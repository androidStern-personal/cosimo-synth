processor EnhancerLiteSampleRateProbe
{
    output stream int32 out;
    node enhancer = wt::EnhancerLiteBus;
    node neutral = wt::EnhancerLiteBus;
    float64 phase;

    void configure()
    {
        enhancer.freqHzIn <- 1200.0f;
        enhancer.qIn <- 4.0f;
        enhancer.modeIn <- float32 (wt::enhancerLiteModeStereo);
        enhancer.midAmountIn <- 0.85f;
        enhancer.sideAmountIn <- 0.0f;
        enhancer.curveIn <- float32 (wt::enhancerLiteCurveSolid);
        enhancer.saturationModeIn <- float32 (wt::enhancerLiteSaturationModeSubtle);
        neutral.midAmountIn <- 0.0f;
        neutral.sideAmountIn <- 0.0f;
    }

    float64 measureContributionPower (float32 frequencyHz)
    {
        configure();
        enhancer.resetIn <- 1;
        neutral.resetIn <- 1;
        phase = 0.0;
        let settleFrames = int32 (processor.frequency * 0.08);
        let measureFrames = int32 (processor.frequency * 0.16);

        for (int32 frame = 0; frame < settleFrames; ++frame)
        {
            let sample = 0.3f * float32 (std::intrinsics::sin (phase));
            phase += twoPi * float64 (frequencyHz) / processor.frequency;
            enhancer.in <- float32<2> (sample, sample);
            neutral.in <- float32<2> (sample, sample);
            enhancer.advance();
            neutral.advance();
        }

        float64 contributionPower;
        for (int32 frame = 0; frame < measureFrames; ++frame)
        {
            let sample = 0.3f * float32 (std::intrinsics::sin (phase));
            phase += twoPi * float64 (frequencyHz) / processor.frequency;
            enhancer.in <- float32<2> (sample, sample);
            neutral.in <- float32<2> (sample, sample);
            enhancer.advance();
            neutral.advance();
            let contribution = enhancer.out[0] - neutral.out[0];
            contributionPower += float64 (contribution) * float64 (contribution);
        }
        return contributionPower / float64 (measureFrames);
    }

    void main()
    {
        let inBandPower = measureContributionPower (1200.0f);
        let outOfBandPower = measureContributionPower (7000.0f);
        let finite = inBandPower == inBandPower && outOfBandPower == outOfBandPower;

        out <- (finite && inBandPower > 1.0e-10) ? 1 : 0;
        advance();
        out <- (inBandPower > outOfBandPower * 4.0) ? 1 : 0;
        advance();
        out <- -1;
        advance();
    }
}
