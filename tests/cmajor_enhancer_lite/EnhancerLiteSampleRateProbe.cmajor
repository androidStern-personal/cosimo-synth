processor EnhancerLiteSampleRateProbe
{
    output stream int32 out;
    node enhancer = wt::EnhancerLiteBus;
    node neutral = wt::EnhancerLiteBus;
    float64 phase;

    void configure (int32 shape)
    {
        enhancer.freqHzIn <- 1200.0f;
        enhancer.qIn <- shape == wt::enhancerLiteShapeBell ? 4.0f : 0.71f;
        enhancer.modeIn <- float32 (wt::enhancerLiteModeStereo);
        enhancer.midAmountIn <- 0.85f;
        enhancer.sideAmountIn <- 0.0f;
        enhancer.curveIn <- float32 (wt::enhancerLiteCurveSolid);
        enhancer.saturationModeIn <- float32 (wt::enhancerLiteSaturationModeSubtle);
        enhancer.shapeIn <- float32 (shape);
        neutral.midAmountIn <- 0.0f;
        neutral.sideAmountIn <- 0.0f;
        neutral.shapeIn <- float32 (wt::enhancerLiteShapeBell);
    }

    float64 measureContributionPower (int32 shape, float32 frequencyHz)
    {
        configure (shape);
        enhancer.resetIn <- 1;
        neutral.resetIn <- 1;
        phase = 0.0;
        let settleFrames = int32 (processor.frequency * 0.08);
        let measureFrames = int32 (processor.frequency * 0.16);

        for (int32 frame = 0; frame < settleFrames; ++frame)
        {
            let sample = 0.3f * float32 (std::intrinsics::sin (phase));
            phase += twoPi * float64 (frequencyHz) / processor.frequency;
            enhancer.in <- float32<2> (sample, sample);
            neutral.in <- float32<2> (sample, sample);
            enhancer.advance();
            neutral.advance();
        }

        float64 contributionPower;
        for (int32 frame = 0; frame < measureFrames; ++frame)
        {
            let sample = 0.3f * float32 (std::intrinsics::sin (phase));
            phase += twoPi * float64 (frequencyHz) / processor.frequency;
            enhancer.in <- float32<2> (sample, sample);
            neutral.in <- float32<2> (sample, sample);
            enhancer.advance();
            neutral.advance();
            let contribution = enhancer.out[0] - neutral.out[0];
            contributionPower += float64 (contribution) * float64 (contribution);
        }
        return contributionPower / float64 (measureFrames);
    }

    void main()
    {
        let bellInBandPower = measureContributionPower (
            wt::enhancerLiteShapeBell,
            1200.0f
        );
        let bellOutOfBandPower = measureContributionPower (
            wt::enhancerLiteShapeBell,
            7000.0f
        );
        let lowPlateauPower = measureContributionPower (
            wt::enhancerLiteShapeLow,
            120.0f
        );
        let lowOppositePower = measureContributionPower (
            wt::enhancerLiteShapeLow,
            12000.0f
        );
        let highOppositePower = measureContributionPower (
            wt::enhancerLiteShapeHigh,
            120.0f
        );
        let highPlateauPower = measureContributionPower (
            wt::enhancerLiteShapeHigh,
            12000.0f
        );
        let finite = bellInBandPower == bellInBandPower
                     && bellOutOfBandPower == bellOutOfBandPower
                     && lowPlateauPower == lowPlateauPower
                     && lowOppositePower == lowOppositePower
                     && highOppositePower == highOppositePower
                     && highPlateauPower == highPlateauPower;

        out <- (finite && bellInBandPower > 1.0e-10) ? 1 : 0;
        advance();
        out <- (bellInBandPower > bellOutOfBandPower * 4.0) ? 1 : 0;
        advance();
        out <- (lowPlateauPower > lowOppositePower * 100.0) ? 1 : 0;
        advance();
        out <- (highPlateauPower > highOppositePower * 100.0) ? 1 : 0;
        advance();
        out <- -1;
        advance();
    }
}
