graph EnhancerAt96000 [[ main ]]
{
    output stream int32 out;
    node probe = EnhancerSampleRateProbe;
    connection
    {
        probe.out -> out;
    }
}

## testProcessor (undefined, { frequency: 192000, maxFrequency: 192000 })
graph EnhancerAt192000 [[ main ]]
{
    output stream int32 out;
    node probe = EnhancerSampleRateProbe;
    connection
    {
        probe.out -> out;
    }
}

//==============================================================================
// Deterministic, normalized drum, bass, and bright-poly holdouts through the
// production processor. This is the musical-material regression, not a mirrored
// transfer implementation.

## testProcessor (undefined, { frequency: 48000, maxFrequency: 48000 })

processor EnhancerMusicalMaterialContract [[ main ]]
{
    output stream int32 out;
    node enhancer = wt::EnhancerBus;

    let settleFrames = 4096;
    let measureFrames = 24576;
    let totalFrames = settleFrames + measureFrames;
    let targetRms = 0.12589254f;

    float32<2>[totalFrames] material;
    std::random::RNG noise;
    bool allFinite = true;
    bool allChanged = true;
    bool allLevelControlled = true;
    bool allDcControlled = true;

    void configure()
    {
        enhancer.b1FreqHzIn <- 130.0f;
        enhancer.b1QIn <- 0.71f;
        enhancer.b1ModeIn <- float32 (wt::enhancerModeStereo);
        enhancer.b1MidAmountIn <- 0.7f;
        enhancer.b1SideAmountIn <- 0.35f;
        enhancer.b1CurveIn <- 1.0f;
        enhancer.b2FreqHzIn <- 9000.0f;
        enhancer.b2QIn <- 0.71f;
        enhancer.b2ModeIn <- float32 (wt::enhancerModeMidSide);
        enhancer.b2MidAmountIn <- 0.35f;
        enhancer.b2SideAmountIn <- 0.7f;
        enhancer.b2CurveIn <- 0.0f;
    }

    float32 bassSample (int32 frame)
    {
        let time = float32 (frame) / float32 (processor.frequency);
        let noteIndex = int32 (time / 0.25f) & 3;
        let frequency = noteIndex == 0 ? 55.0f
                        : (noteIndex == 1 ? 65.406f
                           : (noteIndex == 2 ? 73.416f : 82.407f));
        let noteAge = std::intrinsics::wrap (time, 0.25f);
        float32 sample;
        for (int32 harmonic = 1; harmonic <= 7; ++harmonic)
            sample += float32 (std::intrinsics::sin (
                twoPi * float64 (frequency) * float64 (harmonic) * float64 (time)
            )) / float32 (harmonic);
        return sample * (0.58f + 0.42f * std::intrinsics::exp (-8.0f * noteAge));
    }

    float32<2> fixtureSample (int32 fixture, int32 frame)
    {
        let time = float32 (frame) / float32 (processor.frequency);

        if (fixture == 0)
        {
            let kickAge = std::intrinsics::wrap (time, 0.25f);
            let snareAge = std::intrinsics::wrap (time + 0.25f, 0.5f);
            let hatAge = std::intrinsics::wrap (time, 0.125f);
            let randomLeft = noise.getBipolar();
            let randomRight = noise.getBipolar();
            let kickPhase = twoPi * (46.0f * kickAge
                                     + 2.8f * (1.0f - std::intrinsics::exp (-28.0f * kickAge)));
            let kick = float32 (std::intrinsics::sin (kickPhase))
                       * std::intrinsics::exp (-18.0f * kickAge);
            let snareEnvelope = std::intrinsics::exp (-26.0f * snareAge) * 0.52f;
            let hatEnvelope = std::intrinsics::exp (-95.0f * hatAge) * 0.16f;
            return float32<2> (
                kick + randomLeft * (snareEnvelope + hatEnvelope),
                kick + randomRight * (snareEnvelope + hatEnvelope)
            );
        }

        if (fixture == 1)
        {
            let bass = bassSample (frame);
            return float32<2> (bass, bass);
        }

        float32 left;
        float32 right;
        float32[4] chord = (220.0f, 277.183f, 329.628f, 415.305f);
        for (wrap<4> voice)
            for (int32 harmonic = 1; harmonic <= 9; ++harmonic)
            {
                let amplitude = 1.0f / float32 (harmonic);
                let angle = twoPi * float64 (chord[voice]) * float64 (harmonic)
                            * float64 (time);
                left += amplitude * float32 (std::intrinsics::sin (
                    angle + float64 (voice) * 0.37
                ));
                right += amplitude * float32 (std::intrinsics::sin (
                    angle + float64 (voice) * 0.61 + float64 (harmonic) * 0.03
                ));
            }
        return float32<2> (left, right);
    }

    void buildNormalizedFixture (int32 fixture)
    {
        noise.seed (260826L + int64 (fixture));
        float64 power;
        for (int32 frame = 0; frame < totalFrames; ++frame)
        {
            let sampleFrame = fixtureSample (fixture, frame);
            material.at (frame) = sampleFrame;
            if (frame >= settleFrames)
                power += 0.5 * (float64 (sampleFrame[0]) * float64 (sampleFrame[0])
                                + float64 (sampleFrame[1]) * float64 (sampleFrame[1]));
        }
        let rms = float32 (std::intrinsics::sqrt (power / float64 (measureFrames)));
        let scale = targetRms / std::intrinsics::max (rms, 1.0e-12f);
        for (int32 frame = 0; frame < totalFrames; ++frame)
            material.at (frame) *= scale;
    }

    void checkFixture (int32 fixture)
    {
        buildNormalizedFixture (fixture);
        configure();
        enhancer.resetIn <- 1;
        float64 dryPower;
        float64 renderedPower;
        float64 differencePower;
        float64 differenceSum;

        for (int32 frame = 0; frame < totalFrames; ++frame)
        {
            let dry = material.at (frame);
            configure();
            enhancer.in <- dry;
            enhancer.advance();
            let rendered = enhancer.out;
            if (rendered[0] != rendered[0] || rendered[1] != rendered[1])
                allFinite = false;

            if (frame >= settleFrames)
            {
                let difference = rendered - dry;
                dryPower += 0.5 * (float64 (dry[0]) * float64 (dry[0])
                                   + float64 (dry[1]) * float64 (dry[1]));
                renderedPower += 0.5 * (float64 (rendered[0]) * float64 (rendered[0])
                                        + float64 (rendered[1]) * float64 (rendered[1]));
                differencePower += 0.5 * (
                    float64 (difference[0]) * float64 (difference[0])
                    + float64 (difference[1]) * float64 (difference[1])
                );
                differenceSum += 0.5 * float64 (difference[0] + difference[1]);
            }
        }

        let levelDifferenceDb = std::levels::gainTodB (float32 (std::intrinsics::sqrt (
            renderedPower / std::intrinsics::max (dryPower, 1.0e-30)
        )));
        let differenceMean = differenceSum / float64 (measureFrames);
        if (differencePower / float64 (measureFrames) <= 1.0e-10)
            allChanged = false;
        if (std::intrinsics::abs (levelDifferenceDb) > 0.5f)
            allLevelControlled = false;
        if (std::intrinsics::abs (differenceMean) > 0.0001)
            allDcControlled = false;
    }

    void main()
    {
        for (int32 fixture = 0; fixture < 3; ++fixture)
            checkFixture (fixture);

        out <- allFinite ? 1 : 0;
        advance();
        out <- allChanged ? 1 : 0;
        advance();
        out <- allLevelControlled ? 1 : 0;
        advance();
        out <- allDcControlled ? 1 : 0;
        advance();
        out <- -1;
        advance();
    }
}
