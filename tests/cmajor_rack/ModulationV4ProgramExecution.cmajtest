// Bounded production-engine execution proof for the complete modulation.v4
// sparse program domain. This verifies installed prefix counts and live DSP
// sentinels without turning the test into a performance budget.

## global ("../../cmajor/Mseg.cmajor", "../../cmajor/FixedFrameOscillator.cmajor", "../../cmajor/VoiceReducer.cmajor")

## testProcessor (undefined, { frequency: 600 })

graph ModulationV4ProgramExecution [[ main ]]
{
    output event int32 out;

    node source = ModulationV4ProgramSource;
    node engine = wt::SharedVoiceEngine (1);
    node witness = ModulationV4ProgramWitness;

    connection
    {
        source.programOut -> engine.modulationProgramIn;
        source.voiceOut -> engine.voiceEventIn[0];
        source.macro1Out -> engine.macro1In;
        source.macro4Out -> engine.macro4In;
        source.filterQOut -> engine.filterQIn;
        engine.runtimeInstallAckOut -> witness.ackIn;
        engine.effectiveFilterStateOut -> witness.filterIn;
        engine.rackModOut[19] -> witness.hundredRackIn;
        engine.rackModOut[35] -> witness.tailRackIn;
        witness.out -> out;
    }
}

processor ModulationV4ProgramSource
{
    output event wt::ModulationProgramUpload programOut;
    output event (std::notes::NoteOn, std::notes::Slide) voiceOut;
    output value float32 macro1Out;
    output value float32 macro4Out;
    output value float32 filterQOut;

    wt::ModulationProgramUpload emptyProgram (int32 serial)
    {
        wt::ModulationProgramUpload upload;
        upload.dspSessionId = int32 (processor.session);
        upload.deliverySerial = serial;
        return upload;
    }

    wt::ModulationProgramUpload hundredProgram (int32 serial, bool includeSentinel)
    {
        wt::ModulationProgramUpload upload = emptyProgram (serial);
        upload.voiceRouteCount = 30;
        upload.macroVoiceRouteCount = 20;
        upload.voiceRackRouteCount = 30;
        upload.macroRackRouteCount = includeSentinel ? 21 : 20;

        for (int32 targetIndex = 0; targetIndex < 30; ++targetIndex)
        {
            upload.voiceRouteCells.at (targetIndex) = targetIndex;
            upload.voiceRouteSources.at (targetIndex) = 0;
            upload.voiceRouteTargets.at (targetIndex) = targetIndex;
            upload.voiceRoutePolarities.at (targetIndex) = wt::modulationPolarityUnipolar;

            upload.voiceRackRouteCells.at (targetIndex) = targetIndex;
            upload.voiceRackRouteSources.at (targetIndex) = 0;
            upload.voiceRackRouteTargets.at (targetIndex) = targetIndex;
            upload.voiceRackRoutePolarities.at (targetIndex) = wt::modulationPolarityUnipolar;
            upload.voiceRackRouteReducers.at (targetIndex) = wt::modulationReducerMaximum;
        }

        for (int32 targetIndex = 0; targetIndex < 19; ++targetIndex)
        {
            upload.macroVoiceRouteCells.at (targetIndex) = targetIndex;
            upload.macroVoiceRouteSources.at (targetIndex) = 0;
            upload.macroVoiceRouteTargets.at (targetIndex) = targetIndex;
            upload.macroVoiceRoutePolarities.at (targetIndex) = wt::modulationPolarityUnipolar;
        }

        upload.macroVoiceRouteCells[19] = wt::modulationTargetFilterQ;
        upload.macroVoiceRouteSources[19] = 0;
        upload.macroVoiceRouteTargets[19] = wt::modulationTargetFilterQ;
        upload.macroVoiceRoutePolarities[19] = wt::modulationPolarityUnipolar;
        upload.macroVoiceRouteAmounts[wt::modulationTargetFilterQ] = 1.0f;

        for (int32 targetIndex = 0; targetIndex < 20; ++targetIndex)
        {
            upload.macroRackRouteCells.at (targetIndex) = targetIndex;
            upload.macroRackRouteSources.at (targetIndex) = 0;
            upload.macroRackRouteTargets.at (targetIndex) = targetIndex;
            upload.macroRackRoutePolarities.at (targetIndex) = wt::modulationPolarityUnipolar;
        }
        upload.macroRackRouteAmounts[19] = 1.0f;

        if (includeSentinel)
        {
            let finalCell = wt::modulationMacroRackRouteCellCount - 1;
            upload.macroRackRouteCells[20] = finalCell;
            upload.macroRackRouteSources[20] = wt::modulationMacroSourceCount - 1;
            upload.macroRackRouteTargets[20] = wt::rackModTargetCount - 1;
            upload.macroRackRoutePolarities[20] = wt::modulationPolarityUnipolar;
            upload.macroRackRouteAmounts[finalCell] = 0.5f;
        }

        return upload;
    }

    wt::ModulationProgramUpload fullDomainProgram (int32 serial)
    {
        wt::ModulationProgramUpload upload = emptyProgram (serial);
        upload.voiceRouteCount = wt::modulationVoiceRouteCellCount;
        upload.macroVoiceRouteCount = wt::modulationMacroVoiceRouteCellCount;
        upload.voiceRackRouteCount = wt::modulationVoiceRackRouteCellCount;
        upload.macroRackRouteCount = wt::modulationMacroRackRouteCellCount;

        for (int32 cellIndex = 0; cellIndex < wt::modulationVoiceRouteCellCount; ++cellIndex)
        {
            upload.voiceRouteCells.at (cellIndex) = cellIndex;
            upload.voiceRouteSources.at (cellIndex) = cellIndex / wt::modulationVoiceTargetCount;
            upload.voiceRouteTargets.at (cellIndex) = cellIndex % wt::modulationVoiceTargetCount;
            upload.voiceRoutePolarities.at (cellIndex) = wt::modulationPolarityUnipolar;
        }

        for (int32 cellIndex = 0; cellIndex < wt::modulationMacroVoiceRouteCellCount; ++cellIndex)
        {
            upload.macroVoiceRouteCells.at (cellIndex) = cellIndex;
            upload.macroVoiceRouteSources.at (cellIndex) = cellIndex / wt::modulationVoiceTargetCount;
            upload.macroVoiceRouteTargets.at (cellIndex) = cellIndex % wt::modulationVoiceTargetCount;
            upload.macroVoiceRoutePolarities.at (cellIndex) = wt::modulationPolarityUnipolar;
        }

        for (int32 cellIndex = 0; cellIndex < wt::modulationVoiceRackRouteCellCount; ++cellIndex)
        {
            upload.voiceRackRouteCells.at (cellIndex) = cellIndex;
            upload.voiceRackRouteSources.at (cellIndex) = cellIndex / wt::rackModTargetCount;
            upload.voiceRackRouteTargets.at (cellIndex) = cellIndex % wt::rackModTargetCount;
            upload.voiceRackRoutePolarities.at (cellIndex) = wt::modulationPolarityUnipolar;
            upload.voiceRackRouteReducers.at (cellIndex) = wt::modulationReducerMaximum;
        }

        for (int32 cellIndex = 0; cellIndex < wt::modulationMacroRackRouteCellCount; ++cellIndex)
        {
            upload.macroRackRouteCells.at (cellIndex) = cellIndex;
            upload.macroRackRouteSources.at (cellIndex) = cellIndex / wt::rackModTargetCount;
            upload.macroRackRouteTargets.at (cellIndex) = cellIndex % wt::rackModTargetCount;
            upload.macroRackRoutePolarities.at (cellIndex) = wt::modulationPolarityUnipolar;
        }

        upload.voiceRouteAmounts[wt::modulationVoiceRouteCellCount - 1] = 1.0f;
        upload.macroVoiceRouteAmounts[wt::modulationMacroVoiceRouteCellCount - 1] = 2.0f;
        upload.voiceRackRouteAmounts[wt::modulationVoiceRackRouteCellCount - 1] = 1.0f;
        upload.macroRackRouteAmounts[wt::modulationMacroRackRouteCellCount - 1] = 2.0f;
        return upload;
    }

    wt::ModulationProgramUpload populatedZeroCountProgram (int32 serial)
    {
        wt::ModulationProgramUpload upload = fullDomainProgram (serial);
        upload.voiceRouteCount = 0;
        upload.macroVoiceRouteCount = 0;
        upload.voiceRackRouteCount = 0;
        upload.macroRackRouteCount = 0;
        return upload;
    }

    std::notes::NoteOn noteOn()
    {
        std::notes::NoteOn note;
        note.channel = 0;
        note.pitch = 60.0f;
        note.velocity = 1.0f;
        return note;
    }

    std::notes::Slide slide()
    {
        std::notes::Slide expression;
        expression.channel = 0;
        expression.slide = 1.0f;
        return expression;
    }

    void main()
    {
        macro1Out <- 1.0f;
        macro4Out <- 1.0f;
        filterQOut <- 0.707107f;

        for (int32 frame = 0; ; ++frame)
        {
            if (frame == 1)
                programOut <- emptyProgram (1);
            if (frame == 2)
            {
                voiceOut <- noteOn();
                voiceOut <- slide();
            }
            if (frame == 5)
                programOut <- hundredProgram (2, false);
            if (frame == 20)
                programOut <- hundredProgram (3, true);
            if (frame == 35)
                programOut <- fullDomainProgram (4);
            if (frame == 50)
                programOut <- populatedZeroCountProgram (5);
            if (frame == 75)
                programOut <- emptyProgram (6);
            advance();
        }
    }
}

processor ModulationV4ProgramWitness
{
    input event wt::RuntimeInstallAck ackIn;
    input event wt::EffectiveFilterStateMonitor filterIn;
    input stream float32 hundredRackIn;
    input stream float32 tailRackIn;
    output event int32 out;

    int32 acceptedMask;
    int32 seenAcceptedMask;
    int32 rejectedCount;
    float32 latestQ;
    int32 hundredSustainedFrames;
    bool sentinelExecuted;
    bool fullDomainExecuted;
    bool populatedZeroCountCleared;
    bool emptyStayedClear;

    event ackIn (wt::RuntimeInstallAck ack)
    {
        let serial = ack.acceptedModulationSerial;
        if (serial >= 1 && serial <= 6)
            seenAcceptedMask |= 1 << (serial - 1);
        if (ack.rejectionReason != wt::runtimeInstallRejectionNone)
            rejectedCount += 1;

        if (serial == 1
            && ack.installedVoiceRouteCount == 0
            && ack.installedMacroVoiceRouteCount == 0
            && ack.installedVoiceRackRouteCount == 0
            && ack.installedMacroRackRouteCount == 0)
            acceptedMask |= 1;
        else if (serial == 2
            && ack.installedVoiceRouteCount == 30
            && ack.installedMacroVoiceRouteCount == 20
            && ack.installedVoiceRackRouteCount == 30
            && ack.installedMacroRackRouteCount == 20)
            acceptedMask |= 2;
        else if (serial == 3
            && ack.installedVoiceRouteCount == 30
            && ack.installedMacroVoiceRouteCount == 20
            && ack.installedVoiceRackRouteCount == 30
            && ack.installedMacroRackRouteCount == 21)
            acceptedMask |= 4;
        else if (serial == 4
            && ack.installedVoiceRouteCount == wt::modulationVoiceRouteCellCount
            && ack.installedMacroVoiceRouteCount == wt::modulationMacroVoiceRouteCellCount
            && ack.installedVoiceRackRouteCount == wt::modulationVoiceRackRouteCellCount
            && ack.installedMacroRackRouteCount == wt::modulationMacroRackRouteCellCount)
            acceptedMask |= 8;
        else if (serial == 5
            && ack.installedVoiceRouteCount == 0
            && ack.installedMacroVoiceRouteCount == 0
            && ack.installedVoiceRackRouteCount == 0
            && ack.installedMacroRackRouteCount == 0)
            acceptedMask |= 16;
        else if (serial == 6
            && ack.installedVoiceRouteCount == 0
            && ack.installedMacroVoiceRouteCount == 0
            && ack.installedVoiceRackRouteCount == 0
            && ack.installedMacroRackRouteCount == 0)
            acceptedMask |= 32;
    }

    event filterIn (wt::EffectiveFilterStateMonitor state)
    {
        if (state.hasActive != 0)
            latestQ = state.q;
    }

    void main()
    {
        for (int32 frame = 0; ; ++frame)
        {
            if (frame >= 12 && frame < 20
                && latestQ > 1.6f && latestQ < 1.8f
                && hundredRackIn > 0.9f)
                hundredSustainedFrames += 1;

            if (frame >= 27 && frame < 35 && tailRackIn > 0.45f)
                sentinelExecuted = true;

            if (frame >= 42 && frame < 50
                && latestQ > 3.6f && latestQ < 3.8f
                && tailRackIn > 2.9f)
                fullDomainExecuted = true;

            if (frame >= 70 && frame < 75
                && latestQ > 0.6f && latestQ < 0.8f
                && std::intrinsics::abs (hundredRackIn) < 0.01f
                && std::intrinsics::abs (tailRackIn) < 0.01f)
                populatedZeroCountCleared = true;

            if (frame >= 82 && frame < 89
                && latestQ > 0.6f && latestQ < 0.8f
                && std::intrinsics::abs (hundredRackIn) < 0.01f
                && std::intrinsics::abs (tailRackIn) < 0.01f)
                emptyStayedClear = true;

            if (frame == 90)
                out <- acceptedMask == 63
                    && seenAcceptedMask == 63
                    && rejectedCount == 0 ? 1 : 0;
            if (frame == 91)
                out <- hundredSustainedFrames >= 4 ? 1 : 0;
            if (frame == 92)
                out <- sentinelExecuted ? 1 : 0;
            if (frame == 93)
                out <- fullDomainExecuted ? 1 : 0;
            if (frame == 94)
                out <- populatedZeroCountCleared ? 1 : 0;
            if (frame == 95)
                out <- emptyStayedClear ? 1 : 0;
            if (frame == 96)
                out <- -1;

            advance();
        }
    }
}
