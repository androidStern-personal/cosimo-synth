// Behavioural contract for parallel lane groups (M3 slices T1+T2): a group is
// opened by a MARKER SLOT — a utility unit with its own slot id — whose tag
// field carries the branch count, and the members that follow carry branch
// tags 1..N (monotone, skips allowed: an empty branch is representable and
// contributes SILENCE, so adding an empty lane never changes the sound). The
// marker's enable bit bypasses the whole group: members still advance on
// their branch signals (time bases never drift), but the trunk passes the
// fork signal through. Branch outputs are summed at the merge; a parallel
// group containing no devices at all is a hard passthrough, never a mute.
//
// The audible discrimination, all with FULL-WET delays (mix 1.0, feedback 0):
// parallel delay(40ms) ∥ delay(90ms) echoes at 40ms AND 90ms with NOTHING at
// the 130ms series time — no serial rack can match it. A branch is a serial
// chain of its own, and the merged sum feeds the trunk continuation.
//
// Tag grammar (validated, never coerced — the C11 rule): members require an
// open group; tags never exceed the marker's N and never decrease; parallel
// N is 2..4 (the physical campaign's proven fan-out); junk above the tag
// field, N out of range, and duplicate marker units reject the upload whole
// with the running chain untouched.
//
// `## testProcessor()` scans the first output endpoint: <0 stops, >0 passes,
// ==0 fails. Composed child `init:` annotations are INERT — every endpoint a
// scenario depends on is written explicitly (same as LaneTopology.cmajtest).

## global ("../../cmajor/KeyTrack.cmajor", "../../cmajor/Mseg.cmajor", "../../cmajor/VoiceEnhancer.cmajor", "../../cmajor/FixedFrameOscillator.cmajor", "../../cmajor/VoiceReducer.cmajor", "../../cmajor/GlobalFilter.cmajor", "../../cmajor/Distortion.cmajor", "../../cmajor/Ott.cmajor", "../../cmajor/Chorus.cmajor", "../../cmajor/Flanger.cmajor", "../../cmajor/Phaser.cmajor", "../../cmajor/Delay.cmajor", "../../cmajor/Reverb.cmajor", "../../cmajor/EffectsRack.cmajor")

//==============================================================================
// Two full-wet delays in PARALLEL: both echoes, no series echo, no dry leak.

## testProcessor (true, { frequency: 44100, maxFrequency: 48000 })

processor LaneParallelTwoDelaysTest [[ main ]]
{
    output stream int32 out;

    node rack = wt::EffectsRack;

    // 40ms and 90ms at 44100: echoes at 1764 and 3969; the series echo would
    // land at 5733 and must not exist.
    let echoOneFrame = 1764;
    let echoTwoFrame = 3969;
    let echoSeriesFrame = 5733;

    let settleFrames = 2048;
    let recordFrames = 6400;
    let peakWindow = 8;
    let expectedPeakMinimum = 0.08f;
    let controlCeiling = 0.015f;

    float32[6400] recordedLeft;

    wt::LaneSlotParamsUpload makeDelayParams (int32 slotId, int32 serial, float32 timeMs)
    {
        wt::LaneSlotParamsUpload upload;
        upload.slotId = slotId;
        upload.deliverySerial = serial;
        upload.values[wt::laneDelayParamTimeMs] = timeMs;
        upload.values[wt::laneDelayParamFeedback] = 0.0f;
        upload.values[wt::laneDelayParamFilterHz] = 18000.0f;
        upload.values[wt::laneDelayParamMix] = 1.0f;
        return upload;
    }

    wt::LaneTopologyUpload makeParallelChain()
    {
        wt::LaneTopologyUpload upload;
        upload.chainLength = 3;
        upload.slotIds[0] = wt::laneEncodeSlotWithBranchTag (wt::laneParallelSlotBase, 2);
        upload.slotIds[1] = wt::laneEncodeSlotWithBranchTag (wt::rackModuleDelay, 1);
        upload.slotIds[2] = wt::laneEncodeSlotWithBranchTag (wt::laneSlotDelayTwo, 2);
        upload.enabledMask = 0b111;
        return upload;
    }

    void configure()
    {
        rack.tempoBpmIn <- 120.0f;
        rack.laneSlotParams <- makeDelayParams (wt::rackModuleDelay, 1, 40.0f);
        rack.laneSlotParams <- makeDelayParams (wt::laneSlotDelayTwo, 2, 90.0f);
        rack.laneTopology <- makeParallelChain();
    }

    void advanceRack (float32 sample)
    {
        rack.in <- float32<2> (sample, sample);
        rack.trackingPitchHzIn <- 220.0f;
        rack.advance();
    }

    float32 windowPeak (int32 center)
    {
        var peak = 0.0f;

        for (int32 offset = -peakWindow; offset <= peakWindow; ++offset)
        {
            let index = center + offset;

            if (index >= 0 && index < recordFrames)
            {
                let magnitude = std::intrinsics::abs (recordedLeft.at (index));

                if (magnitude > peak)
                    peak = magnitude;
            }
        }

        return peak;
    }

    void main()
    {
        configure();

        for (int32 frame = 0; frame < settleFrames; ++frame)
            advanceRack (0.0f);

        for (int32 frame = 0; frame < recordFrames; ++frame)
        {
            advanceRack (frame == 0 ? 1.0f : 0.0f);
            recordedLeft.at (frame) = rack.out[0];
        }

        // Frame 1: branch A's echo exists at its own time.
        out <- (windowPeak (echoOneFrame) > expectedPeakMinimum ? 1 : 0);
        advance();

        // Frame 2: branch B's echo exists at ITS own time — only a parallel
        // path from the group input can produce this with full-wet delays.
        out <- (windowPeak (echoTwoFrame) > expectedPeakMinimum ? 1 : 0);
        advance();

        // Frame 3: the SERIES echo does not exist — the branches never chained.
        out <- (windowPeak (echoSeriesFrame) < controlCeiling ? 1 : 0);
        advance();

        // Frame 4: no dry leak — both paths are full wet, and the sum carried
        // no bypass copy of the input.
        out <- (windowPeak (0) < controlCeiling ? 1 : 0);
        advance();

        // Frame 5: the structure actually committed.
        out <- (rack.laneCommittedGeneration > 0 ? 1 : 0);
        advance();

        loop { out <- -1; advance(); }
    }
}

//==============================================================================
// A branch is a serial chain; the merged sum feeds the trunk continuation.

## testProcessor (true, { frequency: 44100, maxFrequency: 48000 })

processor LaneBranchChainAndMergeTest [[ main ]]
{
    output stream int32 out;

    node rack = wt::EffectsRack;

    // Branch A: 40ms -> 90ms (both full wet) = one echo at 130ms.
    // Branch B: 60ms = one echo at 60ms.
    // Trunk after the merge: 25ms full wet shifts EVERYTHING by 25ms.
    // Expected: 155ms and 85ms only; the unshifted 130ms and 60ms must not
    // survive (they would mean the trunk device saw something other than the
    // merged sum).
    let echoBranchAFrame = 6835;   // 155ms
    let echoBranchBFrame = 3749;   // 85ms
    let controlUnshiftedA = 5733;  // 130ms
    let controlUnshiftedB = 2646;  // 60ms

    let settleFrames = 2048;
    let recordFrames = 8192;
    let peakWindow = 8;
    let expectedPeakMinimum = 0.08f;
    let controlCeiling = 0.015f;

    float32[8192] recordedLeft;

    wt::LaneSlotParamsUpload makeDelayParams (int32 slotId, int32 serial, float32 timeMs)
    {
        wt::LaneSlotParamsUpload upload;
        upload.slotId = slotId;
        upload.deliverySerial = serial;
        upload.values[wt::laneDelayParamTimeMs] = timeMs;
        upload.values[wt::laneDelayParamFeedback] = 0.0f;
        upload.values[wt::laneDelayParamFilterHz] = 18000.0f;
        upload.values[wt::laneDelayParamMix] = 1.0f;
        return upload;
    }

    wt::LaneTopologyUpload makeChain()
    {
        // Delay slots by ordinal: 6, 14, 22, 30.
        let delayThree = wt::rackModuleCount * 2 + wt::rackModuleDelay;
        let delayFour  = wt::rackModuleCount * 3 + wt::rackModuleDelay;

        wt::LaneTopologyUpload upload;
        upload.chainLength = 5;
        upload.slotIds[0] = wt::laneEncodeSlotWithBranchTag (wt::laneParallelSlotBase, 2);
        upload.slotIds[1] = wt::laneEncodeSlotWithBranchTag (wt::rackModuleDelay, 1);
        upload.slotIds[2] = wt::laneEncodeSlotWithBranchTag (wt::laneSlotDelayTwo, 1);
        upload.slotIds[3] = wt::laneEncodeSlotWithBranchTag (delayThree, 2);
        upload.slotIds[4] = wt::laneEncodeSlotWithBranchTag (delayFour, 0);
        upload.enabledMask = 0b11111;
        return upload;
    }

    void configure()
    {
        let delayThree = wt::rackModuleCount * 2 + wt::rackModuleDelay;
        let delayFour  = wt::rackModuleCount * 3 + wt::rackModuleDelay;

        rack.tempoBpmIn <- 120.0f;
        rack.laneSlotParams <- makeDelayParams (wt::rackModuleDelay, 1, 40.0f);
        rack.laneSlotParams <- makeDelayParams (wt::laneSlotDelayTwo, 2, 90.0f);
        rack.laneSlotParams <- makeDelayParams (delayThree, 3, 60.0f);
        rack.laneSlotParams <- makeDelayParams (delayFour, 4, 25.0f);
        rack.laneTopology <- makeChain();
    }

    void advanceRack (float32 sample)
    {
        rack.in <- float32<2> (sample, sample);
        rack.trackingPitchHzIn <- 220.0f;
        rack.advance();
    }

    float32 windowPeak (int32 center)
    {
        var peak = 0.0f;

        for (int32 offset = -peakWindow; offset <= peakWindow; ++offset)
        {
            let index = center + offset;

            if (index >= 0 && index < recordFrames)
            {
                let magnitude = std::intrinsics::abs (recordedLeft.at (index));

                if (magnitude > peak)
                    peak = magnitude;
            }
        }

        return peak;
    }

    void main()
    {
        configure();

        for (int32 frame = 0; frame < settleFrames; ++frame)
            advanceRack (0.0f);

        for (int32 frame = 0; frame < recordFrames; ++frame)
        {
            advanceRack (frame == 0 ? 1.0f : 0.0f);
            recordedLeft.at (frame) = rack.out[0];
        }

        // Frame 1: branch A chained 40+90, then the trunk added 25.
        out <- (windowPeak (echoBranchAFrame) > expectedPeakMinimum ? 1 : 0);
        advance();

        // Frame 2: branch B's echo, shifted by the trunk delay.
        out <- (windowPeak (echoBranchBFrame) > expectedPeakMinimum ? 1 : 0);
        advance();

        // Frame 3: nothing at the UNSHIFTED branch-A time — the merged sum
        // went through the trunk device, not around it.
        out <- (windowPeak (controlUnshiftedA) < controlCeiling ? 1 : 0);
        advance();

        // Frame 4: nothing at the unshifted branch-B time either.
        out <- (windowPeak (controlUnshiftedB) < controlCeiling ? 1 : 0);
        advance();

        loop { out <- -1; advance(); }
    }
}

//==============================================================================
// Branch-level semantics: a disabled device passes its branch through, an
// EMPTY branch contributes silence, and the marker's enable bypasses the
// whole group as a hard passthrough.

## testProcessor (true, { frequency: 44100, maxFrequency: 48000 })

processor LaneBranchSemanticsTest [[ main ]]
{
    output stream int32 out;

    node rack = wt::EffectsRack;

    let echoDelayOneFrame = 1764;   // 40ms
    let echoDelayTwoFrame = 3969;   // 90ms

    let settleFrames = 2048;
    let recordFrames = 6400;
    let peakWindow = 8;
    let expectedPeakMinimum = 0.08f;
    let controlCeiling = 0.015f;

    float32[6400] recordedLeft;

    wt::LaneSlotParamsUpload makeDelayParams (int32 slotId, int32 serial, float32 timeMs)
    {
        wt::LaneSlotParamsUpload upload;
        upload.slotId = slotId;
        upload.deliverySerial = serial;
        upload.values[wt::laneDelayParamTimeMs] = timeMs;
        upload.values[wt::laneDelayParamFeedback] = 0.0f;
        upload.values[wt::laneDelayParamFilterHz] = 18000.0f;
        upload.values[wt::laneDelayParamMix] = 1.0f;
        return upload;
    }

    wt::LaneTopologyUpload makeTwoBranchChain (int32 enabledMask)
    {
        wt::LaneTopologyUpload upload;
        upload.chainLength = 3;
        upload.slotIds[0] = wt::laneEncodeSlotWithBranchTag (wt::laneParallelSlotBase, 2);
        upload.slotIds[1] = wt::laneEncodeSlotWithBranchTag (wt::rackModuleDelay, 1);
        upload.slotIds[2] = wt::laneEncodeSlotWithBranchTag (wt::laneSlotDelayTwo, 2);
        upload.enabledMask = enabledMask;
        return upload;
    }

    wt::LaneTopologyUpload makeOneOccupiedBranchChain (int32 enabledMask)
    {
        wt::LaneTopologyUpload upload;
        upload.chainLength = 2;
        upload.slotIds[0] = wt::laneEncodeSlotWithBranchTag (wt::laneParallelSlotBase, 2);
        upload.slotIds[1] = wt::laneEncodeSlotWithBranchTag (wt::rackModuleDelay, 1);
        upload.enabledMask = enabledMask;
        return upload;
    }

    void advanceRack (float32 sample)
    {
        rack.in <- float32<2> (sample, sample);
        rack.trackingPitchHzIn <- 220.0f;
        rack.advance();
    }

    void captureImpulseResponse()
    {
        for (int32 frame = 0; frame < settleFrames; ++frame)
            advanceRack (0.0f);

        for (int32 frame = 0; frame < recordFrames; ++frame)
        {
            advanceRack (frame == 0 ? 1.0f : 0.0f);
            recordedLeft.at (frame) = rack.out[0];
        }
    }

    float32 windowPeak (int32 center)
    {
        var peak = 0.0f;

        for (int32 offset = -peakWindow; offset <= peakWindow; ++offset)
        {
            let index = center + offset;

            if (index >= 0 && index < recordFrames)
            {
                let magnitude = std::intrinsics::abs (recordedLeft.at (index));

                if (magnitude > peak)
                    peak = magnitude;
            }
        }

        return peak;
    }

    void main()
    {
        rack.tempoBpmIn <- 120.0f;
        rack.laneSlotParams <- makeDelayParams (wt::rackModuleDelay, 1, 40.0f);
        rack.laneSlotParams <- makeDelayParams (wt::laneSlotDelayTwo, 2, 90.0f);

        // Scene 1: branch A's device DISABLED (position 1 bit off) — its
        // branch passes the dry impulse; branch B echoes at 90ms.
        rack.laneTopology <- makeTwoBranchChain (0b101);
        captureImpulseResponse();

        out <- (windowPeak (0) > expectedPeakMinimum ? 1 : 0);
        advance();
        out <- (windowPeak (echoDelayTwoFrame) > expectedPeakMinimum ? 1 : 0);
        advance();
        out <- (windowPeak (echoDelayOneFrame) < controlCeiling ? 1 : 0);
        advance();

        // Scene 2: branch B EMPTY (no positions carry tag 2) — it contributes
        // SILENCE, so the output is branch A's wet echo alone: no dry copy of
        // the impulse anywhere.
        rack.laneTopology <- makeOneOccupiedBranchChain (0b11);
        captureImpulseResponse();

        out <- (windowPeak (echoDelayOneFrame) > expectedPeakMinimum ? 1 : 0);
        advance();
        out <- (windowPeak (0) < controlCeiling ? 1 : 0);
        advance();

        // Scene 3: the MARKER disabled — the whole group bypasses as a hard
        // passthrough: the impulse passes dry and no echo survives.
        rack.laneTopology <- makeOneOccupiedBranchChain (0b10);
        captureImpulseResponse();

        out <- (windowPeak (0) > 0.9f ? 1 : 0);
        advance();
        out <- (windowPeak (echoDelayOneFrame) < controlCeiling ? 1 : 0);
        advance();

        loop { out <- -1; advance(); }
    }
}

//==============================================================================
// The marker grammar is validated, never coerced; committed tags read back.

## testProcessor (true, { frequency: 44100, maxFrequency: 48000 })

processor LaneMarkerGrammarTest [[ main ]]
{
    output stream int32 out;

    node rack = wt::EffectsRack;

    let settleFrames = 1024;

    wt::LaneTopologyUpload makeBaseline()
    {
        wt::LaneTopologyUpload upload;
        upload.chainLength = 3;
        upload.slotIds[0] = wt::laneEncodeSlotWithBranchTag (wt::laneParallelSlotBase, 2);
        upload.slotIds[1] = wt::laneEncodeSlotWithBranchTag (wt::rackModuleDelay, 1);
        upload.slotIds[2] = wt::laneEncodeSlotWithBranchTag (wt::laneSlotDelayTwo, 2);
        upload.enabledMask = 0b111;
        return upload;
    }

    wt::LaneTopologyUpload makePair (int32 first, int32 second)
    {
        wt::LaneTopologyUpload upload;
        upload.chainLength = 2;
        upload.slotIds[0] = first;
        upload.slotIds[1] = second;
        upload.enabledMask = 0b11;
        return upload;
    }

    void advanceFrames (int32 frames)
    {
        for (int32 frame = 0; frame < frames; ++frame)
        {
            rack.in <- float32<2> (0.0f, 0.0f);
            rack.trackingPitchHzIn <- 220.0f;
            rack.advance();
        }
    }

    void main()
    {
        rack.tempoBpmIn <- 120.0f;
        rack.laneTopology <- makeBaseline();
        advanceFrames (settleFrames);

        let committedGeneration = rack.laneCommittedGeneration;
        let committedCode = rack.laneCommittedChainCode;
        let rejectedBefore = rack.laneRejectedUploadCount;

        // Frame 1: the baseline committed exactly once.
        out <- (committedGeneration == 1 ? 1 : 0);
        advance();

        // Frame 2: committed tags read back packed, three bits per position:
        // marker N=2, then branches [1, 2] -> 2 | 1<<3 | 2<<6 = 138.
        out <- (rack.laneCommittedBranchTagsLo == 138 && rack.laneCommittedBranchTagsHi == 0 ? 1 : 0);
        advance();

        // A tagged member with no open group (the old markerless T1 form).
        rack.laneTopology <- makePair (
            wt::laneEncodeSlotWithBranchTag (wt::rackModuleDelay, 1),
            wt::laneEncodeSlotWithBranchTag (wt::laneSlotDelayTwo, 2));
        // A one-branch group is not a group.
        rack.laneTopology <- makePair (
            wt::laneEncodeSlotWithBranchTag (wt::laneParallelSlotBase, 1),
            wt::laneEncodeSlotWithBranchTag (wt::rackModuleDelay, 1));
        // Parallel fan-out caps at 4.
        rack.laneTopology <- makePair (
            wt::laneEncodeSlotWithBranchTag (wt::laneParallelSlotBase, 5),
            wt::laneEncodeSlotWithBranchTag (wt::rackModuleDelay, 1));
        // A member tag beyond the marker's branch count.
        rack.laneTopology <- makePair (
            wt::laneEncodeSlotWithBranchTag (wt::laneParallelSlotBase, 2),
            wt::laneEncodeSlotWithBranchTag (wt::rackModuleDelay, 3));
        // Tags never decrease inside a group.
        wt::LaneTopologyUpload decreasing;
        decreasing.chainLength = 4;
        decreasing.slotIds[0] = wt::laneEncodeSlotWithBranchTag (wt::laneParallelSlotBase, 3);
        decreasing.slotIds[1] = wt::laneEncodeSlotWithBranchTag (wt::rackModuleDelay, 2);
        decreasing.slotIds[2] = wt::laneEncodeSlotWithBranchTag (wt::laneSlotDelayTwo, 1);
        decreasing.slotIds[3] = wt::laneEncodeSlotWithBranchTag (wt::rackModuleCount * 2 + wt::rackModuleDelay, 3);
        decreasing.enabledMask = 0b1111;
        rack.laneTopology <- decreasing;
        // Junk above the tag field is malformed, not ignorable.
        rack.laneTopology <- makePair (
            wt::laneEncodeSlotWithBranchTag (wt::laneParallelSlotBase, 2),
            wt::laneEncodeSlotWithBranchTag (wt::rackModuleDelay, 1) | (1 << 12));
        // A marker with tag 0 is not a trunk device.
        rack.laneTopology <- makePair (
            wt::laneEncodeSlotWithBranchTag (wt::laneParallelSlotBase, 0),
            wt::laneEncodeSlotWithBranchTag (wt::rackModuleDelay, 0));

        advanceFrames (settleFrames);

        // Frame 3: every malformed upload rejected.
        out <- (rack.laneRejectedUploadCount == rejectedBefore + 7 ? 1 : 0);
        advance();

        // Frame 4: the running structure never moved.
        out <- (rack.laneCommittedGeneration == committedGeneration
                 && rack.laneCommittedChainCode == committedCode ? 1 : 0);
        advance();

        // Frame 5: a valid upload with a SECOND marker unit still commits
        // after the rejections (adjacent groups, no trunk between).
        wt::LaneTopologyUpload adjacent;
        adjacent.chainLength = 4;
        adjacent.slotIds[0] = wt::laneEncodeSlotWithBranchTag (wt::laneParallelSlotBase, 2);
        adjacent.slotIds[1] = wt::laneEncodeSlotWithBranchTag (wt::rackModuleDelay, 1);
        adjacent.slotIds[2] = wt::laneEncodeSlotWithBranchTag (wt::laneParallelSlotBase + 1, 2);
        adjacent.slotIds[3] = wt::laneEncodeSlotWithBranchTag (wt::laneSlotDelayTwo, 2);
        adjacent.enabledMask = 0b1111;
        rack.laneTopology <- adjacent;
        advanceFrames (settleFrames);
        out <- (rack.laneCommittedGeneration == committedGeneration + 1
                 && rack.laneCommittedBranchTagsLo == (2 | (1 << 3) | (2 << 6) | (2 << 9)) ? 1 : 0);
        advance();

        loop { out <- -1; advance(); }
    }
}
