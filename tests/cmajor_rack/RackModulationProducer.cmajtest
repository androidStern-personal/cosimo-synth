// Production proof that a sparse voice-domain instruction reaches the global rack.

## global ("../../cmajor/KeyTrack.cmajor", "../../cmajor/Mseg.cmajor", "../../cmajor/VoiceEnhancer.cmajor", "../../cmajor/FixedFrameOscillator.cmajor", "../../cmajor/VoiceReducer.cmajor", "NoopThreeOscillatorRenderer.cmajor", "../../cmajor/GlobalFilter.cmajor", "../../cmajor/Distortion.cmajor", "../../cmajor/Ott.cmajor", "../../cmajor/Chorus.cmajor", "../../cmajor/Flanger.cmajor", "../../cmajor/Phaser.cmajor", "../../cmajor/Delay.cmajor", "../../cmajor/Reverb.cmajor", "../../cmajor/EffectsRack.cmajor")

## testProcessor()

processor RackModulationReachesRealDsp [[ main ]]
{
    output stream int32 out;

    let voiceCount = 2;
    let settleFrames = 16384;
    let measureFrames = 8192;
    let cutoffTarget = wt::rackModTargetGlobalFilterCutoffOctaves;

    node engineDry = wt::SharedVoiceEngine (voiceCount);
    node engineModulated = wt::SharedVoiceEngine (voiceCount);
    node rackDry = wt::EffectsRack;
    node rackModulated = wt::EffectsRack;

    wt::LaneTopologyUpload filterOnly()
    {
        wt::LaneTopologyUpload upload;
        upload.chainLength = 1;
        upload.slotIds[0] = wt::rackModuleGlobalFilter;
        upload.enabledMask = 0b1;
        return upload;
    }

    wt::ModulationProgramUpload cutoffProgram (int32 deliverySerial)
    {
        wt::ModulationProgramUpload program;
        program.dspSessionId = int32 (processor.session);
        program.deliverySerial = deliverySerial;
        let cutoffCell = 6 * wt::rackModTargetCount + cutoffTarget;
        let resonanceCell = cutoffCell + 1;
        let driveCell = cutoffCell + 2;
        program.voiceRackRouteCount = 3;
        program.voiceRackRouteCells[0] = cutoffCell;
        program.voiceRackRouteSources[0] = 6;
        program.voiceRackRouteTargets[0] = cutoffTarget;
        program.voiceRackRoutePolarities[0] = wt::modulationPolarityUnipolar;
        program.voiceRackRouteReducers[0] = wt::modulationReducerMaximum;
        program.voiceRackRouteAmounts[cutoffCell] = -3.0f;
        program.voiceRackRouteCells[1] = resonanceCell;
        program.voiceRackRouteSources[1] = 6;
        program.voiceRackRouteTargets[1] = wt::rackModTargetGlobalFilterResonance;
        program.voiceRackRoutePolarities[1] = wt::modulationPolarityBipolar;
        program.voiceRackRouteReducers[1] = wt::modulationReducerMean;
        program.voiceRackRouteAmounts[resonanceCell] = 2.0f;
        program.voiceRackRouteCells[2] = driveCell;
        program.voiceRackRouteSources[2] = 6;
        program.voiceRackRouteTargets[2] = wt::rackModTargetGlobalFilterDrive;
        program.voiceRackRoutePolarities[2] = wt::modulationPolarityBipolar;
        program.voiceRackRouteReducers[2] = wt::modulationReducerMaximum;
        program.voiceRackRouteAmounts[driveCell] = 1.0f;
        return program;
    }

    std::notes::NoteOn noteOn (float32 velocity)
    {
        std::notes::NoteOn note;
        note.channel = 0;
        note.pitch = 60.0f;
        note.velocity = velocity;
        return note;
    }

    float32 testSignal (int32 frame)
    {
        return 0.4f * float32 (std::intrinsics::sin (float32 (frame) * 0.05f));
    }

    wt::LaneSlotParamsUpload filterParams()
    {
        wt::LaneSlotParamsUpload upload;
        upload.slotId = wt::rackModuleGlobalFilter;
        upload.deliverySerial = 1;
        upload.values[wt::laneGlobalFilterParamMode] = 1.0f;
        upload.values[wt::laneGlobalFilterParamCutoffHz] = 4000.0f;
        upload.values[wt::laneGlobalFilterParamResonance] = 4.0f;
        return upload;
    }

    void configure()
    {
        rackDry.laneSlotParams <- filterParams();
        rackDry.laneTopology <- filterOnly();

        rackModulated.laneSlotParams <- filterParams();
        rackModulated.laneTopology <- filterOnly();
    }

    float32 renderDry (int32 frame)
    {
        // Direct SharedVoiceEngine graphs do not apply endpoint init annotations.
        // Drive the legacy-compatible Amp Envelope defaults explicitly.
        engineDry.ampAttackIn <- 0.01f;
        engineDry.ampDecayIn <- 0.001f;
        engineDry.ampSustainIn <- 1.0f;
        engineDry.advance();

        for (wrap<wt::rackModTargetCount> target)
            rackDry.rackModIn[target] <- engineDry.rackModOut[target];

        rackDry.in <- float32<2> (testSignal (frame), testSignal (frame));
        rackDry.advance();
        return rackDry.out[0];
    }

    float32 renderModulated (int32 frame)
    {
        engineModulated.ampAttackIn <- 0.01f;
        engineModulated.ampDecayIn <- 0.001f;
        engineModulated.ampSustainIn <- 1.0f;
        engineModulated.advance();

        for (wrap<wt::rackModTargetCount> target)
            rackModulated.rackModIn[target] <- engineModulated.rackModOut[target];

        rackModulated.in <- float32<2> (testSignal (frame), testSignal (frame));
        rackModulated.advance();
        return rackModulated.out[0];
    }

    void main()
    {
        configure();
        engineModulated.modulationProgramIn <- cutoffProgram (1);
        engineDry.voiceEventIn[0] <- noteOn (0.2f);
        engineDry.voiceEventIn[1] <- noteOn (0.6f);
        engineModulated.voiceEventIn[0] <- noteOn (0.2f);
        engineModulated.voiceEventIn[1] <- noteOn (0.6f);

        float32 maxDifference;
        int32 differingFrames;
        float32 unroutedResidue;

        for (int32 frame = 0; frame < settleFrames + measureFrames; ++frame)
        {
            let dry = renderDry (frame);
            let modulated = renderModulated (frame);

            if (frame >= settleFrames)
            {
                let difference = std::intrinsics::abs (dry - modulated);
                maxDifference = std::intrinsics::max (maxDifference, difference);
                if (difference > 0.0f)
                    differingFrames += 1;

                for (wrap<wt::rackModTargetCount> target)
                    if (int32 (target) != cutoffTarget
                        && int32 (target) != wt::rackModTargetGlobalFilterResonance
                        && int32 (target) != wt::rackModTargetGlobalFilterDrive)
                        unroutedResidue = std::intrinsics::max (
                            unroutedResidue,
                            std::intrinsics::abs (engineModulated.rackModOut[target]));
            }
        }

        out <- (maxDifference > 0.01f) ? 1 : 0;
        advance();
        out <- (differingFrames > measureFrames / 2) ? 1 : 0;
        advance();
        out <- (std::intrinsics::abs (engineModulated.rackModOut[cutoffTarget] + 1.8f) < 0.001f) ? 1 : 0;
        advance();
        out <- (std::intrinsics::abs (engineModulated.rackModOut[wt::rackModTargetGlobalFilterResonance] + 0.4f) < 0.001f) ? 1 : 0;
        advance();
        out <- (std::intrinsics::abs (engineModulated.rackModOut[wt::rackModTargetGlobalFilterDrive] + 0.6f) < 0.001f) ? 1 : 0;
        advance();
        out <- (engineDry.rackModOut[cutoffTarget] == 0.0f) ? 1 : 0;
        advance();
        out <- (unroutedResidue == 0.0f) ? 1 : 0;
        advance();

        wt::ModulationProgramUpload invalidProgram = cutoffProgram (2);
        invalidProgram.voiceRackRouteTargets[0] = wt::rackModTargetGlobalFilterResonance;
        engineModulated.modulationProgramIn <- invalidProgram;
        engineModulated.advance();
        out <- (std::intrinsics::abs (engineModulated.rackModOut[cutoffTarget] + 1.8f) < 0.001f) ? 1 : 0;
        advance();

        wt::ModulationAmountUpload amountUpdate;
        amountUpdate.dspSessionId = int32 (processor.session);
        amountUpdate.deliverySerial = 2;
        amountUpdate.pathKind = wt::modulationPathVoiceRack;
        amountUpdate.cellIndex = 6 * wt::rackModTargetCount + cutoffTarget;
        amountUpdate.amount = -1.0f;
        engineModulated.modulationAmountIn <- amountUpdate;
        for (int32 frame = 0; frame < 4096; ++frame)
            engineModulated.advance();
        out <- (std::intrinsics::abs (engineModulated.rackModOut[cutoffTarget] + 0.6f) < 0.001f) ? 1 : 0;
        advance();

        // A note release remains a participant until the fixed 200 ms amp tail
        // retires. The rack then executes its pinned 180 ms gate release at the
        // audio rate and the 5 ms smoother settles to exact zero.
        engineModulated.voiceEventIn[0] <- std::notes::NoteOff (0, 60.0f, 0.0f);
        engineModulated.voiceEventIn[1] <- std::notes::NoteOff (0, 60.0f, 0.0f);
        for (int32 frame = 0; frame < int32 (0.21f * float32 (processor.frequency)); ++frame)
            engineModulated.advance();
        out <- (std::intrinsics::abs (engineModulated.rackModOut[cutoffTarget]) > 0.4f) ? 1 : 0;
        advance();
        for (int32 frame = 0; frame < int32 (0.23f * float32 (processor.frequency)); ++frame)
            engineModulated.advance();
        out <- (engineModulated.rackModOut[cutoffTarget] == 0.0f) ? 1 : 0;
        advance();

        // Removing then re-adding a route that was in release must not resurrect
        // the removed cell's held source or gate after the output settles.
        engineModulated.voiceEventIn[0] <- noteOn (0.6f);
        for (int32 frame = 0; frame < 4096; ++frame)
            engineModulated.advance();
        engineModulated.voiceEventIn[0] <- std::notes::NoteOff (0, 60.0f, 0.0f);
        for (int32 frame = 0; frame < int32 (0.30f * float32 (processor.frequency)); ++frame)
            engineModulated.advance();
        out <- (std::intrinsics::abs (engineModulated.rackModOut[cutoffTarget]) > 0.1f) ? 1 : 0;
        advance();

        // Preserve a fully populated payload behind a zero active count. Removal
        // must clear the old held sources/gates and the inactive tail must never
        // contribute to rack output.
        wt::ModulationProgramUpload inactiveTailProgram = cutoffProgram (3);
        inactiveTailProgram.voiceRackRouteCount = 0;
        engineModulated.modulationProgramIn <- inactiveTailProgram;
        for (int32 frame = 0; frame < int32 (0.10f * float32 (processor.frequency)); ++frame)
            engineModulated.advance();
        out <- (std::intrinsics::abs (engineModulated.rackModOut[cutoffTarget]) < 0.001f) ? 1 : 0;
        advance();
        wt::ModulationProgramUpload readdedProgram = cutoffProgram (4);
        readdedProgram.voiceRackRouteAmounts[6 * wt::rackModTargetCount + cutoffTarget] = -1.0f;
        engineModulated.modulationProgramIn <- readdedProgram;
        for (int32 frame = 0; frame < int32 (0.02f * float32 (processor.frequency)); ++frame)
            engineModulated.advance();
        out <- (std::intrinsics::abs (engineModulated.rackModOut[cutoffTarget]) < 0.001f) ? 1 : 0;
        advance();

        out <- -1;
        advance();
    }
}

//==============================================================================
// MACRO-rack live amount edits are SURGICAL.
//
// The macro tables run as 39-wide blocked vectors, and the live amount-edit
// path once collapsed the blocked subscript: one edit smeared its scale across
// an entire block (audibly detuning every other macro route from that source).
// Two routes from macro 1 - one static-block target, one lane-pool mirror -
// each edited in turn: only the edited lane may move, and unrouted lanes in
// every block must stay at exact zero.

## testProcessor()

processor MacroRackAmountEditIsolation [[ main ]]
{
    output stream int32 out;

    node engine = wt::SharedVoiceEngine (2);
    node assertFoldGlobalFilter = wt::GlobalFilterBus;
    node assertFoldDistortion   = wt::DistortionBus;
    node assertFoldOtt          = wt::OttBus;
    node assertFoldChorus       = wt::ChorusBus;
    node assertFoldFlanger      = wt::FlangerBus;
    node assertFoldPhaser      = wt::PhaserBus;
    node assertFoldDelay        = wt::DelayBus;
    node assertFoldReverb       = wt::ReverbBus;

    let cutoffTarget = wt::rackModTargetGlobalFilterCutoffOctaves;
    let laneCutoffTarget = wt::rackModTargetLaneGlobalFilterCutoffOctaves;

    wt::ModulationProgramUpload scratch;

    void buildMacroProgram (int32 serial)
    {
        wt::ModulationProgramUpload upload;
        scratch = upload;
        scratch.dspSessionId = int32 (processor.session);
        scratch.deliverySerial = serial;
        scratch.macroRackRouteCount = 2;
        scratch.macroRackRouteCells[0] = cutoffTarget;
        scratch.macroRackRouteSources[0] = 0;
        scratch.macroRackRouteTargets[0] = cutoffTarget;
        scratch.macroRackRoutePolarities[0] = wt::modulationPolarityUnipolar;
        scratch.macroRackRouteAmounts[cutoffTarget] = -2.0f;
        scratch.macroRackRouteCells[1] = laneCutoffTarget;
        scratch.macroRackRouteSources[1] = 0;
        scratch.macroRackRouteTargets[1] = laneCutoffTarget;
        scratch.macroRackRoutePolarities[1] = wt::modulationPolarityUnipolar;
        scratch.macroRackRouteAmounts[laneCutoffTarget] = 1.5f;
    }

    void main()
    {
        engine.macro1In <- 1.0f;
        buildMacroProgram (1);
        engine.modulationProgramIn <- scratch;

        for (int32 frame = 0; frame < 4096; ++frame)
            engine.advance();

        out <- (std::intrinsics::abs (engine.rackModOut[cutoffTarget] + 2.0f) < 0.001f) ? 1 : 0;
        advance();
        out <- (std::intrinsics::abs (engine.rackModOut[laneCutoffTarget] - 1.5f) < 0.001f) ? 1 : 0;
        advance();

        // Edit the LANE route: its own lane follows, the static lane holds.
        wt::ModulationAmountUpload edit;
        edit.dspSessionId = int32 (processor.session);
        edit.deliverySerial = 2;
        edit.pathKind = wt::modulationPathMacroRack;
        edit.cellIndex = laneCutoffTarget;
        edit.amount = 0.5f;
        engine.modulationAmountIn <- edit;

        for (int32 frame = 0; frame < 4096; ++frame)
            engine.advance();

        out <- (std::intrinsics::abs (engine.rackModOut[laneCutoffTarget] - 0.5f) < 0.001f
                 && std::intrinsics::abs (engine.rackModOut[cutoffTarget] + 2.0f) < 0.001f) ? 1 : 0;
        advance();

        // Edit the STATIC route: same in the other direction.
        edit.deliverySerial = 3;
        edit.cellIndex = cutoffTarget;
        edit.amount = -1.0f;
        engine.modulationAmountIn <- edit;

        for (int32 frame = 0; frame < 4096; ++frame)
            engine.advance();

        out <- (std::intrinsics::abs (engine.rackModOut[cutoffTarget] + 1.0f) < 0.001f
                 && std::intrinsics::abs (engine.rackModOut[laneCutoffTarget] - 0.5f) < 0.001f) ? 1 : 0;
        advance();

        // No smear anywhere: every unrouted lane in every block stays exact zero.
        float32 smearResidue;

        for (wrap<wt::rackModTargetCount> target)
            if (int32 (target) != cutoffTarget && int32 (target) != laneCutoffTarget)
                smearResidue = std::intrinsics::max (
                    smearResidue,
                    std::intrinsics::abs (engine.rackModOut[target]));

        out <- (smearResidue == 0.0f) ? 1 : 0;
        advance();

        out <- -1;
        advance();
    }
}
