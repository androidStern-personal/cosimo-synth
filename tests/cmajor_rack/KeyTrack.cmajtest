## global ("../../cmajor/KeyTrack.cmajor")

## testProcessor()

processor SharedKeyTrackMathTest [[ main ]]
{
    output stream int32 out;

    bool approximately (float32 actual, float32 expected, float32 tolerance)
    {
        return std::intrinsics::abs (actual - expected) <= tolerance;
    }

    void main()
    {
        // Frequency: continuous offsets add once; +12 doubles.
        out <- approximately (wt::keyTrackFrequencyHz (440.0f, 12.0f, 20.0f, 20000.0f), 880.0f, 0.001f) ? 1 : 0;
        advance();
        out <- approximately (
            wt::keyTrackFrequencyHz (440.0f, 0.5f, 20.0f, 20000.0f),
            440.0f * std::intrinsics::pow (2.0f, 0.5f / 12.0f),
            0.001f) ? 1 : 0;
        advance();

        // Tuned periods: +12 halves time, including continuous offsets.
        out <- approximately (
            wt::keyTrackPeriodMilliseconds (440.0f, 12.0f, 0.2f, 2000.0f),
            1000.0f / 880.0f,
            0.001f) ? 1 : 0;
        advance();
        out <- approximately (
            wt::keyTrackPeriodMilliseconds (440.0f, 0.5f, 0.2f, 2000.0f),
            (1000.0f / 440.0f) / std::intrinsics::pow (2.0f, 0.5f / 12.0f),
            0.001f) ? 1 : 0;
        advance();

        // Off is byte-contract compatible: ordinary values stay authoritative,
        // and the old octave route signs do not change.
        out <- approximately (
            wt::resolveKeyTrackedFrequencyHz (0.0f, 1000.0f, 440.0f, 9.0f, 12.0f, 20.0f, 20000.0f),
            2000.0f,
            0.001f) ? 1 : 0;
        advance();
        out <- approximately (
            wt::resolveKeyTrackedPeriodMilliseconds (0.0f, 375.0f, 440.0f, 9.0f, 12.0f, 1.0f, 2000.0f),
            750.0f,
            0.001f) ? 1 : 0;
        advance();

        // On ignores ordinary values and combines base + route before conversion.
        out <- approximately (
            wt::resolveKeyTrackedFrequencyHz (1.0f, 7321.25f, 440.0f, 3.25f, 0.75f, 20.0f, 20000.0f),
            440.0f * std::intrinsics::pow (2.0f, 4.0f / 12.0f),
            0.001f) ? 1 : 0;
        advance();
        out <- approximately (
            wt::resolveKeyTrackedPeriodMilliseconds (1.0f, 777.0f, 440.0f, 11.25f, 0.75f, 1.0f, 2000.0f),
            1000.0f / 880.0f,
            0.001f) ? 1 : 0;
        advance();

        // Clamp happens after conversion.
        out <- (wt::keyTrackFrequencyHz (20000.0f, 12.0f, 20.0f, 20000.0f) == 20000.0f) ? 1 : 0;
        advance();

        // The converted/clamped target is what the continuous one-pole sees,
        // and its coefficient cannot overshoot either endpoint.
        let smoothingCoefficient = wt::keyTrackOnePoleCoefficient (48000.0f);
        let clampedTarget = wt::keyTrackFrequencyHz (
            20000.0f, 12.0f, 20.0f, 20000.0f);
        let smoothed = wt::advanceKeyTrackSmoothedValue (
            1000.0f, clampedTarget, smoothingCoefficient);
        out <- (smoothingCoefficient > 0.0f && smoothingCoefficient < 1.0f) ? 1 : 0;
        advance();
        out <- (smoothed > 1000.0f && smoothed < clampedTarget) ? 1 : 0;
        advance();

        out <- -1;
        advance();
    }
}
