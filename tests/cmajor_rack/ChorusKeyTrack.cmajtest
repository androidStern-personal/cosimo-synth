## global ("../../cmajor/KeyTrack.cmajor")

## testFunction()

bool approximately (float32 actual, float32 expected)
{
    return std::intrinsics::abs (actual - expected) <= 0.0001f;
}

bool testKeyTrackAddsTheRouteToTheOffsetWithoutClamping()
{
    let playedPitchHz = 220.0f;
    let tracked = wt::resolveChorusRingFrequencyHz (
        1.0f, 28.0f, playedPitchHz, 7.0f, 4.125f, 0.1f, 20000.0f);
    let expected = wt::keyTrackFrequencyHz (playedPitchHz, 11.125f, 0.1f, 20000.0f);
    let below = wt::resolveChorusRingFrequencyHz (
        1.0f, 28.0f, playedPitchHz, -12.0f, -4.375f, 0.1f, 20000.0f);
    return approximately (tracked, expected)
        && approximately (below, wt::keyTrackFrequencyHz (playedPitchHz, -16.375f, 0.1f, 20000.0f));
}

bool testKeyTrackOffKeepsTheOrdinaryFixedFrequencyPath()
{
    let atLowPlayedPitch = wt::resolveChorusRingFrequencyHz (
        0.0f, 28.0f, 110.0f, 7.0f, 1.25f, 0.1f, 20000.0f);
    let atHighPlayedPitch = wt::resolveChorusRingFrequencyHz (
        0.0f, 28.0f, 880.0f, 7.0f, 1.25f, 0.1f, 20000.0f);
    return atLowPlayedPitch == atHighPlayedPitch
        && atLowPlayedPitch == wt::resolveKeyTrackedFrequencyHz (
            0.0f, 28.0f, 440.0f, 0.0f, 1.25f, 0.1f, 20000.0f);
}

bool testMemoizedResolverMatchesTheDirectResolver()
{
    wt::ExactPow2Memo memo;
    let direct = wt::resolveChorusRingFrequencyHz (
        1.0f, 28.0f, 330.0f, 3.5f, -1.25f, 0.1f, 20000.0f);
    let memoized = wt::resolveChorusRingFrequencyHzMemoized (
        memo, 1.0f, 28.0f, 330.0f, 3.5f, -1.25f, 0.1f, 20000.0f);
    return direct == memoized;
}
