// Wire-contract and pure-math tests for production rack modulation. Stateful
// Mean/Max reduction is tested through SharedVoiceEngine in
// RackModulationProducer.cmajtest; this file deliberately contains no shadow
// reducer implementation.

## global ("../../cmajor/Mseg.cmajor", "../../cmajor/FixedFrameOscillator.cmajor", "../../cmajor/VoiceReducer.cmajor")

## testFunction()

bool testReducerWireValuesKeepZeroInvalid()
{
    return wt::modulationReducerMaximum == 1
        && wt::modulationReducerMean == 2;
}

bool testCompleteMappingDomainCellCountsArePinned()
{
    // 1,131 static legal pairs (the enumerable UI domain, unchanged) plus the
    // Effects Lane pool block's cells: 4 pool destinations x 13 sources = 52.
    // Pool PAIRS are per-patch dynamic (they exist only while a lane device
    // does), so they widen the cell tables without joining the static domain.
    return wt::modulationVoiceRouteCellCount
            + wt::modulationMacroVoiceRouteCellCount
            + wt::modulationVoiceRackRouteCellCount
            + wt::modulationMacroRackRouteCellCount
        == 1131 + ((wt::modulationVoiceSourceCount + wt::modulationMacroSourceCount) * wt::laneModPoolTargetCount);
    // (13 sources x 36 mirror lanes = 468 pool cells; static pairs stay 1,131.)
}

bool testRackDestinationVocabularyIsCompleteAndContiguous()
{
    // The STATIC vocabulary stays 36 named, contiguous base-module
    // destinations; the Effects Lane pool block follows it on the same bus
    // (M1: delay #2's four destinations), and the bus width is their sum.
    return wt::rackModStaticTargetCount == 36
        && wt::rackModTargetGlobalFilterCutoffOctaves == 0
        && wt::rackModTargetReverbMix == wt::rackModStaticTargetCount - 1
        && wt::rackModTargetLaneGlobalFilterCutoffOctaves == wt::rackModStaticTargetCount
        && wt::rackModTargetLaneReverbMix == wt::rackModTargetCount - 1
        && wt::laneModPoolTargetCount == wt::rackModStaticTargetCount
        && wt::rackModTargetCount == 72;
}

bool testRackSmoothingAndReleaseTimingContractsArePinned()
{
    return wt::rackModSmoothingMs == 5.0f
        && wt::rackModGateReleaseMs == 180.0f;
}

wt::ModulationProgramUpload validProgramWithEveryLane()
{
    wt::ModulationProgramUpload program;

    program.voiceRouteCount = 1;
    program.voiceRouteCells[0] = 0;
    program.voiceRouteSources[0] = 0;
    program.voiceRouteTargets[0] = 0;
    program.voiceRoutePolarities[0] = wt::modulationPolarityUnipolar;

    program.macroVoiceRouteCount = 1;
    program.macroVoiceRouteCells[0] = 0;
    program.macroVoiceRouteSources[0] = 0;
    program.macroVoiceRouteTargets[0] = 0;
    program.macroVoiceRoutePolarities[0] = wt::modulationPolarityUnipolar;

    program.voiceRackRouteCount = 1;
    program.voiceRackRouteCells[0] = 0;
    program.voiceRackRouteSources[0] = 0;
    program.voiceRackRouteTargets[0] = 0;
    program.voiceRackRoutePolarities[0] = wt::modulationPolarityUnipolar;
    program.voiceRackRouteReducers[0] = wt::modulationReducerMaximum;

    program.macroRackRouteCount = 1;
    program.macroRackRouteCells[0] = 0;
    program.macroRackRouteSources[0] = 0;
    program.macroRackRouteTargets[0] = 0;
    program.macroRackRoutePolarities[0] = wt::modulationPolarityUnipolar;

    return program;
}

bool testVoiceProgramValidationRejectsEveryMalformedField()
{
    wt::ModulationProgramUpload valid = validProgramWithEveryLane();
    if (! wt::isValidModulationProgram (valid)) return false;

    wt::ModulationProgramUpload malformed = valid;
    malformed.voiceRouteCount = -1;
    if (wt::isValidModulationProgram (malformed)) return false;
    malformed = valid;
    malformed.voiceRouteCount = wt::modulationVoiceRouteCellCount + 1;
    if (wt::isValidModulationProgram (malformed)) return false;
    malformed = valid;
    malformed.voiceRouteCells[0] = -1;
    if (wt::isValidModulationProgram (malformed)) return false;
    malformed = valid;
    malformed.voiceRouteSources[0] = wt::modulationVoiceSourceCount;
    if (wt::isValidModulationProgram (malformed)) return false;
    malformed = valid;
    malformed.voiceRouteTargets[0] = wt::modulationVoiceTargetCount;
    if (wt::isValidModulationProgram (malformed)) return false;
    malformed = valid;
    malformed.voiceRouteCells[0] = 1;
    if (wt::isValidModulationProgram (malformed)) return false;
    malformed = valid;
    malformed.voiceRoutePolarities[0] = 2;
    if (wt::isValidModulationProgram (malformed)) return false;
    malformed = valid;
    malformed.voiceRouteCount = 2;
    malformed.voiceRouteCells[1] = 0;
    malformed.voiceRouteSources[1] = 0;
    malformed.voiceRouteTargets[1] = 0;
    malformed.voiceRoutePolarities[1] = wt::modulationPolarityUnipolar;
    return ! wt::isValidModulationProgram (malformed);
}

