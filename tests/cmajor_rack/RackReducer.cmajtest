bool testPolaritySemanticsAreSharedByEveryPath()
{
    return wt::applyModulationPolarity (0.25f, wt::modulationPolarityUnipolar) == 0.25f
        && wt::applyModulationPolarity (0.25f, wt::modulationPolarityBipolar) == -0.5f
        && wt::applyModulationPolarity (0.75f, wt::modulationPolarityBipolar) == 0.5f;
}

bool testGateReleaseStepReachesExactZeroInTheDeclaredTime()
{
    let sampleRate = 48000.0f;
    let step = wt::rackModGateReleaseStep (sampleRate);
    let frameCount = int32 (wt::rackModGateReleaseMs * 0.001f * sampleRate);
    float32 gate = 1.0f;

    for (int32 frame = 0; frame < frameCount + 2; ++frame)
        gate = std::intrinsics::max (0.0f, gate - step);

    return wt::rackModGateReleaseMs >= 50.0f
        && wt::rackModGateReleaseMs <= 1000.0f
        && gate == 0.0f;
}

bool testGateReleaseRetainsItsLinearRampShape()
{
    let sampleRate = 48000.0f;
    let step = wt::rackModGateReleaseStep (sampleRate);
    let frameCount = int32 (wt::rackModGateReleaseMs * 0.001f * sampleRate);
    float32 gate = 1.0f;
    float32 quarter;
    float32 halfway;
    float32 threeQuarters;
    bool monotonic = true;

    for (int32 frame = 1; frame <= frameCount + 2; ++frame)
    {
        let previous = gate;
        gate = std::intrinsics::max (0.0f, gate - step);
        if (gate > previous)
            monotonic = false;
        if (frame == frameCount / 4) quarter = gate;
        if (frame == frameCount / 2) halfway = gate;
        if (frame == (frameCount * 3) / 4) threeQuarters = gate;
    }

    return monotonic
        && std::intrinsics::abs (quarter - 0.75f) < 0.001f
        && std::intrinsics::abs (halfway - 0.50f) < 0.001f
        && std::intrinsics::abs (threeQuarters - 0.25f) < 0.001f
        && gate == 0.0f;
}

bool testSmootherCoefficientIsStableAtFortyEightKhz()
{
    let coefficient = wt::rackModOnePoleCoefficient (wt::rackModSmoothingMs, 48000.0f);
    return coefficient > 0.0f && coefficient < 1.0f;
}

bool testSmootherRetainsItsFiveMillisecondTimeConstant()
{
    let sampleRate = 48000.0f;
    let coefficient = wt::rackModOnePoleCoefficient (wt::rackModSmoothingMs, sampleRate);
    let timeConstantFrames = int32 (wt::rackModSmoothingMs * 0.001f * sampleRate);
    float32 value = 0.0f;

    for (int32 frame = 0; frame < timeConstantFrames; ++frame)
        value = wt::rackModSmoothTowards (value, 1.0f, coefficient);

    return timeConstantFrames == 240
        && value > 0.60f
        && value < 0.68f;
}

bool testSmootherConvergesWithoutOvershootAndSnapsExactly()
{
    let coefficient = wt::rackModOnePoleCoefficient (wt::rackModSmoothingMs, 48000.0f);
    float32 value = 0.0f;

    for (int32 frame = 0; frame < 8192; ++frame)
    {
        value = wt::rackModSmoothTowards (value, 0.8f, coefficient);
        if (value > 0.8f)
            return false;
    }

    let snapped = wt::rackModSmoothTowards (0.7999995f, 0.8f, coefficient);
    return std::intrinsics::abs (value - 0.8f) < 0.00001f
        && snapped == 0.8f;
}
