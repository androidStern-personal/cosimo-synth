        source.keyTrackOffsetOut -> combined.voiceEnhancerKeyTrackOffsetSemitonesIn,
                                    low.voiceEnhancerKeyTrackOffsetSemitonesIn,
                                    high.voiceEnhancerKeyTrackOffsetSemitonesIn;
        combined.out -> witness.combinedIn;
        low.out -> witness.lowIn;
        high.out -> witness.highIn;
