processor VoiceEnhancerPolyphonicKeyTrackWitness
{
    input stream float32<2> combinedIn;
    input stream float32<2> lowIn;
    input stream float32<2> highIn;
    output event int32 out;

    bool matchedIndependentNotes = true;
    bool heardDifferentCentres;

    void main()
    {
        for (int32 frame = 0; ; ++frame)
        {
            if (frame >= 16 && frame < 96)
            {
                if (std::intrinsics::abs (
                        combinedIn[0] - (lowIn[0] + highIn[0])) > 0.0001f
                    || std::intrinsics::abs (
                        combinedIn[1] - (lowIn[1] + highIn[1])) > 0.0001f)
                    matchedIndependentNotes = false;
                if (std::intrinsics::abs (lowIn[0] - highIn[0]) > 0.000002f
                    || std::intrinsics::abs (lowIn[1] - highIn[1]) > 0.000002f)
                    heardDifferentCentres = true;
            }

            if (frame == 96) out <- matchedIndependentNotes ? 1 : 0;
            if (frame == 97) out <- heardDifferentCentres ? 1 : 0;
            if (frame == 98) out <- -1;
            advance();
        }
    }
}

// Frequency, Q, and Amount are three ordinary per-voice modulation targets.
// The same frequency route is interpreted as octave motion while fixed and
// as a continuous ratio offset while tracked.

## testProcessor (undefined, { frequency: 600 })

graph VoiceEnhancerModulationExecution [[ main ]]
{
    output event int32 out;

    node source = VoiceEnhancerModulationSource;
    node routed = wt::SharedVoiceEngine (1);
    node direct = wt::SharedVoiceEngine (1);
    node witness = VoiceEnhancerModulationWitness;

    connection
    {
        source.noteOut -> routed.voiceEventIn[0], direct.voiceEventIn[0];
        source.programOut -> routed.modulationProgramIn;
        source.attackOut -> routed.ampAttackIn, direct.ampAttackIn;
        source.decayOut -> routed.ampDecayIn, direct.ampDecayIn;
        source.sustainOut -> routed.ampSustainIn, direct.ampSustainIn;
        source.releaseOut -> routed.ampReleaseIn, direct.ampReleaseIn;
        source.filterModeOut -> routed.filterModeIn, direct.filterModeIn;
        source.routedFrequencyOut -> routed.voiceEnhancerFrequencyIn;
        source.directFrequencyOut -> direct.voiceEnhancerFrequencyIn;
        source.routedQOut -> routed.voiceEnhancerQIn;
        source.directQOut -> direct.voiceEnhancerQIn;
        source.routedAmountOut -> routed.voiceEnhancerAmountIn;
        source.directAmountOut -> direct.voiceEnhancerAmountIn;
        routed.out -> witness.routedIn;
        direct.out -> witness.directIn;
        witness.out -> out;
    }
}

processor VoiceEnhancerModulationSource
{
    output event std::notes::NoteOn noteOut;
    output event wt::ModulationProgramUpload programOut;
    output value float32 attackOut;
    output value float32 decayOut;
    output value float32 sustainOut;
    output value float32 releaseOut;
    output value float32 filterModeOut;
    output value float32 routedFrequencyOut;
    output value float32 directFrequencyOut;
    output value float32 routedQOut;
    output value float32 directQOut;
    output value float32 routedAmountOut;
    output value float32 directAmountOut;

    wt::ModulationProgramUpload program()
    {
        wt::ModulationProgramUpload upload;
        upload.dspSessionId = int32 (processor.session);
        upload.deliverySerial = 1;
        let velocitySource = 6;
        let frequencyCell = velocitySource * wt::modulationVoiceTargetCount
            + wt::modulationTargetVoiceEnhancerFrequencyOctaves;
        let qCell = velocitySource * wt::modulationVoiceTargetCount
            + wt::modulationTargetVoiceEnhancerQ;
        let amountCell = velocitySource * wt::modulationVoiceTargetCount
            + wt::modulationTargetVoiceEnhancerAmount;
        upload.voiceRouteCount = 3;
        upload.voiceRouteCells[0] = frequencyCell;
        upload.voiceRouteCells[1] = qCell;
        upload.voiceRouteCells[2] = amountCell;
        upload.voiceRouteSources[0] = velocitySource;
        upload.voiceRouteSources[1] = velocitySource;
        upload.voiceRouteSources[2] = velocitySource;
        upload.voiceRouteTargets[0]
            = wt::modulationTargetVoiceEnhancerFrequencyOctaves;
        upload.voiceRouteTargets[1] = wt::modulationTargetVoiceEnhancerQ;
        upload.voiceRouteTargets[2] = wt::modulationTargetVoiceEnhancerAmount;
        upload.voiceRoutePolarities[0] = wt::modulationPolarityUnipolar;
        upload.voiceRoutePolarities[1] = wt::modulationPolarityUnipolar;
        upload.voiceRoutePolarities[2] = wt::modulationPolarityUnipolar;
        upload.voiceRouteAmounts[frequencyCell] = 1.0f;
        upload.voiceRouteAmounts[qCell] = 0.49f;
        upload.voiceRouteAmounts[amountCell] = 0.4f;
        return upload;
    }

    std::notes::NoteOn noteOn()
    {
        std::notes::NoteOn note;
        note.channel = 0;
        note.pitch = 60.0f;
        note.velocity = 1.0f;
        return note;
    }

    void main()
    {
        attackOut <- 0.001f;
        decayOut <- 0.001f;
        sustainOut <- 1.0f;
        releaseOut <- 0.02f;
        filterModeOut <- 0.0f;
        routedFrequencyOut <- 130.0f;
        directFrequencyOut <- 260.0f;
        routedQOut <- 0.71f;
        directQOut <- 1.2f;
        routedAmountOut <- 0.5f;
        directAmountOut <- 0.9f;
        programOut <- program();
        advance();
        noteOut <- noteOn();
        loop advance();
    }
}

processor VoiceEnhancerModulationWitness
{
    input stream float32<2> routedIn;
    input stream float32<2> directIn;
    output event int32 out;

    bool matched = true;
    bool heardEffect;

    void main()
    {
        for (int32 frame = 0; ; ++frame)
        {
            if (frame >= 12 && frame < 90)
            {
                if (std::intrinsics::abs (routedIn[0] - directIn[0]) > 0.000002f
                    || std::intrinsics::abs (routedIn[1] - directIn[1]) > 0.000002f)
                    matched = false;
                if (std::intrinsics::abs (directIn[0] - 0.75f) > 0.000002f
                    || std::intrinsics::abs (directIn[1] + 0.5f) > 0.000002f)
                    heardEffect = true;
            }

            if (frame == 90) out <- matched ? 1 : 0;
            if (frame == 91) out <- heardEffect ? 1 : 0;
            if (frame == 92) out <- -1;
            advance();
        }
    }
}

// A stolen/retriggered slot resets its Mid, Side, coefficient, and ADAA
// histories. The shared post-sum blocker is flushed at Amount 0 first so this
// comparison isolates the voice-owned lifecycle from intentional bus history.

## testProcessor (undefined, { frequency: 600 })

graph VoiceEnhancerStealReset [[ main ]]
{
    output event int32 out;

    node source = VoiceEnhancerStealResetSource;
    node reused = wt::SharedVoiceEngine (1);
    node fresh = wt::SharedVoiceEngine (1);
    node witness = VoiceEnhancerStealResetWitness;

    connection
    {
        source.firstNoteOut -> reused.voiceEventIn[0];
        source.secondReusedNoteOut -> reused.voiceEventIn[0];
        source.secondFreshNoteOut -> fresh.voiceEventIn[0];
        source.attackOut -> reused.ampAttackIn, fresh.ampAttackIn;
        source.decayOut -> reused.ampDecayIn, fresh.ampDecayIn;
        source.sustainOut -> reused.ampSustainIn, fresh.ampSustainIn;
        source.releaseOut -> reused.ampReleaseIn, fresh.ampReleaseIn;
        source.filterModeOut -> reused.filterModeIn, fresh.filterModeIn;
        source.frequencyOut -> reused.voiceEnhancerFrequencyIn,
                               fresh.voiceEnhancerFrequencyIn;
        source.qOut -> reused.voiceEnhancerQIn, fresh.voiceEnhancerQIn;
        source.amountOut -> reused.voiceEnhancerAmountIn,
                            fresh.voiceEnhancerAmountIn;
        source.keyTrackEnabledOut -> reused.voiceEnhancerKeyTrackEnabledIn,
                                     fresh.voiceEnhancerKeyTrackEnabledIn;
        reused.out -> witness.reusedIn;
        fresh.out -> witness.freshIn;
        witness.out -> out;
    }
}

processor VoiceEnhancerStealResetSource
{
    output event std::notes::NoteOn firstNoteOut;
    output event std::notes::NoteOn secondReusedNoteOut;
    output event std::notes::NoteOn secondFreshNoteOut;
    output value float32 attackOut;
    output value float32 decayOut;
    output value float32 sustainOut;
    output value float32 releaseOut;
    output value float32 filterModeOut;
    output value float32 frequencyOut;
    output value float32 qOut;
    output value float32 amountOut;
    output value float32 keyTrackEnabledOut;

    std::notes::NoteOn noteOn (float32 pitch)
    {
        std::notes::NoteOn note;
        note.channel = 0;
        note.pitch = pitch;
        note.velocity = 1.0f;
        return note;
    }

    void main()
    {
        attackOut <- 0.001f;
        decayOut <- 0.001f;
        sustainOut <- 1.0f;
        releaseOut <- 0.02f;
        filterModeOut <- 0.0f;
        frequencyOut <- 130.0f;
        qOut <- 0.71f;
        amountOut <- 0.9f;
        keyTrackEnabledOut <- 1.0f;
        advance();
        firstNoteOut <- noteOn (36.0f);
        for (int32 frame = 0; frame < 36; ++frame)
            advance();

        amountOut <- 0.0f;
        advance();
        amountOut <- 0.9f;
        secondReusedNoteOut <- noteOn (72.0f);
        // At 600 Hz the production 1.5 ms steal fade is exactly one frame.
        // Start the fresh reference when the reused slot's deferred note
        // actually begins, so this isolates the post-fade lifecycle reset.
        advance();
        secondFreshNoteOut <- noteOn (72.0f);
        loop advance();
    }
}

processor VoiceEnhancerStealResetWitness
{
    input stream float32<2> reusedIn;
    input stream float32<2> freshIn;
    output event int32 out;

    bool matchedFresh = true;
    bool heardSecondNote;

    void main()
    {
        for (int32 frame = 0; ; ++frame)
        {
            if (frame >= 40 && frame < 88)
            {
                if (reusedIn[0] != freshIn[0] || reusedIn[1] != freshIn[1])
                    matchedFresh = false;
                if (std::intrinsics::abs (freshIn[0]) > 0.01f
                    || std::intrinsics::abs (freshIn[1]) > 0.01f)
                    heardSecondNote = true;
            }

            if (frame == 88) out <- matchedFresh ? 1 : 0;
            if (frame == 89) out <- heardSecondNote ? 1 : 0;
            if (frame == 90) out <- -1;
            advance();
        }
    }
}
