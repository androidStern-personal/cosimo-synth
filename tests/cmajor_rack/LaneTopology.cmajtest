// Behavioural contract for the Effects Lane pool (M1 slice 1): the rack accepts a
// LaneTopologyUpload placing a SECOND delay instance in a serial chain, per-slot
// parameters address the pool instance individually, and the rendered audio proves
// two INDEPENDENT delay lines with distinct times.
//
// The discrimination this pins: an impulse through delay(40ms, mix .5) -> delay#2
// (90ms, mix .5) with zero feedback produces echoes at 40ms, 90ms, AND 130ms. The
// 90ms echo can only exist if the second instance is a real, individually
// addressable delay line — a rack with one delay cannot produce it.
//
// `## testProcessor()` renders exactly 100 frames in ONE block and scans the first
// output endpoint: <0 stops, >0 is a pass, ==0 is a failure. The composed rack is
// advanced by hand inside main(), so multi-thousand-frame echoes are reachable.
//
// NOTE (same as Delay.cmajtest): a composed child's `init:` annotations are INERT —
// every rack endpoint the scenario depends on is written explicitly below.

## global ("../../cmajor/Mseg.cmajor", "../../cmajor/FixedFrameOscillator.cmajor", "../../cmajor/VoiceReducer.cmajor", "../../cmajor/GlobalFilter.cmajor", "../../cmajor/Distortion.cmajor", "../../cmajor/Ott.cmajor", "../../cmajor/Chorus.cmajor", "../../cmajor/Flanger.cmajor", "../../cmajor/Phaser.cmajor", "../../cmajor/Delay.cmajor", "../../cmajor/Reverb.cmajor", "../../cmajor/EffectsRack.cmajor")

//==============================================================================
// A second delay instance in the chain is individually addressable and audible.

## testProcessor (true, { frequency: 44100, maxFrequency: 48000 })

processor LaneSecondDelayTest [[ main ]]
{
    output stream int32 out;

    node rack = wt::EffectsRack;

    // 40ms and 90ms at 44100: echoes at 1764, 3969, and (series) 5733 frames.
    let delayOneMs = 40.0f;
    let delayTwoMs = 90.0f;
    let echoOneFrame = 1764;
    let echoTwoFrame = 3969;
    let echoSumFrame = 5733;

    let settleFrames = 2048;
    let recordFrames = 6400;

    // Echo detection windows: catmull-rom interpolation and the parameter ramps
    // spread the impulse slightly, so each expected echo is scanned in a +/-8
    // frame window and each control (no-echo) point in the same window.
    let peakWindow = 8;
    let expectedPeakMinimum = 0.08f;
    let controlCeiling = 0.015f;

    float32[6400] recordedLeft;

    wt::LaneTopologyUpload makeTwoDelayChain()
    {
        wt::LaneTopologyUpload upload;
        upload.chainLength = 2;
        upload.slotIds[0] = wt::rackModuleDelay;
        upload.slotIds[1] = wt::laneSlotDelayTwo;
        upload.enabledMask = 0b11;  // both chain positions enabled
        return upload;
    }

    wt::LaneSlotParamsUpload makeDelayTwoParams()
    {
        wt::LaneSlotParamsUpload upload;
        upload.slotId = wt::laneSlotDelayTwo;
        upload.deliverySerial = 7;
        upload.values[wt::laneDelayParamTimeMs] = delayTwoMs;
        upload.values[wt::laneDelayParamFeedback] = 0.0f;
        upload.values[wt::laneDelayParamFilterHz] = 18000.0f;
        upload.values[wt::laneDelayParamMix] = 0.5f;
        return upload;
    }

    void configure()
    {
        // Delay slot #1 (the base delay) via the rack's parameter endpoints.
        rack.delayTime <- delayOneMs;
        rack.delayFeedback <- 0.0f;
        rack.delayFilter <- 18000.0f;
        rack.delayMix <- 0.5f;
        rack.tempoBpmIn <- 120.0f;

        // Pool slot delay#2, addressed individually.
        rack.laneSlotParams <- makeDelayTwoParams();
        rack.laneTopology <- makeTwoDelayChain();
    }

    void advanceRack (float32 sample)
    {
        rack.in <- float32<2> (sample, sample);
        rack.trackingPitchHzIn <- 220.0f;
        rack.advance();
    }

    float32 windowPeak (int32 center)
    {
        var peak = 0.0f;

        for (int32 offset = -peakWindow; offset <= peakWindow; ++offset)
        {
            let index = center + offset;

            if (index >= 0 && index < recordFrames)
            {
                let magnitude = std::intrinsics::abs (recordedLeft.at (index));

                if (magnitude > peak)
                    peak = magnitude;
            }
        }

        return peak;
    }

    void main()
    {
        configure();

        // Settle: parameter ramps complete and the ADR-003 transition commits
        // the lane chain (3ms ramp down + 3ms back at 44100 is ~266 frames).
        for (int32 frame = 0; frame < settleFrames; ++frame)
            advanceRack (0.0f);

        // One impulse, then silence, recording the response.
        for (int32 frame = 0; frame < recordFrames; ++frame)
        {
            advanceRack (frame == 0 ? 1.0f : 0.0f);
            recordedLeft.at (frame) = rack.out[0];
        }

        // Frame 1: the dry path passed the impulse (both delays half-dry).
        out <- (windowPeak (0) > expectedPeakMinimum ? 1 : 0);
        advance();

        // Frame 2: delay #1's own echo exists.
        out <- (windowPeak (echoOneFrame) > expectedPeakMinimum ? 1 : 0);
        advance();

        // Frame 3: THE claim — delay #2's echo exists at ITS OWN time. Only a
        // second, individually parameterised delay line can produce this.
        out <- (windowPeak (echoTwoFrame) > expectedPeakMinimum ? 1 : 0);
        advance();

        // Frame 4: the series echo proves they are chained, not parallel copies.
        out <- (windowPeak (echoSumFrame) > expectedPeakMinimum ? 1 : 0);
        advance();

        // Frame 5: a control point between the echoes stays silent — the peaks
        // are real echoes, not smear.
        out <- (windowPeak (2646) < controlCeiling ? 1 : 0);
        advance();

        // Frame 6: the committed lane generation is readable back.
        out <- (rack.laneCommittedGeneration > 0 ? 1 : 0);
        advance();

        // Frame 6b: the HOT PATH is acknowledged: an applied param record
        // echoes its delivery serial the same frame it applies, so a knob
        // drag can measure edit-to-acknowledgment latency end to end.
        out <- (rack.laneParamsAcknowledgedSerial == 7 ? 1 : 0);
        advance();

        // Frame 7: a malformed upload (duplicate slot) is rejected, counted, and
        // leaves the running chain untouched.
        wt::LaneTopologyUpload duplicate;
        duplicate.chainLength = 2;
        duplicate.slotIds[0] = wt::rackModuleDelay;
        duplicate.slotIds[1] = wt::rackModuleDelay;
        duplicate.enabledMask = 0b11;
        rack.laneTopology <- duplicate;

        for (int32 frame = 0; frame < 64; ++frame)
            advanceRack (0.0f);

        out <- (rack.laneRejectedUploadCount > 0 ? 1 : 0);
        advance();

        // Frames 8-10: pool lifecycle. Load delay #2's line with an un-emitted
        // echo, remove the slot from the chain (it sleeps, line frozen), re-add
        // it, and prove the frozen tail does NOT replay: a slot entering a
        // chain is a NEW device with an empty line. Then prove it still works.
        wt::LaneTopologyUpload oneDelay;
        oneDelay.chainLength = 1;
        oneDelay.slotIds[0] = wt::rackModuleDelay;
        oneDelay.enabledMask = 0b1;

        // Feed an impulse, then IMMEDIATELY remove delay #2 so its 90ms echo is
        // still buffered, un-emitted, when the slot goes to sleep.
        advanceRack (1.0f);

        for (int32 frame = 0; frame < 256; ++frame)
            advanceRack (0.0f);

        rack.laneTopology <- oneDelay;

        for (int32 frame = 0; frame < settleFrames; ++frame)
            advanceRack (0.0f);

        // Re-add delay #2 and let the transition commit (the entry reset fires).
        rack.laneTopology <- makeTwoDelayChain();

        for (int32 frame = 0; frame < settleFrames; ++frame)
            advanceRack (0.0f);

        // Frame 8: under silence, a full delay-two period stays silent — the
        // frozen echo from before removal never emerges.
        var stalePeak = 0.0f;

        for (int32 frame = 0; frame < echoTwoFrame + 512; ++frame)
        {
            advanceRack (0.0f);
            let magnitude = std::intrinsics::abs (rack.out[0]);

            if (magnitude > stalePeak)
                stalePeak = magnitude;
        }

        out <- (stalePeak < controlCeiling ? 1 : 0);
        advance();

        // Frames 9-10: the re-added slot still works — a fresh impulse produces
        // the 90ms echo again.
        for (int32 frame = 0; frame < recordFrames; ++frame)
        {
            advanceRack (frame == 0 ? 1.0f : 0.0f);
            recordedLeft.at (frame) = rack.out[0];
        }

        out <- (windowPeak (echoTwoFrame) > expectedPeakMinimum ? 1 : 0);
        advance();
        out <- (windowPeak (echoSumFrame) > expectedPeakMinimum ? 1 : 0);
        advance();

        // Frames 11-13: MODULATION reaches the pool instance through the ONE
        // rackMod bus, at the lane block's indices (static vocabulary + pool),
        // exactly as rackModIn drives the base modules: mix as a linear
        // offset, time in octaves.
        // Claim A: slot mix param is 0 (no echo); a +0.5 bus offset on the mix
        // lane makes the 90ms echo appear — modulation, not the base value.
        wt::LaneSlotParamsUpload silentMix = makeDelayTwoParams();
        silentMix.values[wt::laneDelayParamMix] = 0.0f;
        rack.laneSlotParams <- silentMix;

        for (int32 frame = 0; frame < 512; ++frame)
            advanceRack (0.0f);

        for (int32 frame = 0; frame < recordFrames; ++frame)
        {
            rack.rackModIn[wt::rackModTargetLaneDelayMix] <- 0.5f;
            advanceRack (frame == 0 ? 1.0f : 0.0f);
            recordedLeft.at (frame) = rack.out[0];
        }

        out <- (windowPeak (echoTwoFrame) > expectedPeakMinimum ? 1 : 0);
        advance();

        // Claim B: without the bus offset the echo is gone again (the slot's
        // own base mix is still 0) — the offset was doing the work.
        for (int32 frame = 0; frame < 512; ++frame)
            advanceRack (0.0f);

        for (int32 frame = 0; frame < recordFrames; ++frame)
        {
            rack.rackModIn[wt::rackModTargetLaneDelayMix] <- 0.0f;
            advanceRack (frame == 0 ? 1.0f : 0.0f);
            recordedLeft.at (frame) = rack.out[0];
        }

        out <- (windowPeak (echoTwoFrame) < controlCeiling ? 1 : 0);
        advance();

        // Claim C: time modulates in OCTAVES: base 90ms with a -1 octave bus
        // offset echoes at 45ms (frame 1984 at 44100), and no longer at 90ms.
        rack.laneSlotParams <- makeDelayTwoParams();

        // The delay line GLIDES time changes (40ms exponential constant):
        // settle ~5 time constants so the -1 octave target is fully reached.
        for (int32 frame = 0; frame < 12000; ++frame)
        {
            rack.rackModIn[wt::rackModTargetLaneDelayTimeOctaves] <- -1.0f;
            advanceRack (0.0f);
        }

        for (int32 frame = 0; frame < recordFrames; ++frame)
        {
            rack.rackModIn[wt::rackModTargetLaneDelayTimeOctaves] <- -1.0f;
            advanceRack (frame == 0 ? 1.0f : 0.0f);
            recordedLeft.at (frame) = rack.out[0];
        }

        out <- (windowPeak (1984) > expectedPeakMinimum && windowPeak (echoTwoFrame) < controlCeiling ? 1 : 0);
        advance();

        // Frames 14-15: a SECOND pool type proves the pattern generalizes,
        // and the reverb's fresh-entry reset (the longest tail in the rack).
        // A reverbTwo chain rings after an impulse; after removing and
        // re-adding the slot, silence in means silence out — no frozen tail.
        wt::LaneTopologyUpload reverbChain;
        reverbChain.chainLength = 1;
        reverbChain.slotIds[0] = wt::laneSlotReverbTwo;
        reverbChain.enabledMask = 0b1;

        wt::LaneSlotParamsUpload reverbParams;
        reverbParams.slotId = wt::laneSlotReverbTwo;
        reverbParams.deliverySerial = 9;
        reverbParams.values[wt::laneReverbParamSize] = 0.7f;
        reverbParams.values[wt::laneReverbParamDecay] = 0.8f;
        reverbParams.values[wt::laneReverbParamDamping] = 0.2f;
        reverbParams.values[wt::laneReverbParamMix] = 1.0f;
        rack.laneSlotParams <- reverbParams;
        rack.laneTopology <- reverbChain;

        for (int32 frame = 0; frame < settleFrames; ++frame)
            advanceRack (0.0f);

        // Impulse, then measure tail energy 300-800ms later.
        advanceRack (1.0f);
        var reverbTailPeak = 0.0f;

        for (int32 frame = 0; frame < 36000; ++frame)
        {
            advanceRack (0.0f);
            let magnitude = std::intrinsics::abs (rack.out[0]);

            if (frame > 13000 && magnitude > reverbTailPeak)
                reverbTailPeak = magnitude;
        }

        out <- (reverbTailPeak > 0.002f ? 1 : 0);
        advance();

        // Load the tail again, remove the slot mid-ring, re-add it: the
        // commit reset must leave NOTHING of the old ring.
        advanceRack (1.0f);

        for (int32 frame = 0; frame < 2000; ++frame)
            advanceRack (0.0f);

        rack.laneTopology <- oneDelay;

        for (int32 frame = 0; frame < settleFrames; ++frame)
            advanceRack (0.0f);

        rack.laneTopology <- reverbChain;

        for (int32 frame = 0; frame < settleFrames; ++frame)
            advanceRack (0.0f);

        var stalePeakReverb = 0.0f;

        for (int32 frame = 0; frame < 24000; ++frame)
        {
            advanceRack (0.0f);
            let magnitude = std::intrinsics::abs (rack.out[0]);

            if (magnitude > stalePeakReverb)
                stalePeakReverb = magnitude;
        }

        out <- (stalePeakReverb < controlCeiling ? 1 : 0);
        advance();

        // Frames 16-18: pool parameter writes are SMOOTHED like base writes,
        // and structure changes never click. A steady sine through the pool
        // delay shifts LEVEL when mix changes (dry + delayed interfere), so
        // a one-frame mix step is a one-frame level jump — the claims bound
        // per-frame motion while proving the change actually lands.
        rack.laneTopology <- makeTwoDelayChain();
        rack.laneSlotParams <- makeDelayTwoParams();

        for (int32 frame = 0; frame < settleFrames; ++frame)
            advanceRack (0.0f);

        wt::LaneSlotParamsUpload mixRecord = makeDelayTwoParams();
        mixRecord.deliverySerial = 11;
        mixRecord.values[wt::laneDelayParamMix] = 0.0f;
        rack.laneSlotParams <- mixRecord;

        int32 toneClock = 0;

        for (int32 frame = 0; frame < 6000; ++frame)
        {
            advanceRack (0.3f * float32 (std::intrinsics::sin (float32 (toneClock) * 0.05f)));
            ++toneClock;
        }

        // Level with mix 0 (dry only), then jump the record to full wet.
        var dryLevel = 0.0f;

        for (int32 frame = 0; frame < 1024; ++frame)
        {
            advanceRack (0.3f * float32 (std::intrinsics::sin (float32 (toneClock) * 0.05f)));
            ++toneClock;
            let magnitude = std::intrinsics::abs (rack.out[0]);

            if (magnitude > dryLevel)
                dryLevel = magnitude;
        }

        // Mix 0.5: at 350Hz the delayed copy lands ~3.7 rad out of phase, so
        // HALF wet cancels to ~0.26x amplitude — a strong, measurable level
        // shift (full wet would restore the original level and hide it).
        mixRecord.deliverySerial = 12;
        mixRecord.values[wt::laneDelayParamMix] = 0.5f;
        rack.laneSlotParams <- mixRecord;

        var maxFrameDelta = 0.0f;
        var previousSample = rack.out[0];

        for (int32 frame = 0; frame < 512; ++frame)
        {
            advanceRack (0.3f * float32 (std::intrinsics::sin (float32 (toneClock) * 0.05f)));
            ++toneClock;
            let sample = rack.out[0];
            let delta = std::intrinsics::abs (sample - previousSample);

            if (delta > maxFrameDelta)
                maxFrameDelta = delta;

            previousSample = sample;
        }

        // The sine's own per-frame motion is ~0.015; a one-frame full-wet
        // step adds a ~0.1+ discontinuity, a 128-frame ramp adds ~0.002.
        out <- (maxFrameDelta < 0.04f ? 1 : 0);
        advance();

        // ...and the mix change actually LANDS: the settled level differs
        // audibly from the dry-only level (interference shifts it).
        var wetLevel = 0.0f;

        for (int32 frame = 0; frame < 6000; ++frame)
        {
            advanceRack (0.3f * float32 (std::intrinsics::sin (float32 (toneClock) * 0.05f)));
            ++toneClock;
            let magnitude = std::intrinsics::abs (rack.out[0]);

            if (frame > 5000 && magnitude > wetLevel)
                wetLevel = magnitude;
        }

        out <- (std::intrinsics::abs (wetLevel - dryLevel) > 0.05f ? 1 : 0);
        advance();



        // Click-free removal: with the line ringing, drop the pool slot; the
        // ADR-003 fade must keep every frame-to-frame step small.
        rack.laneTopology <- oneDelay;

        var removalMaxDelta = 0.0f;
        previousSample = rack.out[0];

        for (int32 frame = 0; frame < 1024; ++frame)
        {
            advanceRack (0.3f * float32 (std::intrinsics::sin (float32 (toneClock) * 0.05f)));
            ++toneClock;
            let sample = rack.out[0];
            let delta = std::intrinsics::abs (sample - previousSample);

            if (delta > removalMaxDelta)
                removalMaxDelta = delta;

            previousSample = sample;
        }

        out <- (removalMaxDelta < 0.05f ? 1 : 0);
        advance();

        // Frame 18b: LIVE edits ride per-FIELD uploads: one value, one slot,
        // one serial — no whole-record read-modify-write race between UI
        // surfaces. The field write lands (audible), acks its serial, and
        // leaves every other field of the record untouched.
        wt::LaneSlotParamValueUpload fieldEdit;
        fieldEdit.slotId = wt::laneSlotDelayTwo;
        fieldEdit.paramIndex = wt::laneDelayParamMix;
        fieldEdit.deliverySerial = 31;
        fieldEdit.value = 0.5f;
        rack.laneSlotParamValue <- fieldEdit;

        for (int32 frame = 0; frame < 512; ++frame)
            advanceRack (0.0f);

        out <- (rack.laneParamsAcknowledgedSerial == 31 ? 1 : 0);
        advance();

        // The un-edited fields survive: the 90ms time is intact, so with the
        // slot back in the chain a fresh impulse still echoes at delay #2's
        // own time.
        rack.laneTopology <- makeTwoDelayChain();

        for (int32 frame = 0; frame < settleFrames; ++frame)
            advanceRack (0.0f);

        for (int32 frame = 0; frame < recordFrames; ++frame)
        {
            advanceRack (frame == 0 ? 1.0f : 0.0f);
            recordedLeft.at (frame) = rack.out[0];
        }

        out <- (windowPeak (echoTwoFrame) > expectedPeakMinimum ? 1 : 0);
        advance();

        // An out-of-range field index rejects without touching the record.
        fieldEdit.paramIndex = wt::laneSlotParamCount;
        fieldEdit.deliverySerial = 32;
        rack.laneSlotParamValue <- fieldEdit;

        for (int32 frame = 0; frame < 64; ++frame)
            advanceRack (0.0f);

        out <- (rack.laneParamsAcknowledgedSerial == 31 && rack.laneRejectedUploadCount > 1 ? 1 : 0);
        advance();

        // Frame 19: THREE delays at once — the base delay plus pool SET 0
        // and pool SET 1 instances, 40/90/140ms, all individually addressed.
        // Echoes at all three times prove multi-set instances work: the
        // "delay per band" patch shape is real.
        wt::LaneSlotParamsUpload setOneDelay;
        setOneDelay.slotId = wt::rackModuleCount + wt::rackModuleCount + wt::rackModuleDelay;
        setOneDelay.deliverySerial = 20;
        setOneDelay.values[wt::laneDelayParamTimeMs] = 140.0f;
        setOneDelay.values[wt::laneDelayParamFeedback] = 0.0f;
        setOneDelay.values[wt::laneDelayParamFilterHz] = 18000.0f;
        setOneDelay.values[wt::laneDelayParamMix] = 0.5f;
        rack.laneSlotParams <- setOneDelay;
        rack.laneSlotParams <- makeDelayTwoParams();

        wt::LaneTopologyUpload threeDelays;
        threeDelays.chainLength = 3;
        threeDelays.slotIds[0] = wt::rackModuleDelay;
        threeDelays.slotIds[1] = wt::laneSlotDelayTwo;
        threeDelays.slotIds[2] = setOneDelay.slotId;
        threeDelays.enabledMask = 0b111;
        rack.laneTopology <- threeDelays;

        for (int32 frame = 0; frame < settleFrames; ++frame)
            advanceRack (0.0f);

        for (int32 frame = 0; frame < recordFrames; ++frame)
        {
            advanceRack (frame == 0 ? 1.0f : 0.0f);
            recordedLeft.at (frame) = rack.out[0];
        }

        // 140ms at 44100 = frame 6174.
        out <- (windowPeak (echoOneFrame) > 0.05f
                 && windowPeak (echoTwoFrame) > 0.05f
                 && windowPeak (6174) > 0.05f ? 1 : 0);
        advance();

        loop
        {
            out <- 1;
            advance();
        }
    }
}
