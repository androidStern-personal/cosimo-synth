// Behavioural contract for the effects rack shell: wt::EffectsRack, its structure
// uploads and the ADR-003 transition.
//
// The rack is driven here exactly as the main graph drives it, and every child is a
// REAL production module - there are no placeholders in this file. What is pinned:
//
//   1. Rack position changes the sound, and the committed order is readable back.
//   2. Structure uploads are VALIDATED, not coerced (rack invariant C11). A rack order
//      that is not a complete permutation, or an enable flag that is not 0 or 1, is an
//      adapter bug: it is counted on a diagnostic endpoint and the running state is
//      left completely intact - including bit-exactly intact audio.
//   3. Every resident module advances EXACTLY ONCE per rack frame whatever its position
//      and whatever its enabled state. This is the one load-bearing invariant of the
//      composed-processor shape: a module advanced zero times silently re-emits its
//      previous frame, which is a corrupted time base with no error attached. It is
//      asserted BEHAVIOURALLY, on real modules, with float32 `!=` - see the two
//      equivalence tests below, which are only true if the invariant holds.
//      READ THIS BEFORE "FIXING" A FAILURE THERE. Those two tests specify the v1
//      DEFAULT, which is always-advance. They are NOT a ruling that a module may never
//      sleep while disabled: ADR-005 makes that an effect-local, profiling-driven
//      choice, and wt::rackModuleSleepsWhileDisabled is the hook for making it. What
//      they actually pin is the requirement a sleeping module would still have to meet
//      - "re-enabling must not expose an unsmoothed stale-state transient" - stated in
//      the strictest available form. A module that learns to sleep AND to wake
//      correctly is entitled to have its case here re-specified; one that simply stops
//      advancing is not.
//   4. The ADR-003 transition is ONE ramp. It reaches EXACT 0.0f, commits there, and
//      returns to EXACT unity. An upload arriving mid-transition - in either ramp
//      direction - reverses the ramp and is never stranded.
//   5. A redundant structure upload, which is what the adapter sends on every patch
//      load, costs ZERO dipped frames and burns no structure generation.
// A node cannot be passed to a function ("error: Cannot use a processor name as a
// type"), so every rack is configured and driven inline.
//
// `## testProcessor()` renders exactly 100 frames in ONE block and scans the first
// output endpoint: <0 stops, >0 is a pass, ==0 is a failure. Child nodes are advanced
// by hand inside main(), so tails longer than 100 frames are reachable.

## global ("../../cmajor/KeyTrack.cmajor", "../../cmajor/Mseg.cmajor", "../../cmajor/VoiceEnhancer.cmajor", "../../cmajor/FixedFrameOscillator.cmajor", "../../cmajor/VoiceReducer.cmajor", "../../cmajor/GlobalFilter.cmajor", "../../cmajor/Distortion.cmajor", "../../cmajor/Ott.cmajor", "../../cmajor/Chorus.cmajor", "../../cmajor/Flanger.cmajor", "../../cmajor/Phaser.cmajor", "../../cmajor/Delay.cmajor", "../../cmajor/Reverb.cmajor", "../../cmajor/EffectsRack.cmajor")

//==============================================================================
// Order, structure-upload validation, and hard audible bypass.

## testProcessor()

// HARNESS NOTE, load-bearing for every test in this file: TWO composed
// instances of the SAME event-bearing processor interact anomalously in the
// cmaj interpreter (the audio of one tracks the other while their value
// readbacks stay per-instance correct). Every test here therefore drives ONE
// rack SEQUENTIALLY: the device model makes that sound — a slot re-entering
// a chain resets to factory-fresh audio memory, so two sequential runs of
// the same structure are reproducible where the never-reset legacy modules
// were not.

processor RackStructureTest [[ main ]]
{
    output stream int32 out;

    node rack = wt::EffectsRack;

    let settleFrames = 3072;
    let measureFrames = 3072;

    // The device model carries order and participation in ONE topology: the
    // eight ordinal-0 devices in `a..h` order, with the per-POSITION enable
    // mask derived from a per-MODULE mask (bit = module id), preserving the
    // old tests' module-centric vocabulary.
    wt::LaneTopologyUpload makeChain (int32 a, int32 b, int32 c, int32 d,
                                      int32 e, int32 f, int32 g, int32 h,
                                      int32 moduleEnableMask)
    {
        wt::LaneTopologyUpload upload;
        upload.chainLength = 8;
        upload.slotIds[0] = a;
        upload.slotIds[1] = b;
        upload.slotIds[2] = c;
        upload.slotIds[3] = d;
        upload.slotIds[4] = e;
        upload.slotIds[5] = f;
        upload.slotIds[6] = g;
        upload.slotIds[7] = h;

        for (int32 position = 0; position < 8; ++position)
            if (((moduleEnableMask >> upload.slotIds.at (position)) & 1) != 0)
                upload.enabledMask |= 1 << position;

        return upload;
    }

    float32 testSignal (int32 frame)
    {
        return 0.4f * float32 (std::intrinsics::sin (float32 (frame) * 0.05f));
    }

    void sendFilterParams (float32 cutoffHz)
    {
        wt::LaneSlotParamsUpload upload;
        upload.slotId = wt::rackModuleGlobalFilter;
        upload.deliverySerial = 1;
        upload.values[wt::laneGlobalFilterParamMode] = 1.0f;
        upload.values[wt::laneGlobalFilterParamCutoffHz] = cutoffHz;
        upload.values[wt::laneGlobalFilterParamResonance] = 0.707107f;
        rack.laneSlotParams <- upload;
    }

    void sendDistortionParams (float32 wet)
    {
        wt::LaneSlotParamsUpload upload;
        upload.slotId = wt::rackModuleDistortion;
        upload.deliverySerial = 2;
        upload.values[wt::laneDistortionParamDriveDb] = 30.0f;
        upload.values[wt::laneDistortionParamKnee] = 0.35f;
        upload.values[wt::laneDistortionParamWet] = wet;
        upload.values[wt::laneDistortionParamWetHPHz] = 40.0f;
        upload.values[wt::laneDistortionParamWetLPHz] = 18000.0f;
        rack.laneSlotParams <- upload;
    }

    void configure()
    {
        // Two non-commutative modules, both driven hard enough that swapping
        // them is unmistakable: a low lowpass followed by heavy saturation is
        // not the same sound as heavy saturation followed by the same lowpass.
        sendFilterParams (800.0f);
        sendDistortionParams (1.0f);
    }

    float32<2> render (int32 frame)
    {
        rack.in <- float32<2> (testSignal (frame), testSignal (frame));
        rack.trackingPitchHzIn <- 220.0f;
        rack.advance();
        return rack.out;
    }

    // Position -> module id, packed three bits per position, least significant first.
    int32 orderCode (int32 a, int32 b, int32 c, int32 d, int32 e, int32 f, int32 g, int32 h)
    {
        return a | (b << 3) | (c << 6) | (d << 9) | (e << 12) | (f << 15) | (g << 18) | (h << 21);
    }

    float32[3072] firstRun;

    void main()
    {
        configure();

        let filterAndDrive = (1 << wt::rackModuleGlobalFilter) | (1 << wt::rackModuleDistortion);

        // Run 1: filter before distortion. Record the settled output.
        rack.laneTopology <- makeChain (0, 1, 2, 3, 4, 5, 6, 7, filterAndDrive);

        for (int32 frame = 0; frame < settleFrames; ++frame)
            render (frame);

        for (int32 frame = 0; frame < measureFrames; ++frame)
            firstRun.at (frame) = render (frame)[0];

        out <- (rack.laneCommittedChainCode == orderCode (0, 1, 2, 3, 4, 5, 6, 7)) ? 1 : 0;
        advance();
        out <- (rack.laneCommittedPositionMask == 0b11) ? 1 : 0;
        advance();
        out <- (rack.laneCommittedGeneration == 1) ? 1 : 0;
        advance();

        // Run 2: distortion before the filter. Same devices, same parameters,
        // same input phase (the sine is frame-deterministic and the measure
        // window starts at the same frame parity).
        rack.laneTopology <- makeChain (wt::rackModuleDistortion, wt::rackModuleGlobalFilter,
                                        2, 3, 4, 5, 6, 7, filterAndDrive);

        for (int32 frame = 0; frame < settleFrames; ++frame)
            render (frame);

        float32 maxDifference;
        int32 differingFrames;

        for (int32 frame = 0; frame < measureFrames; ++frame)
        {
            let difference = std::intrinsics::abs (render (frame)[0] - firstRun.at (frame));
            maxDifference = std::intrinsics::max (maxDifference, difference);

            if (difference > 0.0f)
                differingFrames += 1;
        }

        // 1. Position changes the sound, sustained — not a transition artefact.
        out <- (maxDifference > 0.001f) ? 1 : 0;
        advance();
        out <- (differingFrames > measureFrames / 2) ? 1 : 0;
        advance();

        out <- (rack.laneCommittedChainCode == orderCode (wt::rackModuleDistortion,
                                                          wt::rackModuleGlobalFilter,
                                                          2, 3, 4, 5, 6, 7)) ? 1 : 0;
        advance();
        out <- (rack.laneCommittedGeneration == 2) ? 1 : 0;
        advance();

        // 2. AN ORDER WITH A DUPLICATE SLOT IS REJECTED OUTRIGHT and the
        //    running structure is left completely intact.
        rack.laneTopology <- makeChain (1, 1, 2, 3, 4, 5, 6, 7, filterAndDrive);

        for (int32 frame = 0; frame < 512; ++frame)
            render (frame);

        out <- (rack.laneRejectedUploadCount == 1) ? 1 : 0;
        advance();
        out <- (rack.laneCommittedGeneration == 2
                 && rack.laneCommittedChainCode == orderCode (wt::rackModuleDistortion,
                                                              wt::rackModuleGlobalFilter,
                                                              2, 3, 4, 5, 6, 7)) ? 1 : 0;
        advance();

        // 3. ENABLE BITS OUTSIDE THE CHAIN ARE REJECTED THE SAME WAY: the
        //    wire mask is per-position, and a set bit beyond chainLength is
        //    an adapter bug, never coerced into meaning.
        wt::LaneTopologyUpload malformed = makeChain (wt::rackModuleDistortion,
                                                      wt::rackModuleGlobalFilter,
                                                      2, 3, 4, 5, 6, 7, filterAndDrive);
        malformed.enabledMask |= 1 << 12;
        rack.laneTopology <- malformed;

        for (int32 frame = 0; frame < 512; ++frame)
            render (frame);

        out <- (rack.laneRejectedUploadCount == 2) ? 1 : 0;
        advance();
        out <- (rack.laneCommittedPositionMask == 0b11) ? 1 : 0;
        advance();

        // 4. Disabling every device is a HARD AUDIBLE BYPASS: once the
        //    transition completes the rack passes its input BIT-EXACTLY
        //    (ADR-005) — the whole rack's zero-latency dry path (ADR-008).
        rack.laneTopology <- makeChain (0, 1, 2, 3, 4, 5, 6, 7, 0);

        for (int32 frame = 0; frame < settleFrames; ++frame)
            render (frame);

        bool bypassIsExact = true;

        for (int32 frame = 0; frame < measureFrames; ++frame)
            if (render (frame)[0] != testSignal (frame))
                bypassIsExact = false;

        out <- bypassIsExact ? 1 : 0;
        advance();
        out <- (rack.laneCommittedPositionMask == 0) ? 1 : 0;
        advance();

        // 5. FREQUENCY MODULATION IS THE IDENTITY AT ZERO OFFSET. The octave
        //    scaler's pow(2, offset) cache is only recomputed when the offset
        //    moves; with nothing routed its INITIAL value multiplies every
        //    frequency parameter forever, so a cache initialised to zero
        //    would silently drag them all to minimum with no error. A 20 kHz
        //    lowpass must pass a 350 Hz sine essentially untouched.
        sendFilterParams (20000.0f);
        sendDistortionParams (0.0f);
        rack.laneTopology <- makeChain (0, 1, 2, 3, 4, 5, 6, 7,
                                        1 << wt::rackModuleGlobalFilter);

        for (int32 frame = 0; frame < settleFrames; ++frame)
            render (frame);

        float32 identityDeparture;

        for (int32 frame = 0; frame < measureFrames; ++frame)
            identityDeparture = std::intrinsics::max (identityDeparture,
                std::intrinsics::abs (render (frame)[0] - testSignal (frame)));

        out <- (identityDeparture < 0.15f) ? 1 : 0;  // zero-cache failure would gut the sine (~0.4)
        advance();

        out <- -1;
        advance();
    }
}

//==============================================================================
// EXACTLY-ONCE ADVANCEMENT, part 1: a module that was disabled and then enabled is
// bit-identical to one that was enabled all along.
//
// This is the strongest behavioural statement of the invariant that exists, and it
// needs no instrumentation endpoint. wt::DelayBus is chosen because it is the module
// that cannot hide a clock error: a delay line whose write head skipped 2048 advances
// reads 2048 samples of the wrong history forever after.
//
// Rack A holds Delay enabled throughout. Rack B holds it disabled for 2048 frames and
// then enables it. Every other module is disabled in both racks, so Delay's INPUT is
// the raw rack input in both racks at every frame - the only thing that differs is
// whether its output is taken. If the rack ever skipped advancing a disabled module,
// rack B's delay line would be 2048 frames behind and the two outputs could not match.

## testProcessor()

processor RackDisabledAdvanceTest [[ main ]]
{
    output stream int32 out;

    node rack = wt::EffectsRack;

    let disabledFrames = 2048;
    let transitionSettleFrames = 512;
    let measureFrames = 3072;

    wt::LaneTopologyUpload eightChain (bool delayEnabled)
    {
        wt::LaneTopologyUpload upload;
        upload.chainLength = 8;

        for (int32 position = 0; position < 8; ++position)
            upload.slotIds.at (position) = position;

        if (delayEnabled)
            upload.enabledMask = 1 << wt::rackModuleDelay;

        return upload;
    }

    wt::LaneTopologyUpload emptyChain()
    {
        wt::LaneTopologyUpload upload;
        upload.chainLength = 0;
        return upload;
    }

    float32 testSignal (int32 frame)
    {
        return 0.35f * float32 (std::intrinsics::sin (float32 (frame) * 0.031f))
             + 0.20f * float32 (std::intrinsics::sin (float32 (frame) * 0.211f));
    }

    void configure()
    {
        // A short, densely repeating, heavily regenerating delay: within the
        // measured window every output sample depends on thousands earlier.
        wt::LaneSlotParamsUpload upload;
        upload.slotId = wt::rackModuleDelay;
        upload.deliverySerial = 1;
        upload.values[wt::laneDelayParamTimeMs] = 20.0f;
        upload.values[wt::laneDelayParamFeedback] = 0.8f;
        upload.values[wt::laneDelayParamFilterHz] = 18000.0f;
        upload.values[wt::laneDelayParamMix] = 1.0f;
        rack.laneSlotParams <- upload;
    }

    float32<2> render (int32 frame)
    {
        rack.in <- float32<2> (testSignal (frame), testSignal (frame));
        rack.trackingPitchHzIn <- 220.0f;
        rack.advance();
        return rack.out;
    }

    float32[9216] reference;

    void main()
    {
        configure();

        // REFERENCE RUN: delay enabled from the first committed frame. The
        // fresh-entry reset makes sequential runs reproducible, so this run
        // is the later runs' bit-exact oracle over the same absolute frames.
        rack.laneTopology <- eightChain (true);

        for (int32 frame = 0; frame < disabledFrames + transitionSettleFrames; ++frame)
            render (frame);

        for (int32 frame = 0; frame < 9216; ++frame)
        {
            let index = disabledFrames + transitionSettleFrames + frame;
            reference.at (frame) = render (index)[0];
        }

        // COMPARISON RUN: back to the empty chain (every device leaves, so
        // re-entry is factory-fresh), then the same chain with the delay
        // DISABLED. It must still advance — its lines keep collecting the
        // live input — so enabling it later exposes no stale-state transient
        // and no clock drift.
        rack.laneTopology <- emptyChain();

        for (int32 frame = 0; frame < transitionSettleFrames; ++frame)
            render (frame);

        rack.laneTopology <- eightChain (false);

        for (int32 frame = 0; frame < disabledFrames; ++frame)
            render (frame);

        rack.laneTopology <- eightChain (true);

        for (int32 frame = 0; frame < transitionSettleFrames; ++frame)
            render (disabledFrames + frame);

        bool identical = true;
        float32 maxWetDeparture;

        for (int32 frame = 0; frame < measureFrames; ++frame)
        {
            let index = disabledFrames + transitionSettleFrames + frame;
            let sample = render (index)[0];

            if (sample != reference.at (frame))
                identical = false;

            maxWetDeparture = std::intrinsics::max (maxWetDeparture,
                                                    std::intrinsics::abs (sample - testSignal (index)));
        }

        // 1. THE INVARIANT: the in-chain device advanced exactly once per
        //    frame while disabled, so re-enabling it is bit-identical to a
        //    device that was enabled all along.
        out <- identical ? 1 : 0;
        advance();

        // 2. Not vacuous: the enabled delay is audibly doing something.
        out <- (maxWetDeparture > 0.01f) ? 1 : 0;
        advance();

        // 3. A REPEATED IDENTICAL TOPOLOGY IS REDUNDANT: no generation burns
        //    and the audio stays bit-identical through the re-send (the
        //    adapter re-sends structure on every patch load).
        let generationBefore = rack.laneCommittedGeneration;
        rack.laneTopology <- eightChain (true);

        bool redundantIsSilent = true;

        for (int32 frame = 0; frame < measureFrames; ++frame)
        {
            let index = disabledFrames + transitionSettleFrames + measureFrames + frame;

            if (render (index)[0] != reference.at (measureFrames + frame))
                redundantIsSilent = false;
        }

        out <- (redundantIsSilent && rack.laneCommittedGeneration == generationBefore) ? 1 : 0;
        advance();

        // 4. A REJECTED UPLOAD IS COMPLETELY INERT: the state does not move
        //    and — the part that is easy to get wrong — the transition ramp
        //    must not even start: a rejected upload that still dipped the
        //    output would be an audible response to a malformed message.
        wt::LaneTopologyUpload duplicated = eightChain (true);
        duplicated.slotIds[1] = 0;
        rack.laneTopology <- duplicated;

        wt::LaneTopologyUpload badMask = eightChain (true);
        badMask.enabledMask |= 1 << 12;
        rack.laneTopology <- badMask;

        bool stillIdentical = true;

        for (int32 frame = 0; frame < measureFrames; ++frame)
        {
            let index = disabledFrames + transitionSettleFrames + (2 * measureFrames) + frame;
            let offset = (2 * measureFrames) + frame;

            if (render (index)[0] != reference.at (offset))
                stillIdentical = false;
        }

        out <- stillIdentical ? 1 : 0;
        advance();

        out <- (rack.laneRejectedUploadCount == 2) ? 1 : 0;
        advance();

        out <- (rack.laneCommittedGeneration == generationBefore
                 && rack.laneCommittedPositionMask == (1 << wt::rackModuleDelay)) ? 1 : 0;
        advance();

        out <- -1;
        advance();
    }
}

//==============================================================================
// EXACTLY-ONCE ADVANCEMENT, part 2: whatever the POSITION.
//
// The same chain committed in two completely different orders, with only the flanger
// enabled (its LFO phase is a direct readout of how many times it has been advanced).
// Every other device in the chain is bypassed, so the flanger's input is the raw rack
// input at every frame regardless of where it sits. Run sequentially on ONE rack (see
// the harness note at the top of this file): the empty-chain commit between runs makes
// each chain enter factory-fresh, so both runs start their LFO from phase zero and the
// outputs must be BIT-IDENTICAL - which they can only be if the rack advanced the
// flanger exactly once per frame, at position 4 and at position 3 alike.

## testProcessor()

processor RackOrderAdvanceTest [[ main ]]
{
    output stream int32 out;

    node rack = wt::EffectsRack;

    let settleFrames = 1024;
    let measureFrames = 4096;

    wt::LaneTopologyUpload flangerChain (bool reversed)
    {
        wt::LaneTopologyUpload upload;
        upload.chainLength = 8;

        for (int32 position = 0; position < 8; ++position)
        {
            int32 moduleId;

            if (reversed)
                moduleId = 7 - position;
            else
                moduleId = position;

            upload.slotIds.at (position) = moduleId;

            if (moduleId == wt::rackModuleFlanger)
                upload.enabledMask |= 1 << position;
        }

        return upload;
    }

    wt::LaneTopologyUpload emptyChain()
    {
        wt::LaneTopologyUpload upload;
        upload.chainLength = 0;
        return upload;
    }

    float32 testSignal (int32 frame)
    {
        return 0.45f * float32 (std::intrinsics::sin (float32 (frame) * 0.017f));
    }

    void configure()
    {
        wt::LaneSlotParamsUpload upload;
        upload.slotId = wt::rackModuleFlanger;
        upload.deliverySerial = 1;
        upload.values[wt::laneFlangerParamRate] = 2.5f;
        upload.values[wt::laneFlangerParamDepth] = 1.0f;
        upload.values[wt::laneFlangerParamFeedback] = 0.9f;
        upload.values[wt::laneFlangerParamMix] = 1.0f;
        rack.laneSlotParams <- upload;
    }

    float32<2> render (int32 frame)
    {
        rack.in <- float32<2> (testSignal (frame), testSignal (frame));
        rack.trackingPitchHzIn <- 220.0f;
        rack.advance();
        return rack.out;
    }

    float32[4096] reference;

    void main()
    {
        configure();

        // Run 1: forward order. Local frame indexing starts at the commit, so the
        // second run can replay the exact same input against its own commit point.
        rack.laneTopology <- flangerChain (false);

        for (int32 frame = 0; frame < settleFrames; ++frame)
            render (frame);

        for (int32 frame = 0; frame < measureFrames; ++frame)
            reference.at (frame) = render (settleFrames + frame)[0];

        let forwardCode = rack.laneCommittedChainCode;
        let forwardMask = rack.laneCommittedPositionMask;

        // Run 2: reversed order, after an empty-chain commit so every device
        // re-enters factory-fresh and the flanger's LFO restarts from phase zero.
        rack.laneTopology <- emptyChain();

        for (int32 frame = 0; frame < settleFrames; ++frame)
            render (frame);

        rack.laneTopology <- flangerChain (true);

        for (int32 frame = 0; frame < settleFrames; ++frame)
            render (frame);

        bool identical = true;
        float32 maxWetDeparture;

        for (int32 frame = 0; frame < measureFrames; ++frame)
        {
            let index = settleFrames + frame;
            let sample = render (index)[0];

            if (sample != reference.at (frame))
                identical = false;

            maxWetDeparture = std::intrinsics::max (maxWetDeparture,
                                                    std::intrinsics::abs (sample - testSignal (index)));
        }

        // 1. Position does not change a module's own time base.
        out <- identical ? 1 : 0;
        advance();

        // 2. Again, not vacuous: the flanger is audibly live.
        out <- (maxWetDeparture > 0.01f) ? 1 : 0;
        advance();

        // 3. The two runs really committed different structures, and the enable
        //    bit followed the flanger to its new position.
        out <- (rack.laneCommittedChainCode != forwardCode
                 && forwardMask == (1 << wt::rackModuleFlanger)
                 && rack.laneCommittedPositionMask == (1 << (7 - wt::rackModuleFlanger))) ? 1 : 0;
        advance();

        out <- -1;
        advance();
    }
}

//==============================================================================
// The ADR-003 transition: one rack-local processed-depth ramp.

## testProcessor()

processor RackTransitionTest [[ main ]]
{
    output stream int32 out;

    node rack = wt::EffectsRack;

    let dcLevel = 0.15f;
    let settleFrames = 1024;

    float32<2> render()
    {
        rack.in <- float32<2> (dcLevel, dcLevel);
        rack.trackingPitchHzIn <- 220.0f;
        rack.advance();
        return rack.out;
    }

    // All eight devices in chain, only the flanger and delay live; the enable
    // bits are POSITION-indexed, so they are derived from where the rotation
    // puts those two modules rather than hand-numbered.
    wt::LaneTopologyUpload wetChain (int32 shift)
    {
        wt::LaneTopologyUpload upload;
        upload.chainLength = 8;

        for (int32 position = 0; position < 8; ++position)
        {
            let moduleId = (position + shift) % 8;
            upload.slotIds.at (position) = moduleId;

            if (moduleId == wt::rackModuleFlanger || moduleId == wt::rackModuleDelay)
                upload.enabledMask |= 1 << position;
        }

        return upload;
    }

    void main()
    {
        // A genuinely wet, non-commutative chain. This catches the production failure
        // mode the old all-dry test missed: a reorder used to gate the entire instrument
        // and measured an 11x transient against steady-state audio.
        wt::LaneSlotParamsUpload flangerParams;
        flangerParams.slotId = wt::rackModuleFlanger;
        flangerParams.deliverySerial = 1;
        flangerParams.values[wt::laneFlangerParamRate] = 1.7f;
        flangerParams.values[wt::laneFlangerParamDepth] = 0.8f;
        flangerParams.values[wt::laneFlangerParamFeedback] = 0.45f;
        flangerParams.values[wt::laneFlangerParamMix] = 0.7f;
        rack.laneSlotParams <- flangerParams;

        wt::LaneSlotParamsUpload delayParams;
        delayParams.slotId = wt::rackModuleDelay;
        delayParams.deliverySerial = 2;
        delayParams.values[wt::laneDelayParamTimeMs] = 23.0f;
        delayParams.values[wt::laneDelayParamFeedback] = 0.5f;
        delayParams.values[wt::laneDelayParamFilterHz] = 18000.0f;
        delayParams.values[wt::laneDelayParamMix] = 0.55f;
        rack.laneSlotParams <- delayParams;

        rack.laneTopology <- wetChain (0);

        for (int32 frame = 0; frame < settleFrames; ++frame)
            render();

        let oldWetLevel = render()[0];
        out <- (std::intrinsics::abs (oldWetLevel - dcLevel) > 0.01f) ? 1 : 0;
        advance();

        //----------------------------------------------------------------------
        // B1-B5: fade the processed contribution to exact dry, commit there, and fade
        // the new order in. The live instrument is never gated.

        let generationBefore = rack.laneCommittedGeneration;
        rack.laneTopology <- wetChain (1);

        int32 silentFrames;
        int32 commitFrame = -1;

        for (int32 frame = 0; frame < settleFrames; ++frame)
        {
            let rendered = render()[0];

            if (rendered == 0.0f)
                silentFrames += 1;

            if (commitFrame < 0 && rack.laneCommittedGeneration == generationBefore + 1)
                commitFrame = frame;

        }

        out <- (silentFrames == 0 && commitFrame >= 0) ? 1 : 0;
        advance();

        out <- (commitFrame < 441) ? 1 : 0;
        advance();

        let newWetLevel = render()[0];
        out <- (std::intrinsics::abs (newWetLevel - dcLevel) > 0.01f) ? 1 : 0;
        advance();

        out <- -1;
        advance();
    }
}

//==============================================================================
// C10, THE STANDING CHECK: NO RACK MODULE MAY DECLARE processor.latency.
//
// This one is a compile-time assertion rather than a behavioural one, because there is
// nothing to behave. Three facts, all established by execution rather than by reading:
//
//   - A composed child's declared latency does not reach the composing PROCESSOR: a
//     child with processor.latency = 128 leaves its parent reporting 0
//     (transient/rack-dsp-poc/smoke05).
//   - It does not delay the audio either. processor.latency is purely declarative:
//     composing a latency-declaring child renders BIT-IDENTICAL samples to composing an
//     otherwise identical clean one, impulse aligned on frame 0 in both.
//   - So a rack module that declared latency would hand the host a wrong number for its
//     delay compensation, with no audible symptom and nothing readable anywhere in the
//     rack. No test of rack.latency and no test of rack audio can catch it.
//
// A GRAPH's latency, however, sums its children's. The probe below chains all eight
// modules and the rack itself behind a witness that declares exactly one frame, and
// asserts the total is exactly one - which can only hold if every one of them contributes
// zero. The rack has to be in the chain in its own right: its
// children's latency does not propagate to it, so covering the modules does not cover
// it.
//
// Two details that are load-bearing and non-obvious:
//   - The witness is required. With no latency declared anywhere in a graph,
//     `processor.latency` is not a constant expression at all and the static_assert
//     fails to compile with "Expected a constant value" rather than passing.
//   - The graph must be INSTANTIATED. An uninstantiated graph's latency is likewise not
//     constant, which is why this lives here and not in cmajor/EffectsRack.cmajor - the
//     shipping rack must not carry eight extra module instances to hold an assertion.
//
// Verified to fire: inserting one latency-declaring node into the chain fails the build
// with the message below.

## testProcessor()

processor RackChildLatencyWitness
{
    input stream float32<2> in;
    output stream float32<2> out;

    processor.latency = 1;

    void main()
    {
        loop
        {
            out <- in;
            advance();
        }
    }
}

graph RackChildLatencyProbe
{
    input stream float32<2> in;
    output stream float32<2> out;

    node witness      = RackChildLatencyWitness;
    node globalFilter = wt::GlobalFilterBus;
    node distortion   = wt::DistortionBus;
    node ott          = wt::OttBus;
    node chorus       = wt::ChorusBus;
    node flanger      = wt::FlangerBus;
    node phaser       = wt::PhaserBus;
    node delay        = wt::DelayBus;
    node reverb       = wt::ReverbBus;
    node rack         = wt::EffectsRack;

    connection
    {
        in -> witness.in;
        witness.out -> globalFilter.in;
        globalFilter.out -> distortion.in;
        distortion.out -> ott.in;
        ott.out -> chorus.in;
        chorus.out -> flanger.in;
        flanger.out -> phaser.in;
        phaser.out -> delay.in;
        delay.out -> reverb.in;
        reverb.out -> rack.in;
        rack.out -> out;
    }

    static_assert (processor.latency == 1,
                   "Something in the rack subsystem has declared processor.latency. A composed child's latency does not reach the composing rack and does not delay the audio, so the host would be told the wrong number with no symptom anywhere (ADR-008)");
}

processor RackLatencyTest [[ main ]]
{
    output stream int32 out;

    // Instantiating the probe is what makes its static_assert a constant expression.
    // Nothing here drives it; the assertion above has already run by the time this
    // compiles at all.
    node latencyProbe = RackChildLatencyProbe;

    void main()
    {
        // The rack itself declares zero, and so does the composing test.
        out <- (processor.latency == 0) ? 1 : 0;
        advance();

        out <- -1;
        advance();
    }
}
