// Bounded production-engine execution proof for the complete modulation.v6
// sparse program domain. This verifies installed prefix counts and live DSP
// sentinels without turning the test into a performance budget.

## global ("../../cmajor/Mseg.cmajor", "../../cmajor/FixedFrameOscillator.cmajor", "../../cmajor/VoiceReducer.cmajor", "NoopThreeOscillatorRenderer.cmajor")

## testProcessor (undefined, { frequency: 600 })

graph ModulationV6ProgramExecution [[ main ]]
{
    output event int32 out;

    node source = ModulationV6ProgramSource;
    node engine = wt::SharedVoiceEngine (1);
    node witness = ModulationV6ProgramWitness;

    connection
    {
        source.programOut -> engine.modulationProgramIn;
        source.voiceOut -> engine.voiceEventIn[0];
        source.macro1Out -> engine.macro1In;
        source.macro4Out -> engine.macro4In;
        source.filterQOut -> engine.filterQIn;
        source.ampAttackOut -> engine.ampAttackIn;
        source.ampDecayOut -> engine.ampDecayIn;
        source.ampSustainOut -> engine.ampSustainIn;
        engine.runtimeInstallAckOut -> witness.ackIn;
        engine.effectiveFilterStateOut -> witness.filterIn;
        engine.rackModOut[19] -> witness.hundredRackIn;
        // The tail sentinel rides the domain's FINAL cell, which since the
        // Effects Lane pool block is a LANE destination — so this claim now
        // also proves pool targets execute through the full program path.
        engine.rackModOut[wt::rackModTargetCount - 1] -> witness.tailRackIn;
        witness.out -> out;
    }
}

processor ModulationV6ProgramSource
{
    output event wt::ModulationProgramUpload programOut;
    output event (std::notes::NoteOn, std::notes::Slide) voiceOut;
    output value float32 macro1Out;
    output value float32 macro4Out;
    output value float32 filterQOut;
    output value float32 ampAttackOut;
    output value float32 ampDecayOut;
    output value float32 ampSustainOut;

    // The upload is a processor MEMBER: at the mirrored 72-wide rack domain
    // the struct is tens of kilobytes, and building it through chained
    // return-by-value locals overflows the interpreter stack (SIGBUS).
    wt::ModulationProgramUpload scratch;

    void resetScratchProgram (int32 serial)
    {
        wt::ModulationProgramUpload upload;
        upload.dspSessionId = int32 (processor.session);
        upload.deliverySerial = serial;
        scratch = upload;
    }

    void buildHundredProgram (int32 serial, bool includeSentinel)
    {
        resetScratchProgram (serial);
        scratch.voiceRouteCount = 30;
        scratch.macroVoiceRouteCount = 20;
        scratch.voiceRackRouteCount = 30;
        scratch.macroRackRouteCount = includeSentinel ? 21 : 20;

        for (int32 targetIndex = 0; targetIndex < 30; ++targetIndex)
        {
            scratch.voiceRouteCells.at (targetIndex) = targetIndex;
            scratch.voiceRouteSources.at (targetIndex) = 0;
            scratch.voiceRouteTargets.at (targetIndex) = targetIndex;
            scratch.voiceRoutePolarities.at (targetIndex) = wt::modulationPolarityUnipolar;

            scratch.voiceRackRouteCells.at (targetIndex) = targetIndex;
            scratch.voiceRackRouteSources.at (targetIndex) = 0;
            scratch.voiceRackRouteTargets.at (targetIndex) = targetIndex;
            scratch.voiceRackRoutePolarities.at (targetIndex) = wt::modulationPolarityUnipolar;
            scratch.voiceRackRouteReducers.at (targetIndex) = wt::modulationReducerMaximum;
        }

        for (int32 targetIndex = 0; targetIndex < 19; ++targetIndex)
        {
            scratch.macroVoiceRouteCells.at (targetIndex) = targetIndex;
            scratch.macroVoiceRouteSources.at (targetIndex) = 0;
            scratch.macroVoiceRouteTargets.at (targetIndex) = targetIndex;
            scratch.macroVoiceRoutePolarities.at (targetIndex) = wt::modulationPolarityUnipolar;
        }

        scratch.macroVoiceRouteCells[19] = wt::modulationTargetFilterQ;
        scratch.macroVoiceRouteSources[19] = 0;
        scratch.macroVoiceRouteTargets[19] = wt::modulationTargetFilterQ;
        scratch.macroVoiceRoutePolarities[19] = wt::modulationPolarityUnipolar;
        scratch.macroVoiceRouteAmounts[wt::modulationTargetFilterQ] = 1.0f;

        for (int32 targetIndex = 0; targetIndex < 20; ++targetIndex)
        {
            scratch.macroRackRouteCells.at (targetIndex) = targetIndex;
            scratch.macroRackRouteSources.at (targetIndex) = 0;
            scratch.macroRackRouteTargets.at (targetIndex) = targetIndex;
            scratch.macroRackRoutePolarities.at (targetIndex) = wt::modulationPolarityUnipolar;
        }
        scratch.macroRackRouteAmounts[19] = 1.0f;

        if (includeSentinel)
        {
            let finalCell = wt::modulationMacroRackRouteCellCount - 1;
            scratch.macroRackRouteCells[20] = finalCell;
            scratch.macroRackRouteSources[20] = wt::modulationMacroSourceCount - 1;
            scratch.macroRackRouteTargets[20] = wt::rackModTargetCount - 1;
            scratch.macroRackRoutePolarities[20] = wt::modulationPolarityUnipolar;
            scratch.macroRackRouteAmounts[finalCell] = 0.5f;
        }

        }

    void buildFullDomainProgram (int32 serial)
    {
        resetScratchProgram (serial);
        scratch.voiceRouteCount = wt::modulationVoiceRouteCellCount;
        scratch.macroVoiceRouteCount = wt::modulationMacroVoiceRouteCellCount;
        scratch.voiceRackRouteCount = wt::modulationVoiceRackRouteCapacity;
        scratch.macroRackRouteCount = wt::modulationMacroRackRouteCapacity;

        for (int32 cellIndex = 0; cellIndex < wt::modulationVoiceRouteCellCount; ++cellIndex)
        {
            scratch.voiceRouteCells.at (cellIndex) = cellIndex;
            scratch.voiceRouteSources.at (cellIndex) = cellIndex / wt::modulationVoiceTargetCount;
            scratch.voiceRouteTargets.at (cellIndex) = cellIndex % wt::modulationVoiceTargetCount;
            scratch.voiceRoutePolarities.at (cellIndex) = wt::modulationPolarityUnipolar;
        }

        for (int32 cellIndex = 0; cellIndex < wt::modulationMacroVoiceRouteCellCount; ++cellIndex)
        {
            scratch.macroVoiceRouteCells.at (cellIndex) = cellIndex;
            scratch.macroVoiceRouteSources.at (cellIndex) = cellIndex / wt::modulationVoiceTargetCount;
            scratch.macroVoiceRouteTargets.at (cellIndex) = cellIndex % wt::modulationVoiceTargetCount;
            scratch.macroVoiceRoutePolarities.at (cellIndex) = wt::modulationPolarityUnipolar;
        }

        // The rack tables carry a ROUTE BUDGET, not the full matrix: fill
        // every slot but the last with the leading cells, then ride the
        // final slot on the domain's FINAL cell so the tail sentinel still
        // proves the last lane-pool destination executes.
        for (int32 routeIndex = 0; routeIndex < wt::modulationVoiceRackRouteCapacity - 1; ++routeIndex)
        {
            scratch.voiceRackRouteCells.at (routeIndex) = routeIndex;
            scratch.voiceRackRouteSources.at (routeIndex) = routeIndex / wt::rackModTargetCount;
            scratch.voiceRackRouteTargets.at (routeIndex) = routeIndex % wt::rackModTargetCount;
            scratch.voiceRackRoutePolarities.at (routeIndex) = wt::modulationPolarityUnipolar;
            scratch.voiceRackRouteReducers.at (routeIndex) = wt::modulationReducerMaximum;
        }

        scratch.voiceRackRouteCells.at (wt::modulationVoiceRackRouteCapacity - 1) = wt::modulationVoiceRackRouteCellCount - 1;
        scratch.voiceRackRouteSources.at (wt::modulationVoiceRackRouteCapacity - 1) = wt::modulationVoiceSourceCount - 1;
        scratch.voiceRackRouteTargets.at (wt::modulationVoiceRackRouteCapacity - 1) = wt::rackModTargetCount - 1;
        scratch.voiceRackRoutePolarities.at (wt::modulationVoiceRackRouteCapacity - 1) = wt::modulationPolarityUnipolar;
        scratch.voiceRackRouteReducers.at (wt::modulationVoiceRackRouteCapacity - 1) = wt::modulationReducerMaximum;

        for (int32 routeIndex = 0; routeIndex < wt::modulationMacroRackRouteCapacity - 1; ++routeIndex)
        {
            scratch.macroRackRouteCells.at (routeIndex) = routeIndex;
            scratch.macroRackRouteSources.at (routeIndex) = routeIndex / wt::rackModTargetCount;
            scratch.macroRackRouteTargets.at (routeIndex) = routeIndex % wt::rackModTargetCount;
            scratch.macroRackRoutePolarities.at (routeIndex) = wt::modulationPolarityUnipolar;
        }

        scratch.macroRackRouteCells.at (wt::modulationMacroRackRouteCapacity - 1) = wt::modulationMacroRackRouteCellCount - 1;
        scratch.macroRackRouteSources.at (wt::modulationMacroRackRouteCapacity - 1) = wt::modulationMacroSourceCount - 1;
        scratch.macroRackRouteTargets.at (wt::modulationMacroRackRouteCapacity - 1) = wt::rackModTargetCount - 1;
        scratch.macroRackRoutePolarities.at (wt::modulationMacroRackRouteCapacity - 1) = wt::modulationPolarityUnipolar;

        scratch.voiceRouteAmounts[wt::modulationVoiceRouteCellCount - 1] = 1.0f;
        scratch.voiceRouteAmounts[
            (wt::modulationVoiceSourceCount - 1) * wt::modulationVoiceTargetCount
                + wt::modulationTargetFilterQ
        ] = 1.0f;
        scratch.macroVoiceRouteAmounts[wt::modulationMacroVoiceRouteCellCount - 1] = 2.0f;
        scratch.macroVoiceRouteAmounts[
            (wt::modulationMacroSourceCount - 1) * wt::modulationVoiceTargetCount
                + wt::modulationTargetFilterQ
        ] = 2.0f;
        scratch.voiceRackRouteAmounts[wt::modulationVoiceRackRouteCellCount - 1] = 1.0f;
        scratch.macroRackRouteAmounts[wt::modulationMacroRackRouteCellCount - 1] = 2.0f;
        }

    void buildPopulatedZeroCountProgram (int32 serial)
    {
        buildFullDomainProgram (serial);
        scratch.voiceRouteCount = 0;
        scratch.macroVoiceRouteCount = 0;
        scratch.voiceRackRouteCount = 0;
        scratch.macroRackRouteCount = 0;
        }

    std::notes::NoteOn noteOn()
    {
        std::notes::NoteOn note;
        note.channel = 0;
        note.pitch = 60.0f;
        note.velocity = 1.0f;
        return note;
    }

    std::notes::Slide slide()
    {
        std::notes::Slide expression;
        expression.channel = 0;
        expression.slide = 1.0f;
        return expression;
    }

    void main()
    {
        macro1Out <- 1.0f;
        macro4Out <- 1.0f;
        filterQOut <- 0.707107f;
        // Direct SharedVoiceEngine graphs do not apply endpoint init
        // annotations, so preserve the old-sound ADSR explicitly here.
        ampAttackOut <- 0.01f;
        ampDecayOut <- 0.001f;
        ampSustainOut <- 1.0f;

        for (int32 frame = 0; ; ++frame)
        {
            if (frame == 1)
            {
                resetScratchProgram (1);
                programOut <- scratch;
            }
            if (frame == 2)
            {
                voiceOut <- noteOn();
                voiceOut <- slide();
            }
            if (frame == 5)
            {
                buildHundredProgram (2, false);
                programOut <- scratch;
            }
            if (frame == 20)
            {
                buildHundredProgram (3, true);
                programOut <- scratch;
            }
            if (frame == 35)
            {
                buildFullDomainProgram (4);
                programOut <- scratch;
            }
            if (frame == 50)
            {
                buildPopulatedZeroCountProgram (5);
                programOut <- scratch;
            }
            if (frame == 75)
            {
                resetScratchProgram (6);
                programOut <- scratch;
            }
            advance();
        }
    }
}

processor ModulationV6ProgramWitness
{
    input event wt::RuntimeInstallAck ackIn;
    input event wt::EffectiveFilterStateMonitor filterIn;
    input stream float32 hundredRackIn;
    input stream float32 tailRackIn;
    output event int32 out;

    int32 acceptedMask;
    int32 seenAcceptedMask;
    int32 rejectedCount;
    float32 latestQ;
    int32 hundredSustainedFrames;
    bool sentinelExecuted;
    bool fullDomainExecuted;
    bool populatedZeroCountCleared;
    bool emptyStayedClear;

    event ackIn (wt::RuntimeInstallAck ack)
    {
        let serial = ack.acceptedModulationSerial;
        if (serial >= 1 && serial <= 6)
            seenAcceptedMask |= 1 << (serial - 1);
        if (ack.rejectionReason != wt::runtimeInstallRejectionNone)
            rejectedCount += 1;

        if (serial == 1
            && ack.installedVoiceRouteCount == 0
            && ack.installedMacroVoiceRouteCount == 0
            && ack.installedVoiceRackRouteCount == 0
            && ack.installedMacroRackRouteCount == 0)
            acceptedMask |= 1;
        else if (serial == 2
            && ack.installedVoiceRouteCount == 30
            && ack.installedMacroVoiceRouteCount == 20
            && ack.installedVoiceRackRouteCount == 30
            && ack.installedMacroRackRouteCount == 20)
            acceptedMask |= 2;
        else if (serial == 3
            && ack.installedVoiceRouteCount == 30
            && ack.installedMacroVoiceRouteCount == 20
            && ack.installedVoiceRackRouteCount == 30
            && ack.installedMacroRackRouteCount == 21)
            acceptedMask |= 4;
        else if (serial == 4
            && ack.installedVoiceRouteCount == wt::modulationVoiceRouteCellCount
            && ack.installedMacroVoiceRouteCount == wt::modulationMacroVoiceRouteCellCount
            && ack.installedVoiceRackRouteCount == wt::modulationVoiceRackRouteCapacity
            && ack.installedMacroRackRouteCount == wt::modulationMacroRackRouteCapacity)
            acceptedMask |= 8;
        else if (serial == 5
            && ack.installedVoiceRouteCount == 0
            && ack.installedMacroVoiceRouteCount == 0
            && ack.installedVoiceRackRouteCount == 0
            && ack.installedMacroRackRouteCount == 0)
            acceptedMask |= 16;
        else if (serial == 6
            && ack.installedVoiceRouteCount == 0
            && ack.installedMacroVoiceRouteCount == 0
            && ack.installedVoiceRackRouteCount == 0
            && ack.installedMacroRackRouteCount == 0)
            acceptedMask |= 32;
    }

    event filterIn (wt::EffectiveFilterStateMonitor state)
    {
        if (state.hasActive != 0)
            latestQ = state.q;
    }

    void main()
    {
        for (int32 frame = 0; ; ++frame)
        {
            if (frame >= 12 && frame < 20
                && latestQ > 1.6f && latestQ < 1.8f
                && hundredRackIn > 0.9f)
                hundredSustainedFrames += 1;

            if (frame >= 27 && frame < 35 && tailRackIn > 0.45f)
                sentinelExecuted = true;

            if (frame >= 42 && frame < 50
                && latestQ > 3.6f && latestQ < 3.8f
                && tailRackIn > 2.9f)
                fullDomainExecuted = true;

            if (frame >= 70 && frame < 75
                && latestQ > 0.6f && latestQ < 0.8f
                && std::intrinsics::abs (hundredRackIn) < 0.01f
                && std::intrinsics::abs (tailRackIn) < 0.01f)
                populatedZeroCountCleared = true;

            if (frame >= 82 && frame < 89
                && latestQ > 0.6f && latestQ < 0.8f
                && std::intrinsics::abs (hundredRackIn) < 0.01f
                && std::intrinsics::abs (tailRackIn) < 0.01f)
                emptyStayedClear = true;

            if (frame == 90)
                out <- acceptedMask == 63
                    && seenAcceptedMask == 63
                    && rejectedCount == 0 ? 1 : 0;
            if (frame == 91)
                out <- hundredSustainedFrames >= 4 ? 1 : 0;
            if (frame == 92)
                out <- sentinelExecuted ? 1 : 0;
            if (frame == 93)
                out <- fullDomainExecuted ? 1 : 0;
            if (frame == 94)
                out <- populatedZeroCountCleared ? 1 : 0;
            if (frame == 95)
                out <- emptyStayedClear ? 1 : 0;
            if (frame == 96)
                out <- -1;

            advance();
        }
    }
}
