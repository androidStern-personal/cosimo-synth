//==============================================================================
// Comp bypass drives the accepted compressor-plus-soft-clip macro to neutral
// without changing its public Amount. The fixed lookahead stays in circuit, and
// re-enabling restores the same treatment through the smoothed macro path.

## testProcessor()

processor PolishCompressionBypassContract [[ main ]]
{
    output stream int32 out;
    node polish = wt::PolishBus;

    float32 render (float32 bypassed)
    {
        polish.in <- float32<2> (2.0f, 2.0f);
        polish.safeBassAmountIn <- 0.0f;
        polish.enhancerAmountIn <- 0.0f;
        polish.compressionClipAmountIn <- 1.0f;
        polish.compressionClipBypassIn <- bypassed;
        polish.outputTrimDbIn <- 0.0f;
        polish.advance();
        return polish.out[0];
    }

    void main()
    {
        float32 previous;
        float32 activeMaximum;
        for (int32 frame = 0; frame < 24000; ++frame)
        {
            previous = render (0.0f);
            if (frame >= 12000)
                activeMaximum = std::intrinsics::max (activeMaximum, previous);
        }

        float32 maximumStep;
        float32 bypassedMinimum = 1000.0f;
        for (int32 frame = 0; frame < 48000; ++frame)
        {
            let current = render (1.0f);
            maximumStep = std::intrinsics::max (
                maximumStep,
                std::intrinsics::abs (current - previous)
            );
            previous = current;
            if (frame >= 36000)
                bypassedMinimum = std::intrinsics::min (bypassedMinimum, current);
        }

        float32 restoredMaximum;
        for (int32 frame = 0; frame < 24000; ++frame)
        {
            let current = render (0.0f);
            maximumStep = std::intrinsics::max (
                maximumStep,
                std::intrinsics::abs (current - previous)
            );
            previous = current;
            if (frame >= 12000)
                restoredMaximum = std::intrinsics::max (restoredMaximum, current);
        }

        out <- activeMaximum > wt::polishSoftClipKnee && activeMaximum <= 1.0f ? 1 : 0;
        advance();
        out <- bypassedMinimum > 1.99f ? 1 : 0;
        advance();
        out <- restoredMaximum > wt::polishSoftClipKnee && restoredMaximum <= 1.0f ? 1 : 0;
        advance();
        out <- maximumStep < 0.01f ? 1 : 0;
        advance();
        out <- -1;
        advance();
    }
}

//==============================================================================
// Meter math is ordinary post-trim sample peak plus an ungated 400 ms sliding
// stereo mean-square level. It is deliberately not true peak or EBU loudness.

## testProcessor()

processor PolishMeterAccumulatorContract [[ main ]]
{
    output stream int32 out;
    wt::PolishMeterAccumulator meter;

    void main()
    {
        meter.prepare (processor.frequency);
        int32 emittedFrames;
        int32 previousEmission = -1;
        bool cadenceExact = true;
        bool constantLevelExact = false;
        bool nextFrameCapturedPeak = false;

        let totalFrames = meter.telemetryFrameCount * 60;
        let impulseFrame = meter.windowFrameCount + 1;
        for (int32 frame = 0; frame < totalFrames; ++frame)
        {
            let sample = frame == impulseFrame ? 1.0f : 0.5f;
            if (meter.push (float32<2> (sample, sample)))
            {
                if (previousEmission >= 0
                    && frame - previousEmission != meter.telemetryFrameCount)
                    cadenceExact = false;
                previousEmission = frame;
                emittedFrames += 1;

                if (frame >= meter.windowFrameCount - 1 && frame < impulseFrame)
                    constantLevelExact = std::intrinsics::abs (meter.peakDbfs + 6.0206f) < 0.001f
                        && std::intrinsics::abs (meter.loudnessDbfs + 6.0206f) < 0.001f;
                if (frame >= impulseFrame
                    && frame < impulseFrame + meter.telemetryFrameCount
                    && meter.peakDbfs == 0.0f)
                    nextFrameCapturedPeak = true;
            }
        }

        out <- cadenceExact && emittedFrames == 60 ? 1 : 0;
        advance();
        out <- constantLevelExact ? 1 : 0;
        advance();
        out <- nextFrameCapturedPeak ? 1 : 0;
        advance();
        out <- -1;
        advance();
    }
}

//==============================================================================
// The finisher clips before trim, and trim is intentionally the final audible
// operation. Positive trim can exceed full scale; no hidden safety waveshaper
// may silently reappear after it.

## testProcessor()

processor PolishFinishAndTrimContract [[ main ]]
{
    output stream int32 out;
    node polish = wt::PolishBus;

    void main()
    {
        float32 fullMacroPeak;
        bool allFinite = true;
        for (int32 frame = 0; frame < 24000; ++frame)
        {
            polish.in <- float32<2> (2.0f, 2.0f);
            polish.enhancerAmountIn <- 0.0f;
            polish.compressionClipAmountIn <- 1.0f;
            polish.outputTrimDbIn <- 0.0f;
            polish.advance();
            if (frame >= 12000)
            {
                fullMacroPeak = std::intrinsics::max (
                    fullMacroPeak,
                    std::intrinsics::max (
                        std::intrinsics::abs (polish.out[0]),
                        std::intrinsics::abs (polish.out[1])
                    )
                );
                if (polish.out[0] != polish.out[0] || polish.out[1] != polish.out[1])
                    allFinite = false;
            }
        }

        float32 positiveTrimMinimum = 1000.0f;
        float32 previous;
        for (int32 frame = 0; frame < 36000; ++frame)
        {
            polish.in <- float32<2> (0.5f, 0.5f);
            polish.enhancerAmountIn <- 0.0f;
            polish.compressionClipAmountIn <- 0.0f;
            polish.outputTrimDbIn <- 12.0f;
            polish.outputTrimBypassIn <- 0.0f;
            polish.advance();
            previous = polish.out[0];
            if (frame >= 24000)
                positiveTrimMinimum = std::intrinsics::min (
                    positiveTrimMinimum,
                    std::intrinsics::min (polish.out[0], polish.out[1])
                );
        }

        float32 maximumBypassStep;
        float32 bypassedTrimMaximum;
        for (int32 frame = 0; frame < 24000; ++frame)
        {
            polish.in <- float32<2> (0.5f, 0.5f);
            polish.enhancerAmountIn <- 0.0f;
            polish.compressionClipAmountIn <- 0.0f;
            // The value remains +12 dB while only bypass changes.
            polish.outputTrimDbIn <- 12.0f;
            polish.outputTrimBypassIn <- 1.0f;
            polish.advance();
            maximumBypassStep = std::intrinsics::max (
                maximumBypassStep,
                std::intrinsics::abs (polish.out[0] - previous)
            );
            previous = polish.out[0];
            if (frame >= 12000)
                bypassedTrimMaximum = std::intrinsics::max (
                    bypassedTrimMaximum,
                    polish.out[0]
                );
        }

        float32 restoredTrimMinimum = 1000.0f;
        for (int32 frame = 0; frame < 24000; ++frame)
        {
            polish.in <- float32<2> (0.5f, 0.5f);
            polish.enhancerAmountIn <- 0.0f;
            polish.compressionClipAmountIn <- 0.0f;
            polish.outputTrimDbIn <- 12.0f;
            polish.outputTrimBypassIn <- 0.0f;
            polish.advance();
            maximumBypassStep = std::intrinsics::max (
                maximumBypassStep,
                std::intrinsics::abs (polish.out[0] - previous)
            );
            previous = polish.out[0];
            if (frame >= 12000)
                restoredTrimMinimum = std::intrinsics::min (
                    restoredTrimMinimum,
                    polish.out[0]
                );
        }

        out <- allFinite ? 1 : 0;
        advance();
        out <- fullMacroPeak > wt::polishSoftClipKnee && fullMacroPeak <= 1.0f ? 1 : 0;
        advance();
        out <- positiveTrimMinimum > 1.9f ? 1 : 0;
        advance();
        out <- bypassedTrimMaximum < 0.51f ? 1 : 0;
        advance();
        out <- restoredTrimMinimum > 1.9f ? 1 : 0;
        advance();
        out <- maximumBypassStep < 0.01f ? 1 : 0;
        advance();
        out <- -1;
        advance();
    }
}
