        "reverbSize": 0.7,
        "reverbDecay": 0.65,
        "reverbDamping": 0.3,
        "reverbMix": 0.31,
        "reverbOutputTrimDb": 0
      }
    }
  },
  "chain": [
    {
      "kind": "device",
      "deviceId": "distortion#1",
      "enabled": false
    },
    {
      "kind": "split",
      "groupId": "split#1",
      "enabled": true,
      "xoverLowHz": 800,
      "xoverHighHz": 2500,
      "xoverLowKeyTrackEnabled": false,
      "xoverLowKeyTrackOffsetSemitones": 0,
      "xoverHighKeyTrackEnabled": false,
      "xoverHighKeyTrackOffsetSemitones": 0,
      "branches": [
        [
          {
            "kind": "device",
            "deviceId": "delay#2",
            "enabled": true
          }
        ],
        [
          {
            "kind": "device",
            "deviceId": "reverb#1",
            "enabled": true
          }
        ]
      ]
    }
  ]
