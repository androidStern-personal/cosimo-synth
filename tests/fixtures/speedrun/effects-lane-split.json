{
  "format": "cosimo.lane",
  "version": 2,
  "output": {
    "mix": 1,
    "bypassed": false
  },
  "devices": {
    "distortion#1": {
      "params": {
        "distortionMode": 0,
        "distortionDriveDb": 12,
        "distortionKnee": 0.35,
        "distortionWet": 0.5,
        "distortionWetHPHz": 40,
        "distortionWetLPHz": 18000,
        "distortionType": 1,
        "distortionWetHPKeyTrackEnabled": 0,
        "distortionWetHPKeyTrackOffsetSemitones": 0,
        "distortionWetLPKeyTrackEnabled": 0,
        "distortionWetLPKeyTrackOffsetSemitones": 0,
        "distortionOutputTrimDb": 0
      }
    },
    "delay#2": {
      "params": {
        "delayTime": 250,
        "delayFeedback": 0.58,
        "delayFilter": 5000,
        "delayMix": 0.42,
        "delayTimeMode": 0,
        "delayDivision": 8,
        "delayTimeKeyTrackEnabled": 0,
        "delayTimeKeyTrackOffsetSemitones": 0,
        "delayFilterKeyTrackEnabled": 0,
        "delayFilterKeyTrackOffsetSemitones": 0,
        "delayOutputTrimDb": 0
      }
    },
    "reverb#1": {
