// Macro modulation-source plumbing tests against the production patch.
// Both cases must be audio-identical to the identity_sine baseline:
// sweeping macros with no routes is inert, and an enabled macro route with
// amount 0 contributes exactly nothing (ADR-010; roadmap Phase 2).

const patchPath = "../../WavetableSynth.cmajorpatch";

function patchRun(subDir)
{
    return {
        patch: patchPath,
        subDir,
        frequency: 44100,
        blockSize: 64,
        samplesToRender: 4096,
        sessionID: 1,
        skipMissingInputs: true,
        skipMissingOutputs: true,
        maxDiffDb: -100.0
    };
}

function positivePatchRun(subDir, maxDiffDb)
{
    let options = patchRun (subDir);
    options.maxDiffDb = maxDiffDb;
    return options;
}

## runScript (patchRun("fixtures/macro_inert_when_unrouted"))

## runScript (patchRun("fixtures/macro_neutral_route"))

// POSITIVE proof: the scan_baseline position sweep, reproduced entirely by a
// macro→wavetablePosition route (base position pinned at 0, macro1 carries the
// ramp, amount 1.0). Same audio within tolerance = macro modulation WORKS.

## runScript (positivePatchRun("fixtures/macro_drives_scan", -60.0))
