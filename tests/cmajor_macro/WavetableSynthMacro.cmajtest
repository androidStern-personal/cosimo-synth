// Macro modulation-source plumbing tests against the production patch.
// Unrouted and zero-depth Macros must remain audio-identical to the identity
// synth as well as leaving the effective-position monitor at zero (ADR-010;
// ADR-020).

const patchPath = "../../WavetableSynth.cmajorpatch";

function patchRun(subDir)
{
    return {
        patch: patchPath,
        subDir,
        frequency: 44100,
        blockSize: 64,
        samplesToRender: 4096,
        sessionID: 1,
        skipMissingInputs: true,
        skipMissingOutputs: true,
        maxDiffDb: -100.0
    };
}

function positivePatchRun(subDir, maxDiffDb)
{
    let options = patchRun (subDir);
    options.maxDiffDb = maxDiffDb;
    return options;
}

## runScript (patchRun("fixtures/macro_inert_when_unrouted"))

## runScript (patchRun("fixtures/macro_neutral_route"))

// POSITIVE proof: an accepted current-program macro→wavetablePosition route
// moves the production patch's effective-position monitor with Macro 1.

## runScript (positivePatchRun("fixtures/macro_drives_scan", -60.0))
