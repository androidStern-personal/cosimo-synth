processor PluginStateChannel
{
    input value float gain [[ name: "Gain", min: -12, max: 12, step: 0.5, init: 1 ]];
    input event float curveBuffer;
    output stream float out;
    float curve = 0;
    event curveBuffer (float value) { curve = value; }
    void main() { loop { out <- gain + curve; advance(); } }
}
