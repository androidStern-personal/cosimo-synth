// Direct behavioural checks for the isolated T27 design studio.

## global ("../../fx/polish_lab/PolishVoicingLab.cmajor")

## testProcessor()

processor PolishCurveContract [[ main ]]
{
    output stream int32 out;
    node core = polishlab::ClipCoreChannel;

    float32 render (float32 sample)
    {
        core.in <- sample;
        core.driveDb <- 0.0f;
        core.p1x <- 0.799438202f;
        core.p1y <- 0.717642209f;
        core.p1t <- 0.42f;
        core.p2x <- 0.927299703f;
        core.p2y <- 0.893592677f;
        core.p2t <- 0.0f;
        core.p3x <- 0.93620178f;
        core.p3y <- 1.0f;
        core.p3t <- -0.72f;
        core.advance();
        return core.out;
    }

    bool close (float32 actual, float32 expected, float32 tolerance)
    {
        return std::intrinsics::abs (actual - expected) <= tolerance;
    }

    void main()
    {
        let tolerance = 2.0e-6f;
        let knot1 = render (0.799438202f);
        let knot2 = render (0.927299703f);
        let knot3 = render (0.93620178f);
        let plateau = render (1.2f);
        let negative = render (-0.5f);
        let positive = render (0.5f);

        out <- close (knot1, 0.717642209f, tolerance) ? 1 : 0;
        advance();
        out <- close (knot2, 0.893592677f, tolerance) ? 1 : 0;
        advance();
        out <- close (knot3, 1.0f, tolerance) ? 1 : 0;
        advance();
        out <- close (plateau, 1.0f, tolerance) ? 1 : 0;
        advance();
        out <- close (negative, -positive, tolerance) ? 1 : 0;
        advance();
        out <- close (positive, 0.4311271f, 3.0e-6f) ? 1 : 0;
        advance();
        out <- -1;
        advance();
    }
}

## testProcessor()

processor PolishBipolarShapeContract [[ main ]]
{
    output stream int32 out;
    node core = polishlab::BipolarShapeCoreChannel;

    float32 render (float32 sample, float32 morphPosition)
    {
        core.in <- sample;
        core.positivePointCount <- 1.0f;
        core.positiveP1X <- 1.0f; core.positiveP1Y <- 1.0f;
        core.positiveP2X <- 1.08f; core.positiveP2Y <- 1.0f;
        core.positiveP3X <- 1.16f; core.positiveP3Y <- 1.0f;
        core.positiveP4X <- 1.24f; core.positiveP4Y <- 1.0f;
        core.positiveP5X <- 1.32f; core.positiveP5Y <- 1.0f;
        core.positiveP6X <- 1.4f; core.positiveP6Y <- 1.0f;
        core.positiveP7X <- 1.5f; core.positiveP7Y <- 1.0f;
        core.positiveB1 <- 0.0f; core.positiveB2 <- 0.0f; core.positiveB3 <- 0.0f;
        core.positiveB4 <- 0.0f; core.positiveB5 <- 0.0f; core.positiveB6 <- 0.0f; core.positiveB7 <- 0.0f;

        core.negativePointCount <- 1.0f;
        core.negativeP1X <- 1.0f; core.negativeP1Y <- -0.5f;
        core.negativeP2X <- 1.08f; core.negativeP2Y <- -0.5f;
        core.negativeP3X <- 1.16f; core.negativeP3Y <- -0.5f;
        core.negativeP4X <- 1.24f; core.negativeP4Y <- -0.5f;
        core.negativeP5X <- 1.32f; core.negativeP5Y <- -0.5f;
        core.negativeP6X <- 1.4f; core.negativeP6Y <- -0.5f;
        core.negativeP7X <- 1.5f; core.negativeP7Y <- -0.5f;
        core.negativeB1 <- 0.0f; core.negativeB2 <- 0.0f; core.negativeB3 <- 0.0f;
        core.negativeB4 <- 0.0f; core.negativeB5 <- 0.0f; core.negativeB6 <- 0.0f; core.negativeB7 <- 0.0f;

        core.morphSide <- 1.0f;
        core.morphPoint <- 7.0f; // restored host state clamps to the last active point
        core.morphTargetX <- 0.6f;
        core.morphTargetY <- 1.2f;
        core.morphPosition <- morphPosition;
        core.advance();
        return core.out;
    }

    bool close (float32 actual, float32 expected)
    {
        return std::intrinsics::abs (actual - expected) <= 2.0e-6f;
    }

    void main()
    {
        out <- close (render (0.5f, 0.0f), 0.5f) ? 1 : 0;
        advance();
        out <- close (render (-0.5f, 0.0f), -0.25f) ? 1 : 0;
        advance();
        out <- close (render (1.2f, 0.0f), 1.0f) ? 1 : 0;
        advance();
        out <- close (render (-1.2f, 0.0f), -0.5f) ? 1 : 0;
        advance();
        out <- close (render (0.8f, 0.5f), 1.1f) ? 1 : 0;
        advance();
        out <- close (render (-0.8f, 0.5f), -0.4f) ? 1 : 0;
        advance();
        out <- -1;
        advance();
    }
}

## testProcessor()

processor PolishBipolarBendContract [[ main ]]
{
    output stream int32 out;
    node core = polishlab::BipolarShapeCoreChannel;

    float32 render (float32 sample)
    {
        core.in <- sample;
        core.positivePointCount <- 2.0f;
        core.positiveP1X <- 0.5f; core.positiveP1Y <- 0.6f;
        core.positiveP2X <- 1.0f; core.positiveP2Y <- 0.8f;
        core.positiveP3X <- 1.16f; core.positiveP3Y <- 0.8f;
        core.positiveP4X <- 1.24f; core.positiveP4Y <- 0.8f;
        core.positiveP5X <- 1.32f; core.positiveP5Y <- 0.8f;
        core.positiveP6X <- 1.4f; core.positiveP6Y <- 0.8f;
        core.positiveP7X <- 1.5f; core.positiveP7Y <- 0.8f;
        core.positiveB1 <- -0.5f; core.positiveB2 <- 1.0f; core.positiveB3 <- 0.0f;
        core.positiveB4 <- 0.0f; core.positiveB5 <- 0.0f; core.positiveB6 <- 0.0f; core.positiveB7 <- 0.0f;

        core.negativePointCount <- 2.0f;
        core.negativeP1X <- 0.4f; core.negativeP1Y <- -0.2f;
        core.negativeP2X <- 0.9f; core.negativeP2Y <- -0.7f;
        core.negativeP3X <- 1.16f; core.negativeP3Y <- -0.7f;
        core.negativeP4X <- 1.24f; core.negativeP4Y <- -0.7f;
        core.negativeP5X <- 1.32f; core.negativeP5Y <- -0.7f;
        core.negativeP6X <- 1.4f; core.negativeP6Y <- -0.7f;
        core.negativeP7X <- 1.5f; core.negativeP7Y <- -0.7f;
        core.negativeB1 <- 0.5f; core.negativeB2 <- -1.0f; core.negativeB3 <- 0.0f;
        core.negativeB4 <- 0.0f; core.negativeB5 <- 0.0f; core.negativeB6 <- 0.0f; core.negativeB7 <- 0.0f;

        core.morphSide <- 1.0f;
        core.morphPoint <- 1.0f;
        core.morphTargetX <- 0.5f;
        core.morphTargetY <- 0.6f;
        core.morphPosition <- 0.0f;
        core.advance();
        return core.out;
    }

    bool close (float32 actual, float32 expected)
    {
        return std::intrinsics::abs (actual - expected) <= 2.0e-6f;
    }

    void main()
    {
        out <- close (render (0.25f), 0.225f) ? 1 : 0;
        advance();
        out <- close (render (0.75f), 0.75f) ? 1 : 0;
        advance();
        out <- close (render (-0.2f), -0.125f) ? 1 : 0;
        advance();
        out <- close (render (-0.65f), -0.325f) ? 1 : 0;
        advance();
        out <- close (render (1.2f), 0.8f) ? 1 : 0;
        advance();
        out <- close (render (-1.2f), -0.7f) ? 1 : 0;
        advance();
        out <- -1;
        advance();
    }
}

## testProcessor()

processor PolishCompressorCurveContract [[ main ]]
{
    output stream int32 out;

    void main()
    {
        let unityRatio = polishlab::desiredGainReductionDb (1.0f, -6.0f, 1.0f, 0.0f);
        let fourToOne = polishlab::desiredGainReductionDb (1.0f, -6.0f, 4.0f, 0.0f);
        let twentyToOne = polishlab::desiredGainReductionDb (1.0f, -6.0f, 20.0f, 0.0f);
        let underThreshold = polishlab::desiredGainReductionDb (0.25f, -6.0f, 20.0f, 0.0f);
        let softKneeAtThreshold = polishlab::desiredGainReductionDb (1.0f, 0.0f, 4.0f, 6.0f);

        out <- std::intrinsics::abs (unityRatio) < 1.0e-6f ? 1 : 0;
        advance();
        out <- std::intrinsics::abs (fourToOne + 4.5f) < 1.0e-5f ? 1 : 0;
        advance();
        out <- twentyToOne < fourToOne ? 1 : 0;
        advance();
        out <- std::intrinsics::abs (underThreshold) < 1.0e-6f ? 1 : 0;
        advance();
        out <- std::intrinsics::abs (softKneeAtThreshold + 0.5625f) < 1.0e-5f ? 1 : 0;
        advance();
        out <- -1;
        advance();
    }
}

## testProcessor()

processor PolishBypassContract [[ main ]]
{
    output stream int32 out;
    node lab = PolishVoicingProcessor;

    float32<2> signalForFrame (int32 frame)
    {
        return float32<2> (
            0.41f * std::intrinsics::sin (float32 (frame) * 0.071f),
            0.29f * std::intrinsics::sin (float32 (frame) * 0.047f + 0.7f)
        );
    }

    void main()
    {
        bool exact = true;

        for (int32 frame = 0; frame < 4096; ++frame)
        {
            let signal = signalForFrame (frame);
            lab.in <- signal;
            lab.bypass <- true;
            lab.thresholdDb <- -36.0f;
            lab.ratio <- 100.0f;
            lab.kneeDb <- 24.0f;
            lab.attackMs <- 0.05f;
            lab.releaseMs <- 5.0f;
            lab.makeupDb <- 24.0f;
            lab.curveP1X <- 0.2f;
            lab.curveP1Y <- -1.2f;
            lab.curveN1X <- 0.3f;
            lab.curveN1Y <- 1.1f;
            lab.morph <- 100.0f;
            lab.advance();

            if (lab.out[0] != signal[0] || lab.out[1] != signal[1])
                exact = false;
        }

        out <- exact ? 1 : 0;
        advance();
        out <- -1;
        advance();
    }
}

## testProcessor()

processor PolishTunableSignalContract [[ main ]]
{
    output stream int32 out;
    node neutral = PolishVoicingProcessor;
    node tuned = PolishVoicingProcessor;

    float32<2> signalForFrame (int32 frame)
    {
        let time = float32 (frame);
        return float32<2> (
            (0.24f * std::intrinsics::sin (time * 0.071f))
                + (0.08f * std::intrinsics::sin (time * 0.193f)),
            (0.21f * std::intrinsics::sin (time * 0.053f + 0.4f))
                + (0.07f * std::intrinsics::sin (time * 0.227f))
        );
    }

    void main()
    {
        float32 maxDifference;
        bool bounded = true;

        for (int32 frame = 0; frame < 8192; ++frame)
        {
            let signal = signalForFrame (frame);
            neutral.in <- signal;
            neutral.advance();

            tuned.in <- signal;
            tuned.thresholdDb <- -18.0f;
            tuned.ratio <- 32.0f;
            tuned.kneeDb <- 9.0f;
            tuned.attackMs <- 8.0f;
            tuned.releaseMs <- 180.0f;
            tuned.makeupDb <- -3.0f;
            tuned.curvePointCount <- 2.0f;
            tuned.curveP1X <- 0.55f;
            tuned.curveP1Y <- 0.38f;
            tuned.curveB1 <- -0.25f;
            tuned.curveP2X <- 0.82f;
            tuned.curveP2Y <- 0.7f;
            tuned.curveB2 <- 0.35f;
            tuned.curveNPointCount <- 2.0f;
            tuned.curveN1X <- 0.48f;
            tuned.curveN1Y <- -0.31f;
            tuned.curveNB1 <- 0.2f;
            tuned.curveN2X <- 0.95f;
            tuned.curveN2Y <- -0.76f;
            tuned.curveNB2 <- -0.4f;
            tuned.morphSide <- 1.0f;
            tuned.morphPoint <- 2.0f;
            tuned.morphTargetX <- 0.68f;
            tuned.morphTargetY <- 0.92f;
            tuned.morph <- 55.0f;
            tuned.advance();

            if (frame > 2048)
            {
                maxDifference = std::intrinsics::max (
                    maxDifference,
                    std::intrinsics::max (
                        std::intrinsics::abs (tuned.out[0] - neutral.out[0]),
                        std::intrinsics::abs (tuned.out[1] - neutral.out[1])
                    )
                );

                if (tuned.out[0] != tuned.out[0]
                    || tuned.out[1] != tuned.out[1]
                    || std::intrinsics::abs (tuned.out[0]) > 2.0f
                    || std::intrinsics::abs (tuned.out[1]) > 2.0f)
                    bounded = false;
            }
        }

        out <- bounded && maxDifference > 0.05f ? 1 : 0;
        advance();
        out <- -1;
        advance();
    }
}
