namespace wt
{
    let enhancerSpectrumFFTSize = 4096;
    let enhancerSpectrumBinCount = enhancerSpectrumFFTSize / 2;
    let enhancerSpectrumWindowSize = 1024;
    let enhancerSpectrumFramesPerSecond = 20.0f;

    struct EnhancerSpectrumFrame
    {
        float32 sampleRateHz;
        float32[enhancerSpectrumBinCount] magnitudes;
    }

    // Stereo power is measured before magnitude conversion so pure Side input
    // remains visible instead of cancelling in a mono-average analyser.
    processor EnhancerSpectrumAnalyzer (int32 initiallyEnabled)
    {
        input stream float32<2> in;
        input event int32 enabledIn;
        output event EnhancerSpectrumFrame spectrum;

        let hopSize = int32 (
            float32 (processor.frequency) / enhancerSpectrumFramesPerSecond
        );

        float32[enhancerSpectrumWindowSize] leftRing;
        float32[enhancerSpectrumWindowSize] rightRing;
        float32[enhancerSpectrumFFTSize] fftBuffer;
        wrap<enhancerSpectrumWindowSize> writePosition;
        int32 collectedFrames;
        int32 framesUntilAnalysis;
        bool enabled;

        float32[enhancerSpectrumWindowSize] hann()
        {
            float32[enhancerSpectrumWindowSize] window;

            for (wrap<enhancerSpectrumWindowSize> index)
                window[index] = 0.5f * (1.0f - std::intrinsics::cos (
                    float32 (twoPi) * float32 (index)
                        / float32 (enhancerSpectrumWindowSize - 1)
                ));

            return window;
        }

        float32[enhancerSpectrumWindowSize] window = hann();

        event enabledIn (int32 value)
        {
            enabled = value != 0;
            writePosition = 0;
            collectedFrames = 0;
            framesUntilAnalysis = enhancerSpectrumWindowSize;
        }

        void copyChannelToFFTBuffer (bool useRightChannel)
        {
            for (wrap<enhancerSpectrumWindowSize> index)
            {
                let sourceIndex = wrap<enhancerSpectrumWindowSize> (
                    int32 (writePosition) + int32 (index)
                );
                let sample = useRightChannel
                    ? rightRing[sourceIndex]
                    : leftRing[sourceIndex];
                fftBuffer[index] = sample * window[index];
            }

            for (int32 index = enhancerSpectrumWindowSize;
                 index < enhancerSpectrumFFTSize;
                 ++index)
                fftBuffer.at (index) = 0.0f;
        }

        void emitSpectrum()
        {
            EnhancerSpectrumFrame result;
            result.sampleRateHz = float32 (processor.frequency);
            float32[enhancerSpectrumFFTSize] fft;

            copyChannelToFFTBuffer (false);
            std::frequency::realOnlyForwardFFT (fftBuffer, fft);
            for (wrap<enhancerSpectrumBinCount> index)
            {
                let real = fft[index];
                let imag = fft.at (enhancerSpectrumBinCount + index);
                result.magnitudes[index] = (real * real) + (imag * imag);
            }

            copyChannelToFFTBuffer (true);
            std::frequency::realOnlyForwardFFT (fftBuffer, fft);
            let amplitudeCalibration = 4.0f
                / float32 (enhancerSpectrumWindowSize);
            for (wrap<enhancerSpectrumBinCount> index)
            {
                let real = fft[index];
                let imag = fft.at (enhancerSpectrumBinCount + index);
                let rightPower = (real * real) + (imag * imag);
                let stereoPower = 0.5f
                    * (result.magnitudes[index] + rightPower);
                result.magnitudes[index] = std::intrinsics::sqrt (stereoPower)
                    * amplitudeCalibration;
            }

            spectrum <- result;
        }

        void main()
        {
            enabled = initiallyEnabled != 0;
            framesUntilAnalysis = enhancerSpectrumWindowSize;

            loop
            {
                if (enabled)
                {
                    leftRing[writePosition] = in[0];
                    rightRing[writePosition] = in[1];
                    writePosition = wrap<enhancerSpectrumWindowSize> (
                        int32 (writePosition) + 1
                    );

                    if (collectedFrames < enhancerSpectrumWindowSize)
                        ++collectedFrames;

                    --framesUntilAnalysis;
                    if (collectedFrames >= enhancerSpectrumWindowSize
                        && framesUntilAnalysis <= 0)
                    {
                        emitSpectrum();
                        framesUntilAnalysis = hopSize;
                    }
                }

                advance();
            }
        }
    }
}
