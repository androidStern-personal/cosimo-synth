namespace wt
{
    //==============================================================================
    // Voice-to-global modulation reduction - the piece that lets a PER-VOICE
    // modulation source drive a GLOBAL effects-rack parameter (ADR-002).
    //
    // WHERE THIS RUNS. SharedVoiceEngine resolves each used voice source once,
    // reduces it once across sounding voices, then fans that result out through the
    // sparse voice-to-rack program. Cosimo is not a per-voice-graph synth: all sixteen
    // voices live in one processor holding parallel arrays, so reduction is an
    // ordinary source-centric array loop over data already in scope. SharedVoiceEngine
    // owns that stateful loop; this module owns only the wire vocabulary and reusable
    // polarity, gate, and smoothing functions.
    //
    // WHY MAXIMUM STARTS AT ONE. Cmajor structs have no field defaults, so an omitted
    // or zero-initialised reducerKind arrives as 0. Keeping valid reducers non-zero
    // lets the compiled-program installer reject malformed voice-to-rack instructions.
    //
    // WHY `maximum` REDUCES ON THE POLARISED VALUE. ADR-002 says maximum is "the
    // strongest participating voice". A bipolar source of 0.0 polarises to -1.0, so a
    // raw max() over the [0,1] source domain picks the most POSITIVE deflection and
    // throws away the strongest one. Two voices at 0.0 and 0.6, bipolar, amount 0.8:
    // the raw rule returns +0.16 while the strongest voice is at -0.8. Reducing by
    // MAGNITUDE OF THE POLARISED VALUE, sign preserved, is what the words mean.
    // Unipolar is unaffected - polarisation is the identity there.
    //
    // WHY THE GATE IS HELD AND RAMPED, NOT STEPPED. With no voice participating the
    // destination must sit at exactly its patch-owned base value (ADR-004), so the
    // offset must reach exactly 0. But stepping there the instant the last voice
    // retires is a click: Velocity is never at 0, Slide sits wherever it was left, and
    // a bipolar source at rest is at FULL NEGATIVE. Worse, that instant is precisely
    // when the rack's own delay and reverb tails are still sounding, because the
    // engine's participation predicate covers the release stage. The last reduced
    // offset is therefore HELD and its gate ramped linearly to zero over a musically
    // scaled release. Linear rather than exponential because an exponential never
    // arrives, and "exactly the base value" is the requirement.
    //
    // ONE SHARED POLARITY FUNCTION. Both the voice and rack paths call
    // applyModulationPolarity, so their semantics cannot drift apart.

    //==============================================================================
    // Reducer policies. Zero is invalid - see above.

    //==============================================================================
    // Rack modulation destinations.
    //
    // ADR-012: "Every continuous creative parameter owned by a rack module is eligible
    // to be a modulation destination, including Mix/Wet." All thirty-six of them are
    // here. Rack order, enabled state and discrete mode selectors are deliberately
    // absent - they are not continuous, and the glossary's "Routable Effect Parameter"
    // excludes them in v1. Hiding a destination from the v1 UI is a UI-surface
    // decision; this table is where DSP eligibility lives, and it withholds nothing.
    //
    // The indices are a wire contract with the compiler. They are grouped in rack
    // module declaration order and must only ever be appended to.
    //
    // Frequency-like destinations modulate in OCTAVES, matching the engine's existing
    // modulationTargetFilterCutoffOctaves convention; everything else is in the
    // destination's own natural units.

    let rackModTargetGlobalFilterCutoffOctaves  = 0;
    let rackModTargetGlobalFilterResonance      = 1;
    let rackModTargetGlobalFilterDrive          = 2;
    let rackModTargetDistortionDriveDb          = 3;
    let rackModTargetDistortionKnee             = 4;
    let rackModTargetDistortionWet              = 5;
    let rackModTargetDistortionWetHPOctaves     = 6;
    let rackModTargetDistortionWetLPOctaves     = 7;
    let rackModTargetOttMix                     = 8;
    let rackModTargetOttAmount                  = 9;
    let rackModTargetOttTimePercent             = 10;
    let rackModTargetOttBandDrive               = 11;
    let rackModTargetOttEnvelopeMatch           = 12;
    let rackModTargetChorusMix                  = 13;
    let rackModTargetChorusTone                 = 14;
    let rackModTargetChorusFeedback             = 15;
    let rackModTargetChorusRingAmount           = 16;
    let rackModTargetChorusRingFineSemitones    = 17;
    let rackModTargetFlangerRate                = 18;
    let rackModTargetFlangerDepth               = 19;
    let rackModTargetFlangerFeedback            = 20;
    let rackModTargetFlangerMix                 = 21;
    let rackModTargetPhaserRate                 = 22;
    let rackModTargetPhaserDepth                = 23;
    let rackModTargetPhaserFrequencyOctaves     = 24;
    let rackModTargetPhaserFeedback             = 25;
    let rackModTargetPhaserPhase                = 26;
    let rackModTargetPhaserMix                  = 27;
    let rackModTargetDelayTimeOctaves           = 28;
    let rackModTargetDelayFeedback              = 29;
    let rackModTargetDelayFilterOctaves         = 30;
    let rackModTargetDelayMix                   = 31;
    let rackModTargetReverbSize                 = 32;
    let rackModTargetReverbDecay                = 33;
    let rackModTargetReverbDamping              = 34;
    let rackModTargetReverbMix                  = 35;

    //==============================================================================
    // Timing.

    // How long the held offset takes to reach exactly zero after the last participating
    // voice retires. Long enough that a Velocity 0.9 mapping glides rather than zips
    // over a live reverb tail, short enough that the destination is back at its base
    // value before the next phrase. First-pass value: it wants a listening pass before
    // it is frozen.
    let rackModGateReleaseMs = 180.0f;

    // Ordinary parameter smoothing on the reduced value, matching the rampFrames 64/128
    // idiom the rest of the instrument uses. A one-pole, so it adds no latency.
    let rackModSmoothingMs = 5.0f;

    //==============================================================================
    // Free helpers.

    // The polarity law, shared with the voice path. A unipolar source passes through
    // clamped; a bipolar source is mapped from [0,1] onto [-1,+1], which is why a
    // bipolar source AT REST sits at full negative rather than at zero.
    float32 applyModulationPolarity (float32 sourceValue, int32 polarityKind)
    {
        let clampedSourceValue = std::intrinsics::clamp (sourceValue, 0.0f, 1.0f);

        if (polarityKind == modulationPolarityBipolar)
            return (clampedSourceValue * 2.0f) - 1.0f;

        return clampedSourceValue;
    }

    // A program install folds polarity and amount into y = (source * scale) + bias.
    // The hot voice path resolves and clamps each source once, then needs no per-route
    // polarity branch or cell-indexed amount load.
    float32 modulationRouteScale (float32 amount, int32 polarityKind)
    {
        return polarityKind == modulationPolarityBipolar ? amount * 2.0f : amount;
    }

    float32 modulationRouteBias (float32 amount, int32 polarityKind)
    {
        return polarityKind == modulationPolarityBipolar ? -amount : 0.0f;
    }

    // Fraction of the way from the held offset to zero per frame. Linear, so the offset
    // arrives at EXACTLY zero after rackModGateReleaseMs.
    float32 rackModGateReleaseStep (float32 sampleRate)
    {
        let releaseFrames = std::intrinsics::max (1.0f, rackModGateReleaseMs * 0.001f * sampleRate);
        return 1.0f / releaseFrames;
    }

    // The instrument's one-pole idiom (Chorus.cmajor:461, Delay.cmajor:225, Ott.cmajor:141).
    float32 rackModOnePoleCoefficient (float32 milliseconds, float32 sampleRate)
    {
        let frames = std::intrinsics::max (1.0f, milliseconds * 0.001f * sampleRate);
        return 1.0f - std::intrinsics::exp (-1.0f / frames);
    }

    float32 rackModOnePole (float32 current, float32 target, float32 coefficient)
    {
        return current + ((target - current) * coefficient);
    }

    let rackModSnapThreshold = 0.000001f;

    float32 rackModSmoothTowards (float32 current, float32 target, float32 coefficient)
    {
        if (std::intrinsics::abs (target - current) <= rackModSnapThreshold)
            return target;

        return rackModOnePole (current, target, coefficient);
    }

}
