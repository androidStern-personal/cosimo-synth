namespace wt
{
    let playModePoly = 0;
    let playModeMono = 1;
    let playModeLegato = 2;
    let maxMonoHeldNotes = 64;

    struct DesiredTableChange
    {
        int32 tableIndex;
    }

    struct WorkerLoadFailure
    {
        int32 dspSessionId;
        int32 tableIndex;
        int32 generation;
        int32 candidateAttemptSerial;
        int32 failurePhase;
        int32 failureReasonCode;
    }

    // What the rack is ACTUALLY running, for readback by the UI. The order and enable
    // mask are packed rather than arrayed to match the rack's own diagnostic endpoints -
    // three bits per rack position, least-significant-position first, and one bit per
    // effect instance id. A non-zero rejected count is an adapter bug: it means an
    // upload was malformed and was rejected outright rather than coerced (ADR-009).
    struct EffectiveRackState
    {
        int32 committedStructureGeneration;
        int32 committedOrderCode;
        int32 committedEnableMask;
        int32 rejectedOrderCount;
        int32 rejectedEnableCount;
    }

    struct RuntimeState
    {
        int32 dspSessionId;
        int32 desiredIntentSerial;
        int32 desiredTableIndex;
        int32 generationFrontier;
        int32 serviceState;
        int32 hasActive;
        int32 activeTableIndex;
        int32 activeGeneration;
        int32 hasLoading;
        int32 loadingTableIndex;
        int32 loadingGeneration;
        int32 hasFailure;
        int32 failedTableIndex;
        int32 failedGeneration;
        int32 failureScope;
        int32 failurePhase;
        int32 failureReasonCode;
    }

    processor NoteDispatcher (int voiceCount,
                              int MPEMasterChannel = 0)
    {
        input event (std::notes::NoteOn,
                     std::notes::NoteOff,
                     std::notes::PitchBend,
                     std::notes::Slide,
                     std::notes::Pressure,
                     std::notes::Control) eventIn;
        input event wt::ArticulationNoteMeta noteMetaIn;
        input event wt::ArticulatedNoteOn articulatedNoteOnIn;
        input value float32 playModeIn [[ name: "Play Mode", min: 0.0f, max: 2.0f, init: 0.0f, discrete: true, step: 1.0f, rampFrames: 0 ]];

        output event (std::notes::NoteOn,
                      std::notes::NoteOff,
                      std::notes::PitchBend,
                      std::notes::Slide,
                      std::notes::Pressure,
                      std::notes::Control,
                      wt::ArticulatedNoteOn) voiceEventOut[voiceCount];
        output event wt::VoiceRetune voiceRetuneOut[voiceCount];

        struct VoiceState
        {
            bool isActive, isReleasing;
            int32 channel, age;
            float32 pitch;

            void start (int32 nextActiveAge, int32 voiceChannel, float32 voicePitch)
            {
                this.isActive = true;
                this.isReleasing = false;
                this.channel = voiceChannel;
                this.pitch = voicePitch;
                this.age = nextActiveAge;
            }

            void free (int32 nextInactiveAge)
            {
                this.isActive = false;
                this.isReleasing = false;
                this.channel = -1;
                this.pitch = 0.0f;
                this.age = nextInactiveAge;
            }
        }

        struct HeldMonoNote
        {
            bool occupied, held, sustained;
            bool hasArticulation;
            int32 channel, order;
            int32 selectorA, selectorB, durationSamples, ageSamples;
            float32 pitch, velocity;
        }

        static_assert (voiceCount > 0);

        VoiceState[voiceCount] polyVoiceState;
        HeldMonoNote[maxMonoHeldNotes] monoHeldNotes;

        float32[16] channelPitchBendSemitones;
        float32[16] channelPressure;
        float32[16] channelSlide;
        bool[16 * 128] pendingNoteMetaValid;
        int32[16 * 128] pendingNoteMetaSelectorA;
        int32[16 * 128] pendingNoteMetaSelectorB;
        int32[16 * 128] pendingNoteMetaDurationSamples;
        int32[16 * 128] pendingNoteMetaAgeSamples;

        int32 nextActiveTime = 0x70000000;
        int32 nextInactiveTime = 1;
        bool mpeMasterSustainActive;
        int64 perChannelSustainActive;
        int32 playModeState = playModePoly;
        int32 lastObservedPlayMode = playModePoly;
        int32 nextMonoOrder = 1;
        bool monoVoiceActive = false;
        int32 monoVoiceChannel = -1;
        float32 monoVoicePitch = 0.0f;

        int32 readPlayModeInput()
        {
            let rounded = int32 (
                std::intrinsics::floor (
                    std::intrinsics::clamp (playModeIn, 0.0f, 2.0f) + 0.5f
                )
            );
            return rounded;
        }

        int32 normalisePlayMode() { return playModeState; }

        bool isMonoMode()
        {
            return normalisePlayMode() != playModePoly;
        }

        bool isLegatoMode()
        {
            return normalisePlayMode() == playModeLegato;
        }

        bool pitchesMatch (float32 left, float32 right)
        {
            return std::intrinsics::abs (left - right) <= 0.0001f;
        }

        int32 noteMetaIndex (int32 channel, int32 noteNumber)
        {
            return (channel * 128) + noteNumber;
        }

        int32 noteNumberFromPitch (float32 pitch)
        {
            return int32 (std::intrinsics::floor (pitch + 0.5f));
        }

        bool hasPendingNoteMeta (std::notes::NoteOn noteOn)
        {
            let noteNumber = noteNumberFromPitch (noteOn.pitch);

            if (noteOn.channel < 0 || noteOn.channel >= 16 || noteNumber < 0 || noteNumber >= 128)
                return false;

            return pendingNoteMetaValid.at (noteMetaIndex (noteOn.channel, noteNumber));
        }

        wt::ArticulatedNoteOn consumePendingNoteMeta (std::notes::NoteOn noteOn)
        {
            let noteNumber = noteNumberFromPitch (noteOn.pitch);
            let index = noteMetaIndex (noteOn.channel, noteNumber);

            wt::ArticulatedNoteOn articulatedNote;
            articulatedNote.channel = noteOn.channel;
            articulatedNote.pitch = noteOn.pitch;
            articulatedNote.velocity = noteOn.velocity;
            articulatedNote.hasArticulation = true;
            articulatedNote.selectorA = pendingNoteMetaSelectorA.at (index);
            articulatedNote.selectorB = pendingNoteMetaSelectorB.at (index);
            articulatedNote.durationSamples = pendingNoteMetaDurationSamples.at (index);
            articulatedNote.ageSamples = pendingNoteMetaAgeSamples.at (index);
            pendingNoteMetaValid.at (index) = false;
            return articulatedNote;
        }

        bool isSustainActive (int32 channel)
        {
            if (channel < 0 || channel >= 64)
                return mpeMasterSustainActive;

            return mpeMasterSustainActive || (perChannelSustainActive & (1L << channel)) != 0;
        }

        void setChannelSustain (int32 channel, bool active)
        {
            if (channel < 0 || channel >= 64)
                return;

            if (active)
                perChannelSustainActive |= (1L << channel);
            else
                perChannelSustainActive &= ~(1L << channel);
        }

        void clearMonoHeldNotes()
        {
            for (int32 slot = 0; slot < maxMonoHeldNotes; ++slot)
            {
                monoHeldNotes.at (slot).occupied = false;
                monoHeldNotes.at (slot).held = false;
                monoHeldNotes.at (slot).sustained = false;
                monoHeldNotes.at (slot).hasArticulation = false;
                monoHeldNotes.at (slot).channel = -1;
                monoHeldNotes.at (slot).order = 0;
                monoHeldNotes.at (slot).selectorA = wt::articulationSelectorNone;
                monoHeldNotes.at (slot).selectorB = 0;
                monoHeldNotes.at (slot).durationSamples = 0;
                monoHeldNotes.at (slot).ageSamples = 0;
                monoHeldNotes.at (slot).pitch = 0.0f;
                monoHeldNotes.at (slot).velocity = 0.0f;
            }
        }

        int32 findHeldMonoSlot (int32 channel, float32 pitch)
        {
            for (int32 slot = 0; slot < maxMonoHeldNotes; ++slot)
            {
                let heldNote = monoHeldNotes.at (slot);
                if (heldNote.occupied && heldNote.channel == channel && pitchesMatch (heldNote.pitch, pitch))
                    return slot;
            }

            return -1;
        }

        int32 findFreeHeldMonoSlot()
        {
            for (int32 slot = 0; slot < maxMonoHeldNotes; ++slot)
                if (! monoHeldNotes.at (slot).occupied)
                    return slot;

            return -1;
        }

        bool monoSlotMatchesCurrentVoice (int32 slot)
        {
            if (slot < 0 || ! monoVoiceActive)
                return false;

            let heldNote = monoHeldNotes.at (slot);
            return heldNote.occupied
                && heldNote.channel == monoVoiceChannel
                && pitchesMatch (heldNote.pitch, monoVoicePitch);
        }

        int32 chooseMonoPrioritySlot()
        {
            int32 selectedSlot = -1;
            int32 selectedOrder = -1;

            for (int32 slot = 0; slot < maxMonoHeldNotes; ++slot)
            {
                let heldNote = monoHeldNotes.at (slot);

                if (! heldNote.occupied || (! heldNote.held && ! heldNote.sustained))
                    continue;

                if (selectedSlot < 0)
                {
                    selectedSlot = slot;
                    selectedOrder = heldNote.order;
                    continue;
                }

                if (heldNote.order > selectedOrder)
                {
                    selectedSlot = slot;
                    selectedOrder = heldNote.order;
                }
            }

            return selectedSlot;
        }

        void emitExpressionSnapshotForVoice (wrap<voiceCount> voice, int32 channel)
        {
            if (channel < 0 || channel >= 16)
                return;

            std::notes::PitchBend bend;
            bend.channel = channel;
            bend.bendSemitones = channelPitchBendSemitones.at (channel);
            voiceEventOut[voice] <- bend;

            std::notes::Pressure pressure;
            pressure.channel = channel;
            pressure.pressure = channelPressure.at (channel);
            voiceEventOut[voice] <- pressure;

            std::notes::Slide slide;
            slide.channel = channel;
            slide.slide = channelSlide.at (channel);
            voiceEventOut[voice] <- slide;
        }

        wrap<voiceCount> findOldestIndex()
        {
            if const (voiceCount == 1)
            {
                return 0;
            }
            else
            {
                wrap<voiceCount> index;
                var oldest = polyVoiceState[0].age;

                for (wrap<voiceCount> voice = 1)
                {
                    let age = polyVoiceState[voice].age;

                    if (age < oldest)
                    {
                        index = voice;
                        oldest = age;
                    }
                }

                return index;
            }
        }

        void handlePolyNoteOn (std::notes::NoteOn noteOn)
        {
            let oldest = findOldestIndex();

            if (polyVoiceState[oldest].isActive)
            {
                voiceEventOut[oldest] <- std::notes::NoteOff (polyVoiceState[oldest].channel,
                                                              polyVoiceState[oldest].pitch,
                                                              0.0f);
            }

            polyVoiceState[oldest].start (++nextActiveTime, noteOn.channel, noteOn.pitch);
            voiceEventOut[oldest] <- noteOn;
            emitExpressionSnapshotForVoice (oldest, noteOn.channel);
        }

        void handlePolyArticulatedNoteOn (wt::ArticulatedNoteOn noteOn)
        {
            let oldest = findOldestIndex();

            if (polyVoiceState[oldest].isActive)
            {
                voiceEventOut[oldest] <- std::notes::NoteOff (polyVoiceState[oldest].channel,
                                                              polyVoiceState[oldest].pitch,
                                                              0.0f);
            }

            polyVoiceState[oldest].start (++nextActiveTime, noteOn.channel, noteOn.pitch);
            voiceEventOut[oldest] <- noteOn;
            emitExpressionSnapshotForVoice (oldest, noteOn.channel);
        }

        void handlePolyNoteOff (std::notes::NoteOff noteOff)
        {
            for (wrap<voiceCount> voice)
            {
                if (polyVoiceState[voice].channel == noteOff.channel
                    && pitchesMatch (polyVoiceState[voice].pitch, noteOff.pitch))
                {
                    if (isSustainActive (noteOff.channel))
                    {
                        polyVoiceState[voice].isReleasing = true;
                    }
                    else
                    {
                        voiceEventOut[voice] <- noteOff;
                        polyVoiceState[voice].free (++nextInactiveTime);
                    }
                }
            }
        }

        void assignMonoHeldNote (int32 slot,
                                 std::notes::NoteOn noteOn,
                                 bool hasArticulation,
                                 int32 selectorA,
                                 int32 selectorB,
                                 int32 durationSamples,
                                 int32 ageSamples)
        {
            monoHeldNotes.at (slot).occupied = true;
            monoHeldNotes.at (slot).held = true;
            monoHeldNotes.at (slot).sustained = false;
            monoHeldNotes.at (slot).hasArticulation = hasArticulation;
            monoHeldNotes.at (slot).channel = noteOn.channel;
            monoHeldNotes.at (slot).pitch = noteOn.pitch;
            monoHeldNotes.at (slot).velocity = noteOn.velocity;
            monoHeldNotes.at (slot).order = nextMonoOrder;
            monoHeldNotes.at (slot).selectorA = selectorA;
            monoHeldNotes.at (slot).selectorB = selectorB;
            monoHeldNotes.at (slot).durationSamples = durationSamples;
            monoHeldNotes.at (slot).ageSamples = ageSamples;
            nextMonoOrder += 1;
        }

        void addOrRefreshMonoHeldNote (std::notes::NoteOn noteOn)
        {
            int32 slot = findHeldMonoSlot (noteOn.channel, noteOn.pitch);

            if (slot < 0)
                slot = findFreeHeldMonoSlot();

            if (slot < 0)
                return;

            assignMonoHeldNote (slot, noteOn, false, wt::articulationSelectorNone, 0, 0, 0);
        }

        void addOrRefreshMonoHeldArticulatedNote (wt::ArticulatedNoteOn articulatedNote)
        {
            int32 slot = findHeldMonoSlot (articulatedNote.channel, articulatedNote.pitch);

            if (slot < 0)
                slot = findFreeHeldMonoSlot();

            if (slot < 0)
                return;

            std::notes::NoteOn noteOn;
            noteOn.channel = articulatedNote.channel;
            noteOn.pitch = articulatedNote.pitch;
            noteOn.velocity = articulatedNote.velocity;
            assignMonoHeldNote (slot,
                                noteOn,
                                articulatedNote.hasArticulation,
                                articulatedNote.selectorA,
                                articulatedNote.selectorB,
                                articulatedNote.durationSamples,
                                articulatedNote.ageSamples);
        }

        void releaseMonoHeldNote (std::notes::NoteOff noteOff)
        {
            let slot = findHeldMonoSlot (noteOff.channel, noteOff.pitch);

            if (slot < 0)
                return;

            if (isSustainActive (noteOff.channel))
            {
                monoHeldNotes.at (slot).held = false;
                monoHeldNotes.at (slot).sustained = true;
                return;
            }

            monoHeldNotes.at (slot).occupied = false;
            monoHeldNotes.at (slot).held = false;
            monoHeldNotes.at (slot).sustained = false;
        }

        void clearReleasedSustainedMonoNotesForChannel (int32 channel)
        {
            for (int32 slot = 0; slot < maxMonoHeldNotes; ++slot)
            {
                let heldNote = monoHeldNotes.at (slot);

                if (! heldNote.occupied)
                    continue;

                if (heldNote.held)
                    continue;

                if (channel == MPEMasterChannel || heldNote.channel == channel)
                {
                    monoHeldNotes.at (slot).occupied = false;
                    monoHeldNotes.at (slot).sustained = false;
                }
            }
        }

        void emitMonoVoiceRetuneForSlot (int32 slot,
                                         bool retrigger,
                                         bool glide)
        {
            if (slot < 0 || slot >= maxMonoHeldNotes)
                return;

            let heldNote = monoHeldNotes.at (slot);
            if (! heldNote.occupied)
                return;

            wt::VoiceRetune change;
            change.channel = heldNote.channel;
            change.pitch = heldNote.pitch;
            change.velocity = heldNote.velocity;
            change.bendSemitones = heldNote.channel >= 0 && heldNote.channel < 16 ? channelPitchBendSemitones.at (heldNote.channel) : 0.0f;
            change.pressure = heldNote.channel >= 0 && heldNote.channel < 16 ? channelPressure.at (heldNote.channel) : 0.0f;
            change.slide = heldNote.channel >= 0 && heldNote.channel < 16 ? channelSlide.at (heldNote.channel) : 0.0f;
            change.retrigger = retrigger;
            change.glide = glide;
            change.hasArticulation = heldNote.hasArticulation;
            change.selectorA = heldNote.selectorA;
            change.selectorB = heldNote.selectorB;
            change.durationSamples = heldNote.durationSamples;
            change.ageSamples = heldNote.ageSamples;
            voiceRetuneOut[0] <- change;

            monoVoiceActive = true;
            monoVoiceChannel = heldNote.channel;
            monoVoicePitch = heldNote.pitch;
        }

        void emitMonoVoiceNoteOff (float32 velocity)
        {
            if (! monoVoiceActive)
                return;

            voiceEventOut[0] <- std::notes::NoteOff (monoVoiceChannel,
                                                     monoVoicePitch,
                                                     velocity);
            monoVoiceActive = false;
            monoVoiceChannel = -1;
            monoVoicePitch = 0.0f;
        }

        void applyMonoSelectionAfterNoteOn()
        {
            let selectedSlot = chooseMonoPrioritySlot();

            if (selectedSlot < 0)
                return;

            if (monoSlotMatchesCurrentVoice (selectedSlot))
            {
                if (! isLegatoMode())
                    emitMonoVoiceRetuneForSlot (selectedSlot, true, false);

                return;
            }

            let retrigger = ! monoVoiceActive || ! isLegatoMode();
            let glide = monoVoiceActive;
            emitMonoVoiceRetuneForSlot (selectedSlot, retrigger, glide);
        }

        void applyMonoSelectionAfterNoteOff (float32 releaseVelocity)
        {
            let selectedSlot = chooseMonoPrioritySlot();

            if (selectedSlot < 0)
            {
                emitMonoVoiceNoteOff (releaseVelocity);
                return;
            }

            if (monoSlotMatchesCurrentVoice (selectedSlot))
                return;

            let retrigger = ! isLegatoMode();
            let glide = monoVoiceActive;
            emitMonoVoiceRetuneForSlot (selectedSlot, retrigger, glide);
        }

        void resetDispatcherState()
        {
            for (wrap<voiceCount> voice)
            {
                if (polyVoiceState[voice].isActive)
                    voiceEventOut[voice] <- std::notes::NoteOff (polyVoiceState[voice].channel,
                                                                 polyVoiceState[voice].pitch,
                                                                 0.0f);

                polyVoiceState[voice].free (++nextInactiveTime);
            }

            emitMonoVoiceNoteOff (0.0f);
            clearMonoHeldNotes();
            mpeMasterSustainActive = false;
            perChannelSustainActive = 0;

            for (int32 index = 0; index < 16 * 128; ++index)
                pendingNoteMetaValid.at (index) = false;
        }

        event eventIn (std::notes::NoteOn noteOn)
        {
            if (hasPendingNoteMeta (noteOn))
            {
                let articulatedNote = consumePendingNoteMeta (noteOn);

                if (! isMonoMode())
                {
                    handlePolyArticulatedNoteOn (articulatedNote);
                    return;
                }

                addOrRefreshMonoHeldArticulatedNote (articulatedNote);
                applyMonoSelectionAfterNoteOn();
                return;
            }

            if (! isMonoMode())
            {
                handlePolyNoteOn (noteOn);
                return;
            }

            addOrRefreshMonoHeldNote (noteOn);
            applyMonoSelectionAfterNoteOn();
        }

        event noteMetaIn (wt::ArticulationNoteMeta meta)
        {
            if (meta.channel < 0 || meta.channel >= 16 || meta.noteNumber < 0 || meta.noteNumber >= 128)
                return;

            let index = noteMetaIndex (meta.channel, meta.noteNumber);
            pendingNoteMetaValid.at (index) = true;
            pendingNoteMetaSelectorA.at (index) = meta.selectorA;
            pendingNoteMetaSelectorB.at (index) = meta.selectorB;
            pendingNoteMetaDurationSamples.at (index) = meta.durationSamples;
            pendingNoteMetaAgeSamples.at (index) = meta.ageSamples;
        }

        event articulatedNoteOnIn (wt::ArticulatedNoteOn noteOn)
        {
            if (! isMonoMode())
            {
                handlePolyArticulatedNoteOn (noteOn);
                return;
            }

            addOrRefreshMonoHeldArticulatedNote (noteOn);
            applyMonoSelectionAfterNoteOn();
        }

        event eventIn (std::notes::NoteOff noteOff)
        {
            if (! isMonoMode())
            {
                handlePolyNoteOff (noteOff);
                return;
            }

            if (isSustainActive (noteOff.channel))
            {
                releaseMonoHeldNote (noteOff);
                return;
            }

            releaseMonoHeldNote (noteOff);
            applyMonoSelectionAfterNoteOff (noteOff.velocity);
        }

        event eventIn (std::notes::PitchBend bend)
        {
            if (bend.channel >= 0 && bend.channel < 16)
                channelPitchBendSemitones.at (bend.channel) = bend.bendSemitones;

            if (! isMonoMode())
            {
                for (wrap<voiceCount> voice)
                    if (polyVoiceState[voice].channel == bend.channel)
                        voiceEventOut[voice] <- bend;

                return;
            }

            if (monoVoiceActive && monoVoiceChannel == bend.channel)
                voiceEventOut[0] <- bend;
        }

        event eventIn (std::notes::Pressure pressure)
        {
            if (pressure.channel >= 0 && pressure.channel < 16)
                channelPressure.at (pressure.channel) = pressure.pressure;

            if (! isMonoMode())
            {
                for (wrap<voiceCount> voice)
                    if (polyVoiceState[voice].channel == pressure.channel)
                        voiceEventOut[voice] <- pressure;

                return;
            }

            if (monoVoiceActive && monoVoiceChannel == pressure.channel)
                voiceEventOut[0] <- pressure;
        }

        event eventIn (std::notes::Slide slide)
        {
            if (slide.channel >= 0 && slide.channel < 16)
                channelSlide.at (slide.channel) = slide.slide;

            if (! isMonoMode())
            {
                for (wrap<voiceCount> voice)
                    if (polyVoiceState[voice].channel == slide.channel)
                        voiceEventOut[voice] <- slide;

                return;
            }

            if (monoVoiceActive && monoVoiceChannel == slide.channel)
                voiceEventOut[0] <- slide;
        }

        event eventIn (std::notes::Control control)
        {
            if (control.control == 64)
            {
                bool sustainActive = control.value >= 0.5f;
                setChannelSustain (control.channel, sustainActive);

                if (control.channel == MPEMasterChannel)
                    mpeMasterSustainActive = sustainActive;

                if (! isMonoMode())
                {
                    if (! sustainActive)
                    {
                        for (wrap<voiceCount> voice)
                        {
                            if ((control.channel == MPEMasterChannel || polyVoiceState[voice].channel == control.channel)
                                && polyVoiceState[voice].isActive
                                && polyVoiceState[voice].isReleasing)
                            {
                                voiceEventOut[voice] <- std::notes::NoteOff (polyVoiceState[voice].channel,
                                                                             polyVoiceState[voice].pitch,
                                                                             0.0f);
                                polyVoiceState[voice].free (++nextInactiveTime);
                            }
                        }
                    }

                    return;
                }

                if (! sustainActive)
                {
                    clearReleasedSustainedMonoNotesForChannel (control.channel);
                    applyMonoSelectionAfterNoteOff (0.0f);
                }

                return;
            }

            if (! isMonoMode())
            {
                for (wrap<voiceCount> voice)
                    if (polyVoiceState[voice].channel == control.channel)
                        voiceEventOut[voice] <- control;

                return;
            }

            if (monoVoiceActive && monoVoiceChannel == control.channel)
                voiceEventOut[0] <- control;
        }

        void main()
        {
            clearMonoHeldNotes();
            for (int32 index = 0; index < 16 * 128; ++index)
                pendingNoteMetaValid.at (index) = false;
            playModeState = readPlayModeInput();
            lastObservedPlayMode = playModeState;

            loop
            {
                let playMode = readPlayModeInput();
                playModeState = playMode;

                if (playMode != lastObservedPlayMode)
                {
                    resetDispatcherState();
                    lastObservedPlayMode = playMode;
                }

                advance();
            }
        }
    }

    processor DesiredTableMonitor
    {
        input value float32 tableSelectIn;
        output event DesiredTableChange desiredTableChangeOut;

        int32 lastTableIndex = -1;

        void emitDesiredTableChange (int32 tableIndex)
        {
            DesiredTableChange change;
            change.tableIndex = tableIndex;
            desiredTableChangeOut <- change;
        }

        void main()
        {
            loop
            {
                let nextTableIndex = int32 (
                    std::intrinsics::floor (
                        std::intrinsics::clamp (tableSelectIn, 0.0f, 255.0f) + 0.5f
                    )
                );

                if (nextTableIndex != lastTableIndex)
                {
                    lastTableIndex = nextTableIndex;
                    emitDesiredTableChange (nextTableIndex);
                }

                advance();
            }
        }
    }

    // The host transport's tempo, converted to the plain BPM value the rack's sync-capable
    // modules take. The Cmajor patch host recognises a tempo endpoint by its
    // std::timeline struct type, not by its name, so declaring one is all it takes for a
    // DAW to drive it - which is what makes the Phaser's and the Delay's Sync modes tell
    // the truth instead of running against a hard-coded number.
    //
    // The event only fires when the host's tempo CHANGES, and standalone it never fires
    // at all, so the last known tempo is held and re-published every frame rather than
    // emitted once: an output value that had never been written would arrive at the rack
    // as 0 BPM and silently override wt::DelayBus's and wt::PhaserBus's own declared
    // defaults. delayTempoInitBpm is that declared default, borrowed rather than
    // duplicated.
    processor TempoMonitor
    {
        input event std::timeline::Tempo tempoIn;
        output value float32 bpmOut;

        float32 currentBpm = delayTempoInitBpm;

        event tempoIn (std::timeline::Tempo tempo)
        {
            currentBpm = tempo.bpm;
        }

        void main()
        {
            loop
            {
                bpmOut <- currentBpm;
                advance();
            }
        }
    }

    // Turns wt::EffectsRack's per-frame diagnostic values into one event emitted only
    // when the rack's committed structure actually moves - the same shape as
    // DesiredTableMonitor above, and the same shape as every other effective-state
    // monitor this instrument exposes.
    //
    // IT HAS TO BE AN EVENT, NOT HOISTED VALUE OUTPUTS. A `value` output is sampled once
    // per rendered BLOCK, so a golden captured at blockSize 64 has a different number of
    // entries from the same render at blockSize 1 or 257 - which would break every
    // existing fixture that asserts block-size invariance (tests/cmajor_warp renders
    // identity_sine at 1, 64 and 257). An event carries an absolute frame offset and is
    // emitted only on change, so it says the same thing at every block size.
    processor RackStateMonitor
    {
        input event int32 syncIn;
        input value int32 committedStructureGenerationIn;
        input value int32 committedOrderCodeIn;
        input value int32 committedEnableMaskIn;
        input value int32 rejectedOrderCountIn;
        input value int32 rejectedEnableCountIn;

        output event EffectiveRackState effectiveRackStateOut;

        // -1 is unreachable for every field - generations and counts only ever rise from
        // zero, and both packed codes are non-negative - so the first frame always emits.
        int32 lastStructureGeneration = -1;
        int32 lastOrderCode = -1;
        int32 lastEnableMask = -1;
        int32 lastRejectedOrderCount = -1;
        int32 lastRejectedEnableCount = -1;

        event syncIn (int32 unused)
        {
            lastStructureGeneration = -1;
            lastOrderCode = -1;
            lastEnableMask = -1;
            lastRejectedOrderCount = -1;
            lastRejectedEnableCount = -1;
        }

        void main()
        {
            loop
            {
                if (committedStructureGenerationIn != lastStructureGeneration
                     || committedOrderCodeIn != lastOrderCode
                     || committedEnableMaskIn != lastEnableMask
                     || rejectedOrderCountIn != lastRejectedOrderCount
                     || rejectedEnableCountIn != lastRejectedEnableCount)
                {
                    lastStructureGeneration = committedStructureGenerationIn;
                    lastOrderCode = committedOrderCodeIn;
                    lastEnableMask = committedEnableMaskIn;
                    lastRejectedOrderCount = rejectedOrderCountIn;
                    lastRejectedEnableCount = rejectedEnableCountIn;

                    EffectiveRackState state;
                    state.committedStructureGeneration = lastStructureGeneration;
                    state.committedOrderCode = lastOrderCode;
                    state.committedEnableMask = lastEnableMask;
                    state.rejectedOrderCount = lastRejectedOrderCount;
                    state.rejectedEnableCount = lastRejectedEnableCount;
                    effectiveRackStateOut <- state;
                }

                advance();
            }
        }
    }

    processor RuntimeStateCoordinator
    {
        input event DesiredTableChange desiredTableChangeIn;
        input event int32 runtimeSyncRequestIn;
        input event int32 retryDesiredTableRequestIn;
        input event WorkerLoadFailure workerLoadFailureIn;
        input event RuntimeServiceState runtimeServiceStateIn;
        output event RuntimeState runtimeStateOut;

        int32 dspSessionId = 0;
        int32 desiredIntentSerial = 0;
        int32 desiredTableIndex = 0;
        int32 generationFrontier = 0;
        int32 serviceState = 0;
        int32 hasActive = 0;
        int32 activeTableIndex = 0;
        int32 activeGeneration = 0;
        int32 hasLoading = 0;
        int32 loadingTableIndex = 0;
        int32 loadingGeneration = 0;
        int32 hasFailure = 0;
        int32 failedTableIndex = 0;
        int32 failedGeneration = 0;
        int32 failureScope = 0;
        int32 failurePhase = 0;
        int32 failureReasonCode = 0;

        void clearFailure()
        {
            hasFailure = 0;
            failedTableIndex = 0;
            failedGeneration = 0;
            failureScope = 0;
            failurePhase = 0;
            failureReasonCode = 0;
        }

        void emitRuntimeState()
        {
            RuntimeState state;
            state.dspSessionId = dspSessionId;
            state.desiredIntentSerial = desiredIntentSerial;
            state.desiredTableIndex = desiredTableIndex;
            state.generationFrontier = generationFrontier;
            state.serviceState = serviceState;
            state.hasActive = hasActive;
            state.activeTableIndex = activeTableIndex;
            state.activeGeneration = activeGeneration;
            state.hasLoading = hasLoading;
            state.loadingTableIndex = loadingTableIndex;
            state.loadingGeneration = loadingGeneration;
            state.hasFailure = hasFailure;
            state.failedTableIndex = failedTableIndex;
            state.failedGeneration = failedGeneration;
            state.failureScope = failureScope;
            state.failurePhase = failurePhase;
            state.failureReasonCode = failureReasonCode;
            runtimeStateOut <- state;
        }

        event desiredTableChangeIn (DesiredTableChange change)
        {
            if (change.tableIndex == desiredTableIndex)
                return;

            desiredTableIndex = change.tableIndex;
            desiredIntentSerial += 1;
            clearFailure();
            emitRuntimeState();
        }

        event runtimeSyncRequestIn (int32 unused)
        {
            emitRuntimeState();
        }

        event retryDesiredTableRequestIn (int32 unused)
        {
            if (hasFailure == 0 || failedTableIndex != desiredTableIndex)
                return;

            desiredIntentSerial += 1;
            clearFailure();
            emitRuntimeState();
        }

        event workerLoadFailureIn (WorkerLoadFailure failure)
        {
            if (failure.dspSessionId != dspSessionId)
                return;

            if (failure.generation == 0)
            {
                if (failure.candidateAttemptSerial != desiredIntentSerial)
                    return;

                hasFailure = 1;
                failedTableIndex = failure.tableIndex;
                failedGeneration = 0;
                failureScope = 0;
                failurePhase = failure.failurePhase;
                failureReasonCode = failure.failureReasonCode;
                emitRuntimeState();
                return;
            }

            if (hasLoading != 0)
            {
                if (failure.generation != loadingGeneration || failure.tableIndex != loadingTableIndex)
                    return;
            }
            else if (hasActive != 0)
            {
                if (failure.generation != activeGeneration || failure.tableIndex != activeTableIndex)
                    return;
            }
            else
            {
                return;
            }

            hasFailure = 1;
            failedTableIndex = failure.tableIndex;
            failedGeneration = failure.generation;
            failureScope = 1;
            failurePhase = failure.failurePhase;
            failureReasonCode = failure.failureReasonCode;
            emitRuntimeState();
        }

        event runtimeServiceStateIn (RuntimeServiceState state)
        {
            dspSessionId = state.dspSessionId;
            generationFrontier = state.generationFrontier;
            serviceState = state.serviceState;
            hasActive = state.hasActive;
            activeTableIndex = state.activeTableIndex;
            activeGeneration = state.activeGeneration;
            hasLoading = state.hasLoading;
            loadingTableIndex = state.loadingTableIndex;
            loadingGeneration = state.loadingGeneration;
            emitRuntimeState();
        }

        void main()
        {
            loop
            {
                advance();
            }
        }
    }

    graph Voice
    {
        input event (std::notes::NoteOn,
                     std::notes::NoteOff,
                     std::notes::PitchBend,
                     std::notes::Slide,
                     std::notes::Pressure,
                     std::notes::Control) eventIn;
        input event wt::WavetableLoadBegin wavetableLoadBeginIn;
        input event wt::WavetableMipFrame wavetableMipFrameIn;
        input event wt::ServiceLoadAbort serviceLoadAbortIn;
        input event wt::MsegBufferUpload msegBufferIn;
        input event wt::MsegPlaybackConfig msegPlaybackIn;
        input value float32 framePositionIn;
        input value float32 msegDepthIn;
        output event wt::WavetableUploadAck wavetableUploadAckOut;
        output event wt::WavetableMipRequest wavetableMipRequestOut;
        output event wt::RuntimeServiceState runtimeServiceStateOut;
        output event wt::EffectiveWavetablePositionMonitor effectiveWavetablePositionOut;
        output stream float32<2> out;

        node osc         = wt::FixedFrameOscillator (440.0f, 0.0f);
        node envelope    = std::envelopes::FixedASR (0.01f, 0.20f);
        node voiceGain   = std::levels::DynamicGain (float32);
        node trim        = std::levels::ConstantGain (float32, 0.18f);
        node stereo      = std::mixers::MonoToStereo (float32);
        node msegReader  = wt::MsegReader;
        node frameRouter = wt::FramePositionModulator;
        node frameMonitor = wt::EffectiveWavetablePositionReporter;
        node noteTracker = wt::NoteGenerationTracker;
        node frameBase   = wt::ValueToStream;

        event eventIn (std::notes::NoteOn note)
        {
            osc.frequencyIn <- std::notes::noteToFrequency (note.pitch);
            envelope.eventIn <- note;
            msegReader.triggerIn <- 1;
            noteTracker.noteOnIn <- 1;
        }

        event eventIn (std::notes::NoteOff note)
        {
            envelope.eventIn <- note;
            msegReader.noteOffIn <- 1;
            noteTracker.noteOffIn <- 1;
        }

        event eventIn (std::notes::PitchBend bend) {}
        event eventIn (std::notes::Slide slide) {}
        event eventIn (std::notes::Pressure pressure) {}
        event eventIn (std::notes::Control control) {}
        event wavetableLoadBeginIn (wt::WavetableLoadBegin load) { osc.wavetableLoadBeginIn <- load; }
        event wavetableMipFrameIn (wt::WavetableMipFrame frame) { osc.wavetableMipFrameIn <- frame; }
        event serviceLoadAbortIn (wt::ServiceLoadAbort abort) { osc.serviceLoadAbortIn <- abort; }
        event msegBufferIn (wt::MsegBufferUpload buffer) { msegReader.bufferUpload <- buffer; }
        event msegPlaybackIn (wt::MsegPlaybackConfig config) { msegReader.playbackUpload <- config; }

        connection
        {
            framePositionIn -> frameBase.valueIn;
            frameBase.out -> frameRouter.basePositionIn;
            frameBase.out -> frameMonitor.basePositionIn;
            osc.wavetableUploadAckOut -> wavetableUploadAckOut;
            osc.wavetableMipRequestOut -> wavetableMipRequestOut;
            osc.runtimeServiceStateOut -> runtimeServiceStateOut;
            msegReader.outA -> frameRouter.modulationIn;
            msegDepthIn -> frameRouter.depthIn;
            frameRouter.out -> frameMonitor.effectivePositionIn;
            noteTracker.activeOut -> frameMonitor.voiceActiveIn;
            noteTracker.generationOut -> frameMonitor.voiceGenerationIn;
            frameMonitor.out -> osc.framePositionIn;
            frameMonitor.monitorOut -> effectiveWavetablePositionOut;
            osc.out -> voiceGain.in;
            envelope.gainOut -> voiceGain.gain;
            voiceGain.out -> trim.in;
            trim.out -> stereo.in;
            stereo.out -> out;
        }
    }

    processor StereoTrim (float32 gain)
    {
        input stream float32<2> in;
        output stream float32<2> out;

        void main()
        {
            loop
            {
                out <- in * gain;
                advance();
            }
        }
    }

    processor StereoToMonoAverage
    {
        input stream float32<2> in;
        output stream float32 out;

        void main()
        {
            loop
            {
                out <- (in[0] + in[1]) * 0.5f;
                advance();
            }
        }
    }
}

graph WavetableSynth [[ main ]]
{
    input event std::midi::Message midiIn;
    input event wt::WavetableLoadBegin wavetableLoadBegin;
    input event wt::WavetableMipFrame wavetableMipFrame;
    input event wt::ServiceLoadAbort serviceLoadAbort;
    input event wt::WorkerLoadFailure workerLoadFailure;
    input event int32 wavetablePrewarmRequest;
    input event int32 runtimeSyncRequest;
    input event int32 retryDesiredTableRequest;
    input event wt::ModulationMsegBufferUpload modulationMsegBuffer;
    input event wt::ModulationMsegPlaybackUpload modulationMsegPlayback;
    input event wt::ModulationEnvelopeUpload modulationEnvelope;
    input event wt::ModulationProgramUpload modulationProgram;
    input event wt::ModulationAmountUpload modulationAmount;
    input event wt::ArticulationNoteMeta articulationNoteMeta;
    input event wt::ArticulatedNoteOn articulatedNoteOn;
    input event wt::ArticulationSnapshotUpload articulationSnapshot;
    // Keep a hidden no-op parameter in host slot 0. Ableton plus the Cmajor
    // JUCE wrapper can treat parameter slot 0 specially, so visible synth
    // parameters must start at slot 1.
    input value float32 hostSlot0Guard [[ name: "Host Slot 0 Guard", min: 0.0f, max: 1.0f, init: 0.0f, discrete: true, step: 1.0f, hidden: true, automatable: false, rampFrames: 0 ]];
    input value float32 wavetablePosition [[ name: "Wavetable Position", min: 0.0f, max: 1.0f, init: 0.0f, rampFrames: 64 ]];
    // Catalog index 34 is the stable `pwm-medicinehat` factory table.
    input value float32 wavetableSelect [[ name: "Wavetable Select", min: 0.0f, max: 255.0f, init: 34.0f, discrete: true, step: 1.0f, rampFrames: 0 ]];
    input value float32 playMode [[ name: "Play Mode", min: 0.0f, max: 2.0f, init: 0.0f, discrete: true, step: 1.0f, rampFrames: 0 ]];
    input value float32 glideTime [[ name: "Glide Time", min: 0.0f, max: 2.0f, init: 0.0f, unit: "s", rampFrames: 0 ]];
    input value float32 pan [[ name: "Pan", min: -1.0f, max: 1.0f, init: 0.0f, rampFrames: 64 ]];
    input value float32 macro1 [[ name: "Macro 1", min: 0.0f, max: 1.0f, init: 0.0f, rampFrames: 64 ]];
    input value float32 macro2 [[ name: "Macro 2", min: 0.0f, max: 1.0f, init: 0.0f, rampFrames: 64 ]];
    input value float32 macro3 [[ name: "Macro 3", min: 0.0f, max: 1.0f, init: 0.0f, rampFrames: 64 ]];
    input value float32 macro4 [[ name: "Macro 4", min: 0.0f, max: 1.0f, init: 0.0f, rampFrames: 64 ]];
    input value float32 warpMode [[ name: "Warp Mode", min: 0.0f, max: 4.0f, init: 0.0f, discrete: true, step: 1.0f, rampFrames: 0 ]];
    input value float32 warpAmount [[ name: "Warp Amount", min: 0.0f, max: 1.0f, init: 0.0f, rampFrames: 64 ]];
    input value float32 filterMode [[ name: "Filter Mode", min: 0.0f, max: 5.0f, init: 1.0f, discrete: true, step: 1.0f, rampFrames: 0 ]];
    input value float32 filterCutoff [[ name: "Filter Cutoff", min: 20.0f, max: 20000.0f, init: 1000.0f, unit: "Hz", rampFrames: 64 ]];
    input value float32 filterQ [[ name: "Filter Q", min: 0.1f, max: 20.0f, init: 0.707107f, rampFrames: 64 ]];
    input value float32 unisonVoices [[ name: "Unison", min: 1.0f, max: 8.0f, init: 1.0f, discrete: true, step: 1.0f, rampFrames: 0 ]];
    input value float32 unisonDetune [[ name: "Unison Detune", min: 0.0f, max: 1.0f, init: 0.10f, rampFrames: 64 ]];
    input value float32 unisonBlend [[ name: "Unison Blend", min: 0.0f, max: 1.0f, init: 0.75f, rampFrames: 64 ]];
    input value float32 unisonWidth [[ name: "Unison Width", min: 0.0f, max: 1.0f, init: 1.0f, rampFrames: 64 ]];
    input value float32 unisonPhase [[ name: "Unison Phase", min: 0.0f, max: 1.0f, init: 0.0f, rampFrames: 0 ]];
    input value float32 unisonRandom [[ name: "Unison Random", min: 0.0f, max: 1.0f, init: 0.0f, rampFrames: 0 ]];
    input value float32 unisonPhaseMode [[ name: "Unison Phase Mode", min: 0.0f, max: 1.0f, init: 0.0f, discrete: true, step: 1.0f, text: "Contiguous|Reset", rampFrames: 0 ]];
    input value float32 unisonDetuneMode [[ name: "Unison Detune Mode", min: 0.0f, max: 4.0f, init: 0.0f, discrete: true, step: 1.0f, text: "Linear|Super|Exp|Inv|Random", rampFrames: 0 ]];
    input value float32 unisonStackMode [[ name: "Unison Stack", min: 0.0f, max: 4.0f, init: 0.0f, discrete: true, step: 1.0f, text: "Off|12|12+7|Center-12|Center-24", rampFrames: 0 ]];
    input value float32 unisonWavetablePositionSpread [[ name: "Unison WT Pos", min: 0.0f, max: 1.0f, init: 0.0f, rampFrames: 64 ]];
    input value float32 unisonWarpSpread [[ name: "Unison Warp", min: 0.0f, max: 1.0f, init: 0.0f, rampFrames: 64 ]];
    input value float32 mseg1Morph [[ name: "MSEG 1 Morph", min: 0.0f, max: 1.0f, init: 0.0f, rampFrames: 0 ]];
    input value float32 mseg2Morph [[ name: "MSEG 2 Morph", min: 0.0f, max: 1.0f, init: 0.0f, rampFrames: 0 ]];
    input value float32 mseg3Morph [[ name: "MSEG 3 Morph", min: 0.0f, max: 1.0f, init: 0.0f, rampFrames: 0 ]];
    // THE EFFECTS RACK OWNS EVERY EFFECT PARAMETER FROM HERE DOWN, and each one is
    // hoisted from wt::EffectsRack rather than declared here, so a parameter's
    // annotation lives in exactly one place - beside the DSP that reads it.
    //
    // THIS BLOCK IS THE HOST PARAMETER CONTRACT. Endpoints are emitted in DECLARATION
    // ORDER, so a parameter's position in this list IS its host automation slot: every
    // saved DAW automation lane and every stored preset index depends on nothing above
    // it moving. Hence three rules. Hoist endpoints ONE BY ONE, never with a
    // `input rack.distortion*;` wildcard - a wildcard silently re-numbers every slot
    // below it the day someone adds an endpoint to the rack. Never reorder. Only append.
    input rack.distortionMode;
    input rack.distortionDriveDb;
    input rack.distortionKnee;
    input rack.distortionWet;
    input rack.distortionWetHPHz;
    input rack.distortionWetLPHz;
    input rack.chorusMix;
    input rack.chorusMotionMode;
    input rack.chorusBloomMode;
    input rack.chorusTone;
    input rack.chorusFeedback;
    input rack.chorusRingAmount;
    input rack.chorusRingOffsetMode;
    input rack.chorusRingFineSemitones;
    input rack.ottMix;
    input rack.ottAmount;
    input rack.ottTimePercent;
    input rack.ottBandDrive;
    input rack.ottEnvelopeMatch;
    // Appended below this line: the five rack modules that had no host surface before,
    // in rack module id order. Everything above keeps the slot it has always had.
    input rack.globalFilterMode;
    input rack.globalFilterCutoff;
    input rack.globalFilterResonance;
    input rack.globalFilterDrive;
    input rack.flangerRate;
    input rack.flangerDepth;
    input rack.flangerFeedback;
    input rack.flangerMix;
    input rack.phaserRate;
    input rack.phaserRateMode;
    input rack.phaserRateDivision;
    input rack.phaserDepth;
    input rack.phaserFrequency;
    input rack.phaserFeedback;
    input rack.phaserPhase;
    input rack.phaserMix;
    input rack.delayTime;
    input rack.delayTimeMode;
    input rack.delayDivision;
    input rack.delayFeedback;
    input rack.delayFilter;
    input rack.delayMix;
    input rack.reverbSize;
    input rack.reverbDecay;
    input rack.reverbDamping;
    input rack.reverbMix;
    // Rack structure is patch state, not host automation (ADR-007). These are struct
    // events, which carry no parameter purpose, so they are structurally
    // non-automatable rather than non-automatable by convention.
    input rack.rackOrder;
    input rack.rackEnable;
    // Host transport, not a user parameter: no `name:`, so it never becomes an
    // automation slot. See wt::TempoMonitor.
    input event std::timeline::Tempo tempo;
    output event wt::WavetableUploadAck wavetableUploadAck;
    output event wt::WavetableMipRequest wavetableMipRequest;
    output event int32 wavetablePrewarmNotification;
    output event wt::RuntimeState runtimeState;
    output event wt::EffectiveWavetablePositionMonitor effectiveWavetablePosition;
    output event wt::EffectiveWarpStateMonitor effectiveWarpState;
    output event wt::EffectiveUnisonStateMonitor effectiveUnisonState;
    output event wt::EffectiveFilterStateMonitor effectiveFilterState;
    output event wt::EffectiveMsegStateMonitor effectiveMsegState;
    output event wt::VoiceArticulationMonitor voiceArticulationStart;
    output stream float32<2> audioOut;
    output filterSpectrumAnalyzer.filterSpectrum;
    output distortionScopeAnalyzer.distortionScope;
    output distortionHistoryAnalyzer.distortionHistory;
    // Rack state readback, joining the instrument's other effective-state monitors. A
    // composed processor cannot write to `console`, so the rack reports through
    // endpoints - which is the better design anyway: the UI reads back what the DSP is
    // actually running instead of assuming its upload landed. Declared last, out of
    // group, so that the emitted endpoint list stays a pure append.
    output event wt::EffectiveRackState effectiveRackState;
    // Test/diagnostic readback for the compiled modulation-program protocol. A rejected
    // install leaves the previous program active, so acceptance observes a rejection event.
    output event int32 modulationRejectedRouteCount;
    // Worker-only restore receipt. Signed session-scoped frontiers let the two
    // restore lanes prove delivery without filling the native event FIFO.
    output event wt::RuntimeInstallAck runtimeInstallAck;

    let voiceCount = 16;

    node mpe   = std::midi::MPEConverter;
    node noteDispatcher = wt::NoteDispatcher (voiceCount);
    node sharedEngine = wt::SharedVoiceEngine (voiceCount);
    node trim = wt::StereoTrim (0.18f);
    // The eight reorderable effects, and then the one stage the user cannot reorder,
    // disable or bypass. Output limiting used to be a POSITIONAL property of the fixed
    // chain - wt::ChorusBus was terminal and soft-limited every sample - and once effect
    // order is a runtime choice that guarantee evaporates in seven orders out of eight.
    // ADR-006: "A final safety limiter, if present, remains fixed after the creative rack
    // and is not a reorderable module."
    node rack = wt::EffectsRack;
    node outputStage = wt::RackOutputStage;
    node rackStateMonitor = wt::RackStateMonitor;
    node tempoMonitor = wt::TempoMonitor;
    node analyzerDownmix = wt::StereoToMonoAverage;
    node filterSpectrumAnalyzer = wt::FilterSpectrumAnalyzer;
    node distortionScopeAnalyzer = wt::DistortionScopeAnalyzer;
    node distortionHistoryAnalyzer = wt::DistortionHistoryAnalyzer;
    node desiredTableMonitor = wt::DesiredTableMonitor;
    node runtimeStateCoordinator = wt::RuntimeStateCoordinator;

    connection
    {
        midiIn -> mpe.parseMIDI;
        mpe.eventOut -> noteDispatcher.eventIn;
        articulationNoteMeta -> noteDispatcher.noteMetaIn;
        articulatedNoteOn -> noteDispatcher.articulatedNoteOnIn;
        playMode -> noteDispatcher.playModeIn;
        noteDispatcher.voiceEventOut -> sharedEngine.voiceEventIn;
        noteDispatcher.voiceRetuneOut -> sharedEngine.voiceRetuneIn;
        wavetableLoadBegin -> sharedEngine.wavetableLoadBeginIn;
        wavetableMipFrame -> sharedEngine.wavetableMipFrameIn;
        serviceLoadAbort -> sharedEngine.serviceLoadAbortIn;
        articulationSnapshot -> sharedEngine.articulationSnapshotIn;
        modulationMsegBuffer -> sharedEngine.modulationMsegBufferIn;
        modulationMsegPlayback -> sharedEngine.modulationMsegPlaybackIn;
        modulationEnvelope -> sharedEngine.modulationEnvelopeIn;
        modulationProgram -> sharedEngine.modulationProgramIn;
        modulationAmount -> sharedEngine.modulationAmountIn;
        wavetablePosition -> sharedEngine.framePositionIn;
        wavetableSelect -> desiredTableMonitor.tableSelectIn;
        glideTime -> sharedEngine.glideTimeIn;
        pan -> sharedEngine.panIn;
        macro1 -> sharedEngine.macro1In;
        macro2 -> sharedEngine.macro2In;
        macro3 -> sharedEngine.macro3In;
        macro4 -> sharedEngine.macro4In;
        warpMode -> sharedEngine.warpModeIn;
        warpAmount -> sharedEngine.warpAmountIn;
        filterMode -> sharedEngine.filterModeIn;
        filterCutoff -> sharedEngine.filterCutoffIn;
        filterQ -> sharedEngine.filterQIn;
        unisonVoices -> sharedEngine.unisonVoicesIn;
        unisonDetune -> sharedEngine.unisonDetuneIn;
        unisonBlend -> sharedEngine.unisonBlendIn;
        unisonWidth -> sharedEngine.unisonWidthIn;
        unisonPhase -> sharedEngine.unisonPhaseIn;
        unisonRandom -> sharedEngine.unisonRandomIn;
        unisonPhaseMode -> sharedEngine.unisonPhaseModeIn;
        unisonDetuneMode -> sharedEngine.unisonDetuneModeIn;
        unisonStackMode -> sharedEngine.unisonStackModeIn;
        unisonWavetablePositionSpread -> sharedEngine.unisonWavetablePositionSpreadIn;
        unisonWarpSpread -> sharedEngine.unisonWarpSpreadIn;
        mseg1Morph -> sharedEngine.mseg1MorphIn;
        mseg2Morph -> sharedEngine.mseg2MorphIn;
        mseg3Morph -> sharedEngine.mseg3MorphIn;
        sharedEngine.wavetableUploadAckOut -> wavetableUploadAck;
        sharedEngine.wavetableMipRequestOut -> wavetableMipRequest;
        sharedEngine.runtimeServiceStateOut -> runtimeStateCoordinator.runtimeServiceStateIn;
        desiredTableMonitor.desiredTableChangeOut -> runtimeStateCoordinator.desiredTableChangeIn;
        workerLoadFailure -> runtimeStateCoordinator.workerLoadFailureIn;
        wavetablePrewarmRequest -> wavetablePrewarmNotification;
        runtimeSyncRequest -> runtimeStateCoordinator.runtimeSyncRequestIn,
                              sharedEngine.runtimeInstallSyncIn,
                              rackStateMonitor.syncIn;
        retryDesiredTableRequest -> runtimeStateCoordinator.retryDesiredTableRequestIn;
        runtimeStateCoordinator.runtimeStateOut -> runtimeState;
        sharedEngine.effectiveWavetablePositionOut -> effectiveWavetablePosition;
        sharedEngine.effectiveWarpStateOut -> effectiveWarpState;
        sharedEngine.effectiveUnisonStateOut -> effectiveUnisonState;
        sharedEngine.effectiveFilterStateOut -> effectiveFilterState;
        sharedEngine.effectiveMsegStateOut -> effectiveMsegState;
        sharedEngine.voiceArticulationStartOut -> voiceArticulationStart;
        sharedEngine.out -> trim.in;
        trim.out -> analyzerDownmix.in, rack.in;
        analyzerDownmix.out -> filterSpectrumAnalyzer.in;
        sharedEngine.trackingPitchHzOut -> rack.trackingPitchHzIn;
        tempo -> tempoMonitor.tempoIn;
        tempoMonitor.bpmOut -> rack.tempoBpmIn;
        sharedEngine.rackModOut -> rack.rackModIn;
        // wt::DistortionBus now lives inside the rack, so the two analyzers read the
        // preview taps the rack forwards on its behalf. A composed child's STREAM
        // outputs stay reachable by its parent; its event outputs would not, which is
        // why these four are streams.
        rack.previewInputLeft -> distortionScopeAnalyzer.previewInputLeft;
        rack.previewInputRight -> distortionScopeAnalyzer.previewInputRight;
        rack.previewOutputLeft -> distortionScopeAnalyzer.previewOutputLeft;
        rack.previewOutputRight -> distortionScopeAnalyzer.previewOutputRight;
        rack.previewInputLeft -> distortionHistoryAnalyzer.previewInputLeft;
        rack.previewInputRight -> distortionHistoryAnalyzer.previewInputRight;
        rack.previewOutputLeft -> distortionHistoryAnalyzer.previewOutputLeft;
        rack.previewOutputRight -> distortionHistoryAnalyzer.previewOutputRight;
        rack.out -> outputStage.in;
        outputStage.out -> audioOut;
        rack.rackCommittedStructureGeneration -> rackStateMonitor.committedStructureGenerationIn;
        rack.rackCommittedOrderCode -> rackStateMonitor.committedOrderCodeIn;
        rack.rackCommittedEnableMask -> rackStateMonitor.committedEnableMaskIn;
        rack.rackRejectedOrderCount -> rackStateMonitor.rejectedOrderCountIn;
        rack.rackRejectedEnableCount -> rackStateMonitor.rejectedEnableCountIn;
        rackStateMonitor.effectiveRackStateOut -> effectiveRackState;
        sharedEngine.modulationRejectedRouteCountOut -> modulationRejectedRouteCount;
        sharedEngine.runtimeInstallAckOut -> runtimeInstallAck;
    }
}
