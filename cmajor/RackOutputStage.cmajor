namespace wt
{
    //==============================================================================
    // The fixed output stage - the last thing in the signal path, and the one thing in
    // it that the user cannot reorder, disable or bypass.
    //
    // WHY IT EXISTS. Until the rack landed, wt::ChorusBus was the terminal node into
    // audioOut and applied chorusOutputLimit to every sample unconditionally, outside
    // its own enabled/mix gate (Chorus.cmajor:571-574). That made output limiting a
    // POSITIONAL property of a fixed chain. Once effect order is a runtime choice,
    // Chorus is last in one order out of eight and is skipped entirely whenever it is
    // disabled - so in almost every rack configuration the instrument would have no
    // output limiting at all, at the same moment the rack gains four modules with
    // +/-0.95 feedback, 36 dB of distortion drive and OTT upward compression in series.
    // ADR-006 contemplates exactly this: "A final safety limiter, if present, remains
    // fixed after the creative rack and is not a reorderable module."
    //
    // THE BUDGET, stated as a number rather than implied:
    //     |audioOut| <= rackOutputHardCeiling (1.15, +1.21 dBFS) for ANY rack order,
    //     ANY enable mask and ANY parameter values, and the stage is BIT-EXACT for
    //     |x| <= rackOutputTransparentCeiling (1.0, 0 dBFS).
    // Below full scale nothing is touched, so no patch that was not already clipping
    // sounds any different than it did before the rack existed - every audio fixture in
    // tests/cmajor_warp, tests/cmajor_filter and tests/cmajor_macro peaks at or below
    // 0.21, so this stage is a bit-exact no-op on all of them. Above full scale the
    // signal was going to clip in the host anyway, and a monotone soft knee is strictly
    // better than the hard one it would have got.
    // The bound is <=, not <: tanh saturates to exactly 1.0f in float32 for a large
    // enough argument, so the ceiling is reached rather than merely approached. Reached
    // and never exceeded is the honest contract, and it is the one asserted.
    //
    // WHY NOT A REAL LOOKAHEAD LIMITER. Lookahead is latency, and ADR-008 requires the
    // instrument to declare zero. A memoryless curve has no attack, no release, no
    // pumping and no lookahead, and it cannot be wrong about how much latency it adds
    // because it adds none. The cost is that it is a waveshaper, not a level rider -
    // which is the right trade for a safety net that should almost never engage.
    //
    // chorusOutputLimit IS DELIBERATELY LEFT INSIDE ChorusBus. It is not a rack output
    // limiter and never was: it is the chorus regeneration loop's own safety valve, and
    // at feedback 0.92 it is part of what that module SOUNDS like. Removing it to avoid
    // limiting twice would change the shipping chorus timbre, which is exactly what
    // moving the effect into the rack must not do. Applying both is harmless rather than
    // merely tolerable: each is monotone, continuous and memoryless, so their
    // composition is monotone, continuous and memoryless too, and the outer bound is set
    // here regardless of what the inner one did. The two also never fight over the same
    // decision, because this stage's own output can never reach 1.15 + epsilon, which is
    // where chorusOutputLimit begins to act. The honest summary: when Chorus happens to
    // sit last AND is loud enough to engage its own limiter, that sample is shaped
    // twice - slightly more compressively, in the direction of safety, at a level that
    // was already over full scale.

    // Identity at or below this. 0 dBFS: everything a well-behaved patch produces.
    let rackOutputTransparentCeiling = 1.0f;

    // The hard bound. +1.21 dBFS, and numerically the knee point chorusOutputLimit
    // already uses (Chorus.cmajor:55-59), so the two stages agree by construction.
    let rackOutputHardCeiling = 1.15f;

    let rackOutputChannelCount = 2;

    // A soft knee in the house idiom - Delay.cmajor:156 shapes its regeneration loop
    // with the same `ceiling * tanh (x / ceiling)` law - but anchored at the transparent
    // ceiling instead of at zero, so that everything below full scale passes through
    // BIT-EXACTLY. tanh'(0) == 1, so the curve leaves the identity with matching slope:
    // there is no corner at the knee for a transient to click on.
    float32 rackOutputLimit (float32 value)
    {
        let magnitude = std::intrinsics::abs (value);

        if (magnitude <= rackOutputTransparentCeiling)
            return value;

        let span = rackOutputHardCeiling - rackOutputTransparentCeiling;
        let excess = magnitude - rackOutputTransparentCeiling;
        let shaped = rackOutputTransparentCeiling + (span * std::intrinsics::tanh (excess / span));

        return value < 0.0f ? -shaped : shaped;
    }

    processor RackOutputStage
    {
        input stream float32<rackOutputChannelCount> in;
        output stream float32<rackOutputChannelCount> out;

        // NO processor.latency DECLARATION, and there must never be one: this stage is
        // memoryless (ADR-008). It is deliberately not pinned with a static_assert here,
        // because `processor.latency` is only a constant expression in a processor that
        // something INSTANTIATES - so an assertion here would break the build of any
        // program that merely includes this file. It is pinned instead in the latency
        // probe graph in tests/cmajor_rack/RackShape.cmajtest, which carries this stage.

        void main()
        {
            loop
            {
                let signal = in;
                out <- float32<rackOutputChannelCount> (rackOutputLimit (signal[0]),
                                                        rackOutputLimit (signal[1]));
                advance();
            }
        }
    }
}
