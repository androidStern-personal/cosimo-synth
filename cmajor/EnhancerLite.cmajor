namespace wt
{
    // Experimental one-band Enhancer for evaluating a voice-affordable signal
    // path. It deliberately remains separate from the accepted two-band
    // EnhancerBus. The measured Bell/Low/High selection laws, routing, and four
    // Spectre transfers are preserved; only the oversampling implementation and
    // tanh evaluation are approximated. There is no de-emphasis path.

    let enhancerLiteOversampleFactor = 4;
    let enhancerLiteFrequencyMinHz = 20.0f;
    let enhancerLiteFrequencyMaxHz = 20000.0f;
    let enhancerLiteFrequencyDefaultHz = 130.0f;
    let enhancerLiteQMin = 0.1f;
    let enhancerLiteQMax = 10.0f;
    let enhancerLiteQDefault = 0.71f;
    let enhancerLiteAmountMin = 0.0f;
    let enhancerLiteAmountMax = 1.0f;
    let enhancerLiteCurveTube = 0;
    let enhancerLiteCurveSolid = 1;
    let enhancerLiteCurveDefault = enhancerLiteCurveSolid;
    let enhancerLiteModeStereo = 0;
    let enhancerLiteModeMidSide = 1;
    let enhancerLiteSaturationModeSubtle = 0;
    let enhancerLiteSaturationModeMedium = 1;
    let enhancerLiteSaturationModeDefault = enhancerLiteSaturationModeSubtle;
    let enhancerLiteShapeLow = 0;
    let enhancerLiteShapeBell = 1;
    let enhancerLiteShapeHigh = 2;
    let enhancerLiteShapeDefault = enhancerLiteShapeBell;
    let enhancerLiteLatencySamples = 3;

    let enhancerLiteControlSmoothingMs = 15.0f;
    let enhancerLiteCoefficientUpdateFrames = 16;
    let enhancerLiteCoefficientEpsilon = 0.000001f;
    let enhancerLiteBandGainRangeDb = 12.0f;

    let enhancerLiteSubtleDrive = 3.0f;
    let enhancerLiteSubtleOutput = 0.7071067811865476f;
    let enhancerLiteSubtleTubeBias = 0.125f;
    let enhancerLiteMediumDrive = 6.0f;
    let enhancerLiteMediumOutput = 0.5f;
    let enhancerLiteMediumTubeBias = 0.3125f;

    let enhancerLiteHighpassCutoffHz = 20.01631809314913f;
    let enhancerLiteHighpassQ = 0.7071067811865475f;
    let enhancerLiteHighpassGain = 1.0023994109214078f;

    // JUCE's normal-quality 4x polyphase-IIR design uses two cascaded 2x
    // half-band stages. These are the direct-path coefficients followed by the
    // delayed-path coefficients, generated from JUCE's public elliptic design
    // method. The complete wrapper needs only sixteen allpass states per lane
    // and never shifts history, so a ring buffer would add work rather than
    // remove it.
    let enhancerLiteIirStage0Up = float32[] (
        0.0747229789332324f, 0.4880179630612405f, 0.8991664385623703f,
        0.2619463552554830f, 0.7023829512909278f
    );
    let enhancerLiteIirStage0Down = float32[] (
        0.0956943757722826f, 0.5956373717869378f,
        0.3269691984950376f, 0.8596268314186788f
    );
    let enhancerLiteIirStage1Up = float32[] (
        0.0707659489761845f, 0.5131675747487928f,
        0.2578530785134526f, 0.8173173544171368f
    );
    let enhancerLiteIirStage1Down = float32[] (
        0.0988618856841852f, 0.7437546430357680f,
        0.3603636828837870f
    );

    namespace enhancerLiteFilters = std::filters (float32, float64, 32);

    float32 clampEnhancerLiteFrequencyHz (float32 value, float32 sampleRateHz)
    {
        let safeMaximum = std::intrinsics::min (
            enhancerLiteFrequencyMaxHz,
            sampleRateHz * 0.49f
        );
        return std::intrinsics::clamp (
            value,
            enhancerLiteFrequencyMinHz,
            safeMaximum
        );
    }

    float32 clampEnhancerLiteQ (float32 value)
    {
        return std::intrinsics::clamp (value, enhancerLiteQMin, enhancerLiteQMax);
    }

    float32 clampEnhancerLiteAmount (float32 value)
    {
        return std::intrinsics::clamp (
            value,
            enhancerLiteAmountMin,
            enhancerLiteAmountMax
        );
    }

    float32 enhancerLiteAmountDrive (float32 amount)
    {
        let amount01 = clampEnhancerLiteAmount (amount);
        return std::levels::dBtoGain (enhancerLiteBandGainRangeDb * amount01) - 1.0f;
    }

    float32 enhancerLiteEffectiveBellQ (float32 q, float32 amount)
    {
        let amount01 = clampEnhancerLiteAmount (amount);
        return clampEnhancerLiteQ (q) * std::levels::dBtoGain (
            0.5f * enhancerLiteBandGainRangeDb * amount01
        );
    }

    float32 enhancerLiteShelfGainDb (float32 amount)
    {
        return enhancerLiteBandGainRangeDb * clampEnhancerLiteAmount (amount);
    }

    float32 smoothEnhancerLiteControl (
        float32 current,
        float32 target,
        float32 smoothingAmount,
        float32 snapEpsilon
    )
    {
        let next = current + (target - current) * smoothingAmount;
        return std::intrinsics::abs (target - next) <= snapEpsilon ? target : next;
    }

    float32 resolveEnhancerLiteWeight (float32 value)
    {
        return value >= 0.5f ? 1.0f : 0.0f;
    }

    float32 resolveEnhancerLiteLowShapeWeight (float32 value)
    {
        return value < 0.5f ? 1.0f : 0.0f;
    }

    float32 resolveEnhancerLiteBellShapeWeight (float32 value)
    {
        return value >= 0.5f && value < 1.5f ? 1.0f : 0.0f;
    }

    float32 resolveEnhancerLiteHighShapeWeight (float32 value)
    {
        return value >= 1.5f ? 1.0f : 0.0f;
    }

    float32 enhancerLiteFastTanh (float32 value)
    {
        // Odd rational tanh approximation. It has the exact origin and slope,
        // reaches +/-1 at +/-3, and is clamped outside that useful interval.
        // The measured maximum absolute transfer error is below 0.02353.
        let x = std::intrinsics::clamp (value, -3.0f, 3.0f);
        let x2 = x * x;
        return x * (27.0f + x2) / (27.0f + 9.0f * x2);
    }

    struct EnhancerLiteIirUpsampleStage0
    {
        float32<2>[5] state;
        float32<2>[2] samples;

        void reset()
        {
            this.state = ();
            this.samples = ();
        }

        void process (float32<2> sampleFrame)
        {
            var direct = sampleFrame;
            for (int32 stage = 0; stage < 3; ++stage)
            {
                let coefficient = enhancerLiteIirStage0Up.at (stage);
                let result = coefficient * direct + this.state.at (stage);
                this.state.at (stage) = direct - coefficient * result;
                direct = result;
            }

            var delayed = sampleFrame;
            for (int32 stage = 3; stage < 5; ++stage)
            {
                let coefficient = enhancerLiteIirStage0Up.at (stage);
                let result = coefficient * delayed + this.state.at (stage);
                this.state.at (stage) = delayed - coefficient * result;
                delayed = result;
            }

            this.samples[0] = direct;
            this.samples[1] = delayed;
        }
    }

    struct EnhancerLiteIirUpsampleStage1
    {
        float32<2>[4] state;
        float32<2>[2] samples;

        void reset()
        {
            this.state = ();
            this.samples = ();
        }

        void process (float32<2> sampleFrame)
        {
            var direct = sampleFrame;
            for (int32 stage = 0; stage < 2; ++stage)
            {
                let coefficient = enhancerLiteIirStage1Up.at (stage);
                let result = coefficient * direct + this.state.at (stage);
                this.state.at (stage) = direct - coefficient * result;
                direct = result;
            }

            var delayed = sampleFrame;
            for (int32 stage = 2; stage < 4; ++stage)
            {
                let coefficient = enhancerLiteIirStage1Up.at (stage);
                let result = coefficient * delayed + this.state.at (stage);
                this.state.at (stage) = delayed - coefficient * result;
                delayed = result;
            }

            this.samples[0] = direct;
            this.samples[1] = delayed;
        }
    }

    struct EnhancerLiteIirUpsampler4x
    {
        EnhancerLiteIirUpsampleStage0 stage0;
        EnhancerLiteIirUpsampleStage1 stage1;
        float32<2>[4] samples;

        void reset()
        {
            this.stage0.reset();
            this.stage1.reset();
            this.samples = ();
        }

        void process (float32<2> sampleFrame)
        {
            this.stage0.process (sampleFrame);
            this.stage1.process (this.stage0.samples[0]);
            this.samples[0] = this.stage1.samples[0];
            this.samples[1] = this.stage1.samples[1];
            this.stage1.process (this.stage0.samples[1]);
            this.samples[2] = this.stage1.samples[0];
            this.samples[3] = this.stage1.samples[1];
        }
    }

    struct EnhancerLiteIirDownsampleStage1
    {
        float32<2>[3] state;
        float32<2> delayedPath;

        void reset()
        {
            this.state = ();
            this.delayedPath = ();
        }

        float32<2> process (float32<2> evenInput, float32<2> oddInput)
        {
            var direct = evenInput;
            for (int32 stage = 0; stage < 2; ++stage)
            {
                let coefficient = enhancerLiteIirStage1Down.at (stage);
                let result = coefficient * direct + this.state.at (stage);
                this.state.at (stage) = direct - coefficient * result;
                direct = result;
            }

            var delayed = oddInput;
            let coefficient = enhancerLiteIirStage1Down[2];
            let delayedResult = coefficient * delayed + this.state[2];
            this.state[2] = delayed - coefficient * delayedResult;

            let downsampled = 0.5f * (this.delayedPath + direct);
            this.delayedPath = delayedResult;
            return downsampled;
        }
    }

    struct EnhancerLiteIirDownsampleStage0
    {
        float32<2>[4] state;
        float32<2> delayedPath;

        void reset()
        {
            this.state = ();
            this.delayedPath = ();
        }

        float32<2> process (float32<2> evenInput, float32<2> oddInput)
        {
            var direct = evenInput;
            for (int32 stage = 0; stage < 2; ++stage)
            {
                let coefficient = enhancerLiteIirStage0Down.at (stage);
                let result = coefficient * direct + this.state.at (stage);
                this.state.at (stage) = direct - coefficient * result;
                direct = result;
            }

            var delayed = oddInput;
            for (int32 stage = 2; stage < 4; ++stage)
            {
                let coefficient = enhancerLiteIirStage0Down.at (stage);
                let result = coefficient * delayed + this.state.at (stage);
                this.state.at (stage) = delayed - coefficient * result;
                delayed = result;
            }

            let downsampled = 0.5f * (this.delayedPath + direct);
            this.delayedPath = delayed;
            return downsampled;
        }
    }

    struct EnhancerLiteIirDownsampler4x
    {
        EnhancerLiteIirDownsampleStage1 stage1;
        EnhancerLiteIirDownsampleStage0 stage0;

        void reset()
        {
            this.stage1.reset();
            this.stage0.reset();
        }

        float32<2> process (
            float32<2> sample0,
            float32<2> sample1,
            float32<2> sample2,
            float32<2> sample3
        )
        {
            let half0 = this.stage1.process (sample0, sample1);
            let half1 = this.stage1.process (sample2, sample3);
            return this.stage0.process (half0, half1);
        }
    }

    struct EnhancerLiteShapedHighpass
    {
        float32<2> state1;
        float32<2> state2;
        float32 b0;
        float32 b1;
        float32 b2;
        float32 a1;
        float32 a2;

        void setSampleRate (float64 sampleRate)
        {
            let omega = twoPi * float64 (enhancerLiteHighpassCutoffHz) / sampleRate;
            let cosine = std::intrinsics::cos (omega);
            let alpha = std::intrinsics::sin (omega)
                        / (2.0 * float64 (enhancerLiteHighpassQ));
            let a0 = 1.0 + alpha;
            this.b0 = float32 ((1.0 + cosine) * 0.5 / a0);
            this.b1 = float32 (-(1.0 + cosine) / a0);
            this.b2 = this.b0;
            this.a1 = float32 (-2.0 * cosine / a0);
            this.a2 = float32 ((1.0 - alpha) / a0);
        }

        void reset()
        {
            this.state1 = ();
            this.state2 = ();
        }

        float32<2> process (float32<2> sampleFrame)
        {
            let result = sampleFrame * this.b0 + this.state1;
            this.state1 = sampleFrame * this.b1 - result * this.a1 + this.state2;
            this.state2 = sampleFrame * this.b2 - result * this.a2;
            return result * enhancerLiteHighpassGain;
        }
    }

    // Shelf selection approaches zero at the opposite plateau, which exposes
    // coefficient quantisation in the accepted float32 Bell conditioner at
    // high host rates. Shelves use the same measured topology with float64
    // coefficients/state; the stable Bell output remains on the original path.
    struct EnhancerLiteShelfShapedHighpass
    {
        float64<2> state1;
        float64<2> state2;
        float64 b0;
        float64 b1;
        float64 b2;
        float64 a1;
        float64 a2;

        void setSampleRate (float64 sampleRate)
        {
            let omega = twoPi * float64 (enhancerLiteHighpassCutoffHz) / sampleRate;
            let cosine = std::intrinsics::cos (omega);
            let alpha = std::intrinsics::sin (omega)
                        / (2.0 * float64 (enhancerLiteHighpassQ));
            let a0 = 1.0 + alpha;
            this.b0 = (1.0 + cosine) * 0.5 / a0;
            this.b1 = -(1.0 + cosine) / a0;
            this.b2 = this.b0;
            this.a1 = -2.0 * cosine / a0;
            this.a2 = (1.0 - alpha) / a0;
        }

        void reset()
        {
            this.state1 = ();
            this.state2 = ();
        }

        float32<2> process (float32<2> sampleFrame)
        {
            let inputFrame = float64<2> (sampleFrame);
            let result = inputFrame * this.b0 + this.state1;
            this.state1 = inputFrame * this.b1 - result * this.a1 + this.state2;
            this.state2 = inputFrame * this.b2 - result * this.a2;
            return float32<2> (result * float64 (enhancerLiteHighpassGain));
        }
    }

    struct EnhancerLiteBandCore
    {
        enhancerLiteFilters::tpt::svf::Implementation[2] bandFilters;
        enhancerLiteFilters::simper::Implementation[2] lowShelfFilters;
        enhancerLiteFilters::simper::Implementation[2] highShelfFilters;
        float32 tunedFrequencyHz0;
        float32 tunedFrequencyHz1;
        float32 tunedQ0;
        float32 tunedQ1;
        float32 tunedShelfFrequencyHz0;
        float32 tunedShelfFrequencyHz1;
        float32 tunedShelfQ0;
        float32 tunedShelfQ1;
        float32 tunedShelfGainDb0;
        float32 tunedShelfGainDb1;
        bool bellFiltersActive;
        bool lowShelfFiltersActive;
        bool highShelfFiltersActive;
        int32 framesUntilCoefficientUpdate;
        int32 shelfFramesUntilCoefficientUpdate;
        float64 sampleRate;

        void prepare (float64 oversampledSampleRate)
        {
            for (wrap<2> lane)
            {
                this.bandFilters[lane].setMode (
                    enhancerLiteFilters::tpt::svf::Mode::bandPass
                );
                this.lowShelfFilters[lane].setMode (
                    enhancerLiteFilters::simper::Mode::lowShelf
                );
                this.highShelfFilters[lane].setMode (
                    enhancerLiteFilters::simper::Mode::highShelf
                );
            }
            this.sampleRate = oversampledSampleRate;
        }

        void reset()
        {
            for (wrap<2> lane)
            {
                this.bandFilters[lane].reset();
                this.lowShelfFilters[lane].reset();
                this.highShelfFilters[lane].reset();
            }

            this.tunedFrequencyHz0 = 0.0f;
            this.tunedFrequencyHz1 = 0.0f;
            this.tunedQ0 = 0.0f;
            this.tunedQ1 = 0.0f;
            this.tunedShelfFrequencyHz0 = 0.0f;
            this.tunedShelfFrequencyHz1 = 0.0f;
            this.tunedShelfQ0 = 0.0f;
            this.tunedShelfQ1 = 0.0f;
            this.tunedShelfGainDb0 = -1.0f;
            this.tunedShelfGainDb1 = -1.0f;
            this.bellFiltersActive = false;
            this.lowShelfFiltersActive = false;
            this.highShelfFiltersActive = false;
            this.framesUntilCoefficientUpdate = 0;
            this.shelfFramesUntilCoefficientUpdate = 0;
        }

        void updateBellCoefficients (
            float32 frequencyHz,
            float32 bellQ0,
            float32 bellQ1
        )
        {
            if (this.framesUntilCoefficientUpdate > 0)
            {
                this.framesUntilCoefficientUpdate -= 1;
                return;
            }

            this.framesUntilCoefficientUpdate = enhancerLiteCoefficientUpdateFrames
                                                * enhancerLiteOversampleFactor - 1;

            if (std::intrinsics::abs (frequencyHz - this.tunedFrequencyHz0)
                    > enhancerLiteCoefficientEpsilon
                || std::intrinsics::abs (bellQ0 - this.tunedQ0)
                    > enhancerLiteCoefficientEpsilon)
            {
                this.bandFilters[0].setFrequency (
                    this.sampleRate,
                    frequencyHz,
                    bellQ0
                );
                this.tunedFrequencyHz0 = frequencyHz;
                this.tunedQ0 = bellQ0;
            }

            if (std::intrinsics::abs (frequencyHz - this.tunedFrequencyHz1)
                    > enhancerLiteCoefficientEpsilon
                || std::intrinsics::abs (bellQ1 - this.tunedQ1)
                    > enhancerLiteCoefficientEpsilon)
            {
                this.bandFilters[1].setFrequency (
                    this.sampleRate,
                    frequencyHz,
                    bellQ1
                );
                this.tunedFrequencyHz1 = frequencyHz;
                this.tunedQ1 = bellQ1;
            }

        }

        void updateShelfCoefficients (
            float32 frequencyHz,
            float32 shelfQ,
            float32 shelfGainDb0,
            float32 shelfGainDb1
        )
        {
            if (this.shelfFramesUntilCoefficientUpdate > 0)
            {
                this.shelfFramesUntilCoefficientUpdate -= 1;
                return;
            }

            this.shelfFramesUntilCoefficientUpdate = enhancerLiteCoefficientUpdateFrames
                                                     * enhancerLiteOversampleFactor - 1;

            if (std::intrinsics::abs (
                    frequencyHz - this.tunedShelfFrequencyHz0
                ) > enhancerLiteCoefficientEpsilon
                || std::intrinsics::abs (shelfQ - this.tunedShelfQ0)
                    > enhancerLiteCoefficientEpsilon
                || std::intrinsics::abs (
                    shelfGainDb0 - this.tunedShelfGainDb0
                ) > enhancerLiteCoefficientEpsilon)
            {
                this.lowShelfFilters[0].setFrequency (
                    this.sampleRate,
                    frequencyHz,
                    shelfQ,
                    shelfGainDb0
                );
                this.highShelfFilters[0].setFrequency (
                    this.sampleRate,
                    frequencyHz,
                    shelfQ,
                    shelfGainDb0
                );
                this.tunedShelfFrequencyHz0 = frequencyHz;
                this.tunedShelfQ0 = shelfQ;
                this.tunedShelfGainDb0 = shelfGainDb0;
            }

            if (std::intrinsics::abs (
                    frequencyHz - this.tunedShelfFrequencyHz1
                ) > enhancerLiteCoefficientEpsilon
                || std::intrinsics::abs (shelfQ - this.tunedShelfQ1)
                    > enhancerLiteCoefficientEpsilon
                || std::intrinsics::abs (
                    shelfGainDb1 - this.tunedShelfGainDb1
                ) > enhancerLiteCoefficientEpsilon)
            {
                this.lowShelfFilters[1].setFrequency (
                    this.sampleRate,
                    frequencyHz,
                    shelfQ,
                    shelfGainDb1
                );
                this.highShelfFilters[1].setFrequency (
                    this.sampleRate,
                    frequencyHz,
                    shelfQ,
                    shelfGainDb1
                );
                this.tunedShelfFrequencyHz1 = frequencyHz;
                this.tunedShelfQ1 = shelfQ;
                this.tunedShelfGainDb1 = shelfGainDb1;
            }
        }

        float32 subtleSolidShape (float32 sample)
        {
            return enhancerLiteSubtleOutput * enhancerLiteFastTanh (
                enhancerLiteSubtleDrive * sample
            );
        }

        float32 subtleTubeShape (float32 sample)
        {
            if (sample == 0.0f)
                return 0.0f;

            return enhancerLiteSubtleOutput * (
                enhancerLiteFastTanh (
                    enhancerLiteSubtleDrive * sample + enhancerLiteSubtleTubeBias
                ) - enhancerLiteFastTanh (enhancerLiteSubtleTubeBias)
            );
        }

        float32 mediumSolidShape (float32 sample)
        {
            return enhancerLiteMediumOutput * enhancerLiteFastTanh (
                enhancerLiteMediumDrive * sample
            );
        }

        float32 mediumTubeShape (float32 sample)
        {
            if (sample == 0.0f)
                return 0.0f;

            return enhancerLiteMediumOutput * (
                enhancerLiteFastTanh (
                    enhancerLiteMediumDrive * sample + enhancerLiteMediumTubeBias
                ) - enhancerLiteFastTanh (enhancerLiteMediumTubeBias)
            );
        }

        float32 subtleShape (float32 sample, float32 solidWeight)
        {
            if (solidWeight == 0.0f)
                return this.subtleTubeShape (sample);
            if (solidWeight == 1.0f)
                return this.subtleSolidShape (sample);

            let tube = this.subtleTubeShape (sample);
            let solid = this.subtleSolidShape (sample);
            return tube + (solid - tube) * solidWeight;
        }

        float32 mediumShape (float32 sample, float32 solidWeight)
        {
            if (solidWeight == 0.0f)
                return this.mediumTubeShape (sample);
            if (solidWeight == 1.0f)
                return this.mediumSolidShape (sample);

            let tube = this.mediumTubeShape (sample);
            let solid = this.mediumSolidShape (sample);
            return tube + (solid - tube) * solidWeight;
        }

        float32 shape (float32 sample, float32 solidWeight, float32 mediumWeight)
        {
            if (mediumWeight == 0.0f)
                return this.subtleShape (sample, solidWeight);
            if (mediumWeight == 1.0f)
                return this.mediumShape (sample, solidWeight);

            let subtle = this.subtleShape (sample, solidWeight);
            let medium = this.mediumShape (sample, solidWeight);
            return subtle + (medium - subtle) * mediumWeight;
        }

        float32 mixSelectedShapes (
            float32 lowSelected,
            float32 bellSelected,
            float32 highSelected,
            float32 solidWeight,
            float32 mediumWeight,
            float32 lowWeight,
            float32 bellWeight,
            float32 highWeight
        )
        {
            // Stable endpoints avoid an extra multiply/add in the accepted Bell
            // path. During a Shape transition, all participating nonlinear
            // outputs are crossfaded while a newly selected filter warms from
            // its reset state behind an initially near-zero weight.
            if (bellWeight == 1.0f && lowWeight == 0.0f && highWeight == 0.0f)
                return this.shape (bellSelected, solidWeight, mediumWeight);

            if (lowWeight == 1.0f && bellWeight == 0.0f && highWeight == 0.0f)
                return this.shape (lowSelected, solidWeight, mediumWeight);

            if (highWeight == 1.0f && lowWeight == 0.0f && bellWeight == 0.0f)
                return this.shape (highSelected, solidWeight, mediumWeight);

            var result = 0.0f;
            if (lowWeight > 0.0f)
                result += this.shape (lowSelected, solidWeight, mediumWeight)
                          * lowWeight;
            if (bellWeight > 0.0f)
                result += this.shape (bellSelected, solidWeight, mediumWeight)
                          * bellWeight;
            if (highWeight > 0.0f)
                result += this.shape (highSelected, solidWeight, mediumWeight)
                          * highWeight;
            return result;
        }

        float32<2> process (
            float32<2> sampleFrame,
            float32 frequencyHz,
            float32 bellQ0,
            float32 bellQ1,
            float32 shelfQ,
            float32 amount0,
            float32 amount1,
            float32 drive0,
            float32 drive1,
            float32 solidWeight,
            float32 mediumWeight,
            float32 lowShapeWeight,
            float32 bellShapeWeight,
            float32 highShapeWeight
        )
        {
            let qMaximum = enhancerLiteQMax * std::levels::dBtoGain (
                0.5f * enhancerLiteBandGainRangeDb
            );
            let safeFrequencyHz = std::intrinsics::clamp (
                frequencyHz,
                enhancerLiteFrequencyMinHz,
                enhancerLiteFrequencyMaxHz
            );
            let safeBellQ0 = std::intrinsics::clamp (
                bellQ0,
                enhancerLiteQMin,
                qMaximum
            );
            let safeBellQ1 = std::intrinsics::clamp (
                bellQ1,
                enhancerLiteQMin,
                qMaximum
            );
            let safeDrive0 = std::intrinsics::clamp (
                drive0,
                0.0f,
                enhancerLiteAmountDrive (1.0f)
            );
            let safeDrive1 = std::intrinsics::clamp (
                drive1,
                0.0f,
                enhancerLiteAmountDrive (1.0f)
            );
            let safeSolidWeight = std::intrinsics::clamp (solidWeight, 0.0f, 1.0f);
            let safeMediumWeight = std::intrinsics::clamp (mediumWeight, 0.0f, 1.0f);
            let safeLowShapeWeight = std::intrinsics::clamp (
                lowShapeWeight,
                0.0f,
                1.0f
            );
            let safeBellShapeWeight = std::intrinsics::clamp (
                bellShapeWeight,
                0.0f,
                1.0f
            );
            let safeHighShapeWeight = std::intrinsics::clamp (
                highShapeWeight,
                0.0f,
                1.0f
            );

            // Keep the accepted stable Bell path short. Shelf coefficient and
            // state work begins only when a shelf participates in a crossfade.
            if (safeBellShapeWeight == 1.0f
                && safeLowShapeWeight == 0.0f
                && safeHighShapeWeight == 0.0f)
            {
                if (this.lowShelfFiltersActive)
                {
                    for (wrap<2> lane)
                        this.lowShelfFilters[lane].reset();
                    this.lowShelfFiltersActive = false;
                }
                if (this.highShelfFiltersActive)
                {
                    for (wrap<2> lane)
                        this.highShelfFilters[lane].reset();
                    this.highShelfFiltersActive = false;
                }

                this.updateBellCoefficients (
                    safeFrequencyHz,
                    safeBellQ0,
                    safeBellQ1
                );
                let bellSelected0 = this.bandFilters[0].process (sampleFrame[0])
                                    * safeDrive0 / safeBellQ0;
                let bellSelected1 = this.bandFilters[1].process (sampleFrame[1])
                                    * safeDrive1 / safeBellQ1;
                this.bellFiltersActive = true;
                return float32<2> (
                    this.shape (
                        bellSelected0,
                        safeSolidWeight,
                        safeMediumWeight
                    ),
                    this.shape (
                        bellSelected1,
                        safeSolidWeight,
                        safeMediumWeight
                    )
                );
            }

            let safeShelfQ = clampEnhancerLiteQ (shelfQ);
            let safeAmount0 = clampEnhancerLiteAmount (amount0);
            let safeAmount1 = clampEnhancerLiteAmount (amount1);
            let safeShelfGainDb0 = enhancerLiteShelfGainDb (safeAmount0);
            let safeShelfGainDb1 = enhancerLiteShelfGainDb (safeAmount1);

            if (safeLowShapeWeight == 1.0f
                && safeBellShapeWeight == 0.0f
                && safeHighShapeWeight == 0.0f)
            {
                if (this.bellFiltersActive)
                {
                    for (wrap<2> lane)
                        this.bandFilters[lane].reset();
                    this.bellFiltersActive = false;
                }
                if (this.highShelfFiltersActive)
                {
                    for (wrap<2> lane)
                        this.highShelfFilters[lane].reset();
                    this.highShelfFiltersActive = false;
                }

                this.updateShelfCoefficients (
                    safeFrequencyHz,
                    safeShelfQ,
                    safeShelfGainDb0,
                    safeShelfGainDb1
                );
                let lowSelected0 = this.lowShelfFilters[0].process (sampleFrame[0])
                                   - sampleFrame[0];
                let lowSelected1 = this.lowShelfFilters[1].process (sampleFrame[1])
                                   - sampleFrame[1];
                this.lowShelfFiltersActive = true;
                return float32<2> (
                    this.shape (
                        lowSelected0,
                        safeSolidWeight,
                        safeMediumWeight
                    ),
                    this.shape (
                        lowSelected1,
                        safeSolidWeight,
                        safeMediumWeight
                    )
                );
            }

            if (safeHighShapeWeight == 1.0f
                && safeLowShapeWeight == 0.0f
                && safeBellShapeWeight == 0.0f)
            {
                if (this.bellFiltersActive)
                {
                    for (wrap<2> lane)
                        this.bandFilters[lane].reset();
                    this.bellFiltersActive = false;
                }
                if (this.lowShelfFiltersActive)
                {
                    for (wrap<2> lane)
                        this.lowShelfFilters[lane].reset();
                    this.lowShelfFiltersActive = false;
                }

                this.updateShelfCoefficients (
                    safeFrequencyHz,
                    safeShelfQ,
                    safeShelfGainDb0,
                    safeShelfGainDb1
                );
                let highSelected0 = this.highShelfFilters[0].process (sampleFrame[0])
                                    - sampleFrame[0];
                let highSelected1 = this.highShelfFilters[1].process (sampleFrame[1])
                                    - sampleFrame[1];
                this.highShelfFiltersActive = true;
                return float32<2> (
                    this.shape (
                        highSelected0,
                        safeSolidWeight,
                        safeMediumWeight
                    ),
                    this.shape (
                        highSelected1,
                        safeSolidWeight,
                        safeMediumWeight
                    )
                );
            }

            this.updateBellCoefficients (
                safeFrequencyHz,
                safeBellQ0,
                safeBellQ1
            );
            this.updateShelfCoefficients (
                safeFrequencyHz,
                safeShelfQ,
                safeShelfGainDb0,
                safeShelfGainDb1
            );

            var bellSelected0 = 0.0f;
            var bellSelected1 = 0.0f;
            if (safeBellShapeWeight > 0.0f)
            {
                bellSelected0 = this.bandFilters[0].process (sampleFrame[0])
                                * safeDrive0 / safeBellQ0;
                bellSelected1 = this.bandFilters[1].process (sampleFrame[1])
                                * safeDrive1 / safeBellQ1;
                this.bellFiltersActive = true;
            }
            else if (this.bellFiltersActive)
            {
                for (wrap<2> lane)
                    this.bandFilters[lane].reset();
                this.bellFiltersActive = false;
            }

            var lowSelected0 = 0.0f;
            var lowSelected1 = 0.0f;
            if (safeLowShapeWeight > 0.0f)
            {
                lowSelected0 = this.lowShelfFilters[0].process (sampleFrame[0])
                               - sampleFrame[0];
                lowSelected1 = this.lowShelfFilters[1].process (sampleFrame[1])
                               - sampleFrame[1];
                this.lowShelfFiltersActive = true;
            }
            else if (this.lowShelfFiltersActive)
            {
                for (wrap<2> lane)
                    this.lowShelfFilters[lane].reset();
                this.lowShelfFiltersActive = false;
            }

            var highSelected0 = 0.0f;
            var highSelected1 = 0.0f;
            if (safeHighShapeWeight > 0.0f)
            {
                highSelected0 = this.highShelfFilters[0].process (sampleFrame[0])
                                - sampleFrame[0];
                highSelected1 = this.highShelfFilters[1].process (sampleFrame[1])
                                - sampleFrame[1];
                this.highShelfFiltersActive = true;
            }
            else if (this.highShelfFiltersActive)
            {
                for (wrap<2> lane)
                    this.highShelfFilters[lane].reset();
                this.highShelfFiltersActive = false;
            }
            return float32<2> (
                this.mixSelectedShapes (
                    lowSelected0,
                    bellSelected0,
                    highSelected0,
                    safeSolidWeight,
                    safeMediumWeight,
                    safeLowShapeWeight,
                    safeBellShapeWeight,
                    safeHighShapeWeight
                ),
                this.mixSelectedShapes (
                    lowSelected1,
                    bellSelected1,
                    highSelected1,
                    safeSolidWeight,
                    safeMediumWeight,
                    safeLowShapeWeight,
                    safeBellShapeWeight,
                    safeHighShapeWeight
                )
            );
        }
    }

    processor EnhancerLiteBus
    {
        input stream float32<2> in;

        input value float32 freqHzIn [[ name: "Enhancer Lite Frequency", min: enhancerLiteFrequencyMinHz, max: enhancerLiteFrequencyMaxHz, init: enhancerLiteFrequencyDefaultHz, unit: "Hz", automatable: false, rampFrames: 0 ]];
        input value float32 qIn [[ name: "Enhancer Lite Q", min: enhancerLiteQMin, max: enhancerLiteQMax, init: enhancerLiteQDefault, automatable: false, rampFrames: 0 ]];
        input value float32 modeIn [[ name: "Enhancer Lite Mode", min: 0.0f, max: 1.0f, init: float32 (enhancerLiteModeStereo), discrete: true, step: 1.0f, text: "Stereo|Mid/Side", automatable: false, rampFrames: 0 ]];
        input value float32 midAmountIn [[ name: "Enhancer Lite Amount / Mid", min: enhancerLiteAmountMin, max: enhancerLiteAmountMax, init: 0.0f, automatable: false, rampFrames: 0 ]];
        input value float32 sideAmountIn [[ name: "Enhancer Lite Side", min: enhancerLiteAmountMin, max: enhancerLiteAmountMax, init: 0.0f, automatable: false, rampFrames: 0 ]];
        input value float32 curveIn [[ name: "Enhancer Lite Character", min: 0.0f, max: 1.0f, init: float32 (enhancerLiteCurveDefault), discrete: true, step: 1.0f, text: "Tube|Solid", automatable: false, rampFrames: 0 ]];
        input value float32 saturationModeIn [[ name: "Enhancer Lite Saturation Mode", min: 0.0f, max: 1.0f, init: float32 (enhancerLiteSaturationModeDefault), discrete: true, step: 1.0f, text: "Subtle|Medium", automatable: false, rampFrames: 0 ]];
        input value float32 shapeIn [[ name: "Enhancer Lite Shape", min: 0.0f, max: 2.0f, init: float32 (enhancerLiteShapeDefault), discrete: true, step: 1.0f, text: "Low|Bell|High", automatable: false, rampFrames: 0 ]];

        input event int32 resetIn;
        output stream float32<2> out;

        processor.latency = 3;
        static_assert (enhancerLiteLatencySamples == 3,
                       "Update EnhancerLiteBus latency with its IIR wrapper contract");

        EnhancerLiteIirUpsampler4x inputOversampler;
        EnhancerLiteIirDownsampler4x outputDownsampler;
        EnhancerLiteBandCore stereoCore;
        EnhancerLiteBandCore midSideCore;
        EnhancerLiteShapedHighpass shapedHighpass;
        EnhancerLiteShelfShapedHighpass shelfShapedHighpass;

        float32 frequencyHz = enhancerLiteFrequencyDefaultHz;
        float32 q = enhancerLiteQDefault;
        float32 midSideWeight;
        float32 midAmount;
        float32 sideAmount;
        float32 solidWeight = float32 (enhancerLiteCurveDefault);
        float32 mediumWeight = float32 (enhancerLiteSaturationModeDefault);
        float32 lowShapeWeight;
        float32 bellShapeWeight = 1.0f;
        float32 highShapeWeight;
        var smoothingAmount = 1.0f - std::intrinsics::exp (
            -1.0f / (
                enhancerLiteControlSmoothingMs * 0.001f * float32 (processor.frequency)
            )
        );

        void init()
        {
            let oversampledSampleRate = processor.frequency
                                        * float64 (enhancerLiteOversampleFactor);
            stereoCore.prepare (oversampledSampleRate);
            midSideCore.prepare (oversampledSampleRate);
            shapedHighpass.setSampleRate (oversampledSampleRate);
            shelfShapedHighpass.setSampleRate (oversampledSampleRate);
        }

        event resetIn (int32 ignored)
        {
            inputOversampler.reset();
            outputDownsampler.reset();
            stereoCore.reset();
            midSideCore.reset();
            shapedHighpass.reset();
            shelfShapedHighpass.reset();
        }

        void smoothControls()
        {
            let sampleRate = float32 (processor.frequency);
            frequencyHz = smoothEnhancerLiteControl (
                frequencyHz,
                clampEnhancerLiteFrequencyHz (freqHzIn, sampleRate),
                smoothingAmount,
                0.001f
            );
            q = smoothEnhancerLiteControl (
                q,
                clampEnhancerLiteQ (qIn),
                smoothingAmount,
                enhancerLiteCoefficientEpsilon
            );
            midSideWeight = smoothEnhancerLiteControl (
                midSideWeight,
                resolveEnhancerLiteWeight (modeIn),
                smoothingAmount,
                enhancerLiteCoefficientEpsilon
            );
            midAmount = smoothEnhancerLiteControl (
                midAmount,
                clampEnhancerLiteAmount (midAmountIn),
                smoothingAmount,
                enhancerLiteCoefficientEpsilon
            );
            sideAmount = smoothEnhancerLiteControl (
                sideAmount,
                clampEnhancerLiteAmount (sideAmountIn),
                smoothingAmount,
                enhancerLiteCoefficientEpsilon
            );
            solidWeight = smoothEnhancerLiteControl (
                solidWeight,
                resolveEnhancerLiteWeight (curveIn),
                smoothingAmount,
                enhancerLiteCoefficientEpsilon
            );
            mediumWeight = smoothEnhancerLiteControl (
                mediumWeight,
                resolveEnhancerLiteWeight (saturationModeIn),
                smoothingAmount,
                enhancerLiteCoefficientEpsilon
            );
            lowShapeWeight = smoothEnhancerLiteControl (
                lowShapeWeight,
                resolveEnhancerLiteLowShapeWeight (shapeIn),
                smoothingAmount,
                enhancerLiteCoefficientEpsilon
            );
            bellShapeWeight = smoothEnhancerLiteControl (
                bellShapeWeight,
                resolveEnhancerLiteBellShapeWeight (shapeIn),
                smoothingAmount,
                enhancerLiteCoefficientEpsilon
            );
            highShapeWeight = smoothEnhancerLiteControl (
                highShapeWeight,
                resolveEnhancerLiteHighShapeWeight (shapeIn),
                smoothingAmount,
                enhancerLiteCoefficientEpsilon
            );
        }

        void main()
        {
            loop
            {
                smoothControls();

                let dry = in;
                let primaryDrive = enhancerLiteAmountDrive (midAmount);
                let sideDrive = enhancerLiteAmountDrive (sideAmount);
                let primaryQ = enhancerLiteEffectiveBellQ (q, midAmount);
                let sideQ = enhancerLiteEffectiveBellQ (q, sideAmount);
                inputOversampler.process (dry);
                float32<2>[4] combinedFrames;

                for (int32 oversampleFrame = 0;
                     oversampleFrame < enhancerLiteOversampleFactor;
                     ++oversampleFrame)
                {
                    let oversampledDry = inputOversampler.samples.at (oversampleFrame);
                    let oversampledMidSide = float32<2> (
                        0.5f * (oversampledDry[0] + oversampledDry[1]),
                        0.5f * (oversampledDry[0] - oversampledDry[1])
                    );
                    let stereoShaped = stereoCore.process (
                        oversampledDry,
                        frequencyHz,
                        primaryQ,
                        primaryQ,
                        q,
                        midAmount,
                        midAmount,
                        primaryDrive,
                        primaryDrive,
                        solidWeight,
                        mediumWeight,
                        lowShapeWeight,
                        bellShapeWeight,
                        highShapeWeight
                    );
                    let midSideShaped = midSideCore.process (
                        oversampledMidSide,
                        frequencyHz,
                        primaryQ,
                        sideQ,
                        q,
                        midAmount,
                        sideAmount,
                        primaryDrive,
                        sideDrive,
                        solidWeight,
                        mediumWeight,
                        lowShapeWeight,
                        bellShapeWeight,
                        highShapeWeight
                    );
                    let decodedMidSideShaped = float32<2> (
                        midSideShaped[0] + midSideShaped[1],
                        midSideShaped[0] - midSideShaped[1]
                    );
                    let shaped = midSideWeight == 0.0f ? stereoShaped
                        : (midSideWeight == 1.0f ? decodedMidSideShaped
                           : stereoShaped
                             + (decodedMidSideShaped - stereoShaped) * midSideWeight);

                    // DC conditioning stays on the shaped contribution, but is
                    // moved into the 4x cluster so dry plus contribution can use
                    // one shared reconstruction path.
                    if (bellShapeWeight == 1.0f
                        && lowShapeWeight == 0.0f
                        && highShapeWeight == 0.0f)
                    {
                        // This is the accepted Bell arithmetic path verbatim.
                        shelfShapedHighpass.reset();
                        combinedFrames.at (oversampleFrame) = oversampledDry
                            + shapedHighpass.process (shaped);
                    }
                    else if (bellShapeWeight == 0.0f)
                    {
                        shapedHighpass.reset();
                        combinedFrames.at (oversampleFrame) = oversampledDry
                            + shelfShapedHighpass.process (shaped);
                    }
                    else
                    {
                        let bellConditioned = shapedHighpass.process (shaped);
                        let shelfConditioned = shelfShapedHighpass.process (shaped);
                        let shelfWeight = std::intrinsics::clamp (
                            lowShapeWeight + highShapeWeight,
                            0.0f,
                            1.0f
                        );
                        let conditioned = bellConditioned
                            + (shelfConditioned - bellConditioned) * shelfWeight;
                        combinedFrames.at (oversampleFrame) = oversampledDry
                            + conditioned;
                    }
                }

                out <- outputDownsampler.process (
                    combinedFrames[0],
                    combinedFrames[1],
                    combinedFrames[2],
                    combinedFrames[3]
                );

                advance();
            }
        }
    }
}
