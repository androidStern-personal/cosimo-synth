namespace wt
{
    //==============================================================================
    // The effects rack - eight resident effect instances advanced in a runtime-selected
    // serial order (ADR-001).
    //
    // THE SHAPE. This is a `processor`, not a `graph`. A graph's `connection` block
    // cannot express a runtime order: conditional connections need a compile-time
    // constant condition, so the 8! = 40320 orders are unreachable from a graph, and a
    // fixed-declaration-order routing bus would need a one-frame delay per hop, which
    // is a direct ADR-008 violation. Cmajor's documented processor composition does
    // express it exactly: the eight effects are resident `node`s, and main() drives
    // each one by hand with `child.in <- signal; child.advance(); read child.out`,
    // walking rack positions and dispatching on the effect id held in a runtime
    // wrap<8> array. The idiom is already used in this repo - wt::DistortionBus
    // hand-drives its two oversampled cores the same way (Distortion.cmajor:125-181).
    // The generated C++ inlines all eight children's state by value: no heap, no
    // indirection, no allocation, and in identity order the audio is bit-identical to
    // the equivalent static graph chain.
    //
    // THE ONE LOAD-BEARING INVARIANT. Every module must be advanced EXACTLY ONCE per
    // rack frame, whatever its position and whatever its enabled state. A module
    // advanced zero times silently re-emits its previous frame - no error, no crash,
    // just a corrupted time base - and nothing in the language enforces this. So the
    // rack validates that every uploaded order is a COMPLETE PERMUTATION and rejects
    // anything else outright (ADR-009), and a disabled module is still fed the live
    // chain signal and still advanced.
    //
    // ALWAYS-ADVANCE IS THE v1 DEFAULT, PENDING PROFILING - NOT A PROHIBITION.
    // ADR-005 is explicit that "whether a disabled child continues advancing is an
    // effect-local implementation and performance decision, not part of the public
    // rack-state model", and that "profiling, rather than rack architecture, determines
    // whether a sleep optimization is necessary". Always-advance is the honest starting
    // point because it cannot be wrong: no clock drifts, no delay line goes stale, and
    // re-enabling exposes no transient. It is also the worst case for CPU - a rack with
    // two modules enabled costs what a rack with eight costs - so it is a default with a
    // known bill, and rackModuleSleepsWhileDisabled() below is the single point where a
    // profiling pass changes it.
    //
    // WHAT THE RACK DOES NOT DO. It does not terminate the signal path. Output limiting
    // lives in wt::RackOutputStage, fixed and non-reorderable, between rack.out and
    // audioOut (ADR-006) - see RackOutputStage.cmajor for why that is not optional.
    //
    // INTEGRATION NOTES for whoever wires this into graph WavetableSynth:
    //   - Hoist with MODULE-PREFIX wildcards only (`input rack.distortion*;` and so on).
    //     A bare `input rack.*;` would also hoist `in`, `trackingPitchHzIn`,
    //     `tempoBpmIn`, `rackModIn` and the four preview streams.
    //   - rackEnable is the only participation gate for every module. This is the first
    //     production rack schema, so there is no deprecated Chorus gate or migration.
    //   - The distortion scope and history analyzers read the four preview streams
    //     forwarded below rather than reaching into wt::DistortionBus directly.
    //   - A composed processor cannot write to `console`, so every diagnostic here is a
    //     value output endpoint. That is the better design anyway: the iPhone UI can
    //     read back what the DSP is actually running instead of assuming its upload
    //     landed.
    //   - `rackModIn` carries the 36 reduced modulation offsets from
    //     wt::SharedVoiceEngine's `rackModOut` in ONE graph connection. The destination
    //     vocabulary and reduction rules live in VoiceReducer.cmajor; the engine runs
    //     only active instructions from its compiled sparse route program.
    //   - THE DEFAULT ENABLE MASK IS EMPTY. This preserves the deployed pre-rack sound
    //     until the adapter restores the canonical rack.v1 document. A module's host
    //     parameter default is never allowed to opt it into the audio path implicitly.

    let rackModuleCount = 8;
    let rackChannelCount = 2;

    // Effect instance ids. These are a WIRE CONTRACT with the adapter and with saved
    // patches: they identify an instance, never a position.
    let rackModuleGlobalFilter = 0;
    let rackModuleDistortion   = 1;
    let rackModuleOtt          = 2;
    let rackModuleChorus       = 3;
    let rackModuleFlanger      = 4;
    let rackModulePhaser       = 5;
    let rackModuleDelay        = 6;
    let rackModuleReverb       = 7;

    // ADR-003's 2-5 ms window. Long enough that the fade is inaudible, short enough
    // that dragging a module in the UI feels instant.
    let rackTransitionMs = 3.0f;

    // Three bits per rack position, packed least-significant-position-first, so the
    // committed order is one readable int32.
    let rackOrderCodeBitsPerPosition = 3;

    //==============================================================================
    // Effects Lane pool (M1). Slot ids EXTEND the module-id wire contract: ids
    // 0..rackModuleCount-1 are the base instances, ids above them are pool slots.
    // Slice 1 carries one pool slot (a second delay); the pool widens here as the
    // build proceeds.
    let laneSlotDelayTwo        = 8;
    let laneSlotGlobalFilterTwo = 9;
    let laneSlotDistortionTwo   = 10;
    let laneSlotOttTwo          = 11;
    let laneSlotChorusTwo       = 12;
    let laneSlotFlangerTwo      = 13;
    let laneSlotPhaserTwo       = 14;
    let laneSlotReverbTwo       = 15;
    let laneSlotCount           = 16;
    let lanePoolSlotCount       = laneSlotCount - rackModuleCount;
    let maxLaneChainLength      = laneSlotCount;

    // Per-slot parameter records travel in LaneSlotParamsUpload.values; each pool
    // slot type documents its own value vocabulary below (indices into `values`).
    let laneSlotParamCount = 8;

    // Delay-type pool slots.
    let laneDelayParamTimeMs   = 0;
    let laneDelayParamFeedback = 1;
    let laneDelayParamFilterHz = 2;
    let laneDelayParamMix      = 3;
    let laneDelayParamTimeMode = 4;
    let laneDelayParamDivision = 5;

    // GlobalFilter-type pool slots.
    let laneGlobalFilterParamMode      = 0;
    let laneGlobalFilterParamCutoffHz  = 1;
    let laneGlobalFilterParamResonance = 2;
    let laneGlobalFilterParamDrive     = 3;

    // Distortion-type pool slots.
    let laneDistortionParamMode    = 0;
    let laneDistortionParamDriveDb = 1;
    let laneDistortionParamKnee    = 2;
    let laneDistortionParamWet     = 3;
    let laneDistortionParamWetHPHz = 4;
    let laneDistortionParamWetLPHz = 5;

    // OTT-type pool slots.
    let laneOttParamMix           = 0;
    let laneOttParamAmount        = 1;
    let laneOttParamTimePercent   = 2;
    let laneOttParamBandDrive     = 3;
    let laneOttParamEnvelopeMatch = 4;

    // Chorus-type pool slots.
    let laneChorusParamMix               = 0;
    let laneChorusParamMotionMode        = 1;
    let laneChorusParamBloomMode         = 2;
    let laneChorusParamTone              = 3;
    let laneChorusParamFeedback          = 4;
    let laneChorusParamRingAmount        = 5;
    let laneChorusParamRingOffsetMode    = 6;
    let laneChorusParamRingFineSemitones = 7;

    // Flanger-type pool slots.
    let laneFlangerParamRate     = 0;
    let laneFlangerParamDepth    = 1;
    let laneFlangerParamFeedback = 2;
    let laneFlangerParamMix      = 3;

    // Phaser-type pool slots.
    let lanePhaserParamRate         = 0;
    let lanePhaserParamRateMode     = 1;
    let lanePhaserParamRateDivision = 2;
    let lanePhaserParamDepth        = 3;
    let lanePhaserParamFrequency    = 4;
    let lanePhaserParamFeedback     = 5;
    let lanePhaserParamPhase        = 6;
    let lanePhaserParamMix          = 7;

    // Reverb-type pool slots.
    let laneReverbParamSize    = 0;
    let laneReverbParamDecay   = 1;
    let laneReverbParamDamping = 2;
    let laneReverbParamMix     = 3;


    // Distortion.cmajor:144-160's rule, in octave units: 0.001 octaves is 0.07% of a
    // frequency, so recomputing pow() below that buys nothing.
    let rackOctaveEpsilon = 0.001f;

    let rackOctaveScalerGlobalFilterCutoff = 0;
    let rackOctaveScalerDistortionWetHP    = 1;
    let rackOctaveScalerDistortionWetLP    = 2;
    let rackOctaveScalerPhaserFrequency    = 3;
    let rackOctaveScalerDelayTime          = 4;
    let rackOctaveScalerDelayFilter        = 5;
    let rackOctaveScalerLaneGlobalFilterCutoff = 6;
    let rackOctaveScalerLaneDistortionWetHP    = 7;
    let rackOctaveScalerLaneDistortionWetLP    = 8;
    let rackOctaveScalerLanePhaserFrequency    = 9;
    let rackOctaveScalerLaneDelayTime          = 10;
    let rackOctaveScalerLaneDelayFilter        = 11;
    let rackOctaveScalerCount                  = 12;

    //==============================================================================
    // The adapter's wire format. Order and enabled state are stored SEPARATELY
    // (ADR-009): moving a module must not change what is on, and turning a module off
    // must not move it.

    // Rack position -> effect instance id. Always a complete permutation.
    struct RackOrderUpload
    {
        int32[rackModuleCount] moduleIds;
    }

    // Effect instance id -> enabled flag. A FLAG, so 0 or 1 - not a truthy integer.
    struct RackEnableUpload
    {
        int32[rackModuleCount] enabledFlags;
    }

    // Effects Lane topology (M1 slice 1): a serial chain over lane slots. A slot
    // present in the chain participates at its position; enabledFlags carries the
    // per-slot bypass state (a bypassed slot stays in the chain and passes the
    // signal through, exactly like rackEnable does for the base modules).
    struct LaneTopologyUpload
    {
        int32 chainLength;
        int32[maxLaneChainLength] slotIds;
        // One bit per lane slot, the same idiom as the committed enable-mask
        // readback (and small enough to keep the whole upload compact).
        int32 enabledMask;
    }

    // One pool slot's parameter record, addressed by slot id. The delivery
    // serial is the HOT PATH's acknowledgment contract: the rack echoes the
    // last APPLIED record's serial on laneParamsAcknowledgedSerial the same
    // frame it applies, so a live knob drag can measure edit-to-ack latency
    // end to end (rejected records echo nothing and count on the rejection
    // diagnostic instead).
    struct LaneSlotParamsUpload
    {
        int32 slotId;
        int32 deliverySerial;
        float32[laneSlotParamCount] values;
    }

    //==============================================================================
    // Structure validation. A malformed upload is a bug at the adapter boundary, not a
    // runtime state the rack may occupy, so both of these fail fast and the caller
    // leaves the running state completely untouched. Neither coerces.

    bool isCompleteRackPermutation (int32[rackModuleCount] moduleIds)
    {
        bool[rackModuleCount] seen;

        for (wrap<rackModuleCount> position)
        {
            let moduleId = moduleIds[position];

            if (moduleId < 0 || moduleId >= rackModuleCount)
                return false;

            let index = wrap<rackModuleCount> (moduleId);

            if (seen[index])
                return false;

            seen[index] = true;
        }

        return true;
    }

    bool isValidRackEnableUpload (int32[rackModuleCount] enabledFlags)
    {
        for (wrap<rackModuleCount> moduleId)
            if (enabledFlags[moduleId] != 0 && enabledFlags[moduleId] != 1)
                return false;

        return true;
    }

    // A lane topology is validated, never coerced (the C11 rule): out-of-range
    // slot ids, duplicate slots, or non-flag enables reject the whole upload and
    // leave the running chain untouched.
    bool isValidLaneTopology (LaneTopologyUpload upload)
    {
        if (upload.chainLength < 0 || upload.chainLength > maxLaneChainLength)
            return false;

        bool[laneSlotCount] seen;

        for (int32 position = 0; position < upload.chainLength; ++position)
        {
            let slotId = upload.slotIds.at (position);

            if (slotId < 0 || slotId >= laneSlotCount)
                return false;

            let index = wrap<laneSlotCount> (slotId);

            if (seen[index])
                return false;

            seen[index] = true;
        }

        // Mask bits above the slot domain are malformed, not ignorable.
        if (upload.enabledMask < 0 || upload.enabledMask >= (1 << laneSlotCount))
            return false;

        return true;
    }

    //==============================================================================
    // C7 / ADR-005 sleep hook.
    //
    // Return true for a module and the dispatch below will stop advancing it while it
    // is disabled. It returns false for EVERY module in v1 - pending profiling - so the
    // compiler folds the branch away entirely and always-advance costs nothing to keep
    // as an option. The three plausible candidates are the modules whose "sleep" is a
    // genuinely small local implementation: wt::GlobalFilterBus (mode Off already
    // resets its state and is a bit-exact passthrough), wt::DistortionBus (memoryless
    // cores; its band filters and DC blockers are the only memory) and wt::PhaserBus
    // (allpass state only). Waking any of them must still satisfy ADR-005's "re-enabling
    // must not expose an unsmoothed stale-state transient", which for the phaser means
    // its LFO phase, so none of this is free - which is exactly why it waits for a
    // measurement rather than a hunch.
    bool rackModuleSleepsWhileDisabled (int32 moduleId)
    {
        return false;
    }

    //==============================================================================
    // Modulation application (ADR-012). The rack is the single point at which a
    // patch-owned base value meets a reduced modulation offset, so there is exactly one
    // place to look when a value is wrong.

    float32 rackModulateLinear (float32 base, float32 offset)
    {
        return base + offset;
    }

    // Frequency-like destinations modulate in OCTAVES, matching the engine's existing
    // modulationTargetFilterCutoffOctaves convention. pow() is only recomputed when the
    // offset has actually moved, which in the overwhelmingly common case of an
    // unrouted destination means never - the offset is exactly 0.0f every frame.
    struct RackOctaveScaler
    {
        float32 offsetOctaves;
        float32 scale;
    }

    float32 rackOctaveScale (RackOctaveScaler& scaler, float32 offsetOctaves)
    {
        if (std::intrinsics::abs (offsetOctaves - scaler.offsetOctaves) > rackOctaveEpsilon)
        {
            scaler.offsetOctaves = offsetOctaves;
            scaler.scale = std::intrinsics::pow (2.0f, offsetOctaves);
        }

        return scaler.scale;
    }

    //==============================================================================
    // C10: NO RACK CHILD MAY DECLARE processor.latency.
    //
    // A composed child's declared latency does NOT reach a composing PROCESSOR - a
    // child with processor.latency = 128 leaves its parent reporting 0
    // (transient/rack-dsp-poc/smoke05) - and it does not delay the audio either:
    // processor.latency is purely declarative, so composing a latency-declaring child
    // produces BIT-IDENTICAL samples to composing a clean one. Measured, not assumed.
    // A rack module that declared latency would therefore make the host's delay
    // compensation wrong with no audible and no readable symptom anywhere. That is
    // precisely the failure ADR-008 exists to prevent, and neither a test of the rack's
    // own latency nor any test of its audio can catch it.
    //
    // A GRAPH's latency, however, DOES sum its children's, and that is the lever. The
    // standing check lives in tests/cmajor_rack/RackShape.cmajtest: a probe graph
    // chaining all eight modules behind a one-frame latency witness, asserting the sum
    // is exactly one. It has to live in the test rather than here because the sum is
    // only a constant expression in a graph that is actually INSTANTIATED, and this
    // rack must not pay for eight extra module instances just to hold an assertion.

    //==============================================================================

    processor EffectsRack
    {
        //----------------------------------------------------------------------
        // Plumbing. None of this is hoisted to the host.

        input stream float32<rackChannelCount> in;
        input stream float32 trackingPitchHzIn;

        // The reduced voice-to-global modulation offsets, one per rack destination,
        // carried from wt::SharedVoiceEngine in a single graph connection. See
        // VoiceReducer.cmajor for the vocabulary and the reduction itself.
        input stream float32 rackModIn[rackModTargetCount];

        // Host transport tempo, for the phaser's and delay's sync modes. Declared the
        // way the modules declare theirs - no `name:`, so it is plumbing rather than a
        // creative parameter, and it is not covered by any module-prefix hoist wildcard.
        // The graph should drive it from the host transport; unconnected it sits at 120,
        // which keeps the sync divisions meaningful in a standalone render.
        input value float32 tempoBpmIn [[ init: 120.0f ]];

        //----------------------------------------------------------------------
        // Structure (ADR-007: patch state, NOT host automation). These are struct
        // events, which carry no parameter purpose, so they are structurally
        // non-automatable rather than non-automatable by convention.

        input event RackOrderUpload rackOrder;
        input event RackEnableUpload rackEnable;
        input event LaneTopologyUpload laneTopology;
        input event LaneSlotParamsUpload laneSlotParams;

        //----------------------------------------------------------------------
        // Host parameters. Distortion, Chorus and OTT keep the exact annotations they
        // have today so that host parameter identity, ranges and automation lanes are
        // unchanged by the move into the rack.

        input value float32 globalFilterMode [[ name: "Global Filter Mode", min: 0.0f, max: 5.0f, init: 1.0f, discrete: true, step: 1.0f, text: "Off|Lowpass|Highpass|Bandpass|Notch|Peak", rampFrames: 0 ]];
        input value float32 globalFilterCutoff [[ name: "Global Filter Cutoff", min: filterCutoffMinHz, max: filterCutoffMaxHz, init: filterCutoffMaxHz, unit: "Hz", rampFrames: 64 ]];
        input value float32 globalFilterResonance [[ name: "Global Filter Resonance", min: filterQMin, max: filterQMax, init: 0.707107f, rampFrames: 64 ]];
        input value float32 globalFilterDrive [[ name: "Global Filter Drive", min: globalFilterDriveMin, max: globalFilterDriveMax, init: 0.0f, rampFrames: 64 ]];

        input value float32 distortionMode [[ name: "Distortion Mode", min: 0.0f, max: 1.0f, init: 0.0f, discrete: true, step: 1.0f, text: "Classic|Harmonics", rampFrames: 0 ]];
        input value float32 distortionDriveDb [[ name: "Distortion Drive", min: 0.0f, max: 36.0f, init: 12.0f, unit: "dB", rampFrames: 64 ]];
        input value float32 distortionKnee [[ name: "Distortion Knee", min: 0.0f, max: 1.0f, init: 0.35f, rampFrames: 64 ]];
        input value float32 distortionWet [[ name: "Distortion Mix", min: 0.0f, max: 1.0f, init: 0.0f, rampFrames: 64 ]];
        input value float32 distortionWetHPHz [[ name: "Distortion Band HP", min: 20.0f, max: 4000.0f, init: 40.0f, unit: "Hz", rampFrames: 64 ]];
        input value float32 distortionWetLPHz [[ name: "Distortion Band LP", min: 20.0f, max: 20000.0f, init: 18000.0f, unit: "Hz", rampFrames: 64 ]];

        input value float32 ottMix [[ name: "OTT Mix", min: 0.0f, max: 100.0f, init: 100.0f, unit: "%", rampFrames: 128 ]];
        input value float32 ottAmount [[ name: "OTT Amount", min: 0.0f, max: 100.0f, init: 100.0f, unit: "%", rampFrames: 128 ]];
        input value float32 ottTimePercent [[ name: "OTT Time", min: 10.0f, max: 1000.0f, init: 100.0f, unit: "%", rampFrames: 128 ]];
        input value float32 ottBandDrive [[ name: "OTT Band Drive", min: 0.0f, max: 100.0f, init: 0.0f, unit: "%", rampFrames: 128 ]];
        input value float32 ottEnvelopeMatch [[ name: "OTT Envelope Match", min: 0.0f, max: 100.0f, init: 0.0f, unit: "%", rampFrames: 128 ]];

        input value float32 chorusMix [[ name: "Chorus Mix", min: 0.0f, max: 1.0f, init: 0.0f, rampFrames: 128 ]];
        input value float32 chorusMotionMode [[ name: "Chorus Motion", min: 0.0f, max: 3.0f, init: 1.0f, discrete: true, step: 1.0f, text: "Subtle|Wide Slow|Classic|Fast Light", rampFrames: 0 ]];
        input value float32 chorusBloomMode [[ name: "Chorus Bloom", min: 0.0f, max: 4.0f, init: 0.0f, discrete: true, step: 1.0f, text: "Clean|Small|Large|Small+Shimmer|Large+Shimmer", rampFrames: 0 ]];
        input value float32 chorusTone [[ name: "Chorus Tone", min: 0.0f, max: 1.0f, init: 0.5f, rampFrames: 128 ]];
        input value float32 chorusFeedback [[ name: "Chorus Feedback", min: 0.0f, max: 0.95f, init: 0.42f, rampFrames: 128 ]];
        input value float32 chorusRingAmount [[ name: "Chorus Ring", min: 0.0f, max: 1.0f, init: 0.0f, rampFrames: 128 ]];
        input value float32 chorusRingOffsetMode [[ name: "Chorus Ring Pitch", min: 0.0f, max: 3.0f, init: 0.0f, discrete: true, step: 1.0f, text: "+5th|Low 5th|+Oct|-Oct", rampFrames: 0 ]];
        input value float32 chorusRingFineSemitones [[ name: "Chorus Ring Fine", min: -2.0f, max: 2.0f, init: 0.0f, unit: "st", rampFrames: 128 ]];

        input value float32 flangerRate [[ name: "Flanger Rate", min: flangerRateMinHz, max: flangerRateMaxHz, init: 0.35f, unit: "Hz", rampFrames: 64 ]];
        input value float32 flangerDepth [[ name: "Flanger Depth", min: flangerDepthMin, max: flangerDepthMax, init: 0.6f, rampFrames: 64 ]];
        input value float32 flangerFeedback [[ name: "Flanger Feedback", min: flangerFeedbackMin, max: flangerFeedbackMax, init: 0.0f, rampFrames: 64 ]];
        input value float32 flangerMix [[ name: "Flanger Mix", min: flangerMixMin, max: flangerMixMax, init: 0.0f, rampFrames: 128 ]];

        input value float32 phaserRate [[ name: "Phaser Rate", min: phaserRateMinHz, max: phaserRateMaxHz, init: 0.3f, unit: "Hz", rampFrames: 64 ]];
        input value float32 phaserRateMode [[ name: "Phaser Rate Mode", min: 0.0f, max: float32 (phaserRateModeMax), init: float32 (phaserRateModeFree), discrete: true, step: 1.0f, text: "Free|Sync", rampFrames: 0 ]];
        input value float32 phaserRateDivision [[ name: "Phaser Division", min: 0.0f, max: float32 (phaserDivisionMax), init: 2.0f, discrete: true, step: 1.0f, text: "4/1|2/1|1/1|1/2.|1/2|1/4.|1/2T|1/4|1/4T|1/8.|1/8|1/8T|1/16", rampFrames: 0 ]];
        input value float32 phaserDepth [[ name: "Phaser Depth", min: phaserDepthMin, max: phaserDepthMax, init: 0.7f, rampFrames: 64 ]];
        input value float32 phaserFrequency [[ name: "Phaser Frequency", min: phaserFrequencyMinHz, max: phaserFrequencyMaxHz, init: 600.0f, unit: "Hz", rampFrames: 64 ]];
        input value float32 phaserFeedback [[ name: "Phaser Feedback", min: phaserFeedbackMin, max: phaserFeedbackMax, init: 0.0f, rampFrames: 64 ]];
        input value float32 phaserPhase [[ name: "Phaser Phase", min: phaserPhaseMinDeg, max: phaserPhaseMaxDeg, init: 90.0f, unit: "deg", rampFrames: 64 ]];
        input value float32 phaserMix [[ name: "Phaser Mix", min: phaserMixMin, max: phaserMixMax, init: 0.0f, rampFrames: 128 ]];

        input value float32 delayTime [[ name: "Delay Time", min: delayMinMs, max: delayMaxMs, init: delayTimeInitMs, unit: "ms", rampFrames: 0 ]];
        input value float32 delayTimeMode [[ name: "Delay Timing", min: 0.0f, max: float32 (delayTimeModeMax), init: float32 (delayTimeModeFree), discrete: true, step: 1.0f, text: "Free|Sync", rampFrames: 0 ]];
        input value float32 delayDivision [[ name: "Delay Division", min: 0.0f, max: float32 (delayDivisionMax), init: float32 (delayDivisionInit), discrete: true, step: 1.0f, text: "1/1|1/2.|1/2|1/4.|1/2T|1/4|1/8.|1/4T|1/8|1/16.|1/8T|1/16|1/16T", rampFrames: 0 ]];
        input value float32 delayFeedback [[ name: "Delay Feedback", min: delayFeedbackMin, max: delayFeedbackMax, init: delayFeedbackInit, rampFrames: 64 ]];
        input value float32 delayFilter [[ name: "Delay Filter", min: delayFilterMinHz, max: delayFilterMaxHz, init: delayFilterInitHz, unit: "Hz", rampFrames: 64 ]];
        input value float32 delayMix [[ name: "Delay Mix", min: delayMixMin, max: delayMixMax, init: delayMixInit, rampFrames: 128 ]];

        // wt::ReverbBus exports no range constants; its own annotations use the same
        // literals, and the module re-clamps every one of these internally.
        input value float32 reverbSize [[ name: "Reverb Size", min: 0.0f, max: 1.0f, init: 0.5f, rampFrames: 128 ]];
        input value float32 reverbDecay [[ name: "Reverb Decay", min: 0.0f, max: 1.0f, init: 0.4f, rampFrames: 128 ]];
        input value float32 reverbDamping [[ name: "Reverb Damping", min: 0.0f, max: 1.0f, init: 0.5f, rampFrames: 128 ]];
        input value float32 reverbMix [[ name: "Reverb Mix", min: 0.0f, max: 1.0f, init: 0.0f, rampFrames: 128 ]];

        //----------------------------------------------------------------------

        output stream float32<rackChannelCount> out;

        // A resident module's own stream outputs stay reachable: the two analyzers that
        // today connect straight to wt::DistortionBus keep working once it lives inside
        // the rack, they just read these forwarded streams instead.
        output stream float32 previewInputLeft;
        output stream float32 previewInputRight;
        output stream float32 previewOutputLeft;
        output stream float32 previewOutputRight;

        // Diagnostics and state readback.
        output value int32 rackCommittedStructureGeneration;
        output value int32 rackCommittedOrderCode;
        output value int32 rackCommittedEnableMask;
        output value int32 rackRejectedOrderCount;
        output value int32 rackRejectedEnableCount;
        output value int32 laneCommittedGeneration;
        output value int32 laneRejectedUploadCount;
        output value int32 laneParamsAcknowledgedSerial;

        //----------------------------------------------------------------------
        // Exactly one stable instance of each effect (ADR-001 effect identity). The
        // declaration order below is also the compile-time default rack order.

        node globalFilter = wt::GlobalFilterBus;
        node distortion   = wt::DistortionBus;
        node ott          = wt::OttBus;
        node chorus       = wt::ChorusBus;
        node flanger      = wt::FlangerBus;
        node phaser       = wt::PhaserBus;
        node delay        = wt::DelayBus;
        node reverb       = wt::ReverbBus;

        // Effects Lane pool slots: one extra resident instance per type,
        // asleep (never advanced) outside the committed chain and entered
        // fresh through the commit-path pool reset.
        node delayTwo        = wt::DelayBus;
        node globalFilterTwo = wt::GlobalFilterBus;
        node distortionTwo   = wt::DistortionBus;
        node ottTwo          = wt::OttBus;
        node chorusTwo       = wt::ChorusBus;
        node flangerTwo      = wt::FlangerBus;
        node phaserTwo       = wt::PhaserBus;
        node reverbTwo       = wt::ReverbBus;

        // NO processor.latency DECLARATION HERE, and there must never be one: every dry
        // path through the rack is bit-exact and no module has lookahead (ADR-008). It
        // cannot be pinned with a static_assert on this processor - `processor.latency`
        // is not a constant expression inside a processor that declares nodes ("error:
        // Expected a constant value") - so the rack is included in the latency probe
        // graph in tests/cmajor_rack/RackShape.cmajtest instead, where a graph's summed
        // latency does resolve.

        let transitionFrames = int32 (std::intrinsics::max (1.0f,
                                        float32 (processor.frequency) * rackTransitionMs * 0.001f));

        wrap<rackModuleCount>[rackModuleCount] currentOrder;
        wrap<rackModuleCount>[rackModuleCount] pendingOrder;
        bool[rackModuleCount] currentEnabled;
        bool[rackModuleCount] pendingEnabled;

        bool hasPendingStructure;
        float32 transitionGain = 1.0f;
        int32 committedStructureGeneration;
        int32 rejectedOrderCount;
        int32 rejectedEnableCount;

        // Lane chain state. Once a topology commits, the lane chain drives the
        // dispatch instead of the legacy order permutation.
        bool laneChainActive;
        bool pendingLaneUpload;
        int32 currentLaneChainLength;
        int32 pendingLaneChainLength;
        wrap<laneSlotCount>[maxLaneChainLength] currentLaneChain;
        wrap<laneSlotCount>[maxLaneChainLength] pendingLaneChain;
        bool[laneSlotCount] currentLaneEnabled;
        bool[laneSlotCount] pendingLaneEnabled;
        int32 laneGeneration;
        int32 laneRejectedCount;
        int32 laneParamsSerial;
        float32[lanePoolSlotCount, laneSlotParamCount] poolSlotParams;
        bool[laneSlotCount] slotInCurrentChain;

        RackOctaveScaler[rackOctaveScalerCount] octaveScalers;

        void init()
        {
            for (wrap<rackModuleCount> position)
            {
                currentOrder[position] = position;
                pendingOrder[position] = position;
            }

            for (wrap<rackModuleCount> moduleId)
            {
                currentEnabled[moduleId] = false;
                pendingEnabled[moduleId] = false;
            }

            // pow (2, 0) - the identity, so an unrouted frequency destination never
            // computes a pow() at all.
            for (wrap<rackOctaveScalerCount> scaler)
                octaveScalers[scaler].scale = 1.0f;
        }

        //----------------------------------------------------------------------
        // Structure uploads.

        event rackOrder (RackOrderUpload upload)
        {
            if (! isCompleteRackPermutation (upload.moduleIds))
            {
                rejectedOrderCount += 1;
                return;
            }

            for (wrap<rackModuleCount> position)
                pendingOrder[position] = wrap<rackModuleCount> (upload.moduleIds[position]);

            hasPendingStructure = pendingStructureDiffersFromCurrent();
        }

        event rackEnable (RackEnableUpload upload)
        {
            if (! isValidRackEnableUpload (upload.enabledFlags))
            {
                rejectedEnableCount += 1;
                return;
            }

            for (wrap<rackModuleCount> moduleId)
                pendingEnabled[moduleId] = upload.enabledFlags[moduleId] != 0;

            hasPendingStructure = pendingStructureDiffersFromCurrent();
        }

        event laneTopology (LaneTopologyUpload upload)
        {
            if (! isValidLaneTopology (upload))
            {
                laneRejectedCount += 1;
                return;
            }

            pendingLaneChainLength = upload.chainLength;

            for (wrap<maxLaneChainLength> position)
            {
                var slotValue = 0;

                if (int32 (position) < upload.chainLength)
                    slotValue = upload.slotIds[position];

                pendingLaneChain[position] = wrap<laneSlotCount> (slotValue);
            }

            for (wrap<laneSlotCount> slot)
                pendingLaneEnabled[slot] = ((upload.enabledMask >> int32 (slot)) & 1) != 0;

            // Drives the shared ADR-003 transition; the commit swaps the chain
            // on the fully-dry frame exactly as a reorder does.
            pendingLaneUpload = true;
            hasPendingStructure = true;
        }

        event laneSlotParams (LaneSlotParamsUpload upload)
        {
            // Parameter records apply immediately, like host parameter writes;
            // only STRUCTURE rides the transition ramp. Applying acknowledges
            // the record's serial the same frame.
            if (upload.slotId >= rackModuleCount && upload.slotId < laneSlotCount)
            {
                poolSlotParams[wrap<lanePoolSlotCount> (upload.slotId - rackModuleCount)] = upload.values;
                laneParamsSerial = upload.deliverySerial;
                return;
            }

            laneRejectedCount += 1;
        }

        // Compared against the RUNNING structure, never against the previous upload, so
        // that a redundant upload arriving mid-transition cannot cancel a real pending
        // change - and so that the adapter re-sending rack state on every patch load,
        // which it does, costs nothing instead of a 6 ms dropout.
        bool pendingStructureDiffersFromCurrent()
        {
            for (wrap<rackModuleCount> position)
                if (pendingOrder[position] != currentOrder[position])
                    return true;

            for (wrap<rackModuleCount> moduleId)
                if (pendingEnabled[moduleId] != currentEnabled[moduleId])
                    return true;

            return false;
        }

        void commitPendingStructure()
        {
            for (wrap<rackModuleCount> position)
                currentOrder[position] = pendingOrder[position];

            for (wrap<rackModuleCount> moduleId)
                currentEnabled[moduleId] = pendingEnabled[moduleId];

            if (pendingLaneUpload)
            {
                bool[laneSlotCount] slotInPendingChain;

                for (wrap<maxLaneChainLength> position)
                    if (int32 (position) < pendingLaneChainLength)
                        slotInPendingChain[pendingLaneChain[position]] = true;

                // A POOL slot entering the chain is a newly created device: it
                // starts with empty audio memory, never a frozen tail from a
                // previous life. Base instances are never reset (ADR-003).
                for (wrap<laneSlotCount> slot)
                {
                    let selector = int32 (slot);

                    if (selector >= rackModuleCount
                         && slotInPendingChain[slot] && ! slotInCurrentChain[slot])
                    {
                        if (selector == laneSlotDelayTwo)         delayTwo.poolResetIn <- 1;
                        if (selector == laneSlotGlobalFilterTwo)  globalFilterTwo.poolResetIn <- 1;
                        if (selector == laneSlotDistortionTwo)    distortionTwo.poolResetIn <- 1;
                        if (selector == laneSlotOttTwo)           ottTwo.poolResetIn <- 1;
                        if (selector == laneSlotChorusTwo)        chorusTwo.poolResetIn <- 1;
                        if (selector == laneSlotFlangerTwo)       flangerTwo.poolResetIn <- 1;
                        if (selector == laneSlotPhaserTwo)        phaserTwo.poolResetIn <- 1;
                        if (selector == laneSlotReverbTwo)        reverbTwo.poolResetIn <- 1;
                    }
                }

                slotInCurrentChain = slotInPendingChain;
                currentLaneChainLength = pendingLaneChainLength;
                currentLaneChain = pendingLaneChain;
                currentLaneEnabled = pendingLaneEnabled;
                laneChainActive = true;
                laneGeneration += 1;
                pendingLaneUpload = false;
            }

            hasPendingStructure = false;
            committedStructureGeneration += 1;
        }

        int32 committedOrderCode()
        {
            var code = 0;

            for (wrap<rackModuleCount> position)
                code |= int32 (currentOrder[position]) << (rackOrderCodeBitsPerPosition * int32 (position));

            return code;
        }

        int32 committedEnableMask()
        {
            var mask = 0;

            for (wrap<rackModuleCount> moduleId)
                if (currentEnabled[moduleId])
                    mask |= 1 << int32 (moduleId);

            return mask;
        }

        void publishStructureDiagnostics()
        {
            rackCommittedStructureGeneration <- committedStructureGeneration;
            rackCommittedOrderCode <- committedOrderCode();
            rackCommittedEnableMask <- committedEnableMask();
            rackRejectedOrderCount <- rejectedOrderCount;
            rackRejectedEnableCount <- rejectedEnableCount;
            laneCommittedGeneration <- laneGeneration;
            laneRejectedUploadCount <- laneRejectedCount;
            laneParamsAcknowledgedSerial <- laneParamsSerial;
        }

        //----------------------------------------------------------------------
        // The ADR-003 transition: one rack-local processed-depth ramp.
        //
        // Fade the processed chain to the live dry input, swap on that dry frame, then
        // fade the new chain back in. A reorder never gates or mutes the instrument.
        //
        // An upload arriving mid-transition simply REVERSES THE RAMP, in either
        // direction, and can never strand a pending structure: there is no phase to be
        // in and no counter to be halfway through. The recon's first attempt used a
        // two-phase counter state machine and lost the second of two rapid uploads;
        // this form is immune to that whole class.

        float32 nextTransitionGain()
        {
            let step = 1.0f / float32 (transitionFrames);

            if (hasPendingStructure)
            {
                transitionGain = std::intrinsics::max (0.0f, transitionGain - step);

                if (transitionGain == 0.0f)
                    commitPendingStructure();
            }
            else
            {
                transitionGain = std::intrinsics::min (1.0f, transitionGain + step);
            }

            return transitionGain;
        }

        //----------------------------------------------------------------------
        // Parameter forwarding.
        //
        // Hoisted-endpoint syntax is graph-only ("error: Expected a stream type
        // specifier" inside a processor), so every child parameter is written by hand
        // here. This is also the single point where a patch-owned base value meets its
        // reduced modulation offset. Every value is re-clamped by its module's own
        // clamp helper where one exists, because a modulated value can leave the
        // parameter's declared range; the modules that export none (Chorus, Reverb)
        // clamp every one of these internally.
        //
        // Endpoint access is statically restricted to code reachable from main(), so
        // dropping this call is a compile error rather than a silent regression.

        void forwardModuleParameters()
        {
            let sampleRate = float32 (processor.frequency);

            // --- Global Filter ---------------------------------------------
            globalFilter.modeIn <- globalFilterMode;
            globalFilter.cutoffHzIn <- clampFilterCutoffHz (
                globalFilterCutoff * rackOctaveScale (octaveScalers[rackOctaveScalerGlobalFilterCutoff],
                                                      rackModIn[rackModTargetGlobalFilterCutoffOctaves]),
                sampleRate);
            globalFilter.resonanceIn <- clampFilterQ (
                rackModulateLinear (globalFilterResonance, rackModIn[rackModTargetGlobalFilterResonance]));
            globalFilter.driveIn <- clampGlobalFilterDrive (
                rackModulateLinear (globalFilterDrive, rackModIn[rackModTargetGlobalFilterDrive]));

            // --- Distortion ------------------------------------------------
            let wetHPHz = clampDistortionWetHPHz (
                distortionWetHPHz * rackOctaveScale (octaveScalers[rackOctaveScalerDistortionWetHP],
                                                     rackModIn[rackModTargetDistortionWetHPOctaves]));

            distortion.modeIn <- distortionMode;
            distortion.driveDbIn <- clampDistortionDriveDb (
                rackModulateLinear (distortionDriveDb, rackModIn[rackModTargetDistortionDriveDb]));
            distortion.kneeIn <- clampDistortionKnee (
                rackModulateLinear (distortionKnee, rackModIn[rackModTargetDistortionKnee]));
            distortion.wetIn <- clampDistortionWet (
                rackModulateLinear (distortionWet, rackModIn[rackModTargetDistortionWet]));
            distortion.wetHPHzIn <- wetHPHz;
            distortion.wetLPHzIn <- clampDistortionWetLPHz (
                distortionWetLPHz * rackOctaveScale (octaveScalers[rackOctaveScalerDistortionWetLP],
                                                     rackModIn[rackModTargetDistortionWetLPOctaves]),
                wetHPHz);

            // --- OTT -------------------------------------------------------
            // Percent destinations take percent offsets: a modulation amount is always
            // in its destination's own units, as the existing voice targets already are
            // (dB for amp gain, semitones for pitch).
            ott.mixIn <- ottClampMixPercent (
                rackModulateLinear (ottMix, rackModIn[rackModTargetOttMix]));
            ott.amountIn <- ottClampAmountPercent (
                rackModulateLinear (ottAmount, rackModIn[rackModTargetOttAmount]));
            ott.timePercentIn <- ottClampTimePercent (
                rackModulateLinear (ottTimePercent, rackModIn[rackModTargetOttTimePercent]));
            ott.bandDriveIn <- ottClampBandDrivePercent (
                rackModulateLinear (ottBandDrive, rackModIn[rackModTargetOttBandDrive]));
            ott.envelopeMatchIn <- ottClampEnvelopeMatchPercent (
                rackModulateLinear (ottEnvelopeMatch, rackModIn[rackModTargetOttEnvelopeMatch]));

            // --- Chorus / Bloom --------------------------------------------
            // Pinned on internally: module participation is governed solely by rackEnable.
            chorus.enabledIn <- 1.0f;
            chorus.mixIn <- rackModulateLinear (chorusMix, rackModIn[rackModTargetChorusMix]);
            chorus.motionModeIn <- chorusMotionMode;
            chorus.bloomModeIn <- chorusBloomMode;
            chorus.toneIn <- rackModulateLinear (chorusTone, rackModIn[rackModTargetChorusTone]);
            chorus.feedbackIn <- rackModulateLinear (chorusFeedback, rackModIn[rackModTargetChorusFeedback]);
            chorus.ringAmountIn <- rackModulateLinear (chorusRingAmount, rackModIn[rackModTargetChorusRingAmount]);
            chorus.ringOffsetModeIn <- chorusRingOffsetMode;
            chorus.ringFineSemitonesIn <- rackModulateLinear (chorusRingFineSemitones,
                                                              rackModIn[rackModTargetChorusRingFineSemitones]);
            chorus.trackingPitchHzIn <- trackingPitchHzIn;

            // --- Flanger ---------------------------------------------------
            flanger.rateIn <- clampFlangerRateHz (
                rackModulateLinear (flangerRate, rackModIn[rackModTargetFlangerRate]));
            flanger.depthIn <- clampFlangerDepth (
                rackModulateLinear (flangerDepth, rackModIn[rackModTargetFlangerDepth]));
            flanger.feedbackIn <- clampFlangerFeedback (
                rackModulateLinear (flangerFeedback, rackModIn[rackModTargetFlangerFeedback]));
            flanger.mixIn <- clampFlangerMix (
                rackModulateLinear (flangerMix, rackModIn[rackModTargetFlangerMix]));

            // --- Phaser ----------------------------------------------------
            phaser.rateIn <- clampPhaserRateHz (
                rackModulateLinear (phaserRate, rackModIn[rackModTargetPhaserRate]));
            phaser.rateModeIn <- phaserRateMode;
            phaser.rateDivisionIn <- phaserRateDivision;
            phaser.depthIn <- clampPhaserDepth (
                rackModulateLinear (phaserDepth, rackModIn[rackModTargetPhaserDepth]));
            phaser.frequencyIn <- clampPhaserFrequencyHz (
                phaserFrequency * rackOctaveScale (octaveScalers[rackOctaveScalerPhaserFrequency],
                                                   rackModIn[rackModTargetPhaserFrequencyOctaves]));
            phaser.feedbackIn <- clampPhaserFeedback (
                rackModulateLinear (phaserFeedback, rackModIn[rackModTargetPhaserFeedback]));
            phaser.phaseIn <- clampPhaserPhaseDeg (
                rackModulateLinear (phaserPhase, rackModIn[rackModTargetPhaserPhase]));
            phaser.mixIn <- clampPhaserMix (
                rackModulateLinear (phaserMix, rackModIn[rackModTargetPhaserMix]));
            phaser.tempoBpmIn <- clampPhaserTempoBpm (tempoBpmIn);

            // --- Delay -----------------------------------------------------
            delay.timeMsIn <- clampDelayTimeMs (
                delayTime * rackOctaveScale (octaveScalers[rackOctaveScalerDelayTime],
                                             rackModIn[rackModTargetDelayTimeOctaves]));
            delay.timeModeIn <- delayTimeMode;
            delay.divisionIn <- delayDivision;
            delay.feedbackIn <- clampDelayFeedback (
                rackModulateLinear (delayFeedback, rackModIn[rackModTargetDelayFeedback]));
            delay.filterHzIn <- clampDelayFilterHz (
                delayFilter * rackOctaveScale (octaveScalers[rackOctaveScalerDelayFilter],
                                               rackModIn[rackModTargetDelayFilterOctaves]));
            delay.mixIn <- clampDelayMix (
                rackModulateLinear (delayMix, rackModIn[rackModTargetDelayMix]));
            delay.tempoBpmIn <- clampDelayTempoBpm (tempoBpmIn);

            // --- Reverb ----------------------------------------------------
            reverb.sizeIn <- rackModulateLinear (reverbSize, rackModIn[rackModTargetReverbSize]);
            reverb.decayIn <- rackModulateLinear (reverbDecay, rackModIn[rackModTargetReverbDecay]);
            reverb.dampingIn <- rackModulateLinear (reverbDamping, rackModIn[rackModTargetReverbDamping]);
            reverb.mixIn <- rackModulateLinear (reverbMix, rackModIn[rackModTargetReverbMix]);

            // --- Lane pool -------------------------------------------------
            // Each pool instance mirrors its base module's forwarding exactly:
            // per-slot parameter record composed with the pool block of the
            // one rackMod bus, through the same clamps, octave conventions,
            // and helper functions. `pp` is the slot's parameter record.

            {
                let pp = poolSlotParams[wrap<lanePoolSlotCount> (laneSlotGlobalFilterTwo - rackModuleCount)];
                globalFilterTwo.modeIn <- pp[laneGlobalFilterParamMode];
                globalFilterTwo.cutoffHzIn <- clampFilterCutoffHz (
                    pp[laneGlobalFilterParamCutoffHz]
                        * rackOctaveScale (octaveScalers[rackOctaveScalerLaneGlobalFilterCutoff],
                                           rackModIn[rackModTargetLaneGlobalFilterCutoffOctaves]),
                    sampleRate);
                globalFilterTwo.resonanceIn <- clampFilterQ (
                    rackModulateLinear (pp[laneGlobalFilterParamResonance],
                                        rackModIn[rackModTargetLaneGlobalFilterResonance]));
                globalFilterTwo.driveIn <- clampGlobalFilterDrive (
                    rackModulateLinear (pp[laneGlobalFilterParamDrive],
                                        rackModIn[rackModTargetLaneGlobalFilterDrive]));
            }

            {
                let pp = poolSlotParams[wrap<lanePoolSlotCount> (laneSlotDistortionTwo - rackModuleCount)];
                let laneWetHPHz = clampDistortionWetHPHz (
                    pp[laneDistortionParamWetHPHz]
                        * rackOctaveScale (octaveScalers[rackOctaveScalerLaneDistortionWetHP],
                                           rackModIn[rackModTargetLaneDistortionWetHPOctaves]));
                distortionTwo.modeIn <- pp[laneDistortionParamMode];
                distortionTwo.driveDbIn <- clampDistortionDriveDb (
                    rackModulateLinear (pp[laneDistortionParamDriveDb],
                                        rackModIn[rackModTargetLaneDistortionDriveDb]));
                distortionTwo.kneeIn <- clampDistortionKnee (
                    rackModulateLinear (pp[laneDistortionParamKnee],
                                        rackModIn[rackModTargetLaneDistortionKnee]));
                distortionTwo.wetIn <- clampDistortionWet (
                    rackModulateLinear (pp[laneDistortionParamWet],
                                        rackModIn[rackModTargetLaneDistortionWet]));
                distortionTwo.wetHPHzIn <- laneWetHPHz;
                distortionTwo.wetLPHzIn <- clampDistortionWetLPHz (
                    pp[laneDistortionParamWetLPHz]
                        * rackOctaveScale (octaveScalers[rackOctaveScalerLaneDistortionWetLP],
                                           rackModIn[rackModTargetLaneDistortionWetLPOctaves]),
                    laneWetHPHz);
            }

            {
                let pp = poolSlotParams[wrap<lanePoolSlotCount> (laneSlotOttTwo - rackModuleCount)];
                ottTwo.mixIn <- ottClampMixPercent (
                    rackModulateLinear (pp[laneOttParamMix], rackModIn[rackModTargetLaneOttMix]));
                ottTwo.amountIn <- ottClampAmountPercent (
                    rackModulateLinear (pp[laneOttParamAmount], rackModIn[rackModTargetLaneOttAmount]));
                ottTwo.timePercentIn <- ottClampTimePercent (
                    rackModulateLinear (pp[laneOttParamTimePercent], rackModIn[rackModTargetLaneOttTimePercent]));
                ottTwo.bandDriveIn <- ottClampBandDrivePercent (
                    rackModulateLinear (pp[laneOttParamBandDrive], rackModIn[rackModTargetLaneOttBandDrive]));
                ottTwo.envelopeMatchIn <- ottClampEnvelopeMatchPercent (
                    rackModulateLinear (pp[laneOttParamEnvelopeMatch], rackModIn[rackModTargetLaneOttEnvelopeMatch]));
            }

            {
                let pp = poolSlotParams[wrap<lanePoolSlotCount> (laneSlotChorusTwo - rackModuleCount)];
                chorusTwo.enabledIn <- 1.0f;
                chorusTwo.mixIn <- rackModulateLinear (pp[laneChorusParamMix], rackModIn[rackModTargetLaneChorusMix]);
                chorusTwo.motionModeIn <- pp[laneChorusParamMotionMode];
                chorusTwo.bloomModeIn <- pp[laneChorusParamBloomMode];
                chorusTwo.toneIn <- rackModulateLinear (pp[laneChorusParamTone], rackModIn[rackModTargetLaneChorusTone]);
                chorusTwo.feedbackIn <- rackModulateLinear (pp[laneChorusParamFeedback],
                                                            rackModIn[rackModTargetLaneChorusFeedback]);
                chorusTwo.ringAmountIn <- rackModulateLinear (pp[laneChorusParamRingAmount],
                                                              rackModIn[rackModTargetLaneChorusRingAmount]);
                chorusTwo.ringOffsetModeIn <- pp[laneChorusParamRingOffsetMode];
                chorusTwo.ringFineSemitonesIn <- rackModulateLinear (pp[laneChorusParamRingFineSemitones],
                                                                     rackModIn[rackModTargetLaneChorusRingFineSemitones]);
                chorusTwo.trackingPitchHzIn <- trackingPitchHzIn;
            }

            {
                let pp = poolSlotParams[wrap<lanePoolSlotCount> (laneSlotFlangerTwo - rackModuleCount)];
                flangerTwo.rateIn <- clampFlangerRateHz (
                    rackModulateLinear (pp[laneFlangerParamRate], rackModIn[rackModTargetLaneFlangerRate]));
                flangerTwo.depthIn <- clampFlangerDepth (
                    rackModulateLinear (pp[laneFlangerParamDepth], rackModIn[rackModTargetLaneFlangerDepth]));
                flangerTwo.feedbackIn <- clampFlangerFeedback (
                    rackModulateLinear (pp[laneFlangerParamFeedback], rackModIn[rackModTargetLaneFlangerFeedback]));
                flangerTwo.mixIn <- clampFlangerMix (
                    rackModulateLinear (pp[laneFlangerParamMix], rackModIn[rackModTargetLaneFlangerMix]));
            }

            {
                let pp = poolSlotParams[wrap<lanePoolSlotCount> (laneSlotPhaserTwo - rackModuleCount)];
                phaserTwo.rateIn <- clampPhaserRateHz (
                    rackModulateLinear (pp[lanePhaserParamRate], rackModIn[rackModTargetLanePhaserRate]));
                phaserTwo.rateModeIn <- pp[lanePhaserParamRateMode];
                phaserTwo.rateDivisionIn <- pp[lanePhaserParamRateDivision];
                phaserTwo.depthIn <- clampPhaserDepth (
                    rackModulateLinear (pp[lanePhaserParamDepth], rackModIn[rackModTargetLanePhaserDepth]));
                phaserTwo.frequencyIn <- clampPhaserFrequencyHz (
                    pp[lanePhaserParamFrequency]
                        * rackOctaveScale (octaveScalers[rackOctaveScalerLanePhaserFrequency],
                                           rackModIn[rackModTargetLanePhaserFrequencyOctaves]));
                phaserTwo.feedbackIn <- clampPhaserFeedback (
                    rackModulateLinear (pp[lanePhaserParamFeedback], rackModIn[rackModTargetLanePhaserFeedback]));
                phaserTwo.phaseIn <- clampPhaserPhaseDeg (
                    rackModulateLinear (pp[lanePhaserParamPhase], rackModIn[rackModTargetLanePhaserPhase]));
                phaserTwo.mixIn <- clampPhaserMix (
                    rackModulateLinear (pp[lanePhaserParamMix], rackModIn[rackModTargetLanePhaserMix]));
                phaserTwo.tempoBpmIn <- clampPhaserTempoBpm (tempoBpmIn);
            }

            {
                let pp = poolSlotParams[wrap<lanePoolSlotCount> (laneSlotDelayTwo - rackModuleCount)];
                delayTwo.timeMsIn <- clampDelayTimeMs (
                    pp[laneDelayParamTimeMs]
                        * rackOctaveScale (octaveScalers[rackOctaveScalerLaneDelayTime],
                                           rackModIn[rackModTargetLaneDelayTimeOctaves]));
                delayTwo.timeModeIn <- pp[laneDelayParamTimeMode];
                delayTwo.divisionIn <- pp[laneDelayParamDivision];
                delayTwo.feedbackIn <- clampDelayFeedback (
                    rackModulateLinear (pp[laneDelayParamFeedback], rackModIn[rackModTargetLaneDelayFeedback]));
                delayTwo.filterHzIn <- clampDelayFilterHz (
                    pp[laneDelayParamFilterHz]
                        * rackOctaveScale (octaveScalers[rackOctaveScalerLaneDelayFilter],
                                           rackModIn[rackModTargetLaneDelayFilterOctaves]));
                delayTwo.mixIn <- clampDelayMix (
                    rackModulateLinear (pp[laneDelayParamMix], rackModIn[rackModTargetLaneDelayMix]));
                delayTwo.tempoBpmIn <- clampDelayTempoBpm (tempoBpmIn);
            }

            {
                let pp = poolSlotParams[wrap<lanePoolSlotCount> (laneSlotReverbTwo - rackModuleCount)];
                reverbTwo.sizeIn <- rackModulateLinear (pp[laneReverbParamSize], rackModIn[rackModTargetLaneReverbSize]);
                reverbTwo.decayIn <- rackModulateLinear (pp[laneReverbParamDecay], rackModIn[rackModTargetLaneReverbDecay]);
                reverbTwo.dampingIn <- rackModulateLinear (pp[laneReverbParamDamping], rackModIn[rackModTargetLaneReverbDamping]);
                reverbTwo.mixIn <- rackModulateLinear (pp[laneReverbParamMix], rackModIn[rackModTargetLaneReverbMix]);
            }
        }

        //----------------------------------------------------------------------
        // Dispatch.
        //
        // A disabled module is fed the LIVE chain signal - not silence - and is still
        // advanced, so its internal time never diverges from the rack's and its delay
        // lines hold the history they would have held. It simply contributes no wet
        // output and passes the signal through EXACTLY (ADR-005's hard audible bypass).

        float32<rackChannelCount> advanceModule (wrap<rackModuleCount> moduleId,
                                                 float32<rackChannelCount> signal,
                                                 bool isEnabled)
        {
            let selector = int32 (moduleId);

            if (! isEnabled && rackModuleSleepsWhileDisabled (selector))
                return signal;

            if (selector == rackModuleGlobalFilter)
            {
                globalFilter.in <- signal;
                globalFilter.advance();
                return isEnabled ? globalFilter.out : signal;
            }

            if (selector == rackModuleDistortion)
            {
                distortion.in <- signal;
                distortion.advance();
                return isEnabled ? distortion.out : signal;
            }

            if (selector == rackModuleOtt)
            {
                ott.in <- signal;
                ott.advance();
                return isEnabled ? ott.out : signal;
            }

            if (selector == rackModuleChorus)
            {
                chorus.in <- signal;
                chorus.advance();
                return isEnabled ? chorus.out : signal;
            }

            if (selector == rackModuleFlanger)
            {
                flanger.in <- signal;
                flanger.advance();
                return isEnabled ? flanger.out : signal;
            }

            if (selector == rackModulePhaser)
            {
                phaser.in <- signal;
                phaser.advance();
                return isEnabled ? phaser.out : signal;
            }

            if (selector == rackModuleDelay)
            {
                delay.in <- signal;
                delay.advance();
                return isEnabled ? delay.out : signal;
            }

            reverb.in <- signal;
            reverb.advance();
            return isEnabled ? reverb.out : signal;
        }

        float32<rackChannelCount> advanceLaneSlot (wrap<laneSlotCount> slotId,
                                                   float32<rackChannelCount> signal)
        {
            let selector = int32 (slotId);
            let isEnabled = currentLaneEnabled[slotId];

            if (selector < rackModuleCount)
                return advanceModule (wrap<rackModuleCount> (selector), signal, isEnabled);

            if (selector == laneSlotDelayTwo)
            {
                delayTwo.in <- signal;
                delayTwo.advance();
                return isEnabled ? delayTwo.out : signal;
            }

            if (selector == laneSlotGlobalFilterTwo)
            {
                globalFilterTwo.in <- signal;
                globalFilterTwo.advance();
                return isEnabled ? globalFilterTwo.out : signal;
            }

            if (selector == laneSlotDistortionTwo)
            {
                distortionTwo.in <- signal;
                distortionTwo.advance();
                return isEnabled ? distortionTwo.out : signal;
            }

            if (selector == laneSlotOttTwo)
            {
                ottTwo.in <- signal;
                ottTwo.advance();
                return isEnabled ? ottTwo.out : signal;
            }

            if (selector == laneSlotChorusTwo)
            {
                chorusTwo.in <- signal;
                chorusTwo.advance();
                return isEnabled ? chorusTwo.out : signal;
            }

            if (selector == laneSlotFlangerTwo)
            {
                flangerTwo.in <- signal;
                flangerTwo.advance();
                return isEnabled ? flangerTwo.out : signal;
            }

            if (selector == laneSlotPhaserTwo)
            {
                phaserTwo.in <- signal;
                phaserTwo.advance();
                return isEnabled ? phaserTwo.out : signal;
            }

            reverbTwo.in <- signal;
            reverbTwo.advance();
            return isEnabled ? reverbTwo.out : signal;
        }

        void main()
        {
            publishStructureDiagnostics();

            loop
            {
                forwardModuleParameters();

                var chain = in;

                if (laneChainActive)
                {
                    bool[laneSlotCount] advancedThisFrame;

                    for (wrap<maxLaneChainLength> position)
                    {
                        if (int32 (position) < currentLaneChainLength)
                        {
                            let slot = currentLaneChain[position];
                            chain = advanceLaneSlot (slot, chain);
                            advancedThisFrame[slot] = true;
                        }
                    }

                    // Time-base invariant: every resident BASE module advances
                    // exactly once per rack frame (idling on the live input, its
                    // output discarded). POOL slots sleep outside the chain — a
                    // device that does not exist yet costs nothing — and enter
                    // fresh via the commit-path reset.
                    for (wrap<laneSlotCount> slot)
                    {
                        if (! advancedThisFrame[slot] && int32 (slot) < rackModuleCount)
                        {
                            let idleOut = advanceLaneSlot (slot, in);
                        }
                    }
                }
                else
                {
                    for (wrap<rackModuleCount> position)
                        chain = advanceModule (currentOrder[position], chain,
                                               currentEnabled[currentOrder[position]]);

                    // Pool slots sleep until a lane topology commits them into a
                    // chain; a device that does not exist yet costs nothing.
                }

                let transition = nextTransitionGain();
                out <- float32<2> (
                    in[0] + ((chain[0] - in[0]) * transition),
                    in[1] + ((chain[1] - in[1]) * transition)
                );

                previewInputLeft <- distortion.previewInputLeft;
                previewInputRight <- distortion.previewInputRight;
                previewOutputLeft <- distortion.previewOutputLeft;
                previewOutputRight <- distortion.previewOutputRight;

                publishStructureDiagnostics();
                advance();
            }
        }
    }
}
