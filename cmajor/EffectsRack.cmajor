namespace wt
{
    //==============================================================================
    // The effects rack - eight resident effect instances advanced in a runtime-selected
    // serial order (ADR-001).
    //
    // THE SHAPE. This is a `processor`, not a `graph`. A graph's `connection` block
    // cannot express a runtime order: conditional connections need a compile-time
    // constant condition, so the 8! = 40320 orders are unreachable from a graph, and a
    // fixed-declaration-order routing bus would need a one-frame delay per hop, which
    // is a direct ADR-008 violation. Cmajor's documented processor composition does
    // express it exactly: the eight effects are resident `node`s, and main() drives
    // each one by hand with `child.in <- signal; child.advance(); read child.out`,
    // walking rack positions and dispatching on the effect id held in a runtime
    // wrap<8> array. The idiom is already used in this repo - wt::DistortionBus
    // hand-drives its two oversampled cores the same way (Distortion.cmajor:125-181).
    // The generated C++ inlines all eight children's state by value: no heap, no
    // indirection, no allocation, and in identity order the audio is bit-identical to
    // the equivalent static graph chain.
    //
    // THE ONE LOAD-BEARING INVARIANT. Every module must be advanced EXACTLY ONCE per
    // rack frame, whatever its position and whatever its enabled state. A module
    // advanced zero times silently re-emits its previous frame - no error, no crash,
    // just a corrupted time base - and nothing in the language enforces this. So the
    // rack validates that every uploaded order is a COMPLETE PERMUTATION and rejects
    // anything else outright (ADR-009), and a disabled module is still fed the live
    // chain signal and still advanced.
    //
    // ALWAYS-ADVANCE IS THE v1 DEFAULT, PENDING PROFILING - NOT A PROHIBITION.
    // ADR-005 is explicit that "whether a disabled child continues advancing is an
    // effect-local implementation and performance decision, not part of the public
    // rack-state model", and that "profiling, rather than rack architecture, determines
    // whether a sleep optimization is necessary". Always-advance is the honest starting
    // point because it cannot be wrong: no clock drifts, no delay line goes stale, and
    // re-enabling exposes no transient. It is also the worst case for CPU - a rack with
    // two modules enabled costs what a rack with eight costs - so it is a default with a
    // known bill, and rackModuleSleepsWhileDisabled() below is the single point where a
    // profiling pass changes it.
    //
    // WHAT THE RACK DOES NOT DO. It does not terminate the signal path. Fixed finishing
    // lives in wt::PolishBus, non-reorderable between rack.out and audioOut; overload
    // remains observable rather than hidden by a final limiter. Whole-lane Mix/Bypass
    // therefore remains upstream of Polish.
    //
    // INTEGRATION NOTES for whoever wires this into graph WavetableSynth:
    //   - Hoist with MODULE-PREFIX wildcards only (`input rack.distortion*;` and so on).
    //     A bare `input rack.*;` would also hoist `in`, `trackingPitchHzIn`,
    //     `tempoBpmIn`, `rackModIn` and the four preview streams.
    //   - laneTopology is the only structure gate for every device: chain membership
    //     plus the per-position enable mask. There is no other participation path.
    //     laneSolo is a transient merge-selection overlay and never changes that
    //     structure or resets a branch processor.
    //   - The distortion scope and history analyzers read the four preview streams
    //     forwarded below rather than reaching into wt::DistortionBus directly.
    //   - A composed processor cannot write to `console`, so every diagnostic here is a
    //     value output endpoint. That is the better design anyway: the iPhone UI can
    //     read back what the DSP is actually running instead of assuming its upload
    //     landed.
    //   - `rackModIn` carries the 36 reduced modulation offsets from
    //     wt::SharedVoiceEngine's `rackModOut` in ONE graph connection. The destination
    //     vocabulary and reduction rules live in VoiceReducer.cmajor; the engine runs
    //     only active instructions from its compiled sparse route program.
    //   - THE DEFAULT CHAIN IS EMPTY. This preserves the deployed pre-rack sound until
    //     the adapter restores the saved lane document. A device's host parameter
    //     default is never allowed to opt it into the audio path implicitly.

    let rackModuleCount = 8;
    let rackChannelCount = 2;

    // Effect instance ids. These are a WIRE CONTRACT with the adapter and with saved
    // patches: they identify an instance, never a position.
    let rackModuleGlobalFilter = 0;
    let rackModuleDistortion   = 1;
    let rackModuleOtt          = 2;
    let rackModuleChorus       = 3;
    let rackModuleFlanger      = 4;
    let rackModulePhaser       = 5;
    let rackModuleDelay        = 6;
    let rackModuleReverb       = 7;

    // ADR-003's 2-5 ms window. Long enough that the fade is inaudible, short enough
    // that dragging a module in the UI feels instant.
    let rackTransitionMs = 3.0f;

    // Three bits per rack position, packed least-significant-position-first, so the
    // committed order is one readable int32.
    let rackOrderCodeBitsPerPosition = 3;

    //==============================================================================
    // Effects Lane pool (M1). Slot ids EXTEND the module-id wire contract: ids
    // 0..rackModuleCount-1 are the base instances, ids above them are pool slots.
    // Slice 1 carries one pool slot (a second delay); the pool widens here as the
    // build proceeds.
    // Effects Lane pool sizing: lanePoolSetCount (FixedFrameOscillator.cmajor,
    // with the other shared wire constants) ADDITIONAL resident instances of
    // every type — physical-campaign evidence covers +4-each. Pool slot ids
    // extend the module-id wire contract in module order:
    // poolSlot(set, moduleId) = rackModuleCount + set*rackModuleCount + moduleId.
    let lanePoolSlotCount = lanePoolSetCount * rackModuleCount;
    let laneSlotCount = rackModuleCount + lanePoolSlotCount;

    // Set-0 aliases, used by tests and as readable documentation of the layout.
    let laneSlotGlobalFilterTwo = rackModuleCount + rackModuleGlobalFilter;
    let laneSlotDistortionTwo   = rackModuleCount + rackModuleDistortion;
    let laneSlotOttTwo          = rackModuleCount + rackModuleOtt;
    let laneSlotChorusTwo       = rackModuleCount + rackModuleChorus;
    let laneSlotFlangerTwo      = rackModuleCount + rackModuleFlanger;
    let laneSlotPhaserTwo       = rackModuleCount + rackModulePhaser;
    let laneSlotDelayTwo        = rackModuleCount + rackModuleDelay;
    let laneSlotReverbTwo       = rackModuleCount + rackModuleReverb;

    // The serial chain is capped independently of the slot domain: 16 placed
    // devices per chain keeps the topology upload inside the test harness's
    // proven composed-event size while the SLOT domain grows with the pool.
    let maxLaneChainLength = 16;

    //==============================================================================
    // Groups (M3 slices T1+T2). A group section is encoded IN PLACE in the
    // topology upload: each slotIds entry carries the slot id in its low byte
    // and a BRANCH TAG in the three bits above it, so the upload struct — and
    // its proven harness event size — is unchanged. A group is OPENED by a
    // MARKER SLOT — a utility unit placed in the chain like a device — whose
    // tag field carries the branch/band count N; the members that follow
    // carry tags 1..N, monotone non-decreasing with skips allowed (an empty
    // branch is representable). A trunk device (tag 0), the next marker, or
    // the chain's end closes the group. Branch outputs are SUMMED at the
    // merge (no per-branch level in v1; the post-lane Polish section owns finishing,
    // and overload glitching is the decided policy, not a governor's job).
    //
    // Markers are slots: single-use per chain, addressed by the same param
    // machinery (split markers own the crossover record), and their position
    // enable bit is the GROUP BYPASS — members and split filters still
    // advance on their branch signals (time bases never drift) while the
    // trunk hands the fork signal through. A group with no devices at all is
    // a hard passthrough too: placing structure never changes the sound.
    //
    // Tag grammar, validated and never coerced (the C11 rule): a member with
    // no open group, a tag above the marker's N, a decreasing tag, a marker
    // N outside 2..laneMaxBranchesPerGroup (parallel) or
    // 2..laneMaxBandsPerSplit (split), and any bit above the tag field
    // reject the upload whole.

    let laneBranchTagShift = 8;
    let laneBranchTagBits = 3;
    let laneBranchTagFieldMask = (1 << laneBranchTagBits) - 1;
    let laneSlotIdFieldMask = (1 << laneBranchTagShift) - 1;
    let laneMaxBranchesPerGroup = 4;
    let laneMaxBandsPerSplit = 3;

    // Marker slot ids extend the slot domain above the device pool: four
    // parallel units, then four split units. The CHAIN slot domain (what a
    // topology may reference and what params may address) is therefore wider
    // than the device pool.
    let laneParallelUnitCount = 4;
    let laneSplitUnitCount = 4;
    let laneParallelSlotBase = laneSlotCount;
    let laneSplitSlotBase = laneSlotCount + laneParallelUnitCount;
    let laneChainSlotCount = laneSlotCount + laneParallelUnitCount + laneSplitUnitCount;

    bool laneSlotIsGroupMarker (int32 slotId)   { return slotId >= laneSlotCount; }
    bool laneSlotIsSplitMarker (int32 slotId)   { return slotId >= laneSplitSlotBase; }

    // Split-type marker slots' param vocabulary: the crossover frequencies,
    // Linkwitz-Riley LR4 (doubled second-order sections, 24 dB/oct, minimum
    // phase, zero latency — Andrew's 2026-08-23 call, superseding the
    // linear-phase FIR idea). Ascending band order: tag 1 is low.
    let laneSplitParamXoverLowHz  = 0;
    let laneSplitParamXoverHighHz = 1;
    let laneSplitParamXoverLowKeyTrackEnabled = 2;
    let laneSplitParamXoverLowKeyTrackOffsetSemitones = 3;
    let laneSplitParamXoverHighKeyTrackEnabled = 4;
    let laneSplitParamXoverHighKeyTrackOffsetSemitones = 5;

    let laneSplitXoverMinHz = 40.0f;
    let laneSplitXoverMaxHz = 18000.0f;

    // Ordinary crossover Hz glides in its deployed domain. Key Track state and
    // offsets snap here, then the converted/clamped frequency is smoothed.
    int32 laneUtilitySlotParamRampFrames (int32 paramIndex)
    {
        return paramIndex == laneSplitParamXoverLowHz
            || paramIndex == laneSplitParamXoverHighHz ? 64 : 0;
    }

    float32 laneClampSplitXoverHz (float32 hz)
    {
        return std::intrinsics::clamp (hz, laneSplitXoverMinHz, laneSplitXoverMaxHz);
    }

    // The stdlib crossover IS the decided LR4 form: low = LP2², high = its
    // 2nd-order allpass minus low, so each edge is 24 dB/oct and the two
    // bands sum to that allpass exactly — flat magnitude, zero latency. The
    // frame type matches the rack bus (rackChannelCount = 2).
    namespace laneSplitFilters = std::filters (float32<2>, float64, 32);

    int32 laneEncodeSlotWithBranchTag (int32 slotId, int32 branchTag)
    {
        return slotId | (branchTag << laneBranchTagShift);
    }

    int32 laneDecodeSlotId (int32 encoded)
    {
        return encoded & laneSlotIdFieldMask;
    }

    int32 laneDecodeBranchTag (int32 encoded)
    {
        return (encoded >> laneBranchTagShift) & laneBranchTagFieldMask;
    }

    // Per-slot parameter records travel in LaneSlotParamsUpload.values; each pool
    // slot type documents its own value vocabulary below (indices into `values`).
    let laneSlotParamCount = 12;

    // Delay-type pool slots.
    let laneDelayParamTimeMs   = 0;
    let laneDelayParamFeedback = 1;
    let laneDelayParamFilterHz = 2;
    let laneDelayParamMix      = 3;
    let laneDelayParamTimeMode = 4;
    let laneDelayParamDivision = 5;
    let laneDelayParamTimeKeyTrackEnabled = 6;
    let laneDelayParamTimeKeyTrackOffsetSemitones = 7;
    let laneDelayParamFilterKeyTrackEnabled = 8;
    let laneDelayParamFilterKeyTrackOffsetSemitones = 9;

    // GlobalFilter-type pool slots.
    let laneGlobalFilterParamMode      = 0;
    let laneGlobalFilterParamCutoffHz  = 1;
    let laneGlobalFilterParamResonance = 2;
    let laneGlobalFilterParamDrive     = 3;
    let laneGlobalFilterParamCutoffKeyTrackEnabled = 4;
    let laneGlobalFilterParamCutoffKeyTrackOffsetSemitones = 5;

    // Distortion-type pool slots.
    let laneDistortionParamMode    = 0;
    let laneDistortionParamDriveDb = 1;
    let laneDistortionParamKnee    = 2;
    let laneDistortionParamWet     = 3;
    let laneDistortionParamWetHPHz = 4;
    let laneDistortionParamWetLPHz = 5;
    let laneDistortionParamType    = 6;
    let laneDistortionParamWetHPKeyTrackEnabled = 7;
    let laneDistortionParamWetHPKeyTrackOffsetSemitones = 8;
    let laneDistortionParamWetLPKeyTrackEnabled = 9;
    let laneDistortionParamWetLPKeyTrackOffsetSemitones = 10;

    // OTT-type pool slots.
    let laneOttParamMix           = 0;
    let laneOttParamAmount        = 1;
    let laneOttParamTimePercent   = 2;
    let laneOttParamBandDrive     = 3;
    let laneOttParamEnvelopeMatch = 4;

    // Chorus-type pool slots.
    let laneChorusParamMix               = 0;
    let laneChorusParamMotionMode        = 1;
    let laneChorusParamBloomMode         = 2;
    let laneChorusParamTone              = 3;
    let laneChorusParamFeedback          = 4;
    let laneChorusParamRingAmount        = 5;
    let laneChorusParamRingOffsetMode    = 6;
    let laneChorusParamRingFineSemitones = 7;
    let laneChorusParamRingFrequencyHz = 8;
    let laneChorusParamRingKeyTrackEnabled = 9;
    let laneChorusParamRingKeyTrackOffsetSemitones = 10;
    let laneChorusParamRingLegacyClampEnabled = 11;

    // Flanger-type pool slots.
    let laneFlangerParamRate     = 0;
    let laneFlangerParamDepth    = 1;
    let laneFlangerParamFeedback = 2;
    let laneFlangerParamMix      = 3;
    let laneFlangerParamBaseDelayMs = 4;
    let laneFlangerParamBaseDelayKeyTrackEnabled = 5;
    let laneFlangerParamBaseDelayKeyTrackOffsetSemitones = 6;

    // Phaser-type pool slots.
    let lanePhaserParamRate         = 0;
    let lanePhaserParamRateMode     = 1;
    let lanePhaserParamRateDivision = 2;
    let lanePhaserParamDepth        = 3;
    let lanePhaserParamFrequency    = 4;
    let lanePhaserParamFeedback     = 5;
    let lanePhaserParamPhase        = 6;
    let lanePhaserParamMix          = 7;
    let lanePhaserParamFrequencyKeyTrackEnabled = 8;
    let lanePhaserParamFrequencyKeyTrackOffsetSemitones = 9;

    // Reverb-type pool slots.
    let laneReverbParamSize    = 0;
    let laneReverbParamDecay   = 1;
    let laneReverbParamDamping = 2;
    let laneReverbParamMix     = 3;

    // Host-style parameter smoothing for pool records, mirroring each base
    // endpoint's rampFrames annotation EXACTLY (the annotations are inert on
    // composed children, so the rack owns the ramp). 0 = snap: discrete
    // modes/divisions, and the delay's time, which the module glides itself.
    // Rows follow the pool-slot order (delay, globalFilter, distortion, ott,
    // chorus, flanger, phaser, reverb); columns are the type's param indices.
    int32[rackModuleCount, laneSlotParamCount] laneSlotParamRampFrames()
    {
        int32[rackModuleCount, laneSlotParamCount] table;

        // Rows are MODULE ids (a pool slot's type = (slot - base) % 8).
        // globalFilter: mode 0, cutoff 64, resonance 64, drive 64
        table[wrap<rackModuleCount> (rackModuleGlobalFilter), 1] = 64;
        table[wrap<rackModuleCount> (rackModuleGlobalFilter), 2] = 64;
        table[wrap<rackModuleCount> (rackModuleGlobalFilter), 3] = 64;
        // distortion: mode/type 0, driveDb 64, knee 64, wet 64, wetHP 64, wetLP 64
        table[wrap<rackModuleCount> (rackModuleDistortion), 1] = 64;
        table[wrap<rackModuleCount> (rackModuleDistortion), 2] = 64;
        table[wrap<rackModuleCount> (rackModuleDistortion), 3] = 64;
        table[wrap<rackModuleCount> (rackModuleDistortion), 4] = 64;
        table[wrap<rackModuleCount> (rackModuleDistortion), 5] = 64;
        // ott: all five 128
        table[wrap<rackModuleCount> (rackModuleOtt), 0] = 128;
        table[wrap<rackModuleCount> (rackModuleOtt), 1] = 128;
        table[wrap<rackModuleCount> (rackModuleOtt), 2] = 128;
        table[wrap<rackModuleCount> (rackModuleOtt), 3] = 128;
        table[wrap<rackModuleCount> (rackModuleOtt), 4] = 128;
        // chorus: mix 128, motion 0, bloom 0, tone 128, feedback 128,
        // ringAmount 128, legacy mode 0/fine 128, ordinary frequency 128.
        table[wrap<rackModuleCount> (rackModuleChorus), 0] = 128;
        table[wrap<rackModuleCount> (rackModuleChorus), 3] = 128;
        table[wrap<rackModuleCount> (rackModuleChorus), 4] = 128;
        table[wrap<rackModuleCount> (rackModuleChorus), 5] = 128;
        table[wrap<rackModuleCount> (rackModuleChorus), 7] = 128;
        table[wrap<rackModuleCount> (rackModuleChorus), 8] = 128;
        // flanger: rate 64, depth 64, feedback 64, mix 128
        table[wrap<rackModuleCount> (rackModuleFlanger), 0] = 64;
        table[wrap<rackModuleCount> (rackModuleFlanger), 1] = 64;
        table[wrap<rackModuleCount> (rackModuleFlanger), 2] = 64;
        table[wrap<rackModuleCount> (rackModuleFlanger), 3] = 128;
        // phaser: rate 64, rateMode 0, division 0, depth 64, frequency 64,
        // feedback 64, phase 64, mix 128
        table[wrap<rackModuleCount> (rackModulePhaser), 0] = 64;
        table[wrap<rackModuleCount> (rackModulePhaser), 3] = 64;
        table[wrap<rackModuleCount> (rackModulePhaser), 4] = 64;
        table[wrap<rackModuleCount> (rackModulePhaser), 5] = 64;
        table[wrap<rackModuleCount> (rackModulePhaser), 6] = 64;
        table[wrap<rackModuleCount> (rackModulePhaser), 7] = 128;
        // delay: timeMs 0 (module glides), feedback 64, filterHz 64, mix 128,
        // timeMode 0, division 0
        table[wrap<rackModuleCount> (rackModuleDelay), 1] = 64;
        table[wrap<rackModuleCount> (rackModuleDelay), 2] = 64;
        table[wrap<rackModuleCount> (rackModuleDelay), 3] = 128;
        // reverb: all four 128
        table[wrap<rackModuleCount> (rackModuleReverb), 0] = 128;
        table[wrap<rackModuleCount> (rackModuleReverb), 1] = 128;
        table[wrap<rackModuleCount> (rackModuleReverb), 2] = 128;
        table[wrap<rackModuleCount> (rackModuleReverb), 3] = 128;

        return table;
    }

    // Preserve the deployed untracked route law bit-for-bit. Existing
    // frequency/time destinations stay octave-backed and retain the 0.001
    // octave recompute threshold whenever Key Track is off.
    let rackOctaveEpsilon = 0.001f;
    let laneOctaveScalerGlobalFilterCutoff = 0;
    let laneOctaveScalerDistortionWetHP    = 1;
    let laneOctaveScalerDistortionWetLP    = 2;
    let laneOctaveScalerPhaserFrequency    = 3;
    let laneOctaveScalerDelayTime          = 4;
    let laneOctaveScalerDelayFilter        = 5;
    let laneOctaveScalerFlangerBaseDelay   = 6;
    let laneOctaveScalerBankSize           = 7;
    let rackOctaveScalerCount = lanePoolInstanceCount * laneOctaveScalerBankSize;

    //==============================================================================
    // The adapter's wire format. Order and enabled state are stored SEPARATELY
    // (ADR-009): moving a module must not change what is on, and turning a module off
    // must not move it.

    struct LaneTopologyUpload
    {
        int32 chainLength;
        int32[maxLaneChainLength] slotIds;
        // One bit per CHAIN POSITION (bit N = the device at position N is
        // enabled): position-indexed so the mask stays one int32 at any pool
        // size, and bypass is a property of a placed device.
        int32 enabledMask;
    }

    // Temporary audition state, intentionally separate from the topology
    // document. Each value is one-based (matching branch tags); zero means
    // that unit is not soloed. The fixed unit arrays let sequential groups
    // keep independent choices without changing or re-uploading the chain.
    struct LaneSoloUpload
    {
        int32[laneParallelUnitCount] parallelSoloBranches;
        int32[laneSplitUnitCount] splitSoloBranches;
    }

    // One pool slot's parameter record, addressed by slot id. The delivery
    // serial is the HOT PATH's acknowledgment contract: the rack echoes the
    // last APPLIED record's serial on laneParamsAcknowledgedSerial the same
    // frame it applies, so a live knob drag can measure edit-to-ack latency
    // end to end (rejected records echo nothing and count on the rejection
    // diagnostic instead).
    struct LaneSlotParamsUpload
    {
        int32 slotId;
        int32 deliverySerial;
        float32[laneSlotParamCount] values;
    }

    // One FIELD of one slot's record: the live-edit contract. A knob drag
    // sends single values, so concurrent surfaces editing different params
    // of the same device never race at record granularity; whole records
    // remain the bulk-restore path.
    struct LaneSlotParamValueUpload
    {
        int32 slotId;
        int32 paramIndex;
        int32 deliverySerial;
        float32 value;
    }

    // Whole-lane output controls are patch state, not host parameters. Mix is
    // stored independently from Bypass so releasing Bypass restores the exact
    // continuous value rather than replacing it with a binary surrogate.
    struct LaneOutputControlUpload
    {
        float32 mix;
        bool bypassed;
    }

    //==============================================================================
    // Structure validation. A malformed upload is a bug at the adapter boundary, not a
    // runtime state the rack may occupy, so both of these fail fast and the caller
    // leaves the running state completely untouched. Neither coerces.

    // A lane topology is validated, never coerced (the C11 rule): out-of-range
    // slot ids, duplicate slots, malformed marker/tag grammar, or non-flag
    // enables reject the whole upload and leave the running chain untouched.
    bool isValidLaneTopology (LaneTopologyUpload upload)
    {
        if (upload.chainLength < 0 || upload.chainLength > maxLaneChainLength)
            return false;

        bool[laneChainSlotCount] seen;
        var openGroupFanout = 0;   // 0 = no open group
        var lastMemberTag = 0;

        for (int32 position = 0; position < upload.chainLength; ++position)
        {
            let encoded = upload.slotIds.at (position);

            // Junk above the tag field (including any negative value) is
            // malformed, not ignorable.
            if ((encoded >> (laneBranchTagShift + laneBranchTagBits)) != 0)
                return false;

            let slotId = laneDecodeSlotId (encoded);
            let tag = laneDecodeBranchTag (encoded);

            if (slotId >= laneChainSlotCount)
                return false;

            if (laneSlotIsGroupMarker (slotId))
            {
                // A marker's tag is its branch/band count. It closes any open
                // group (empty branches are legal, so there is nothing to
                // check at a close) and opens its own.
                let maxFanout = laneSlotIsSplitMarker (slotId) ? laneMaxBandsPerSplit
                                                               : laneMaxBranchesPerGroup;

                if (tag < 2 || tag > maxFanout)
                    return false;

                openGroupFanout = tag;
                lastMemberTag = 0;
            }
            else if (tag == 0)
            {
                // A trunk device closes any open group.
                openGroupFanout = 0;
                lastMemberTag = 0;
            }
            else
            {
                // A member needs an open group, stays within its fan-out, and
                // never decreases — equal tags chain serially inside a
                // branch, and skipped tags leave those branches empty.
                if (openGroupFanout == 0)
                    return false;

                if (tag > openGroupFanout || tag < lastMemberTag)
                    return false;

                lastMemberTag = tag;
            }

            let index = wrap<laneChainSlotCount> (slotId);

            if (seen[index])
                return false;

            seen[index] = true;
        }

        // Mask bits above the chain length are malformed, not ignorable.
        if (upload.enabledMask < 0 || upload.enabledMask >= (1 << upload.chainLength))
            return false;

        return true;
    }

    bool isValidLaneSolo (LaneSoloUpload upload)
    {
        for (wrap<laneParallelUnitCount> unit)
            if (upload.parallelSoloBranches[unit] < 0
                 || upload.parallelSoloBranches[unit] > laneMaxBranchesPerGroup)
                return false;

        for (wrap<laneSplitUnitCount> unit)
            if (upload.splitSoloBranches[unit] < 0
                 || upload.splitSoloBranches[unit] > laneMaxBandsPerSplit)
                return false;

        return true;
    }


    //==============================================================================
    // Modulation application (ADR-012). The rack is the single point at which a
    // patch-owned base value meets a reduced modulation offset, so there is exactly one
    // place to look when a value is wrong.

    float32 rackModulateLinear (float32 base, float32 offset)
    {
        return base + offset;
    }

    struct RackOctaveScaler
    {
        float32 offsetOctaves;
        float32 scale;
    }

    float32 rackOctaveScale (RackOctaveScaler& scaler, float32 offsetOctaves)
    {
        if (std::intrinsics::abs (offsetOctaves - scaler.offsetOctaves) > rackOctaveEpsilon)
        {
            scaler.offsetOctaves = offsetOctaves;
            scaler.scale = std::intrinsics::pow (2.0f, offsetOctaves);
        }

        return scaler.scale;
    }

    //==============================================================================
    // C10: NO RACK CHILD MAY DECLARE processor.latency.
    //
    // A composed child's declared latency does NOT reach a composing PROCESSOR - a
    // child with processor.latency = 128 leaves its parent reporting 0
    // (transient/rack-dsp-poc/smoke05) - and it does not delay the audio either:
    // processor.latency is purely declarative, so composing a latency-declaring child
    // produces BIT-IDENTICAL samples to composing a clean one. Measured, not assumed.
    // A rack module that declared latency would therefore make the host's delay
    // compensation wrong with no audible and no readable symptom anywhere. That is
    // precisely the failure ADR-008 exists to prevent, and neither a test of the rack's
    // own latency nor any test of its audio can catch it.
    //
    // A GRAPH's latency, however, DOES sum its children's, and that is the lever. The
    // standing check lives in tests/cmajor_rack/RackShape.cmajtest: a probe graph
    // chaining all eight modules behind a one-frame latency witness, asserting the sum
    // is exactly one. It has to live in the test rather than here because the sum is
    // only a constant expression in a graph that is actually INSTANTIATED, and this
    // rack must not pay for eight extra module instances just to hold an assertion.

    // ADR-008 keeps every legal creative-rack layout zero-latency. This outer
    // blend therefore combines the current dry and wet frames directly. A future
    // latency-producing lane effect requires a separate rack/host architecture
    // decision; this processor deliberately does not pretend to align one.
    processor EffectsLaneOutputBlend
    {
        input stream float32<rackChannelCount> dryIn;
        input stream float32<rackChannelCount> wetIn;
        input stream float32 mixDepthIn;
        output stream float32<rackChannelCount> out;

        void main()
        {
            loop
            {
                let depth = std::intrinsics::clamp (mixDepthIn, 0.0f, 1.0f);
                out <- dryIn + ((wetIn - dryIn) * depth);
                advance();
            }
        }
    }

    //==============================================================================

    processor EffectsRack
    {
        //----------------------------------------------------------------------
        // Plumbing. None of this is hoisted to the host.

        input stream float32<rackChannelCount> in;
        input stream float32 trackingPitchHzIn;

        // The reduced voice-to-global modulation offsets, one per rack destination,
        // carried from wt::SharedVoiceEngine in a single graph connection. See
        // VoiceReducer.cmajor for the vocabulary and the reduction itself.
        input stream float32 rackModIn[rackModTargetCount];

        // Host transport tempo, for the phaser's and delay's sync modes. Declared the
        // way the modules declare theirs - no `name:`, so it is plumbing rather than a
        // creative parameter, and it is not covered by any module-prefix hoist wildcard.
        // The graph should drive it from the host transport; unconnected it sits at 120,
        // which keeps the sync divisions meaningful in a standalone render.
        input value float32 tempoBpmIn [[ init: 120.0f ]];

        //----------------------------------------------------------------------
        // Lane control. Topology and parameter records are patch state (ADR-007),
        // while Solo is runtime-only audition state. These struct events carry no
        // parameter purpose, so none can become a host automation slot.

        input event LaneTopologyUpload laneTopology;
        input event LaneSoloUpload laneSolo;
        input event LaneSlotParamsUpload laneSlotParams;
        input event LaneSlotParamValueUpload laneSlotParamValue;
        input event LaneOutputControlUpload laneOutputControl;


        //----------------------------------------------------------------------

        output stream float32<rackChannelCount> out;

        // A resident module's own stream outputs stay reachable: the two analyzers that
        // today connect straight to wt::DistortionBus keep working once it lives inside
        // the rack, they just read these forwarded streams instead.
        output stream float32 previewInputLeft;
        output stream float32 previewInputRight;
        output stream float32 previewOutputLeft;
        output stream float32 previewOutputRight;

        // Diagnostics and state readback.
        // The committed CHAIN, packed for the readback: three bits per
        // position (valid while chains hold only ordinal-0 devices, i.e. the
        // rack.v1 document) plus the per-position enable mask.
        output value int32 laneCommittedChainLength;
        output value int32 laneCommittedChainCode;
        output value int32 laneCommittedPositionMask;
        // Committed branch tags, three bits per position: Lo carries
        // positions 0..9, Hi carries 10..15. Zero = an all-trunk (serial)
        // chain, so the pre-parallel readback shape is a strict subset.
        output value int32 laneCommittedBranchTagsLo;
        output value int32 laneCommittedBranchTagsHi;
        output value int32 laneCommittedGeneration;
        output value int32 laneRejectedUploadCount;
        output value int32 laneParamsAcknowledgedSerial;

        //----------------------------------------------------------------------
        // Exactly one stable instance of each effect (ADR-001 effect identity). The
        // declaration order below is also the compile-time default rack order.

        // UNIFORM instances (M2): one array of lanePoolInstanceCount per
        // type. Ordinal 0 is the (former) base instance — it still reads the
        // 45 annotated host parameters until the B3 parameter cut — and
        // ordinals 1.. are the pool sets (asleep outside the chain, entered
        // fresh through the commit-path reset).
        node globalFilterPool = wt::GlobalFilterBus[lanePoolInstanceCount];
        node distortionPool   = wt::DistortionBus[lanePoolInstanceCount];
        node ottPool          = wt::OttBus[lanePoolInstanceCount];
        node chorusPool       = wt::ChorusBus[lanePoolInstanceCount];
        node flangerPool      = wt::FlangerBus[lanePoolInstanceCount];
        node phaserPool       = wt::PhaserBus[lanePoolInstanceCount];
        node delayPool        = wt::DelayBus[lanePoolInstanceCount];
        node reverbPool       = wt::ReverbBus[lanePoolInstanceCount];

        // Every currently legal lane child and split layout is zero-latency
        // (ADR-008), so the whole-lane dry/wet blend is same-frame.
        node laneOutputBlend = EffectsLaneOutputBlend;

        // NO processor.latency DECLARATION HERE, and there must never be one: every dry
        // path through the rack is bit-exact and no module has lookahead (ADR-008). It
        // cannot be pinned with a static_assert on this processor - `processor.latency`
        // is not a constant expression inside a processor that declares nodes ("error:
        // Expected a constant value") - so the rack is included in the latency probe
        // graph in tests/cmajor_rack/RackShape.cmajtest instead, where a graph's summed
        // latency does resolve.

        let transitionFrames = int32 (std::intrinsics::max (1.0f,
                                        float32 (processor.frequency) * rackTransitionMs * 0.001f));

        bool hasPendingTransition;
        float32 transitionGain = 1.0f;
        int32 currentPositionMask;
        int32 pendingPositionMask;

        float32 laneStoredMix = 1.0f;
        bool laneOutputBypassed;
        float32 laneOutputMixCurrent = 1.0f;
        float32 laneOutputMixTarget = 1.0f;
        float32 laneOutputMixStep;
        int32 laneOutputMixFramesRemaining;

        // Lane chain state. Once a topology commits, the lane chain drives the
        // dispatch instead of the legacy order permutation. The slot domain
        // here is laneChainSlotCount: device slots plus the marker units.
        bool pendingLaneUpload;
        int32 currentLaneChainLength;
        int32 pendingLaneChainLength;
        wrap<laneChainSlotCount>[maxLaneChainLength] currentLaneChain;
        wrap<laneChainSlotCount>[maxLaneChainLength] pendingLaneChain;
        int32[maxLaneChainLength] currentLaneBranchTag;
        int32[maxLaneChainLength] pendingLaneBranchTag;
        bool[laneChainSlotCount] currentLaneEnabled;
        bool[laneChainSlotCount] pendingLaneEnabled;
        bool pendingLaneSoloUpload;
        int32[laneParallelUnitCount] currentParallelSoloBranches;
        int32[laneParallelUnitCount] pendingParallelSoloBranches;
        int32[laneSplitUnitCount] currentSplitSoloBranches;
        int32[laneSplitUnitCount] pendingSplitSoloBranches;
        int32 laneGeneration;
        int32 laneRejectedCount;
        int32 laneParamsSerial;
        float32[laneChainSlotCount, laneSlotParamCount] slotParams;
        // Host-style linear ramps toward the records (see the table above):
        // the CURRENT values the forwarding blocks actually read, plus each
        // cell's per-frame step and the target it was computed against.
        float32[laneChainSlotCount, laneSlotParamCount] slotParamCurrent;
        float32[laneChainSlotCount, laneSlotParamCount] slotParamStep;
        float32[laneChainSlotCount, laneSlotParamCount] slotParamKnownTarget;
        int32[rackModuleCount, laneSlotParamCount] slotParamRampTable;
        bool[laneChainSlotCount] slotInCurrentChain;

        // Post-conversion smoothing state. Ordinary values retain their
        // deployed ramps; these cells are only advanced while Key Track is on.
        let laneTrackedFrequencyGlobalFilter = 0;
        let laneTrackedFrequencyDistortionWetHP = 1;
        let laneTrackedFrequencyDistortionWetLP = 2;
        let laneTrackedFrequencyPhaser = 3;
        let laneTrackedFrequencyDelayFilter = 4;
        let laneTrackedFrequencyCount = 5;
        float32[lanePoolInstanceCount, laneTrackedFrequencyCount] trackedFrequencyHz;
        float32[lanePoolInstanceCount] trackedDelayTimeMs;
        float32[lanePoolInstanceCount] trackedFlangerBaseDelayMs;
        float32 keyTrackSmoothingCoefficientState;
        RackOctaveScaler[rackOctaveScalerCount] octaveScalers;

        // Split marker DSP (T2): per unit, the LR4 crossover tree plus the
        // low path's COMPENSATION ALLPASS. The 3-band tree splits low off
        // first, then splits the rest at the high crossover; the low path is
        // then rotated by the high crossover's own allpass so all three
        // bands share the tree's full phase response — the recombined
        // magnitude is exactly flat at ANY crossover spacing. State resets
        // when a unit enters the chain or changes band count; both land on
        // the transition's fully-dry frame.
        laneSplitFilters::crossover::Implementation[laneSplitUnitCount] splitXoverLow;
        laneSplitFilters::crossover::Implementation[laneSplitUnitCount] splitXoverHigh;
        laneSplitFilters::tpt::svf::Implementation[laneSplitUnitCount] splitCompensation;
        float32[laneSplitUnitCount] splitTunedLowHz;
        float32[laneSplitUnitCount] splitTunedHighHz;
        float32[laneSplitUnitCount, 2] splitTrackedFrequencyHz;
        RackOctaveScaler[laneSplitUnitCount, 2] splitOctaveScalers;
        int32[laneSplitUnitCount] currentSplitBandCount;

        // Per-frame group-walk scratch, held as members so the dispatch
        // helpers can share it (Cmajor has no closures). laneGroupKind
        // returns to 0 by the end of every frame's walk: every open group
        // closes at a trunk device, the next marker, or the chain's end.
        int32 laneGroupKind;          // 0 none, 1 parallel, 2 split
        bool laneGroupEnabled;
        int32 laneGroupBranchCount;
        int32 laneGroupMemberCount;
        int32 laneGroupSoloBranch;
        int32 laneRunBranch;
        float32<rackChannelCount> laneGroupInput;
        float32<rackChannelCount> laneBranchSignal;
        float32<rackChannelCount>[laneMaxBranchesPerGroup] laneGroupContributions;

        void init()
        {
            for (wrap<rackOctaveScalerCount> scaler)
                octaveScalers[scaler].scale = 1.0f;

            for (wrap<laneSplitUnitCount> unit)
                for (wrap<2> crossover)
                    splitOctaveScalers[unit, crossover].scale = 1.0f;

            slotParamRampTable = laneSlotParamRampFrames();
            keyTrackSmoothingCoefficientState = keyTrackOnePoleCoefficient (
                float32 (processor.frequency));
        }

        void resetTrackedKeyTrackStateForPoolDevice (wrap<lanePoolInstanceCount> ordinal,
                                                       int32 poolType)
        {
            if (poolType == rackModuleGlobalFilter)
                trackedFrequencyHz[ordinal, laneTrackedFrequencyGlobalFilter] = 0.0f;

            if (poolType == rackModuleDistortion)
            {
                trackedFrequencyHz[ordinal, laneTrackedFrequencyDistortionWetHP] = 0.0f;
                trackedFrequencyHz[ordinal, laneTrackedFrequencyDistortionWetLP] = 0.0f;
            }

            if (poolType == rackModuleFlanger)
                trackedFlangerBaseDelayMs[ordinal] = 0.0f;

            if (poolType == rackModulePhaser)
                trackedFrequencyHz[ordinal, laneTrackedFrequencyPhaser] = 0.0f;

            if (poolType == rackModuleDelay)
            {
                trackedDelayTimeMs[ordinal] = 0.0f;
                trackedFrequencyHz[ordinal, laneTrackedFrequencyDelayFilter] = 0.0f;
            }
        }

        // One frame of host-style linear ramping for every pool record cell.
        // A changed target recomputes the step; rampFrames 0 snaps; arrival
        // clamps exactly to the target so ramps terminate.
        void advanceSlotParamSmoothing()
        {
            for (wrap<laneChainSlotCount> slot)
            {
                // A slot outside the committed chain does no work: its ramps
                // snap to the record at commit-entry.
                if (! slotInCurrentChain[slot])
                    continue;

                for (wrap<laneSlotParamCount> param)
                {
                    let target = slotParams[slot, param];

                    if (target != slotParamKnownTarget[slot, param])
                    {
                        slotParamKnownTarget[slot, param] = target;
                        // The type table is device-shaped; marker slots take
                        // the utility row (crossovers glide like cutoffs).
                        let rampFrames = laneSlotIsGroupMarker (int32 (slot))
                                           ? laneUtilitySlotParamRampFrames (int32 (param))
                                           : slotParamRampTable[wrap<rackModuleCount> (int32 (slot) % rackModuleCount), param];

                        if (rampFrames <= 0)
                        {
                            slotParamCurrent[slot, param] = target;
                            slotParamStep[slot, param] = 0.0f;
                        }
                        else
                        {
                            slotParamStep[slot, param] =
                                (target - slotParamCurrent[slot, param]) / float32 (rampFrames);
                        }
                    }

                    let step = slotParamStep[slot, param];

                    if (step != 0.0f)
                    {
                        var next = slotParamCurrent[slot, param] + step;

                        if ((step > 0.0f && next >= target) || (step < 0.0f && next <= target))
                        {
                            next = target;
                            slotParamStep[slot, param] = 0.0f;
                        }

                        slotParamCurrent[slot, param] = next;
                    }
                }
            }
        }

        //----------------------------------------------------------------------
        // Lane control uploads.

        event laneTopology (LaneTopologyUpload upload)
        {
            if (! isValidLaneTopology (upload))
            {
                laneRejectedCount += 1;
                return;
            }

            pendingLaneChainLength = upload.chainLength;

            for (wrap<maxLaneChainLength> position)
            {
                var slotValue = 0;
                var tagValue = 0;

                if (int32 (position) < upload.chainLength)
                {
                    slotValue = laneDecodeSlotId (upload.slotIds[position]);
                    tagValue = laneDecodeBranchTag (upload.slotIds[position]);
                }

                pendingLaneChain[position] = wrap<laneChainSlotCount> (slotValue);
                pendingLaneBranchTag[position] = tagValue;
            }

            // Enable is position-indexed on the wire; store it per SLOT for
            // the dispatch (slots outside the chain never read their flag).
            // A marker slot's flag is its group's bypass.
            for (wrap<laneChainSlotCount> slot)
                pendingLaneEnabled[slot] = false;

            for (wrap<maxLaneChainLength> position)
                if (int32 (position) < upload.chainLength)
                    pendingLaneEnabled[wrap<laneChainSlotCount> (laneDecodeSlotId (upload.slotIds[position]))] =
                        ((upload.enabledMask >> int32 (position)) & 1) != 0;

            pendingPositionMask = upload.enabledMask;

            // Compared against the RUNNING structure so a redundant upload —
            // the adapter re-sends on every patch load — costs zero dipped
            // frames and burns no generation.
            var differs = pendingLaneChainLength != currentLaneChainLength
                          || pendingPositionMask != currentPositionMask;

            for (wrap<maxLaneChainLength> position)
                if (int32 (position) < pendingLaneChainLength
                     && (pendingLaneChain[position] != currentLaneChain[position]
                          || pendingLaneBranchTag[position] != currentLaneBranchTag[position]))
                    differs = true;

            for (wrap<laneChainSlotCount> slot)
                if (pendingLaneEnabled[slot] != currentLaneEnabled[slot])
                    differs = true;

            if (differs)
            {
                // Drives the shared ADR-003 transition; the commit swaps the
                // chain on the fully-dry frame exactly as a reorder does.
                pendingLaneUpload = true;
                hasPendingTransition = true;
            }
        }

        event laneSolo (LaneSoloUpload upload)
        {
            if (! isValidLaneSolo (upload))
            {
                laneRejectedCount += 1;
                return;
            }

            pendingParallelSoloBranches = upload.parallelSoloBranches;
            pendingSplitSoloBranches = upload.splitSoloBranches;

            var differs = false;

            for (wrap<laneParallelUnitCount> unit)
                if (pendingParallelSoloBranches[unit] != currentParallelSoloBranches[unit])
                    differs = true;

            for (wrap<laneSplitUnitCount> unit)
                if (pendingSplitSoloBranches[unit] != currentSplitSoloBranches[unit])
                    differs = true;

            // Solo is an interactive replacement, not a durable document
            // replay. A rapid tap back to the running choice therefore
            // cancels an uncommitted Solo change and lets the ramp reverse.
            pendingLaneSoloUpload = differs;
            hasPendingTransition = pendingLaneUpload || pendingLaneSoloUpload;
        }

        event laneSlotParams (LaneSlotParamsUpload upload)
        {
            // Parameter records apply immediately, like host parameter writes
            // once did; only STRUCTURE rides the transition ramp. Applying
            // acknowledges the record's serial the same frame. Marker slots
            // are addressable too: a split's crossovers are its record.
            if (upload.slotId >= 0 && upload.slotId < laneChainSlotCount)
            {
                slotParams[wrap<laneChainSlotCount> (upload.slotId)] = upload.values;
                laneParamsSerial = upload.deliverySerial;
                return;
            }

            laneRejectedCount += 1;
        }

        event laneSlotParamValue (LaneSlotParamValueUpload upload)
        {
            if (upload.slotId >= 0 && upload.slotId < laneChainSlotCount
                 && upload.paramIndex >= 0 && upload.paramIndex < laneSlotParamCount)
            {
                slotParams[wrap<laneChainSlotCount> (upload.slotId),
                               wrap<laneSlotParamCount> (upload.paramIndex)] = upload.value;
                laneParamsSerial = upload.deliverySerial;
                return;
            }

            laneRejectedCount += 1;
        }

        event laneOutputControl (LaneOutputControlUpload upload)
        {
            // Validate the transport exactly; NaN also fails these ordered
            // comparisons. The stored Mix changes only when an accepted event
            // carries a new Mix — Bypass merely selects an effective target of 0.
            if (! (upload.mix >= 0.0f && upload.mix <= 1.0f))
            {
                laneRejectedCount += 1;
                return;
            }

            laneStoredMix = upload.mix;
            laneOutputBypassed = upload.bypassed;
            laneOutputMixTarget = laneOutputBypassed ? 0.0f : laneStoredMix;

            if (laneOutputMixTarget == laneOutputMixCurrent)
            {
                laneOutputMixStep = 0.0f;
                laneOutputMixFramesRemaining = 0;
            }
            else
            {
                laneOutputMixStep = (laneOutputMixTarget - laneOutputMixCurrent)
                                      / float32 (transitionFrames);
                laneOutputMixFramesRemaining = transitionFrames;
            }
        }

        // Topology is compared against the RUNNING structure, never the previous
        // upload, so a redundant restore cannot cancel a real pending change. Solo
        // instead replaces its pending audition choice so a rapid toggle can cancel.
        void commitPendingRackState()
        {
            if (pendingLaneUpload)
            {
                bool[laneChainSlotCount] slotInPendingChain;
                int32[laneSplitUnitCount] pendingSplitBandCount;

                for (wrap<maxLaneChainLength> position)
                {
                    if (int32 (position) < pendingLaneChainLength)
                    {
                        slotInPendingChain[pendingLaneChain[position]] = true;

                        if (laneSlotIsSplitMarker (int32 (pendingLaneChain[position])))
                            pendingSplitBandCount[wrap<laneSplitUnitCount> (
                                int32 (pendingLaneChain[position]) - laneSplitSlotBase)] =
                                    pendingLaneBranchTag[position];
                    }
                }

                // A slot entering the chain is a newly created device: it
                // starts with empty audio memory, never a frozen tail from a
                // previous life. Reorders and bypass keep membership, so
                // tails still survive both (ADR-003 semantics carried over).
                for (wrap<laneChainSlotCount> slot)
                {
                    let selector = int32 (slot);

                    if (slotInPendingChain[slot] && ! slotInCurrentChain[slot])
                    {
                        // Ramps snap: a device entering the chain starts ON
                        // its record, never mid-glide toward it.
                        for (wrap<laneSlotParamCount> param)
                        {
                            slotParamCurrent[slot, param] = slotParams[slot, param];
                            slotParamKnownTarget[slot, param] = slotParams[slot, param];
                            slotParamStep[slot, param] = 0.0f;
                        }

                        // Marker slots are not pool devices; split state
                        // resets are handled per unit below.
                        if (selector < laneSlotCount)
                        {
                            let ordinal = wrap<lanePoolInstanceCount> (selector / rackModuleCount);
                            let poolType = selector % rackModuleCount;

                            resetTrackedKeyTrackStateForPoolDevice (ordinal, poolType);

                            if (poolType == rackModuleGlobalFilter)  globalFilterPool[ordinal].poolResetIn <- 1;
                            if (poolType == rackModuleDistortion)    distortionPool[ordinal].poolResetIn <- 1;
                            if (poolType == rackModuleOtt)           ottPool[ordinal].poolResetIn <- 1;
                            if (poolType == rackModuleChorus)        chorusPool[ordinal].poolResetIn <- 1;
                            if (poolType == rackModuleFlanger)       flangerPool[ordinal].poolResetIn <- 1;
                            if (poolType == rackModulePhaser)        phaserPool[ordinal].poolResetIn <- 1;
                            if (poolType == rackModuleDelay)         delayPool[ordinal].poolResetIn <- 1;
                            if (poolType == rackModuleReverb)        reverbPool[ordinal].poolResetIn <- 1;
                        }
                    }
                }

                // A split unit entering the chain — or re-entering with a new
                // band count — starts with fresh filter state. Clearing the
                // tuned frequencies forces a retune on the next forward pass
                // (zero is below the clamp floor, so it can never match).
                for (wrap<laneSplitUnitCount> unit)
                {
                    let pendingBands = pendingSplitBandCount[unit];

                    if (pendingBands != 0 && pendingBands != currentSplitBandCount[unit])
                    {
                        splitXoverLow[unit].reset();
                        splitXoverHigh[unit].reset();
                        splitCompensation[unit].reset();
                        splitTunedLowHz[unit] = 0.0f;
                        splitTunedHighHz[unit] = 0.0f;
                        splitTrackedFrequencyHz[unit, 0] = 0.0f;
                        splitTrackedFrequencyHz[unit, 1] = 0.0f;
                    }

                    currentSplitBandCount[unit] = pendingBands;
                }

                slotInCurrentChain = slotInPendingChain;
                currentLaneChainLength = pendingLaneChainLength;
                currentLaneChain = pendingLaneChain;
                currentLaneBranchTag = pendingLaneBranchTag;
                currentLaneEnabled = pendingLaneEnabled;
                currentPositionMask = pendingPositionMask;
                laneGeneration += 1;
                pendingLaneUpload = false;
            }

            if (pendingLaneSoloUpload)
            {
                currentParallelSoloBranches = pendingParallelSoloBranches;
                currentSplitSoloBranches = pendingSplitSoloBranches;
                pendingLaneSoloUpload = false;
            }

            hasPendingTransition = false;
        }

        int32 committedChainCode()
        {
            // Three bits per position: valid while chains hold only ordinal-0
            // devices (the rack.v1 document); the general readback arrives
            // with lane state.
            var code = 0;

            for (wrap<maxLaneChainLength> position)
                if (int32 (position) < currentLaneChainLength)
                    code |= int32 (currentLaneChain[position]) << (rackOrderCodeBitsPerPosition * int32 (position));

            return code;
        }

        int32 committedBranchTags (int32 firstPosition, int32 positionCount)
        {
            var packed = 0;

            for (wrap<maxLaneChainLength> position)
            {
                let offset = int32 (position) - firstPosition;

                if (offset >= 0 && offset < positionCount
                     && int32 (position) < currentLaneChainLength)
                    packed |= currentLaneBranchTag[position] << (laneBranchTagBits * offset);
            }

            return packed;
        }

        void publishStructureDiagnostics()
        {
            laneCommittedChainLength <- currentLaneChainLength;
            laneCommittedChainCode <- committedChainCode();
            laneCommittedPositionMask <- currentPositionMask;
            laneCommittedBranchTagsLo <- committedBranchTags (0, 10);
            laneCommittedBranchTagsHi <- committedBranchTags (10, 6);
            laneCommittedGeneration <- laneGeneration;
            laneRejectedUploadCount <- laneRejectedCount;
            laneParamsAcknowledgedSerial <- laneParamsSerial;
        }

        //----------------------------------------------------------------------
        // The ADR-003 transition: one rack-local processed-depth ramp.
        //
        // Fade the processed chain to the live dry input, commit topology and/or Solo
        // on that dry frame, then fade the running chain back in. Branch processors
        // keep advancing throughout, so a Solo switch never resets their state.
        //
        // An upload arriving mid-transition simply REVERSES THE RAMP, in either
        // direction, and can never strand a pending change: there is no phase to be
        // in and no counter to be halfway through. The recon's first attempt used a
        // two-phase counter state machine and lost the second of two rapid uploads;
        // this form is immune to that whole class.

        float32 nextTransitionGain()
        {
            let step = 1.0f / float32 (transitionFrames);

            if (hasPendingTransition)
            {
                transitionGain = std::intrinsics::max (0.0f, transitionGain - step);

                if (transitionGain == 0.0f)
                    commitPendingRackState();
            }
            else
            {
                transitionGain = std::intrinsics::min (1.0f, transitionGain + step);
            }

            return transitionGain;
        }

        // Every accepted Mix or Bypass edge gets a complete 3 ms linear ramp.
        // Retargeting mid-ramp starts another ramp from the current sample, so
        // rapid UI traffic never creates a discontinuity.
        float32 nextLaneOutputMix()
        {
            if (laneOutputMixFramesRemaining <= 0)
                return laneOutputMixCurrent;

            laneOutputMixFramesRemaining -= 1;

            if (laneOutputMixFramesRemaining == 0)
                laneOutputMixCurrent = laneOutputMixTarget;
            else
                laneOutputMixCurrent += laneOutputMixStep;

            return laneOutputMixCurrent;
        }

        //----------------------------------------------------------------------
        // Parameter forwarding.
        //
        // Hoisted-endpoint syntax is graph-only ("error: Expected a stream type
        // specifier" inside a processor), so every child parameter is written by hand
        // here. This is also the single point where a patch-owned base value meets its
        // reduced modulation offset. Every value is re-clamped by its module's own
        // clamp helper where one exists, because a modulated value can leave the
        // parameter's declared range; the modules that export none (Chorus, Reverb)
        // clamp every one of these internally.
        //
        // Endpoint access is statically restricted to code reachable from main(), so
        // dropping this call is a compile error rather than a silent regression.

        void forwardModuleParameters()
        {
            let sampleRate = float32 (processor.frequency);

            advanceSlotParamSmoothing();

            // Split markers: retune the crossover tree from the smoothed
            // record. Exact inequality is the epsilon here — a resting ramp
            // holds its target bit for bit, so tan() only recomputes while a
            // crossover is actually moving. The compensation allpass always
            // follows the HIGH crossover: it is that crossover's phase it
            // repays on the low path.
            for (wrap<laneSplitUnitCount> unit)
            {
                let slot = wrap<laneChainSlotCount> (laneSplitSlotBase + int32 (unit));
                let splitModBase = int32 (unit) * rackModStaticTargetCount;

                if (! slotInCurrentChain[slot])
                    continue;

                let lowKeyTrackEnabled = slotParamCurrent[slot, laneSplitParamXoverLowKeyTrackEnabled] >= 0.5f;
                let highKeyTrackEnabled = slotParamCurrent[slot, laneSplitParamXoverHighKeyTrackEnabled] >= 0.5f;
                let lowRouteOctaves = rackModIn[wrap<rackModTargetCount> (
                    splitModBase + rackModTargetFrequencySplitLowOctaves)];
                let highRouteOctaves = rackModIn[wrap<rackModTargetCount> (
                    splitModBase + rackModTargetFrequencySplitHighOctaves)];
                let lowTargetHz = lowKeyTrackEnabled
                    ? resolveKeyTrackedFrequencyHz (
                        1.0f,
                        slotParamCurrent[slot, laneSplitParamXoverLowHz],
                        trackingPitchHzIn,
                        slotParamCurrent[slot, laneSplitParamXoverLowKeyTrackOffsetSemitones],
                        lowRouteOctaves * 12.0f,
                        laneSplitXoverMinHz,
                        laneSplitXoverMaxHz)
                    : std::intrinsics::clamp (
                        slotParamCurrent[slot, laneSplitParamXoverLowHz]
                            * rackOctaveScale (splitOctaveScalers[unit, 0], lowRouteOctaves),
                        laneSplitXoverMinHz,
                        laneSplitXoverMaxHz);
                let highTargetHz = highKeyTrackEnabled
                    ? resolveKeyTrackedFrequencyHz (
                        1.0f,
                        slotParamCurrent[slot, laneSplitParamXoverHighHz],
                        trackingPitchHzIn,
                        slotParamCurrent[slot, laneSplitParamXoverHighKeyTrackOffsetSemitones],
                        highRouteOctaves * 12.0f,
                        laneSplitXoverMinHz,
                        laneSplitXoverMaxHz)
                    : std::intrinsics::clamp (
                        slotParamCurrent[slot, laneSplitParamXoverHighHz]
                            * rackOctaveScale (splitOctaveScalers[unit, 1], highRouteOctaves),
                        laneSplitXoverMinHz,
                        laneSplitXoverMaxHz);
                let lowHz = lowKeyTrackEnabled
                    ? advanceKeyTrackSmoothedValue (
                        splitTrackedFrequencyHz[unit, 0], lowTargetHz,
                        keyTrackSmoothingCoefficientState)
                    : lowTargetHz;
                let highHz = highKeyTrackEnabled
                    ? advanceKeyTrackSmoothedValue (
                        splitTrackedFrequencyHz[unit, 1], highTargetHz,
                        keyTrackSmoothingCoefficientState)
                    : highTargetHz;
                splitTrackedFrequencyHz[unit, 0] = lowHz;
                splitTrackedFrequencyHz[unit, 1] = highHz;

                if (lowHz != splitTunedLowHz[unit])
                {
                    splitXoverLow[unit].setFrequency (processor.frequency, float64 (lowHz));
                    splitTunedLowHz[unit] = lowHz;
                }

                if (highHz != splitTunedHighHz[unit])
                {
                    splitXoverHigh[unit].setFrequency (processor.frequency, float64 (highHz));
                    splitCompensation[unit].setFrequency (processor.frequency, float64 (highHz),
                                                          float64 (laneSplitFilters::defaultQ));
                    splitTunedHighHz[unit] = highHz;
                }
            }

            // ONE forwarding path for every ordinal. A slot's smoothed record
            // is composed with its ordinal's block of the one rackMod bus,
            // through the module's own clamps, octave conventions, and helper
            // functions. `pp` is the slot's smoothed record; slots outside the
            // committed chain cost nothing.

            for (wrap<lanePoolInstanceCount> ordinal)
            {
                let slotBase = int32 (ordinal) * rackModuleCount;
                let laneBase = int32 (ordinal) * rackModStaticTargetCount;
                let scalerBase = int32 (ordinal) * laneOctaveScalerBankSize;

                if (slotInCurrentChain[wrap<laneChainSlotCount> (slotBase + rackModuleGlobalFilter)])
                {
                    let pp = slotParamCurrent[wrap<laneChainSlotCount> (slotBase + rackModuleGlobalFilter)];
                    let keyTrackEnabled = pp[laneGlobalFilterParamCutoffKeyTrackEnabled] >= 0.5f;
                    let cutoffRouteOctaves = rackModIn[wrap<rackModTargetCount> (
                        laneBase + rackModTargetGlobalFilterCutoffOctaves)];
                    let cutoffTargetHz = keyTrackEnabled
                        ? resolveKeyTrackedFrequencyHz (
                            1.0f,
                            pp[laneGlobalFilterParamCutoffHz],
                            trackingPitchHzIn,
                            pp[laneGlobalFilterParamCutoffKeyTrackOffsetSemitones],
                            cutoffRouteOctaves * 12.0f,
                            filterCutoffMinHz,
                            std::intrinsics::min (filterCutoffMaxHz, sampleRate * 0.48f))
                        : clampFilterCutoffHz (
                            pp[laneGlobalFilterParamCutoffHz]
                                * rackOctaveScale (octaveScalers[wrap<rackOctaveScalerCount> (
                                    scalerBase + laneOctaveScalerGlobalFilterCutoff)], cutoffRouteOctaves),
                            sampleRate);
                    let cutoffHz = keyTrackEnabled
                        ? advanceKeyTrackSmoothedValue (
                            trackedFrequencyHz[ordinal, laneTrackedFrequencyGlobalFilter],
                            cutoffTargetHz,
                            keyTrackSmoothingCoefficientState)
                        : cutoffTargetHz;
                    trackedFrequencyHz[ordinal, laneTrackedFrequencyGlobalFilter] = cutoffHz;
                    globalFilterPool[ordinal].modeIn <- pp[laneGlobalFilterParamMode];
                    globalFilterPool[ordinal].cutoffHzIn <- cutoffHz;
                    globalFilterPool[ordinal].resonanceIn <- clampFilterQ (
                        rackModulateLinear (pp[laneGlobalFilterParamResonance],
                                            rackModIn[wrap<rackModTargetCount> (laneBase + rackModTargetGlobalFilterResonance)]));
                    globalFilterPool[ordinal].driveIn <- clampGlobalFilterDrive (
                        rackModulateLinear (pp[laneGlobalFilterParamDrive],
                                            rackModIn[wrap<rackModTargetCount> (laneBase + rackModTargetGlobalFilterDrive)]));
                }

                if (slotInCurrentChain[wrap<laneChainSlotCount> (slotBase + rackModuleDistortion)])
                {
                    let pp = slotParamCurrent[wrap<laneChainSlotCount> (slotBase + rackModuleDistortion)];
                    let wetHPKeyTrackEnabled = pp[laneDistortionParamWetHPKeyTrackEnabled] >= 0.5f;
                    let wetHPRouteOctaves = rackModIn[wrap<rackModTargetCount> (
                        laneBase + rackModTargetDistortionWetHPOctaves)];
                    let wetHPHzTarget = wetHPKeyTrackEnabled
                        ? resolveKeyTrackedFrequencyHz (
                            1.0f,
                            pp[laneDistortionParamWetHPHz],
                            trackingPitchHzIn,
                            pp[laneDistortionParamWetHPKeyTrackOffsetSemitones],
                            wetHPRouteOctaves * 12.0f,
                            distortionWetHPMinHz,
                            distortionWetHPMaxHz)
                        : clampDistortionWetHPHz (
                            pp[laneDistortionParamWetHPHz]
                                * rackOctaveScale (octaveScalers[wrap<rackOctaveScalerCount> (
                                    scalerBase + laneOctaveScalerDistortionWetHP)], wetHPRouteOctaves));
                    let laneWetHPHz = wetHPKeyTrackEnabled
                        ? advanceKeyTrackSmoothedValue (
                            trackedFrequencyHz[ordinal, laneTrackedFrequencyDistortionWetHP],
                            wetHPHzTarget,
                            keyTrackSmoothingCoefficientState)
                        : wetHPHzTarget;
                    trackedFrequencyHz[ordinal, laneTrackedFrequencyDistortionWetHP] = laneWetHPHz;
                    let wetLPKeyTrackEnabled = pp[laneDistortionParamWetLPKeyTrackEnabled] >= 0.5f;
                    let wetLPRouteOctaves = rackModIn[wrap<rackModTargetCount> (
                        laneBase + rackModTargetDistortionWetLPOctaves)];
                    let wetLPHzTarget = wetLPKeyTrackEnabled
                        ? resolveKeyTrackedFrequencyHz (
                            1.0f,
                            pp[laneDistortionParamWetLPHz],
                            trackingPitchHzIn,
                            pp[laneDistortionParamWetLPKeyTrackOffsetSemitones],
                            wetLPRouteOctaves * 12.0f,
                            distortionWetLPMinHz,
                            distortionWetLPMaxHz)
                        : clampDistortionWetLPHz (
                            pp[laneDistortionParamWetLPHz]
                                * rackOctaveScale (octaveScalers[wrap<rackOctaveScalerCount> (
                                    scalerBase + laneOctaveScalerDistortionWetLP)], wetLPRouteOctaves),
                            laneWetHPHz);
                    let laneWetLPHz = wetLPKeyTrackEnabled
                        ? advanceKeyTrackSmoothedValue (
                            trackedFrequencyHz[ordinal, laneTrackedFrequencyDistortionWetLP],
                            wetLPHzTarget,
                            keyTrackSmoothingCoefficientState)
                        : wetLPHzTarget;
                    trackedFrequencyHz[ordinal, laneTrackedFrequencyDistortionWetLP] = laneWetLPHz;
                    distortionPool[ordinal].modeIn <- pp[laneDistortionParamMode];
                    distortionPool[ordinal].typeIn <- pp[laneDistortionParamType];
                    distortionPool[ordinal].driveDbIn <- clampDistortionDriveDb (
                        rackModulateLinear (pp[laneDistortionParamDriveDb],
                                            rackModIn[wrap<rackModTargetCount> (laneBase + rackModTargetDistortionDriveDb)]));
                    distortionPool[ordinal].kneeIn <- clampDistortionKnee (
                        rackModulateLinear (pp[laneDistortionParamKnee],
                                            rackModIn[wrap<rackModTargetCount> (laneBase + rackModTargetDistortionKnee)]));
                    distortionPool[ordinal].wetIn <- clampDistortionWet (
                        rackModulateLinear (pp[laneDistortionParamWet],
                                            rackModIn[wrap<rackModTargetCount> (laneBase + rackModTargetDistortionWet)]));
                    distortionPool[ordinal].wetHPHzIn <- laneWetHPHz;
                    distortionPool[ordinal].wetLPHzIn <- clampDistortionWetLPHz (
                        laneWetLPHz, laneWetHPHz);
                }

                if (slotInCurrentChain[wrap<laneChainSlotCount> (slotBase + rackModuleOtt)])
                {
                    let pp = slotParamCurrent[wrap<laneChainSlotCount> (slotBase + rackModuleOtt)];
                    ottPool[ordinal].mixIn <- ottClampMixPercent (
                        rackModulateLinear (pp[laneOttParamMix],
                                            rackModIn[wrap<rackModTargetCount> (laneBase + rackModTargetOttMix)]));
                    ottPool[ordinal].amountIn <- ottClampAmountPercent (
                        rackModulateLinear (pp[laneOttParamAmount],
                                            rackModIn[wrap<rackModTargetCount> (laneBase + rackModTargetOttAmount)]));
                    ottPool[ordinal].timePercentIn <- ottClampTimePercent (
                        rackModulateLinear (pp[laneOttParamTimePercent],
                                            rackModIn[wrap<rackModTargetCount> (laneBase + rackModTargetOttTimePercent)]));
                    ottPool[ordinal].bandDriveIn <- ottClampBandDrivePercent (
                        rackModulateLinear (pp[laneOttParamBandDrive],
                                            rackModIn[wrap<rackModTargetCount> (laneBase + rackModTargetOttBandDrive)]));
                    ottPool[ordinal].envelopeMatchIn <- ottClampEnvelopeMatchPercent (
                        rackModulateLinear (pp[laneOttParamEnvelopeMatch],
                                            rackModIn[wrap<rackModTargetCount> (laneBase + rackModTargetOttEnvelopeMatch)]));
                }

                if (slotInCurrentChain[wrap<laneChainSlotCount> (slotBase + rackModuleChorus)])
                {
                    let pp = slotParamCurrent[wrap<laneChainSlotCount> (slotBase + rackModuleChorus)];
                    chorusPool[ordinal].enabledIn <- 1.0f;
                    chorusPool[ordinal].mixIn <- rackModulateLinear (pp[laneChorusParamMix],
                        rackModIn[wrap<rackModTargetCount> (laneBase + rackModTargetChorusMix)]);
                    chorusPool[ordinal].motionModeIn <- pp[laneChorusParamMotionMode];
                    chorusPool[ordinal].bloomModeIn <- pp[laneChorusParamBloomMode];
                    chorusPool[ordinal].toneIn <- rackModulateLinear (pp[laneChorusParamTone],
                        rackModIn[wrap<rackModTargetCount> (laneBase + rackModTargetChorusTone)]);
                    chorusPool[ordinal].feedbackIn <- rackModulateLinear (pp[laneChorusParamFeedback],
                        rackModIn[wrap<rackModTargetCount> (laneBase + rackModTargetChorusFeedback)]);
                    chorusPool[ordinal].ringAmountIn <- rackModulateLinear (pp[laneChorusParamRingAmount],
                        rackModIn[wrap<rackModTargetCount> (laneBase + rackModTargetChorusRingAmount)]);
                    chorusPool[ordinal].ringFrequencyHzIn <- pp[laneChorusParamRingFrequencyHz];
                    chorusPool[ordinal].ringKeyTrackEnabledIn <- pp[laneChorusParamRingKeyTrackEnabled];
                    chorusPool[ordinal].ringKeyTrackOffsetSemitonesIn <- pp[laneChorusParamRingKeyTrackOffsetSemitones];
                    chorusPool[ordinal].ringLegacyClampEnabledIn <- pp[laneChorusParamRingLegacyClampEnabled];
                    chorusPool[ordinal].ringRouteOffsetSemitonesIn <-
                        rackModIn[wrap<rackModTargetCount> (laneBase + rackModTargetChorusRingFineSemitones)];
                    chorusPool[ordinal].ringOffsetModeIn <- pp[laneChorusParamRingOffsetMode];
                    chorusPool[ordinal].ringFineSemitonesIn <- pp[laneChorusParamRingFineSemitones];
                    chorusPool[ordinal].trackingPitchHzIn <- trackingPitchHzIn;
                }

                if (slotInCurrentChain[wrap<laneChainSlotCount> (slotBase + rackModuleFlanger)])
                {
                    let pp = slotParamCurrent[wrap<laneChainSlotCount> (slotBase + rackModuleFlanger)];
                    let baseDelayKeyTrackEnabled = pp[laneFlangerParamBaseDelayKeyTrackEnabled] >= 0.5f;
                    let baseDelayRouteOctaves = rackModIn[wrap<rackModTargetCount> (
                        laneBase + rackModTargetFlangerBaseDelayOctaves)];
                    let baseDelayTargetMs = baseDelayKeyTrackEnabled
                        ? resolveKeyTrackedPeriodMilliseconds (
                            1.0f,
                            pp[laneFlangerParamBaseDelayMs],
                            trackingPitchHzIn,
                            pp[laneFlangerParamBaseDelayKeyTrackOffsetSemitones],
                            baseDelayRouteOctaves * 12.0f,
                            flangerBaseDelayMinMs,
                            flangerBaseDelayMaxMs)
                        : std::intrinsics::clamp (
                            pp[laneFlangerParamBaseDelayMs]
                                * rackOctaveScale (octaveScalers[wrap<rackOctaveScalerCount> (
                                    scalerBase + laneOctaveScalerFlangerBaseDelay)], baseDelayRouteOctaves),
                            flangerBaseDelayMinMs,
                            flangerBaseDelayMaxMs);
                    let baseDelayMs = baseDelayKeyTrackEnabled
                        ? advanceKeyTrackSmoothedValue (
                            trackedFlangerBaseDelayMs[ordinal],
                            baseDelayTargetMs,
                            keyTrackSmoothingCoefficientState)
                        : baseDelayTargetMs;
                    trackedFlangerBaseDelayMs[ordinal] = baseDelayMs;
                    flangerPool[ordinal].baseDelayMsIn <- baseDelayMs;
                    flangerPool[ordinal].rateIn <- clampFlangerRateHz (
                        rackModulateLinear (pp[laneFlangerParamRate],
                                            rackModIn[wrap<rackModTargetCount> (laneBase + rackModTargetFlangerRate)]));
                    flangerPool[ordinal].depthIn <- clampFlangerDepth (
                        rackModulateLinear (pp[laneFlangerParamDepth],
                                            rackModIn[wrap<rackModTargetCount> (laneBase + rackModTargetFlangerDepth)]));
                    flangerPool[ordinal].feedbackIn <- clampFlangerFeedback (
                        rackModulateLinear (pp[laneFlangerParamFeedback],
                                            rackModIn[wrap<rackModTargetCount> (laneBase + rackModTargetFlangerFeedback)]));
                    flangerPool[ordinal].mixIn <- clampFlangerMix (
                        rackModulateLinear (pp[laneFlangerParamMix],
                                            rackModIn[wrap<rackModTargetCount> (laneBase + rackModTargetFlangerMix)]));
                }

                if (slotInCurrentChain[wrap<laneChainSlotCount> (slotBase + rackModulePhaser)])
                {
                    let pp = slotParamCurrent[wrap<laneChainSlotCount> (slotBase + rackModulePhaser)];
                    let frequencyKeyTrackEnabled = pp[lanePhaserParamFrequencyKeyTrackEnabled] >= 0.5f;
                    let phaserFrequencyRouteOctaves = rackModIn[wrap<rackModTargetCount> (
                        laneBase + rackModTargetPhaserFrequencyOctaves)];
                    let frequencyTargetHz = frequencyKeyTrackEnabled
                        ? resolveKeyTrackedFrequencyHz (
                            1.0f,
                            pp[lanePhaserParamFrequency],
                            trackingPitchHzIn,
                            pp[lanePhaserParamFrequencyKeyTrackOffsetSemitones],
                            phaserFrequencyRouteOctaves * 12.0f,
                            phaserFrequencyMinHz,
                            phaserFrequencyMaxHz)
                        : clampPhaserFrequencyHz (
                            pp[lanePhaserParamFrequency]
                                * rackOctaveScale (octaveScalers[wrap<rackOctaveScalerCount> (
                                    scalerBase + laneOctaveScalerPhaserFrequency)], phaserFrequencyRouteOctaves));
                    let frequencyHz = frequencyKeyTrackEnabled
                        ? advanceKeyTrackSmoothedValue (
                            trackedFrequencyHz[ordinal, laneTrackedFrequencyPhaser],
                            frequencyTargetHz,
                            keyTrackSmoothingCoefficientState)
                        : frequencyTargetHz;
                    trackedFrequencyHz[ordinal, laneTrackedFrequencyPhaser] = frequencyHz;
                    phaserPool[ordinal].rateIn <- clampPhaserRateHz (
                        rackModulateLinear (pp[lanePhaserParamRate],
                                            rackModIn[wrap<rackModTargetCount> (laneBase + rackModTargetPhaserRate)]));
                    phaserPool[ordinal].rateModeIn <- pp[lanePhaserParamRateMode];
                    phaserPool[ordinal].rateDivisionIn <- pp[lanePhaserParamRateDivision];
                    phaserPool[ordinal].depthIn <- clampPhaserDepth (
                        rackModulateLinear (pp[lanePhaserParamDepth],
                                            rackModIn[wrap<rackModTargetCount> (laneBase + rackModTargetPhaserDepth)]));
                    phaserPool[ordinal].frequencyIn <- frequencyHz;
                    phaserPool[ordinal].feedbackIn <- clampPhaserFeedback (
                        rackModulateLinear (pp[lanePhaserParamFeedback],
                                            rackModIn[wrap<rackModTargetCount> (laneBase + rackModTargetPhaserFeedback)]));
                    phaserPool[ordinal].phaseIn <- clampPhaserPhaseDeg (
                        rackModulateLinear (pp[lanePhaserParamPhase],
                                            rackModIn[wrap<rackModTargetCount> (laneBase + rackModTargetPhaserPhase)]));
                    phaserPool[ordinal].mixIn <- clampPhaserMix (
                        rackModulateLinear (pp[lanePhaserParamMix],
                                            rackModIn[wrap<rackModTargetCount> (laneBase + rackModTargetPhaserMix)]));
                    phaserPool[ordinal].tempoBpmIn <- clampPhaserTempoBpm (tempoBpmIn);
                }

                if (slotInCurrentChain[wrap<laneChainSlotCount> (slotBase + rackModuleDelay)])
                {
                    let pp = slotParamCurrent[wrap<laneChainSlotCount> (slotBase + rackModuleDelay)];
                    let timeKeyTrackEnabled = pp[laneDelayParamTimeKeyTrackEnabled] >= 0.5f;
                    let delayTimeRouteOctaves = rackModIn[wrap<rackModTargetCount> (
                        laneBase + rackModTargetDelayTimeOctaves)];
                    let trackedTimeTargetMs = timeKeyTrackEnabled
                        ? resolveKeyTrackedPeriodMilliseconds (
                            1.0f,
                            pp[laneDelayParamTimeMs],
                            trackingPitchHzIn,
                            pp[laneDelayParamTimeKeyTrackOffsetSemitones],
                            delayTimeRouteOctaves * 12.0f,
                            delayMinMs,
                            delayMaxMs)
                        : clampDelayTimeMs (
                            pp[laneDelayParamTimeMs]
                                * rackOctaveScale (octaveScalers[wrap<rackOctaveScalerCount> (
                                    scalerBase + laneOctaveScalerDelayTime)], delayTimeRouteOctaves));
                    let trackedTimeMs = timeKeyTrackEnabled
                        ? advanceKeyTrackSmoothedValue (
                            trackedDelayTimeMs[ordinal], trackedTimeTargetMs,
                            keyTrackSmoothingCoefficientState)
                        : trackedTimeTargetMs;
                    trackedDelayTimeMs[ordinal] = trackedTimeMs;
                    let filterKeyTrackEnabled = pp[laneDelayParamFilterKeyTrackEnabled] >= 0.5f;
                    let delayFilterRouteOctaves = rackModIn[wrap<rackModTargetCount> (
                        laneBase + rackModTargetDelayFilterOctaves)];
                    let filterTargetHz = filterKeyTrackEnabled
                        ? resolveKeyTrackedFrequencyHz (
                            1.0f,
                            pp[laneDelayParamFilterHz],
                            trackingPitchHzIn,
                            pp[laneDelayParamFilterKeyTrackOffsetSemitones],
                            delayFilterRouteOctaves * 12.0f,
                            delayFilterMinHz,
                            delayFilterMaxHz)
                        : clampDelayFilterHz (
                            pp[laneDelayParamFilterHz]
                                * rackOctaveScale (octaveScalers[wrap<rackOctaveScalerCount> (
                                    scalerBase + laneOctaveScalerDelayFilter)], delayFilterRouteOctaves));
                    let filterHz = filterKeyTrackEnabled
                        ? advanceKeyTrackSmoothedValue (
                            trackedFrequencyHz[ordinal, laneTrackedFrequencyDelayFilter],
                            filterTargetHz,
                            keyTrackSmoothingCoefficientState)
                        : filterTargetHz;
                    trackedFrequencyHz[ordinal, laneTrackedFrequencyDelayFilter] = filterHz;
                    delayPool[ordinal].timeMsIn <- trackedTimeMs;
                    delayPool[ordinal].timeModeIn <- timeKeyTrackEnabled
                        ? float32 (delayTimeModeFree)
                        : pp[laneDelayParamTimeMode];
                    delayPool[ordinal].divisionIn <- pp[laneDelayParamDivision];
                    delayPool[ordinal].feedbackIn <- clampDelayFeedback (
                        rackModulateLinear (pp[laneDelayParamFeedback],
                                            rackModIn[wrap<rackModTargetCount> (laneBase + rackModTargetDelayFeedback)]));
                    delayPool[ordinal].filterHzIn <- filterHz;
                    delayPool[ordinal].mixIn <- clampDelayMix (
                        rackModulateLinear (pp[laneDelayParamMix],
                                            rackModIn[wrap<rackModTargetCount> (laneBase + rackModTargetDelayMix)]));
                    delayPool[ordinal].tempoBpmIn <- clampDelayTempoBpm (tempoBpmIn);
                }

                if (slotInCurrentChain[wrap<laneChainSlotCount> (slotBase + rackModuleReverb)])
                {
                    let pp = slotParamCurrent[wrap<laneChainSlotCount> (slotBase + rackModuleReverb)];
                    reverbPool[ordinal].sizeIn <- rackModulateLinear (pp[laneReverbParamSize],
                        rackModIn[wrap<rackModTargetCount> (laneBase + rackModTargetReverbSize)]);
                    reverbPool[ordinal].decayIn <- rackModulateLinear (pp[laneReverbParamDecay],
                        rackModIn[wrap<rackModTargetCount> (laneBase + rackModTargetReverbDecay)]);
                    reverbPool[ordinal].dampingIn <- rackModulateLinear (pp[laneReverbParamDamping],
                        rackModIn[wrap<rackModTargetCount> (laneBase + rackModTargetReverbDamping)]);
                    reverbPool[ordinal].mixIn <- rackModulateLinear (pp[laneReverbParamMix],
                        rackModIn[wrap<rackModTargetCount> (laneBase + rackModTargetReverbMix)]);
                }
            }
        }

        //----------------------------------------------------------------------
        // Dispatch.
        //
        // A disabled module is fed the LIVE chain signal - not silence - and is still
        // advanced, so its internal time never diverges from the rack's and its delay
        // lines hold the history they would have held. It simply contributes no wet
        // output and passes the signal through EXACTLY (ADR-005's hard audible bypass).

        float32<rackChannelCount> advanceLaneSlot (wrap<laneSlotCount> slotId,
                                                   float32<rackChannelCount> signal)
        {
            let selector = int32 (slotId);
            let isEnabled = currentLaneEnabled[wrap<laneChainSlotCount> (selector)];
            let ordinal = wrap<lanePoolInstanceCount> (selector / rackModuleCount);
            let poolType = selector % rackModuleCount;

            if (poolType == rackModuleGlobalFilter)
            {
                globalFilterPool[ordinal].in <- signal;
                globalFilterPool[ordinal].advance();
                return isEnabled ? globalFilterPool[ordinal].out : signal;
            }

            if (poolType == rackModuleDistortion)
            {
                distortionPool[ordinal].in <- signal;
                distortionPool[ordinal].advance();
                return isEnabled ? distortionPool[ordinal].out : signal;
            }

            if (poolType == rackModuleOtt)
            {
                ottPool[ordinal].in <- signal;
                ottPool[ordinal].advance();
                return isEnabled ? ottPool[ordinal].out : signal;
            }

            if (poolType == rackModuleChorus)
            {
                chorusPool[ordinal].in <- signal;
                chorusPool[ordinal].advance();
                return isEnabled ? chorusPool[ordinal].out : signal;
            }

            if (poolType == rackModuleFlanger)
            {
                flangerPool[ordinal].in <- signal;
                flangerPool[ordinal].advance();
                return isEnabled ? flangerPool[ordinal].out : signal;
            }

            if (poolType == rackModulePhaser)
            {
                phaserPool[ordinal].in <- signal;
                phaserPool[ordinal].advance();
                return isEnabled ? phaserPool[ordinal].out : signal;
            }

            if (poolType == rackModuleDelay)
            {
                delayPool[ordinal].in <- signal;
                delayPool[ordinal].advance();
                return isEnabled ? delayPool[ordinal].out : signal;
            }

            reverbPool[ordinal].in <- signal;
            reverbPool[ordinal].advance();
            return isEnabled ? reverbPool[ordinal].out : signal;
        }

        //----------------------------------------------------------------------
        // Group walk helpers. A marker OPENS a group over the trunk signal;
        // members are dispatched onto their branches; a trunk device, the
        // next marker, or the chain's end CLOSES it through mergeOpenGroup.

        void openGroup (int32 markerSlot, int32 fanout, float32<rackChannelCount> forkSignal)
        {
            laneGroupKind = laneSlotIsSplitMarker (markerSlot) ? 2 : 1;
            laneGroupEnabled = currentLaneEnabled[wrap<laneChainSlotCount> (markerSlot)];
            laneGroupBranchCount = fanout;
            laneGroupMemberCount = 0;
            laneGroupSoloBranch = 0;
            laneRunBranch = 0;
            laneGroupInput = forkSignal;

            if (laneGroupKind == 2)
            {
                // The contribution slots are pre-filled with each band's RAW
                // FILTERED SIGNAL: an untouched band passes itself to the
                // merge, so the spectrum always survives an empty band. The
                // filters run whether or not the group is bypassed — their
                // time bases never drift (the ADR-005 posture).
                let unit = wrap<laneSplitUnitCount> (markerSlot - laneSplitSlotBase);
                let requestedSolo = currentSplitSoloBranches[unit];
                laneGroupSoloBranch = requestedSolo <= fanout ? requestedSolo : 0;

                if (fanout == 2)
                {
                    let split = splitXoverLow[unit].process (forkSignal);
                    laneGroupContributions[0] = split[0];
                    laneGroupContributions[1] = split[1];
                    laneGroupContributions[2] = float32<rackChannelCount> ();
                }
                else
                {
                    let splitLowRest = splitXoverLow[unit].process (forkSignal);
                    let splitMidHigh = splitXoverHigh[unit].process (splitLowRest[1]);
                    let modes = splitCompensation[unit].processMultimode (splitLowRest[0]);

                    // The high crossover's own allpass form (lp − √2·bp + hp)
                    // applied to the LOW path, so all three bands share the
                    // tree's full phase rotation and the recombined magnitude
                    // is exactly flat at any crossover spacing.
                    laneGroupContributions[0] = modes[0]
                                                  - std::intrinsics::sqrt (2.0f) * modes[2]
                                                  + modes[1];
                    laneGroupContributions[1] = splitMidHigh[0];
                    laneGroupContributions[2] = splitMidHigh[1];
                }

                laneGroupContributions[3] = float32<rackChannelCount> ();
            }
            else
            {
                let unit = wrap<laneParallelUnitCount> (markerSlot - laneParallelSlotBase);
                let requestedSolo = currentParallelSoloBranches[unit];
                laneGroupSoloBranch = requestedSolo <= fanout ? requestedSolo : 0;

                // A parallel branch's empty contribution is SILENCE: every
                // branch reads the whole fork signal, so an empty lane must
                // add nothing at the merge.
                for (wrap<laneMaxBranchesPerGroup> branch)
                    laneGroupContributions[branch] = float32<rackChannelCount> ();
            }
        }

        // A member's first appearance on a branch starts from that branch's
        // input: parallel branches read the fork signal, split bands read
        // their filtered band (sitting in the contribution slot until a
        // device claims it). Later members continue the branch serially.
        void startBranchMember (int32 tag)
        {
            if (tag != laneRunBranch)
            {
                if (laneRunBranch >= 1)
                    laneGroupContributions[wrap<laneMaxBranchesPerGroup> (laneRunBranch - 1)] = laneBranchSignal;

                laneBranchSignal = laneGroupKind == 2
                                     ? laneGroupContributions[wrap<laneMaxBranchesPerGroup> (tag - 1)]
                                     : laneGroupInput;
                laneRunBranch = tag;
            }
        }

        // Close the open group: bank the running branch, then select the
        // auditioned contribution or merge by sum. Group bypass still hands
        // the FORK signal through. With no Solo, an entirely empty group is
        // also a hard passthrough; with Solo, an empty Parallel branch is
        // silence while an empty Split band retains its raw filtered band.
        float32<rackChannelCount> mergeOpenGroup()
        {
            if (laneRunBranch >= 1)
                laneGroupContributions[wrap<laneMaxBranchesPerGroup> (laneRunBranch - 1)] = laneBranchSignal;

            let selectedBranch = laneGroupSoloBranch;
            laneGroupKind = 0;

            if (! laneGroupEnabled)
                return laneGroupInput;

            if (selectedBranch >= 1)
                return laneGroupContributions[wrap<laneMaxBranchesPerGroup> (selectedBranch - 1)];

            if (laneGroupMemberCount == 0)
                return laneGroupInput;

            var merged = float32<rackChannelCount> ();

            for (wrap<laneMaxBranchesPerGroup> branch)
                if (int32 (branch) < laneGroupBranchCount)
                    merged += laneGroupContributions[branch];

            return merged;
        }

        void main()
        {
            publishStructureDiagnostics();

            loop
            {
                forwardModuleParameters();

                var chain = in;

                // ONE dispatch: the committed chain, in order. A device
                // outside the chain does not exist — it advances nothing and
                // costs nothing; it enters fresh through the commit reset.
                // An empty chain is the dry instrument.
                //
                // Groups walk the SAME positions: a marker forks the trunk
                // (splitting it into bands when the marker is a split),
                // members ride their branches, and the group closes — merging
                // by sum, or handing the fork through when bypassed or empty
                // — at a trunk device, the next marker, or the chain's end.
                // An all-trunk chain takes none of these paths and is
                // bit-identical to the pre-group serial walk.

                for (wrap<maxLaneChainLength> position)
                {
                    if (int32 (position) < currentLaneChainLength)
                    {
                        let slot = int32 (currentLaneChain[position]);
                        let tag = currentLaneBranchTag[position];

                        if (laneSlotIsGroupMarker (slot))
                        {
                            if (laneGroupKind != 0)
                                chain = mergeOpenGroup();

                            openGroup (slot, tag, chain);
                        }
                        else if (tag == 0)
                        {
                            if (laneGroupKind != 0)
                                chain = mergeOpenGroup();

                            chain = advanceLaneSlot (wrap<laneSlotCount> (slot), chain);
                        }
                        else
                        {
                            startBranchMember (tag);
                            laneBranchSignal = advanceLaneSlot (wrap<laneSlotCount> (slot), laneBranchSignal);
                            laneGroupMemberCount += 1;
                        }
                    }
                }

                if (laneGroupKind != 0)
                    chain = mergeOpenGroup();

                let transition = nextTransitionGain();
                let laneMix = nextLaneOutputMix();
                laneOutputBlend.dryIn <- in;
                laneOutputBlend.wetIn <- chain;
                laneOutputBlend.mixDepthIn <- transition * laneMix;
                laneOutputBlend.advance();
                out <- laneOutputBlend.out;

                previewInputLeft <- distortionPool[wrap<lanePoolInstanceCount> (0)].previewInputLeft;
                previewInputRight <- distortionPool[wrap<lanePoolInstanceCount> (0)].previewInputRight;
                previewOutputLeft <- distortionPool[wrap<lanePoolInstanceCount> (0)].previewOutputLeft;
                previewOutputRight <- distortionPool[wrap<lanePoolInstanceCount> (0)].previewOutputRight;

                publishStructureDiagnostics();
                advance();
            }
        }
    }
}
