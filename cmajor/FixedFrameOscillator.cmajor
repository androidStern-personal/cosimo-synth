                    mip2Bank1Samples.at (base + samplesPerFrame + 1) = sourceSamples.at (0);
                    mip2Bank1Samples.at (base + samplesPerFrame + 2) = sourceSamples.at (1);
                }

                return;
            }

            if (mipIndex == 3)
