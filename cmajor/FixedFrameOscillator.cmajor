                    mip9Bank1Samples.at (base + 0) = sourceSamples.at (samplesPerFrame - 1);
                    for (int32 sampleIndex = 0; sampleIndex < samplesPerFrame; ++sampleIndex)
                        mip9Bank1Samples.at (base + sampleIndex + 1) = sourceSamples.at (sampleIndex);
                    mip9Bank1Samples.at (base + samplesPerFrame + 1) = sourceSamples.at (0);
                    mip9Bank1Samples.at (base + samplesPerFrame + 2) = sourceSamples.at (1);
                }

                return;
            }

            if (mipIndex == 10)
            {
                if (bank == 0)
                {
                    mip10Bank0Samples.at (base + 0) = sourceSamples.at (samplesPerFrame - 1);
                    for (int32 sampleIndex = 0; sampleIndex < samplesPerFrame; ++sampleIndex)
                        mip10Bank0Samples.at (base + sampleIndex + 1) = sourceSamples.at (sampleIndex);
                    mip10Bank0Samples.at (base + samplesPerFrame + 1) = sourceSamples.at (0);
                    mip10Bank0Samples.at (base + samplesPerFrame + 2) = sourceSamples.at (1);
                }
                else
                {
                    mip10Bank1Samples.at (base + 0) = sourceSamples.at (samplesPerFrame - 1);
                    for (int32 sampleIndex = 0; sampleIndex < samplesPerFrame; ++sampleIndex)
                        mip10Bank1Samples.at (base + sampleIndex + 1) = sourceSamples.at (sampleIndex);
                    mip10Bank1Samples.at (base + samplesPerFrame + 1) = sourceSamples.at (0);
                    mip10Bank1Samples.at (base + samplesPerFrame + 2) = sourceSamples.at (1);
                }

                return;
            }

        }

        float32 readFixedFrameSampleForMip (int32 mipIndex, int32 frameIndex, float32 phase)
        {
            let bank = normalizeTableBankIndex (activeBankIndex);
            let base = frameBase (frameIndex);

            if (mipIndex == 0) return bank == 0 ? readFixedFrameSampleFromBase (mip0Bank0Samples, base, phase) : readFixedFrameSampleFromBase (mip0Bank1Samples, base, phase);
            if (mipIndex == 1) return bank == 0 ? readFixedFrameSampleFromBase (mip1Bank0Samples, base, phase) : readFixedFrameSampleFromBase (mip1Bank1Samples, base, phase);
            if (mipIndex == 2) return bank == 0 ? readFixedFrameSampleFromBase (mip2Bank0Samples, base, phase) : readFixedFrameSampleFromBase (mip2Bank1Samples, base, phase);
            if (mipIndex == 3) return bank == 0 ? readFixedFrameSampleFromBase (mip3Bank0Samples, base, phase) : readFixedFrameSampleFromBase (mip3Bank1Samples, base, phase);
            if (mipIndex == 4) return bank == 0 ? readFixedFrameSampleFromBase (mip4Bank0Samples, base, phase) : readFixedFrameSampleFromBase (mip4Bank1Samples, base, phase);
            if (mipIndex == 5) return bank == 0 ? readFixedFrameSampleFromBase (mip5Bank0Samples, base, phase) : readFixedFrameSampleFromBase (mip5Bank1Samples, base, phase);
            if (mipIndex == 6) return bank == 0 ? readFixedFrameSampleFromBase (mip6Bank0Samples, base, phase) : readFixedFrameSampleFromBase (mip6Bank1Samples, base, phase);
            if (mipIndex == 7) return bank == 0 ? readFixedFrameSampleFromBase (mip7Bank0Samples, base, phase) : readFixedFrameSampleFromBase (mip7Bank1Samples, base, phase);
            if (mipIndex == 8) return bank == 0 ? readFixedFrameSampleFromBase (mip8Bank0Samples, base, phase) : readFixedFrameSampleFromBase (mip8Bank1Samples, base, phase);
            if (mipIndex == 9) return bank == 0 ? readFixedFrameSampleFromBase (mip9Bank0Samples, base, phase) : readFixedFrameSampleFromBase (mip9Bank1Samples, base, phase);
            if (mipIndex == 10) return bank == 0 ? readFixedFrameSampleFromBase (mip10Bank0Samples, base, phase) : readFixedFrameSampleFromBase (mip10Bank1Samples, base, phase);
            return 0.0f;
        }

        float32 readFrameBlendSampleForMip (int32 mipIndex,
                                            int32 frameLo,
                                            int32 frameHi,
                                            float32 phase,
                                            float32 frameT)
        {
            let lo = readFixedFrameSampleForMip (mipIndex, frameLo, phase);

            if (frameHi == frameLo)
                return lo;

            let hi = readFixedFrameSampleForMip (mipIndex, frameHi, phase);
            return lo + (hi - lo) * frameT;
        }

        float32 readFixedFrameEndpointSampleForMip (int32 mipIndex, int32 frameIndex)
        {
            let bank = normalizeTableBankIndex (activeBankIndex);
            let endpointIndex = frameBase (frameIndex) + samplesPerFrame;

            if (mipIndex == 0) return bank == 0 ? mip0Bank0Samples.at (endpointIndex) : mip0Bank1Samples.at (endpointIndex);
            if (mipIndex == 1) return bank == 0 ? mip1Bank0Samples.at (endpointIndex) : mip1Bank1Samples.at (endpointIndex);
            if (mipIndex == 2) return bank == 0 ? mip2Bank0Samples.at (endpointIndex) : mip2Bank1Samples.at (endpointIndex);
            if (mipIndex == 3) return bank == 0 ? mip3Bank0Samples.at (endpointIndex) : mip3Bank1Samples.at (endpointIndex);
            if (mipIndex == 4) return bank == 0 ? mip4Bank0Samples.at (endpointIndex) : mip4Bank1Samples.at (endpointIndex);
            if (mipIndex == 5) return bank == 0 ? mip5Bank0Samples.at (endpointIndex) : mip5Bank1Samples.at (endpointIndex);
            if (mipIndex == 6) return bank == 0 ? mip6Bank0Samples.at (endpointIndex) : mip6Bank1Samples.at (endpointIndex);
            if (mipIndex == 7) return bank == 0 ? mip7Bank0Samples.at (endpointIndex) : mip7Bank1Samples.at (endpointIndex);
            if (mipIndex == 8) return bank == 0 ? mip8Bank0Samples.at (endpointIndex) : mip8Bank1Samples.at (endpointIndex);
            if (mipIndex == 9) return bank == 0 ? mip9Bank0Samples.at (endpointIndex) : mip9Bank1Samples.at (endpointIndex);
            if (mipIndex == 10) return bank == 0 ? mip10Bank0Samples.at (endpointIndex) : mip10Bank1Samples.at (endpointIndex);
            return 0.0f;
        }

        float32 readFrameBlendEndpointSampleForMip (int32 mipIndex,
                                                    int32 frameLo,
                                                    int32 frameHi,
                                                    float32 frameT)
        {
            let lo = readFixedFrameEndpointSampleForMip (mipIndex, frameLo);

            if (frameHi == frameLo)
                return lo;

            let hi = readFixedFrameEndpointSampleForMip (mipIndex, frameHi);
            return lo + (hi - lo) * frameT;
        }

        void emitMipRequest (int32 mipIndex, int32 urgencyLevel)
        {
            if (currentGeneration <= 0 || frameCount <= 0 || mipIndex < 0 || mipIndex >= mipLevelCount)
                return;

            if (requestedGenerationByMip.at (mipIndex) == currentGeneration
                && requestedUrgencyByMip.at (mipIndex) >= urgencyLevel)
                return;

            WavetableMipRequest request;
            request.dspSessionId = currentDspSessionId;
            request.generation = currentGeneration;
            request.tableIndex = currentTableIndex;
            request.mipIndex = mipIndex;
            request.urgencyLevel = urgencyLevel;
            requestedGenerationByMip.at (mipIndex) = currentGeneration;
            requestedUrgencyByMip.at (mipIndex) = urgencyLevel;
            wavetableMipRequestOut <- request;
        }

        void emitUploadAck (int32 generation, int32 tableIndex, int32 mipIndex, int32 frameIndex)
        {
            WavetableUploadAck ack;
            ack.dspSessionId = currentDspSessionId;
            ack.generation = generation;
            ack.tableIndex = tableIndex;
            ack.mipIndex = mipIndex;
            ack.frameIndex = frameIndex;
            wavetableUploadAckOut <- ack;
        }

        void emitRuntimeServiceState()
        {
            RuntimeServiceState state;
            state.dspSessionId = currentDspSessionId;
            state.generationFrontier = generationFrontier;
            state.serviceState = isPlayable != 0 ? 2 : (stagingGeneration > 0 && stagingFrameCount > 0 ? 1 : 0);
            state.hasActive = isPlayable != 0 ? 1 : 0;
            state.activeTableIndex = isPlayable != 0 ? currentTableIndex : 0;
            state.activeGeneration = isPlayable != 0 ? currentGeneration : 0;
            state.hasLoading = stagingGeneration > 0 && stagingFrameCount > 0 ? 1 : 0;
            state.loadingTableIndex = state.hasLoading != 0 ? stagingTableIndex : 0;
            state.loadingGeneration = state.hasLoading != 0 ? stagingGeneration : 0;
            runtimeServiceStateOut <- state;
        }

        event frequencyIn (float32 newFrequency)
        {
            currentFrequencyHz = newFrequency < 0.0f ? 0.0f : newFrequency;
            phasor.setFrequency (processor.frequency, currentFrequencyHz);
        }

        event wavetableLoadBeginIn (WavetableLoadBegin request)
        {
            let resolvedFrameCount = resolveUploadedFrameCount (request.frameCount);

            if (request.dspSessionId != currentDspSessionId
                || request.generation <= 0
                || request.generation < generationFrontier
                || request.tableIndex < 0
                || resolvedFrameCount == 0)
                return;

            generationFrontier = std::intrinsics::max (generationFrontier, request.generation);
            stagingGeneration = request.generation;
            stagingTableIndex = request.tableIndex;
            stagingFrameCount = resolvedFrameCount;
            stagingLastFrameIndex = stagingFrameCount > 0 ? stagingFrameCount - 1 : 0;
            stagingLastFrameIndexF = float32 (stagingLastFrameIndex);
            clearPendingTableState();
            emitRuntimeServiceState();
        }

        event wavetableMipFrameIn (WavetableMipFrame newFrame)
        {
            let resolvedMipIndex = resolveMipIndex (newFrame.mipIndex);

            if (resolvedMipIndex < 0 || stagingFrameCount <= 0)
                return;

            if (newFrame.dspSessionId != currentDspSessionId
                || newFrame.generation != stagingGeneration
                || newFrame.tableIndex != stagingTableIndex)
                return;

            if (newFrame.frameIndex < 0 || newFrame.frameIndex >= stagingFrameCount)
                return;

            let readyIndex = bankedReadinessIndex (stagingBankIndex, resolvedMipIndex, newFrame.frameIndex);

            if (readyFrameFlags.at (readyIndex) != 0)
            {
                emitUploadAck (
                    newFrame.generation,
                    newFrame.tableIndex,
                    resolvedMipIndex,
                    newFrame.frameIndex
                );
                return;
            }

            writeMipFrame (stagingBankIndex, resolvedMipIndex, newFrame.frameIndex, newFrame.samples);
            readyFrameFlags.at (readyIndex) = 1;
            loadedFrameCounts.at (bankedMipLevelIndex (stagingBankIndex, resolvedMipIndex)) += 1;

            emitUploadAck (
                newFrame.generation,
                newFrame.tableIndex,
                resolvedMipIndex,
                newFrame.frameIndex
            );

            if (isStagingComplete())
                commitStagingTable();
        }

        event serviceLoadAbortIn (ServiceLoadAbort abort)
        {
            if (abort.dspSessionId != currentDspSessionId
                || abort.generation != stagingGeneration
                || abort.tableIndex != stagingTableIndex)
                return;

            stagingGeneration = 0;
            stagingTableIndex = 0;
            stagingFrameCount = 0;
            stagingLastFrameIndex = 0;
            stagingLastFrameIndexF = 0.0f;
            clearPendingTableState();
            emitRuntimeServiceState();
        }

        void main()
        {
            phasor.phase = std::intrinsics::wrap (initialPhase, 1.0f);
            currentFrequencyHz = currentFrequencyHz < 0.0f ? 0.0f : currentFrequencyHz;
            phasor.setFrequency (processor.frequency, currentFrequencyHz);
            loop
            {
                if (! hasEmittedInitialRuntimeState)
                {
                    emitRuntimeServiceState();
                    hasEmittedInitialRuntimeState = true;
                }

                let currentPhaseIncrement = currentFrequencyHz / float32 (processor.frequency);
                let requestedMipIndex = selectMipIndexFromPhaseIncrement (currentPhaseIncrement);
                let playableMipIndex = findPlayableMipIndex (requestedMipIndex);

                if (playableMipIndex < 0)
                {
                    out <- 0.0f;
                }
                else
                {
                    let phase = phasor.next();

                    if (frameCount <= 1)
                    {
                        out <- readFixedFrameSampleForMip (playableMipIndex, 0, phase);
                    }
                    else
                    {
                        let framePosition = std::intrinsics::clamp (framePositionIn, 0.0f, 1.0f);
                        let frameIndex = framePosition * lastFrameIndexF;
                        let frameLo = int32 (std::intrinsics::floor (frameIndex));
                        let frameHi = std::intrinsics::min (frameLo + 1, lastFrameIndex);
                        let frameT = frameIndex - float32 (frameLo);
                        out <- readFrameBlendSampleForMip (playableMipIndex, frameLo, frameHi, phase, frameT);
                    }
                }

                advance();
            }
        }
    }

    processor SharedVoiceEngine (int voiceCount,
                                 float32 previewFrequencyHz = 440.0f,
                                 int wavetableFrameCapacity = maxFramesPerTable)
    {
        input event (std::notes::NoteOn,
                     std::notes::NoteOff,
                     std::notes::PitchBend,
                     std::notes::Slide,
                     std::notes::Pressure,
                     std::notes::Control,
                     wt::ArticulatedNoteOn) voiceEventIn[voiceCount];
        input event VoiceRetune voiceRetuneIn[voiceCount];
        input event WavetableLoadBegin wavetableLoadBeginIn;
        input event WavetableMipFrame wavetableMipFrameIn;
        input event ServiceLoadAbort serviceLoadAbortIn;
        input event OscillatorWavetableLoadBegin oscillatorWavetableLoadBeginIn;
        input event OscillatorWavetableMipFrame oscillatorWavetableMipFrameIn;
        input event OscillatorServiceLoadAbort oscillatorServiceLoadAbortIn;
        input event ArticulationSnapshotUpload articulationSnapshotIn;
        input event ModulationMsegBufferUpload modulationMsegBufferIn;
        input event ModulationMsegPlaybackUpload modulationMsegPlaybackIn;
        input event ModulationEnvelopeUpload modulationEnvelopeIn;
        input event ModulationProgramUpload modulationProgramIn;
        input event ModulationAmountUpload modulationAmountIn;
        input event int32 runtimeInstallSyncIn;
        input value float32 framePositionIn [[ name: "Wavetable Position", min: 0.0f, max: 1.0f, init: 0.0f ]];
        input value float32 glideTimeIn [[ name: "Glide Time", min: 0.0f, max: 2.0f, init: 0.0f, unit: "s", rampFrames: 0 ]];
        input value float32 warpModeIn [[ name: "Warp Mode", min: 0.0f, max: 4.0f, init: 0.0f, discrete: true, step: 1.0f, rampFrames: 0 ]];
        input value float32 warpAmountIn [[ name: "Warp Amount", min: 0.0f, max: 1.0f, init: 0.0f, rampFrames: 64 ]];
        input value float32 filterModeIn [[ name: "Filter Mode", min: 0.0f, max: 5.0f, init: 0.0f, discrete: true, step: 1.0f, rampFrames: 0 ]];
        input value float32 filterCutoffIn [[ name: "Filter Cutoff", min: 20.0f, max: 20000.0f, init: 1000.0f, unit: "Hz", rampFrames: 64 ]];
        input value float32 filterQIn [[ name: "Filter Q", min: 0.1f, max: 20.0f, init: 0.707107f, rampFrames: 64 ]];
        input value float32 panIn [[ name: "Pan", min: -1.0f, max: 1.0f, init: 0.0f, rampFrames: 64 ]];
        input value float32 macro1In [[ name: "Macro 1", min: 0.0f, max: 1.0f, init: 0.0f, rampFrames: 64 ]];
        input value float32 macro2In [[ name: "Macro 2", min: 0.0f, max: 1.0f, init: 0.0f, rampFrames: 64 ]];
        input value float32 macro3In [[ name: "Macro 3", min: 0.0f, max: 1.0f, init: 0.0f, rampFrames: 64 ]];
        input value float32 macro4In [[ name: "Macro 4", min: 0.0f, max: 1.0f, init: 0.0f, rampFrames: 64 ]];
        input value float32 unisonVoicesIn [[ name: "Unison", min: 1.0f, max: 8.0f, init: 1.0f, discrete: true, step: 1.0f, rampFrames: 0 ]];
        input value float32 unisonDetuneIn [[ name: "Unison Detune", min: 0.0f, max: 1.0f, init: 0.10f, rampFrames: 64 ]];
        input value float32 unisonBlendIn [[ name: "Unison Blend", min: 0.0f, max: 1.0f, init: 0.75f, rampFrames: 64 ]];
        input value float32 unisonWidthIn [[ name: "Unison Width", min: 0.0f, max: 1.0f, init: 1.0f, rampFrames: 64 ]];
        input value float32 unisonPhaseIn [[ name: "Unison Phase", min: 0.0f, max: 1.0f, init: 0.0f, rampFrames: 0 ]];
        input value float32 unisonRandomIn [[ name: "Unison Random", min: 0.0f, max: 1.0f, init: 0.0f, rampFrames: 0 ]];
        input value float32 unisonPhaseModeIn [[ name: "Unison Phase Mode", min: 0.0f, max: 1.0f, init: 0.0f, discrete: true, step: 1.0f, text: "Contiguous|Reset", rampFrames: 0 ]];
        input value float32 unisonDetuneModeIn [[ name: "Unison Detune Mode", min: 0.0f, max: 4.0f, init: 0.0f, discrete: true, step: 1.0f, text: "Linear|Super|Exp|Inv|Random", rampFrames: 0 ]];
        input value float32 unisonStackModeIn [[ name: "Unison Stack", min: 0.0f, max: 4.0f, init: 0.0f, discrete: true, step: 1.0f, text: "Off|12|12+7|Center-12|Center-24", rampFrames: 0 ]];
        input value float32 unisonWavetablePositionSpreadIn [[ name: "Unison WT Pos", min: 0.0f, max: 1.0f, init: 0.0f, rampFrames: 64 ]];
        input value float32 unisonWarpSpreadIn [[ name: "Unison Warp", min: 0.0f, max: 1.0f, init: 0.0f, rampFrames: 64 ]];
        input value float32 mseg1MorphIn [[ name: "MSEG 1 Morph", min: 0.0f, max: 1.0f, init: 0.0f, rampFrames: 0 ]];
        input value float32 mseg2MorphIn [[ name: "MSEG 2 Morph", min: 0.0f, max: 1.0f, init: 0.0f, rampFrames: 0 ]];
        input value float32 mseg3MorphIn [[ name: "MSEG 3 Morph", min: 0.0f, max: 1.0f, init: 0.0f, rampFrames: 0 ]];
        output event WavetableUploadAck wavetableUploadAckOut;
        output event WavetableMipRequest wavetableMipRequestOut;
        output event RuntimeServiceState runtimeServiceStateOut;
        output event OscillatorWavetableUploadAck oscillatorWavetableUploadAckOut;
        output event OscillatorWavetableMipRequest oscillatorWavetableMipRequestOut;
        output event OscillatorRuntimeServiceState oscillatorRuntimeServiceStateOut;
        output event WavetableSlotMonitor wavetableSlotMonitorOut;
        output event wt::EffectiveWavetablePositionMonitor effectiveWavetablePositionOut;
        output event wt::EffectiveWarpStateMonitor effectiveWarpStateOut;
        output event wt::EffectiveUnisonStateMonitor effectiveUnisonStateOut;
        output event wt::EffectiveFilterStateMonitor effectiveFilterStateOut;
        output event wt::EffectiveMsegStateMonitor effectiveMsegStateOut;
        output event wt::VoiceArticulationMonitor voiceArticulationStartOut;
        output event wt::OscillatorVoiceStartMonitor oscillatorVoiceStartOut;
        output stream float32<2> out;
        output stream float32 trackingPitchHzOut;
        output stream float32 rackModOut[rackModTargetCount];
        output event int32 modulationRejectedRouteCountOut;
        output event RuntimeInstallAck runtimeInstallAckOut;

        int32[oscillatorCount] makeInactiveOscillatorSlots()
        {
            int32[oscillatorCount] slots;

            for (wrap<oscillatorCount> oscillator)
                slots[oscillator] = -1;

            return slots;
        }

        node envelopes = wt::RetriggerableFixedASR (0.01f, 0.20f)[voiceCount];
        node mseg1 = wt::MsegReader[voiceCount];
        node mseg2 = wt::MsegReader[voiceCount];
        node mseg3 = wt::MsegReader[voiceCount];
        node modEnv1 = wt::RetriggerableAdsr[voiceCount];
        node modEnv2 = wt::RetriggerableAdsr[voiceCount];
        node modEnv3 = wt::RetriggerableAdsr[voiceCount];

        std::filters::simper::Implementation[voiceCount] filters;
        std::filters::simper::Implementation[voiceCount] unisonLeftFilters;
        std::filters::simper::Implementation[voiceCount] unisonRightFilters;
        std::oscillators::PhasorState[voiceCount * oscillatorCount] phasors;
        std::oscillators::PhasorState[voiceCount * oscillatorCount * maxUnisonVoiceCount] unisonPhasors;
        int32[voiceCount * oscillatorCount] voiceOscillatorGeneration;
        int32[voiceCount] voiceChannel;
        float32[voiceCount] voiceBasePitch;
        float32[voiceCount] voiceCurrentPitch;
        float32[voiceCount] voiceTargetPitch;
        float32[voiceCount] voiceBendSemitones;
        float32[voiceCount] voicePressure;
        float32[voiceCount] voiceSlide;
        float32[voiceCount] voiceVelocity;
        float32[voiceCount] voicePitchGlideStep;
        int32[voiceCount] voiceGlideSamplesRemaining;
        int32[voiceCount] voiceActive;
        int32[voiceCount] voiceGeneration;
        int32[voiceCount] voiceTrackingSerial;
        float32[voiceCount] voiceEffectivePosition;
        int32[voiceCount] voiceEffectiveWarpMode;
        float32[voiceCount] voiceEffectiveWarpAmount;
        int32[voiceCount] voiceEffectiveFilterMode;
        float32[voiceCount] voiceEffectiveFilterCutoffHz;
        float32[voiceCount] voiceEffectiveFilterQ;
        float32[voiceCount] voiceEffectivePan;
        int32[voiceCount] voiceEffectiveUnisonVoices;
        float32[voiceCount] voiceEffectiveUnisonDetune;
        float32[voiceCount] voiceEffectiveUnisonBlend;
        float32[voiceCount] voiceEffectiveUnisonWidth;
        int32[voiceCount] voiceEffectiveUnisonDetuneMode;
        int32[voiceCount] voiceEffectiveUnisonStackMode;
        float32[voiceCount] voiceEffectiveUnisonWavetablePositionSpread;
        float32[voiceCount] voiceEffectiveUnisonWarpSpread;
        float32[voiceCount] voiceMsegProgress1;
        float32[voiceCount] voiceMsegProgress2;
        float32[voiceCount] voiceMsegProgress3;
        bool[articulationSlotCount] articulationSlotDefined;
        float32[articulationSlotCount] articulationFramePosition;
        float32[articulationSlotCount] articulationPan;
        int32[articulationSlotCount] articulationUnisonVoices;
        float32[articulationSlotCount] articulationUnisonDetune;
        float32[articulationSlotCount] articulationUnisonBlend;
        float32[articulationSlotCount] articulationUnisonWidth;
        float32[articulationSlotCount] articulationUnisonPhase;
        float32[articulationSlotCount] articulationUnisonRandom;
        int32[articulationSlotCount] articulationUnisonPhaseMode;
        int32[articulationSlotCount] articulationUnisonDetuneMode;
        int32[articulationSlotCount] articulationUnisonStackMode;
        float32[articulationSlotCount] articulationUnisonWavetablePositionSpread;
        float32[articulationSlotCount] articulationUnisonWarpSpread;
        int32[articulationSlotCount] articulationWarpMode;
        float32[articulationSlotCount] articulationWarpAmount;
        int32[articulationSlotCount] articulationFilterMode;
        float32[articulationSlotCount] articulationFilterCutoffHz;
        float32[articulationSlotCount] articulationFilterQ;
        float32[articulationSlotCount * modulationMsegSlotCount] articulationMsegMorphs;
