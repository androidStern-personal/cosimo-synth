        float32<rackModStaticTargetCount>[modulationMacroSourceCount, rackModBlockCount] macroRackRouteScaleVectors;
        float32<rackModStaticTargetCount>[modulationMacroSourceCount, rackModBlockCount] macroRackRouteBiasVectors;
        bool[modulationVoiceSourceCount] voiceRackSourceUsed;
        VoiceModulationTargets[voiceCount] voiceTargetOffsets;
        float32[modulationMacroSourceCount] macroSourceValues;
        float32<modulationVoiceCoreLaneCount> macroVoiceCoreBaseTargetOffsets;
        float32<modulationVoiceGeneratorLaneCount> macroVoiceGeneratorBaseTargetOffsets;
        float32<rackModStaticTargetCount>[rackModBlockCount] macroRackBaseTargetOffsets;
        float32[modulationVoiceSourceCount] voiceRackSourceSums;
        float32[modulationVoiceSourceCount] voiceRackSourceMaxima;
        float32[modulationVoiceSourceCount] voiceRackSourceBipolarStrongest;
        float32[modulationVoiceSourceCount] voiceRackSourceBipolarMagnitudes;
        int32 voiceRackParticipantCount;
        float32 voiceRackParticipantReciprocal;
        bool[modulationVoiceRackRouteCellCount] voiceRackCellActive;
        bool[modulationVoiceRackRouteCellCount] voiceRackCellNextActive;
        float32[modulationVoiceRackRouteCellCount] voiceRackCellHeldSources;
        float32[modulationVoiceRackRouteCellCount] voiceRackCellGates;
        float32[rackModTargetCount] rackModAccumulator;
        float32[rackModTargetCount] rackModSmoothed;
        // Active-set delivery for the rack modulation bus. The compiled
        // program is sparse everywhere upstream; these carry that sparseness
        // through the final smooth-and-publish stage, so the per-sample cost
        // scales with installed rack routes rather than the full
        // rackModTargetCount lane domain. A target is ROUTED while the
        // installed program references it, and LIVE from the install until
        // its smoothed value has decayed back to exactly zero — the
        // rackModSmoothTowards snap guarantees that happens in finite time,
        // and a lane's final write before leaving the live list is that
        // exact zero, so unpublished lanes always stand at 0.
        bool[rackModTargetCount] rackModTargetRouted;
        bool[rackModTargetCount] rackModTargetLive;
        int32[rackModTargetCount] rackModLiveTargets;
        int32 rackModLiveTargetCount;
        bool rackModHasMacroRackRoutes;
        float32 rackModGateReleaseStepState;
        float32 rackModSmoothingCoefficientState;
        float32 keyTrackSmoothingCoefficientState;
        int32 rejectedModulationRouteCount;
        int32 acceptedModulationSerial;
        int32 acceptedModulationProgramSerial;
        int32 acceptedArticulationSerial;
        float32[rendererPackedFloatCount] rendererFloats;
        int32[rendererPackedIntCount] rendererInts;

        // BounceBankStore residency seam. Callers only address install,
        // commit and read operations; the chunked arrays are a Path B detail.
        static_assert (bounceBankFrameCapacity == 5472000);
        static_assert (bounceBankChunkFrameCount == 684000);
        int32[bounceBankChunkFrameCount] bounceSlot0Chunk0;
        int32[bounceBankChunkFrameCount] bounceSlot0Chunk1;
        int32[bounceBankChunkFrameCount] bounceSlot0Chunk2;
        int32[bounceBankChunkFrameCount] bounceSlot0Chunk3;
        int32[bounceBankChunkFrameCount] bounceSlot0Chunk4;
        int32[bounceBankChunkFrameCount] bounceSlot0Chunk5;
        int32[bounceBankChunkFrameCount] bounceSlot0Chunk6;
        int32[bounceBankChunkFrameCount] bounceSlot0Chunk7;
        int32[bounceBankChunkFrameCount] bounceSlot1Chunk0;
        int32[bounceBankChunkFrameCount] bounceSlot1Chunk1;
        int32[bounceBankChunkFrameCount] bounceSlot1Chunk2;
        int32[bounceBankChunkFrameCount] bounceSlot1Chunk3;
        int32[bounceBankChunkFrameCount] bounceSlot1Chunk4;
        int32[bounceBankChunkFrameCount] bounceSlot1Chunk5;
        int32[bounceBankChunkFrameCount] bounceSlot1Chunk6;
        int32[bounceBankChunkFrameCount] bounceSlot1Chunk7;
        int32[bounceBankSlotCount * bounceBankRootCapacity] bounceSlotRootNotes;
        int32[bounceBankSlotCount * bounceBankRootCapacity] bounceSlotRootFrameOffsets;
        int32[bounceBankSlotCount * bounceBankRootCapacity] bounceSlotRootFrameCounts;
        int32[bounceBankSlotCount * bounceBankRootCapacity] bounceSlotRootNoteOffFrameOffsets;
        int32[bounceBankSlotCount] bounceSlotGenerations;
        int32[bounceBankSlotCount] bounceSlotSampleRates;
        int32[bounceBankSlotCount] bounceSlotRootCounts;
        int32[bounceBankSlotCount] bounceSlotFrameCounts;
        int32 bounceActiveSlot = -1;
        int32 bounceStagingSlot = -1;
        int32 bounceStagingGeneration = 0;
        int32 bounceStagingDeliverySerial = 0;
        int32 bounceStagingReceivedFrameCount = 0;
        int32 bounceGenerationFrontier = 0;
        int32 bounceRejectedDeliverySerial = 0;
        int32 bounceInstallRejectionReason = bounceInstallRejectionNone;
        int32 sourceModeState = sourceModeOscillator;
        int32 pendingSourceModeState = sourceModeOscillator;
        int32 sourceModeFadeDirection = 0;
        float32 sourceModeFadeGain = 1.0f;

        // Active slots are immutable while visible. Uploads write into the one
        // spare slot and publish only after every mip/frame has arrived.
        static_assert (wavetableFrameCapacity > 0 && wavetableFrameCapacity <= maxFramesPerTable);
        static_assert (voiceCount > 0 && voiceCount <= 16);
        static_assert (wavetableFrameCapacity == maxFramesPerTable);
        let packedWavetableSlotSampleCount = packedWavetableSamplesPerFrameSet * wavetableFrameCapacity;
        let packedWavetableChunkSampleCount = (packedWavetableSlotSampleCount + packedWavetableChunkCount - 1)
                                              / packedWavetableChunkCount;
        static_assert (wavetableFrameCapacity != maxFramesPerTable
                       || packedWavetableChunkSampleCount == 819904);
        int32[packedWavetableChunkSampleCount] packedSlot0Chunk0;
        int32[packedWavetableChunkSampleCount] packedSlot0Chunk1;
        int32[packedWavetableChunkSampleCount] packedSlot0Chunk2;
        int32[packedWavetableChunkSampleCount] packedSlot0Chunk3;
        int32[packedWavetableChunkSampleCount] packedSlot1Chunk0;
        int32[packedWavetableChunkSampleCount] packedSlot1Chunk1;
        int32[packedWavetableChunkSampleCount] packedSlot1Chunk2;
        int32[packedWavetableChunkSampleCount] packedSlot1Chunk3;
        int32[packedWavetableChunkSampleCount] packedSlot2Chunk0;
        int32[packedWavetableChunkSampleCount] packedSlot2Chunk1;
        int32[packedWavetableChunkSampleCount] packedSlot2Chunk2;
        int32[packedWavetableChunkSampleCount] packedSlot2Chunk3;
        int32[packedWavetableChunkSampleCount] packedSlot3Chunk0;
        int32[packedWavetableChunkSampleCount] packedSlot3Chunk1;
        int32[packedWavetableChunkSampleCount] packedSlot3Chunk2;
        int32[packedWavetableChunkSampleCount] packedSlot3Chunk3;
        int32[wavetableSlotCount * mipLevelCount * wavetableFrameCapacity] packedReadyFrameFlags;
        int32[wavetableSlotCount * mipLevelCount] packedLoadedFrameCounts;
        int32[oscillatorCount * mipLevelCount] oscillatorRequestedGenerationByMip;
        int32[oscillatorCount * mipLevelCount] oscillatorRequestedUrgencyByMip;
        int32[oscillatorCount] oscillatorGenerationFrontier;
        int32[oscillatorCount] oscillatorCurrentGeneration;
        int32[oscillatorCount] oscillatorCurrentTableIndex;
        int32[oscillatorCount] oscillatorFrameCount;
        int32[oscillatorCount] oscillatorLastFrameIndex;
        float32[oscillatorCount] oscillatorLastFrameIndexF;
        int32[oscillatorCount] oscillatorActiveSlot = makeInactiveOscillatorSlots();
        int32 tableStagingOscillatorIndex = -1;
        int32 tableStagingSlotIndex = -1;
        int32 tableStagingGeneration = 0;
        int32 tableStagingTableIndex = 0;
        int32 tableStagingFrameCount = 0;
        int32 tableStagingLastFrameIndex = 0;
        float32 tableStagingLastFrameIndexF = 0.0f;

        int32 currentDspSessionId = int32 (processor.session);
        bool hasEmittedInitialRuntimeState = false;

        int32 nextVoiceGeneration = 1;
        int32 nextVoiceTrackingSerial = 1;
        int32 monitorUpdateIntervalFrames = 1;
        int32 framesUntilNextMonitorUpdate = 0;
        int32 warpMonitorUpdateIntervalFrames = 1;
        int32 framesUntilNextWarpMonitorUpdate = 0;
        int32 unisonMonitorUpdateIntervalFrames = 1;
        int32 framesUntilNextUnisonMonitorUpdate = 0;
        int32 filterMonitorUpdateIntervalFrames = 1;
        int32 framesUntilNextFilterMonitorUpdate = 0;
        int32 msegMonitorUpdateIntervalFrames = 1;
        int32 framesUntilNextMsegMonitorUpdate = 0;
        int32 modSourceMonitorUpdateIntervalFrames = 1;
        int32 framesUntilNextModSourceMonitorUpdate = 0;
        float32 previewFrequencyHzState = previewFrequencyHz;
        float32 glideTimeSecondsState = 0.0f;
        float32[oscillatorCount] indexedFramePositionState;
        int32[oscillatorCount] indexedWarpModeState;
        float32[oscillatorCount] indexedWarpAmountState;
        float32[oscillatorCount] indexedOctaveState;
        float32[oscillatorCount] indexedSemitoneState;
        float32[oscillatorCount] indexedFineCentsState;
        int32[oscillatorCount] indexedUnisonVoicesState;
        float32[oscillatorCount] indexedPhaseState;
        float32[oscillatorCount] indexedPhaseRandomState;
        bool[oscillatorCount] indexedRetriggerState;
        float32[oscillatorCount] indexedVolumeDbState;
        bool[oscillatorCount] indexedMuteState;
        bool[oscillatorCount] indexedSoloState;
        float32[oscillatorCount] indexedPanState;
        float32[oscillatorCount] indexedUnisonDetuneState;
        float32[oscillatorCount] indexedUnisonBlendState;
        float32[oscillatorCount] indexedUnisonWidthState;
        int32[oscillatorCount] indexedUnisonDetuneModeState;
        int32[oscillatorCount] indexedUnisonStackModeState;
        float32[oscillatorCount] indexedPositionSpreadState;
        float32[oscillatorCount] indexedWarpSpreadState;
        int32 indexedFilterModeState;
        float32 indexedFilterCutoffState;
        float32 indexedFilterKeyTrackOffsetSemitonesState;
        float32 indexedFilterQState;
        float32[modulationMsegSlotCount] indexedMsegMorphState;
        float32[modulationMsegSlotCount] indexedMsegRateState;

        void updateOscillatorInputState()
        {
            for (wrap<oscillatorCount> oscillator)
            {
                indexedFramePositionState.at (oscillator)
                    = std::intrinsics::clamp (oscillatorFramePositionIn.at (oscillator), 0.0f, 1.0f);
                indexedWarpModeState.at (oscillator)
                    = resolveWarpMode (oscillatorWarpModeIn.at (oscillator));
                indexedWarpAmountState.at (oscillator)
                    = std::intrinsics::clamp (oscillatorWarpAmountIn.at (oscillator), 0.0f, 1.0f);
                indexedOctaveState.at (oscillator)
                    = std::intrinsics::clamp (oscillatorOctaveIn.at (oscillator), -4.0f, 4.0f);
                indexedSemitoneState.at (oscillator)
                    = std::intrinsics::clamp (oscillatorSemitoneIn.at (oscillator), -12.0f, 12.0f);
                indexedFineCentsState.at (oscillator)
                    = std::intrinsics::clamp (oscillatorFineCentsIn.at (oscillator), -100.0f, 100.0f);
                indexedUnisonVoicesState.at (oscillator)
                    = resolveUnisonVoices (oscillatorUnisonVoicesIn.at (oscillator));
                indexedPhaseState.at (oscillator)
                    = clampUnison01 (oscillatorPhaseIn.at (oscillator));
                indexedPhaseRandomState.at (oscillator)
                    = clampUnison01 (oscillatorPhaseRandomIn.at (oscillator));
                indexedRetriggerState.at (oscillator)
                    = oscillatorRetriggerIn.at (oscillator) >= 0.5f;
                indexedVolumeDbState.at (oscillator)
                    = clampAmpGainDb (oscillatorVolumeDbIn.at (oscillator));
                indexedMuteState.at (oscillator) = oscillatorMuteIn.at (oscillator) >= 0.5f;
                indexedSoloState.at (oscillator) = oscillatorSoloIn.at (oscillator) >= 0.5f;
                indexedPanState.at (oscillator) = clampPan (oscillatorPanIn.at (oscillator));
                indexedUnisonDetuneState.at (oscillator)
                    = clampUnison01 (oscillatorUnisonDetuneIn.at (oscillator));
                indexedUnisonBlendState.at (oscillator)
                    = clampUnison01 (oscillatorUnisonBlendIn.at (oscillator));
                indexedUnisonWidthState.at (oscillator)
                    = clampUnison01 (oscillatorUnisonWidthIn.at (oscillator));
                indexedUnisonDetuneModeState.at (oscillator)
                    = resolveUnisonDetuneMode (oscillatorUnisonDetuneModeIn.at (oscillator));
                indexedUnisonStackModeState.at (oscillator)
                    = resolveUnisonStackMode (oscillatorUnisonStackModeIn.at (oscillator));
                indexedPositionSpreadState.at (oscillator)
                    = clampUnison01 (oscillatorUnisonWavetablePositionSpreadIn.at (oscillator));
                indexedWarpSpreadState.at (oscillator)
                    = clampUnison01 (oscillatorUnisonWarpSpreadIn.at (oscillator));
            }
            indexedFilterModeState = resolveFilterMode (filterModeIn);
            indexedFilterCutoffState = clampFilterCutoffHz (filterCutoffIn, float32 (processor.frequency));
            indexedFilterKeyTrackOffsetSemitonesState = std::intrinsics::clamp (
                filterCutoffKeyTrackOffsetSemitonesIn, -60.0f, 60.0f);
            indexedFilterQState = clampFilterQ (filterQIn);
            indexedMsegMorphState[0] = std::intrinsics::clamp (mseg1MorphIn, 0.0f, 1.0f);
            indexedMsegMorphState[1] = std::intrinsics::clamp (mseg2MorphIn, 0.0f, 1.0f);
            indexedMsegMorphState[2] = std::intrinsics::clamp (mseg3MorphIn, 0.0f, 1.0f);
            for (int32 slotIndex = 0; slotIndex < modulationMsegSlotCount; ++slotIndex)
                indexedMsegRateState.at (slotIndex) = std::intrinsics::clamp (msegRateIn.at (slotIndex), 0.0f, 2.0f);
            for (int32 slotIndex = 0; slotIndex < modulationEnvSlotCount; ++slotIndex)
            {
                currentEnvelopeAttackSeconds.at (slotIndex) = std::intrinsics::clamp (envelopeAttackIn.at (slotIndex), 0.001f, 10.0f);
                currentEnvelopeDecaySeconds.at (slotIndex) = std::intrinsics::clamp (envelopeDecayIn.at (slotIndex), 0.001f, 10.0f);
                currentEnvelopeSustain.at (slotIndex) = std::intrinsics::clamp (envelopeSustainIn.at (slotIndex), 0.0f, 1.0f);
                currentEnvelopeReleaseSeconds.at (slotIndex) = std::intrinsics::clamp (envelopeReleaseIn.at (slotIndex), 0.001f, 10.0f);
            }
        }

        int32 oscillatorMipIndex (int32 oscillatorIndex, int32 mipIndex)
        {
            return (oscillatorIndex * mipLevelCount) + mipIndex;
        }

        int32 packedSlotMipIndex (int32 slotIndex, int32 mipIndex)
        {
            return (slotIndex * mipLevelCount) + mipIndex;
        }

        int32 packedReadinessIndex (int32 slotIndex, int32 mipIndex, int32 uploadedFrameIndex)
        {
            return (slotIndex * mipLevelCount * wavetableFrameCapacity)
                 + (mipIndex * wavetableFrameCapacity) + uploadedFrameIndex;
        }

        int32 packedMipLength (int32 mipIndex)
        {
            let harmonicLength = (1 << std::intrinsics::clamp (mipIndex, 0, mipLevelCount - 1)) * 32;
            return std::intrinsics::min (
                samplesPerFrame, std::intrinsics::max (256, harmonicLength));
        }

        int32 packedMipOffset (int32 mipIndex)
        {
            int32 offset = 0;

            for (int32 previousMip = 0; previousMip < mipIndex; ++previousMip)
                offset += (packedMipLength (previousMip) + 1) * wavetableFrameCapacity;

            return offset;
        }

        int32 packedFrameBase (int32 mipIndex, int32 uploadedFrameIndex)
        {
            return packedMipOffset (mipIndex)
                 + uploadedFrameIndex * (packedMipLength (mipIndex) + 1);
        }

        int32 quantisePackedSourceValue (float32 value, float32 inverseScale, int32 maximum)
        {
            let scaled = value * inverseScale;
            return std::intrinsics::clamp (
                int32 (scaled + (scaled >= 0.0f ? 0.5f : -0.5f)), -maximum, maximum);
        }

        int32 packSourcePoint (float32 value, float32 derivative)
        {
            let valueBits = quantisePackedSourceValue (
                value, float32 (packedSourceValueMaximum) / 1.5f, packedSourceValueMaximum)
                & 0x3ffff;
            let derivativeBits = quantisePackedSourceValue (
                derivative, float32 (packedSourceDerivativeMaximum) / 0.5f,
                packedSourceDerivativeMaximum);
            return valueBits | (derivativeBits << packedSourceValueBits);
        }

        void writePackedPoolPoint (int32 slotIndex, int32 pointIndex, int32 packedPoint)
        {
            let chunkIndex = pointIndex / packedWavetableChunkSampleCount;
            let indexWithinChunk = pointIndex % packedWavetableChunkSampleCount;

            if (slotIndex == 0)
            {
                if (chunkIndex == 0) packedSlot0Chunk0.at (indexWithinChunk) = packedPoint;
                else if (chunkIndex == 1) packedSlot0Chunk1.at (indexWithinChunk) = packedPoint;
                else if (chunkIndex == 2) packedSlot0Chunk2.at (indexWithinChunk) = packedPoint;
                else packedSlot0Chunk3.at (indexWithinChunk) = packedPoint;
            }
            else if (slotIndex == 1)
            {
                if (chunkIndex == 0) packedSlot1Chunk0.at (indexWithinChunk) = packedPoint;
                else if (chunkIndex == 1) packedSlot1Chunk1.at (indexWithinChunk) = packedPoint;
                else if (chunkIndex == 2) packedSlot1Chunk2.at (indexWithinChunk) = packedPoint;
                else packedSlot1Chunk3.at (indexWithinChunk) = packedPoint;
            }
            else if (slotIndex == 2)
            {
                if (chunkIndex == 0) packedSlot2Chunk0.at (indexWithinChunk) = packedPoint;
                else if (chunkIndex == 1) packedSlot2Chunk1.at (indexWithinChunk) = packedPoint;
                else if (chunkIndex == 2) packedSlot2Chunk2.at (indexWithinChunk) = packedPoint;
                else packedSlot2Chunk3.at (indexWithinChunk) = packedPoint;
            }
            else
            {
                if (chunkIndex == 0) packedSlot3Chunk0.at (indexWithinChunk) = packedPoint;
                else if (chunkIndex == 1) packedSlot3Chunk1.at (indexWithinChunk) = packedPoint;
                else if (chunkIndex == 2) packedSlot3Chunk2.at (indexWithinChunk) = packedPoint;
                else packedSlot3Chunk3.at (indexWithinChunk) = packedPoint;
            }
        }

        bool hasValidWavetableBatchSamples (const float32[] sourceSamples,
                                            int32 batchFrameCount)
        {
            for (int32 batchFrameIndex = 0; batchFrameIndex < batchFrameCount; ++batchFrameIndex)
            {
                for (int32 sampleIndex = 0; sampleIndex < samplesPerFrame; ++sampleIndex)
                    if (! isFiniteRuntimeValue (
                            sourceSamples.at ((batchFrameIndex * samplesPerFrame) + sampleIndex)))
                        return false;
            }

            return true;
        }

        void writePackedMipFrame (int32 slotIndex,
                                  int32 mipIndex,
                                  int32 uploadedFrameIndex,
                                  int32 sourceBase,
                                  const float32[] sourceSamples)
        {
            let length = packedMipLength (mipIndex);
            let sourceStep = samplesPerFrame / length;
            let destinationBase = packedFrameBase (mipIndex, uploadedFrameIndex);

            for (int32 pointIndex = 0; pointIndex <= length; ++pointIndex)
            {
                let wrappedPoint = pointIndex == length ? 0 : pointIndex;
                let sourceIndex = wrappedPoint * sourceStep;
                let previousIndex = sourceIndex - sourceStep < 0
                    ? sourceIndex - sourceStep + samplesPerFrame
                    : sourceIndex - sourceStep;
                let nextIndex = sourceIndex + sourceStep >= samplesPerFrame
                    ? sourceIndex + sourceStep - samplesPerFrame
                    : sourceIndex + sourceStep;
                let value = sourceSamples.at (sourceBase + sourceIndex);
                let derivative = 0.5f * (
                    sourceSamples.at (sourceBase + nextIndex)
                  - sourceSamples.at (sourceBase + previousIndex));
                writePackedPoolPoint (
                    slotIndex, destinationBase + pointIndex, packSourcePoint (value, derivative));
            }
        }

        void clearPackedSlotState (int32 slotIndex)
        {
            for (int32 index = 0; index < mipLevelCount * wavetableFrameCapacity; ++index)
                packedReadyFrameFlags.at (
                    (slotIndex * mipLevelCount * wavetableFrameCapacity) + index) = 0;

            for (int32 mipIndex = 0; mipIndex < mipLevelCount; ++mipIndex)
                packedLoadedFrameCounts.at (packedSlotMipIndex (slotIndex, mipIndex)) = 0;
        }

        void clearOscillatorMipRequestState (int32 oscillatorIndex)
        {
            for (int32 mipIndex = 0; mipIndex < mipLevelCount; ++mipIndex)
            {
                let requestIndex = oscillatorMipIndex (oscillatorIndex, mipIndex);
                oscillatorRequestedGenerationByMip.at (requestIndex) = 0;
                oscillatorRequestedUrgencyByMip.at (requestIndex) = -1;
            }
        }

        int32 findSparePackedSlot()
        {
            for (int32 slotIndex = 0; slotIndex < wavetableSlotCount; ++slotIndex)
            {
                bool active = false;

                for (wrap<oscillatorCount> oscillator)
                    if (oscillatorActiveSlot.at (oscillator) == slotIndex)
                        active = true;

                if (! active)
                    return slotIndex;
            }

            return -1;
        }

        bool isPackedStagingComplete()
        {
            if (tableStagingOscillatorIndex < 0 || tableStagingSlotIndex < 0
                || tableStagingGeneration <= 0 || tableStagingFrameCount <= 0)
                return false;

            for (int32 mipIndex = 0; mipIndex < mipLevelCount; ++mipIndex)
                if (packedLoadedFrameCounts.at (packedSlotMipIndex (
                        tableStagingSlotIndex, mipIndex)) < tableStagingFrameCount)
                    return false;

            return true;
        }

        int32 oscillatorVoiceIndex (int32 voiceIndex, int32 oscillatorIndex)
        {
            return (int32 (wrap<voiceCount> (voiceIndex)) * oscillatorCount)
                 + int32 (wrap<oscillatorCount> (oscillatorIndex));
        }

        int32 oscillatorLaneIndex (int32 voiceIndex, int32 oscillatorIndex, int32 subVoiceIndex)
        {
            return (oscillatorVoiceIndex (voiceIndex, oscillatorIndex) * maxUnisonVoiceCount)
                 + int32 (wrap<maxUnisonVoiceCount> (subVoiceIndex));
        }

        int32 resolveUnisonVoices (float32 rawVoices)
        {
            return std::intrinsics::clamp (
                int32 (std::intrinsics::floor (rawVoices + 0.5f)),
                1,
                maxUnisonVoiceCount
            );
        }

        int32 resolveUnisonPhaseMode (float32 rawMode)
        {
            return std::intrinsics::clamp (
                int32 (std::intrinsics::floor (rawMode + 0.5f)),
                unisonPhaseModeContiguous,
                unisonPhaseModeReset
            );
        }

        int32 resolveUnisonDetuneMode (float32 rawMode)
        {
            return std::intrinsics::clamp (
                int32 (std::intrinsics::floor (rawMode + 0.5f)),
                unisonDetuneModeLinear,
                unisonDetuneModeRandom
            );
        }

        int32 resolveUnisonStackMode (float32 rawMode)
        {
            return std::intrinsics::clamp (
                int32 (std::intrinsics::floor (rawMode + 0.5f)),
                unisonStackModeOff,
                unisonStackModeCenterTwoOctaves
            );
        }

        float32 clampUnison01 (float32 value)
        {
            return std::intrinsics::clamp (value, 0.0f, 1.0f);
        }

        float32 oscillatorFramePosition (int32 oscillatorIndex)
        {
            let oscillator = wrap<oscillatorCount> (oscillatorIndex);
            return indexedFramePositionState.at (oscillator);
        }

        int32 oscillatorWarpMode (int32 oscillatorIndex)
        {
            let oscillator = wrap<oscillatorCount> (oscillatorIndex);
            return indexedWarpModeState.at (oscillator);
        }

        float32 oscillatorWarpAmount (int32 oscillatorIndex)
        {
            let oscillator = wrap<oscillatorCount> (oscillatorIndex);
            return indexedWarpAmountState.at (oscillator);
        }

        float32 oscillatorPan (int32 oscillatorIndex)
        {
            let oscillator = wrap<oscillatorCount> (oscillatorIndex);
            return indexedPanState.at (oscillator);
        }

        int32 oscillatorUnisonVoices (int32 oscillatorIndex)
        {
            let oscillator = wrap<oscillatorCount> (oscillatorIndex);
            return indexedUnisonVoicesState.at (oscillator);
        }

        float32 oscillatorUnisonDetune (int32 oscillatorIndex)
        {
            let oscillator = wrap<oscillatorCount> (oscillatorIndex);
            return indexedUnisonDetuneState.at (oscillator);
        }

        float32 oscillatorUnisonBlend (int32 oscillatorIndex)
        {
            let oscillator = wrap<oscillatorCount> (oscillatorIndex);
            return indexedUnisonBlendState.at (oscillator);
        }

        float32 oscillatorUnisonWidth (int32 oscillatorIndex)
        {
            let oscillator = wrap<oscillatorCount> (oscillatorIndex);
            return indexedUnisonWidthState.at (oscillator);
        }

        int32 oscillatorUnisonDetuneMode (int32 oscillatorIndex)
        {
            let oscillator = wrap<oscillatorCount> (oscillatorIndex);
            return indexedUnisonDetuneModeState.at (oscillator);
        }

        int32 oscillatorUnisonStackMode (int32 oscillatorIndex)
        {
            let oscillator = wrap<oscillatorCount> (oscillatorIndex);
            return indexedUnisonStackModeState.at (oscillator);
        }

        float32 oscillatorPositionSpread (int32 oscillatorIndex)
        {
            let oscillator = wrap<oscillatorCount> (oscillatorIndex);
            return indexedPositionSpreadState.at (oscillator);
        }

        float32 oscillatorWarpSpread (int32 oscillatorIndex)
        {
            let oscillator = wrap<oscillatorCount> (oscillatorIndex);
            return indexedWarpSpreadState.at (oscillator);
        }

        float32 oscillatorTuningSemitones (int32 oscillatorIndex)
        {
            let oscillator = wrap<oscillatorCount> (oscillatorIndex);
            let octave = int32 (std::intrinsics::floor (indexedOctaveState.at (oscillator) + 0.5f));
            let semitone = int32 (std::intrinsics::floor (indexedSemitoneState.at (oscillator) + 0.5f));
            let fineCents = indexedFineCentsState.at (oscillator);
            return float32 ((octave * 12) + semitone) + fineCents * 0.01f;
        }

        bool anyOscillatorSoloed()
        {
            for (wrap<oscillatorCount> oscillator)
                if (oscillatorSoloIn.at (oscillator) >= 0.5f)
                    return true;

            return false;
        }

        bool oscillatorIsAudible (int32 oscillatorIndex, bool hasSolo)
        {
            let oscillator = wrap<oscillatorCount> (oscillatorIndex);
            return oscillatorMuteIn.at (oscillator) < 0.5f
                && (! hasSolo || oscillatorSoloIn.at (oscillator) >= 0.5f);
        }

        float32 oscillatorVolumeDb (int32 oscillatorIndex)
        {
            let oscillator = wrap<oscillatorCount> (oscillatorIndex);
            return oscillatorVolumeDbIn.at (oscillator);
        }

        int32 voiceArticulationOscillatorIndex (int32 voiceIndex, int32 oscillatorIndex)
        {
            return (voiceIndex * oscillatorCount) + oscillatorIndex;
        }

        float32 voiceOscillatorFramePosition (int32 voiceIndex, int32 oscillatorIndex)
        {
            let voice = wrap<voiceCount> (voiceIndex);
            let index = voiceArticulationOscillatorIndex (
                int32 (voice), int32 (wrap<oscillatorCount> (oscillatorIndex)));
            return voiceUsesArticulation.at (voice)
                ? voiceArticulationFramePositions.at (index)
                : oscillatorFramePosition (oscillatorIndex);
        }

        int32 voiceOscillatorWarpMode (int32 voiceIndex, int32 oscillatorIndex)
        {
            let voice = wrap<voiceCount> (voiceIndex);
            let index = voiceArticulationOscillatorIndex (
                int32 (voice), int32 (wrap<oscillatorCount> (oscillatorIndex)));
            return voiceUsesArticulation.at (voice)
                ? voiceArticulationWarpModes.at (index)
                : oscillatorWarpMode (oscillatorIndex);
        }

        float32 voiceOscillatorWarpAmount (int32 voiceIndex, int32 oscillatorIndex)
        {
            let voice = wrap<voiceCount> (voiceIndex);
            let index = voiceArticulationOscillatorIndex (
                int32 (voice), int32 (wrap<oscillatorCount> (oscillatorIndex)));
            return voiceUsesArticulation.at (voice)
                ? voiceArticulationWarpAmounts.at (index)
                : oscillatorWarpAmount (oscillatorIndex);
        }

        float32 voiceOscillatorPan (int32 voiceIndex, int32 oscillatorIndex)
        {
            let voice = wrap<voiceCount> (voiceIndex);
            let index = voiceArticulationOscillatorIndex (
                int32 (voice), int32 (wrap<oscillatorCount> (oscillatorIndex)));
            return voiceUsesArticulation.at (voice)
                ? voiceArticulationPans.at (index)
                : oscillatorPan (oscillatorIndex);
        }

