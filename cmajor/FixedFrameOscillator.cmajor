        int32[voiceCount] voiceEffectiveUnisonStackMode;
        float32[voiceCount] voiceEffectiveUnisonWavetablePositionSpread;
        float32[voiceCount] voiceEffectiveUnisonWarpSpread;
        float32[voiceCount] voiceMsegProgress1;
