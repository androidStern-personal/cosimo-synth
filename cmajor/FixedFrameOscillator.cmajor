namespace wt
{
    let samplesPerFrame = 2048;
    // Protocol twin: WAVETABLE_MIP_FRAME_BATCH_SIZE in ui/worker/wavetable-worker.ts.
    // Measured against the native performer's 64 KiB input FIFO (QuickJS
    // restore probe, 2026-08-21): ONE 24 KiB three-frame payload in flight is
    // the reliable ceiling — batch 4 or 5, or two batches in flight, starve
    // alongside the session's other event traffic and the probe deadline
    // fails. The window default therefore stays 1; the win is the batching.
    let wavetableMipFrameBatchSize = 3;
    let wavetableMipFrameBatchSampleCount = wavetableMipFrameBatchSize * samplesPerFrame;
    let paddedFrameSize = samplesPerFrame + 3;
    let mipLevelCount = 11;
    let brightestMipIndex = mipLevelCount - 1;
    let maxMipHarmonics = 1 << brightestMipIndex;
    let maxFramesPerTable = 256;
    let maxMipSampleCount = paddedFrameSize * maxFramesPerTable;
    let maxMipFrameSlots = mipLevelCount * maxFramesPerTable;
    let tableBankCount = 2;
    let maxBankedMipFrameSlots = maxMipFrameSlots * tableBankCount;
    let maxBankedMipLevelSlots = mipLevelCount * tableBankCount;
    let warpModeOff = 0;
    let warpModeBend = 1;
    let warpModePWM = 2;
    let warpModeAsym = 3;
    let warpModeMirror = 4;
    let filterModeOff = 0;
    let filterModeLowpass = 1;
    let filterModeHighpass = 2;
    let filterModeBandpass = 3;
    let filterModeNotch = 4;
    let filterModePeak = 5;
    let filterCutoffMinHz = 20.0f;
    let filterCutoffMaxHz = 20000.0f;
    let filterQMin = 0.1f;
    let filterQMax = 20.0f;
    let oscillatorCount = 3;
    let oscillatorA = 0;
    let oscillatorB = 1;
    let oscillatorC = 2;
    // Three independently published tables plus one bounded replacement slot.
    let wavetableSlotCount = oscillatorCount + 1;
    let packedSourceValueBits = 18;
    let packedSourceDerivativeBits = 32 - packedSourceValueBits;
    let packedSourceValueMaximum = (1 << (packedSourceValueBits - 1)) - 1;
    let packedSourceDerivativeMaximum = (1 << (packedSourceDerivativeBits - 1)) - 1;
    // Each mip frame stores one endpoint after the cycle body. Dark mips use
    // shorter power-of-two cycles; every length divides the 2048-sample upload.
    let packedWavetableSamplesPerFrameSet = 12811;
    let packedWavetableChunkCount = 4;
    let modulationMsegSlotCount = 3;
    let modulationEnvSlotCount = 3;
    // Existing source indexes are frozen. The Amp Envelope is append-only at
    // index 9 so stored modulation.v6 programs keep their exact meaning.
    let modulationVoiceSourceCount = 10;
    let modulationMacroSourceCount = 4;
    // Runtime order matches ui/shared/modulation-targets.ts: ten local targets
    // for each oscillator, the two established shared filter targets, the
    // continuous MSEG/envelope controls, append-only Filter Mix and Global
    // Tune, the complete Amp Envelope controls, then T62's three append-only
    // per-voice Enhancer destinations.
    let modulationOscillatorTargetCount = 10;
    let modulationVoiceTargetCount = (oscillatorCount * modulationOscillatorTargetCount) + 29;
    // Keep the established 32-wide SIMD block intact and place appended
    // destinations in a second padded SIMD block. A single 59-wide
    // vector scalarises in the pinned browser backend and cannot meet the
    // production AudioWorklet deadline.
    let modulationVoiceCoreLaneCount = 32;
    let modulationVoiceGeneratorLaneCount = 32;
    // Shared rack destination domain. Kept here because several isolated oscillator
    // tests compile this module without VoiceReducer.cmajor.
    // The bus is the STATIC vocabulary (39 append-only base-module destinations,
    // VoiceReducer.cmajor) plus the Effects Lane pool block: one lane per
    // modulatable pool destination (M1: delay #2's four). Cell math, program
    // validation, and the rackMod bus all run at the TOTAL width; the static
    // count remains the contiguous named-vocabulary pin.
    let rackModStaticTargetCount = 39;
    // Effects Lane pool sizing lives HERE with the other shared wire
    // constants: lanePoolSetCount ADDITIONAL resident instances per type,
    // each set mirroring the static vocabulary on the bus.
    let lanePoolSetCount = 4;
    let laneModPoolTargetCount = lanePoolSetCount * rackModStaticTargetCount;
    let rackModTargetCount = rackModStaticTargetCount + laneModPoolTargetCount;
    // SIMD discipline (see the 32-wide note above): rack vectors stay at the
    // proven static width and the pool adds whole BLOCKS of it — one 39-wide
    // vector per mirror set, never one wide vector that scalarises.
    let rackModBlockCount = 1 + lanePoolSetCount;
    // Uniform instance count per effect type: ordinal 0 is the (former) base
    // instance, ordinals 1..lanePoolSetCount are the pool sets.
    let lanePoolInstanceCount = 1 + lanePoolSetCount;
    let modulationVoiceRouteCellCount = modulationVoiceSourceCount * modulationVoiceTargetCount;
    let modulationMacroVoiceRouteCellCount = modulationMacroSourceCount * modulationVoiceTargetCount;
    let modulationVoiceRackRouteCellCount = modulationVoiceSourceCount * rackModTargetCount;
    let modulationMacroRackRouteCellCount = modulationMacroSourceCount * rackModTargetCount;

    // Wire ROUTE CAPACITY for the two rack tables. Their per-route upload
    // arrays are deliberately NOT sized as the full source x target matrix:
    // at the 195-wide pooled target bus that matrix put the program upload at
    // 68KB, and cmaj::Patch's native performer event FIFO is a fixed 64KB —
    // the event could never be delivered on the native (iPhone) transport.
    // The budget covers the ENTIRE 39-target static domain active at once
    // (the shipping 1,330-route stress contract needs 390 voice-rack and 156
    // macro-rack routes) with lane-pool routes on top. The per-CELL amount
    // tables keep the full cell space: cell indexes, live amount edits and
    // the reducer vocabulary are untouched by this budget.
    let modulationVoiceRackRouteCapacity = 512;
    let modulationMacroRackRouteCapacity = 256;

    struct VoiceModulationTargets
    {
        float32<modulationVoiceCoreLaneCount> coreValues;
        float32<modulationVoiceGeneratorLaneCount> generatorValues;
    }

    struct VoiceModulationTransform
    {
        float32<modulationVoiceCoreLaneCount> coreScales;
        float32<modulationVoiceCoreLaneCount> coreBiases;
        float32<modulationVoiceGeneratorLaneCount> generatorScales;
        float32<modulationVoiceGeneratorLaneCount> generatorBiases;
    }

    struct VoiceArticulationModulationTransforms
    {
        VoiceModulationTransform[modulationVoiceSourceCount] voiceSources;
        VoiceModulationTransform[modulationMacroSourceCount] macroSources;
    }
    let modulationArticulationRouteCellCount = modulationVoiceRouteCellCount + modulationMacroVoiceRouteCellCount;
    let modulationArticulationInheritAmount = 1000000.0f;
    let articulationOscillatorFramePositionBit = 1 << 0;
    let articulationOscillatorPanBit = 1 << 1;
    let articulationOscillatorOctaveBit = 1 << 2;
    let articulationOscillatorSemitoneBit = 1 << 3;
    let articulationOscillatorFineCentsBit = 1 << 4;
    let articulationOscillatorPhaseBit = 1 << 5;
    let articulationOscillatorPhaseRandomBit = 1 << 6;
    let articulationOscillatorRetriggerBit = 1 << 7;
    let articulationOscillatorVolumeDbBit = 1 << 8;
    let articulationOscillatorMuteBit = 1 << 9;
    let articulationOscillatorSoloBit = 1 << 10;
    let articulationOscillatorWarpModeBit = 1 << 11;
    let articulationOscillatorWarpAmountBit = 1 << 12;
    let articulationOscillatorUnisonVoicesBit = 1 << 13;
    let articulationOscillatorUnisonDetuneBit = 1 << 14;
    let articulationOscillatorUnisonBlendBit = 1 << 15;
    let articulationOscillatorUnisonWidthBit = 1 << 16;
    let articulationOscillatorUnisonDetuneModeBit = 1 << 17;
    let articulationOscillatorUnisonStackModeBit = 1 << 18;
    let articulationOscillatorPositionSpreadBit = 1 << 19;
    let articulationOscillatorWarpSpreadBit = 1 << 20;
    let articulationOscillatorAllBits = (1 << 21) - 1;
    let articulationSharedFilterModeBit = 1 << 0;
    let articulationSharedFilterCutoffBit = 1 << 1;
    let articulationSharedFilterQBit = 1 << 2;
    let articulationSharedMseg1Bit = 1 << 3;
    let articulationSharedMseg2Bit = 1 << 4;
    let articulationSharedMseg3Bit = 1 << 5;
    let articulationSharedEnvelopeBitOffset = 6;
    // Append-only: the established shared articulation bits remain 0..17.
    let articulationSharedFilterKeyTrackOffsetBit = 1 << 18;
    let articulationSharedAllBits = (1 << 19) - 1;
    let modulationPathVoice = 1;
    let modulationPathMacroVoice = 2;
    let modulationPathVoiceRack = 3;
    let modulationPathMacroRack = 4;
    // Shared reducer wire values. Zero remains invalid so a zero-initialised
    // voice-to-rack instruction cannot be published accidentally.
    let modulationReducerMaximum = 1;
    let modulationReducerMean = 2;
    let modulationSourceMseg = 1;
    let modulationSourceEnv = 2;
    let modulationSourceVelocity = 3;
    let modulationSourcePressure = 4;
    let modulationSourceSlide = 5;
    let modulationSourceMacro = 6;
    let macroSlotCount = 4;
    let modulationPolarityUnipolar = 0;
    let modulationPolarityBipolar = 1;
    let runtimeInstallRejectionNone = 0;
    let runtimeInstallRejectionSession = 1;
    let runtimeInstallRejectionGap = 2;
    let runtimeInstallRejectionInvalid = 3;
    let modulationTargetWavetablePosition = 0;
    let modulationTargetWarpAmount = 1;
    let modulationTargetPitchSemitones = 2;
    let modulationTargetAmpGainDb = 3;
    let modulationTargetPan = 4;
    let modulationTargetUnisonDetune = 5;
    let modulationTargetUnisonBlend = 6;
    let modulationTargetUnisonWidth = 7;
    let modulationTargetUnisonWavetablePositionSpread = 8;
    let modulationTargetUnisonWarpSpread = 9;
    let modulationTargetFilterCutoffOctaves = oscillatorCount * modulationOscillatorTargetCount;
    let modulationTargetFilterQ = modulationTargetFilterCutoffOctaves + 1;
    let modulationTargetMseg1Morph = modulationTargetFilterQ + 1;
    let modulationTargetMseg2Morph = modulationTargetMseg1Morph + 1;
    let modulationTargetMseg3Morph = modulationTargetMseg2Morph + 1;
    let modulationTargetMseg1Rate = modulationTargetMseg3Morph + 1;
    let modulationTargetMseg2Rate = modulationTargetMseg1Rate + 1;
    let modulationTargetMseg3Rate = modulationTargetMseg2Rate + 1;
    let modulationTargetEnv1Attack = modulationTargetMseg3Rate + 1;
    let modulationTargetEnv1Decay = modulationTargetEnv1Attack + 1;
    let modulationTargetEnv1Sustain = modulationTargetEnv1Decay + 1;
    let modulationTargetEnv1Release = modulationTargetEnv1Sustain + 1;
    let modulationTargetEnv2Attack = modulationTargetEnv1Release + 1;
    let modulationTargetEnv2Decay = modulationTargetEnv2Attack + 1;
    let modulationTargetEnv2Sustain = modulationTargetEnv2Decay + 1;
    let modulationTargetEnv2Release = modulationTargetEnv2Sustain + 1;
    let modulationTargetEnv3Attack = modulationTargetEnv2Release + 1;
    let modulationTargetEnv3Decay = modulationTargetEnv3Attack + 1;
    let modulationTargetEnv3Sustain = modulationTargetEnv3Decay + 1;
    let modulationTargetEnv3Release = modulationTargetEnv3Sustain + 1;
    let modulationTargetFilterMix = modulationTargetEnv3Release + 1;
    let modulationTargetGlobalTuneSemitones = modulationTargetFilterMix + 1;
    let modulationTargetAmpAttack = modulationTargetGlobalTuneSemitones + 1;
    let modulationTargetAmpDecay = modulationTargetAmpAttack + 1;
    let modulationTargetAmpSustain = modulationTargetAmpDecay + 1;
    let modulationTargetAmpRelease = modulationTargetAmpSustain + 1;
    let modulationTargetVoiceEnhancerFrequencyOctaves = modulationTargetAmpRelease + 1;
    let modulationTargetVoiceEnhancerQ = modulationTargetVoiceEnhancerFrequencyOctaves + 1;
    let modulationTargetVoiceEnhancerAmount = modulationTargetVoiceEnhancerQ + 1;
    let articulationSlotCount = 128;
    let articulationSelectorNone = -1;
    // Frozen Cmajor/native address book for the 16-note, three-oscillator
    // external renderer. The table ABI is slot-major and remains 16 fixed
    // chunks; chunking is deliberately invisible to product state and UI.
    let rendererLaneCount = 16 * oscillatorCount * 8;
    let rendererFamilyBatchCount = rendererLaneCount / 4;
    let rendererHistoryCount = 16 * 4 * 79;
    let rendererPhaseOffset = 0;
    let rendererHistoryOffset = rendererPhaseOffset + rendererLaneCount;
    let rendererAtlasFamilyMixOffset = rendererHistoryOffset + rendererHistoryCount;
    let rendererCachedAtlasPhaseIncrementOffset = rendererAtlasFamilyMixOffset + rendererFamilyBatchCount;
    let rendererCachedAtlasWarpAmountOffset = rendererCachedAtlasPhaseIncrementOffset + rendererLaneCount;
    let rendererAtlasAmountWeight0Offset = rendererCachedAtlasWarpAmountOffset + rendererLaneCount;
    let rendererAtlasAmountWeight1Offset = rendererAtlasAmountWeight0Offset + rendererLaneCount;
    let rendererAtlasAmountWeight2Offset = rendererAtlasAmountWeight1Offset + rendererLaneCount;
    let rendererPhaseIncrementOffset = rendererAtlasAmountWeight2Offset + rendererLaneCount;
    let rendererPositionOffset = rendererPhaseIncrementOffset + rendererLaneCount;
    let rendererWarpAmountOffset = rendererPositionOffset + rendererLaneCount;
    let rendererLeftGainOffset = rendererWarpAmountOffset + rendererLaneCount;
    let rendererRightGainOffset = rendererLeftGainOffset + rendererLaneCount;
    let rendererAtlasDcOffset = rendererRightGainOffset + rendererLaneCount;
    let rendererAtlasBasis0Offset = rendererAtlasDcOffset + rendererLaneCount;
    let rendererAtlasBasis1Offset = rendererAtlasBasis0Offset + rendererLaneCount;
    let rendererAtlasBasis2Offset = rendererAtlasBasis1Offset + rendererLaneCount;
    let rendererAtlasBasis3Offset = rendererAtlasBasis2Offset + rendererLaneCount;
    let rendererVoiceOscillatorCount = 16 * oscillatorCount;
    let rendererBasePhaseIncrementOffset = rendererAtlasBasis3Offset + rendererLaneCount;
    let rendererBasePositionOffset = rendererBasePhaseIncrementOffset + rendererVoiceOscillatorCount;
    let rendererBaseWarpAmountOffset = rendererBasePositionOffset + rendererVoiceOscillatorCount;
    let rendererBasePanOffset = rendererBaseWarpAmountOffset + rendererVoiceOscillatorCount;
    let rendererOscillatorGainOffset = rendererBasePanOffset + rendererVoiceOscillatorCount;
    let rendererUnisonDetuneOffset = rendererOscillatorGainOffset + rendererVoiceOscillatorCount;
    let rendererUnisonBlendOffset = rendererUnisonDetuneOffset + rendererVoiceOscillatorCount;
    let rendererUnisonWidthOffset = rendererUnisonBlendOffset + rendererVoiceOscillatorCount;
    let rendererPositionSpreadOffset = rendererUnisonWidthOffset + rendererVoiceOscillatorCount;
    let rendererWarpSpreadOffset = rendererPositionSpreadOffset + rendererVoiceOscillatorCount;
    let rendererNoteOutputOffset = rendererWarpSpreadOffset + rendererVoiceOscillatorCount;
    let rendererPackedFloatCount = rendererNoteOutputOffset + (16 * 2);
    let rendererWriteIndexOffset = 0;
    let rendererAtlasFamilyTargetOffset = rendererWriteIndexOffset + 16;
    let rendererCachedAtlasModeOffset = rendererAtlasFamilyTargetOffset + rendererFamilyBatchCount;
    let rendererAtlasLengthOffset = rendererCachedAtlasModeOffset + rendererLaneCount;
    let rendererAtlasAmountBase0Offset = rendererAtlasLengthOffset + rendererLaneCount;
    let rendererAtlasAmountBase1Offset = rendererAtlasAmountBase0Offset + rendererLaneCount;
    let rendererAtlasAmountBase2Offset = rendererAtlasAmountBase1Offset + rendererLaneCount;
    let rendererWarpModeOffset = rendererAtlasAmountBase2Offset + rendererLaneCount;
    let rendererNoteOscillatorModeCount = 16 * oscillatorCount;
    let rendererOscillatorSlotOffset = rendererWarpModeOffset + rendererNoteOscillatorModeCount;
    let rendererMipOffsetOffset = rendererOscillatorSlotOffset + oscillatorCount;
    let rendererMipLengthOffset = rendererMipOffsetOffset + (wavetableSlotCount * mipLevelCount);
    let rendererFrameCountOffset = rendererMipLengthOffset + (wavetableSlotCount * mipLevelCount);
    let rendererOversampleFactorOffset = rendererFrameCountOffset + wavetableSlotCount;
    let rendererUse441FilterOffset = rendererOversampleFactorOffset + 1;
    let rendererUnisonVoicesOffset = rendererUse441FilterOffset + 1;
    let rendererUnisonDetuneModeOffset = rendererUnisonVoicesOffset + rendererVoiceOscillatorCount;
    let rendererUnisonStackModeOffset = rendererUnisonDetuneModeOffset + rendererVoiceOscillatorCount;
    let rendererPackedIntCount = rendererUnisonStackModeOffset + rendererVoiceOscillatorCount;
    let maxUnisonVoiceCount = 8;
    let unisonPhaseModeContiguous = 0;
    let unisonPhaseModeReset = 1;
    let unisonDetuneModeLinear = 0;
    let unisonDetuneModeSuper = 1;
    let unisonDetuneModeExp = 2;
    let unisonDetuneModeInv = 3;
    let unisonDetuneModeRandom = 4;
    let unisonStackModeOff = 0;
    let unisonStackModeOctaves = 1;
    let unisonStackModeOctavesFifths = 2;
    let unisonStackModeCenterOctave = 3;
    let unisonStackModeCenterTwoOctaves = 4;
    let warpOversampleFactor = 8;
    let warpDecimatorTapCount = 257;
    let warpDecimatorCutoffNyquist = 0.125f;

    // BounceBankStore Path B: immutable, packed stereo PCM banks live in two
    // fixed slots. The inactive slot is the only upload target, so an abort
    // cannot damage the audible bank and commit is one bounded slot flip.
    // 19 roots x 6 seconds x 48 kHz = 5,472,000 stereo frames (20.9 MiB).
    let bounceBankRootCapacity = 19;
    let bounceBankFrameCapacity = 5472000;
    let bounceBankSlotCount = 2;
    let bounceBankChunkCount = 8;
    let bounceBankChunkFrameCount = (bounceBankFrameCapacity + bounceBankChunkCount - 1)
                                  / bounceBankChunkCount;
    // Mirrors the measured reliable wavetable upload payload: one roughly
    // 24 KiB event in flight, acknowledged before the next event is sent.
    let bounceBankFrameBatchCapacity = 6000;
    let sourceModeOscillator = 0;
    let sourceModeBounce = 1;
    // A source replacement can arrive while a note is held. Fade the old
    // source to zero before changing readers, then fade the new source in.
    // This is fixed per-sample arithmetic: no allocation, lock, or unbounded
    // audio-thread work is introduced by the sampled path.
    let sourceModeFadeFrameCount = 192;
    let sourceModeFadeStep = 1.0f / float32 (sourceModeFadeFrameCount);
    let bouncePlaybackMakeupGain = 1.0f / 0.18f;
    let bounceCaptureVelocityGain = 100.0f / 127.0f;
    let bounceInstallRejectionNone = 0;
    let bounceInstallRejectionSession = 1;
    let bounceInstallRejectionGap = 2;
    let bounceInstallRejectionInvalid = 3;
    let bounceInstallRejectionBusy = 4;

    // One identity-bearing transport owns table loading for all three oscillators.
    struct OscillatorWavetableLoadBegin
    {
        int32 dspSessionId;
        int32 oscillatorIndex;
        int32 generation;
        int32 tableIndex;
        int32 frameCount;
    }

    struct OscillatorWavetableMipFrame
    {
        int32 dspSessionId;
        int32 oscillatorIndex;
        int32 generation;
        int32 tableIndex;
        int32 mipIndex;
        int32 frameIndexBase;
        int32 frameCount;
        float32[wavetableMipFrameBatchSampleCount] samples;
    }

    struct OscillatorWavetableUploadAck
    {
        int32 dspSessionId;
        int32 oscillatorIndex;
        int32 generation;
        int32 tableIndex;
        int32 mipIndex;
        int32 frameIndexBase;
        int32 frameCount;
    }

    struct OscillatorWavetableMipRequest
    {
        int32 dspSessionId;
        int32 oscillatorIndex;
        int32 generation;
        int32 tableIndex;
        int32 mipIndex;
        int32 urgencyLevel;
    }

    struct OscillatorServiceLoadAbort
    {
        int32 dspSessionId;
        int32 oscillatorIndex;
        int32 generation;
        int32 tableIndex;
        int32 failureReasonCode;
    }

    struct OscillatorRuntimeServiceState
    {
        int32 dspSessionId;
        int32 oscillatorIndex;
        int32 generationFrontier;
        int32 serviceState;
        int32 hasActive;
        int32 activeTableIndex;
        int32 activeGeneration;
        int32 hasLoading;
        int32 loadingTableIndex;
        int32 loadingGeneration;
    }

    struct BounceBankLoadBegin
    {
        int32 dspSessionId;
        int32 generation;
        int32 deliverySerial;
        int32 sampleRate;
        int32 rootCount;
        int32 totalFrameCount;
        int32[bounceBankRootCapacity] rootNotes;
        int32[bounceBankRootCapacity] rootFrameOffsets;
        int32[bounceBankRootCapacity] rootFrameCounts;
        int32[bounceBankRootCapacity] rootNoteOffFrameOffsets;
    }

    struct BounceBankFrameBatch
    {
        int32 dspSessionId;
        int32 generation;
        int32 deliverySerial;
        int32 frameIndexBase;
        int32 frameCount;
        int32[bounceBankFrameBatchCapacity] packedFrames;
    }

    struct BounceBankCommit
    {
        int32 dspSessionId;
        int32 generation;
        int32 deliverySerial;
    }

    struct BounceBankAbort
    {
        int32 dspSessionId;
        int32 generation;
        int32 deliverySerial;
        int32 failureReasonCode;
    }

    struct BounceBankUploadAck
    {
        int32 dspSessionId;
        int32 generation;
        int32 deliverySerial;
        int32 frameIndexBase;
        int32 frameCount;
        int32 receivedFrameCount;
    }

    struct BounceBankRuntimeState
    {
        int32 dspSessionId;
        int32 hasActive;
        int32 activeGeneration;
        int32 activeRootCount;
        int32 activeFrameCount;
        int32 hasStaging;
        int32 stagingGeneration;
        int32 stagingReceivedFrameCount;
        int32 stagingExpectedFrameCount;
        int32 rejectedDeliverySerial;
        int32 rejectionReason;
    }

    struct WavetableSlotMonitor
    {
        int32 oscillatorIndex;
        int32 activeSlotIndex;
        int32 tableIndex;
        int32 generation;
    }

    struct RuntimeInstallAck
    {
        int32 dspSessionId;
        int32 acceptedModulationSerial;
        int32 acceptedModulationProgramSerial;
        int32 installedVoiceRouteCount;
        int32 installedMacroVoiceRouteCount;
        int32 installedVoiceRackRouteCount;
        int32 installedMacroRackRouteCount;
        int32 acceptedArticulationSerial;
        int32 rejectedSerial;
        int32 rejectionReason;
        int32 syncSerial;
    }

    struct VoiceRetune
    {
        int32 channel;
        float32 pitch;
        float32 velocity;
        float32 bendSemitones;
        float32 pressure;
        float32 slide;
        bool retrigger, glide;
        bool hasArticulation;
        int32 selectorA;
        int32 selectorB;
        int32 durationSamples;
        int32 ageSamples;
    }

    struct ArticulatedNoteOn
    {
        int32 channel;
        float32 pitch;
        float32 velocity;
        bool hasArticulation;
        int32 selectorA;
        int32 selectorB;
        int32 durationSamples;
        int32 ageSamples;
    }

    struct ArticulationNoteMeta
    {
        int32 channel;
        int32 noteNumber;
        int32 selectorA;
        int32 selectorB;
        int32 durationSamples;
        int32 ageSamples;
    }

    struct ArticulationSnapshotUpload
    {
        int32 selectorA;
        bool enabled;
        int32[oscillatorCount] oscillatorOverrideMasks;
        int32 sharedOverrideMask;
        float32[oscillatorCount] framePositions;
        float32[oscillatorCount] pans;
        float32[oscillatorCount] octaves;
        float32[oscillatorCount] semitones;
        float32[oscillatorCount] fineCents;
        float32[oscillatorCount] phases;
        float32[oscillatorCount] phaseRandoms;
        int32[oscillatorCount] retriggers;
        float32[oscillatorCount] volumeDbs;
        int32[oscillatorCount] mutes;
        int32[oscillatorCount] solos;
        int32[oscillatorCount] warpModes;
        float32[oscillatorCount] warpAmounts;
        int32 filterMode;
        float32 filterCutoffHz;
        float32 filterQ;
        int32[oscillatorCount] unisonVoices;
        float32[oscillatorCount] unisonDetunes;
        float32[oscillatorCount] unisonBlends;
        float32[oscillatorCount] unisonWidths;
        int32[oscillatorCount] unisonDetuneModes;
        int32[oscillatorCount] unisonStackModes;
        float32[oscillatorCount] unisonWavetablePositionSpreads;
        float32[oscillatorCount] unisonWarpSpreads;
        float32[modulationMsegSlotCount] msegMorphs;
        float32[modulationArticulationRouteCellCount] routeAmounts;
        float32[modulationEnvSlotCount] envelopeAttackSeconds;
        float32[modulationEnvSlotCount] envelopeDecaySeconds;
        float32[modulationEnvSlotCount] envelopeSustain;
        float32[modulationEnvSlotCount] envelopeReleaseSeconds;
        float32 filterKeyTrackOffsetSemitones;
        int32 dspSessionId;
        int32 deliverySerial;
    }

    struct VoiceArticulationMonitor
    {
        int32 voiceIndex;
        int32 hasArticulation;
        int32 selectorA;
        int32 selectorB;
        int32 durationSamples;
        int32 ageSamples;
        float32 framePosition;
        float32 mseg1Morph;
        float32 route1Amount;
    }

    // A polyphonic note owns one atomic bundle containing oscillators A, B and C.
    // This remains an engine-internal test seam rather than a host parameter.
    struct OscillatorVoiceStartMonitor
    {
        int32 voiceIndex;
        int32 oscillatorIndex;
        int32 voiceGeneration;
        int32 channel;
        float32 pitch;
        float32 firstUnisonPhase;
        float32 lastUnisonPhase;
    }

    struct ModulationMsegBufferUpload
    {
        int32 slot;
        int32 shapeIndex;
        float32[msegPaddedSamples] buffer;
        int32 dspSessionId;
        int32 deliverySerial;
    }

    struct ModulationMsegPlaybackUpload
    {
        int32 slot;
        bool holdFinalValue;
        int32 rateKind;
        bool loopEnabled;
        float32 loopStart;
        float32 loopEnd;
        int32 noteOffPolicy;
        bool legatoRestarts;
        int32 dspSessionId;
        int32 deliverySerial;
    }

    struct ModulationProgramUpload
    {
        int32 voiceRouteCount;
        int32[modulationVoiceRouteCellCount] voiceRouteCells;
        int32[modulationVoiceRouteCellCount] voiceRouteSources;
        int32[modulationVoiceRouteCellCount] voiceRouteTargets;
        int32[modulationVoiceRouteCellCount] voiceRoutePolarities;
        float32[modulationVoiceRouteCellCount] voiceRouteAmounts;

        int32 macroVoiceRouteCount;
        int32[modulationMacroVoiceRouteCellCount] macroVoiceRouteCells;
        int32[modulationMacroVoiceRouteCellCount] macroVoiceRouteSources;
        int32[modulationMacroVoiceRouteCellCount] macroVoiceRouteTargets;
        int32[modulationMacroVoiceRouteCellCount] macroVoiceRoutePolarities;
        float32[modulationMacroVoiceRouteCellCount] macroVoiceRouteAmounts;

        int32 voiceRackRouteCount;
        int32[modulationVoiceRackRouteCapacity] voiceRackRouteCells;
        int32[modulationVoiceRackRouteCapacity] voiceRackRouteSources;
        int32[modulationVoiceRackRouteCapacity] voiceRackRouteTargets;
        int32[modulationVoiceRackRouteCapacity] voiceRackRoutePolarities;
        int32[modulationVoiceRackRouteCapacity] voiceRackRouteReducers;
        float32[modulationVoiceRackRouteCellCount] voiceRackRouteAmounts;

        int32 macroRackRouteCount;
        int32[modulationMacroRackRouteCapacity] macroRackRouteCells;
        int32[modulationMacroRackRouteCapacity] macroRackRouteSources;
        int32[modulationMacroRackRouteCapacity] macroRackRouteTargets;
        int32[modulationMacroRackRouteCapacity] macroRackRoutePolarities;
        float32[modulationMacroRackRouteCellCount] macroRackRouteAmounts;
        int32 dspSessionId;
        int32 deliverySerial;
    }

    struct ModulationAmountUpload
    {
        int32 pathKind;
        int32 cellIndex;
        float32 amount;
        int32 dspSessionId;
        int32 deliverySerial;
    }

    bool isValidModulationPolarity (int32 polarityKind)
    {
        return polarityKind == modulationPolarityUnipolar
            || polarityKind == modulationPolarityBipolar;
    }

    bool isFiniteRuntimeValue (float32 value)
    {
        return ! isnan (value) && ! isinf (value);
    }

    // Validate the complete sparse program before publishing any of it. Keeping
    // this free of processor state makes every wire invariant directly testable.
    bool isValidModulationProgram (ModulationProgramUpload& upload)
    {
        if (upload.voiceRouteCount < 0 || upload.voiceRouteCount > modulationVoiceRouteCellCount
            || upload.macroVoiceRouteCount < 0 || upload.macroVoiceRouteCount > modulationMacroVoiceRouteCellCount
            || upload.voiceRackRouteCount < 0 || upload.voiceRackRouteCount > modulationVoiceRackRouteCapacity
            || upload.macroRackRouteCount < 0 || upload.macroRackRouteCount > modulationMacroRackRouteCapacity)
            return false;

        // Amount arrays are deterministic-cell indexed, including inactive tails
        // that may later become articulation inheritance inputs. Reject poison at
        // the runtime seam before any part of the program is published.
        for (int32 cellIndex = 0; cellIndex < modulationVoiceRouteCellCount; ++cellIndex)
            if (! isFiniteRuntimeValue (upload.voiceRouteAmounts.at (cellIndex)))
                return false;

        for (int32 cellIndex = 0; cellIndex < modulationMacroVoiceRouteCellCount; ++cellIndex)
            if (! isFiniteRuntimeValue (upload.macroVoiceRouteAmounts.at (cellIndex)))
                return false;

        for (int32 cellIndex = 0; cellIndex < modulationVoiceRackRouteCellCount; ++cellIndex)
            if (! isFiniteRuntimeValue (upload.voiceRackRouteAmounts.at (cellIndex)))
                return false;

        for (int32 cellIndex = 0; cellIndex < modulationMacroRackRouteCellCount; ++cellIndex)
            if (! isFiniteRuntimeValue (upload.macroRackRouteAmounts.at (cellIndex)))
                return false;

        int32 previousCell = -1;
        for (int32 routeIndex = 0; routeIndex < upload.voiceRouteCount; ++routeIndex)
        {
            let cellIndex = upload.voiceRouteCells.at (routeIndex);
            let sourceIndex = upload.voiceRouteSources.at (routeIndex);
            let targetIndex = upload.voiceRouteTargets.at (routeIndex);
            if (cellIndex <= previousCell
                || cellIndex < 0 || cellIndex >= modulationVoiceRouteCellCount
                || sourceIndex < 0 || sourceIndex >= modulationVoiceSourceCount
                || targetIndex < 0 || targetIndex >= modulationVoiceTargetCount
                || cellIndex != (sourceIndex * modulationVoiceTargetCount) + targetIndex
                || ! isValidModulationPolarity (upload.voiceRoutePolarities.at (routeIndex)))
                return false;
            previousCell = cellIndex;
        }

        previousCell = -1;
        for (int32 routeIndex = 0; routeIndex < upload.macroVoiceRouteCount; ++routeIndex)
        {
            let cellIndex = upload.macroVoiceRouteCells.at (routeIndex);
            let sourceIndex = upload.macroVoiceRouteSources.at (routeIndex);
            let targetIndex = upload.macroVoiceRouteTargets.at (routeIndex);
            if (cellIndex <= previousCell
                || cellIndex < 0 || cellIndex >= modulationMacroVoiceRouteCellCount
                || sourceIndex < 0 || sourceIndex >= modulationMacroSourceCount
                || targetIndex < 0 || targetIndex >= modulationVoiceTargetCount
                || cellIndex != (sourceIndex * modulationVoiceTargetCount) + targetIndex
                || ! isValidModulationPolarity (upload.macroVoiceRoutePolarities.at (routeIndex)))
                return false;
            previousCell = cellIndex;
        }

        previousCell = -1;
        for (int32 routeIndex = 0; routeIndex < upload.voiceRackRouteCount; ++routeIndex)
        {
            let cellIndex = upload.voiceRackRouteCells.at (routeIndex);
            let sourceIndex = upload.voiceRackRouteSources.at (routeIndex);
            let targetIndex = upload.voiceRackRouteTargets.at (routeIndex);
            let reducerKind = upload.voiceRackRouteReducers.at (routeIndex);
            if (cellIndex <= previousCell
                || cellIndex < 0 || cellIndex >= modulationVoiceRackRouteCellCount
                || sourceIndex < 0 || sourceIndex >= modulationVoiceSourceCount
                || targetIndex < 0 || targetIndex >= rackModTargetCount
                || cellIndex != (sourceIndex * rackModTargetCount) + targetIndex
                || ! isValidModulationPolarity (upload.voiceRackRoutePolarities.at (routeIndex))
                || (reducerKind != modulationReducerMaximum && reducerKind != modulationReducerMean))
                return false;
            previousCell = cellIndex;
        }

        previousCell = -1;
        for (int32 routeIndex = 0; routeIndex < upload.macroRackRouteCount; ++routeIndex)
        {
            let cellIndex = upload.macroRackRouteCells.at (routeIndex);
            let sourceIndex = upload.macroRackRouteSources.at (routeIndex);
            let targetIndex = upload.macroRackRouteTargets.at (routeIndex);
            if (cellIndex <= previousCell
                || cellIndex < 0 || cellIndex >= modulationMacroRackRouteCellCount
                || sourceIndex < 0 || sourceIndex >= modulationMacroSourceCount
                || targetIndex < 0 || targetIndex >= rackModTargetCount
                || cellIndex != (sourceIndex * rackModTargetCount) + targetIndex
                || ! isValidModulationPolarity (upload.macroRackRoutePolarities.at (routeIndex)))
                return false;
            previousCell = cellIndex;
        }

        return true;
    }

    bool isValidArticulationSnapshot (ArticulationSnapshotUpload& upload)
    {
        if (! upload.enabled)
            return true;

        if (upload.sharedOverrideMask < 0
            || upload.sharedOverrideMask > articulationSharedAllBits
            || ! isFiniteRuntimeValue (upload.filterCutoffHz)
            || ! isFiniteRuntimeValue (upload.filterKeyTrackOffsetSemitones)
            || ! isFiniteRuntimeValue (upload.filterQ))
            return false;

        for (wrap<oscillatorCount> oscillator)
        {
            if (upload.oscillatorOverrideMasks.at (oscillator) < 0
                || upload.oscillatorOverrideMasks.at (oscillator) > articulationOscillatorAllBits
                || ! isFiniteRuntimeValue (upload.framePositions.at (oscillator))
                || ! isFiniteRuntimeValue (upload.pans.at (oscillator))
                || ! isFiniteRuntimeValue (upload.octaves.at (oscillator))
                || ! isFiniteRuntimeValue (upload.semitones.at (oscillator))
                || ! isFiniteRuntimeValue (upload.fineCents.at (oscillator))
                || ! isFiniteRuntimeValue (upload.phases.at (oscillator))
                || ! isFiniteRuntimeValue (upload.phaseRandoms.at (oscillator))
                || ! isFiniteRuntimeValue (upload.volumeDbs.at (oscillator))
                || ! isFiniteRuntimeValue (upload.warpAmounts.at (oscillator))
                || ! isFiniteRuntimeValue (upload.unisonDetunes.at (oscillator))
                || ! isFiniteRuntimeValue (upload.unisonBlends.at (oscillator))
                || ! isFiniteRuntimeValue (upload.unisonWidths.at (oscillator))
                || ! isFiniteRuntimeValue (upload.unisonWavetablePositionSpreads.at (oscillator))
                || ! isFiniteRuntimeValue (upload.unisonWarpSpreads.at (oscillator)))
                return false;
        }

        for (int32 slotIndex = 0; slotIndex < modulationMsegSlotCount; ++slotIndex)
            if (! isFiniteRuntimeValue (upload.msegMorphs.at (slotIndex)))
                return false;

        for (int32 routeIndex = 0; routeIndex < modulationArticulationRouteCellCount; ++routeIndex)
            if (! isFiniteRuntimeValue (upload.routeAmounts.at (routeIndex)))
                return false;

        for (int32 slotIndex = 0; slotIndex < modulationEnvSlotCount; ++slotIndex)
            if (! isFiniteRuntimeValue (upload.envelopeAttackSeconds.at (slotIndex))
                || ! isFiniteRuntimeValue (upload.envelopeDecaySeconds.at (slotIndex))
                || ! isFiniteRuntimeValue (upload.envelopeSustain.at (slotIndex))
                || ! isFiniteRuntimeValue (upload.envelopeReleaseSeconds.at (slotIndex)))
                return false;

        return true;
    }

    float32 catmullRom (float32 p0, float32 p1, float32 p2, float32 p3, float32 t)
    {
        return p1 + 0.5f * t * ((p2 - p0) + t * ((2.0f * p0 - 5.0f * p1 + 4.0f * p2 - p3)
               + t * (-p0 + 3.0f * p1 - 3.0f * p2 + p3)));
    }

    int32 resolveUploadedFrameCount (int32 resolvedFrameCount)
    {
        if (resolvedFrameCount < 1 || resolvedFrameCount > maxFramesPerTable)
            return 0;

        return resolvedFrameCount;
    }

    int32 resolveMipIndex (int32 requestedMipIndex)
    {
        if (requestedMipIndex < 0 || requestedMipIndex >= mipLevelCount)
            return -1;

        return requestedMipIndex;
    }

    int32 selectMipIndexFromPhaseIncrement (float32 phaseIncrement)
    {
        if (phaseIncrement <= 0.0f)
            return brightestMipIndex;

        let rawMaxHarmonics = int32 (
            std::intrinsics::floor (1.0f / (2.0f * phaseIncrement))
        );
        int32 clampedMaxHarmonics = rawMaxHarmonics;

        if (clampedMaxHarmonics < 1)
            clampedMaxHarmonics = 1;
        else if (clampedMaxHarmonics > maxMipHarmonics)
            clampedMaxHarmonics = maxMipHarmonics;

        int32 mipIndex = 0;
        int32 remainingHarmonics = clampedMaxHarmonics;

        while (remainingHarmonics > 1)
        {
            remainingHarmonics /= 2;
            mipIndex += 1;
        }

        return std::intrinsics::clamp (mipIndex, 0, brightestMipIndex);
    }

    int32 frameBase (int32 frameIndex)
    {
        return (frameIndex * paddedFrameSize);
    }

    int32 readinessIndex (int32 mipIndex, int32 frameIndex)
    {
        return (mipIndex * maxFramesPerTable) + frameIndex;
    }

    int32 normalizeTableBankIndex (int32 bankIndex)
    {
        return bankIndex == 0 ? 0 : 1;
    }

    int32 bankedReadinessIndex (int32 bankIndex, int32 mipIndex, int32 frameIndex)
    {
        return (normalizeTableBankIndex (bankIndex) * maxMipFrameSlots) + readinessIndex (mipIndex, frameIndex);
    }

    int32 bankedMipLevelIndex (int32 bankIndex, int32 mipIndex)
    {
        return (normalizeTableBankIndex (bankIndex) * mipLevelCount) + mipIndex;
    }

    float32 readFixedFrameSampleFromBase (const float[] tableSamples,
                                          int32 base,
                                          float32 phase)
    {
        let wrappedPhase = std::intrinsics::wrap (phase, 1.0f);
        let x = wrappedPhase * float32 (samplesPerFrame);
        let sampleIndex = int32 (std::intrinsics::floor (x));
        let fractional = x - float32 (sampleIndex);
        let sampleBase = base + sampleIndex;
        let p0 = tableSamples.at (sampleBase + 0);
        let p1 = tableSamples.at (sampleBase + 1);
        let p2 = tableSamples.at (sampleBase + 2);
        let p3 = tableSamples.at (sampleBase + 3);
        return catmullRom (p0, p1, p2, p3, fractional);
    }

    float32 readFixedFrameSample (const float[] tableSamples,
                                  int32 frameIndex,
                                  float32 phase)
    {
        return readFixedFrameSampleFromBase (tableSamples, frameBase (frameIndex), phase);
    }

    float32 readFrameBlendSample (const float[] tableSamples,
                                  int32 frameLo,
                                  int32 frameHi,
                                  float32 phase,
                                  float32 frameT)
    {
        let lo = readFixedFrameSample (tableSamples, frameLo, phase);

        if (frameHi == frameLo)
            return lo;

        let hi = readFixedFrameSample (tableSamples, frameHi, phase);
        return lo + (hi - lo) * frameT;
    }

    struct WarpPhaseResult
    {
        bool shouldLookup;
        bool holdCycleEndpoint;
        float32 phase;
    }

    int32 resolveFilterMode (float32 rawMode)
    {
        return std::intrinsics::clamp (
            int32 (std::intrinsics::floor (rawMode + 0.5f)),
            filterModeOff,
            filterModePeak
        );
    }

    float32 clampFilterCutoffHz (float32 cutoffHz, float32 processorFrequency)
    {
        let maxCutoffHz = std::intrinsics::min (filterCutoffMaxHz, processorFrequency * 0.48f);
        return std::intrinsics::clamp (cutoffHz, filterCutoffMinHz, maxCutoffHz);
    }

    float32 clampFilterQ (float32 q)
    {
        return std::intrinsics::clamp (q, filterQMin, filterQMax);
    }

    float32 resolveVoiceFilterMix (float32 baseMix, float32 modulationOffset)
    {
        return std::intrinsics::clamp (baseMix + modulationOffset, 0.0f, 1.0f);
    }

    float32 mixVoiceFilterSample (float32 dry, float32 filtered, float32 mix)
    {
        if (mix >= 1.0f)
            return filtered;

        if (mix <= 0.0f)
            return dry;

        return dry * (1.0f - mix) + filtered * mix;
    }

    float32 clampPan (float32 pan)
    {
        return std::intrinsics::clamp (pan, -1.0f, 1.0f);
    }

    float32 clampAmpGainDb (float32 gainDb)
    {
        return std::intrinsics::clamp (gainDb, -48.0f, 6.0f);
    }

    float32 dbToGain (float32 gainDb)
    {
        return std::intrinsics::pow (10.0f, gainDb / 20.0f);
    }

    float32 panLeftGain (float32 pan)
    {
        let normalizedPan = (clampPan (pan) + 1.0f) * 0.25f * float32 (pi);
        return std::intrinsics::cos (normalizedPan);
    }

    float32 panRightGain (float32 pan)
    {
        let normalizedPan = (clampPan (pan) + 1.0f) * 0.25f * float32 (pi);
        return std::intrinsics::sin (normalizedPan);
    }

    int32 resolveSimperFilterMode (int32 filterMode)
    {
        if (filterMode == filterModeHighpass)
            return std::filters::simper::Mode::highPass;

        if (filterMode == filterModeBandpass)
            return std::filters::simper::Mode::bandPass;

        if (filterMode == filterModeNotch)
            return std::filters::simper::Mode::notchPass;

        if (filterMode == filterModePeak)
            return std::filters::simper::Mode::peakPass;

        return std::filters::simper::Mode::lowPass;
    }

    int32 resolveWarpMode (float32 rawMode)
    {
        return std::intrinsics::clamp (
            int32 (std::intrinsics::floor (rawMode + 0.5f)),
            warpModeOff,
            warpModeMirror
        );
    }

    float32 curvedWarpRight (float32 phase, float32 amount)
    {
        let clampedPhase = std::intrinsics::clamp (phase, 0.0f, 1.0f);
        let clampedAmount = std::intrinsics::clamp (amount, 0.0f, 1.0f);
        let exponent = std::intrinsics::pow (2.0f, 4.0f * clampedAmount);
        return std::intrinsics::pow (clampedPhase, exponent);
    }

    float32 curvedWarpLeft (float32 phase, float32 amount)
    {
        let clampedPhase = std::intrinsics::clamp (phase, 0.0f, 1.0f);
        let clampedAmount = std::intrinsics::clamp (amount, 0.0f, 1.0f);
        let exponent = std::intrinsics::pow (2.0f, 4.0f * clampedAmount);
        return 1.0f - std::intrinsics::pow (1.0f - clampedPhase, exponent);
    }

    float32 curvedAsymSigned (float32 phase, float32 dial)
    {
        let clampedDial = std::intrinsics::clamp (dial, 0.0f, 1.0f);
        let signedAmount = (2.0f * clampedDial) - 1.0f;
        let magnitude = std::intrinsics::abs (signedAmount);

        if (signedAmount >= 0.0f)
            return curvedWarpRight (phase, magnitude);

        return curvedWarpLeft (phase, magnitude);
    }

    float32 linearSkewSigned (float32 phase, float32 dial)
    {
        let clampedPhase = std::intrinsics::clamp (phase, 0.0f, 1.0f);
        let clampedDial = std::intrinsics::clamp (dial, 0.0f, 1.0f);
        let signedAmount = (2.0f * clampedDial) - 1.0f;
        let split = std::intrinsics::clamp (0.5f + (0.48f * signedAmount), 0.02f, 0.98f);

        if (clampedPhase < split)
            return 0.5f * (clampedPhase / split);

        return 0.5f + (0.5f * ((clampedPhase - split) / (1.0f - split)));
    }

    float32 mirrorBasePhase (float32 phase)
    {
        let clampedPhase = std::intrinsics::clamp (phase, 0.0f, 1.0f);

        if (clampedPhase < 0.5f)
            return clampedPhase * 2.0f;

        return 2.0f - (2.0f * clampedPhase);
    }

    float32 pwmActivePortion (float32 amount)
    {
        let clampedAmount = std::intrinsics::clamp (amount, 0.0f, 1.0f);
        return 1.0f - ((1.0f - 0.02f) * clampedAmount);
    }

    bool isIdentityWarp (int32 warpMode, float32 warpAmount)
    {
        let clampedAmount = std::intrinsics::clamp (warpAmount, 0.0f, 1.0f);

        if (warpMode <= warpModeOff)
            return true;

        if (warpMode == warpModeBend)
            return std::intrinsics::abs (clampedAmount - 0.5f) <= 0.000001f;

        if (warpMode == warpModePWM)
            return clampedAmount <= 0.000001f;

        if (warpMode == warpModeAsym)
            return std::intrinsics::abs (clampedAmount - 0.5f) <= 0.000001f;

        if (warpMode == warpModeMirror)
            return false;

        return true;
    }

    WarpPhaseResult resolveWarpPhase (int32 warpMode,
                                      float32 warpAmount,
                                      float32 phase)
    {
        WarpPhaseResult result;
        let wrappedPhase = std::intrinsics::wrap (phase, 1.0f);
        result.shouldLookup = true;
        result.holdCycleEndpoint = false;
        result.phase = wrappedPhase;

        if (warpMode <= warpModeOff)
            return result;

        let clampedAmount = std::intrinsics::clamp (warpAmount, 0.0f, 1.0f);

        if (warpMode == warpModeBend)
        {
            let invertedDial = 1.0f - clampedAmount;

            if (wrappedPhase < 0.5f)
                result.phase = 0.5f * curvedAsymSigned (wrappedPhase * 2.0f, invertedDial);
            else
                result.phase = 1.0f - (0.5f * curvedAsymSigned ((2.0f - (2.0f * wrappedPhase)), invertedDial));

            return result;
        }

        if (warpMode == warpModePWM)
        {
            let activePortion = pwmActivePortion (clampedAmount);

            if (wrappedPhase < activePortion)
            {
                result.phase = wrappedPhase / activePortion;
            }
            else
            {
                result.shouldLookup = false;
                result.holdCycleEndpoint = true;
                result.phase = 1.0f;
            }

            return result;
        }

        if (warpMode == warpModeAsym)
        {
            result.phase = linearSkewSigned (wrappedPhase, clampedAmount);
            return result;
        }

        if (warpMode == warpModeMirror)
        {
            result.phase = linearSkewSigned (mirrorBasePhase (wrappedPhase), clampedAmount);
            return result;
        }

        return result;
    }

    processor RetriggerableASR (float32 attackSeconds)
    {
        input event (std::notes::NoteOn,
                     std::notes::NoteOff) eventIn;
        input value float32 releaseSecondsIn;

        output stream float32 gainOut;

        float32 keyDownVelocity, currentLevel;
        float32 lastReleaseSeconds = -1.0f;
        float32 releaseDecayFactor = 0.0f;
        int32 noteOnSerial, handledNoteOnSerial;

        event eventIn (std::notes::NoteOn noteOn)
        {
            keyDownVelocity = noteOn.velocity;
            noteOnSerial += 1;
        }

        event eventIn (std::notes::NoteOff noteOff)
        {
            keyDownVelocity = 0.0f;
        }

        void main()
        {
            int32 handledNoteOnSerial = 0;

            loop
            {
                while (keyDownVelocity == 0.0f)
                {
                    // Standalone/generated performers leave un-driven value
                    // inputs at zero rather than applying endpoint annotations.
                    // Zero is outside the public range, so preserve the legacy
                    // 0.2 s release for those engines as well as hosted ones.
                    let safeReleaseSeconds = releaseSecondsIn > 0.0f
                        ? std::intrinsics::max (0.005f, releaseSecondsIn)
                        : 0.2f;

                    // Runtime control must not turn coefficient calculation
                    // into per-sample transcendental work on every idle voice.
                    if (safeReleaseSeconds != lastReleaseSeconds)
                    {
                        lastReleaseSeconds = safeReleaseSeconds;
                        releaseDecayFactor = pow (
                            0.0001f,
                            float32 (processor.period) / safeReleaseSeconds
                        );
                    }

                    if (currentLevel > 0.0001f)
                    {
                        gainOut <- currentLevel;
                        currentLevel *= releaseDecayFactor;
                    }
                    else
                    {
                        currentLevel = 0.0f;
                        gainOut <- 0.0f;
                    }

                    advance();
                }

                handledNoteOnSerial = noteOnSerial;
                currentLevel = 0.0f;

                if const (attackSeconds > 0.0f)
                {
                    while (currentLevel < keyDownVelocity)
                    {
                        let attackExponent = 1.0f / int32 (attackSeconds * float32 (processor.frequency));
                        let attackMultiplier = 2.0f ** -attackExponent
                                               * (2.0f + keyDownVelocity) ** attackExponent;
                        gainOut <- currentLevel;
                        currentLevel = attackMultiplier * (currentLevel + 2.0f) - 2.0f;
                        advance();

                        if (keyDownVelocity == 0.0f)
                            break;

                        if (handledNoteOnSerial != noteOnSerial)
                        {
                            handledNoteOnSerial = noteOnSerial;
                            currentLevel = 0.0f;
                        }
                    }
                }
                else
                {
                    currentLevel = keyDownVelocity;
                }

                while (keyDownVelocity != 0.0f)
                {
                    gainOut <- currentLevel;
                    advance();

                    if (handledNoteOnSerial != noteOnSerial)
                        break;
                }
            }
        }
    }

    // Per-note loudness ADSR. Its attack and release equations deliberately
    // match RetriggerableASR: at A=10 ms, D=1 ms, S=1 the gain stream is
    // sample-identical to every pre-T38 sound, including velocity response.
    processor RetriggerableAmpAdsr
    {
        input event (std::notes::NoteOn,
                     std::notes::NoteOff) eventIn;
        input value float32 attackSecondsIn;
        input value float32 decaySecondsIn;
        input value float32 sustainIn;
        input value float32 releaseSecondsIn;

        output stream float32 gainOut;

        float32 keyDownVelocity, envelopeVelocity, currentLevel;
        float32 lastAttackSeconds = -1.0f;
        float32 lastAttackVelocity = -1.0f;
        float32 attackMultiplier = 0.0f;
        float32 lastReleaseSeconds = -1.0f;
        float32 releaseDecayFactor = 0.0f;
        int32 noteOnSerial;

        event eventIn (std::notes::NoteOn noteOn)
        {
            keyDownVelocity = noteOn.velocity;
            envelopeVelocity = noteOn.velocity;
            noteOnSerial += 1;
        }

        event eventIn (std::notes::NoteOff noteOff)
        {
            keyDownVelocity = 0.0f;
        }

        void emitCurrentLevel()
        {
            gainOut <- currentLevel;
        }

        float32 safeAttackSeconds()
        {
            return attackSecondsIn > 0.0f
                ? std::intrinsics::max (0.001f, attackSecondsIn)
                : 0.01f;
        }

        float32 safeDecaySeconds()
        {
            return decaySecondsIn > 0.0f
                ? std::intrinsics::max (0.001f, decaySecondsIn)
                : 0.001f;
        }

        float32 safeReleaseSeconds()
        {
            return releaseSecondsIn > 0.0f
                ? std::intrinsics::max (0.005f, releaseSecondsIn)
                : 0.2f;
        }

        void main()
        {
            int32 handledNoteOnSerial = 0;

            loop
            {
                while (keyDownVelocity == 0.0f)
                {
                    let releaseSeconds = safeReleaseSeconds();
                    if (releaseSeconds != lastReleaseSeconds)
                    {
                        lastReleaseSeconds = releaseSeconds;
                        releaseDecayFactor = pow (
                            0.0001f,
                            float32 (processor.period) / releaseSeconds
                        );
                    }

                    if (currentLevel > 0.0001f)
                    {
                        emitCurrentLevel();
                        currentLevel *= releaseDecayFactor;
                    }
                    else
                    {
                        currentLevel = 0.0f;
                        emitCurrentLevel();
                    }

                    advance();
                }

                handledNoteOnSerial = noteOnSerial;
                currentLevel = 0.0f;

                while (currentLevel < keyDownVelocity)
                {
                    let attackSeconds = safeAttackSeconds();
                    if (attackSeconds != lastAttackSeconds
                        || keyDownVelocity != lastAttackVelocity)
                    {
                        lastAttackSeconds = attackSeconds;
                        lastAttackVelocity = keyDownVelocity;
                        let attackFrameCount = std::intrinsics::max (
                            1, int32 (attackSeconds * float32 (processor.frequency))
                        );
                        let attackExponent = 1.0f / attackFrameCount;
                        attackMultiplier = 2.0f ** -attackExponent
                                         * (2.0f + keyDownVelocity) ** attackExponent;
                    }

                    emitCurrentLevel();
                    currentLevel = attackMultiplier * (currentLevel + 2.0f) - 2.0f;
                    advance();

                    if (keyDownVelocity == 0.0f)
                        break;

                    if (handledNoteOnSerial != noteOnSerial)
                    {
                        handledNoteOnSerial = noteOnSerial;
                        currentLevel = 0.0f;
                    }
                }

                if (handledNoteOnSerial != noteOnSerial)
                    continue;

                // Full sustain is the exact legacy hold representation. Skip
                // its inaudible decay stage so the old ASR stream stays bit-for-bit.
                let initialSustain = std::intrinsics::clamp (sustainIn, 0.0f, 1.0f);
                if (keyDownVelocity != 0.0f && initialSustain < 1.0f)
                {
                    let decayStartLevel = currentLevel;
                    float32 decayProgress = 0.0f;

                    while (keyDownVelocity != 0.0f && decayProgress < 1.0f)
                    {
                        let sustainLevel = std::intrinsics::clamp (sustainIn, 0.0f, 1.0f);
                        let decayTargetLevel = envelopeVelocity * sustainLevel;
                        currentLevel = decayStartLevel
                            + ((decayTargetLevel - decayStartLevel)
                                * std::intrinsics::clamp (decayProgress, 0.0f, 1.0f));
                        emitCurrentLevel();
                        decayProgress += 1.0f
                            / (safeDecaySeconds() * float32 (processor.frequency));
                        advance();

                        if (handledNoteOnSerial != noteOnSerial)
                            break;
                    }
                }

                if (handledNoteOnSerial != noteOnSerial)
                    continue;

                while (keyDownVelocity != 0.0f)
                {
                    let sustainLevel = std::intrinsics::clamp (sustainIn, 0.0f, 1.0f);
                    if (sustainLevel < 1.0f)
                        currentLevel = envelopeVelocity * sustainLevel;
                    emitCurrentLevel();
                    advance();

                    if (handledNoteOnSerial != noteOnSerial)
                        break;
                }
            }
        }
    }

    processor RetriggerableAdsr
    {
        input event (std::notes::NoteOn,
                     std::notes::NoteOff) eventIn;
        input value float32 attackSecondsIn;
        input value float32 decaySecondsIn;
        input value float32 sustainIn;
        input value float32 releaseSecondsIn;
        output stream float32 gainOut;

        float32 currentLevel = 0.0f;
        float32 attackStartLevel = 0.0f;
        float32 releaseStartLevel = 0.0f;
        float32 stageProgress = 0.0f;
        int32 stage = 0;

        void startStage (int32 nextStage)
        {
            stage = nextStage;
            stageProgress = 0.0f;
        }

        float32 stageIncrement (float32 seconds)
        {
            let safeSeconds = std::intrinsics::max (0.001f, seconds);
            return 1.0f / (safeSeconds * float32 (processor.frequency));
        }

        event eventIn (std::notes::NoteOn noteOn)
        {
            attackStartLevel = 0.0f;
            currentLevel = 0.0f;
            startStage (1);
        }

        event eventIn (std::notes::NoteOff noteOff)
        {
            releaseStartLevel = currentLevel;
            startStage (4);
        }

        void main()
        {
            loop
            {
                if (stage == 1)
                {
                    let t = std::intrinsics::clamp (stageProgress, 0.0f, 1.0f);
                    currentLevel = attackStartLevel + ((1.0f - attackStartLevel) * std::intrinsics::clamp (t, 0.0f, 1.0f));
                    stageProgress += stageIncrement (attackSecondsIn);

                    if (stageProgress >= 1.0f)
                    {
                        currentLevel = 1.0f;
                        startStage (2);
                    }
                }
                else if (stage == 2)
                {
                    let sustainLevel = std::intrinsics::clamp (sustainIn, 0.0f, 1.0f);
                    let t = std::intrinsics::clamp (stageProgress, 0.0f, 1.0f);
                    currentLevel = 1.0f + ((sustainLevel - 1.0f) * t);
                    stageProgress += stageIncrement (decaySecondsIn);

                    if (stageProgress >= 1.0f)
                    {
                        currentLevel = sustainLevel;
                        stage = 3;
                        stageProgress = 0.0f;
                    }
                }
                else if (stage == 3)
                {
                    currentLevel = std::intrinsics::clamp (sustainIn, 0.0f, 1.0f);
                }
                else if (stage == 4)
                {
                    let t = std::intrinsics::clamp (stageProgress, 0.0f, 1.0f);
                    currentLevel = releaseStartLevel * (1.0f - t);
                    stageProgress += stageIncrement (releaseSecondsIn);

                    if (stageProgress >= 1.0f)
                    {
                        currentLevel = 0.0f;
                        stage = 0;
                        stageProgress = 0.0f;
                    }
                }
                else
                {
                    currentLevel = 0.0f;
                }

                gainOut <- currentLevel;
                advance();
            }
        }
    }

    processor SharedVoiceEngine (int voiceCount,
                                 float32 previewFrequencyHz = 440.0f,
                                 int wavetableFrameCapacity = maxFramesPerTable)
    {
        input event (std::notes::NoteOn,
                     std::notes::NoteOff,
                     std::notes::PitchBend,
                     std::notes::Slide,
                     std::notes::Pressure,
                     std::notes::Control,
                     wt::ArticulatedNoteOn) voiceEventIn[voiceCount];
        input event VoiceRetune voiceRetuneIn[voiceCount];
        input event OscillatorWavetableLoadBegin oscillatorWavetableLoadBeginIn;
        input event OscillatorWavetableMipFrame oscillatorWavetableMipFrameIn;
        input event OscillatorServiceLoadAbort oscillatorServiceLoadAbortIn;
        input event BounceBankLoadBegin bounceBankLoadBeginIn;
        input event BounceBankFrameBatch bounceBankFrameBatchIn;
        input event BounceBankCommit bounceBankCommitIn;
