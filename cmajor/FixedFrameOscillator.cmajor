        input event ModulationMsegPlaybackUpload modulationMsegPlaybackIn;
        input event ModulationProgramUpload modulationProgramIn;
        input event ModulationAmountUpload modulationAmountIn;
        input event int32 runtimeInstallSyncIn;
        input value float32 oscillatorFramePositionIn[oscillatorCount];
        input value float32 oscillatorWarpModeIn[oscillatorCount];
        input value float32 oscillatorWarpAmountIn[oscillatorCount];
        input value float32 oscillatorOctaveIn[oscillatorCount];
        input value float32 oscillatorSemitoneIn[oscillatorCount];
        input value float32 oscillatorFineCentsIn[oscillatorCount];
        input value float32 oscillatorPhaseIn[oscillatorCount];
        input value float32 oscillatorPhaseRandomIn[oscillatorCount];
        input value float32 oscillatorRetriggerIn[oscillatorCount];
        input value float32 oscillatorVolumeDbIn[oscillatorCount];
        input value float32 oscillatorMuteIn[oscillatorCount];
        input value float32 oscillatorSoloIn[oscillatorCount];
        input value float32 oscillatorPanIn[oscillatorCount];
        input value float32 oscillatorUnisonVoicesIn[oscillatorCount];
        input value float32 oscillatorUnisonDetuneIn[oscillatorCount];
        input value float32 oscillatorUnisonBlendIn[oscillatorCount];
        input value float32 oscillatorUnisonWidthIn[oscillatorCount];
        input value float32 oscillatorUnisonDetuneModeIn[oscillatorCount];
        input value float32 oscillatorUnisonStackModeIn[oscillatorCount];
        input value float32 oscillatorUnisonWavetablePositionSpreadIn[oscillatorCount];
        input value float32 oscillatorUnisonWarpSpreadIn[oscillatorCount];
        input value float32 glideTimeIn [[ name: "Glide Time", min: 0.0f, max: 2.0f, init: 0.0f, unit: "s", rampFrames: 0 ]];
        input value float32 filterModeIn [[ name: "Filter Mode", min: 0.0f, max: 5.0f, init: 0.0f, discrete: true, step: 1.0f, rampFrames: 0 ]];
        input value float32 filterCutoffIn [[ name: "Filter Cutoff", min: 20.0f, max: 20000.0f, init: 1000.0f, unit: "Hz", rampFrames: 64 ]];
        input value float32 filterCutoffKeyTrackEnabledIn [[ name: "Voice Filter Key Track", min: 0.0f, max: 1.0f, init: 0.0f, discrete: true, step: 1.0f, text: "Off|On", rampFrames: 0 ]];
        input value float32 filterCutoffKeyTrackOffsetSemitonesIn [[ name: "Voice Filter Key Track Offset", min: -60.0f, max: 60.0f, init: 0.0f, unit: "st", rampFrames: 0 ]];
        input value float32 filterQIn [[ name: "Filter Q", min: 0.1f, max: 20.0f, init: 0.707107f, rampFrames: 64 ]];
        input value float32 filterMixIn [[ name: "Filter Mix", min: 0.0f, max: 1.0f, init: 1.0f, rampFrames: 64 ]];
        input value float32 voiceEnhancerFrequencyIn [[ name: "Voice Enhancer Frequency", min: voiceEnhancerFrequencyMinHz, max: voiceEnhancerFrequencyMaxHz, init: voiceEnhancerFrequencyDefaultHz, unit: "Hz", rampFrames: 0 ]];
        input value float32 voiceEnhancerKeyTrackEnabledIn [[ name: "Voice Enhancer Key Track", min: 0.0f, max: 1.0f, init: 0.0f, discrete: true, step: 1.0f, text: "Off|On", rampFrames: 0 ]];
        input value float32 voiceEnhancerKeyTrackOffsetSemitonesIn [[ name: "Voice Enhancer Key Track Offset", min: -12.0f, max: 60.0f, init: 0.0f, unit: "st", rampFrames: 0 ]];
        input value float32 voiceEnhancerQIn [[ name: "Voice Enhancer Q", min: voiceEnhancerQMin, max: voiceEnhancerQMax, init: voiceEnhancerQDefault, rampFrames: 0 ]];
        input value float32 voiceEnhancerAmountIn [[ name: "Voice Enhancer Amount", min: voiceEnhancerAmountMin, max: voiceEnhancerAmountMax, init: voiceEnhancerAmountDefault, rampFrames: 64 ]];
        input value float32 macro1In [[ name: "Macro 1", min: 0.0f, max: 1.0f, init: 0.0f, rampFrames: 64 ]];
        input value float32 macro2In [[ name: "Macro 2", min: 0.0f, max: 1.0f, init: 0.0f, rampFrames: 64 ]];
        input value float32 macro3In [[ name: "Macro 3", min: 0.0f, max: 1.0f, init: 0.0f, rampFrames: 64 ]];
        input value float32 macro4In [[ name: "Macro 4", min: 0.0f, max: 1.0f, init: 0.0f, rampFrames: 64 ]];
        input value float32 mseg1MorphIn [[ name: "MSEG 1 Morph", min: 0.0f, max: 1.0f, init: 0.0f, rampFrames: 0 ]];
        input value float32 mseg2MorphIn [[ name: "MSEG 2 Morph", min: 0.0f, max: 1.0f, init: 0.0f, rampFrames: 0 ]];
        input value float32 mseg3MorphIn [[ name: "MSEG 3 Morph", min: 0.0f, max: 1.0f, init: 0.0f, rampFrames: 0 ]];
        input value float32 msegRateIn[modulationMsegSlotCount];
        input value float32 envelopeAttackIn[modulationEnvSlotCount];
        input value float32 envelopeDecayIn[modulationEnvSlotCount];
        input value float32 envelopeSustainIn[modulationEnvSlotCount];
        input value float32 envelopeReleaseIn[modulationEnvSlotCount];
        input value float32 ampAttackIn [[ name: "Amp Envelope Attack", min: 0.001f, max: 10.0f, init: 0.01f, unit: "s", rampFrames: 0 ]];
        input value float32 ampDecayIn [[ name: "Amp Envelope Decay", min: 0.001f, max: 10.0f, init: 0.001f, unit: "s", rampFrames: 0 ]];
        input value float32 ampSustainIn [[ name: "Amp Envelope Sustain", min: 0.0f, max: 1.0f, init: 1.0f, rampFrames: 0 ]];
        input value float32 ampReleaseIn [[ name: "Amp Release", min: 0.005f, max: 10.0f, init: 0.2f, unit: "s", rampFrames: 0 ]];
        input value float32 sourceModeIn [[ name: "Source Mode", min: 0.0f, max: 1.0f, init: 0.0f, discrete: true, step: 1.0f, text: "Oscillator|Bounce", rampFrames: 0 ]];
        input value float32 globalTuneIn [[ name: "Global Tune", min: -24.0f, max: 24.0f, init: 0.0f, unit: "st", rampFrames: 64 ]];
        output event OscillatorWavetableUploadAck oscillatorWavetableUploadAckOut;
        output event OscillatorWavetableMipRequest oscillatorWavetableMipRequestOut;
        output event OscillatorRuntimeServiceState oscillatorRuntimeServiceStateOut;
        output event WavetableSlotMonitor wavetableSlotMonitorOut;
        output event wt::EffectiveWavetablePositionMonitor effectiveWavetablePositionOut;
        output event wt::EffectiveWarpStateMonitor effectiveWarpStateOut;
        output event wt::EffectiveUnisonStateMonitor effectiveUnisonStateOut;
        output event wt::EffectiveFilterStateMonitor effectiveFilterStateOut;
        output event wt::EffectiveMsegStateMonitor effectiveMsegStateOut;
        output event wt::EffectiveModSourceStateMonitor effectiveModSourceStateOut;
        output event wt::VoiceArticulationMonitor voiceArticulationStartOut;
        output event wt::OscillatorVoiceStartMonitor oscillatorVoiceStartOut;
        output stream float32<2> out;
        output stream float32 trackingPitchHzOut;
        output stream float32 rackModOut[rackModTargetCount];
        output event int32 modulationRejectedRouteCountOut;
        output event RuntimeInstallAck runtimeInstallAckOut;
        output event BounceBankUploadAck bounceBankUploadAckOut;
        output event BounceBankRuntimeState bounceBankRuntimeStateOut;

        int32[oscillatorCount] makeInactiveOscillatorSlots()
        {
            int32[oscillatorCount] slots;

            for (wrap<oscillatorCount> oscillator)
                slots[oscillator] = -1;

            return slots;
        }

        node ampEnvelopes = wt::RetriggerableAmpAdsr[voiceCount];
        node mseg1 = wt::MsegReader[voiceCount];
        node mseg2 = wt::MsegReader[voiceCount];
        node mseg3 = wt::MsegReader[voiceCount];
        node modEnv1 = wt::RetriggerableAdsr[voiceCount];
        node modEnv2 = wt::RetriggerableAdsr[voiceCount];
        node modEnv3 = wt::RetriggerableAdsr[voiceCount];

        std::filters::simper::Implementation[voiceCount] unisonLeftFilters;
        std::filters::simper::Implementation[voiceCount] unisonRightFilters;
        VoiceEnhancerVoice[voiceCount] voiceEnhancers;
        VoiceEnhancerResidueDcBlocker voiceEnhancerResidueDcBlocker;
        int32[voiceCount * oscillatorCount] voiceOscillatorGeneration;
        int32[voiceCount] voiceChannel;
        float32[voiceCount] voiceBasePitch;
        float32[voiceCount] voiceCurrentPitch;
        float32[voiceCount] voiceTargetPitch;
        float32[voiceCount] voiceBendSemitones;
        float32[voiceCount] voicePressure;
        float32[voiceCount] voiceSlide;
        float32[voiceCount] voiceVelocity;
        float32[voiceCount] voiceAmpEnvelopeInverseVelocity;
        float64[voiceCount] voiceBouncePosition;
        int32[voiceCount] voiceBounceRootIndex;
        int32[voiceCount] voiceBounceBankSlot;
        bool[voiceCount] voiceBouncePlaying;
        float32[voiceCount] voicePitchGlideStep;
        int32[voiceCount] voiceGlideSamplesRemaining;
        int32[voiceCount] voiceActive;
        int32[voiceCount] voiceGeneration;
        int32[voiceCount] voiceTrackingSerial;
        // True while the audio loop last saw this voice sounding. A voice
        // that is not sounding is fully quiescent: its seven modulator nodes
        // are frozen (an un-advanced node re-emits its previous frame, and
        // every modulator emits exactly 0 or a held value at rest), its
        // renderer controls are cleared once at the transition, and nothing
        // reads it — the mixer, the rack-source reduction, and every
        // monitor all gate on the same sounding predicate, and a retrigger
        // resets every modulator from its note-on event before the next
        // advance. Freezing is therefore bit-identical to advancing.
        bool[voiceCount] voiceWasSounding;
        // Post-mix effects follow the newest still-held voice. Once no note is
        // held, retain the last realized shared pitch so effect tails never retune.
        float32 trackingPitchHzState = keyTrackFallbackPitchHz;
        float32[voiceCount] voiceEffectivePosition;
        int32[voiceCount] voiceEffectiveWarpMode;
        float32[voiceCount] voiceEffectiveWarpAmount;
        int32[voiceCount] voiceEffectiveFilterMode;
        float32[voiceCount] voiceEffectiveFilterCutoffHz;
        float32[voiceCount] voiceEffectiveFilterQ;
        float32[voiceCount] voiceEffectiveFilterMix;
