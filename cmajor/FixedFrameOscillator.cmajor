    struct ModulationProgramUpload
    {
        int32 voiceRouteCount;
        int32[modulationVoiceRouteCellCount] voiceRouteCells;
        int32[modulationVoiceRouteCellCount] voiceRouteSources;
        int32[modulationVoiceRouteCellCount] voiceRouteTargets;
        int32[modulationVoiceRouteCellCount] voiceRoutePolarities;
        float32[modulationVoiceRouteCellCount] voiceRouteAmounts;

        int32 macroVoiceRouteCount;
        int32[modulationMacroVoiceRouteCellCount] macroVoiceRouteCells;
        int32[modulationMacroVoiceRouteCellCount] macroVoiceRouteSources;
        int32[modulationMacroVoiceRouteCellCount] macroVoiceRouteTargets;
        int32[modulationMacroVoiceRouteCellCount] macroVoiceRoutePolarities;
        float32[modulationMacroVoiceRouteCellCount] macroVoiceRouteAmounts;

        int32 voiceRackRouteCount;
        int32[modulationVoiceRackRouteCellCount] voiceRackRouteCells;
        int32[modulationVoiceRackRouteCellCount] voiceRackRouteSources;
        int32[modulationVoiceRackRouteCellCount] voiceRackRouteTargets;
        int32[modulationVoiceRackRouteCellCount] voiceRackRoutePolarities;
        int32[modulationVoiceRackRouteCellCount] voiceRackRouteReducers;
        float32[modulationVoiceRackRouteCellCount] voiceRackRouteAmounts;

        int32 macroRackRouteCount;
        int32[modulationMacroRackRouteCellCount] macroRackRouteCells;
        int32[modulationMacroRackRouteCellCount] macroRackRouteSources;
        int32[modulationMacroRackRouteCellCount] macroRackRouteTargets;
        int32[modulationMacroRackRouteCellCount] macroRackRoutePolarities;
        float32[modulationMacroRackRouteCellCount] macroRackRouteAmounts;
        int32 dspSessionId;
        int32 deliverySerial;
    }

    struct ModulationAmountUpload
    {
        int32 pathKind;
        int32 cellIndex;
        float32 amount;
        int32 dspSessionId;
        int32 deliverySerial;
    }

    bool isValidModulationPolarity (int32 polarityKind)
    {
        return polarityKind == modulationPolarityUnipolar
            || polarityKind == modulationPolarityBipolar;
    }

    bool isFiniteRuntimeValue (float32 value)
    {
        return ! isnan (value) && ! isinf (value);
    }

    // Validate the complete sparse program before publishing any of it. Keeping
    // this free of processor state makes every wire invariant directly testable.
    bool isValidModulationProgram (ModulationProgramUpload& upload)
    {
        if (upload.voiceRouteCount < 0 || upload.voiceRouteCount > modulationVoiceRouteCellCount
            || upload.macroVoiceRouteCount < 0 || upload.macroVoiceRouteCount > modulationMacroVoiceRouteCellCount
            || upload.voiceRackRouteCount < 0 || upload.voiceRackRouteCount > modulationVoiceRackRouteCellCount
            || upload.macroRackRouteCount < 0 || upload.macroRackRouteCount > modulationMacroRackRouteCellCount)
            return false;

        // Amount arrays are deterministic-cell indexed, including inactive tails
        // that may later become articulation inheritance inputs. Reject poison at
        // the runtime seam before any part of the program is published.
        for (int32 cellIndex = 0; cellIndex < modulationVoiceRouteCellCount; ++cellIndex)
            if (! isFiniteRuntimeValue (upload.voiceRouteAmounts.at (cellIndex)))
                return false;

        for (int32 cellIndex = 0; cellIndex < modulationMacroVoiceRouteCellCount; ++cellIndex)
            if (! isFiniteRuntimeValue (upload.macroVoiceRouteAmounts.at (cellIndex)))
                return false;

        for (int32 cellIndex = 0; cellIndex < modulationVoiceRackRouteCellCount; ++cellIndex)
            if (! isFiniteRuntimeValue (upload.voiceRackRouteAmounts.at (cellIndex)))
                return false;

        for (int32 cellIndex = 0; cellIndex < modulationMacroRackRouteCellCount; ++cellIndex)
            if (! isFiniteRuntimeValue (upload.macroRackRouteAmounts.at (cellIndex)))
                return false;

        int32 previousCell = -1;
        for (int32 routeIndex = 0; routeIndex < upload.voiceRouteCount; ++routeIndex)
        {
            let cellIndex = upload.voiceRouteCells.at (routeIndex);
            let sourceIndex = upload.voiceRouteSources.at (routeIndex);
            let targetIndex = upload.voiceRouteTargets.at (routeIndex);
            if (cellIndex <= previousCell
                || cellIndex < 0 || cellIndex >= modulationVoiceRouteCellCount
                || sourceIndex < 0 || sourceIndex >= modulationVoiceSourceCount
                || targetIndex < 0 || targetIndex >= modulationVoiceTargetCount
                || cellIndex != (sourceIndex * modulationVoiceTargetCount) + targetIndex
                || ! isValidModulationPolarity (upload.voiceRoutePolarities.at (routeIndex)))
                return false;
            previousCell = cellIndex;
        }

        previousCell = -1;
        for (int32 routeIndex = 0; routeIndex < upload.macroVoiceRouteCount; ++routeIndex)
        {
            let cellIndex = upload.macroVoiceRouteCells.at (routeIndex);
            let sourceIndex = upload.macroVoiceRouteSources.at (routeIndex);
            let targetIndex = upload.macroVoiceRouteTargets.at (routeIndex);
            if (cellIndex <= previousCell
                || cellIndex < 0 || cellIndex >= modulationMacroVoiceRouteCellCount
                || sourceIndex < 0 || sourceIndex >= modulationMacroSourceCount
                || targetIndex < 0 || targetIndex >= modulationVoiceTargetCount
                || cellIndex != (sourceIndex * modulationVoiceTargetCount) + targetIndex
                || ! isValidModulationPolarity (upload.macroVoiceRoutePolarities.at (routeIndex)))
                return false;
            previousCell = cellIndex;
        }

        previousCell = -1;
        for (int32 routeIndex = 0; routeIndex < upload.voiceRackRouteCount; ++routeIndex)
        {
            let cellIndex = upload.voiceRackRouteCells.at (routeIndex);
            let sourceIndex = upload.voiceRackRouteSources.at (routeIndex);
            let targetIndex = upload.voiceRackRouteTargets.at (routeIndex);
            let reducerKind = upload.voiceRackRouteReducers.at (routeIndex);
            if (cellIndex <= previousCell
                || cellIndex < 0 || cellIndex >= modulationVoiceRackRouteCellCount
                || sourceIndex < 0 || sourceIndex >= modulationVoiceSourceCount
                || targetIndex < 0 || targetIndex >= rackModTargetCount
                || cellIndex != (sourceIndex * rackModTargetCount) + targetIndex
                || ! isValidModulationPolarity (upload.voiceRackRoutePolarities.at (routeIndex))
                || (reducerKind != modulationReducerMaximum && reducerKind != modulationReducerMean))
                return false;
            previousCell = cellIndex;
        }

        previousCell = -1;
        for (int32 routeIndex = 0; routeIndex < upload.macroRackRouteCount; ++routeIndex)
        {
            let cellIndex = upload.macroRackRouteCells.at (routeIndex);
            let sourceIndex = upload.macroRackRouteSources.at (routeIndex);
            let targetIndex = upload.macroRackRouteTargets.at (routeIndex);
            if (cellIndex <= previousCell
                || cellIndex < 0 || cellIndex >= modulationMacroRackRouteCellCount
                || sourceIndex < 0 || sourceIndex >= modulationMacroSourceCount
                || targetIndex < 0 || targetIndex >= rackModTargetCount
                || cellIndex != (sourceIndex * rackModTargetCount) + targetIndex
                || ! isValidModulationPolarity (upload.macroRackRoutePolarities.at (routeIndex)))
                return false;
            previousCell = cellIndex;
        }

        return true;
    }

    bool isValidArticulationSnapshot (ArticulationSnapshotUpload& upload)
    {
        if (! upload.enabled)
            return true;

        if (! isFiniteRuntimeValue (upload.framePosition)
            || ! isFiniteRuntimeValue (upload.pan)
            || ! isFiniteRuntimeValue (upload.unisonDetune)
            || ! isFiniteRuntimeValue (upload.unisonBlend)
            || ! isFiniteRuntimeValue (upload.unisonWidth)
            || ! isFiniteRuntimeValue (upload.unisonPhase)
            || ! isFiniteRuntimeValue (upload.unisonRandom)
            || ! isFiniteRuntimeValue (upload.unisonWavetablePositionSpread)
            || ! isFiniteRuntimeValue (upload.unisonWarpSpread)
            || ! isFiniteRuntimeValue (upload.warpAmount)
            || ! isFiniteRuntimeValue (upload.filterCutoffHz)
            || ! isFiniteRuntimeValue (upload.filterQ))
            return false;

        for (int32 slotIndex = 0; slotIndex < modulationMsegSlotCount; ++slotIndex)
            if (! isFiniteRuntimeValue (upload.msegMorphs.at (slotIndex)))
                return false;

        for (int32 routeIndex = 0; routeIndex < modulationArticulationRouteCellCount; ++routeIndex)
            if (! isFiniteRuntimeValue (upload.routeAmounts.at (routeIndex)))
                return false;

        for (int32 slotIndex = 0; slotIndex < modulationEnvSlotCount; ++slotIndex)
            if (! isFiniteRuntimeValue (upload.envelopeAttackSeconds.at (slotIndex))
                || ! isFiniteRuntimeValue (upload.envelopeDecaySeconds.at (slotIndex))
                || ! isFiniteRuntimeValue (upload.envelopeSustain.at (slotIndex))
                || ! isFiniteRuntimeValue (upload.envelopeReleaseSeconds.at (slotIndex)))
                return false;

        return true;
    }

    float32 catmullRom (float32 p0, float32 p1, float32 p2, float32 p3, float32 t)
    {
        return p1 + 0.5f * t * ((p2 - p0) + t * ((2.0f * p0 - 5.0f * p1 + 4.0f * p2 - p3)
               + t * (-p0 + 3.0f * p1 - 3.0f * p2 + p3)));
    }

    int32 resolveUploadedFrameCount (int32 resolvedFrameCount)
    {
        if (resolvedFrameCount < 1 || resolvedFrameCount > maxFramesPerTable)
            return 0;

        return resolvedFrameCount;
    }

    int32 resolveMipIndex (int32 requestedMipIndex)
    {
        if (requestedMipIndex < 0 || requestedMipIndex >= mipLevelCount)
            return -1;

        return requestedMipIndex;
    }

    int32 selectMipIndexFromPhaseIncrement (float32 phaseIncrement)
    {
        if (phaseIncrement <= 0.0f)
            return brightestMipIndex;

        let rawMaxHarmonics = int32 (
            std::intrinsics::floor (1.0f / (2.0f * phaseIncrement))
        );
        int32 clampedMaxHarmonics = rawMaxHarmonics;

        if (clampedMaxHarmonics < 1)
            clampedMaxHarmonics = 1;
        else if (clampedMaxHarmonics > maxMipHarmonics)
            clampedMaxHarmonics = maxMipHarmonics;

        int32 mipIndex = 0;
        int32 remainingHarmonics = clampedMaxHarmonics;

        while (remainingHarmonics > 1)
        {
            remainingHarmonics /= 2;
            mipIndex += 1;
        }

        return std::intrinsics::clamp (mipIndex, 0, brightestMipIndex);
    }

    int32 frameBase (int32 frameIndex)
    {
        return (frameIndex * paddedFrameSize);
    }

    int32 readinessIndex (int32 mipIndex, int32 frameIndex)
    {
        return (mipIndex * maxFramesPerTable) + frameIndex;
    }

    int32 normalizeTableBankIndex (int32 bankIndex)
    {
        return bankIndex == 0 ? 0 : 1;
    }

    int32 bankedReadinessIndex (int32 bankIndex, int32 mipIndex, int32 frameIndex)
    {
        return (normalizeTableBankIndex (bankIndex) * maxMipFrameSlots) + readinessIndex (mipIndex, frameIndex);
    }

    int32 bankedMipLevelIndex (int32 bankIndex, int32 mipIndex)
    {
        return (normalizeTableBankIndex (bankIndex) * mipLevelCount) + mipIndex;
    }

    float32 readFixedFrameSampleFromBase (const float[] tableSamples,
                                          int32 base,
                                          float32 phase)
    {
        let wrappedPhase = std::intrinsics::wrap (phase, 1.0f);
        let x = wrappedPhase * float32 (samplesPerFrame);
        let sampleIndex = int32 (std::intrinsics::floor (x));
        let fractional = x - float32 (sampleIndex);
        let sampleBase = base + sampleIndex;
        let p0 = tableSamples.at (sampleBase + 0);
        let p1 = tableSamples.at (sampleBase + 1);
        let p2 = tableSamples.at (sampleBase + 2);
        let p3 = tableSamples.at (sampleBase + 3);
        return catmullRom (p0, p1, p2, p3, fractional);
    }

    float32 readFixedFrameSample (const float[] tableSamples,
                                  int32 frameIndex,
                                  float32 phase)
    {
        return readFixedFrameSampleFromBase (tableSamples, frameBase (frameIndex), phase);
    }

    float32 readFrameBlendSample (const float[] tableSamples,
                                  int32 frameLo,
                                  int32 frameHi,
                                  float32 phase,
                                  float32 frameT)
    {
        let lo = readFixedFrameSample (tableSamples, frameLo, phase);

        if (frameHi == frameLo)
            return lo;

        let hi = readFixedFrameSample (tableSamples, frameHi, phase);
        return lo + (hi - lo) * frameT;
    }

    struct WarpPhaseResult
    {
        bool shouldLookup;
        bool holdCycleEndpoint;
        float32 phase;
    }

    int32 resolveFilterMode (float32 rawMode)
    {
        return std::intrinsics::clamp (
            int32 (std::intrinsics::floor (rawMode + 0.5f)),
            filterModeOff,
            filterModePeak
        );
    }

    float32 clampFilterCutoffHz (float32 cutoffHz, float32 processorFrequency)
    {
        let maxCutoffHz = std::intrinsics::min (filterCutoffMaxHz, processorFrequency * 0.48f);
        return std::intrinsics::clamp (cutoffHz, filterCutoffMinHz, maxCutoffHz);
    }

    float32 clampFilterQ (float32 q)
    {
        return std::intrinsics::clamp (q, filterQMin, filterQMax);
    }

    float32 clampPan (float32 pan)
    {
        return std::intrinsics::clamp (pan, -1.0f, 1.0f);
    }

    float32 clampAmpGainDb (float32 gainDb)
    {
        return std::intrinsics::clamp (gainDb, -48.0f, 6.0f);
    }

    float32 dbToGain (float32 gainDb)
    {
        return std::intrinsics::pow (10.0f, gainDb / 20.0f);
    }

    float32 panLeftGain (float32 pan)
    {
        let normalizedPan = (clampPan (pan) + 1.0f) * 0.25f * float32 (pi);
        return std::intrinsics::cos (normalizedPan);
    }

    float32 panRightGain (float32 pan)
    {
        let normalizedPan = (clampPan (pan) + 1.0f) * 0.25f * float32 (pi);
        return std::intrinsics::sin (normalizedPan);
    }

    int32 resolveSimperFilterMode (int32 filterMode)
    {
        if (filterMode == filterModeHighpass)
            return std::filters::simper::Mode::highPass;

        if (filterMode == filterModeBandpass)
            return std::filters::simper::Mode::bandPass;

        if (filterMode == filterModeNotch)
            return std::filters::simper::Mode::notchPass;

        if (filterMode == filterModePeak)
            return std::filters::simper::Mode::peakPass;

        return std::filters::simper::Mode::lowPass;
    }

    int32 resolveWarpMode (float32 rawMode)
    {
        return std::intrinsics::clamp (
            int32 (std::intrinsics::floor (rawMode + 0.5f)),
            warpModeOff,
            warpModeMirror
        );
    }

    float32 curvedWarpRight (float32 phase, float32 amount)
    {
        let clampedPhase = std::intrinsics::clamp (phase, 0.0f, 1.0f);
        let clampedAmount = std::intrinsics::clamp (amount, 0.0f, 1.0f);
        let exponent = std::intrinsics::pow (2.0f, 4.0f * clampedAmount);
        return std::intrinsics::pow (clampedPhase, exponent);
    }

    float32 curvedWarpLeft (float32 phase, float32 amount)
    {
        let clampedPhase = std::intrinsics::clamp (phase, 0.0f, 1.0f);
        let clampedAmount = std::intrinsics::clamp (amount, 0.0f, 1.0f);
        let exponent = std::intrinsics::pow (2.0f, 4.0f * clampedAmount);
        return 1.0f - std::intrinsics::pow (1.0f - clampedPhase, exponent);
    }

    float32 curvedAsymSigned (float32 phase, float32 dial)
    {
        let clampedDial = std::intrinsics::clamp (dial, 0.0f, 1.0f);
        let signedAmount = (2.0f * clampedDial) - 1.0f;
        let magnitude = std::intrinsics::abs (signedAmount);

        if (signedAmount >= 0.0f)
            return curvedWarpRight (phase, magnitude);

        return curvedWarpLeft (phase, magnitude);
    }

    float32 linearSkewSigned (float32 phase, float32 dial)
    {
        let clampedPhase = std::intrinsics::clamp (phase, 0.0f, 1.0f);
        let clampedDial = std::intrinsics::clamp (dial, 0.0f, 1.0f);
        let signedAmount = (2.0f * clampedDial) - 1.0f;
        let split = std::intrinsics::clamp (0.5f + (0.48f * signedAmount), 0.02f, 0.98f);

        if (clampedPhase < split)
            return 0.5f * (clampedPhase / split);

        return 0.5f + (0.5f * ((clampedPhase - split) / (1.0f - split)));
    }

    float32 mirrorBasePhase (float32 phase)
    {
        let clampedPhase = std::intrinsics::clamp (phase, 0.0f, 1.0f);

        if (clampedPhase < 0.5f)
            return clampedPhase * 2.0f;

        return 2.0f - (2.0f * clampedPhase);
    }

    float32 pwmActivePortion (float32 amount)
    {
        let clampedAmount = std::intrinsics::clamp (amount, 0.0f, 1.0f);
        return 1.0f - ((1.0f - 0.02f) * clampedAmount);
    }

    bool isIdentityWarp (int32 warpMode, float32 warpAmount)
    {
        let clampedAmount = std::intrinsics::clamp (warpAmount, 0.0f, 1.0f);

        if (warpMode <= warpModeOff)
            return true;

        if (warpMode == warpModeBend)
            return std::intrinsics::abs (clampedAmount - 0.5f) <= 0.000001f;

        if (warpMode == warpModePWM)
            return clampedAmount <= 0.000001f;

        if (warpMode == warpModeAsym)
            return std::intrinsics::abs (clampedAmount - 0.5f) <= 0.000001f;

        if (warpMode == warpModeMirror)
            return false;

        return true;
    }

    WarpPhaseResult resolveWarpPhase (int32 warpMode,
                                      float32 warpAmount,
                                      float32 phase)
    {
        WarpPhaseResult result;
        let wrappedPhase = std::intrinsics::wrap (phase, 1.0f);
        result.shouldLookup = true;
        result.holdCycleEndpoint = false;
        result.phase = wrappedPhase;

        if (warpMode <= warpModeOff)
            return result;

        let clampedAmount = std::intrinsics::clamp (warpAmount, 0.0f, 1.0f);

        if (warpMode == warpModeBend)
        {
            let invertedDial = 1.0f - clampedAmount;

            if (wrappedPhase < 0.5f)
                result.phase = 0.5f * curvedAsymSigned (wrappedPhase * 2.0f, invertedDial);
            else
                result.phase = 1.0f - (0.5f * curvedAsymSigned ((2.0f - (2.0f * wrappedPhase)), invertedDial));

            return result;
        }

        if (warpMode == warpModePWM)
        {
            let activePortion = pwmActivePortion (clampedAmount);

            if (wrappedPhase < activePortion)
            {
                result.phase = wrappedPhase / activePortion;
            }
            else
            {
                result.shouldLookup = false;
                result.holdCycleEndpoint = true;
                result.phase = 1.0f;
            }

            return result;
        }

        if (warpMode == warpModeAsym)
        {
            result.phase = linearSkewSigned (wrappedPhase, clampedAmount);
            return result;
        }

        if (warpMode == warpModeMirror)
        {
            result.phase = linearSkewSigned (mirrorBasePhase (wrappedPhase), clampedAmount);
            return result;
        }

        return result;
    }

    processor RetriggerableFixedASR (float32 attackSeconds,
                                     float32 releaseSeconds)
    {
        input event (std::notes::NoteOn,
                     std::notes::NoteOff) eventIn;

        output stream float32 gainOut;

        float32 keyDownVelocity, currentLevel;
        int32 noteOnSerial, handledNoteOnSerial;

        event eventIn (std::notes::NoteOn noteOn)
        {
            keyDownVelocity = noteOn.velocity;
            noteOnSerial += 1;
        }

        event eventIn (std::notes::NoteOff noteOff)
        {
            keyDownVelocity = 0.0f;
        }

        void main()
        {
            int32 handledNoteOnSerial = 0;

            loop
            {
                while (keyDownVelocity == 0.0f)
                {
                    if const (releaseSeconds > 0.0f)
                    {
                        let decayFactor = pow (0.0001f, float32 (processor.period) / releaseSeconds);

                        if (currentLevel > 0.0001f)
                        {
                            gainOut <- currentLevel;
                            currentLevel *= decayFactor;
                        }
                        else
                        {
                            currentLevel = 0.0f;
                            gainOut <- 0.0f;
                        }
                    }
                    else
                    {
                        currentLevel = 0.0f;
                        gainOut <- 0.0f;
                    }

                    advance();
                }

                handledNoteOnSerial = noteOnSerial;
                currentLevel = 0.0f;

                if const (attackSeconds > 0.0f)
                {
                    while (currentLevel < keyDownVelocity)
                    {
                        let attackExponent = 1.0f / int32 (attackSeconds * float32 (processor.frequency));
                        let attackMultiplier = 2.0f ** -attackExponent
                                               * (2.0f + keyDownVelocity) ** attackExponent;
                        gainOut <- currentLevel;
                        currentLevel = attackMultiplier * (currentLevel + 2.0f) - 2.0f;
                        advance();

                        if (keyDownVelocity == 0.0f)
                            break;

                        if (handledNoteOnSerial != noteOnSerial)
                        {
                            handledNoteOnSerial = noteOnSerial;
                            currentLevel = 0.0f;
                        }
                    }
                }
                else
                {
                    currentLevel = keyDownVelocity;
                }

                while (keyDownVelocity != 0.0f)
                {
                    gainOut <- currentLevel;
                    advance();

                    if (handledNoteOnSerial != noteOnSerial)
                        break;
                }
            }
        }
    }

    processor RetriggerableAdsr
    {
        input event (std::notes::NoteOn,
                     std::notes::NoteOff) eventIn;
        input event ModulationEnvelopeUpload configUpload;
        output stream float32 gainOut;

        float32 attackSeconds = 0.01f;
        float32 decaySeconds = 0.25f;
        float32 sustainLevel = 0.5f;
        float32 releaseSeconds = 0.2f;
        float32 currentLevel = 0.0f;
        float32 attackStartLevel = 0.0f;
        float32 releaseStartLevel = 0.0f;
        int32 stage = 0;
        int32 stageFrame = 0;
        int32 stageLengthFrames = 0;

        void startStage (int32 nextStage, float32 seconds)
        {
            stage = nextStage;
            stageFrame = 0;
            stageLengthFrames = std::intrinsics::max (
                1,
                int32 (std::intrinsics::floor ((std::intrinsics::max (seconds, 0.0f) * float32 (processor.frequency)) + 0.5f))
            );
        }

        event configUpload (ModulationEnvelopeUpload config)
        {
            attackSeconds = std::intrinsics::max (0.001f, config.attackSeconds);
            decaySeconds = std::intrinsics::max (0.001f, config.decaySeconds);
            sustainLevel = std::intrinsics::clamp (config.sustain, 0.0f, 1.0f);
            releaseSeconds = std::intrinsics::max (0.001f, config.releaseSeconds);
        }

        event eventIn (std::notes::NoteOn noteOn)
        {
            attackStartLevel = 0.0f;
            currentLevel = 0.0f;
            startStage (1, attackSeconds);
        }

        event eventIn (std::notes::NoteOff noteOff)
        {
            releaseStartLevel = currentLevel;
            startStage (4, releaseSeconds);
        }

        void main()
        {
            loop
            {
                if (stage == 1)
                {
                    let t = float32 (stageFrame) / float32 (stageLengthFrames);
                    currentLevel = attackStartLevel + ((1.0f - attackStartLevel) * std::intrinsics::clamp (t, 0.0f, 1.0f));
                    stageFrame += 1;

                    if (stageFrame >= stageLengthFrames)
                    {
                        currentLevel = 1.0f;
                        startStage (2, decaySeconds);
                    }
                }
                else if (stage == 2)
                {
                    let t = float32 (stageFrame) / float32 (stageLengthFrames);
                    currentLevel = 1.0f + ((sustainLevel - 1.0f) * std::intrinsics::clamp (t, 0.0f, 1.0f));
                    stageFrame += 1;

                    if (stageFrame >= stageLengthFrames)
                    {
                        currentLevel = sustainLevel;
                        stage = 3;
                        stageFrame = 0;
                        stageLengthFrames = 0;
                    }
                }
                else if (stage == 3)
                {
                    currentLevel = sustainLevel;
                }
                else if (stage == 4)
                {
                    let t = float32 (stageFrame) / float32 (stageLengthFrames);
                    currentLevel = releaseStartLevel * (1.0f - std::intrinsics::clamp (t, 0.0f, 1.0f));
                    stageFrame += 1;

                    if (stageFrame >= stageLengthFrames)
                    {
                        currentLevel = 0.0f;
                        stage = 0;
                        stageFrame = 0;
                        stageLengthFrames = 0;
                    }
                }
                else
                {
                    currentLevel = 0.0f;
                }

                gainOut <- currentLevel;
                advance();
            }
        }
    }

    processor FixedFrameOscillator (float32 initialFrequencyHz = 440.0f,
                                    float32 initialPhase = 0.0f)
    {
        input event float32 frequencyIn [[ name: "Frequency", min: 0.0f, max: 24000.0f, init: 440.0f, unit: "Hz" ]];
        input event WavetableLoadBegin wavetableLoadBeginIn;
        input event WavetableMipFrame wavetableMipFrameIn;
        input event ServiceLoadAbort serviceLoadAbortIn;
        input stream float32 framePositionIn [[ name: "Wavetable Position", min: 0.0f, max: 1.0f, init: 0.0f ]];
        output event WavetableUploadAck wavetableUploadAckOut;
        output event WavetableMipRequest wavetableMipRequestOut;
        output event RuntimeServiceState runtimeServiceStateOut;
        output stream float out;

        std::oscillators::PhasorState phasor;
        float32[maxMipSampleCount] mip0Bank0Samples;
        float32[maxMipSampleCount] mip0Bank1Samples;
        float32[maxMipSampleCount] mip1Bank0Samples;
        float32[maxMipSampleCount] mip1Bank1Samples;
        float32[maxMipSampleCount] mip2Bank0Samples;
        float32[maxMipSampleCount] mip2Bank1Samples;
        float32[maxMipSampleCount] mip3Bank0Samples;
        float32[maxMipSampleCount] mip3Bank1Samples;
        float32[maxMipSampleCount] mip4Bank0Samples;
        float32[maxMipSampleCount] mip4Bank1Samples;
        float32[maxMipSampleCount] mip5Bank0Samples;
        float32[maxMipSampleCount] mip5Bank1Samples;
        float32[maxMipSampleCount] mip6Bank0Samples;
        float32[maxMipSampleCount] mip6Bank1Samples;
        float32[maxMipSampleCount] mip7Bank0Samples;
        float32[maxMipSampleCount] mip7Bank1Samples;
        float32[maxMipSampleCount] mip8Bank0Samples;
        float32[maxMipSampleCount] mip8Bank1Samples;
        float32[maxMipSampleCount] mip9Bank0Samples;
        float32[maxMipSampleCount] mip9Bank1Samples;
        float32[maxMipSampleCount] mip10Bank0Samples;
        float32[maxMipSampleCount] mip10Bank1Samples;
        int32[maxBankedMipFrameSlots] readyFrameFlags;
        int32[maxBankedMipLevelSlots] loadedFrameCounts;
        int32[mipLevelCount] requestedGenerationByMip;
        int32[mipLevelCount] requestedUrgencyByMip;
        float32 currentFrequencyHz = initialFrequencyHz;
        int32 currentDspSessionId = int32 (processor.session);
        int32 currentGeneration = 0;
        int32 currentTableIndex = 0;
        int32 generationFrontier = 0;
        int32 frameCount = 0;
        int32 lastFrameIndex = 0;
        float32 lastFrameIndexF = 0.0f;
        int32 activeBankIndex = 0;
        int32 stagingBankIndex = 1;
        int32 stagingGeneration = 0;
        int32 stagingTableIndex = 0;
        int32 stagingFrameCount = 0;
        int32 stagingLastFrameIndex = 0;
        float32 stagingLastFrameIndexF = 0.0f;
        int32 isPlayable = 0;
        bool hasEmittedInitialRuntimeState = false;

        void clearTableBankState (int32 bankIndex)
        {
            for (int32 index = 0; index < maxMipFrameSlots; ++index)
                readyFrameFlags.at ((normalizeTableBankIndex (bankIndex) * maxMipFrameSlots) + index) = 0;

            for (int32 mipIndex = 0; mipIndex < mipLevelCount; ++mipIndex)
                loadedFrameCounts.at (bankedMipLevelIndex (bankIndex, mipIndex)) = 0;
        }

        void clearPendingTableState()
        {
            clearTableBankState (stagingBankIndex);

            for (int32 mipIndex = 0; mipIndex < mipLevelCount; ++mipIndex)
            {
                requestedGenerationByMip.at (mipIndex) = 0;
                requestedUrgencyByMip.at (mipIndex) = -1;
            }
        }

        bool isMipReady (int32 mipIndex)
        {
            if (mipIndex < 0 || mipIndex >= mipLevelCount || frameCount <= 0)
                return false;

            return loadedFrameCounts.at (bankedMipLevelIndex (activeBankIndex, mipIndex)) >= frameCount;
        }

        int32 findPlayableMipIndex (int32 requestedMipIndex)
        {
            let resolvedRequestedMip = resolveMipIndex (requestedMipIndex);

            if (resolvedRequestedMip < 0)
                return -1;

            for (int32 mipIndex = resolvedRequestedMip; mipIndex >= 0; --mipIndex)
                if (isMipReady (mipIndex))
                    return mipIndex;

            return -1;
        }

        bool isStagingComplete()
        {
            if (stagingGeneration <= 0 || stagingFrameCount <= 0)
                return false;

            for (int32 mipIndex = 0; mipIndex < mipLevelCount; ++mipIndex)
                if (loadedFrameCounts.at (bankedMipLevelIndex (stagingBankIndex, mipIndex)) < stagingFrameCount)
                    return false;

            return true;
        }

        void commitStagingTable()
        {
            let hadActiveTable = isPlayable != 0;

            currentGeneration = stagingGeneration;
            currentTableIndex = stagingTableIndex;
            frameCount = stagingFrameCount;
            lastFrameIndex = stagingLastFrameIndex;
            lastFrameIndexF = stagingLastFrameIndexF;
            activeBankIndex = stagingBankIndex;
            stagingBankIndex = activeBankIndex == 0 ? 1 : 0;
            stagingGeneration = 0;
            stagingTableIndex = 0;
            stagingFrameCount = 0;
            stagingLastFrameIndex = 0;
            stagingLastFrameIndexF = 0.0f;

            if (! hadActiveTable)
                phasor.phase = 0.0f;

            isPlayable = 1;
            emitRuntimeServiceState();
        }

        void writeMipFrame (int32 bankIndex, int32 mipIndex, int32 frameIndex, const float32[] sourceSamples)
        {
            let bank = normalizeTableBankIndex (bankIndex);
            let base = frameBase (frameIndex);

            if (mipIndex == 0)
            {
                if (bank == 0)
                {
                    mip0Bank0Samples.at (base + 0) = sourceSamples.at (samplesPerFrame - 1);
                    for (int32 sampleIndex = 0; sampleIndex < samplesPerFrame; ++sampleIndex)
                        mip0Bank0Samples.at (base + sampleIndex + 1) = sourceSamples.at (sampleIndex);
                    mip0Bank0Samples.at (base + samplesPerFrame + 1) = sourceSamples.at (0);
                    mip0Bank0Samples.at (base + samplesPerFrame + 2) = sourceSamples.at (1);
                }
                else
                {
                    mip0Bank1Samples.at (base + 0) = sourceSamples.at (samplesPerFrame - 1);
                    for (int32 sampleIndex = 0; sampleIndex < samplesPerFrame; ++sampleIndex)
                        mip0Bank1Samples.at (base + sampleIndex + 1) = sourceSamples.at (sampleIndex);
                    mip0Bank1Samples.at (base + samplesPerFrame + 1) = sourceSamples.at (0);
                    mip0Bank1Samples.at (base + samplesPerFrame + 2) = sourceSamples.at (1);
                }

                return;
            }

            if (mipIndex == 1)
            {
                if (bank == 0)
                {
                    mip1Bank0Samples.at (base + 0) = sourceSamples.at (samplesPerFrame - 1);
                    for (int32 sampleIndex = 0; sampleIndex < samplesPerFrame; ++sampleIndex)
                        mip1Bank0Samples.at (base + sampleIndex + 1) = sourceSamples.at (sampleIndex);
                    mip1Bank0Samples.at (base + samplesPerFrame + 1) = sourceSamples.at (0);
