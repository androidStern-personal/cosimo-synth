        float32<modulationVoiceCoreLaneCount>[modulationVoiceSourceCount] voiceRouteCoreBiasVectors;
        float32<modulationVoiceGeneratorLaneCount>[modulationVoiceSourceCount] voiceRouteGeneratorScaleVectors;
        float32<modulationVoiceGeneratorLaneCount>[modulationVoiceSourceCount] voiceRouteGeneratorBiasVectors;
        int32 macroVoiceRouteCount;
        int32[modulationMacroVoiceRouteCellCount] macroVoiceRouteCells;
        int32[modulationMacroVoiceRouteCellCount] macroVoiceRouteSources;
        int32[modulationMacroVoiceRouteCellCount] macroVoiceRouteTargets;
        int32[modulationMacroVoiceRouteCellCount] macroVoiceRoutePolarities;
        float32[modulationMacroVoiceRouteCellCount] macroVoiceRouteAmounts;
        bool[modulationMacroSourceCount] macroVoiceRouteCoreSourceUsed;
        bool[modulationMacroSourceCount] macroVoiceRouteGeneratorSourceUsed;
        float32<modulationVoiceCoreLaneCount>[modulationMacroSourceCount] macroVoiceRouteCoreScaleVectors;
        float32<modulationVoiceCoreLaneCount>[modulationMacroSourceCount] macroVoiceRouteCoreBiasVectors;
        float32<modulationVoiceGeneratorLaneCount>[modulationMacroSourceCount] macroVoiceRouteGeneratorScaleVectors;
        float32<modulationVoiceGeneratorLaneCount>[modulationMacroSourceCount] macroVoiceRouteGeneratorBiasVectors;
        int32 voiceRackRouteCount;
        int32[modulationVoiceRackRouteCapacity] voiceRackRouteCells;
        int32[modulationVoiceRackRouteCapacity] voiceRackRouteSources;
        int32[modulationVoiceRackRouteCapacity] voiceRackRouteTargets;
        int32[modulationVoiceRackRouteCapacity] voiceRackRoutePolarities;
        int32[modulationVoiceRackRouteCapacity] voiceRackRouteReducers;
