namespace wt
{
    let samplesPerFrame = 2048;
    let paddedFrameSize = samplesPerFrame + 3;
    let mipLevelCount = 11;
    let brightestMipIndex = mipLevelCount - 1;
    let maxMipHarmonics = 1 << brightestMipIndex;
    let maxFramesPerTable = 256;
    let maxMipSampleCount = paddedFrameSize * maxFramesPerTable;
    let maxMipFrameSlots = mipLevelCount * maxFramesPerTable;
    let tableBankCount = 2;
    let maxBankedMipFrameSlots = maxMipFrameSlots * tableBankCount;
    let maxBankedMipLevelSlots = mipLevelCount * tableBankCount;
    let warpModeOff = 0;
    let warpModeBend = 1;
    let warpModePWM = 2;
    let warpModeAsym = 3;
    let warpModeMirror = 4;
    let filterModeOff = 0;
    let filterModeLowpass = 1;
    let filterModeHighpass = 2;
    let filterModeBandpass = 3;
    let filterModeNotch = 4;
    let filterModePeak = 5;
    let filterCutoffMinHz = 20.0f;
    let filterCutoffMaxHz = 20000.0f;
    let filterQMin = 0.1f;
    let filterQMax = 20.0f;
    let oscillatorCount = 3;
    let oscillatorA = 0;
    let oscillatorB = 1;
    let oscillatorC = 2;
    // Three independently published tables plus one bounded replacement slot.
    let wavetableSlotCount = oscillatorCount + 1;
    let packedSourceValueBits = 18;
    let packedSourceDerivativeBits = 32 - packedSourceValueBits;
    let packedSourceValueMaximum = (1 << (packedSourceValueBits - 1)) - 1;
    let packedSourceDerivativeMaximum = (1 << (packedSourceDerivativeBits - 1)) - 1;
    // Each mip frame stores one endpoint after the cycle body. Dark mips use
    // shorter power-of-two cycles; every length divides the 2048-sample upload.
    let packedWavetableSamplesPerFrameSet = 12811;
    let packedWavetableChunkCount = 4;
    let modulationMsegSlotCount = 3;
    let modulationEnvSlotCount = 3;
    let modulationVoiceSourceCount = 9;
    let modulationMacroSourceCount = 4;
    let modulationVoiceTargetCount = 12;
    // Shared rack destination domain. Kept here because several isolated oscillator
    // tests compile this module without VoiceReducer.cmajor.
    let rackModTargetCount = 36;
    let modulationVoiceRouteCellCount = modulationVoiceSourceCount * modulationVoiceTargetCount;
    let modulationMacroVoiceRouteCellCount = modulationMacroSourceCount * modulationVoiceTargetCount;
    let modulationVoiceRackRouteCellCount = modulationVoiceSourceCount * rackModTargetCount;
    let modulationMacroRackRouteCellCount = modulationMacroSourceCount * rackModTargetCount;

    struct VoiceModulationTargets
    {
        float32<modulationVoiceTargetCount> values;
    }
    let modulationArticulationRouteCellCount = modulationVoiceRouteCellCount + modulationMacroVoiceRouteCellCount;
    let modulationArticulationInheritAmount = 1000000.0f;
    let modulationPathVoice = 1;
    let modulationPathMacroVoice = 2;
    let modulationPathVoiceRack = 3;
    let modulationPathMacroRack = 4;
    // Shared reducer wire values. Zero remains invalid so a zero-initialised
    // voice-to-rack instruction cannot be published accidentally.
    let modulationReducerMaximum = 1;
    let modulationReducerMean = 2;
    let modulationSourceMseg = 1;
    let modulationSourceEnv = 2;
    let modulationSourceVelocity = 3;
    let modulationSourcePressure = 4;
    let modulationSourceSlide = 5;
    let modulationSourceMacro = 6;
    let macroSlotCount = 4;
    let modulationPolarityUnipolar = 0;
    let modulationPolarityBipolar = 1;
    let runtimeInstallRejectionNone = 0;
    let runtimeInstallRejectionSession = 1;
    let runtimeInstallRejectionGap = 2;
    let runtimeInstallRejectionInvalid = 3;
    let modulationTargetWavetablePosition = 1;
    let modulationTargetWarpAmount = 2;
    let modulationTargetFilterCutoffOctaves = 3;
    let modulationTargetFilterQ = 4;
    let modulationTargetPitchSemitones = 5;
    let modulationTargetAmpGainDb = 6;
    let modulationTargetPan = 7;
    let modulationTargetUnisonDetune = 8;
    let modulationTargetUnisonBlend = 9;
    let modulationTargetUnisonWidth = 10;
    let modulationTargetUnisonWavetablePositionSpread = 11;
    let modulationTargetUnisonWarpSpread = 12;
    let articulationSlotCount = 128;
    let articulationSelectorNone = -1;
    let maxUnisonVoiceCount = 8;
    let unisonPhaseModeContiguous = 0;
    let unisonPhaseModeReset = 1;
    let unisonDetuneModeLinear = 0;
    let unisonDetuneModeSuper = 1;
    let unisonDetuneModeExp = 2;
    let unisonDetuneModeInv = 3;
    let unisonDetuneModeRandom = 4;
    let unisonStackModeOff = 0;
    let unisonStackModeOctaves = 1;
    let unisonStackModeOctavesFifths = 2;
    let unisonStackModeCenterOctave = 3;
    let unisonStackModeCenterTwoOctaves = 4;
    let warpOversampleFactor = 8;
    let warpDecimatorTapCount = 257;
    let warpDecimatorCutoffNyquist = 0.125f;

