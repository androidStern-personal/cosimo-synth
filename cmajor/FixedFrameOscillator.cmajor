                int32 (voice), int32 (wrap<oscillatorCount> (oscillatorIndex)));
            return voiceUsesArticulation.at (voice)
                ? voiceArticulationUnisonWarpSpreads.at (index)
                : oscillatorWarpSpread (oscillatorIndex);
        }

        float32 voiceOscillatorPhase (int32 voiceIndex, int32 oscillatorIndex)
        {
            let voice = wrap<voiceCount> (voiceIndex);
            if (voiceUsesArticulation.at (voice))
                return voiceArticulationPhases.at (voiceArticulationOscillatorIndex (
                    int32 (voice), int32 (wrap<oscillatorCount> (oscillatorIndex))));

            return indexedPhaseState.at (wrap<oscillatorCount> (oscillatorIndex));
        }

        float32 voiceOscillatorPhaseRandom (int32 voiceIndex, int32 oscillatorIndex)
        {
            let voice = wrap<voiceCount> (voiceIndex);
            if (voiceUsesArticulation.at (voice))
                return voiceArticulationPhaseRandoms.at (voiceArticulationOscillatorIndex (
                    int32 (voice), int32 (wrap<oscillatorCount> (oscillatorIndex))));

            return indexedPhaseRandomState.at (wrap<oscillatorCount> (oscillatorIndex));
        }

        bool voiceOscillatorRetriggers (int32 voiceIndex, int32 oscillatorIndex)
        {
            let voice = wrap<voiceCount> (voiceIndex);
            if (voiceUsesArticulation.at (voice))
                return voiceArticulationRetriggers.at (voiceArticulationOscillatorIndex (
                    int32 (voice), int32 (wrap<oscillatorCount> (oscillatorIndex))));

            return indexedRetriggerState.at (wrap<oscillatorCount> (oscillatorIndex));
        }

        float32 voiceOscillatorTuningSemitones (int32 voiceIndex, int32 oscillatorIndex)
        {
            let voice = wrap<voiceCount> (voiceIndex);
            if (! voiceUsesArticulation.at (voice))
                return oscillatorTuningSemitones (oscillatorIndex);

            let index = voiceArticulationOscillatorIndex (
                int32 (voice), int32 (wrap<oscillatorCount> (oscillatorIndex)));
            let octave = std::intrinsics::clamp (int32 (std::intrinsics::floor (
                voiceArticulationOctaves.at (index) + 0.5f)), -4, 4);
            let semitone = std::intrinsics::clamp (int32 (std::intrinsics::floor (
                voiceArticulationSemitones.at (index) + 0.5f)), -12, 12);
            let fineCents = std::intrinsics::clamp (
                voiceArticulationFineCents.at (index), -100.0f, 100.0f);
            return float32 ((octave * 12) + semitone) + fineCents * 0.01f;
        }

        bool voiceHasSoloedOscillator (int32 voiceIndex)
        {
            let voice = wrap<voiceCount> (voiceIndex);
            if (! voiceUsesArticulation.at (voice))
                return anyOscillatorSoloed();

            for (wrap<oscillatorCount> oscillator)
                if (voiceArticulationSolos.at (voiceArticulationOscillatorIndex (
                    int32 (voice), int32 (oscillator))))
                    return true;

            return false;
        }

        bool voiceOscillatorIsAudible (int32 voiceIndex,
                                       int32 oscillatorIndex,
                                       bool hasSolo)
        {
            let voice = wrap<voiceCount> (voiceIndex);
            if (! voiceUsesArticulation.at (voice))
                return oscillatorIsAudible (oscillatorIndex, hasSolo);

            let index = voiceArticulationOscillatorIndex (
                int32 (voice), int32 (wrap<oscillatorCount> (oscillatorIndex)));
            return ! voiceArticulationMutes.at (index)
                && (! hasSolo || voiceArticulationSolos.at (index));
        }

        float32 voiceOscillatorVolumeDb (int32 voiceIndex, int32 oscillatorIndex)
        {
            let voice = wrap<voiceCount> (voiceIndex);
            if (! voiceUsesArticulation.at (voice))
                return oscillatorVolumeDb (oscillatorIndex);

            let index = voiceArticulationOscillatorIndex (
                int32 (voice), int32 (wrap<oscillatorCount> (oscillatorIndex)));
            return voiceArticulationVolumeDbs.at (index);
        }

        void resetFilterState (int32 voiceIndex)
        {
            let resolvedVoice = int32 (wrap<voiceCount> (voiceIndex));
            unisonLeftFilters.at (resolvedVoice).reset();
            unisonRightFilters.at (resolvedVoice).reset();
            voiceEnhancers.at (resolvedVoice).reset();
            voiceFilterKeyTrackSmoothedHz.at (resolvedVoice) = 0.0f;
        }

        void resetAllFilterState()
        {
            for (wrap<voiceCount> voice)
                resetFilterState (int32 (voice));
        }

        float32 unisonSpreadScalar (int32 subVoiceIndex, int32 voiceCountForNote, int32 detuneMode)
        {
            if (voiceCountForNote <= 1)
                return 0.0f;

            let normalized = (float32 (subVoiceIndex) / float32 (voiceCountForNote - 1)) * 2.0f - 1.0f;

            if (detuneMode == unisonDetuneModeSuper)
                return std::intrinsics::sin (normalized * 0.5f * float32 (pi));

            if (detuneMode == unisonDetuneModeExp)
            {
                let sign = normalized < 0.0f ? -1.0f : 1.0f;
                return sign * std::intrinsics::pow (std::intrinsics::abs (normalized), 1.6f);
            }

            if (detuneMode == unisonDetuneModeInv)
            {
                let sign = normalized < 0.0f ? -1.0f : 1.0f;
                return sign * (1.0f - std::intrinsics::pow (1.0f - std::intrinsics::abs (normalized), 1.6f));
            }

            if (detuneMode == unisonDetuneModeRandom)
            {
                let seeded = std::intrinsics::sin (
                    float32 ((subVoiceIndex + 1) * 37 + (voiceCountForNote * 19)) * 12.9898f
                ) * 43758.5453f;
                return (std::intrinsics::wrap (seeded, 1.0f) * 2.0f) - 1.0f;
            }

            return normalized;
        }

        float32 unisonStackSemitones (int32 subVoiceIndex, int32 voiceCountForNote, int32 stackMode)
        {
            if (voiceCountForNote <= 1 || stackMode == unisonStackModeOff)
                return 0.0f;

            if (stackMode == unisonStackModeOctaves)
                return float32 (subVoiceIndex) * 12.0f;

            if (stackMode == unisonStackModeOctavesFifths)
            {
                if ((subVoiceIndex % 2) == 0)
                    return float32 (subVoiceIndex / 2) * 12.0f;

                return (float32 (subVoiceIndex / 2) * 12.0f) + 7.0f;
            }

            let center = float32 (voiceCountForNote - 1) * 0.5f;
            let offset = float32 (subVoiceIndex) - center;

            if (stackMode == unisonStackModeCenterTwoOctaves)
                return offset * 24.0f;

            return offset * 12.0f;
        }

        float32 unisonSubVoiceWeight (int32 subVoiceIndex, int32 voiceCountForNote, float32 blend)
        {
            if (voiceCountForNote <= 1)
                return 1.0f;

            let clampedBlend = clampUnison01 (blend);
            let center = float32 (voiceCountForNote - 1) * 0.5f;
            let distanceFromCenter = std::intrinsics::abs (float32 (subVoiceIndex) - center);
            let maxDistance = center <= 0.0f ? 1.0f : center;
            let sideAmount = distanceFromCenter / maxDistance;
            return (1.0f - clampedBlend) * (1.0f - sideAmount) + clampedBlend;
        }

        float32 unisonSubVoicePhase (int32 voiceIndex,
                                     int32 oscillatorIndex,
                                     int32 subVoiceIndex,
                                     int32 generation,
                                     float32 phase,
                                     float32 randomAmount)
        {
            let clampedPhase = clampUnison01 (phase);
            let clampedRandom = clampUnison01 (randomAmount);
            let seeded = std::intrinsics::sin (
                float32 ((voiceIndex + 1) * 101
                         + oscillatorIndex * 503
                         + (subVoiceIndex + 1) * 1009
                         + (generation + 1) * 9176) * 12.9898f
            ) * 43758.5453f;
            let randomPhase = std::intrinsics::wrap (seeded, 1.0f);
            return std::intrinsics::wrap (clampedPhase + (randomPhase * clampedRandom), 1.0f);
        }

        void initialiseExternalRendererState()
        {
            for (int32 slotIndex = 0; slotIndex < wavetableSlotCount; ++slotIndex)
            {
                rendererInts.at (rendererFrameCountOffset + slotIndex) = 0;

                for (int32 mipIndex = 0; mipIndex < mipLevelCount; ++mipIndex)
                {
                    let metadataIndex = (slotIndex * mipLevelCount) + mipIndex;
                    rendererInts.at (rendererMipOffsetOffset + metadataIndex)
                        = packedMipOffset (mipIndex);
                    rendererInts.at (rendererMipLengthOffset + metadataIndex)
                        = packedMipLength (mipIndex);
                }
            }

            for (wrap<oscillatorCount> oscillator)
            {
                let oscillatorIndex = int32 (oscillator);
                let activeSlot = oscillatorActiveSlot.at (oscillator);
                rendererInts.at (rendererOscillatorSlotOffset + oscillatorIndex)
                    = activeSlot >= 0 ? activeSlot : 0;

                if (activeSlot >= 0)
                    rendererInts.at (rendererFrameCountOffset + activeSlot)
                        = oscillatorFrameCount.at (oscillator);
            }

            rendererInts.at (rendererOversampleFactorOffset)
                = processor.frequency >= 88200.0 ? 1 : 2;
            rendererInts.at (rendererUse441FilterOffset)
                = processor.frequency < 46000.0 ? 1 : 0;

            for (int32 index = 0; index < rendererFamilyBatchCount; ++index)
                rendererInts.at (rendererAtlasFamilyTargetOffset + index) = -1;

            for (int32 index = 0; index < rendererLaneCount; ++index)
                rendererInts.at (rendererCachedAtlasModeOffset + index) = -1;

            for (int32 index = 0; index < rendererNoteOscillatorModeCount; ++index)
            {
                rendererInts.at (rendererWarpModeOffset + index) = warpModeOff;
                rendererInts.at (rendererUnisonVoicesOffset + index) = 1;
                rendererFloats.at (rendererOscillatorGainOffset + index) = 0.0f;
            }
        }

        void clearExternalRendererVoiceControls (int32 voiceIndex)
        {
            let voice = int32 (wrap<voiceCount> (voiceIndex));

            for (wrap<oscillatorCount> oscillator)
            {
                let voiceOscillator = oscillatorVoiceIndex (voice, int32 (oscillator));
                rendererInts.at (rendererWarpModeOffset + voiceOscillator) = warpModeOff;
                rendererInts.at (rendererUnisonVoicesOffset + voiceOscillator) = 1;
                rendererFloats.at (rendererBasePhaseIncrementOffset + voiceOscillator) = 0.0f;
                rendererFloats.at (rendererOscillatorGainOffset + voiceOscillator) = 0.0f;
            }
        }

        void resetExternalRendererNoteHistory (int32 voiceIndex)
        {
            let voice = int32 (wrap<voiceCount> (voiceIndex));
            let historyChannelStride = 2 * 79 * 16;

            for (int32 channel = 0; channel < 2; ++channel)
                for (int32 historySample = 0; historySample < 2 * 79; ++historySample)
                    rendererFloats.at (rendererHistoryOffset
                        + (channel * historyChannelStride)
                        + (historySample * 16) + voice) = 0.0f;
        }

        void resetExternalRendererOscillatorPhases (int32 voiceIndex,
                                                    int32 oscillatorIndex,
                                                    int32 unisonVoiceCount,
                                                    float32 phase,
                                                    float32 randomAmount)
        {
            let voice = int32 (wrap<voiceCount> (voiceIndex));
            let oscillator = int32 (wrap<oscillatorCount> (oscillatorIndex));
            let generation = voiceGeneration.at (voice);

            for (wrap<maxUnisonVoiceCount> subVoice)
            {
                let subVoiceIndex = int32 (subVoice);
                let phaseForVoice = subVoiceIndex < unisonVoiceCount
                    ? unisonSubVoicePhase (
                        voice, oscillator, subVoiceIndex, generation, phase, randomAmount)
                    : 0.0f;
                rendererFloats.at (rendererPhaseOffset
                    + oscillatorLaneIndex (voice, oscillator, subVoiceIndex)) = phaseForVoice;
            }
        }

        void prepareExternalRendererOscillator (int32 voiceIndex,
                                                int32 oscillatorIndex,
                                                float32 effectivePosition,
                                                int32 effectiveWarpMode,
                                                float32 effectiveWarpAmount,
                                                float32 effectivePitchSemitones,
                                                float32 effectivePan,
                                                float32 oscillatorGain,
                                                int32 effectiveUnisonVoices,
                                                float32 effectiveUnisonDetune,
                                                float32 effectiveUnisonBlend,
                                                float32 effectiveUnisonWidth,
                                                int32 effectiveUnisonDetuneMode,
                                                int32 effectiveUnisonStackMode,
                                                float32 effectivePositionSpread,
                                                float32 effectiveWarpSpread)
        {
            let voice = int32 (wrap<voiceCount> (voiceIndex));
            let oscillator = int32 (wrap<oscillatorCount> (oscillatorIndex));
            let voiceOscillator = oscillatorVoiceIndex (voice, oscillator);
            let resolvedUnisonVoices = std::intrinsics::clamp (
                effectiveUnisonVoices, 1, maxUnisonVoiceCount);
            let activeSlot = oscillatorActiveSlot.at (oscillator);
            let canRender = oscillatorGain > 0.0f
                && activeSlot >= 0
                && oscillatorFrameCount.at (oscillator) > 0;
            let baseFrequencyHz = std::notes::noteToFrequency (effectivePitchSemitones);

            rendererFloats.at (rendererBasePhaseIncrementOffset + voiceOscillator)
                = baseFrequencyHz / float32 (processor.frequency);
            rendererFloats.at (rendererBasePositionOffset + voiceOscillator)
                = std::intrinsics::clamp (effectivePosition, 0.0f, 1.0f);
            rendererFloats.at (rendererBaseWarpAmountOffset + voiceOscillator)
                = std::intrinsics::clamp (effectiveWarpAmount, 0.0f, 1.0f);
            rendererFloats.at (rendererBasePanOffset + voiceOscillator)
                = clampPan (effectivePan);
            rendererFloats.at (rendererOscillatorGainOffset + voiceOscillator)
                = canRender ? oscillatorGain : 0.0f;
            rendererFloats.at (rendererUnisonDetuneOffset + voiceOscillator)
                = clampUnison01 (effectiveUnisonDetune);
            rendererFloats.at (rendererUnisonBlendOffset + voiceOscillator)
                = clampUnison01 (effectiveUnisonBlend);
            rendererFloats.at (rendererUnisonWidthOffset + voiceOscillator)
                = clampUnison01 (effectiveUnisonWidth);
            rendererFloats.at (rendererPositionSpreadOffset + voiceOscillator)
                = clampUnison01 (effectivePositionSpread);
            rendererFloats.at (rendererWarpSpreadOffset + voiceOscillator)
                = clampUnison01 (effectiveWarpSpread);
            rendererInts.at (rendererWarpModeOffset + voiceOscillator)
                = canRender ? effectiveWarpMode : warpModeOff;
            rendererInts.at (rendererUnisonVoicesOffset + voiceOscillator)
                = resolvedUnisonVoices;
            rendererInts.at (rendererUnisonDetuneModeOffset + voiceOscillator)
                = effectiveUnisonDetuneMode;
            rendererInts.at (rendererUnisonStackModeOffset + voiceOscillator)
                = effectiveUnisonStackMode;
        }

        int32 articulationOscillatorIndex (int32 selectorA, int32 oscillatorIndex)
        {
            return (selectorA * oscillatorCount) + oscillatorIndex;
        }

        int32 articulationMsegIndex (int32 selectorA, int32 slotIndex)
        {
            return (selectorA * modulationMsegSlotCount) + slotIndex;
        }

        int32 articulationRouteIndex (int32 selectorA, int32 routeIndex)
        {
            return (selectorA * modulationArticulationRouteCellCount) + routeIndex;
        }

        int32 articulationEnvelopeIndex (int32 selectorA, int32 slotIndex)
        {
            return (selectorA * modulationEnvSlotCount) + slotIndex;
        }

        bool articulationMaskContains (int32 mask, int32 bit)
        {
            return (mask & bit) != 0;
        }

        int32 articulationEnvelopeBit (int32 slotIndex, int32 fieldIndex)
        {
            return 1 << (articulationSharedEnvelopeBitOffset + (slotIndex * 4) + fieldIndex);
        }

        float32 baseMsegMorph (int32 slotIndex)
        {
            return indexedMsegMorphState.at (
                wrap<modulationMsegSlotCount> (slotIndex));
        }

        int32 voiceArticulationMsegIndex (int32 voiceIndex, int32 slotIndex)
        {
            return (voiceIndex * modulationMsegSlotCount) + slotIndex;
        }

        int32 voiceArticulationRouteIndex (int32 voiceIndex, int32 routeIndex)
        {
            return (voiceIndex * modulationArticulationRouteCellCount) + routeIndex;
        }

        int32 voiceArticulationEnvelopeIndex (int32 voiceIndex, int32 slotIndex)
        {
            return (voiceIndex * modulationEnvSlotCount) + slotIndex;
        }

        void clearVoiceArticulation (int32 voiceIndex)
        {
            let voice = wrap<voiceCount> (voiceIndex);
            voiceUsesArticulation.at (voice) = false;
            voiceSelectorA.at (voice) = wt::articulationSelectorNone;
            voiceSelectorB.at (voice) = 0;
            voiceArticulationDurationSamples.at (voice) = 0;
            voiceArticulationAgeSamples.at (voice) = 0;
        }

        void emitVoiceArticulationMonitor (int32 voiceIndex)
        {
            let voice = wrap<voiceCount> (voiceIndex);

            wt::VoiceArticulationMonitor monitor;
            monitor.voiceIndex = int32 (voice);
            monitor.hasArticulation = voiceUsesArticulation.at (voice) ? 1 : 0;
            monitor.selectorA = voiceSelectorA.at (voice);
            monitor.selectorB = voiceSelectorB.at (voice);
            monitor.durationSamples = voiceArticulationDurationSamples.at (voice);
            monitor.ageSamples = voiceArticulationAgeSamples.at (voice);
            monitor.framePosition = voiceUsesArticulation.at (voice)
                ? voiceArticulationFramePositions.at (voiceArticulationOscillatorIndex (
                    int32 (voice), oscillatorA))
                : 0.0f;
            monitor.mseg1Morph = voiceUsesArticulation.at (voice) ? voiceArticulationMsegMorphs.at (voiceArticulationMsegIndex (int32 (voice), 0)) : 0.0f;
            monitor.route1Amount = voiceUsesArticulation.at (voice) ? voiceArticulationRouteAmounts.at (voiceArticulationRouteIndex (int32 (voice), 0)) : 0.0f;
            voiceArticulationStartOut <- monitor;
        }

        void latchVoiceArticulation (int32 voiceIndex,
                                     bool hasArticulation,
                                     int32 selectorA,
                                     int32 selectorB,
                                     int32 durationSamples,
                                     int32 ageSamples)
        {
            let voice = wrap<voiceCount> (voiceIndex);

            if (! hasArticulation
                || selectorA < 0
                || selectorA >= articulationSlotCount
                || ! articulationSlotDefined.at (selectorA))
            {
                clearVoiceArticulation (voiceIndex);
                emitVoiceArticulationMonitor (voiceIndex);
                return;
            }

            voiceUsesArticulation.at (voice) = true;
            voiceSelectorA.at (voice) = selectorA;
            voiceSelectorB.at (voice) = selectorB;
            voiceArticulationDurationSamples.at (voice) = std::intrinsics::max (0, durationSamples);
            voiceArticulationAgeSamples.at (voice) = std::intrinsics::max (0, ageSamples);

            for (wrap<oscillatorCount> oscillator)
            {
                let storedIndex = articulationOscillatorIndex (selectorA, int32 (oscillator));
                let latchedIndex = voiceArticulationOscillatorIndex (
                    int32 (voice), int32 (oscillator));
                let overrideMask = articulationOscillatorOverrideMasks.at (storedIndex);
                voiceArticulationFramePositions.at (latchedIndex)
                    = articulationMaskContains (overrideMask, articulationOscillatorFramePositionBit)
                        ? articulationFramePositions.at (storedIndex)
                        : std::intrinsics::clamp (oscillatorFramePosition (int32 (oscillator)), 0.0f, 1.0f);
                voiceArticulationPans.at (latchedIndex)
                    = articulationMaskContains (overrideMask, articulationOscillatorPanBit)
                        ? articulationPans.at (storedIndex)
                        : clampPan (oscillatorPan (int32 (oscillator)));
                voiceArticulationOctaves.at (latchedIndex)
                    = articulationMaskContains (overrideMask, articulationOscillatorOctaveBit)
                        ? articulationOctaves.at (storedIndex)
                        : indexedOctaveState.at (oscillator);
                voiceArticulationSemitones.at (latchedIndex)
                    = articulationMaskContains (overrideMask, articulationOscillatorSemitoneBit)
                        ? articulationSemitones.at (storedIndex)
                        : indexedSemitoneState.at (oscillator);
                voiceArticulationFineCents.at (latchedIndex)
                    = articulationMaskContains (overrideMask, articulationOscillatorFineCentsBit)
                        ? articulationFineCents.at (storedIndex)
                        : indexedFineCentsState.at (oscillator);
                voiceArticulationPhases.at (latchedIndex)
                    = articulationMaskContains (overrideMask, articulationOscillatorPhaseBit)
                        ? articulationPhases.at (storedIndex)
                        : indexedPhaseState.at (oscillator);
                voiceArticulationPhaseRandoms.at (latchedIndex)
                    = articulationMaskContains (overrideMask, articulationOscillatorPhaseRandomBit)
                        ? articulationPhaseRandoms.at (storedIndex)
                        : indexedPhaseRandomState.at (oscillator);
                voiceArticulationRetriggers.at (latchedIndex)
                    = articulationMaskContains (overrideMask, articulationOscillatorRetriggerBit)
                        ? articulationRetriggers.at (storedIndex)
                        : indexedRetriggerState.at (oscillator);
                voiceArticulationVolumeDbs.at (latchedIndex)
                    = articulationMaskContains (overrideMask, articulationOscillatorVolumeDbBit)
                        ? articulationVolumeDbs.at (storedIndex)
                        : indexedVolumeDbState.at (oscillator);
                voiceArticulationMutes.at (latchedIndex)
                    = articulationMaskContains (overrideMask, articulationOscillatorMuteBit)
                        ? articulationMutes.at (storedIndex)
                        : indexedMuteState.at (oscillator);
                voiceArticulationSolos.at (latchedIndex)
                    = articulationMaskContains (overrideMask, articulationOscillatorSoloBit)
                        ? articulationSolos.at (storedIndex)
                        : indexedSoloState.at (oscillator);
                voiceArticulationWarpModes.at (latchedIndex)
                    = articulationMaskContains (overrideMask, articulationOscillatorWarpModeBit)
                        ? articulationWarpModes.at (storedIndex)
                        : oscillatorWarpMode (int32 (oscillator));
                voiceArticulationWarpAmounts.at (latchedIndex)
                    = articulationMaskContains (overrideMask, articulationOscillatorWarpAmountBit)
                        ? articulationWarpAmounts.at (storedIndex)
                        : std::intrinsics::clamp (oscillatorWarpAmount (int32 (oscillator)), 0.0f, 1.0f);
                voiceArticulationUnisonVoices.at (latchedIndex)
                    = articulationMaskContains (overrideMask, articulationOscillatorUnisonVoicesBit)
                        ? articulationUnisonVoices.at (storedIndex)
                        : oscillatorUnisonVoices (int32 (oscillator));
                voiceArticulationUnisonDetunes.at (latchedIndex)
                    = articulationMaskContains (overrideMask, articulationOscillatorUnisonDetuneBit)
                        ? articulationUnisonDetunes.at (storedIndex)
                        : oscillatorUnisonDetune (int32 (oscillator));
                voiceArticulationUnisonBlends.at (latchedIndex)
                    = articulationMaskContains (overrideMask, articulationOscillatorUnisonBlendBit)
                        ? articulationUnisonBlends.at (storedIndex)
                        : oscillatorUnisonBlend (int32 (oscillator));
                voiceArticulationUnisonWidths.at (latchedIndex)
                    = articulationMaskContains (overrideMask, articulationOscillatorUnisonWidthBit)
                        ? articulationUnisonWidths.at (storedIndex)
                        : oscillatorUnisonWidth (int32 (oscillator));
                voiceArticulationUnisonDetuneModes.at (latchedIndex)
                    = articulationMaskContains (overrideMask, articulationOscillatorUnisonDetuneModeBit)
                        ? articulationUnisonDetuneModes.at (storedIndex)
                        : oscillatorUnisonDetuneMode (int32 (oscillator));
                voiceArticulationUnisonStackModes.at (latchedIndex)
                    = articulationMaskContains (overrideMask, articulationOscillatorUnisonStackModeBit)
                        ? articulationUnisonStackModes.at (storedIndex)
                        : oscillatorUnisonStackMode (int32 (oscillator));
                voiceArticulationUnisonWavetablePositionSpreads.at (latchedIndex)
                    = articulationMaskContains (overrideMask, articulationOscillatorPositionSpreadBit)
                        ? articulationUnisonWavetablePositionSpreads.at (storedIndex)
                        : oscillatorPositionSpread (int32 (oscillator));
                voiceArticulationUnisonWarpSpreads.at (latchedIndex)
                    = articulationMaskContains (overrideMask, articulationOscillatorWarpSpreadBit)
                        ? articulationUnisonWarpSpreads.at (storedIndex)
                        : oscillatorWarpSpread (int32 (oscillator));
            }

            let sharedOverrideMask = articulationSharedOverrideMasks.at (selectorA);
            voiceArticulationFilterMode.at (voice)
                = articulationMaskContains (sharedOverrideMask, articulationSharedFilterModeBit)
                    ? articulationFilterMode.at (selectorA)
                    : indexedFilterModeState;
            voiceArticulationFilterCutoffHz.at (voice)
                = articulationMaskContains (sharedOverrideMask, articulationSharedFilterCutoffBit)
                    ? articulationFilterCutoffHz.at (selectorA)
                    : indexedFilterCutoffState;
            voiceArticulationFilterKeyTrackOffsetSemitones.at (voice)
                = articulationMaskContains (sharedOverrideMask, articulationSharedFilterKeyTrackOffsetBit)
                    ? articulationFilterKeyTrackOffsetSemitones.at (selectorA)
                    : indexedFilterKeyTrackOffsetSemitonesState;
            voiceArticulationFilterQ.at (voice)
                = articulationMaskContains (sharedOverrideMask, articulationSharedFilterQBit)
                    ? articulationFilterQ.at (selectorA)
                    : indexedFilterQState;

            for (int32 slotIndex = 0; slotIndex < modulationMsegSlotCount; ++slotIndex)
            {
                voiceArticulationMsegMorphs.at (voiceArticulationMsegIndex (int32 (voice), slotIndex))
                    = articulationMaskContains (sharedOverrideMask, articulationSharedMseg1Bit << slotIndex)
                        ? articulationMsegMorphs.at (articulationMsegIndex (selectorA, slotIndex))
                        : baseMsegMorph (slotIndex);
            }

            for (int32 routeIndex = 0; routeIndex < modulationArticulationRouteCellCount; ++routeIndex)
            {
                let storedAmount = articulationRouteAmounts.at (articulationRouteIndex (selectorA, routeIndex));
                let baseAmount = routeIndex < modulationVoiceRouteCellCount
                    ? voiceRouteAmounts.at (routeIndex)
                    : macroVoiceRouteAmounts.at (routeIndex - modulationVoiceRouteCellCount);
                voiceArticulationRouteAmounts.at (voiceArticulationRouteIndex (int32 (voice), routeIndex))
                    = storedAmount == modulationArticulationInheritAmount ? baseAmount : storedAmount;
            }

            rebuildVoiceArticulationRouteTransforms (voiceIndex, voiceRouteCount, macroVoiceRouteCount);

            for (int32 slotIndex = 0; slotIndex < modulationEnvSlotCount; ++slotIndex)
            {
                voiceArticulationEnvelopeAttackSeconds.at (voiceArticulationEnvelopeIndex (int32 (voice), slotIndex))
                    = articulationMaskContains (sharedOverrideMask, articulationEnvelopeBit (slotIndex, 0))
                        ? articulationEnvelopeAttackSeconds.at (articulationEnvelopeIndex (selectorA, slotIndex))
                        : currentEnvelopeAttackSeconds.at (slotIndex);
                voiceArticulationEnvelopeDecaySeconds.at (voiceArticulationEnvelopeIndex (int32 (voice), slotIndex))
                    = articulationMaskContains (sharedOverrideMask, articulationEnvelopeBit (slotIndex, 1))
                        ? articulationEnvelopeDecaySeconds.at (articulationEnvelopeIndex (selectorA, slotIndex))
                        : currentEnvelopeDecaySeconds.at (slotIndex);
                voiceArticulationEnvelopeSustain.at (voiceArticulationEnvelopeIndex (int32 (voice), slotIndex))
                    = articulationMaskContains (sharedOverrideMask, articulationEnvelopeBit (slotIndex, 2))
                        ? articulationEnvelopeSustain.at (articulationEnvelopeIndex (selectorA, slotIndex))
                        : currentEnvelopeSustain.at (slotIndex);
                voiceArticulationEnvelopeReleaseSeconds.at (voiceArticulationEnvelopeIndex (int32 (voice), slotIndex))
                    = articulationMaskContains (sharedOverrideMask, articulationEnvelopeBit (slotIndex, 3))
                        ? articulationEnvelopeReleaseSeconds.at (articulationEnvelopeIndex (selectorA, slotIndex))
                        : currentEnvelopeReleaseSeconds.at (slotIndex);
            }

            emitVoiceArticulationMonitor (voiceIndex);
        }

        void uploadMsegBufferToSlot (int32 slot, int32 shapeIndex, const float32[msegPaddedSamples] buffer)
        {
            wt::MsegBufferUpload shapeUpload;
            shapeUpload.shapeIndex = shapeIndex == 1 ? 1 : 0;

            for (int32 sampleIndex = 0; sampleIndex < msegPaddedSamples; ++sampleIndex)
                shapeUpload.buffer.at (sampleIndex) = buffer.at (sampleIndex);

            if (slot == 1)
            {
                for (wrap<voiceCount> voice)
                    mseg1[voice].bufferUpload <- shapeUpload;
                return;
            }

            if (slot == 2)
            {
                for (wrap<voiceCount> voice)
                    mseg2[voice].bufferUpload <- shapeUpload;
                return;
            }

            if (slot == 3)
            {
                for (wrap<voiceCount> voice)
                    mseg3[voice].bufferUpload <- shapeUpload;
            }
        }

        void uploadMsegPlaybackToSlot (int32 slot, wt::MsegPlaybackConfig config)
        {
            if (slot == 1)
            {
                for (wrap<voiceCount> voice)
                    mseg1[voice].playbackUpload <- config;
                return;
            }

            if (slot == 2)
            {
                for (wrap<voiceCount> voice)
                    mseg2[voice].playbackUpload <- config;
                return;
            }

            if (slot == 3)
            {
                for (wrap<voiceCount> voice)
                    mseg3[voice].playbackUpload <- config;
            }
        }

        void triggerVoiceModulators (int32 voiceIndex)
        {
            let voice = wrap<voiceCount> (voiceIndex);
            mseg1[voice].triggerIn <- 1;
            mseg2[voice].triggerIn <- 1;
            mseg3[voice].triggerIn <- 1;

            std::notes::NoteOn note;
            note.channel = voiceChannel.at (voice);
            note.pitch = voiceBasePitch.at (voice);
            note.velocity = voiceVelocity.at (voice);
            modEnv1[voice].eventIn <- note;
            modEnv2[voice].eventIn <- note;
            modEnv3[voice].eventIn <- note;
        }

        void noteOffVoiceModulators (int32 voiceIndex, std::notes::NoteOff note)
        {
            let voice = wrap<voiceCount> (voiceIndex);
            mseg1[voice].noteOffIn <- 1;
            mseg2[voice].noteOffIn <- 1;
            mseg3[voice].noteOffIn <- 1;
            modEnv1[voice].eventIn <- note;
            modEnv2[voice].eventIn <- note;
            modEnv3[voice].eventIn <- note;
        }

        float32 resolveVoiceMsegMorphBase (int32 voiceIndex, int32 slot)
        {
            let voice = wrap<voiceCount> (voiceIndex);

            if (voiceUsesArticulation.at (voice))
            {
                if (slot >= 1 && slot <= modulationMsegSlotCount)
                    return std::intrinsics::clamp (voiceArticulationMsegMorphs.at (voiceArticulationMsegIndex (int32 (voice), slot - 1)), 0.0f, 1.0f);

                return 0.0f;
            }

            if (slot == 1)
                return indexedMsegMorphState.at (0);

            if (slot == 2)
                return indexedMsegMorphState.at (1);

            if (slot == 3)
                return indexedMsegMorphState.at (2);

            return 0.0f;
        }

        float32 resolveVoiceMsegRateBase (int32 slotIndex)
        {
            return std::intrinsics::clamp (
                indexedMsegRateState.at (std::intrinsics::clamp (slotIndex, 0, modulationMsegSlotCount - 1)),
                0.0f,
                2.0f
            );
        }

        float32 resolveVoiceEnvelopeAttackBase (int32 voiceIndex, int32 slotIndex)
        {
            let voice = wrap<voiceCount> (voiceIndex);
            let index = voiceArticulationEnvelopeIndex (voiceIndex, slotIndex);
            return voiceUsesArticulation.at (voice)
                ? voiceArticulationEnvelopeAttackSeconds.at (index)
                : currentEnvelopeAttackSeconds.at (slotIndex);
        }

        float32 resolveVoiceEnvelopeDecayBase (int32 voiceIndex, int32 slotIndex)
        {
            let voice = wrap<voiceCount> (voiceIndex);
            let index = voiceArticulationEnvelopeIndex (voiceIndex, slotIndex);
            return voiceUsesArticulation.at (voice)
                ? voiceArticulationEnvelopeDecaySeconds.at (index)
                : currentEnvelopeDecaySeconds.at (slotIndex);
        }

        float32 resolveVoiceEnvelopeSustainBase (int32 voiceIndex, int32 slotIndex)
        {
            let voice = wrap<voiceCount> (voiceIndex);
            let index = voiceArticulationEnvelopeIndex (voiceIndex, slotIndex);
            return voiceUsesArticulation.at (voice)
                ? voiceArticulationEnvelopeSustain.at (index)
                : currentEnvelopeSustain.at (slotIndex);
        }

        float32 resolveVoiceEnvelopeReleaseBase (int32 voiceIndex, int32 slotIndex)
        {
            let voice = wrap<voiceCount> (voiceIndex);
            let index = voiceArticulationEnvelopeIndex (voiceIndex, slotIndex);
            return voiceUsesArticulation.at (voice)
                ? voiceArticulationEnvelopeReleaseSeconds.at (index)
                : currentEnvelopeReleaseSeconds.at (slotIndex);
        }

        float32 resolveMsegValue (int32 voiceIndex, int32 slot)
        {
            let voice = wrap<voiceCount> (voiceIndex);
            let morph = voiceEffectiveMsegMorphs.at (
                voiceArticulationMsegIndex (voiceIndex, slot - 1)
            );

            if (slot == 1)
            {
                return mseg1[voice].outA + ((mseg1[voice].outB - mseg1[voice].outA) * morph);
            }

            if (slot == 2)
            {
                return mseg2[voice].outA + ((mseg2[voice].outB - mseg2[voice].outA) * morph);
            }

            if (slot == 3)
            {
                return mseg3[voice].outA + ((mseg3[voice].outB - mseg3[voice].outA) * morph);
            }

            return 0.0f;
        }

        float32 resolveEnvValue (int32 voiceIndex, int32 slot)
        {
            let voice = wrap<voiceCount> (voiceIndex);

            if (slot == 1) return modEnv1[voice].gainOut;
            if (slot == 2) return modEnv2[voice].gainOut;
            if (slot == 3) return modEnv3[voice].gainOut;

            return 0.0f;
        }

        float32 resolveMacroValue (int32 slot)
        {
            if (slot == 1) return std::intrinsics::clamp (macro1In, 0.0f, 1.0f);
            if (slot == 2) return std::intrinsics::clamp (macro2In, 0.0f, 1.0f);
            if (slot == 3) return std::intrinsics::clamp (macro3In, 0.0f, 1.0f);
            if (slot == 4) return std::intrinsics::clamp (macro4In, 0.0f, 1.0f);

            return 0.0f;
        }

        float32 resolveVoiceSourceValue (int32 voiceIndex, int32 sourceIndex)
        {
            if (sourceIndex < 3)
                return resolveMsegValue (voiceIndex, sourceIndex + 1);

            if (sourceIndex < 6)
                return resolveEnvValue (voiceIndex, sourceIndex - 2);

            let voice = wrap<voiceCount> (voiceIndex);

            if (sourceIndex == 6)
                return std::intrinsics::clamp (voiceVelocity.at (voice), 0.0f, 1.0f);

            if (sourceIndex == 7)
                return std::intrinsics::clamp (voicePressure.at (voice), 0.0f, 1.0f);

            if (sourceIndex == 8)
                return std::intrinsics::clamp (voiceSlide.at (voice), 0.0f, 1.0f);

            if (sourceIndex == 9)
                return ampEnvelopes[voice].gainOut
                    * voiceAmpEnvelopeInverseVelocity.at (voice);

            return 0.0f;
        }

        void beginModulationFrame()
        {
            for (wrap<modulationMacroSourceCount> macroIndex)
                macroSourceValues[macroIndex] = resolveMacroValue (int32 (macroIndex) + 1);

            macroVoiceCoreBaseTargetOffsets = float32<modulationVoiceCoreLaneCount> (0.0f);
            macroVoiceGeneratorBaseTargetOffsets = float32<modulationVoiceGeneratorLaneCount> (0.0f);

            for (wrap<modulationMacroSourceCount> sourceIndex)
            {
                if (macroVoiceRouteCoreSourceUsed[sourceIndex])
                    macroVoiceCoreBaseTargetOffsets += (
                        macroVoiceRouteCoreScaleVectors[sourceIndex] * macroSourceValues[sourceIndex]
                    ) + macroVoiceRouteCoreBiasVectors[sourceIndex];

                if (macroVoiceRouteGeneratorSourceUsed[sourceIndex])
                    macroVoiceGeneratorBaseTargetOffsets += (
                        macroVoiceRouteGeneratorScaleVectors[sourceIndex] * macroSourceValues[sourceIndex]
                    ) + macroVoiceRouteGeneratorBiasVectors[sourceIndex];
            }

            if (voiceRackRouteCount != 0)
            {
                for (wrap<modulationVoiceSourceCount> sourceIndex)
                {
                    voiceRackSourceSums[sourceIndex] = 0.0f;
                    voiceRackSourceMaxima[sourceIndex] = 0.0f;
                    voiceRackSourceBipolarStrongest[sourceIndex] = 0.0f;
                    voiceRackSourceBipolarMagnitudes[sourceIndex] = 0.0f;
                }
            }

            voiceRackParticipantCount = 0;
        }

        void clearVoiceTargetOffsets (int32 voiceIndex)
        {
            let voice = wrap<voiceCount> (voiceIndex);
            voiceTargetOffsets[voice].coreValues
                = float32<modulationVoiceCoreLaneCount> (0.0f);
            voiceTargetOffsets[voice].generatorValues
                = float32<modulationVoiceGeneratorLaneCount> (0.0f);
        }

        void setVoiceModulationTransformTarget (VoiceModulationTransform& transform, int32 targetIndex,
                                                float32 amount, int32 polarityKind)
        {
            let scale = modulationRouteScale (amount, polarityKind);
            let bias = modulationRouteBias (amount, polarityKind);
            if (targetIndex < modulationVoiceCoreLaneCount)
            {
                transform.coreScales.at (targetIndex) = scale;
                transform.coreBiases.at (targetIndex) = bias;
                return;
            }

            let generatorTargetIndex = targetIndex - modulationVoiceCoreLaneCount;
            transform.generatorScales.at (generatorTargetIndex) = scale;
            transform.generatorBiases.at (generatorTargetIndex) = bias;
        }

        void rebuildVoiceArticulationRouteTransforms (int32 voiceIndex,
                                                       int32 nextVoiceRouteCount,
                                                       int32 nextMacroVoiceRouteCount)
        {
            let voice = wrap<voiceCount> (voiceIndex);
            VoiceModulationTransform emptyTransform;

            for (wrap<modulationVoiceSourceCount> sourceIndex)
                voiceArticulationRouteTransforms[voice].voiceSources[sourceIndex] = emptyTransform;

            for (wrap<modulationMacroSourceCount> sourceIndex)
                voiceArticulationRouteTransforms[voice].macroSources[sourceIndex] = emptyTransform;

            for (wrap<modulationVoiceRouteCellCount> routeIndex)
            {
                if (int32 (routeIndex) >= nextVoiceRouteCount)
                    break;

                let sourceIndex = voiceRouteSources[routeIndex];
                let targetIndex = voiceRouteTargets[routeIndex];
                let cellIndex = voiceRouteCells[routeIndex];
                let amount = voiceArticulationRouteAmounts.at (
                    voiceArticulationRouteIndex (voiceIndex, cellIndex)
                );
                setVoiceModulationTransformTarget (voiceArticulationRouteTransforms[voice].voiceSources.at (sourceIndex),
                                                    targetIndex, amount, voiceRoutePolarities[routeIndex]);
            }

            for (wrap<modulationMacroVoiceRouteCellCount> routeIndex)
            {
                if (int32 (routeIndex) >= nextMacroVoiceRouteCount)
                    break;

                let sourceIndex = macroVoiceRouteSources[routeIndex];
                let targetIndex = macroVoiceRouteTargets[routeIndex];
                let cellIndex = macroVoiceRouteCells[routeIndex];
                let amount = voiceArticulationRouteAmounts.at (
                    voiceArticulationRouteIndex (
                        voiceIndex,
                        modulationVoiceRouteCellCount + cellIndex
                    )
                );
                setVoiceModulationTransformTarget (voiceArticulationRouteTransforms[voice].macroSources.at (sourceIndex),
                                                    targetIndex, amount, macroVoiceRoutePolarities[routeIndex]);
            }
        }

        void accumulateVoiceModulationTargets (int32 voiceIndex)
        {
            let voice = wrap<voiceCount> (voiceIndex);
            let usesArticulation = voiceUsesArticulation.at (voice);

            if (usesArticulation)
            {
                clearVoiceTargetOffsets (voiceIndex);

                if (voiceRouteCount == 0 && macroVoiceRouteCount == 0)
                    return;

                for (wrap<modulationVoiceSourceCount> sourceIndex)
                {
                    if (! voiceRouteCoreSourceUsed[sourceIndex]
                        && ! voiceRouteGeneratorSourceUsed[sourceIndex])
                        continue;

                    let sourceValue = std::intrinsics::clamp (
                        resolveVoiceSourceValue (voiceIndex, int32 (sourceIndex)),
                        0.0f,
                        1.0f
                    );
                    if (voiceRouteCoreSourceUsed[sourceIndex])
                        voiceTargetOffsets[voice].coreValues += (
                            voiceArticulationRouteTransforms[voice].voiceSources[sourceIndex].coreScales * sourceValue
                        ) + voiceArticulationRouteTransforms[voice].voiceSources[sourceIndex].coreBiases;

                    if (voiceRouteGeneratorSourceUsed[sourceIndex])
                        voiceTargetOffsets[voice].generatorValues += (
                            voiceArticulationRouteTransforms[voice].voiceSources[sourceIndex].generatorScales * sourceValue
                        ) + voiceArticulationRouteTransforms[voice].voiceSources[sourceIndex].generatorBiases;
                }

                for (wrap<modulationMacroSourceCount> sourceIndex)
                {
                    if (! macroVoiceRouteCoreSourceUsed[sourceIndex]
                        && ! macroVoiceRouteGeneratorSourceUsed[sourceIndex])
                        continue;

                    if (macroVoiceRouteCoreSourceUsed[sourceIndex])
                        voiceTargetOffsets[voice].coreValues += (
                            voiceArticulationRouteTransforms[voice].macroSources[sourceIndex].coreScales * macroSourceValues[sourceIndex]
                        ) + voiceArticulationRouteTransforms[voice].macroSources[sourceIndex].coreBiases;

                    if (macroVoiceRouteGeneratorSourceUsed[sourceIndex])
                        voiceTargetOffsets[voice].generatorValues += (
                            voiceArticulationRouteTransforms[voice].macroSources[sourceIndex].generatorScales * macroSourceValues[sourceIndex]
                        ) + voiceArticulationRouteTransforms[voice].macroSources[sourceIndex].generatorBiases;
                }

                return;
            }

            voiceTargetOffsets[voice].coreValues = macroVoiceCoreBaseTargetOffsets;
            voiceTargetOffsets[voice].generatorValues = macroVoiceGeneratorBaseTargetOffsets;

            if (voiceRouteCount == 0 && macroVoiceRouteCount == 0)
                return;

            for (wrap<modulationVoiceSourceCount> sourceIndex)
            {
                if (! voiceRouteCoreSourceUsed[sourceIndex]
                    && ! voiceRouteGeneratorSourceUsed[sourceIndex])
                    continue;

                let sourceValue = std::intrinsics::clamp (
                    resolveVoiceSourceValue (voiceIndex, int32 (sourceIndex)),
                    0.0f,
                    1.0f
                );
                if (voiceRouteCoreSourceUsed[sourceIndex])
                    voiceTargetOffsets[voice].coreValues += (
                        voiceRouteCoreScaleVectors[sourceIndex] * sourceValue
                    ) + voiceRouteCoreBiasVectors[sourceIndex];

                if (voiceRouteGeneratorSourceUsed[sourceIndex])
                    voiceTargetOffsets[voice].generatorValues += (
                        voiceRouteGeneratorScaleVectors[sourceIndex] * sourceValue
                    ) + voiceRouteGeneratorBiasVectors[sourceIndex];
            }
        }

        float32 voiceTargetOffset (int32 voiceIndex, int32 targetIndex)
        {
            let voice = wrap<voiceCount> (voiceIndex);
            if (targetIndex < modulationVoiceCoreLaneCount)
                return voiceTargetOffsets[voice].coreValues.at (targetIndex);

            return voiceTargetOffsets[voice].generatorValues.at (
                targetIndex - modulationVoiceCoreLaneCount
            );
        }

        // One shared pitch authority for oscillator playback, Bounce playback,
        // and pitch-following effects. Oscillator-local tuning is deliberately
        // applied only after this value has been resolved.
        float32 resolveSharedPlayedPitchSemitones (int32 voiceIndex)
        {
            let voice = wrap<voiceCount> (voiceIndex);
            return voiceCurrentPitch.at (voice)
                + voiceBendSemitones.at (voice)
                + std::intrinsics::clamp (globalTuneIn, -24.0f, 24.0f)
                + voiceTargetOffset (voiceIndex, modulationTargetGlobalTuneSemitones);
        }

        float32 resolveAmpAttackBase()
        {
            return currentAmpAttackSeconds;
        }

        float32 resolveAmpDecayBase()
        {
            return currentAmpDecaySeconds;
        }

        float32 resolveAmpSustainBase()
        {
            return currentAmpSustain;
        }

        float32 resolveAmpReleaseBase()
        {
            return currentAmpReleaseSeconds;
        }

        void updateVoiceGeneratorModulationTargets (int32 voiceIndex)
        {
            voiceEffectiveMsegMorphs.at (voiceArticulationMsegIndex (voiceIndex, 0))
                = std::intrinsics::clamp (
                    resolveVoiceMsegMorphBase (voiceIndex, 1)
                        + voiceTargetOffset (voiceIndex, modulationTargetMseg1Morph),
                    0.0f,
                    1.0f
                );
            voiceEffectiveMsegMorphs.at (voiceArticulationMsegIndex (voiceIndex, 1))
                = std::intrinsics::clamp (
                    resolveVoiceMsegMorphBase (voiceIndex, 2)
                        + voiceTargetOffset (voiceIndex, modulationTargetMseg2Morph),
                    0.0f,
                    1.0f
                );
            voiceEffectiveMsegMorphs.at (voiceArticulationMsegIndex (voiceIndex, 2))
                = std::intrinsics::clamp (
                    resolveVoiceMsegMorphBase (voiceIndex, 3)
                        + voiceTargetOffset (voiceIndex, modulationTargetMseg3Morph),
                    0.0f,
                    1.0f
                );

            for (int32 slotIndex = 0; slotIndex < modulationMsegSlotCount; ++slotIndex)
            {
                voiceEffectiveMsegRates.at (voiceArticulationMsegIndex (voiceIndex, slotIndex))
                    = std::intrinsics::clamp (
                        resolveVoiceMsegRateBase (slotIndex)
                            + voiceTargetOffset (voiceIndex, modulationTargetMseg1Rate + slotIndex),
                        0.0f,
                        2.0f
                    );
            }

            for (int32 slotIndex = 0; slotIndex < modulationEnvSlotCount; ++slotIndex)
            {
                let effectiveIndex = voiceArticulationEnvelopeIndex (voiceIndex, slotIndex);
                let targetIndex = modulationTargetEnv1Attack + (slotIndex * 4);
                voiceEffectiveEnvelopeAttackSeconds.at (effectiveIndex)
                    = std::intrinsics::clamp (
                        resolveVoiceEnvelopeAttackBase (voiceIndex, slotIndex)
                            + voiceTargetOffset (voiceIndex, targetIndex),
                        0.001f,
                        10.0f
                    );
                voiceEffectiveEnvelopeDecaySeconds.at (effectiveIndex)
                    = std::intrinsics::clamp (
                        resolveVoiceEnvelopeDecayBase (voiceIndex, slotIndex)
                            + voiceTargetOffset (voiceIndex, targetIndex + 1),
                        0.001f,
                        10.0f
                    );
                voiceEffectiveEnvelopeSustain.at (effectiveIndex)
                    = std::intrinsics::clamp (
                        resolveVoiceEnvelopeSustainBase (voiceIndex, slotIndex)
                            + voiceTargetOffset (voiceIndex, targetIndex + 2),
                        0.0f,
                        1.0f
                    );
                voiceEffectiveEnvelopeReleaseSeconds.at (effectiveIndex)
                    = std::intrinsics::clamp (
                        resolveVoiceEnvelopeReleaseBase (voiceIndex, slotIndex)
                            + voiceTargetOffset (voiceIndex, targetIndex + 3),
                        0.001f,
                        10.0f
                    );
            }

            let voice = wrap<voiceCount> (voiceIndex);
            voiceEffectiveAmpAttackSeconds.at (voice) = std::intrinsics::clamp (
                resolveAmpAttackBase()
                    + voiceTargetOffset (voiceIndex, modulationTargetAmpAttack),
                0.001f,
                10.0f
            );
            voiceEffectiveAmpDecaySeconds.at (voice) = std::intrinsics::clamp (
                resolveAmpDecayBase()
                    + voiceTargetOffset (voiceIndex, modulationTargetAmpDecay),
                0.001f,
                10.0f
            );
            voiceEffectiveAmpSustain.at (voice) = std::intrinsics::clamp (
                resolveAmpSustainBase()
                    + voiceTargetOffset (voiceIndex, modulationTargetAmpSustain),
                0.0f,
                1.0f
            );
            voiceEffectiveAmpReleaseSeconds.at (voice) = std::intrinsics::clamp (
                resolveAmpReleaseBase()
                    + voiceTargetOffset (voiceIndex, modulationTargetAmpRelease),
                0.005f,
                10.0f
            );
        }

        void resetVoiceGeneratorModulationTargets (int32 voiceIndex)
        {
            for (int32 slotIndex = 0; slotIndex < modulationMsegSlotCount; ++slotIndex)
            {
                voiceEffectiveMsegMorphs.at (voiceArticulationMsegIndex (voiceIndex, slotIndex))
                    = resolveVoiceMsegMorphBase (voiceIndex, slotIndex + 1);
                voiceEffectiveMsegRates.at (voiceArticulationMsegIndex (voiceIndex, slotIndex))
                    = resolveVoiceMsegRateBase (slotIndex);
            }

            for (int32 slotIndex = 0; slotIndex < modulationEnvSlotCount; ++slotIndex)
            {
                let effectiveIndex = voiceArticulationEnvelopeIndex (voiceIndex, slotIndex);
                voiceEffectiveEnvelopeAttackSeconds.at (effectiveIndex)
                    = resolveVoiceEnvelopeAttackBase (voiceIndex, slotIndex);
                voiceEffectiveEnvelopeDecaySeconds.at (effectiveIndex)
                    = resolveVoiceEnvelopeDecayBase (voiceIndex, slotIndex);
                voiceEffectiveEnvelopeSustain.at (effectiveIndex)
                    = resolveVoiceEnvelopeSustainBase (voiceIndex, slotIndex);
                voiceEffectiveEnvelopeReleaseSeconds.at (effectiveIndex)
                    = resolveVoiceEnvelopeReleaseBase (voiceIndex, slotIndex);
            }

            let voice = wrap<voiceCount> (voiceIndex);
            voiceEffectiveAmpAttackSeconds.at (voice) = resolveAmpAttackBase();
            voiceEffectiveAmpDecaySeconds.at (voice) = resolveAmpDecayBase();
            voiceEffectiveAmpSustain.at (voice) = resolveAmpSustainBase();
            voiceEffectiveAmpReleaseSeconds.at (voice) = resolveAmpReleaseBase();
        }

        int32 oscillatorModulationTargetIndex (int32 oscillatorIndex, int32 localTargetIndex)
        {
            return (int32 (wrap<oscillatorCount> (oscillatorIndex)) * modulationOscillatorTargetCount)
                + int32 (wrap<modulationOscillatorTargetCount> (localTargetIndex));
        }

        float32 voiceOscillatorModulationOffset (int32 voiceIndex,
                                                  int32 oscillatorIndex,
                                                  int32 localTargetIndex)
        {
            return voiceTargetOffset (
                voiceIndex,
                oscillatorModulationTargetIndex (oscillatorIndex, localTargetIndex)
            );
        }

        void accumulateVoiceRackSources (int32 voiceIndex)
        {
            if (voiceRackRouteCount == 0)
                return;

            for (wrap<modulationVoiceSourceCount> sourceIndex)
            {
                if (! voiceRackSourceUsed[sourceIndex])
                    continue;

                let sourceValue = std::intrinsics::clamp (
                    resolveVoiceSourceValue (voiceIndex, int32 (sourceIndex)),
                    0.0f,
                    1.0f
                );
                let bipolarValue = (sourceValue * 2.0f) - 1.0f;
                let bipolarMagnitude = std::intrinsics::abs (bipolarValue);
                voiceRackSourceSums[sourceIndex] += sourceValue;
                voiceRackSourceMaxima[sourceIndex] = std::intrinsics::max (
                    voiceRackSourceMaxima[sourceIndex],
                    sourceValue
                );

                if (voiceRackParticipantCount == 0
                    || bipolarMagnitude > voiceRackSourceBipolarMagnitudes[sourceIndex])
                {
                    voiceRackSourceBipolarStrongest[sourceIndex] = bipolarValue;
                    voiceRackSourceBipolarMagnitudes[sourceIndex] = bipolarMagnitude;
                }
            }

            voiceRackParticipantCount += 1;
        }

        float32 resolveVoiceRackSource (int32 sourceIndex, int32 polarityKind, int32 reducerKind)
        {
            if (reducerKind == modulationReducerMean)
            {
                let mean = voiceRackSourceSums.at (sourceIndex) * voiceRackParticipantReciprocal;
                return applyModulationPolarity (mean, polarityKind);
            }

            if (polarityKind == modulationPolarityBipolar)
                return voiceRackSourceBipolarStrongest.at (sourceIndex);

            return voiceRackSourceMaxima.at (sourceIndex);
        }

        int32 resolveSourceMode()
        {
            return sourceModeState;
        }

        int32 bounceRootMetadataIndex (int32 slotIndex, int32 rootIndex)
        {
            return (slotIndex * bounceBankRootCapacity) + rootIndex;
        }

        bool bounceSlotIsInUse (int32 slotIndex)
        {
            for (wrap<voiceCount> voice)
                if (voiceBouncePlaying.at (voice)
                    && voiceBounceBankSlot.at (voice) == slotIndex)
                    return true;

            return false;
        }

        void writeBouncePackedFrame (int32 slotIndex, int32 frameIndex, int32 packedFrame)
        {
            let chunkIndex = frameIndex / bounceBankChunkFrameCount;
            let indexWithinChunk = frameIndex % bounceBankChunkFrameCount;

            if (slotIndex == 0)
            {
                if (chunkIndex == 0) bounceSlot0Chunk0.at (indexWithinChunk) = packedFrame;
                else if (chunkIndex == 1) bounceSlot0Chunk1.at (indexWithinChunk) = packedFrame;
                else if (chunkIndex == 2) bounceSlot0Chunk2.at (indexWithinChunk) = packedFrame;
                else if (chunkIndex == 3) bounceSlot0Chunk3.at (indexWithinChunk) = packedFrame;
                else if (chunkIndex == 4) bounceSlot0Chunk4.at (indexWithinChunk) = packedFrame;
                else if (chunkIndex == 5) bounceSlot0Chunk5.at (indexWithinChunk) = packedFrame;
                else if (chunkIndex == 6) bounceSlot0Chunk6.at (indexWithinChunk) = packedFrame;
                else bounceSlot0Chunk7.at (indexWithinChunk) = packedFrame;
            }
            else
            {
                if (chunkIndex == 0) bounceSlot1Chunk0.at (indexWithinChunk) = packedFrame;
                else if (chunkIndex == 1) bounceSlot1Chunk1.at (indexWithinChunk) = packedFrame;
                else if (chunkIndex == 2) bounceSlot1Chunk2.at (indexWithinChunk) = packedFrame;
                else if (chunkIndex == 3) bounceSlot1Chunk3.at (indexWithinChunk) = packedFrame;
                else if (chunkIndex == 4) bounceSlot1Chunk4.at (indexWithinChunk) = packedFrame;
                else if (chunkIndex == 5) bounceSlot1Chunk5.at (indexWithinChunk) = packedFrame;
                else if (chunkIndex == 6) bounceSlot1Chunk6.at (indexWithinChunk) = packedFrame;
                else bounceSlot1Chunk7.at (indexWithinChunk) = packedFrame;
            }
        }

        int32 readBouncePackedFrame (int32 slotIndex, int32 frameIndex)
        {
            let chunkIndex = frameIndex / bounceBankChunkFrameCount;
            let indexWithinChunk = frameIndex % bounceBankChunkFrameCount;

            if (slotIndex == 0)
            {
                if (chunkIndex == 0) return bounceSlot0Chunk0.at (indexWithinChunk);
                if (chunkIndex == 1) return bounceSlot0Chunk1.at (indexWithinChunk);
                if (chunkIndex == 2) return bounceSlot0Chunk2.at (indexWithinChunk);
                if (chunkIndex == 3) return bounceSlot0Chunk3.at (indexWithinChunk);
                if (chunkIndex == 4) return bounceSlot0Chunk4.at (indexWithinChunk);
                if (chunkIndex == 5) return bounceSlot0Chunk5.at (indexWithinChunk);
                if (chunkIndex == 6) return bounceSlot0Chunk6.at (indexWithinChunk);
                return bounceSlot0Chunk7.at (indexWithinChunk);
            }

            if (chunkIndex == 0) return bounceSlot1Chunk0.at (indexWithinChunk);
            if (chunkIndex == 1) return bounceSlot1Chunk1.at (indexWithinChunk);
            if (chunkIndex == 2) return bounceSlot1Chunk2.at (indexWithinChunk);
            if (chunkIndex == 3) return bounceSlot1Chunk3.at (indexWithinChunk);
            if (chunkIndex == 4) return bounceSlot1Chunk4.at (indexWithinChunk);
            if (chunkIndex == 5) return bounceSlot1Chunk5.at (indexWithinChunk);
            if (chunkIndex == 6) return bounceSlot1Chunk6.at (indexWithinChunk);
            return bounceSlot1Chunk7.at (indexWithinChunk);
        }

        float32<2> unpackBounceStereoFrame (int32 packedFrame)
        {
            int32 left = packedFrame & 65535;
            if (left >= 32768)
                left -= 65536;

            let right = packedFrame >> 16;
            return float32<2> (float32 (left) / 32768.0f,
                               float32 (right) / 32768.0f);
        }

        float32 interpolateBounceSample (float32 y0, float32 y1,
                                         float32 y2, float32 y3,
                                         float32 amount)
        {
            return y1 + (0.5f * amount * (
                y2 - y0 + (amount * (
                    (2.0f * y0) - (5.0f * y1) + (4.0f * y2) - y3
                    + (amount * ((3.0f * (y1 - y2)) + y3 - y0))
                ))
            ));
        }

        int32 findNearestBounceRoot (int32 slotIndex, float32 pitch)
        {
            let rootCount = bounceSlotRootCounts.at (slotIndex);
            int32 nearestRoot = 0;
            float32 nearestDistance = 1000.0f;

            for (int32 rootIndex = 0; rootIndex < rootCount; ++rootIndex)
            {
                let note = bounceSlotRootNotes.at (
                    bounceRootMetadataIndex (slotIndex, rootIndex));
                let distance = std::intrinsics::abs (pitch - float32 (note));
                // Strictly-less preserves the lower root on an exact tie.
                if (distance < nearestDistance)
                {
                    nearestRoot = rootIndex;
                    nearestDistance = distance;
                }
            }

            return nearestRoot;
        }

        void stopBounceSampleForVoice (int32 voiceIndex)
        {
            let voice = wrap<voiceCount> (voiceIndex);
            voiceBouncePlaying.at (voice) = false;
            voiceBouncePosition.at (voice) = 0.0;
            voiceBounceRootIndex.at (voice) = 0;
            voiceBounceBankSlot.at (voice) = -1;
        }

        void startBounceSampleForVoice (int32 voiceIndex, float32 pitch)
        {
            stopBounceSampleForVoice (voiceIndex);

            if (resolveSourceMode() != sourceModeBounce || bounceActiveSlot < 0)
                return;

            let voice = wrap<voiceCount> (voiceIndex);
            let rootIndex = findNearestBounceRoot (bounceActiveSlot, pitch);
            let metadataIndex = bounceRootMetadataIndex (bounceActiveSlot, rootIndex);
            if (bounceSlotRootFrameCounts.at (metadataIndex) <= 0)
                return;

            voiceBounceBankSlot.at (voice) = bounceActiveSlot;
            voiceBounceRootIndex.at (voice) = rootIndex;
            voiceBouncePosition.at (voice) = 0.0;
            voiceBouncePlaying.at (voice) = true;
        }

        float32<2> readBounceSampleForVoice (int32 voiceIndex)
        {
            let voice = wrap<voiceCount> (voiceIndex);
            if (! voiceBouncePlaying.at (voice))
                return float32<2> (0.0f);

            let slotIndex = voiceBounceBankSlot.at (voice);
            let rootIndex = voiceBounceRootIndex.at (voice);
            if (slotIndex < 0 || slotIndex >= bounceBankSlotCount
                || rootIndex < 0 || rootIndex >= bounceSlotRootCounts.at (slotIndex))
            {
                stopBounceSampleForVoice (voiceIndex);
                return float32<2> (0.0f);
            }

            let metadataIndex = bounceRootMetadataIndex (slotIndex, rootIndex);
            let frameOffset = bounceSlotRootFrameOffsets.at (metadataIndex);
            let frameCount = bounceSlotRootFrameCounts.at (metadataIndex);
            let position = voiceBouncePosition.at (voice);
            if (frameCount <= 0 || position >= float64 (frameCount))
            {
                stopBounceSampleForVoice (voiceIndex);
                return float32<2> (0.0f);
            }

            let centerIndex = int32 (std::intrinsics::floor (position));
            let amount = float32 (position - float64 (centerIndex));
            let local0 = std::intrinsics::clamp (centerIndex - 1, 0, frameCount - 1);
            let local1 = std::intrinsics::clamp (centerIndex, 0, frameCount - 1);
            let local2 = std::intrinsics::clamp (centerIndex + 1, 0, frameCount - 1);
            let local3 = std::intrinsics::clamp (centerIndex + 2, 0, frameCount - 1);
            let frame0 = unpackBounceStereoFrame (readBouncePackedFrame (slotIndex, frameOffset + local0));
            let frame1 = unpackBounceStereoFrame (readBouncePackedFrame (slotIndex, frameOffset + local1));
            let frame2 = unpackBounceStereoFrame (readBouncePackedFrame (slotIndex, frameOffset + local2));
            let frame3 = unpackBounceStereoFrame (readBouncePackedFrame (slotIndex, frameOffset + local3));
            let sample = float32<2> (
                interpolateBounceSample (frame0[0], frame1[0], frame2[0], frame3[0], amount),
                interpolateBounceSample (frame0[1], frame1[1], frame2[1], frame3[1], amount)
            );

            let rootNote = bounceSlotRootNotes.at (metadataIndex);
            let pitchSemitones = resolveSharedPlayedPitchSemitones (voiceIndex);
            let pitchRate = std::intrinsics::pow (
                2.0f, (pitchSemitones - float32 (rootNote)) / 12.0f);
            let sampleRateRatio = float32 (bounceSlotSampleRates.at (slotIndex))
                                / float32 (processor.frequency);
            voiceBouncePosition.at (voice) += float64 (pitchRate * sampleRateRatio);
            if (voiceBouncePosition.at (voice) >= float64 (frameCount))
                voiceBouncePlaying.at (voice) = false;

            // The bank is captured at fixed velocity 100. Calibrate that
            // source once, then let the same live per-note Amp Envelope own
            // all oscillator and Bounce loudness.
            return sample * (bouncePlaybackMakeupGain / bounceCaptureVelocityGain);
        }

        bool voiceIsSoundingForRackModulation (int32 voiceIndex)
        {
            let voice = wrap<voiceCount> (voiceIndex);
            return voiceActive.at (voice) != 0
                || ampEnvelopes[voice].gainOut > 0.0f;
        }

        void requestSourceModeTransition (int32 requestedMode)
        {
            let resolvedMode = requestedMode == sourceModeBounce
                ? sourceModeBounce : sourceModeOscillator;

            if (resolvedMode != sourceModeState)
            {
                pendingSourceModeState = resolvedMode;
                sourceModeFadeDirection = -1;
            }
            else if (sourceModeFadeDirection < 0)
            {
                // A host can supersede a queued swap before the zero crossing.
                pendingSourceModeState = sourceModeState;
                sourceModeFadeDirection = 1;
            }
        }

        void publishPendingSourceMode()
        {
            sourceModeState = pendingSourceModeState;

            for (wrap<voiceCount> voice)
            {
                let voiceIndex = int32 (voice);

                if (sourceModeState == sourceModeBounce)
                {
                    if (voiceIsSoundingForRackModulation (voiceIndex))
                        startBounceSampleForVoice (
                            voiceIndex,
                            voiceCurrentPitch.at (voice) + voiceBendSemitones.at (voice));
                }
                else
                {
                    // A paused reader would pin the old immutable bank slot.
                    stopBounceSampleForVoice (voiceIndex);
                }
            }
        }

        float32 advanceSourceModeTransition()
        {
            if (sourceModeFadeDirection < 0)
            {
                sourceModeFadeGain = std::intrinsics::max (
                    0.0f, sourceModeFadeGain - sourceModeFadeStep);

                if (sourceModeFadeGain <= 0.0f)
                {
                    publishPendingSourceMode();
                    sourceModeFadeDirection = 1;
                }
            }

            if (sourceModeFadeDirection > 0)
            {
                sourceModeFadeGain = std::intrinsics::min (
                    1.0f, sourceModeFadeGain + sourceModeFadeStep);

                if (sourceModeFadeGain >= 1.0f)
                    sourceModeFadeDirection = 0;
            }

            return sourceModeFadeGain;
        }

        // Called from every accepted program install, at event rate. Routed
        // membership only changes here; amount edits keep their route and so
        // keep its target's lane. Accumulators for every currently live lane
        // are re-zeroed because the audio loop now zeroes only the lanes the
        // installed route prefix is about to write: a lane whose route was
        // just removed must decay from its smoothed value toward zero, not
        // toward a stale accumulated offset.
        void rebuildRackModulationLiveSet()
        {
            for (int32 liveIndex = 0; liveIndex < rackModLiveTargetCount; ++liveIndex)
                rackModAccumulator.at (rackModLiveTargets.at (liveIndex)) = 0.0f;

            for (wrap<rackModTargetCount> target)
                rackModTargetRouted[target] = false;

            for (int32 routeIndex = 0; routeIndex < voiceRackRouteCount; ++routeIndex)
                rackModTargetRouted.at (voiceRackRouteTargets.at (routeIndex)) = true;

            for (int32 routeIndex = 0; routeIndex < macroRackRouteCount; ++routeIndex)
                rackModTargetRouted.at (macroRackRouteTargets.at (routeIndex)) = true;

            rackModHasMacroRackRoutes = macroRackRouteCount > 0;

            for (wrap<rackModTargetCount> target)
            {
                if (rackModTargetRouted[target] && ! rackModTargetLive[target])
                {
                    rackModTargetLive[target] = true;
                    rackModLiveTargets.at (rackModLiveTargetCount) = int32 (target);
                    rackModLiveTargetCount += 1;
                }
            }
        }

        void updateRackModulationOutputs()
        {
            if (voiceRackParticipantCount > 0)
                voiceRackParticipantReciprocal = 1.0f / float32 (voiceRackParticipantCount);

            for (int32 routeIndex = 0; routeIndex < voiceRackRouteCount; ++routeIndex)
                rackModAccumulator.at (voiceRackRouteTargets.at (routeIndex)) = 0.0f;

            for (wrap<modulationVoiceRackRouteCapacity> routeIndex)
            {
                if (int32 (routeIndex) >= voiceRackRouteCount)
                    break;

                let cellIndex = wrap<modulationVoiceRackRouteCellCount> (voiceRackRouteCells[routeIndex]);
                let sourceIndex = voiceRackRouteSources[routeIndex];

                if (voiceRackParticipantCount > 0)
                {
                    voiceRackCellHeldSources[cellIndex] = resolveVoiceRackSource (
                        sourceIndex,
                        voiceRackRoutePolarities[routeIndex],
                        voiceRackRouteReducers[routeIndex]
                    );
                    voiceRackCellGates[cellIndex] = 1.0f;
                }
                else
                {
                    voiceRackCellGates[cellIndex] = std::intrinsics::max (
                        0.0f,
                        voiceRackCellGates[cellIndex] - rackModGateReleaseStepState
                    );
                }

                let target = wrap<rackModTargetCount> (voiceRackRouteTargets[routeIndex]);
                rackModAccumulator[target] += voiceRackCellHeldSources[cellIndex]
                    * voiceRackCellGates[cellIndex]
                    * voiceRackRouteAmounts[cellIndex];
            }

            if (rackModHasMacroRackRoutes)
            {
                for (wrap<rackModBlockCount> block)
                    macroRackBaseTargetOffsets[block] = float32<rackModStaticTargetCount> (0.0f);

                for (wrap<modulationMacroSourceCount> sourceIndex)
                {
                    if (macroRackRouteSourceUsed[sourceIndex])
                    {
                        for (wrap<rackModBlockCount> block)
                            macroRackBaseTargetOffsets[block] += (
                                macroRackRouteScaleVectors[sourceIndex, block] * macroSourceValues[sourceIndex]
                            ) + macroRackRouteBiasVectors[sourceIndex, block];
                    }
                }
            }

            // Only live lanes smooth and publish. A lane leaves the list
            // when it is unrouted and its one-pole has snapped to exactly
            // zero; that zero is written before removal, so a dormant lane's
            // last published value is always 0 and skipping it is
            // bit-identical to the dense loop this replaces.
            for (int32 liveIndex = 0; liveIndex < rackModLiveTargetCount;)
            {
                let target = wrap<rackModTargetCount> (rackModLiveTargets.at (liveIndex));
                let block = wrap<rackModBlockCount> (int32 (target) / rackModStaticTargetCount);
                let lane = wrap<rackModStaticTargetCount> (int32 (target) % rackModStaticTargetCount);
                let macroOffset = rackModHasMacroRackRoutes
                    ? macroRackBaseTargetOffsets[block][lane]
                    : 0.0f;
                let smoothed = rackModSmoothTowards (rackModSmoothed[target],
                                                     rackModAccumulator[target] + macroOffset,
                                                     rackModSmoothingCoefficientState);
                rackModSmoothed[target] = smoothed;
                rackModOut[target] <- smoothed;

                if (smoothed == 0.0f && ! rackModTargetRouted[target])
                {
                    rackModTargetLive[target] = false;
                    rackModLiveTargetCount -= 1;
                    rackModLiveTargets.at (liveIndex) = rackModLiveTargets.at (rackModLiveTargetCount);
                }
                else
                {
                    ++liveIndex;
                }
            }
        }

        void clearTableStagingIdentity()
        {
            tableStagingOscillatorIndex = -1;
            tableStagingSlotIndex = -1;
            tableStagingGeneration = 0;
            tableStagingTableIndex = 0;
            tableStagingFrameCount = 0;
            tableStagingLastFrameIndex = 0;
            tableStagingLastFrameIndexF = 0.0f;
        }

        void commitPackedStagingTable()
        {
            let oscillator = tableStagingOscillatorIndex;
            let committedSlot = tableStagingSlotIndex;
            let hadActiveTable = oscillatorActiveSlot.at (oscillator) >= 0;

            oscillatorCurrentGeneration.at (oscillator) = tableStagingGeneration;
            oscillatorCurrentTableIndex.at (oscillator) = tableStagingTableIndex;
            oscillatorFrameCount.at (oscillator) = tableStagingFrameCount;
            oscillatorLastFrameIndex.at (oscillator) = tableStagingLastFrameIndex;
            oscillatorLastFrameIndexF.at (oscillator) = tableStagingLastFrameIndexF;
            oscillatorActiveSlot.at (oscillator) = committedSlot;

            rendererInts.at (rendererOscillatorSlotOffset + oscillator) = committedSlot;
            rendererInts.at (rendererFrameCountOffset + committedSlot)
                = tableStagingFrameCount;

            if (! hadActiveTable)
            {
                for (wrap<voiceCount> voice)
                {
                    let resolvedVoice = int32 (voice);
                    resetExternalRendererOscillatorPhases (
                        resolvedVoice, oscillator, maxUnisonVoiceCount, 0.0f, 0.0f);
                }
            }

            WavetableSlotMonitor slotMonitor;
            slotMonitor.oscillatorIndex = oscillator;
            slotMonitor.activeSlotIndex = committedSlot;
            slotMonitor.tableIndex = oscillatorCurrentTableIndex.at (oscillator);
            slotMonitor.generation = oscillatorCurrentGeneration.at (oscillator);
            wavetableSlotMonitorOut <- slotMonitor;

            clearTableStagingIdentity();
            emitRuntimeServiceState (oscillator);
        }

        void emitUploadAck (int32 oscillatorIndex,
                            int32 generation,
                            int32 tableIndex,
                            int32 mipIndex,
                            int32 uploadedFrameIndexBase,
                            int32 uploadedFrameCount)
        {
            OscillatorWavetableUploadAck oscillatorAck;
            oscillatorAck.dspSessionId = currentDspSessionId;
            oscillatorAck.oscillatorIndex = oscillatorIndex;
            oscillatorAck.generation = generation;
            oscillatorAck.tableIndex = tableIndex;
            oscillatorAck.mipIndex = mipIndex;
            oscillatorAck.frameIndexBase = uploadedFrameIndexBase;
            oscillatorAck.frameCount = uploadedFrameCount;
            oscillatorWavetableUploadAckOut <- oscillatorAck;
        }

        void emitRuntimeServiceState (int32 oscillatorIndex)
        {
            let oscillator = int32 (wrap<oscillatorCount> (oscillatorIndex));

            let hasActive = oscillatorActiveSlot.at (oscillator) >= 0 ? 1 : 0;
            let hasLoading = tableStagingOscillatorIndex == oscillator
                && tableStagingGeneration > 0 && tableStagingFrameCount > 0 ? 1 : 0;
            OscillatorRuntimeServiceState oscillatorState;
            oscillatorState.dspSessionId = currentDspSessionId;
            oscillatorState.oscillatorIndex = oscillator;
            oscillatorState.generationFrontier = oscillatorGenerationFrontier.at (oscillator);
            oscillatorState.serviceState = hasLoading != 0 ? 1 : (hasActive != 0 ? 2 : 0);
            oscillatorState.hasActive = hasActive;
            oscillatorState.activeTableIndex = hasActive != 0
                ? oscillatorCurrentTableIndex.at (oscillator) : 0;
            oscillatorState.activeGeneration = hasActive != 0
                ? oscillatorCurrentGeneration.at (oscillator) : 0;
            oscillatorState.hasLoading = hasLoading;
            oscillatorState.loadingTableIndex = hasLoading != 0 ? tableStagingTableIndex : 0;
            oscillatorState.loadingGeneration = hasLoading != 0 ? tableStagingGeneration : 0;
            oscillatorRuntimeServiceStateOut <- oscillatorState;
        }

        int32 findNewestVisibleGeneration()
        {
            int32 newestGeneration = 0;

            for (wrap<voiceCount> voice)
                newestGeneration = std::intrinsics::max (newestGeneration, voiceGeneration.at (voice));

            return newestGeneration;
        }

        int32 findNewestMonitoredVoiceIndex()
        {
            int32 newestGeneration = -1;
            int32 newestVoiceIndex = -1;

            for (wrap<voiceCount> voice)
            {
                let isVisible = voiceActive.at (voice) != 0 || ampEnvelopes[voice].gainOut > 0.0f;

                if (isVisible && voiceGeneration.at (voice) >= newestGeneration)
                {
                    newestGeneration = voiceGeneration.at (voice);
                    newestVoiceIndex = int32 (voice);
                }
            }

            return newestVoiceIndex;
        }

        void emitEffectiveWavetablePositionMonitor()
        {
            wt::EffectiveWavetablePositionMonitor monitor;
            let newestVoiceIndex = findNewestMonitoredVoiceIndex();

            if (newestVoiceIndex >= 0)
            {
                monitor.voiceGeneration = voiceGeneration.at (newestVoiceIndex);
                monitor.position = std::intrinsics::clamp (voiceEffectivePosition.at (newestVoiceIndex), 0.0f, 1.0f);
            }
            else
            {
                monitor.voiceGeneration = findNewestVisibleGeneration();
                monitor.position = std::intrinsics::clamp (
                    oscillatorFramePosition (oscillatorA), 0.0f, 1.0f);
            }

            effectiveWavetablePositionOut <- monitor;
        }

        void emitEffectiveWarpStateMonitor()
        {
            wt::EffectiveWarpStateMonitor monitor;
            let newestVoiceIndex = findNewestMonitoredVoiceIndex();

            if (newestVoiceIndex >= 0)
            {
                monitor.voiceGeneration = voiceGeneration.at (newestVoiceIndex);
                monitor.hasActive = 1;
                monitor.mode = voiceEffectiveWarpMode.at (newestVoiceIndex);
                monitor.amount = std::intrinsics::clamp (voiceEffectiveWarpAmount.at (newestVoiceIndex), 0.0f, 1.0f);
            }
            else
            {
                monitor.voiceGeneration = findNewestVisibleGeneration();
                monitor.hasActive = 0;
                monitor.mode = oscillatorWarpMode (oscillatorA);
                monitor.amount = std::intrinsics::clamp (
                    oscillatorWarpAmount (oscillatorA), 0.0f, 1.0f);
            }

            effectiveWarpStateOut <- monitor;
        }

        void emitEffectiveUnisonStateMonitor()
        {
            wt::EffectiveUnisonStateMonitor monitor;
            let newestVoiceIndex = findNewestMonitoredVoiceIndex();

            if (newestVoiceIndex >= 0)
            {
                monitor.voiceGeneration = voiceGeneration.at (newestVoiceIndex);
                monitor.hasActive = 1;
                monitor.voices = voiceEffectiveUnisonVoices.at (newestVoiceIndex);
                monitor.detune = voiceEffectiveUnisonDetune.at (newestVoiceIndex);
                monitor.blend = voiceEffectiveUnisonBlend.at (newestVoiceIndex);
                monitor.width = voiceEffectiveUnisonWidth.at (newestVoiceIndex);
                monitor.detuneMode = voiceEffectiveUnisonDetuneMode.at (newestVoiceIndex);
                monitor.stackMode = voiceEffectiveUnisonStackMode.at (newestVoiceIndex);
                monitor.wavetablePositionSpread = voiceEffectiveUnisonWavetablePositionSpread.at (newestVoiceIndex);
                monitor.warpSpread = voiceEffectiveUnisonWarpSpread.at (newestVoiceIndex);
            }
            else
            {
                monitor.voiceGeneration = findNewestVisibleGeneration();
                monitor.hasActive = 0;
                monitor.voices = oscillatorUnisonVoices (oscillatorA);
                monitor.detune = oscillatorUnisonDetune (oscillatorA);
                monitor.blend = oscillatorUnisonBlend (oscillatorA);
                monitor.width = oscillatorUnisonWidth (oscillatorA);
                monitor.detuneMode = oscillatorUnisonDetuneMode (oscillatorA);
                monitor.stackMode = oscillatorUnisonStackMode (oscillatorA);
                monitor.wavetablePositionSpread = oscillatorPositionSpread (oscillatorA);
                monitor.warpSpread = oscillatorWarpSpread (oscillatorA);
            }

            effectiveUnisonStateOut <- monitor;
        }

        void emitEffectiveFilterStateMonitor()
        {
            wt::EffectiveFilterStateMonitor monitor;
            let newestVoiceIndex = findNewestMonitoredVoiceIndex();

            if (newestVoiceIndex >= 0)
            {
                monitor.voiceGeneration = voiceGeneration.at (newestVoiceIndex);
                monitor.hasActive = 1;
                monitor.mode = voiceEffectiveFilterMode.at (newestVoiceIndex);
                monitor.cutoffHz = voiceEffectiveFilterCutoffHz.at (newestVoiceIndex);
                monitor.q = voiceEffectiveFilterQ.at (newestVoiceIndex);
            }
            else
            {
                let processorFrequency = float32 (processor.frequency);
                monitor.voiceGeneration = findNewestVisibleGeneration();
                monitor.hasActive = 0;
                monitor.mode = resolveFilterMode (filterModeIn);
                monitor.cutoffHz = clampFilterCutoffHz (filterCutoffIn, processorFrequency);
                monitor.q = clampFilterQ (filterQIn);
            }

            effectiveFilterStateOut <- monitor;
        }

        void emitEffectiveMsegStateMonitor()
        {
            wt::EffectiveMsegStateMonitor monitor;
            let newestVoiceIndex = findNewestMonitoredVoiceIndex();

            if (newestVoiceIndex >= 0)
            {
                monitor.voiceGeneration = voiceGeneration.at (newestVoiceIndex);
                monitor.hasActive = 1;
                monitor.positions[0] = std::intrinsics::clamp (voiceMsegProgress1.at (newestVoiceIndex), 0.0f, 1.0f);
                monitor.positions[1] = std::intrinsics::clamp (voiceMsegProgress2.at (newestVoiceIndex), 0.0f, 1.0f);
                monitor.positions[2] = std::intrinsics::clamp (voiceMsegProgress3.at (newestVoiceIndex), 0.0f, 1.0f);
            }
            else
            {
                monitor.voiceGeneration = findNewestVisibleGeneration();
                monitor.hasActive = 0;
                monitor.positions[0] = 0.0f;
                monitor.positions[1] = 0.0f;
                monitor.positions[2] = 0.0f;
            }

            effectiveMsegStateOut <- monitor;
        }

        void emitEffectiveModSourceStateMonitor()
        {
            wt::EffectiveModSourceStateMonitor monitor;
            let newestVoiceIndex = findNewestMonitoredVoiceIndex();

            if (newestVoiceIndex >= 0)
            {
                monitor.voiceGeneration = voiceGeneration.at (newestVoiceIndex);
                monitor.hasActive = 1;

                for (wrap<modulationVoiceSourceCount> source)
                    monitor.values[source] = std::intrinsics::clamp (
                        resolveVoiceSourceValue (newestVoiceIndex, int32 (source)),
                        0.0f,
                        1.0f);
            }
            else
            {
                monitor.voiceGeneration = findNewestVisibleGeneration();
                monitor.hasActive = 0;

                for (wrap<modulationVoiceSourceCount> source)
                    monitor.values[source] = 0.0f;
            }

            effectiveModSourceStateOut <- monitor;
        }

        void maybeEmitMonitorUpdate()
        {
            if (framesUntilNextMonitorUpdate <= 0)
            {
                emitEffectiveWavetablePositionMonitor();
                framesUntilNextMonitorUpdate = monitorUpdateIntervalFrames - 1;
            }
            else
            {
                framesUntilNextMonitorUpdate -= 1;
            }

            if (framesUntilNextWarpMonitorUpdate <= 0)
            {
                emitEffectiveWarpStateMonitor();
                framesUntilNextWarpMonitorUpdate = warpMonitorUpdateIntervalFrames - 1;
            }
            else
            {
                framesUntilNextWarpMonitorUpdate -= 1;
            }

            if (framesUntilNextUnisonMonitorUpdate <= 0)
            {
                emitEffectiveUnisonStateMonitor();
                framesUntilNextUnisonMonitorUpdate = unisonMonitorUpdateIntervalFrames - 1;
            }
            else
            {
                framesUntilNextUnisonMonitorUpdate -= 1;
            }

            if (framesUntilNextFilterMonitorUpdate <= 0)
            {
                emitEffectiveFilterStateMonitor();
                framesUntilNextFilterMonitorUpdate = filterMonitorUpdateIntervalFrames - 1;
            }
            else
            {
                framesUntilNextFilterMonitorUpdate -= 1;
            }

            if (framesUntilNextMsegMonitorUpdate <= 0)
            {
                emitEffectiveMsegStateMonitor();
                framesUntilNextMsegMonitorUpdate = msegMonitorUpdateIntervalFrames - 1;
            }
            else
            {
                framesUntilNextMsegMonitorUpdate -= 1;
            }

            if (framesUntilNextModSourceMonitorUpdate <= 0)
            {
                emitEffectiveModSourceStateMonitor();
                framesUntilNextModSourceMonitorUpdate = modSourceMonitorUpdateIntervalFrames - 1;
            }
            else
            {
                framesUntilNextModSourceMonitorUpdate -= 1;
            }
        }

        void emitOscillatorVoiceStart (int32 voiceIndex, int32 oscillatorIndex)
        {
            let voice = int32 (wrap<voiceCount> (voiceIndex));
            let oscillator = int32 (wrap<oscillatorCount> (oscillatorIndex));
            OscillatorVoiceStartMonitor monitor;
            monitor.voiceIndex = voice;
            monitor.oscillatorIndex = oscillator;
            monitor.voiceGeneration = voiceOscillatorGeneration.at (
                oscillatorVoiceIndex (voice, oscillator));
            monitor.channel = voiceChannel.at (voice);
            monitor.pitch = voiceBasePitch.at (voice);
            monitor.firstUnisonPhase = rendererFloats.at (
                rendererPhaseOffset + oscillatorLaneIndex (voice, oscillator, 0));
            monitor.lastUnisonPhase = rendererFloats.at (
                rendererPhaseOffset
                    + oscillatorLaneIndex (voice, oscillator, maxUnisonVoiceCount - 1));
            oscillatorVoiceStartOut <- monitor;
        }

        void resetVoiceOscillatorLifecycle (int32 voiceIndex)
        {
            let voice = int32 (wrap<voiceCount> (voiceIndex));
            resetExternalRendererNoteHistory (voice);

            for (wrap<oscillatorCount> oscillatorWrapped)
            {
                let oscillator = int32 (oscillatorWrapped);
                voiceOscillatorGeneration.at (oscillatorVoiceIndex (voice, oscillator))
                    = voiceGeneration.at (voice);

                if (voiceOscillatorRetriggers (voice, oscillator))
                    resetExternalRendererOscillatorPhases (
                        voice,
                        oscillator,
                        voiceOscillatorUnisonVoices (voice, oscillator),
                        voiceOscillatorPhase (voice, oscillator),
                        voiceOscillatorPhaseRandom (voice, oscillator)
                    );

                emitOscillatorVoiceStart (voice, oscillator);
            }
        }

        void clearVoiceGlide (int32 voiceIndex)
        {
            let voice = wrap<voiceCount> (voiceIndex);
            voicePitchGlideStep.at (voice) = 0.0f;
            voiceGlideSamplesRemaining.at (voice) = 0;
        }

        void setVoicePitchImmediate (int32 voiceIndex, float32 pitch)
        {
            let voice = wrap<voiceCount> (voiceIndex);
            voiceBasePitch.at (voice) = pitch;
            voiceCurrentPitch.at (voice) = pitch;
            voiceTargetPitch.at (voice) = pitch;
            clearVoiceGlide (voiceIndex);
        }

        void startVoiceGlideToPitch (int32 voiceIndex, float32 targetPitch)
        {
            let voice = wrap<voiceCount> (voiceIndex);
            voiceBasePitch.at (voice) = targetPitch;
            voiceTargetPitch.at (voice) = targetPitch;

            let requestedSeconds = std::intrinsics::max (0.0f, glideTimeSecondsState);
            let glideSamples = int32 (
                std::intrinsics::floor ((requestedSeconds * float32 (processor.frequency)) + 0.5f)
            );

            if (glideSamples <= 0 || std::intrinsics::abs (voiceCurrentPitch.at (voice) - targetPitch) <= 0.0001f)
            {
                setVoicePitchImmediate (voiceIndex, targetPitch);
                return;
            }

            voiceGlideSamplesRemaining.at (voice) = glideSamples;
            voicePitchGlideStep.at (voice) = (targetPitch - voiceCurrentPitch.at (voice)) / float32 (glideSamples);
        }

        void advanceVoicePitchState (int32 voiceIndex)
        {
            let voice = wrap<voiceCount> (voiceIndex);

            if (voiceGlideSamplesRemaining.at (voice) > 0)
            {
                voiceCurrentPitch.at (voice) += voicePitchGlideStep.at (voice);
                voiceGlideSamplesRemaining.at (voice) -= 1;

                if (voiceGlideSamplesRemaining.at (voice) <= 0)
                {
                    voiceCurrentPitch.at (voice) = voiceTargetPitch.at (voice);
                    clearVoiceGlide (voiceIndex);
                }
            }
        }

        void startVoiceFromNote (int32 index,
                                 std::notes::NoteOn note,
                                 bool hasArticulation,
                                 int32 selectorA,
                                 int32 selectorB,
                                 int32 durationSamples,
                                 int32 ageSamples)
        {
            let voice = wrap<voiceCount> (index);
            voiceChannel.at (voice) = note.channel;
            voiceVelocity.at (voice) = note.velocity;
            voiceAmpEnvelopeInverseVelocity.at (voice) = note.velocity > 0.0f
                ? 1.0f / note.velocity
                : 0.0f;
            voiceBendSemitones.at (voice) = 0.0f;
            voicePressure.at (voice) = 0.0f;
            voiceSlide.at (voice) = 0.0f;
            latchVoiceArticulation (index, hasArticulation, selectorA, selectorB, durationSamples, ageSamples);
            setVoicePitchImmediate (index, note.pitch);
            voiceActive.at (voice) = 1;
            voiceGeneration.at (voice) = nextVoiceGeneration;
            nextVoiceGeneration += 1;
            voiceTrackingSerial.at (voice) = nextVoiceTrackingSerial;
            nextVoiceTrackingSerial += 1;
            resetVoiceOscillatorLifecycle (index);
            startBounceSampleForVoice (index, note.pitch);
            resetFilterState (index);
            resetVoiceGeneratorModulationTargets (index);

            ampEnvelopes[voice].eventIn <- note;
            triggerVoiceModulators (index);
        }

        event voiceEventIn (int index, std::notes::NoteOn note)
        {
            startVoiceFromNote (int32 (index), note, false, wt::articulationSelectorNone, 0, 0, 0);
        }

        event voiceEventIn (int index, wt::ArticulatedNoteOn articulatedNote)
        {
            std::notes::NoteOn note;
            note.channel = articulatedNote.channel;
            note.pitch = articulatedNote.pitch;
            note.velocity = articulatedNote.velocity;
            startVoiceFromNote (int32 (index),
                                note,
                                articulatedNote.hasArticulation,
                                articulatedNote.selectorA,
                                articulatedNote.selectorB,
                                articulatedNote.durationSamples,
                                articulatedNote.ageSamples);
        }

        event voiceEventIn (int index, std::notes::NoteOff note)
        {
            let voice = wrap<voiceCount> (index);
            voiceActive.at (voice) = 0;
            ampEnvelopes[voice].eventIn <- note;
            noteOffVoiceModulators (index, note);
        }

        event voiceEventIn (int index, std::notes::PitchBend bend)
        {
            let voice = wrap<voiceCount> (index);
            voiceBendSemitones.at (voice) = bend.bendSemitones;
        }

        event voiceEventIn (int index, std::notes::Slide slide)
        {
            let voice = wrap<voiceCount> (index);
            voiceSlide.at (voice) = slide.slide;
        }

        event voiceEventIn (int index, std::notes::Pressure pressure)
        {
            let voice = wrap<voiceCount> (index);
            voicePressure.at (voice) = pressure.pressure;
        }

        event voiceEventIn (int index, std::notes::Control control) {}

        event voiceRetuneIn (int index, VoiceRetune change)
        {
            let voice = wrap<voiceCount> (index);
            let shouldRetrigger = change.retrigger || voiceActive.at (voice) == 0;
            let shouldGlide = change.glide && voiceActive.at (voice) != 0;

            voiceChannel.at (voice) = change.channel;
            voiceVelocity.at (voice) = change.velocity;
            voiceBendSemitones.at (voice) = change.bendSemitones;
            voicePressure.at (voice) = change.pressure;
            voiceSlide.at (voice) = change.slide;
            latchVoiceArticulation (index,
                                    change.hasArticulation,
                                    change.selectorA,
                                    change.selectorB,
                                    change.durationSamples,
                                    change.ageSamples);

            if (shouldGlide)
                startVoiceGlideToPitch (index, change.pitch);
            else
                setVoicePitchImmediate (index, change.pitch);

            voiceActive.at (voice) = 1;
            voiceTrackingSerial.at (voice) = nextVoiceTrackingSerial;
            nextVoiceTrackingSerial += 1;

            if (shouldRetrigger)
            {
                std::notes::NoteOn note;
                note.channel = change.channel;
                note.pitch = change.pitch;
                note.velocity = change.velocity;
                voiceAmpEnvelopeInverseVelocity.at (voice) = change.velocity > 0.0f
                    ? 1.0f / change.velocity
                    : 0.0f;
                voiceGeneration.at (voice) = nextVoiceGeneration;
                nextVoiceGeneration += 1;
                resetVoiceOscillatorLifecycle (index);
                startBounceSampleForVoice (index, change.pitch);
                resetFilterState (index);

                // A quiescent voice's effective envelope/MSEG values are
                // frozen along with the rest of it, so a retune out of
                // quiescence must refresh them from the current bases — the
                // per-frame reset used to do this implicitly. A retrigger of
                // a still-sounding voice keeps its live effectives, exactly
                // as before (startVoiceFromNote's poly path resets
                // unconditionally because a stolen voice starts over).
                if (! voiceWasSounding[voice])
                    resetVoiceGeneratorModulationTargets (index);

                ampEnvelopes[voice].eventIn <- note;
                triggerVoiceModulators (index);
            }
        }

        void rejectModulationProgram()
        {
            rejectedModulationRouteCount += 1;
            modulationRejectedRouteCountOut <- rejectedModulationRouteCount;
        }

        void emitRuntimeInstallAck (int32 rejectedSerial, int32 rejectionReason, int32 syncSerial)
        {
            RuntimeInstallAck ack;
            ack.dspSessionId = currentDspSessionId;
            ack.acceptedModulationSerial = acceptedModulationSerial;
            ack.acceptedModulationProgramSerial = acceptedModulationProgramSerial;
            ack.installedVoiceRouteCount = voiceRouteCount;
            ack.installedMacroVoiceRouteCount = macroVoiceRouteCount;
            ack.installedVoiceRackRouteCount = voiceRackRouteCount;
            ack.installedMacroRackRouteCount = macroRackRouteCount;
            ack.acceptedArticulationSerial = acceptedArticulationSerial;
            ack.rejectedSerial = rejectedSerial;
            ack.rejectionReason = rejectionReason;
            ack.syncSerial = syncSerial;
            runtimeInstallAckOut <- ack;
        }

        int32 beginModulationRuntimeInstall (int32 dspSessionId, int32 deliverySerial)
        {
            if (dspSessionId != currentDspSessionId)
            {
                emitRuntimeInstallAck (deliverySerial, runtimeInstallRejectionSession, 0);
                return 0;
            }

            if (deliverySerial <= 0 || deliverySerial > acceptedModulationSerial + 1)
            {
                emitRuntimeInstallAck (deliverySerial, runtimeInstallRejectionGap, 0);
                return 0;
            }

            if (deliverySerial <= acceptedModulationSerial)
            {
                emitRuntimeInstallAck (0, runtimeInstallRejectionNone, 0);
                return 0;
            }

            return 2;
        }

        int32 beginArticulationRuntimeInstall (int32 dspSessionId, int32 deliverySerial)
        {
            if (dspSessionId != currentDspSessionId)
            {
                emitRuntimeInstallAck (deliverySerial, runtimeInstallRejectionSession, 0);
                return 0;
            }

            if (deliverySerial >= 0 || deliverySerial < acceptedArticulationSerial - 1)
            {
                emitRuntimeInstallAck (deliverySerial, runtimeInstallRejectionGap, 0);
                return 0;
            }

            if (deliverySerial >= acceptedArticulationSerial)
            {
                emitRuntimeInstallAck (0, runtimeInstallRejectionNone, 0);
                return 0;
            }

            return 2;
        }

        void completeModulationRuntimeInstall (int32 deliverySerial)
        {
            if (deliverySerial > 0)
            {
                acceptedModulationSerial = deliverySerial;
                emitRuntimeInstallAck (0, runtimeInstallRejectionNone, 0);
            }
        }

        void completeArticulationRuntimeInstall (int32 deliverySerial)
        {
            if (deliverySerial < 0)
            {
                acceptedArticulationSerial = deliverySerial;
                emitRuntimeInstallAck (0, runtimeInstallRejectionNone, 0);
            }
        }

        void rejectRuntimeInstall (int32 deliverySerial)
        {
            if (deliverySerial != 0)
                emitRuntimeInstallAck (deliverySerial, runtimeInstallRejectionInvalid, 0);
        }

        event runtimeInstallSyncIn (int32 syncSerial)
        {
            emitRuntimeInstallAck (0, runtimeInstallRejectionNone, syncSerial);
        }

        event modulationProgramIn (ModulationProgramUpload upload)
        {
            let installKind = beginModulationRuntimeInstall (upload.dspSessionId, upload.deliverySerial);
            if (installKind == 0)
                return;

            if (! isValidModulationProgram (upload))
            {
                rejectModulationProgram();
                rejectRuntimeInstall (upload.deliverySerial);
                return;
            }

            for (int32 sourceIndex = 0; sourceIndex < modulationVoiceSourceCount; ++sourceIndex)
            {
                voiceRackSourceUsed.at (sourceIndex) = false;
                voiceRouteCoreSourceUsed.at (sourceIndex) = false;
                voiceRouteGeneratorSourceUsed.at (sourceIndex) = false;
                voiceRouteCoreScaleVectors.at (sourceIndex)
                    = float32<modulationVoiceCoreLaneCount> (0.0f);
                voiceRouteCoreBiasVectors.at (sourceIndex)
                    = float32<modulationVoiceCoreLaneCount> (0.0f);
                voiceRouteGeneratorScaleVectors.at (sourceIndex)
                    = float32<modulationVoiceGeneratorLaneCount> (0.0f);
                voiceRouteGeneratorBiasVectors.at (sourceIndex)
                    = float32<modulationVoiceGeneratorLaneCount> (0.0f);
            }

            for (int32 sourceIndex = 0; sourceIndex < modulationMacroSourceCount; ++sourceIndex)
            {
                macroVoiceRouteCoreSourceUsed.at (sourceIndex) = false;
                macroVoiceRouteGeneratorSourceUsed.at (sourceIndex) = false;
                macroVoiceRouteCoreScaleVectors.at (sourceIndex)
                    = float32<modulationVoiceCoreLaneCount> (0.0f);
                macroVoiceRouteCoreBiasVectors.at (sourceIndex)
                    = float32<modulationVoiceCoreLaneCount> (0.0f);
                macroVoiceRouteGeneratorScaleVectors.at (sourceIndex)
                    = float32<modulationVoiceGeneratorLaneCount> (0.0f);
                macroVoiceRouteGeneratorBiasVectors.at (sourceIndex)
                    = float32<modulationVoiceGeneratorLaneCount> (0.0f);
                macroRackRouteSourceUsed.at (sourceIndex) = false;
                for (wrap<rackModBlockCount> block)
                {
                    macroRackRouteScaleVectors.at (sourceIndex, block)
                        = float32<rackModStaticTargetCount> (0.0f);
                    macroRackRouteBiasVectors.at (sourceIndex, block)
                        = float32<rackModStaticTargetCount> (0.0f);
                }
            }

            for (int32 cellIndex = 0; cellIndex < modulationVoiceRouteCellCount; ++cellIndex)
                voiceRouteAmounts.at (cellIndex) = upload.voiceRouteAmounts.at (cellIndex);

            for (int32 routeIndex = 0; routeIndex < upload.voiceRouteCount; ++routeIndex)
            {
                let cellIndex = upload.voiceRouteCells.at (routeIndex);
                let sourceIndex = upload.voiceRouteSources.at (routeIndex);
                let targetIndex = upload.voiceRouteTargets.at (routeIndex);
                let polarityKind = upload.voiceRoutePolarities.at (routeIndex);
                let amount = upload.voiceRouteAmounts.at (cellIndex);
                voiceRouteCells.at (routeIndex) = cellIndex;
                voiceRouteSources.at (routeIndex) = sourceIndex;
                voiceRouteTargets.at (routeIndex) = targetIndex;
                voiceRoutePolarities.at (routeIndex) = polarityKind;
                let scale = modulationRouteScale (amount, polarityKind);
                let bias = modulationRouteBias (amount, polarityKind);
                if (targetIndex < modulationVoiceCoreLaneCount)
                {
                    voiceRouteCoreSourceUsed.at (sourceIndex) = true;
                    voiceRouteCoreScaleVectors.at (sourceIndex).at (targetIndex)
                        = scale;
                    voiceRouteCoreBiasVectors.at (sourceIndex).at (targetIndex)
                        = bias;
                }
                else
                {
                    voiceRouteGeneratorSourceUsed.at (sourceIndex) = true;
                    let generatorTargetIndex = targetIndex - modulationVoiceCoreLaneCount;
                    voiceRouteGeneratorScaleVectors.at (sourceIndex).at (generatorTargetIndex)
                        = scale;
                    voiceRouteGeneratorBiasVectors.at (sourceIndex).at (generatorTargetIndex)
                        = bias;
                }
            }

            for (int32 cellIndex = 0; cellIndex < modulationMacroVoiceRouteCellCount; ++cellIndex)
                macroVoiceRouteAmounts.at (cellIndex) = upload.macroVoiceRouteAmounts.at (cellIndex);

            for (int32 routeIndex = 0; routeIndex < upload.macroVoiceRouteCount; ++routeIndex)
            {
                let cellIndex = upload.macroVoiceRouteCells.at (routeIndex);
                let sourceIndex = upload.macroVoiceRouteSources.at (routeIndex);
                let targetIndex = upload.macroVoiceRouteTargets.at (routeIndex);
                let polarityKind = upload.macroVoiceRoutePolarities.at (routeIndex);
                let amount = upload.macroVoiceRouteAmounts.at (cellIndex);
                macroVoiceRouteCells.at (routeIndex) = cellIndex;
                macroVoiceRouteSources.at (routeIndex) = sourceIndex;
                macroVoiceRouteTargets.at (routeIndex) = targetIndex;
                macroVoiceRoutePolarities.at (routeIndex) = polarityKind;
                if (targetIndex < modulationVoiceCoreLaneCount)
                {
                    macroVoiceRouteCoreSourceUsed.at (sourceIndex) = true;
                    macroVoiceRouteCoreScaleVectors.at (sourceIndex).at (targetIndex)
                        = modulationRouteScale (amount, polarityKind);
                    macroVoiceRouteCoreBiasVectors.at (sourceIndex).at (targetIndex)
                        = modulationRouteBias (amount, polarityKind);
                }
                else
                {
                    macroVoiceRouteGeneratorSourceUsed.at (sourceIndex) = true;
                    let generatorTargetIndex = targetIndex - modulationVoiceCoreLaneCount;
                    macroVoiceRouteGeneratorScaleVectors.at (sourceIndex).at (generatorTargetIndex)
                        = modulationRouteScale (amount, polarityKind);
                    macroVoiceRouteGeneratorBiasVectors.at (sourceIndex).at (generatorTargetIndex)
                        = modulationRouteBias (amount, polarityKind);
                }
            }

            for (wrap<voiceCount> voice)
            {
                if (voiceUsesArticulation[voice])
                {
                    rebuildVoiceArticulationRouteTransforms (int32 (voice), upload.voiceRouteCount,
                                                              upload.macroVoiceRouteCount);
                }
            }

            // Reconcile only the old and new sparse prefixes. A topology edit must
            // not scan the complete rack-routing domain on the audio thread.
            for (int32 routeIndex = 0; routeIndex < voiceRackRouteCount; ++routeIndex)
                voiceRackCellNextActive.at (voiceRackRouteCells.at (routeIndex)) = false;

            for (int32 routeIndex = 0; routeIndex < upload.voiceRackRouteCount; ++routeIndex)
            {
                let cellIndex = upload.voiceRackRouteCells.at (routeIndex);
                let sourceIndex = upload.voiceRackRouteSources.at (routeIndex);
                voiceRackSourceUsed.at (sourceIndex) = true;
                voiceRackCellNextActive.at (cellIndex) = true;
            }

            for (int32 routeIndex = 0; routeIndex < voiceRackRouteCount; ++routeIndex)
            {
                let cellIndex = voiceRackRouteCells.at (routeIndex);
                if (! voiceRackCellNextActive.at (cellIndex))
                {
                    voiceRackCellHeldSources.at (cellIndex) = 0.0f;
                    voiceRackCellGates.at (cellIndex) = 0.0f;
                    voiceRackCellActive.at (cellIndex) = false;
                }
            }

            for (int32 routeIndex = 0; routeIndex < upload.voiceRackRouteCount; ++routeIndex)
            {
                let cellIndex = upload.voiceRackRouteCells.at (routeIndex);
                voiceRackRouteCells.at (routeIndex) = cellIndex;
                voiceRackRouteSources.at (routeIndex) = upload.voiceRackRouteSources.at (routeIndex);
                voiceRackRouteTargets.at (routeIndex) = upload.voiceRackRouteTargets.at (routeIndex);
                voiceRackRoutePolarities.at (routeIndex) = upload.voiceRackRoutePolarities.at (routeIndex);
                voiceRackRouteReducers.at (routeIndex) = upload.voiceRackRouteReducers.at (routeIndex);
                voiceRackRouteAmounts.at (cellIndex) = upload.voiceRackRouteAmounts.at (cellIndex);

                if (! voiceRackCellActive.at (cellIndex))
                {
                    voiceRackCellHeldSources.at (cellIndex) = 0.0f;
                    voiceRackCellGates.at (cellIndex) = 0.0f;
                }
                voiceRackCellActive.at (cellIndex) = true;
            }

            for (int32 routeIndex = 0; routeIndex < upload.macroRackRouteCount; ++routeIndex)
            {
                let cellIndex = upload.macroRackRouteCells.at (routeIndex);
                let sourceIndex = upload.macroRackRouteSources.at (routeIndex);
                let targetIndex = upload.macroRackRouteTargets.at (routeIndex);
                let polarityKind = upload.macroRackRoutePolarities.at (routeIndex);
                let amount = upload.macroRackRouteAmounts.at (cellIndex);
                macroRackRouteCells.at (routeIndex) = cellIndex;
                macroRackRouteSources.at (routeIndex) = sourceIndex;
                macroRackRouteTargets.at (routeIndex) = targetIndex;
                macroRackRoutePolarities.at (routeIndex) = polarityKind;
                macroRackRouteAmounts.at (cellIndex) = amount;
                macroRackRouteSourceUsed.at (sourceIndex) = true;
                let routeBlock = wrap<rackModBlockCount> (targetIndex / rackModStaticTargetCount);
                let routeLane = wrap<rackModStaticTargetCount> (targetIndex % rackModStaticTargetCount);
                macroRackRouteScaleVectors.at (sourceIndex, routeBlock).at (routeLane)
                    = modulationRouteScale (amount, polarityKind);
                macroRackRouteBiasVectors.at (sourceIndex, routeBlock).at (routeLane)
                    = modulationRouteBias (amount, polarityKind);
            }

            voiceRouteCount = upload.voiceRouteCount;
            macroVoiceRouteCount = upload.macroVoiceRouteCount;
            voiceRackRouteCount = upload.voiceRackRouteCount;
            macroRackRouteCount = upload.macroRackRouteCount;
            rebuildRackModulationLiveSet();
            acceptedModulationProgramSerial = upload.deliverySerial;
            completeModulationRuntimeInstall (upload.deliverySerial);
        }

        event modulationAmountIn (ModulationAmountUpload upload)
        {
            let installKind = beginModulationRuntimeInstall (upload.dspSessionId, upload.deliverySerial);
            if (installKind == 0)
                return;

            if (! isFiniteRuntimeValue (upload.amount))
            {
                rejectModulationProgram();
                rejectRuntimeInstall (upload.deliverySerial);
                return;
            }

            bool applied = false;
            if (upload.pathKind == modulationPathVoice
                && upload.cellIndex >= 0 && upload.cellIndex < modulationVoiceRouteCellCount)
            {
                for (int32 routeIndex = 0; routeIndex < voiceRouteCount; ++routeIndex)
                {
                    if (voiceRouteCells.at (routeIndex) == upload.cellIndex)
                    {
                        voiceRouteAmounts.at (upload.cellIndex) = upload.amount;
                        let scale = modulationRouteScale (upload.amount, voiceRoutePolarities.at (routeIndex));
                        let bias = modulationRouteBias (upload.amount, voiceRoutePolarities.at (routeIndex));
                        let sourceIndex = voiceRouteSources.at (routeIndex);
                        let targetIndex = voiceRouteTargets.at (routeIndex);
                        if (targetIndex < modulationVoiceCoreLaneCount)
                        {
                            voiceRouteCoreScaleVectors.at (sourceIndex).at (targetIndex)
                                = scale;
                            voiceRouteCoreBiasVectors.at (sourceIndex).at (targetIndex)
                                = bias;
                        }
                        else
                        {
                            let generatorTargetIndex = targetIndex - modulationVoiceCoreLaneCount;
                            voiceRouteGeneratorScaleVectors.at (sourceIndex).at (generatorTargetIndex)
                                = scale;
                            voiceRouteGeneratorBiasVectors.at (sourceIndex).at (generatorTargetIndex)
                                = bias;
                        }
                        applied = true;
                        break;
                    }
                }
            }
            else if (upload.pathKind == modulationPathMacroVoice
                && upload.cellIndex >= 0 && upload.cellIndex < modulationMacroVoiceRouteCellCount)
            {
                for (int32 routeIndex = 0; routeIndex < macroVoiceRouteCount; ++routeIndex)
                {
                    if (macroVoiceRouteCells.at (routeIndex) == upload.cellIndex)
                    {
                        macroVoiceRouteAmounts.at (upload.cellIndex) = upload.amount;
                        let sourceIndex = macroVoiceRouteSources.at (routeIndex);
                        let targetIndex = macroVoiceRouteTargets.at (routeIndex);
                        let polarityKind = macroVoiceRoutePolarities.at (routeIndex);
                        if (targetIndex < modulationVoiceCoreLaneCount)
                        {
                            macroVoiceRouteCoreScaleVectors.at (sourceIndex).at (targetIndex)
                                = modulationRouteScale (upload.amount, polarityKind);
                            macroVoiceRouteCoreBiasVectors.at (sourceIndex).at (targetIndex)
                                = modulationRouteBias (upload.amount, polarityKind);
                        }
                        else
                        {
                            let generatorTargetIndex = targetIndex - modulationVoiceCoreLaneCount;
                            macroVoiceRouteGeneratorScaleVectors.at (sourceIndex).at (generatorTargetIndex)
                                = modulationRouteScale (upload.amount, polarityKind);
                            macroVoiceRouteGeneratorBiasVectors.at (sourceIndex).at (generatorTargetIndex)
                                = modulationRouteBias (upload.amount, polarityKind);
                        }
                        applied = true;
                        break;
                    }
                }
            }
            else if (upload.pathKind == modulationPathVoiceRack
                && upload.cellIndex >= 0 && upload.cellIndex < modulationVoiceRackRouteCellCount)
            {
                for (int32 routeIndex = 0; routeIndex < voiceRackRouteCount; ++routeIndex)
                {
                    if (voiceRackRouteCells.at (routeIndex) == upload.cellIndex)
                    {
                        voiceRackRouteAmounts.at (upload.cellIndex) = upload.amount;
                        applied = true;
                        break;
                    }
                }
            }
            else if (upload.pathKind == modulationPathMacroRack
                && upload.cellIndex >= 0 && upload.cellIndex < modulationMacroRackRouteCellCount)
            {
                for (int32 routeIndex = 0; routeIndex < macroRackRouteCount; ++routeIndex)
                {
                    if (macroRackRouteCells.at (routeIndex) == upload.cellIndex)
                    {
                        macroRackRouteAmounts.at (upload.cellIndex) = upload.amount;
                        let sourceIndex = macroRackRouteSources.at (routeIndex);
                        let targetIndex = macroRackRouteTargets.at (routeIndex);
                        let polarityKind = macroRackRoutePolarities.at (routeIndex);
                        let routeBlock = wrap<rackModBlockCount> (targetIndex / rackModStaticTargetCount);
                        let routeLane = wrap<rackModStaticTargetCount> (targetIndex % rackModStaticTargetCount);
                        macroRackRouteScaleVectors.at (sourceIndex, routeBlock).at (routeLane)
                            = modulationRouteScale (upload.amount, polarityKind);
                        macroRackRouteBiasVectors.at (sourceIndex, routeBlock).at (routeLane)
                            = modulationRouteBias (upload.amount, polarityKind);
                        applied = true;
                        break;
                    }
                }
            }

            if (applied)
            {
                completeModulationRuntimeInstall (upload.deliverySerial);
            }
            else
            {
                rejectModulationProgram();
                rejectRuntimeInstall (upload.deliverySerial);
            }
        }

        event articulationSnapshotIn (ArticulationSnapshotUpload upload)
        {
            let installKind = beginArticulationRuntimeInstall (upload.dspSessionId, upload.deliverySerial);
            if (installKind == 0)
                return;

            if (upload.selectorA < 0 || upload.selectorA >= articulationSlotCount)
            {
                rejectRuntimeInstall (upload.deliverySerial);
                return;
            }

            if (! isValidArticulationSnapshot (upload))
            {
                rejectRuntimeInstall (upload.deliverySerial);
                return;
            }

            let selectorA = upload.selectorA;
            articulationSlotDefined.at (selectorA) = upload.enabled;

            if (! upload.enabled)
            {
                completeArticulationRuntimeInstall (upload.deliverySerial);
                return;
            }

            for (wrap<oscillatorCount> oscillator)
            {
                let index = articulationOscillatorIndex (selectorA, int32 (oscillator));
                articulationOscillatorOverrideMasks.at (index)
                    = upload.oscillatorOverrideMasks.at (oscillator);
                articulationFramePositions.at (index) = std::intrinsics::clamp (
                    upload.framePositions.at (oscillator), 0.0f, 1.0f);
                articulationPans.at (index) = clampPan (upload.pans.at (oscillator));
                articulationOctaves.at (index) = std::intrinsics::clamp (
                    upload.octaves.at (oscillator), -4.0f, 4.0f);
                articulationSemitones.at (index) = std::intrinsics::clamp (
                    upload.semitones.at (oscillator), -12.0f, 12.0f);
                articulationFineCents.at (index) = std::intrinsics::clamp (
                    upload.fineCents.at (oscillator), -100.0f, 100.0f);
                articulationPhases.at (index) = clampUnison01 (upload.phases.at (oscillator));
                articulationPhaseRandoms.at (index) = clampUnison01 (
                    upload.phaseRandoms.at (oscillator));
                articulationRetriggers.at (index) = upload.retriggers.at (oscillator) != 0;
                articulationVolumeDbs.at (index) = clampAmpGainDb (
                    upload.volumeDbs.at (oscillator));
                articulationMutes.at (index) = upload.mutes.at (oscillator) != 0;
                articulationSolos.at (index) = upload.solos.at (oscillator) != 0;
                articulationWarpModes.at (index) = resolveWarpMode (
                    float32 (upload.warpModes.at (oscillator)));
                articulationWarpAmounts.at (index) = std::intrinsics::clamp (
                    upload.warpAmounts.at (oscillator), 0.0f, 1.0f);
                articulationUnisonVoices.at (index) = resolveUnisonVoices (
                    float32 (upload.unisonVoices.at (oscillator)));
                articulationUnisonDetunes.at (index) = clampUnison01 (
                    upload.unisonDetunes.at (oscillator));
                articulationUnisonBlends.at (index) = clampUnison01 (
                    upload.unisonBlends.at (oscillator));
                articulationUnisonWidths.at (index) = clampUnison01 (
                    upload.unisonWidths.at (oscillator));
                articulationUnisonDetuneModes.at (index) = resolveUnisonDetuneMode (
                    float32 (upload.unisonDetuneModes.at (oscillator)));
                articulationUnisonStackModes.at (index) = resolveUnisonStackMode (
                    float32 (upload.unisonStackModes.at (oscillator)));
                articulationUnisonWavetablePositionSpreads.at (index) = clampUnison01 (
                    upload.unisonWavetablePositionSpreads.at (oscillator));
                articulationUnisonWarpSpreads.at (index) = clampUnison01 (
                    upload.unisonWarpSpreads.at (oscillator));
            }
            articulationSharedOverrideMasks.at (selectorA) = upload.sharedOverrideMask;
            articulationFilterMode.at (selectorA) = resolveFilterMode (float32 (upload.filterMode));
            articulationFilterCutoffHz.at (selectorA) = clampFilterCutoffHz (upload.filterCutoffHz, float32 (processor.frequency));
            articulationFilterKeyTrackOffsetSemitones.at (selectorA)
                = std::intrinsics::clamp (upload.filterKeyTrackOffsetSemitones, -60.0f, 60.0f);
            articulationFilterQ.at (selectorA) = clampFilterQ (upload.filterQ);

            for (int32 slotIndex = 0; slotIndex < modulationMsegSlotCount; ++slotIndex)
                articulationMsegMorphs.at (articulationMsegIndex (selectorA, slotIndex)) = std::intrinsics::clamp (upload.msegMorphs.at (slotIndex), 0.0f, 1.0f);

            for (int32 routeIndex = 0; routeIndex < modulationArticulationRouteCellCount; ++routeIndex)
                articulationRouteAmounts.at (articulationRouteIndex (selectorA, routeIndex)) = upload.routeAmounts.at (routeIndex);

            for (int32 slotIndex = 0; slotIndex < modulationEnvSlotCount; ++slotIndex)
            {
                articulationEnvelopeAttackSeconds.at (articulationEnvelopeIndex (selectorA, slotIndex)) = std::intrinsics::max (0.001f, upload.envelopeAttackSeconds.at (slotIndex));
                articulationEnvelopeDecaySeconds.at (articulationEnvelopeIndex (selectorA, slotIndex)) = std::intrinsics::max (0.001f, upload.envelopeDecaySeconds.at (slotIndex));
                articulationEnvelopeSustain.at (articulationEnvelopeIndex (selectorA, slotIndex)) = std::intrinsics::clamp (upload.envelopeSustain.at (slotIndex), 0.0f, 1.0f);
                articulationEnvelopeReleaseSeconds.at (articulationEnvelopeIndex (selectorA, slotIndex)) = std::intrinsics::max (0.001f, upload.envelopeReleaseSeconds.at (slotIndex));
            }
            completeArticulationRuntimeInstall (upload.deliverySerial);
        }

        event modulationMsegBufferIn (ModulationMsegBufferUpload upload)
        {
            let installKind = beginModulationRuntimeInstall (upload.dspSessionId, upload.deliverySerial);
            if (installKind == 0)
                return;
            if (upload.slot < 1 || upload.slot > modulationMsegSlotCount
                || upload.shapeIndex < 0 || upload.shapeIndex > 1)
            {
                rejectRuntimeInstall (upload.deliverySerial);
                return;
            }
            uploadMsegBufferToSlot (upload.slot, upload.shapeIndex, upload.buffer);
            completeModulationRuntimeInstall (upload.deliverySerial);
        }

        event modulationMsegPlaybackIn (ModulationMsegPlaybackUpload upload)
        {
            let installKind = beginModulationRuntimeInstall (upload.dspSessionId, upload.deliverySerial);
            if (installKind == 0)
                return;
            if (upload.slot < 1 || upload.slot > modulationMsegSlotCount)
            {
                rejectRuntimeInstall (upload.deliverySerial);
                return;
            }
            wt::MsegPlaybackConfig config;
            config.holdFinalValue = upload.holdFinalValue;
            config.rateKind = upload.rateKind;
            config.loopEnabled = upload.loopEnabled;
            config.loopStart = upload.loopStart;
            config.loopEnd = upload.loopEnd;
            config.noteOffPolicy = upload.noteOffPolicy;
            config.legatoRestarts = upload.legatoRestarts;
            uploadMsegPlaybackToSlot (upload.slot, config);
            completeModulationRuntimeInstall (upload.deliverySerial);
        }

        void clearBounceStagingIdentity()
        {
            bounceStagingSlot = -1;
            bounceStagingGeneration = 0;
            bounceStagingDeliverySerial = 0;
            bounceStagingReceivedFrameCount = 0;
        }

        void emitBounceBankRuntimeState()
        {
            BounceBankRuntimeState state;
            state.dspSessionId = currentDspSessionId;
            state.hasActive = bounceActiveSlot >= 0 ? 1 : 0;
            state.activeGeneration = bounceActiveSlot >= 0
                ? bounceSlotGenerations.at (bounceActiveSlot) : 0;
            state.activeRootCount = bounceActiveSlot >= 0
                ? bounceSlotRootCounts.at (bounceActiveSlot) : 0;
            state.activeFrameCount = bounceActiveSlot >= 0
                ? bounceSlotFrameCounts.at (bounceActiveSlot) : 0;
            state.hasStaging = bounceStagingSlot >= 0 ? 1 : 0;
            state.stagingGeneration = bounceStagingGeneration;
            state.stagingReceivedFrameCount = bounceStagingReceivedFrameCount;
            state.stagingExpectedFrameCount = bounceStagingSlot >= 0
                ? bounceSlotFrameCounts.at (bounceStagingSlot) : 0;
            state.rejectedDeliverySerial = bounceRejectedDeliverySerial;
            state.rejectionReason = bounceInstallRejectionReason;
            bounceBankRuntimeStateOut <- state;
        }

        void rejectBounceBankInstall (int32 deliverySerial,
                                      int32 rejectionReason,
                                      bool discardStaging)
        {
            bounceRejectedDeliverySerial = deliverySerial;
            bounceInstallRejectionReason = rejectionReason;
            if (discardStaging)
                clearBounceStagingIdentity();
            emitBounceBankRuntimeState();
        }

        bool isValidBounceBankBegin (BounceBankLoadBegin& request)
        {
            if (request.sampleRate <= 0
                || request.rootCount <= 0
                || request.rootCount > bounceBankRootCapacity
                || request.totalFrameCount <= 0
                || request.totalFrameCount > bounceBankFrameCapacity)
                return false;

            int32 expectedFrameOffset = 0;
            int32 previousRootNote = -1;
            for (int32 rootIndex = 0; rootIndex < request.rootCount; ++rootIndex)
            {
                let rootNote = request.rootNotes.at (rootIndex);
                let frameOffset = request.rootFrameOffsets.at (rootIndex);
                let frameCount = request.rootFrameCounts.at (rootIndex);
                let noteOffFrameOffset = request.rootNoteOffFrameOffsets.at (rootIndex);
                if (rootNote < 0 || rootNote > 127
                    || rootNote <= previousRootNote
                    || frameOffset != expectedFrameOffset
                    || frameCount <= 0
                    || noteOffFrameOffset < 0
                    || noteOffFrameOffset >= frameCount
                    || frameOffset + frameCount > request.totalFrameCount)
                    return false;

                previousRootNote = rootNote;
                expectedFrameOffset += frameCount;
            }

            return expectedFrameOffset == request.totalFrameCount;
        }

        void beginBounceBankLoad (BounceBankLoadBegin& request)
        {
            if (request.dspSessionId != currentDspSessionId)
            {
                rejectBounceBankInstall (
                    request.deliverySerial, bounceInstallRejectionSession, false);
                return;
            }

            if (request.generation <= 0
                || request.generation <= bounceGenerationFrontier
                || request.deliverySerial <= 0
                || ! isValidBounceBankBegin (request))
            {
                rejectBounceBankInstall (
                    request.deliverySerial, bounceInstallRejectionInvalid, false);
                return;
            }

            let nextSlot = bounceActiveSlot == 0 ? 1 : 0;
            if (bounceSlotIsInUse (nextSlot))
            {
                rejectBounceBankInstall (
                    request.deliverySerial, bounceInstallRejectionBusy, false);
                return;
            }

            bounceGenerationFrontier = request.generation;
            bounceStagingSlot = nextSlot;
            bounceStagingGeneration = request.generation;
            bounceStagingDeliverySerial = request.deliverySerial;
            bounceStagingReceivedFrameCount = 0;
            bounceSlotSampleRates.at (nextSlot) = request.sampleRate;
            bounceSlotRootCounts.at (nextSlot) = request.rootCount;
            bounceSlotFrameCounts.at (nextSlot) = request.totalFrameCount;

            for (int32 rootIndex = 0; rootIndex < bounceBankRootCapacity; ++rootIndex)
            {
                let metadataIndex = bounceRootMetadataIndex (nextSlot, rootIndex);
                bounceSlotRootNotes.at (metadataIndex) = rootIndex < request.rootCount
                    ? request.rootNotes.at (rootIndex) : 0;
                bounceSlotRootFrameOffsets.at (metadataIndex) = rootIndex < request.rootCount
                    ? request.rootFrameOffsets.at (rootIndex) : 0;
                bounceSlotRootFrameCounts.at (metadataIndex) = rootIndex < request.rootCount
                    ? request.rootFrameCounts.at (rootIndex) : 0;
                bounceSlotRootNoteOffFrameOffsets.at (metadataIndex) = rootIndex < request.rootCount
                    ? request.rootNoteOffFrameOffsets.at (rootIndex) : 0;
            }

            bounceRejectedDeliverySerial = 0;
            bounceInstallRejectionReason = bounceInstallRejectionNone;
            emitBounceBankRuntimeState();
        }

        void receiveBounceBankFrameBatch (BounceBankFrameBatch& batch)
        {
            if (batch.dspSessionId != currentDspSessionId)
            {
                rejectBounceBankInstall (
                    batch.deliverySerial, bounceInstallRejectionSession, false);
                return;
            }

            if (bounceStagingSlot < 0
                || batch.generation != bounceStagingGeneration)
            {
                rejectBounceBankInstall (
                    batch.deliverySerial, bounceInstallRejectionInvalid, false);
                return;
            }

            let expectedFrameCount = bounceSlotFrameCounts.at (bounceStagingSlot);
            if (batch.deliverySerial != bounceStagingDeliverySerial + 1
                || batch.frameIndexBase != bounceStagingReceivedFrameCount)
            {
                rejectBounceBankInstall (
                    batch.deliverySerial, bounceInstallRejectionGap, true);
                return;
            }

            if (batch.frameCount <= 0
                || batch.frameCount > bounceBankFrameBatchCapacity
                || batch.frameIndexBase + batch.frameCount > expectedFrameCount)
            {
                rejectBounceBankInstall (
                    batch.deliverySerial, bounceInstallRejectionInvalid, true);
                return;
            }

            for (int32 batchIndex = 0; batchIndex < batch.frameCount; ++batchIndex)
                writeBouncePackedFrame (
                    bounceStagingSlot,
                    batch.frameIndexBase + batchIndex,
                    batch.packedFrames.at (batchIndex));

            bounceStagingDeliverySerial = batch.deliverySerial;
            bounceStagingReceivedFrameCount += batch.frameCount;
            BounceBankUploadAck ack;
            ack.dspSessionId = currentDspSessionId;
            ack.generation = bounceStagingGeneration;
            ack.deliverySerial = batch.deliverySerial;
            ack.frameIndexBase = batch.frameIndexBase;
            ack.frameCount = batch.frameCount;
            ack.receivedFrameCount = bounceStagingReceivedFrameCount;
            bounceBankUploadAckOut <- ack;
        }

        void commitBounceBankLoad (BounceBankCommit& request)
        {
            if (request.dspSessionId != currentDspSessionId)
            {
                rejectBounceBankInstall (
                    request.deliverySerial, bounceInstallRejectionSession, false);
                return;
            }

            if (bounceStagingSlot < 0
                || request.generation != bounceStagingGeneration
                || request.deliverySerial != bounceStagingDeliverySerial + 1
                || bounceStagingReceivedFrameCount
                    != bounceSlotFrameCounts.at (bounceStagingSlot))
            {
                rejectBounceBankInstall (
                    request.deliverySerial, bounceInstallRejectionInvalid,
                    request.generation == bounceStagingGeneration);
                return;
            }

            let committedSlot = bounceStagingSlot;
            bounceSlotGenerations.at (committedSlot) = bounceStagingGeneration;
            bounceActiveSlot = committedSlot;
            clearBounceStagingIdentity();
            bounceRejectedDeliverySerial = 0;
            bounceInstallRejectionReason = bounceInstallRejectionNone;
            emitBounceBankRuntimeState();
        }

        void abortBounceBankLoad (BounceBankAbort& request)
        {
            if (request.dspSessionId != currentDspSessionId
                || request.generation != bounceStagingGeneration)
                return;

            clearBounceStagingIdentity();
            bounceRejectedDeliverySerial = request.deliverySerial;
            bounceInstallRejectionReason = request.failureReasonCode > 0
                ? request.failureReasonCode : bounceInstallRejectionInvalid;
            emitBounceBankRuntimeState();
        }

        event bounceBankLoadBeginIn (BounceBankLoadBegin request)
        {
            beginBounceBankLoad (request);
        }

        event bounceBankFrameBatchIn (BounceBankFrameBatch batch)
        {
            receiveBounceBankFrameBatch (batch);
        }

        event bounceBankCommitIn (BounceBankCommit request)
        {
            commitBounceBankLoad (request);
        }

        event bounceBankAbortIn (BounceBankAbort request)
        {
            abortBounceBankLoad (request);
        }

        void beginWavetableLoad (int32 dspSessionId,
                                 int32 oscillatorIndex,
                                 int32 requestedGeneration,
                                 int32 requestedTableIndex,
                                 int32 requestedFrameCount)
        {
            let resolvedFrameCount = resolveUploadedFrameCount (requestedFrameCount);
            let oscillator = oscillatorIndex;

            if (dspSessionId != currentDspSessionId
                || oscillator < 0 || oscillator >= oscillatorCount
                || requestedGeneration <= 0
                || requestedGeneration < oscillatorGenerationFrontier.at (oscillator)
                || requestedTableIndex < 0
                || resolvedFrameCount == 0
                || resolvedFrameCount > wavetableFrameCapacity)
                return;

            let nextStagingSlot = findSparePackedSlot();

            if (nextStagingSlot < 0)
                return;

            let previousStagingOscillator = tableStagingOscillatorIndex;

            oscillatorGenerationFrontier.at (oscillator) = std::intrinsics::max (
                oscillatorGenerationFrontier.at (oscillator), requestedGeneration);
            tableStagingOscillatorIndex = oscillator;
            tableStagingSlotIndex = nextStagingSlot;
            tableStagingGeneration = requestedGeneration;
            tableStagingTableIndex = requestedTableIndex;
            tableStagingFrameCount = resolvedFrameCount;
            tableStagingLastFrameIndex = resolvedFrameCount - 1;
            tableStagingLastFrameIndexF = float32 (tableStagingLastFrameIndex);
            clearPackedSlotState (nextStagingSlot);
            clearOscillatorMipRequestState (oscillator);

            if (previousStagingOscillator >= 0 && previousStagingOscillator != oscillator)
                emitRuntimeServiceState (previousStagingOscillator);

            emitRuntimeServiceState (oscillator);
        }

        void receiveWavetableMipBatch (int32 dspSessionId,
                                       int32 oscillatorIndex,
                                       int32 uploadedGeneration,
                                       int32 uploadedTableIndex,
                                       int32 uploadedMipIndex,
                                       int32 uploadedFrameIndexBase,
                                       int32 uploadedFrameCount,
                                       const float32[] samples)
        {
            let resolvedMipIndex = resolveMipIndex (uploadedMipIndex);

            if (resolvedMipIndex < 0 || tableStagingFrameCount <= 0)
                return;

            if (dspSessionId != currentDspSessionId
                || oscillatorIndex != tableStagingOscillatorIndex
                || uploadedGeneration != tableStagingGeneration
                || uploadedTableIndex != tableStagingTableIndex)
                return;

            if (uploadedFrameIndexBase < 0
                || uploadedFrameCount <= 0
                || uploadedFrameCount > wavetableMipFrameBatchSize
                || uploadedFrameIndexBase + uploadedFrameCount > tableStagingFrameCount
                || ! hasValidWavetableBatchSamples (samples, uploadedFrameCount))
                return;

            for (int32 batchFrameIndex = 0; batchFrameIndex < uploadedFrameCount; ++batchFrameIndex)
            {
                let uploadedFrameIndex = uploadedFrameIndexBase + batchFrameIndex;
                let readyIndex = packedReadinessIndex (
                    tableStagingSlotIndex, resolvedMipIndex, uploadedFrameIndex);

                if (packedReadyFrameFlags.at (readyIndex) == 0)
                {
                    writePackedMipFrame (
                        tableStagingSlotIndex,
                        resolvedMipIndex,
                        uploadedFrameIndex,
                        batchFrameIndex * samplesPerFrame,
                        samples);
                    packedReadyFrameFlags.at (readyIndex) = 1;
                    packedLoadedFrameCounts.at (packedSlotMipIndex (
                        tableStagingSlotIndex, resolvedMipIndex)) += 1;
                }
            }

            emitUploadAck (
                oscillatorIndex,
                uploadedGeneration,
                uploadedTableIndex,
                resolvedMipIndex,
                uploadedFrameIndexBase,
                uploadedFrameCount
            );

            if (isPackedStagingComplete())
                commitPackedStagingTable();
        }

        void abortWavetableLoad (int32 dspSessionId,
                                 int32 oscillatorIndex,
                                 int32 abortedGeneration,
                                 int32 abortedTableIndex)
        {
            if (dspSessionId != currentDspSessionId
                || oscillatorIndex != tableStagingOscillatorIndex
                || abortedGeneration != tableStagingGeneration
                || abortedTableIndex != tableStagingTableIndex)
                return;

            let abortedOscillator = tableStagingOscillatorIndex;

            clearTableStagingIdentity();
            emitRuntimeServiceState (abortedOscillator);
        }

        event oscillatorWavetableLoadBeginIn (OscillatorWavetableLoadBegin request)
        {
            beginWavetableLoad (request.dspSessionId, request.oscillatorIndex,
                                request.generation, request.tableIndex, request.frameCount);
        }

        event oscillatorWavetableMipFrameIn (OscillatorWavetableMipFrame frame)
        {
            receiveWavetableMipBatch (frame.dspSessionId, frame.oscillatorIndex,
                                      frame.generation, frame.tableIndex, frame.mipIndex,
                                      frame.frameIndexBase, frame.frameCount, frame.samples);
        }

        event oscillatorServiceLoadAbortIn (OscillatorServiceLoadAbort abort)
        {
            abortWavetableLoad (abort.dspSessionId, abort.oscillatorIndex,
                                abort.generation, abort.tableIndex);
        }

        void main()
        {
            previewFrequencyHzState = previewFrequencyHzState < 0.0f ? 0.0f : previewFrequencyHzState;
            glideTimeSecondsState = std::intrinsics::max (0.0f, glideTimeIn);
            sourceModeState = sourceModeIn >= 0.5f ? sourceModeBounce : sourceModeOscillator;
            pendingSourceModeState = sourceModeState;
            sourceModeFadeDirection = 0;
            sourceModeFadeGain = 1.0f;
            updateOscillatorInputState();

            for (wrap<oscillatorCount> oscillator)
                clearOscillatorMipRequestState (int32 (oscillator));

            let requestedInterval = int32 (
                std::intrinsics::floor ((processor.frequency / wt::effectiveWavetablePositionMonitorHz) + 0.5f)
            );
            monitorUpdateIntervalFrames = std::intrinsics::max (1, requestedInterval);
            framesUntilNextMonitorUpdate = 0;
            let requestedWarpInterval = int32 (
                std::intrinsics::floor ((processor.frequency / wt::effectiveWarpStateMonitorHz) + 0.5f)
            );
            warpMonitorUpdateIntervalFrames = std::intrinsics::max (1, requestedWarpInterval);
            framesUntilNextWarpMonitorUpdate = 0;
            let requestedUnisonInterval = int32 (
                std::intrinsics::floor ((processor.frequency / wt::effectiveUnisonStateMonitorHz) + 0.5f)
            );
            unisonMonitorUpdateIntervalFrames = std::intrinsics::max (1, requestedUnisonInterval);
            framesUntilNextUnisonMonitorUpdate = 0;
            let requestedFilterInterval = int32 (
                std::intrinsics::floor ((processor.frequency / wt::effectiveFilterStateMonitorHz) + 0.5f)
            );
            filterMonitorUpdateIntervalFrames = std::intrinsics::max (1, requestedFilterInterval);
            framesUntilNextFilterMonitorUpdate = 0;
            let requestedMsegInterval = int32 (
                std::intrinsics::floor ((processor.frequency / wt::effectiveMsegStateMonitorHz) + 0.5f)
            );
            msegMonitorUpdateIntervalFrames = std::intrinsics::max (1, requestedMsegInterval);
            framesUntilNextMsegMonitorUpdate = 0;
            let requestedModSourceInterval = int32 (
                std::intrinsics::floor ((processor.frequency / wt::effectiveModSourceStateMonitorHz) + 0.5f)
            );
            modSourceMonitorUpdateIntervalFrames = std::intrinsics::max (1, requestedModSourceInterval);
            framesUntilNextModSourceMonitorUpdate = 0;
            rackModGateReleaseStepState = rackModGateReleaseStep (float32 (processor.frequency));
            rackModSmoothingCoefficientState = rackModOnePoleCoefficient (
                rackModSmoothingMs, float32 (processor.frequency));
            keyTrackSmoothingCoefficientState = keyTrackOnePoleCoefficient (
                float32 (processor.frequency));
            for (wrap<voiceCount> voice)
                voiceEnhancers[voice].prepare (float32 (processor.frequency));
            voiceEnhancerResidueDcBlocker.prepare (float32 (processor.frequency));
            resetAllFilterState();

            for (int32 slotIndex = 0; slotIndex < modulationEnvSlotCount; ++slotIndex)
            {
                currentEnvelopeAttackSeconds.at (slotIndex) = 0.01f;
                currentEnvelopeDecaySeconds.at (slotIndex) = 0.25f;
                currentEnvelopeSustain.at (slotIndex) = 0.5f;
                currentEnvelopeReleaseSeconds.at (slotIndex) = 0.2f;
            }

            for (wrap<voiceCount> voice)
            {
                clearVoiceArticulation (int32 (voice));
                resetVoiceGeneratorModulationTargets (int32 (voice));
                stopBounceSampleForVoice (int32 (voice));

                // Run every modulator's main() prologue (the MSEG readers
                // fill their default buffers there) exactly once, before any
                // event can read that state. The audio loop freezes these
                // nodes while their voice is quiescent, and a frozen node's
                // rest state is stationary, so this single advance leaves
                // each node exactly where an always-advanced node would rest.
                mseg1[voice].advance();
                mseg2[voice].advance();
                mseg3[voice].advance();
                modEnv1[voice].advance();
                modEnv2[voice].advance();
                modEnv3[voice].advance();
                ampEnvelopes[voice].advance();
            }

            initialiseExternalRendererState();

            loop
            {
                glideTimeSecondsState = std::intrinsics::max (0.0f, glideTimeIn);
                currentAmpAttackSeconds = ampAttackIn > 0.0f
                    ? std::intrinsics::clamp (ampAttackIn, 0.001f, 10.0f)
                    : 0.01f;
                currentAmpDecaySeconds = ampDecayIn > 0.0f
                    ? std::intrinsics::clamp (ampDecayIn, 0.001f, 10.0f)
                    : 0.001f;
                currentAmpSustain = std::intrinsics::clamp (ampSustainIn, 0.0f, 1.0f);
                currentAmpReleaseSeconds = ampReleaseIn > 0.0f
                    ? std::intrinsics::clamp (ampReleaseIn, 0.005f, 10.0f)
                    : 0.2f;
                requestSourceModeTransition (
                    sourceModeIn >= 0.5f ? sourceModeBounce : sourceModeOscillator);
                let sourceModeGain = advanceSourceModeTransition();
                updateOscillatorInputState();
                let isBounceSource = resolveSourceMode() == sourceModeBounce;

                if (! hasEmittedInitialRuntimeState)
                {
                    for (wrap<oscillatorCount> oscillator)
                        emitRuntimeServiceState (int32 (oscillator));

                    emitBounceBankRuntimeState();
                    hasEmittedInitialRuntimeState = true;
                }

                float32 leftMix = 0.0f;
                float32 rightMix = 0.0f;
                float32 enhancerResidueLeftMix = 0.0f;
                float32 enhancerResidueRightMix = 0.0f;
                bool hasEnhancerResidue = false;
                float32 trackingPitchHz = trackingPitchHzState;
                int32 trackingSerial = -1;

                beginModulationFrame();

                for (wrap<voiceCount> voice)
                {
                    let voiceIndex = int32 (voice);

                    // A voice that was not sounding after its previous frame
                    // is frozen whole: no pitch glide, no modulator input
                    // writes, no node advances. Every frozen node re-emits
                    // its rest value, nothing downstream reads the voice
                    // (see voiceWasSounding), and a note-on resets all of it,
                    // so the skip is bit-identical to advancing. The
                    // pre-advance view of the amp gain equals the
                    // post-advance view here because an idle amp envelope is
                    // stationary at exactly zero.
                    if (voiceActive.at (voice) == 0 && ampEnvelopes[voice].gainOut <= 0.0f)
                    {
                        if (voiceWasSounding[voice])
                        {
                            voiceWasSounding[voice] = false;
                            resetVoiceGeneratorModulationTargets (voiceIndex);
                            clearExternalRendererVoiceControls (voiceIndex);
                        }

                        continue;
                    }

                    advanceVoicePitchState (voiceIndex);
                    let msegIndex0 = voiceArticulationMsegIndex (voiceIndex, 0);
                    let msegIndex1 = voiceArticulationMsegIndex (voiceIndex, 1);
                    let msegIndex2 = voiceArticulationMsegIndex (voiceIndex, 2);
                    mseg1[voice].durationSecondsIn <- voiceEffectiveMsegRates.at (msegIndex0);
                    mseg2[voice].durationSecondsIn <- voiceEffectiveMsegRates.at (msegIndex1);
                    mseg3[voice].durationSecondsIn <- voiceEffectiveMsegRates.at (msegIndex2);

                    let envIndex0 = voiceArticulationEnvelopeIndex (voiceIndex, 0);
                    let envIndex1 = voiceArticulationEnvelopeIndex (voiceIndex, 1);
                    let envIndex2 = voiceArticulationEnvelopeIndex (voiceIndex, 2);
                    modEnv1[voice].attackSecondsIn <- voiceEffectiveEnvelopeAttackSeconds.at (envIndex0);
                    modEnv1[voice].decaySecondsIn <- voiceEffectiveEnvelopeDecaySeconds.at (envIndex0);
                    modEnv1[voice].sustainIn <- voiceEffectiveEnvelopeSustain.at (envIndex0);
                    modEnv1[voice].releaseSecondsIn <- voiceEffectiveEnvelopeReleaseSeconds.at (envIndex0);
                    modEnv2[voice].attackSecondsIn <- voiceEffectiveEnvelopeAttackSeconds.at (envIndex1);
                    modEnv2[voice].decaySecondsIn <- voiceEffectiveEnvelopeDecaySeconds.at (envIndex1);
                    modEnv2[voice].sustainIn <- voiceEffectiveEnvelopeSustain.at (envIndex1);
                    modEnv2[voice].releaseSecondsIn <- voiceEffectiveEnvelopeReleaseSeconds.at (envIndex1);
                    modEnv3[voice].attackSecondsIn <- voiceEffectiveEnvelopeAttackSeconds.at (envIndex2);
                    modEnv3[voice].decaySecondsIn <- voiceEffectiveEnvelopeDecaySeconds.at (envIndex2);
                    modEnv3[voice].sustainIn <- voiceEffectiveEnvelopeSustain.at (envIndex2);
                    modEnv3[voice].releaseSecondsIn <- voiceEffectiveEnvelopeReleaseSeconds.at (envIndex2);
                    ampEnvelopes[voice].attackSecondsIn
                        <- voiceEffectiveAmpAttackSeconds.at (voice);
                    ampEnvelopes[voice].decaySecondsIn
                        <- voiceEffectiveAmpDecaySeconds.at (voice);
                    ampEnvelopes[voice].sustainIn
                        <- voiceEffectiveAmpSustain.at (voice);
                    ampEnvelopes[voice].releaseSecondsIn
                        <- voiceEffectiveAmpReleaseSeconds.at (voice);
                    mseg1[voice].advance();
                    mseg2[voice].advance();
                    mseg3[voice].advance();
                    modEnv1[voice].advance();
                    modEnv2[voice].advance();
                    modEnv3[voice].advance();
                    ampEnvelopes[voice].advance();
                    voiceMsegProgress1[voice] = mseg1[voice].progressOut;
                    voiceMsegProgress2[voice] = mseg2[voice].progressOut;
                    voiceMsegProgress3[voice] = mseg3[voice].progressOut;

                    if (! voiceIsSoundingForRackModulation (voiceIndex))
                    {
                        // The retiring frame: this advance brought the amp
                        // envelope to exactly zero. Tear the voice down once;
                        // the frozen path above owns it from the next frame.
                        voiceWasSounding[voice] = false;
                        resetVoiceGeneratorModulationTargets (voiceIndex);
                        clearExternalRendererVoiceControls (voiceIndex);
                        continue;
                    }

                    voiceWasSounding[voice] = true;
                    accumulateVoiceModulationTargets (voiceIndex);
                    // Generator destinations consume the prior frame's source
                    // values. This one-frame causal delay makes self/cross
                    // modulation deterministic without an algebraic cycle.
                    updateVoiceGeneratorModulationTargets (voiceIndex);
                    accumulateVoiceRackSources (voiceIndex);

                    let sharedPlayedPitchSemitones = resolveSharedPlayedPitchSemitones (voiceIndex);
                    let voiceSerial = voiceTrackingSerial.at (voice);
                    if (voiceActive.at (voice) != 0 && voiceSerial > trackingSerial)
                    {
                        trackingSerial = voiceSerial;
                        trackingPitchHz = std::notes::noteToFrequency (sharedPlayedPitchSemitones);
                    }

                    let processorFrequency = float32 (processor.frequency);
                    let routeFilterCutoffOctaves = voiceTargetOffset (
                        voiceIndex, modulationTargetFilterCutoffOctaves);
                    let routeFilterQ = voiceTargetOffset (
                        voiceIndex, modulationTargetFilterQ);
                    let routeFilterMix = voiceTargetOffset (
                        voiceIndex, modulationTargetFilterMix);
                    let baseFilterMode = voiceUsesArticulation.at (voice)
                        ? voiceArticulationFilterMode.at (voice)
                        : resolveFilterMode (filterModeIn);
                    let baseFilterCutoffHz = voiceUsesArticulation.at (voice)
                        ? voiceArticulationFilterCutoffHz.at (voice)
                        : clampFilterCutoffHz (filterCutoffIn, processorFrequency);
                    let baseFilterKeyTrackOffsetSemitones = voiceUsesArticulation.at (voice)
                        ? voiceArticulationFilterKeyTrackOffsetSemitones.at (voice)
                        : std::intrinsics::clamp (
                            filterCutoffKeyTrackOffsetSemitonesIn, -60.0f, 60.0f);
                    let baseFilterQ = voiceUsesArticulation.at (voice)
                        ? voiceArticulationFilterQ.at (voice)
                        : filterQIn;
                    let filterKeyTrackEnabled = filterCutoffKeyTrackEnabledIn >= 0.5f;
                    let targetFilterCutoffHz = resolveVoiceFilterKeyTrackedFrequencyHz (
                        filterKeyTrackEnabled ? 1.0f : 0.0f,
                        baseFilterCutoffHz,
                        std::notes::noteToFrequency (sharedPlayedPitchSemitones),
                        baseFilterKeyTrackOffsetSemitones,
                        routeFilterCutoffOctaves,
                        filterCutoffMinHz,
                        std::intrinsics::min (filterCutoffMaxHz, processorFrequency * 0.48f));
                    let effectiveFilterCutoffHz = filterKeyTrackEnabled
                        ? advanceKeyTrackSmoothedValue (
                            voiceFilterKeyTrackSmoothedHz.at (voice),
                            targetFilterCutoffHz,
                            keyTrackSmoothingCoefficientState)
                        : targetFilterCutoffHz;
                    voiceFilterKeyTrackSmoothedHz.at (voice) = effectiveFilterCutoffHz;
                    let effectiveFilterQ = clampFilterQ (baseFilterQ + routeFilterQ);
                    let effectiveFilterMix = resolveVoiceFilterMix (filterMixIn, routeFilterMix);
                    let hasSoloedOscillator = voiceHasSoloedOscillator (voiceIndex);

                    voiceEffectiveFilterMode.at (voice) = baseFilterMode;
                    voiceEffectiveFilterCutoffHz.at (voice) = effectiveFilterCutoffHz;
                    voiceEffectiveFilterQ.at (voice) = effectiveFilterQ;
                    voiceEffectiveFilterMix.at (voice) = effectiveFilterMix;
                    let routeVoiceEnhancerFrequencyOctaves = voiceTargetOffset (
                        voiceIndex,
                        modulationTargetVoiceEnhancerFrequencyOctaves);
                    voiceEffectiveEnhancerFrequencyHz.at (voice)
                        = resolveVoiceEnhancerFrequencyHz (
                            voiceEnhancerKeyTrackEnabledIn,
                            voiceEnhancerFrequencyIn,
                            std::notes::noteToFrequency (sharedPlayedPitchSemitones),
                            voiceEnhancerKeyTrackOffsetSemitonesIn,
                            routeVoiceEnhancerFrequencyOctaves,
                            processorFrequency);
                    voiceEffectiveEnhancerQ.at (voice) = clampVoiceEnhancerQ (
                        voiceEnhancerQIn + voiceTargetOffset (
                            voiceIndex, modulationTargetVoiceEnhancerQ));
                    voiceEffectiveEnhancerAmount.at (voice)
                        = clampVoiceEnhancerAmount (
                            voiceEnhancerAmountIn + voiceTargetOffset (
                                voiceIndex, modulationTargetVoiceEnhancerAmount));

                    for (wrap<oscillatorCount> oscillatorWrapped)
                    {
                        let oscillator = int32 (oscillatorWrapped);
                        let effectivePosition = std::intrinsics::clamp (
                            voiceOscillatorFramePosition (voiceIndex, oscillator)
                                + voiceOscillatorModulationOffset (
                                    voiceIndex, oscillator, modulationTargetWavetablePosition),
                            0.0f,
                            1.0f);
                        let effectiveWarpAmount = std::intrinsics::clamp (
                            voiceOscillatorWarpAmount (voiceIndex, oscillator)
                                + voiceOscillatorModulationOffset (
                                    voiceIndex, oscillator, modulationTargetWarpAmount),
                            0.0f,
                            1.0f);
                        let effectivePitchSemitones = sharedPlayedPitchSemitones
                            + voiceOscillatorTuningSemitones (voiceIndex, oscillator)
                            + voiceOscillatorModulationOffset (
                                voiceIndex, oscillator, modulationTargetPitchSemitones);
                        let effectiveGain = voiceOscillatorIsAudible (
                            voiceIndex, oscillator, hasSoloedOscillator)
                            ? dbToGain (clampAmpGainDb (
                                voiceOscillatorVolumeDb (voiceIndex, oscillator)
                                    + voiceOscillatorModulationOffset (
                                        voiceIndex, oscillator, modulationTargetAmpGainDb)))
                            : 0.0f;
                        let effectivePan = clampPan (
                            voiceOscillatorPan (voiceIndex, oscillator)
                                + voiceOscillatorModulationOffset (
                                    voiceIndex, oscillator, modulationTargetPan));
                        let effectiveUnisonVoices = voiceOscillatorUnisonVoices (
                            voiceIndex, oscillator);
                        let effectiveUnisonDetune = clampUnison01 (
                            voiceOscillatorUnisonDetune (voiceIndex, oscillator)
                                + voiceOscillatorModulationOffset (
                                    voiceIndex, oscillator, modulationTargetUnisonDetune));
                        let effectiveUnisonBlend = clampUnison01 (
                            voiceOscillatorUnisonBlend (voiceIndex, oscillator)
                                + voiceOscillatorModulationOffset (
                                    voiceIndex, oscillator, modulationTargetUnisonBlend));
                        let effectiveUnisonWidth = clampUnison01 (
                            voiceOscillatorUnisonWidth (voiceIndex, oscillator)
                                + voiceOscillatorModulationOffset (
                                    voiceIndex, oscillator, modulationTargetUnisonWidth));
                        let effectivePositionSpread = clampUnison01 (
                            voiceOscillatorPositionSpread (voiceIndex, oscillator)
                                + voiceOscillatorModulationOffset (
                                    voiceIndex, oscillator,
                                    modulationTargetUnisonWavetablePositionSpread));
                        let effectiveWarpSpread = clampUnison01 (
                            voiceOscillatorWarpSpread (voiceIndex, oscillator)
                                + voiceOscillatorModulationOffset (
                                    voiceIndex, oscillator, modulationTargetUnisonWarpSpread));

                        if (! isBounceSource)
                        {
                            prepareExternalRendererOscillator (
                                voiceIndex,
                                oscillator,
                                effectivePosition,
                                voiceOscillatorWarpMode (voiceIndex, oscillator),
                                effectiveWarpAmount,
                                effectivePitchSemitones,
                                effectivePan,
                                effectiveGain,
                                effectiveUnisonVoices,
                                effectiveUnisonDetune,
                                effectiveUnisonBlend,
                                effectiveUnisonWidth,
                                voiceOscillatorUnisonDetuneMode (voiceIndex, oscillator),
                                voiceOscillatorUnisonStackMode (voiceIndex, oscillator),
                                effectivePositionSpread,
                                effectiveWarpSpread
                            );
                        }

                        if (oscillator == oscillatorA)
                        {
                            voiceEffectivePosition.at (voice) = effectivePosition;
                            voiceEffectiveWarpMode.at (voice)
                                = voiceOscillatorWarpMode (voiceIndex, oscillator);
                            voiceEffectiveWarpAmount.at (voice) = effectiveWarpAmount;
                            voiceEffectivePan.at (voice) = effectivePan;
                            voiceEffectiveUnisonVoices.at (voice) = effectiveUnisonVoices;
                            voiceEffectiveUnisonDetune.at (voice) = effectiveUnisonDetune;
                            voiceEffectiveUnisonBlend.at (voice) = effectiveUnisonBlend;
                            voiceEffectiveUnisonWidth.at (voice) = effectiveUnisonWidth;
                            voiceEffectiveUnisonDetuneMode.at (voice)
                                = voiceOscillatorUnisonDetuneMode (voiceIndex, oscillator);
                            voiceEffectiveUnisonStackMode.at (voice)
                                = voiceOscillatorUnisonStackMode (voiceIndex, oscillator);
                            voiceEffectiveUnisonWavetablePositionSpread.at (voice)
                                = effectivePositionSpread;
                            voiceEffectiveUnisonWarpSpread.at (voice) = effectiveWarpSpread;

                        }
                    }
                }

                int32 rendererSucceeded = 0;
                if (! isBounceSource)
                {
                    rendererSucceeded = CosimoThreeOscillatorRenderer::renderAll (
                        rendererFloats,
                        rendererInts,
                        packedSlot0Chunk0, packedSlot0Chunk1,
                        packedSlot0Chunk2, packedSlot0Chunk3,
                        packedSlot1Chunk0, packedSlot1Chunk1,
                        packedSlot1Chunk2, packedSlot1Chunk3,
                        packedSlot2Chunk0, packedSlot2Chunk1,
                        packedSlot2Chunk2, packedSlot2Chunk3,
                        packedSlot3Chunk0, packedSlot3Chunk1,
                        packedSlot3Chunk2, packedSlot3Chunk3
                    );
                }

                for (wrap<voiceCount> voice)
                {
                    if (! voiceIsSoundingForRackModulation (int32 (voice)))
                        continue;

                    float32 noteLeft = 0.0f;
                    float32 noteRight = 0.0f;

                    if (isBounceSource)
                    {
                        let bounceSample = readBounceSampleForVoice (int32 (voice));
                        noteLeft = bounceSample[0];
                        noteRight = bounceSample[1];
                    }
                    else if (rendererSucceeded != 0)
                    {
                        let outputIndex = rendererNoteOutputOffset + (int32 (voice) * 2);
                        noteLeft = rendererFloats.at (outputIndex);
                        noteRight = rendererFloats.at (outputIndex + 1);
                    }

                    let effectiveFilterMode = voiceEffectiveFilterMode.at (voice);
                    if (effectiveFilterMode > filterModeOff)
                    {
                        let dryLeft = noteLeft;
                        let dryRight = noteRight;
                        unisonLeftFilters.at (voice).setMode (
                            resolveSimperFilterMode (effectiveFilterMode));
                        unisonLeftFilters.at (voice).setFrequency (
                            processor.frequency,
                            voiceEffectiveFilterCutoffHz.at (voice),
                            voiceEffectiveFilterQ.at (voice),
                            0.0f
                        );
                        unisonRightFilters.at (voice).setMode (
                            resolveSimperFilterMode (effectiveFilterMode));
                        unisonRightFilters.at (voice).setFrequency (
                            processor.frequency,
                            voiceEffectiveFilterCutoffHz.at (voice),
                            voiceEffectiveFilterQ.at (voice),
                            0.0f
                        );
                        let filteredLeft = unisonLeftFilters.at (voice).process (noteLeft);
                        let filteredRight = unisonRightFilters.at (voice).process (noteRight);
                        let effectiveFilterMix = voiceEffectiveFilterMix.at (voice);
                        noteLeft = mixVoiceFilterSample (dryLeft, filteredLeft, effectiveFilterMix);
                        noteRight = mixVoiceFilterSample (dryRight, filteredRight, effectiveFilterMix);
                    }
                    else
                    {
                        unisonLeftFilters.at (voice).reset();
                        unisonRightFilters.at (voice).reset();
                    }

                    // Oscillators A/B/C are already combined by the renderer,
                    // and Bounce is the alternative combined source. The
                    // Voice Filter above feeds this note-owned Enhancer; the
                    // shared per-note Amp Envelope then scales both dry and
                    // residue before voices are summed.
                    let enhancerResidue = voiceEnhancers.at (voice).process (
                        float32<2> (noteLeft, noteRight),
                        voiceEffectiveEnhancerFrequencyHz.at (voice),
                        voiceEffectiveEnhancerQ.at (voice),
                        voiceEffectiveEnhancerAmount.at (voice));
                    let gain = ampEnvelopes[voice].gainOut;
                    leftMix += noteLeft * gain;
                    rightMix += noteRight * gain;
                    enhancerResidueLeftMix += enhancerResidue[0] * gain;
                    enhancerResidueRightMix += enhancerResidue[1] * gain;
                    hasEnhancerResidue = hasEnhancerResidue
                        || voiceEffectiveEnhancerAmount.at (voice) > 0.0f;
                }

                updateRackModulationOutputs();

                trackingPitchHzState = trackingPitchHz;

                float32<2> blockedEnhancerResidue;
                if (hasEnhancerResidue)
                {
                    blockedEnhancerResidue = voiceEnhancerResidueDcBlocker.process (
                        float32<2> (
                            enhancerResidueLeftMix,
                            enhancerResidueRightMix));
                }
                else
                {
                    // Amount 0 is a hard identity even after prior use.
                    voiceEnhancerResidueDcBlocker.reset();
                    blockedEnhancerResidue = ();
                }

                out <- float32<2> (
                    (leftMix + blockedEnhancerResidue[0]) * sourceModeGain,
                    (rightMix + blockedEnhancerResidue[1]) * sourceModeGain);
                trackingPitchHzOut <- trackingPitchHz;
                maybeEmitMonitorUpdate();
                advance();
            }
        }

    }
}
