                    mip8Bank1Samples.at (base + samplesPerFrame + 1) = sourceSamples.at (0);
                    mip8Bank1Samples.at (base + samplesPerFrame + 2) = sourceSamples.at (1);
                }

                return;
            }

            if (mipIndex == 9)
            {
                if (bank == 0)
                {
                    mip9Bank0Samples.at (base + 0) = sourceSamples.at (samplesPerFrame - 1);
                    for (int32 sampleIndex = 0; sampleIndex < samplesPerFrame; ++sampleIndex)
                        mip9Bank0Samples.at (base + sampleIndex + 1) = sourceSamples.at (sampleIndex);
                    mip9Bank0Samples.at (base + samplesPerFrame + 1) = sourceSamples.at (0);
