        float32 readFixedFrameSampleForMip (int32 mipIndex, int32 frameIndex, float32 phase)
        {
            let bank = normalizeTableBankIndex (activeBankIndex);
            let base = frameBase (frameIndex);

            if (mipIndex == 0) return bank == 0 ? readFixedFrameSampleFromBase (mip0Bank0Samples, base, phase) : readFixedFrameSampleFromBase (mip0Bank1Samples, base, phase);
            if (mipIndex == 1) return bank == 0 ? readFixedFrameSampleFromBase (mip1Bank0Samples, base, phase) : readFixedFrameSampleFromBase (mip1Bank1Samples, base, phase);
            if (mipIndex == 2) return bank == 0 ? readFixedFrameSampleFromBase (mip2Bank0Samples, base, phase) : readFixedFrameSampleFromBase (mip2Bank1Samples, base, phase);
            if (mipIndex == 3) return bank == 0 ? readFixedFrameSampleFromBase (mip3Bank0Samples, base, phase) : readFixedFrameSampleFromBase (mip3Bank1Samples, base, phase);
            if (mipIndex == 4) return bank == 0 ? readFixedFrameSampleFromBase (mip4Bank0Samples, base, phase) : readFixedFrameSampleFromBase (mip4Bank1Samples, base, phase);
            if (mipIndex == 5) return bank == 0 ? readFixedFrameSampleFromBase (mip5Bank0Samples, base, phase) : readFixedFrameSampleFromBase (mip5Bank1Samples, base, phase);
            if (mipIndex == 6) return bank == 0 ? readFixedFrameSampleFromBase (mip6Bank0Samples, base, phase) : readFixedFrameSampleFromBase (mip6Bank1Samples, base, phase);
            if (mipIndex == 7) return bank == 0 ? readFixedFrameSampleFromBase (mip7Bank0Samples, base, phase) : readFixedFrameSampleFromBase (mip7Bank1Samples, base, phase);
            if (mipIndex == 8) return bank == 0 ? readFixedFrameSampleFromBase (mip8Bank0Samples, base, phase) : readFixedFrameSampleFromBase (mip8Bank1Samples, base, phase);
            if (mipIndex == 9) return bank == 0 ? readFixedFrameSampleFromBase (mip9Bank0Samples, base, phase) : readFixedFrameSampleFromBase (mip9Bank1Samples, base, phase);
            if (mipIndex == 10) return bank == 0 ? readFixedFrameSampleFromBase (mip10Bank0Samples, base, phase) : readFixedFrameSampleFromBase (mip10Bank1Samples, base, phase);
            return 0.0f;
        }

        float32 readFrameBlendSampleForMip (int32 mipIndex,
                                            int32 frameLo,
                                            int32 frameHi,
                                            float32 phase,
                                            float32 frameT)
        {
            let lo = readFixedFrameSampleForMip (mipIndex, frameLo, phase);

            if (frameHi == frameLo)
                return lo;

            let hi = readFixedFrameSampleForMip (mipIndex, frameHi, phase);
            return lo + (hi - lo) * frameT;
        }

        float32 readFixedFrameEndpointSampleForMip (int32 mipIndex, int32 frameIndex)
        {
            let bank = normalizeTableBankIndex (activeBankIndex);
            let endpointIndex = frameBase (frameIndex) + samplesPerFrame;

            if (mipIndex == 0) return bank == 0 ? mip0Bank0Samples.at (endpointIndex) : mip0Bank1Samples.at (endpointIndex);
            if (mipIndex == 1) return bank == 0 ? mip1Bank0Samples.at (endpointIndex) : mip1Bank1Samples.at (endpointIndex);
            if (mipIndex == 2) return bank == 0 ? mip2Bank0Samples.at (endpointIndex) : mip2Bank1Samples.at (endpointIndex);
            if (mipIndex == 3) return bank == 0 ? mip3Bank0Samples.at (endpointIndex) : mip3Bank1Samples.at (endpointIndex);
            if (mipIndex == 4) return bank == 0 ? mip4Bank0Samples.at (endpointIndex) : mip4Bank1Samples.at (endpointIndex);
            if (mipIndex == 5) return bank == 0 ? mip5Bank0Samples.at (endpointIndex) : mip5Bank1Samples.at (endpointIndex);
            if (mipIndex == 6) return bank == 0 ? mip6Bank0Samples.at (endpointIndex) : mip6Bank1Samples.at (endpointIndex);
            if (mipIndex == 7) return bank == 0 ? mip7Bank0Samples.at (endpointIndex) : mip7Bank1Samples.at (endpointIndex);
            if (mipIndex == 8) return bank == 0 ? mip8Bank0Samples.at (endpointIndex) : mip8Bank1Samples.at (endpointIndex);
            if (mipIndex == 9) return bank == 0 ? mip9Bank0Samples.at (endpointIndex) : mip9Bank1Samples.at (endpointIndex);
            if (mipIndex == 10) return bank == 0 ? mip10Bank0Samples.at (endpointIndex) : mip10Bank1Samples.at (endpointIndex);
            return 0.0f;
        }

        float32 readFrameBlendEndpointSampleForMip (int32 mipIndex,
                                                    int32 frameLo,
                                                    int32 frameHi,
                                                    float32 frameT)
        {
            let lo = readFixedFrameEndpointSampleForMip (mipIndex, frameLo);

            if (frameHi == frameLo)
                return lo;

            let hi = readFixedFrameEndpointSampleForMip (mipIndex, frameHi);
            return lo + (hi - lo) * frameT;
        }

        void emitMipRequest (int32 mipIndex, int32 urgencyLevel)
        {
            let requestIndex = oscillatorMipIndex (oscillatorA, mipIndex);

            if (currentGeneration <= 0 || frameCount <= 0
                || mipIndex < 0 || mipIndex >= mipLevelCount)
                return;

            if (oscillatorRequestedGenerationByMip.at (requestIndex) == currentGeneration
                && oscillatorRequestedUrgencyByMip.at (requestIndex) >= urgencyLevel)
                return;

            WavetableMipRequest request;
            request.dspSessionId = currentDspSessionId;
            request.generation = currentGeneration;
            request.tableIndex = currentTableIndex;
            request.mipIndex = mipIndex;
            request.urgencyLevel = urgencyLevel;
            oscillatorRequestedGenerationByMip.at (requestIndex) = currentGeneration;
            oscillatorRequestedUrgencyByMip.at (requestIndex) = urgencyLevel;
            wavetableMipRequestOut <- request;

            OscillatorWavetableMipRequest oscillatorRequest;
            oscillatorRequest.dspSessionId = currentDspSessionId;
            oscillatorRequest.oscillatorIndex = oscillatorA;
            oscillatorRequest.generation = currentGeneration;
            oscillatorRequest.tableIndex = currentTableIndex;
            oscillatorRequest.mipIndex = mipIndex;
            oscillatorRequest.urgencyLevel = urgencyLevel;
            oscillatorWavetableMipRequestOut <- oscillatorRequest;
        }

        void emitUploadAck (int32 oscillatorIndex,
                            int32 generation,
                            int32 tableIndex,
                            int32 mipIndex,
                            int32 uploadedFrameIndex)
        {
            OscillatorWavetableUploadAck oscillatorAck;
            oscillatorAck.dspSessionId = currentDspSessionId;
            oscillatorAck.oscillatorIndex = oscillatorIndex;
            oscillatorAck.generation = generation;
            oscillatorAck.tableIndex = tableIndex;
            oscillatorAck.mipIndex = mipIndex;
            oscillatorAck.frameIndex = uploadedFrameIndex;
            oscillatorWavetableUploadAckOut <- oscillatorAck;

            if (oscillatorIndex == oscillatorA)
            {
                WavetableUploadAck ack;
                ack.dspSessionId = currentDspSessionId;
                ack.generation = generation;
                ack.tableIndex = tableIndex;
                ack.mipIndex = mipIndex;
                ack.frameIndex = uploadedFrameIndex;
                wavetableUploadAckOut <- ack;
            }
        }

        void emitRuntimeServiceState (int32 oscillatorIndex)
        {
            let oscillator = int32 (wrap<oscillatorCount> (oscillatorIndex));

            let hasActive = oscillatorActiveSlot.at (oscillator) >= 0 ? 1 : 0;
            let hasLoading = tableStagingOscillatorIndex == oscillator
                && tableStagingGeneration > 0 && tableStagingFrameCount > 0 ? 1 : 0;
            OscillatorRuntimeServiceState oscillatorState;
            oscillatorState.dspSessionId = currentDspSessionId;
            oscillatorState.oscillatorIndex = oscillator;
            oscillatorState.generationFrontier = oscillatorGenerationFrontier.at (oscillator);
            oscillatorState.serviceState = hasLoading != 0 ? 1 : (hasActive != 0 ? 2 : 0);
            oscillatorState.hasActive = hasActive;
            oscillatorState.activeTableIndex = hasActive != 0
                ? oscillatorCurrentTableIndex.at (oscillator) : 0;
            oscillatorState.activeGeneration = hasActive != 0
                ? oscillatorCurrentGeneration.at (oscillator) : 0;
            oscillatorState.hasLoading = hasLoading;
            oscillatorState.loadingTableIndex = hasLoading != 0 ? tableStagingTableIndex : 0;
            oscillatorState.loadingGeneration = hasLoading != 0 ? tableStagingGeneration : 0;
            oscillatorRuntimeServiceStateOut <- oscillatorState;

            if (oscillator == oscillatorA)
            {
                RuntimeServiceState state;
                state.dspSessionId = oscillatorState.dspSessionId;
                state.generationFrontier = oscillatorState.generationFrontier;
                state.serviceState = oscillatorState.serviceState;
                state.hasActive = oscillatorState.hasActive;
                state.activeTableIndex = oscillatorState.activeTableIndex;
                state.activeGeneration = oscillatorState.activeGeneration;
                state.hasLoading = oscillatorState.hasLoading;
                state.loadingTableIndex = oscillatorState.loadingTableIndex;
                state.loadingGeneration = oscillatorState.loadingGeneration;
                runtimeServiceStateOut <- state;
            }
        }

        int32 findNewestVisibleGeneration()
        {
            int32 newestGeneration = 0;

            for (wrap<voiceCount> voice)
                newestGeneration = std::intrinsics::max (newestGeneration, voiceGeneration.at (voice));

            return newestGeneration;
        }

        int32 findNewestMonitoredVoiceIndex()
        {
            int32 newestGeneration = -1;
            int32 newestVoiceIndex = -1;

            for (wrap<voiceCount> voice)
            {
                let isVisible = voiceActive.at (voice) != 0 || envelopes[voice].gainOut > 0.0f;

                if (isVisible && voiceGeneration.at (voice) >= newestGeneration)
                {
                    newestGeneration = voiceGeneration.at (voice);
                    newestVoiceIndex = int32 (voice);
                }
            }

            return newestVoiceIndex;
        }

        void emitEffectiveWavetablePositionMonitor()
        {
            wt::EffectiveWavetablePositionMonitor monitor;
            let newestVoiceIndex = findNewestMonitoredVoiceIndex();

            if (newestVoiceIndex >= 0)
            {
                monitor.voiceGeneration = voiceGeneration.at (newestVoiceIndex);
                monitor.position = std::intrinsics::clamp (voiceEffectivePosition.at (newestVoiceIndex), 0.0f, 1.0f);
            }
            else
            {
                monitor.voiceGeneration = findNewestVisibleGeneration();
                monitor.position = std::intrinsics::clamp (framePositionIn, 0.0f, 1.0f);
            }

            effectiveWavetablePositionOut <- monitor;
        }

        void emitEffectiveWarpStateMonitor()
        {
            wt::EffectiveWarpStateMonitor monitor;
            let newestVoiceIndex = findNewestMonitoredVoiceIndex();

            if (newestVoiceIndex >= 0)
            {
                monitor.voiceGeneration = voiceGeneration.at (newestVoiceIndex);
                monitor.hasActive = 1;
                monitor.mode = voiceEffectiveWarpMode.at (newestVoiceIndex);
                monitor.amount = std::intrinsics::clamp (voiceEffectiveWarpAmount.at (newestVoiceIndex), 0.0f, 1.0f);
            }
            else
            {
                monitor.voiceGeneration = findNewestVisibleGeneration();
                monitor.hasActive = 0;
                monitor.mode = resolveWarpMode (warpModeIn);
                monitor.amount = std::intrinsics::clamp (warpAmountIn, 0.0f, 1.0f);
            }

            effectiveWarpStateOut <- monitor;
        }

        void emitEffectiveUnisonStateMonitor()
        {
            wt::EffectiveUnisonStateMonitor monitor;
            let newestVoiceIndex = findNewestMonitoredVoiceIndex();

            if (newestVoiceIndex >= 0)
            {
                monitor.voiceGeneration = voiceGeneration.at (newestVoiceIndex);
                monitor.hasActive = 1;
                monitor.voices = voiceEffectiveUnisonVoices.at (newestVoiceIndex);
                monitor.detune = voiceEffectiveUnisonDetune.at (newestVoiceIndex);
                monitor.blend = voiceEffectiveUnisonBlend.at (newestVoiceIndex);
                monitor.width = voiceEffectiveUnisonWidth.at (newestVoiceIndex);
                monitor.detuneMode = voiceEffectiveUnisonDetuneMode.at (newestVoiceIndex);
                monitor.stackMode = voiceEffectiveUnisonStackMode.at (newestVoiceIndex);
                monitor.wavetablePositionSpread = voiceEffectiveUnisonWavetablePositionSpread.at (newestVoiceIndex);
                monitor.warpSpread = voiceEffectiveUnisonWarpSpread.at (newestVoiceIndex);
            }
            else
            {
                monitor.voiceGeneration = findNewestVisibleGeneration();
                monitor.hasActive = 0;
                monitor.voices = unisonVoicesState;
                monitor.detune = unisonDetuneState;
                monitor.blend = unisonBlendState;
                monitor.width = unisonWidthState;
                monitor.detuneMode = unisonDetuneModeState;
                monitor.stackMode = unisonStackModeState;
                monitor.wavetablePositionSpread = unisonWavetablePositionSpreadState;
                monitor.warpSpread = unisonWarpSpreadState;
            }

            effectiveUnisonStateOut <- monitor;
        }

        void emitEffectiveFilterStateMonitor()
        {
            wt::EffectiveFilterStateMonitor monitor;
            let newestVoiceIndex = findNewestMonitoredVoiceIndex();

            if (newestVoiceIndex >= 0)
            {
                monitor.voiceGeneration = voiceGeneration.at (newestVoiceIndex);
                monitor.hasActive = 1;
                monitor.mode = voiceEffectiveFilterMode.at (newestVoiceIndex);
                monitor.cutoffHz = voiceEffectiveFilterCutoffHz.at (newestVoiceIndex);
                monitor.q = voiceEffectiveFilterQ.at (newestVoiceIndex);
            }
            else
            {
                let processorFrequency = float32 (processor.frequency);
                monitor.voiceGeneration = findNewestVisibleGeneration();
                monitor.hasActive = 0;
                monitor.mode = resolveFilterMode (filterModeIn);
                monitor.cutoffHz = clampFilterCutoffHz (filterCutoffIn, processorFrequency);
                monitor.q = clampFilterQ (filterQIn);
            }

            effectiveFilterStateOut <- monitor;
        }

        void emitEffectiveMsegStateMonitor()
        {
            wt::EffectiveMsegStateMonitor monitor;
            let newestVoiceIndex = findNewestMonitoredVoiceIndex();

            if (newestVoiceIndex >= 0)
            {
                monitor.voiceGeneration = voiceGeneration.at (newestVoiceIndex);
                monitor.hasActive = 1;
                monitor.positions[0] = std::intrinsics::clamp (voiceMsegProgress1.at (newestVoiceIndex), 0.0f, 1.0f);
                monitor.positions[1] = std::intrinsics::clamp (voiceMsegProgress2.at (newestVoiceIndex), 0.0f, 1.0f);
                monitor.positions[2] = std::intrinsics::clamp (voiceMsegProgress3.at (newestVoiceIndex), 0.0f, 1.0f);
            }
            else
            {
                monitor.voiceGeneration = findNewestVisibleGeneration();
                monitor.hasActive = 0;
                monitor.positions[0] = 0.0f;
                monitor.positions[1] = 0.0f;
                monitor.positions[2] = 0.0f;
            }

            effectiveMsegStateOut <- monitor;
        }

        void maybeEmitMonitorUpdate()
        {
            if (framesUntilNextMonitorUpdate <= 0)
            {
                emitEffectiveWavetablePositionMonitor();
                framesUntilNextMonitorUpdate = monitorUpdateIntervalFrames - 1;
            }
            else
            {
                framesUntilNextMonitorUpdate -= 1;
            }

            if (framesUntilNextWarpMonitorUpdate <= 0)
            {
                emitEffectiveWarpStateMonitor();
                framesUntilNextWarpMonitorUpdate = warpMonitorUpdateIntervalFrames - 1;
            }
            else
            {
                framesUntilNextWarpMonitorUpdate -= 1;
            }

            if (framesUntilNextUnisonMonitorUpdate <= 0)
            {
                emitEffectiveUnisonStateMonitor();
                framesUntilNextUnisonMonitorUpdate = unisonMonitorUpdateIntervalFrames - 1;
            }
            else
            {
                framesUntilNextUnisonMonitorUpdate -= 1;
            }

            if (framesUntilNextFilterMonitorUpdate <= 0)
            {
                emitEffectiveFilterStateMonitor();
                framesUntilNextFilterMonitorUpdate = filterMonitorUpdateIntervalFrames - 1;
            }
            else
            {
                framesUntilNextFilterMonitorUpdate -= 1;
            }

            if (framesUntilNextMsegMonitorUpdate <= 0)
            {
                emitEffectiveMsegStateMonitor();
                framesUntilNextMsegMonitorUpdate = msegMonitorUpdateIntervalFrames - 1;
            }
            else
            {
                framesUntilNextMsegMonitorUpdate -= 1;
            }
        }

        void maybeTransitionServiceToPlayable()
        {
        }

        float32 readVoiceSampleForMip (int32 playableMipIndex,
                                       float32 effectivePosition,
                                       float32 phase)
        {
            if (frameCount <= 1)
                return readFixedFrameSampleForMip (playableMipIndex, 0, phase);

            let frameIndex = effectivePosition * lastFrameIndexF;
            let frameLo = int32 (std::intrinsics::floor (frameIndex));
            let frameHi = std::intrinsics::min (frameLo + 1, lastFrameIndex);
            let frameT = frameIndex - float32 (frameLo);
            return readFrameBlendSampleForMip (playableMipIndex, frameLo, frameHi, phase, frameT);
        }

        float32 readVoiceEndpointSampleForMip (int32 playableMipIndex,
                                               float32 effectivePosition)
        {
            if (frameCount <= 1)
                return readFixedFrameEndpointSampleForMip (playableMipIndex, 0);

            let frameIndex = effectivePosition * lastFrameIndexF;
            let frameLo = int32 (std::intrinsics::floor (frameIndex));
            let frameHi = std::intrinsics::min (frameLo + 1, lastFrameIndex);
            let frameT = frameIndex - float32 (frameLo);
            return readFrameBlendEndpointSampleForMip (playableMipIndex, frameLo, frameHi, frameT);
        }

        void pushWarpHistorySample (int32 voiceIndex, int32 oscillatorIndex, float32 sample)
        {
            let resolvedVoice = int32 (wrap<voiceCount> (voiceIndex));
            let resolvedOscillator = int32 (wrap<oscillatorCount> (oscillatorIndex));
            let stateIndex = oscillatorVoiceIndex (resolvedVoice, resolvedOscillator);
            let writeIndex = voiceWarpHistoryWriteIndex.at (stateIndex);
            voiceWarpHistory.at (
                warpHistoryIndex (resolvedVoice, resolvedOscillator, writeIndex)) = sample;
            int32 nextWriteIndex = writeIndex + 1;

            if (nextWriteIndex >= warpDecimatorTapCount)
                nextWriteIndex = 0;

            voiceWarpHistoryWriteIndex.at (stateIndex) = nextWriteIndex;
        }

        float32 readWarpDecimatorOutput (int32 voiceIndex, int32 oscillatorIndex)
        {
            let resolvedVoice = int32 (wrap<voiceCount> (voiceIndex));
            let resolvedOscillator = int32 (wrap<oscillatorCount> (oscillatorIndex));
            int32 historyIndex = voiceWarpHistoryWriteIndex.at (
                oscillatorVoiceIndex (resolvedVoice, resolvedOscillator));
            float32 sum = 0.0f;

            for (int32 tapIndex = 0; tapIndex < warpDecimatorTapCount; ++tapIndex)
            {
                historyIndex -= 1;

                if (historyIndex < 0)
                    historyIndex = warpDecimatorTapCount - 1;

                sum += voiceWarpHistory.at (
                           warpHistoryIndex (resolvedVoice, resolvedOscillator, historyIndex))
                     * warpDecimatorTapsState.at (tapIndex);
            }

            return sum;
        }

        float32 renderWarpedVoiceSample (int32 voiceIndex,
                                         int32 oscillatorIndex,
                                         int32 playableMipIndex,
                                         float32 effectivePosition,
                                         float32 basePhase,
                                         float32 currentPhaseIncrement,
                                         int32 warpMode,
                                         float32 effectiveWarpAmount)
        {
            let oversampledPhaseIncrement = currentPhaseIncrement / float32 (warpOversampleFactor);

            for (int32 oversampleIndex = 0; oversampleIndex < warpOversampleFactor; ++oversampleIndex)
            {
                let oversampledPhase = std::intrinsics::wrap (
                    basePhase + (float32 (oversampleIndex) * oversampledPhaseIncrement),
                    1.0f
                );
                let warpedPhase = resolveWarpPhase (warpMode, effectiveWarpAmount, oversampledPhase);
                float32 oversampledSample = 0.0f;

                if (warpedPhase.shouldLookup)
                    oversampledSample = readVoiceSampleForMip (playableMipIndex, effectivePosition, warpedPhase.phase);
                else if (warpedPhase.holdCycleEndpoint)
                    oversampledSample = readVoiceEndpointSampleForMip (playableMipIndex, effectivePosition);

                pushWarpHistorySample (voiceIndex, oscillatorIndex, oversampledSample);
            }

            return readWarpDecimatorOutput (voiceIndex, oscillatorIndex);
        }

        void pushUnisonWarpHistorySample (int32 voiceIndex,
                                          int32 oscillatorIndex,
                                          int32 subVoiceIndex,
                                          float32 sample)
        {
            let resolvedVoice = int32 (wrap<voiceCount> (voiceIndex));
            let resolvedOscillator = int32 (wrap<oscillatorCount> (oscillatorIndex));
            let resolvedSubVoice = int32 (wrap<maxUnisonVoiceCount> (subVoiceIndex));
            let stateIndex = oscillatorLaneIndex (
                resolvedVoice, resolvedOscillator, resolvedSubVoice);
            let writeIndex = unisonWarpHistoryWriteIndex.at (stateIndex);
            unisonWarpHistory.at (unisonWarpHistoryIndex (
                resolvedVoice, resolvedOscillator, resolvedSubVoice, writeIndex)) = sample;
            int32 nextWriteIndex = writeIndex + 1;

            if (nextWriteIndex >= warpDecimatorTapCount)
                nextWriteIndex = 0;

            unisonWarpHistoryWriteIndex.at (stateIndex) = nextWriteIndex;
        }

        float32 readUnisonWarpDecimatorOutput (int32 voiceIndex,
                                               int32 oscillatorIndex,
                                               int32 subVoiceIndex)
        {
            let resolvedVoice = int32 (wrap<voiceCount> (voiceIndex));
            let resolvedOscillator = int32 (wrap<oscillatorCount> (oscillatorIndex));
            let resolvedSubVoice = int32 (wrap<maxUnisonVoiceCount> (subVoiceIndex));
            int32 historyIndex = unisonWarpHistoryWriteIndex.at (
                oscillatorLaneIndex (resolvedVoice, resolvedOscillator, resolvedSubVoice));
            float32 sum = 0.0f;

            for (int32 tapIndex = 0; tapIndex < warpDecimatorTapCount; ++tapIndex)
            {
                historyIndex -= 1;

                if (historyIndex < 0)
                    historyIndex = warpDecimatorTapCount - 1;

                sum += unisonWarpHistory.at (unisonWarpHistoryIndex (
                           resolvedVoice, resolvedOscillator, resolvedSubVoice, historyIndex))
                     * warpDecimatorTapsState.at (tapIndex);
            }

            return sum;
        }

        float32 renderWarpedUnisonSample (int32 voiceIndex,
                                          int32 oscillatorIndex,
                                          int32 subVoiceIndex,
                                          int32 playableMipIndex,
                                          float32 effectivePosition,
                                          float32 basePhase,
                                          float32 currentPhaseIncrement,
                                          int32 warpMode,
                                          float32 effectiveWarpAmount)
        {
            let oversampledPhaseIncrement = currentPhaseIncrement / float32 (warpOversampleFactor);

            for (int32 oversampleIndex = 0; oversampleIndex < warpOversampleFactor; ++oversampleIndex)
            {
                let oversampledPhase = std::intrinsics::wrap (
                    basePhase + (float32 (oversampleIndex) * oversampledPhaseIncrement),
                    1.0f
                );
                let warpedPhase = resolveWarpPhase (warpMode, effectiveWarpAmount, oversampledPhase);
                float32 oversampledSample = 0.0f;

                if (warpedPhase.shouldLookup)
                    oversampledSample = readVoiceSampleForMip (playableMipIndex, effectivePosition, warpedPhase.phase);
                else if (warpedPhase.holdCycleEndpoint)
                    oversampledSample = readVoiceEndpointSampleForMip (playableMipIndex, effectivePosition);

                pushUnisonWarpHistorySample (
                    voiceIndex, oscillatorIndex, subVoiceIndex, oversampledSample);
            }

            return readUnisonWarpDecimatorOutput (
                voiceIndex, oscillatorIndex, subVoiceIndex);
        }

        void resetOscillatorUnisonPhases (int32 voiceIndex,
                                          int32 oscillatorIndex,
                                          int32 unisonVoiceCount,
                                          float32 phase,
                                          float32 randomAmount)
        {
            let voice = int32 (wrap<voiceCount> (voiceIndex));
            let oscillator = int32 (wrap<oscillatorCount> (oscillatorIndex));
            let generation = voiceGeneration.at (voice);

            for (wrap<maxUnisonVoiceCount> subVoice)
            {
                let subIndex = int32 (subVoice);
                let phaseForVoice = subIndex < unisonVoiceCount
                    ? unisonSubVoicePhase (
                        voice, oscillator, subIndex, generation, phase, randomAmount)
                    : 0.0f;
                unisonPhasors.at (
                    oscillatorLaneIndex (voice, oscillator, subIndex)).phase = phaseForVoice;
            }
        }

        void emitOscillatorVoiceStart (int32 voiceIndex, int32 oscillatorIndex)
        {
            let voice = int32 (wrap<voiceCount> (voiceIndex));
            let oscillator = int32 (wrap<oscillatorCount> (oscillatorIndex));
            OscillatorVoiceStartMonitor monitor;
            monitor.voiceIndex = voice;
            monitor.oscillatorIndex = oscillator;
            monitor.voiceGeneration = voiceOscillatorGeneration.at (
                oscillatorVoiceIndex (voice, oscillator));
            monitor.channel = voiceChannel.at (voice);
            monitor.pitch = voiceBasePitch.at (voice);
            monitor.firstUnisonPhase = unisonPhasors.at (
                oscillatorLaneIndex (voice, oscillator, 0)).phase;
            monitor.lastUnisonPhase = unisonPhasors.at (
                oscillatorLaneIndex (voice, oscillator, maxUnisonVoiceCount - 1)).phase;
            oscillatorVoiceStartOut <- monitor;
        }

        void resetVoiceOscillatorLifecycle (int32 voiceIndex)
        {
            let voice = int32 (wrap<voiceCount> (voiceIndex));
            let unisonVoiceCount = voiceUsesArticulation.at (voice)
                ? voiceArticulationUnisonVoices.at (voice)
                : unisonVoicesState;
            let phase = voiceUsesArticulation.at (voice)
                ? voiceArticulationUnisonPhase.at (voice)
                : unisonPhaseState;
            let randomAmount = voiceUsesArticulation.at (voice)
                ? voiceArticulationUnisonRandom.at (voice)
                : unisonRandomState;
            let phaseMode = voiceUsesArticulation.at (voice)
                ? voiceArticulationUnisonPhaseMode.at (voice)
                : unisonPhaseModeState;

            for (wrap<oscillatorCount> oscillatorWrapped)
            {
                let oscillator = int32 (oscillatorWrapped);
                voiceOscillatorGeneration.at (oscillatorVoiceIndex (voice, oscillator))
                    = voiceGeneration.at (voice);
                resetOscillatorWarpRenderState (voice, oscillator);
                resetOscillatorUnisonWarpRenderState (voice, oscillator);

                if (phaseMode == unisonPhaseModeReset)
                    resetOscillatorUnisonPhases (
                        voice, oscillator, unisonVoiceCount, phase, randomAmount);

                emitOscillatorVoiceStart (voice, oscillator);
            }
        }

        void clearVoiceGlide (int32 voiceIndex)
        {
            let voice = wrap<voiceCount> (voiceIndex);
            voicePitchGlideStep.at (voice) = 0.0f;
            voiceGlideSamplesRemaining.at (voice) = 0;
        }

        void setVoicePitchImmediate (int32 voiceIndex, float32 pitch)
        {
            let voice = wrap<voiceCount> (voiceIndex);
            voiceBasePitch.at (voice) = pitch;
            voiceCurrentPitch.at (voice) = pitch;
            voiceTargetPitch.at (voice) = pitch;
            clearVoiceGlide (voiceIndex);
        }

        void startVoiceGlideToPitch (int32 voiceIndex, float32 targetPitch)
        {
            let voice = wrap<voiceCount> (voiceIndex);
            voiceBasePitch.at (voice) = targetPitch;
            voiceTargetPitch.at (voice) = targetPitch;

            let requestedSeconds = std::intrinsics::max (0.0f, glideTimeSecondsState);
            let glideSamples = int32 (
                std::intrinsics::floor ((requestedSeconds * float32 (processor.frequency)) + 0.5f)
            );

            if (glideSamples <= 0 || std::intrinsics::abs (voiceCurrentPitch.at (voice) - targetPitch) <= 0.0001f)
            {
                setVoicePitchImmediate (voiceIndex, targetPitch);
                return;
            }

            voiceGlideSamplesRemaining.at (voice) = glideSamples;
            voicePitchGlideStep.at (voice) = (targetPitch - voiceCurrentPitch.at (voice)) / float32 (glideSamples);
        }

        void advanceVoicePitchState (int32 voiceIndex)
        {
            let voice = wrap<voiceCount> (voiceIndex);

            if (voiceGlideSamplesRemaining.at (voice) > 0)
            {
                voiceCurrentPitch.at (voice) += voicePitchGlideStep.at (voice);
                voiceGlideSamplesRemaining.at (voice) -= 1;

                if (voiceGlideSamplesRemaining.at (voice) <= 0)
                {
                    voiceCurrentPitch.at (voice) = voiceTargetPitch.at (voice);
                    clearVoiceGlide (voiceIndex);
                }
            }
        }

        void startVoiceFromNote (int32 index,
                                 std::notes::NoteOn note,
                                 bool hasArticulation,
                                 int32 selectorA,
                                 int32 selectorB,
                                 int32 durationSamples,
                                 int32 ageSamples)
        {
            let voice = wrap<voiceCount> (index);
            voiceChannel.at (voice) = note.channel;
            voiceVelocity.at (voice) = note.velocity;
            voiceBendSemitones.at (voice) = 0.0f;
            voicePressure.at (voice) = 0.0f;
            voiceSlide.at (voice) = 0.0f;
            latchVoiceArticulation (index, hasArticulation, selectorA, selectorB, durationSamples, ageSamples);
            setVoicePitchImmediate (index, note.pitch);
            voiceActive.at (voice) = 1;
            voiceGeneration.at (voice) = nextVoiceGeneration;
            nextVoiceGeneration += 1;
            voiceTrackingSerial.at (voice) = nextVoiceTrackingSerial;
            nextVoiceTrackingSerial += 1;
            resetVoiceOscillatorLifecycle (index);
            resetFilterState (index);

            envelopes[voice].eventIn <- note;
            triggerVoiceModulators (index);
        }

        event voiceEventIn (int index, std::notes::NoteOn note)
        {
            startVoiceFromNote (int32 (index), note, false, wt::articulationSelectorNone, 0, 0, 0);
        }

        event voiceEventIn (int index, wt::ArticulatedNoteOn articulatedNote)
        {
            std::notes::NoteOn note;
            note.channel = articulatedNote.channel;
            note.pitch = articulatedNote.pitch;
            note.velocity = articulatedNote.velocity;
            startVoiceFromNote (int32 (index),
                                note,
                                articulatedNote.hasArticulation,
                                articulatedNote.selectorA,
                                articulatedNote.selectorB,
                                articulatedNote.durationSamples,
                                articulatedNote.ageSamples);
        }

        event voiceEventIn (int index, std::notes::NoteOff note)
        {
            let voice = wrap<voiceCount> (index);
            voiceActive.at (voice) = 0;
            envelopes[voice].eventIn <- note;
            noteOffVoiceModulators (index, note);
        }

        event voiceEventIn (int index, std::notes::PitchBend bend)
        {
            let voice = wrap<voiceCount> (index);
            voiceBendSemitones.at (voice) = bend.bendSemitones;
        }

        event voiceEventIn (int index, std::notes::Slide slide)
        {
            let voice = wrap<voiceCount> (index);
            voiceSlide.at (voice) = slide.slide;
        }

        event voiceEventIn (int index, std::notes::Pressure pressure)
        {
            let voice = wrap<voiceCount> (index);
            voicePressure.at (voice) = pressure.pressure;
        }

        event voiceEventIn (int index, std::notes::Control control) {}

        event voiceRetuneIn (int index, VoiceRetune change)
        {
            let voice = wrap<voiceCount> (index);
            let shouldRetrigger = change.retrigger || voiceActive.at (voice) == 0;
            let shouldGlide = change.glide && voiceActive.at (voice) != 0;

            voiceChannel.at (voice) = change.channel;
            voiceVelocity.at (voice) = change.velocity;
            voiceBendSemitones.at (voice) = change.bendSemitones;
            voicePressure.at (voice) = change.pressure;
            voiceSlide.at (voice) = change.slide;
            latchVoiceArticulation (index,
                                    change.hasArticulation,
                                    change.selectorA,
                                    change.selectorB,
                                    change.durationSamples,
                                    change.ageSamples);

            if (shouldGlide)
                startVoiceGlideToPitch (index, change.pitch);
            else
                setVoicePitchImmediate (index, change.pitch);

            voiceActive.at (voice) = 1;
            voiceTrackingSerial.at (voice) = nextVoiceTrackingSerial;
            nextVoiceTrackingSerial += 1;

            if (shouldRetrigger)
            {
                std::notes::NoteOn note;
                note.channel = change.channel;
                note.pitch = change.pitch;
                note.velocity = change.velocity;
                voiceGeneration.at (voice) = nextVoiceGeneration;
                nextVoiceGeneration += 1;
                resetVoiceOscillatorLifecycle (index);
                resetFilterState (index);
                envelopes[voice].eventIn <- note;
                triggerVoiceModulators (index);
            }
        }

        void rejectModulationProgram()
        {
            rejectedModulationRouteCount += 1;
            modulationRejectedRouteCountOut <- rejectedModulationRouteCount;
        }

        void emitRuntimeInstallAck (int32 rejectedSerial, int32 rejectionReason, int32 syncSerial)
        {
            RuntimeInstallAck ack;
            ack.dspSessionId = currentDspSessionId;
            ack.acceptedModulationSerial = acceptedModulationSerial;
            ack.acceptedModulationProgramSerial = acceptedModulationProgramSerial;
            ack.installedVoiceRouteCount = voiceRouteCount;
            ack.installedMacroVoiceRouteCount = macroVoiceRouteCount;
            ack.installedVoiceRackRouteCount = voiceRackRouteCount;
            ack.installedMacroRackRouteCount = macroRackRouteCount;
            ack.acceptedArticulationSerial = acceptedArticulationSerial;
            ack.rejectedSerial = rejectedSerial;
            ack.rejectionReason = rejectionReason;
            ack.syncSerial = syncSerial;
            runtimeInstallAckOut <- ack;
        }

        int32 beginModulationRuntimeInstall (int32 dspSessionId, int32 deliverySerial)
        {
            if (dspSessionId != currentDspSessionId)
            {
                emitRuntimeInstallAck (deliverySerial, runtimeInstallRejectionSession, 0);
                return 0;
            }

            if (deliverySerial <= 0 || deliverySerial > acceptedModulationSerial + 1)
            {
                emitRuntimeInstallAck (deliverySerial, runtimeInstallRejectionGap, 0);
                return 0;
            }

            if (deliverySerial <= acceptedModulationSerial)
            {
                emitRuntimeInstallAck (0, runtimeInstallRejectionNone, 0);
                return 0;
            }

            return 2;
        }

        int32 beginArticulationRuntimeInstall (int32 dspSessionId, int32 deliverySerial)
        {
            if (dspSessionId != currentDspSessionId)
            {
                emitRuntimeInstallAck (deliverySerial, runtimeInstallRejectionSession, 0);
                return 0;
            }

            if (deliverySerial >= 0 || deliverySerial < acceptedArticulationSerial - 1)
            {
                emitRuntimeInstallAck (deliverySerial, runtimeInstallRejectionGap, 0);
                return 0;
            }

            if (deliverySerial >= acceptedArticulationSerial)
            {
                emitRuntimeInstallAck (0, runtimeInstallRejectionNone, 0);
                return 0;
            }

            return 2;
        }

        void completeModulationRuntimeInstall (int32 deliverySerial)
        {
            if (deliverySerial > 0)
            {
                acceptedModulationSerial = deliverySerial;
                emitRuntimeInstallAck (0, runtimeInstallRejectionNone, 0);
            }
        }

        void completeArticulationRuntimeInstall (int32 deliverySerial)
        {
            if (deliverySerial < 0)
            {
                acceptedArticulationSerial = deliverySerial;
                emitRuntimeInstallAck (0, runtimeInstallRejectionNone, 0);
            }
        }

        void rejectRuntimeInstall (int32 deliverySerial)
        {
            if (deliverySerial != 0)
                emitRuntimeInstallAck (deliverySerial, runtimeInstallRejectionInvalid, 0);
        }

        event runtimeInstallSyncIn (int32 syncSerial)
        {
            emitRuntimeInstallAck (0, runtimeInstallRejectionNone, syncSerial);
        }

        event modulationProgramIn (ModulationProgramUpload upload)
        {
            let installKind = beginModulationRuntimeInstall (upload.dspSessionId, upload.deliverySerial);
            if (installKind == 0)
                return;

            if (! isValidModulationProgram (upload))
            {
                rejectModulationProgram();
                rejectRuntimeInstall (upload.deliverySerial);
                return;
            }

            for (int32 sourceIndex = 0; sourceIndex < modulationVoiceSourceCount; ++sourceIndex)
            {
                voiceRackSourceUsed.at (sourceIndex) = false;
                voiceRouteSourceUsed.at (sourceIndex) = false;
                voiceRouteScaleVectors.at (sourceIndex)
                    = float32<modulationVoiceTargetCount> (0.0f);
                voiceRouteBiasVectors.at (sourceIndex)
                    = float32<modulationVoiceTargetCount> (0.0f);
            }

            for (int32 sourceIndex = 0; sourceIndex < modulationMacroSourceCount; ++sourceIndex)
            {
                macroVoiceRouteSourceUsed.at (sourceIndex) = false;
                macroVoiceRouteScaleVectors.at (sourceIndex)
                    = float32<modulationVoiceTargetCount> (0.0f);
                macroVoiceRouteBiasVectors.at (sourceIndex)
                    = float32<modulationVoiceTargetCount> (0.0f);
                macroRackRouteSourceUsed.at (sourceIndex) = false;
                macroRackRouteScaleVectors.at (sourceIndex)
                    = float32<rackModTargetCount> (0.0f);
                macroRackRouteBiasVectors.at (sourceIndex)
                    = float32<rackModTargetCount> (0.0f);
            }

            for (int32 cellIndex = 0; cellIndex < modulationVoiceRouteCellCount; ++cellIndex)
                voiceRouteAmounts.at (cellIndex) = upload.voiceRouteAmounts.at (cellIndex);

            for (int32 routeIndex = 0; routeIndex < upload.voiceRouteCount; ++routeIndex)
            {
                let cellIndex = upload.voiceRouteCells.at (routeIndex);
                let sourceIndex = upload.voiceRouteSources.at (routeIndex);
                let targetIndex = upload.voiceRouteTargets.at (routeIndex);
                let polarityKind = upload.voiceRoutePolarities.at (routeIndex);
                let amount = upload.voiceRouteAmounts.at (cellIndex);
                voiceRouteCells.at (routeIndex) = cellIndex;
                voiceRouteSources.at (routeIndex) = sourceIndex;
                voiceRouteTargets.at (routeIndex) = targetIndex;
                voiceRoutePolarities.at (routeIndex) = polarityKind;
                voiceRouteScales.at (routeIndex) = modulationRouteScale (amount, polarityKind);
                voiceRouteBiases.at (routeIndex) = modulationRouteBias (amount, polarityKind);
                voiceRouteSourceUsed.at (sourceIndex) = true;
                voiceRouteScaleVectors.at (sourceIndex).at (targetIndex)
                    = modulationRouteScale (amount, polarityKind);
                voiceRouteBiasVectors.at (sourceIndex).at (targetIndex)
                    = modulationRouteBias (amount, polarityKind);
            }

            for (int32 cellIndex = 0; cellIndex < modulationMacroVoiceRouteCellCount; ++cellIndex)
                macroVoiceRouteAmounts.at (cellIndex) = upload.macroVoiceRouteAmounts.at (cellIndex);

            for (int32 routeIndex = 0; routeIndex < upload.macroVoiceRouteCount; ++routeIndex)
            {
                let cellIndex = upload.macroVoiceRouteCells.at (routeIndex);
                let sourceIndex = upload.macroVoiceRouteSources.at (routeIndex);
                let targetIndex = upload.macroVoiceRouteTargets.at (routeIndex);
                let polarityKind = upload.macroVoiceRoutePolarities.at (routeIndex);
                let amount = upload.macroVoiceRouteAmounts.at (cellIndex);
                macroVoiceRouteCells.at (routeIndex) = cellIndex;
                macroVoiceRouteSources.at (routeIndex) = sourceIndex;
                macroVoiceRouteTargets.at (routeIndex) = targetIndex;
                macroVoiceRoutePolarities.at (routeIndex) = polarityKind;
                macroVoiceRouteSourceUsed.at (sourceIndex) = true;
                macroVoiceRouteScaleVectors.at (sourceIndex).at (targetIndex)
                    = modulationRouteScale (amount, polarityKind);
                macroVoiceRouteBiasVectors.at (sourceIndex).at (targetIndex)
                    = modulationRouteBias (amount, polarityKind);
            }

            // Reconcile only the old and new sparse prefixes. A topology edit must
            // not scan the complete rack-routing domain on the audio thread.
            for (int32 routeIndex = 0; routeIndex < voiceRackRouteCount; ++routeIndex)
                voiceRackCellNextActive.at (voiceRackRouteCells.at (routeIndex)) = false;

            for (int32 routeIndex = 0; routeIndex < upload.voiceRackRouteCount; ++routeIndex)
            {
                let cellIndex = upload.voiceRackRouteCells.at (routeIndex);
                let sourceIndex = upload.voiceRackRouteSources.at (routeIndex);
                voiceRackSourceUsed.at (sourceIndex) = true;
                voiceRackCellNextActive.at (cellIndex) = true;
            }

            for (int32 routeIndex = 0; routeIndex < voiceRackRouteCount; ++routeIndex)
            {
                let cellIndex = voiceRackRouteCells.at (routeIndex);
                if (! voiceRackCellNextActive.at (cellIndex))
                {
                    voiceRackCellHeldSources.at (cellIndex) = 0.0f;
                    voiceRackCellGates.at (cellIndex) = 0.0f;
                    voiceRackCellActive.at (cellIndex) = false;
                }
            }

            for (int32 routeIndex = 0; routeIndex < upload.voiceRackRouteCount; ++routeIndex)
            {
                let cellIndex = upload.voiceRackRouteCells.at (routeIndex);
                voiceRackRouteCells.at (routeIndex) = cellIndex;
                voiceRackRouteSources.at (routeIndex) = upload.voiceRackRouteSources.at (routeIndex);
                voiceRackRouteTargets.at (routeIndex) = upload.voiceRackRouteTargets.at (routeIndex);
                voiceRackRoutePolarities.at (routeIndex) = upload.voiceRackRoutePolarities.at (routeIndex);
                voiceRackRouteReducers.at (routeIndex) = upload.voiceRackRouteReducers.at (routeIndex);
                voiceRackRouteAmounts.at (cellIndex) = upload.voiceRackRouteAmounts.at (cellIndex);

                if (! voiceRackCellActive.at (cellIndex))
                {
                    voiceRackCellHeldSources.at (cellIndex) = 0.0f;
                    voiceRackCellGates.at (cellIndex) = 0.0f;
                }
                voiceRackCellActive.at (cellIndex) = true;
            }

            for (int32 routeIndex = 0; routeIndex < upload.macroRackRouteCount; ++routeIndex)
            {
                let cellIndex = upload.macroRackRouteCells.at (routeIndex);
                let sourceIndex = upload.macroRackRouteSources.at (routeIndex);
                let targetIndex = upload.macroRackRouteTargets.at (routeIndex);
                let polarityKind = upload.macroRackRoutePolarities.at (routeIndex);
                let amount = upload.macroRackRouteAmounts.at (cellIndex);
                macroRackRouteCells.at (routeIndex) = cellIndex;
                macroRackRouteSources.at (routeIndex) = sourceIndex;
                macroRackRouteTargets.at (routeIndex) = targetIndex;
                macroRackRoutePolarities.at (routeIndex) = polarityKind;
                macroRackRouteAmounts.at (cellIndex) = amount;
                macroRackRouteSourceUsed.at (sourceIndex) = true;
                macroRackRouteScaleVectors.at (sourceIndex).at (targetIndex)
                    = modulationRouteScale (amount, polarityKind);
                macroRackRouteBiasVectors.at (sourceIndex).at (targetIndex)
                    = modulationRouteBias (amount, polarityKind);
            }

            voiceRouteCount = upload.voiceRouteCount;
            macroVoiceRouteCount = upload.macroVoiceRouteCount;
            voiceRackRouteCount = upload.voiceRackRouteCount;
            macroRackRouteCount = upload.macroRackRouteCount;
            acceptedModulationProgramSerial = upload.deliverySerial;
            completeModulationRuntimeInstall (upload.deliverySerial);
        }

        event modulationAmountIn (ModulationAmountUpload upload)
        {
            let installKind = beginModulationRuntimeInstall (upload.dspSessionId, upload.deliverySerial);
            if (installKind == 0)
                return;

            if (! isFiniteRuntimeValue (upload.amount))
            {
                rejectModulationProgram();
                rejectRuntimeInstall (upload.deliverySerial);
                return;
            }

            bool applied = false;
            if (upload.pathKind == modulationPathVoice
                && upload.cellIndex >= 0 && upload.cellIndex < modulationVoiceRouteCellCount)
            {
                for (int32 routeIndex = 0; routeIndex < voiceRouteCount; ++routeIndex)
                {
                    if (voiceRouteCells.at (routeIndex) == upload.cellIndex)
                    {
                        voiceRouteAmounts.at (upload.cellIndex) = upload.amount;
                        voiceRouteScales.at (routeIndex) = modulationRouteScale (
                            upload.amount,
                            voiceRoutePolarities.at (routeIndex)
                        );
                        voiceRouteBiases.at (routeIndex) = modulationRouteBias (
                            upload.amount,
                            voiceRoutePolarities.at (routeIndex)
                        );
                        let sourceIndex = voiceRouteSources.at (routeIndex);
                        let targetIndex = voiceRouteTargets.at (routeIndex);
                        voiceRouteScaleVectors.at (sourceIndex).at (targetIndex)
                            = voiceRouteScales.at (routeIndex);
                        voiceRouteBiasVectors.at (sourceIndex).at (targetIndex)
                            = voiceRouteBiases.at (routeIndex);
                        applied = true;
                        break;
                    }
                }
            }
            else if (upload.pathKind == modulationPathMacroVoice
                && upload.cellIndex >= 0 && upload.cellIndex < modulationMacroVoiceRouteCellCount)
            {
                for (int32 routeIndex = 0; routeIndex < macroVoiceRouteCount; ++routeIndex)
                {
                    if (macroVoiceRouteCells.at (routeIndex) == upload.cellIndex)
                    {
                        macroVoiceRouteAmounts.at (upload.cellIndex) = upload.amount;
                        let sourceIndex = macroVoiceRouteSources.at (routeIndex);
                        let targetIndex = macroVoiceRouteTargets.at (routeIndex);
                        let polarityKind = macroVoiceRoutePolarities.at (routeIndex);
                        macroVoiceRouteScaleVectors.at (sourceIndex).at (targetIndex)
                            = modulationRouteScale (upload.amount, polarityKind);
                        macroVoiceRouteBiasVectors.at (sourceIndex).at (targetIndex)
                            = modulationRouteBias (upload.amount, polarityKind);
                        applied = true;
                        break;
                    }
                }
            }
            else if (upload.pathKind == modulationPathVoiceRack
                && upload.cellIndex >= 0 && upload.cellIndex < modulationVoiceRackRouteCellCount)
            {
                for (int32 routeIndex = 0; routeIndex < voiceRackRouteCount; ++routeIndex)
                {
                    if (voiceRackRouteCells.at (routeIndex) == upload.cellIndex)
                    {
                        voiceRackRouteAmounts.at (upload.cellIndex) = upload.amount;
                        applied = true;
                        break;
                    }
                }
            }
            else if (upload.pathKind == modulationPathMacroRack
                && upload.cellIndex >= 0 && upload.cellIndex < modulationMacroRackRouteCellCount)
            {
                for (int32 routeIndex = 0; routeIndex < macroRackRouteCount; ++routeIndex)
                {
                    if (macroRackRouteCells.at (routeIndex) == upload.cellIndex)
                    {
                        macroRackRouteAmounts.at (upload.cellIndex) = upload.amount;
                        let sourceIndex = macroRackRouteSources.at (routeIndex);
                        let targetIndex = macroRackRouteTargets.at (routeIndex);
                        let polarityKind = macroRackRoutePolarities.at (routeIndex);
                        macroRackRouteScaleVectors.at (sourceIndex).at (targetIndex)
                            = modulationRouteScale (upload.amount, polarityKind);
                        macroRackRouteBiasVectors.at (sourceIndex).at (targetIndex)
                            = modulationRouteBias (upload.amount, polarityKind);
                        applied = true;
                        break;
                    }
                }
            }

            if (applied)
            {
                completeModulationRuntimeInstall (upload.deliverySerial);
            }
            else
            {
                rejectModulationProgram();
                rejectRuntimeInstall (upload.deliverySerial);
            }
        }

        event articulationSnapshotIn (ArticulationSnapshotUpload upload)
        {
            let installKind = beginArticulationRuntimeInstall (upload.dspSessionId, upload.deliverySerial);
            if (installKind == 0)
                return;

            if (upload.selectorA < 0 || upload.selectorA >= articulationSlotCount)
            {
                rejectRuntimeInstall (upload.deliverySerial);
                return;
            }

            if (! isValidArticulationSnapshot (upload))
            {
                rejectRuntimeInstall (upload.deliverySerial);
                return;
            }

            let selectorA = upload.selectorA;
            articulationSlotDefined.at (selectorA) = upload.enabled;

            if (! upload.enabled)
            {
                completeArticulationRuntimeInstall (upload.deliverySerial);
                return;
            }

            articulationFramePosition.at (selectorA) = std::intrinsics::clamp (upload.framePosition, 0.0f, 1.0f);
            articulationPan.at (selectorA) = clampPan (upload.pan);
            articulationUnisonVoices.at (selectorA) = resolveUnisonVoices (float32 (upload.unisonVoices));
            articulationUnisonDetune.at (selectorA) = clampUnison01 (upload.unisonDetune);
            articulationUnisonBlend.at (selectorA) = clampUnison01 (upload.unisonBlend);
            articulationUnisonWidth.at (selectorA) = clampUnison01 (upload.unisonWidth);
            articulationUnisonPhase.at (selectorA) = clampUnison01 (upload.unisonPhase);
            articulationUnisonRandom.at (selectorA) = clampUnison01 (upload.unisonRandom);
            articulationUnisonPhaseMode.at (selectorA) = resolveUnisonPhaseMode (float32 (upload.unisonPhaseMode));
            articulationUnisonDetuneMode.at (selectorA) = resolveUnisonDetuneMode (float32 (upload.unisonDetuneMode));
            articulationUnisonStackMode.at (selectorA) = resolveUnisonStackMode (float32 (upload.unisonStackMode));
            articulationUnisonWavetablePositionSpread.at (selectorA) = clampUnison01 (upload.unisonWavetablePositionSpread);
            articulationUnisonWarpSpread.at (selectorA) = clampUnison01 (upload.unisonWarpSpread);
            articulationWarpMode.at (selectorA) = resolveWarpMode (float32 (upload.warpMode));
            articulationWarpAmount.at (selectorA) = std::intrinsics::clamp (upload.warpAmount, 0.0f, 1.0f);
            articulationFilterMode.at (selectorA) = resolveFilterMode (float32 (upload.filterMode));
            articulationFilterCutoffHz.at (selectorA) = clampFilterCutoffHz (upload.filterCutoffHz, float32 (processor.frequency));
            articulationFilterQ.at (selectorA) = clampFilterQ (upload.filterQ);

            for (int32 slotIndex = 0; slotIndex < modulationMsegSlotCount; ++slotIndex)
                articulationMsegMorphs.at (articulationMsegIndex (selectorA, slotIndex)) = std::intrinsics::clamp (upload.msegMorphs.at (slotIndex), 0.0f, 1.0f);

            for (int32 routeIndex = 0; routeIndex < modulationArticulationRouteCellCount; ++routeIndex)
                articulationRouteAmounts.at (articulationRouteIndex (selectorA, routeIndex)) = upload.routeAmounts.at (routeIndex);

            for (int32 slotIndex = 0; slotIndex < modulationEnvSlotCount; ++slotIndex)
            {
                articulationEnvelopeAttackSeconds.at (articulationEnvelopeIndex (selectorA, slotIndex)) = std::intrinsics::max (0.001f, upload.envelopeAttackSeconds.at (slotIndex));
                articulationEnvelopeDecaySeconds.at (articulationEnvelopeIndex (selectorA, slotIndex)) = std::intrinsics::max (0.001f, upload.envelopeDecaySeconds.at (slotIndex));
                articulationEnvelopeSustain.at (articulationEnvelopeIndex (selectorA, slotIndex)) = std::intrinsics::clamp (upload.envelopeSustain.at (slotIndex), 0.0f, 1.0f);
                articulationEnvelopeReleaseSeconds.at (articulationEnvelopeIndex (selectorA, slotIndex)) = std::intrinsics::max (0.001f, upload.envelopeReleaseSeconds.at (slotIndex));
            }
            completeArticulationRuntimeInstall (upload.deliverySerial);
        }

        event modulationMsegBufferIn (ModulationMsegBufferUpload upload)
        {
            let installKind = beginModulationRuntimeInstall (upload.dspSessionId, upload.deliverySerial);
            if (installKind == 0)
                return;
            if (upload.slot < 1 || upload.slot > modulationMsegSlotCount
                || upload.shapeIndex < 0 || upload.shapeIndex > 1)
            {
                rejectRuntimeInstall (upload.deliverySerial);
                return;
            }
            uploadMsegBufferToSlot (upload.slot, upload.shapeIndex, upload.buffer);
            completeModulationRuntimeInstall (upload.deliverySerial);
        }

        event modulationMsegPlaybackIn (ModulationMsegPlaybackUpload upload)
        {
            let installKind = beginModulationRuntimeInstall (upload.dspSessionId, upload.deliverySerial);
            if (installKind == 0)
                return;
            if (upload.slot < 1 || upload.slot > modulationMsegSlotCount)
            {
                rejectRuntimeInstall (upload.deliverySerial);
                return;
            }
            wt::MsegPlaybackConfig config;
            config.seconds = upload.seconds;
            config.holdFinalValue = upload.holdFinalValue;
            config.rateKind = upload.rateKind;
            config.loopEnabled = upload.loopEnabled;
            config.loopStart = upload.loopStart;
            config.loopEnd = upload.loopEnd;
            config.noteOffPolicy = upload.noteOffPolicy;
            config.legatoRestarts = upload.legatoRestarts;
            uploadMsegPlaybackToSlot (upload.slot, config);
            completeModulationRuntimeInstall (upload.deliverySerial);
        }

        event modulationEnvelopeIn (ModulationEnvelopeUpload upload)
        {
            let installKind = beginModulationRuntimeInstall (upload.dspSessionId, upload.deliverySerial);
            if (installKind == 0)
                return;
            if (upload.slot < 1 || upload.slot > modulationEnvSlotCount)
            {
                rejectRuntimeInstall (upload.deliverySerial);
                return;
            }
            uploadEnvelopeToSlot (upload.slot, upload);
            completeModulationRuntimeInstall (upload.deliverySerial);
        }

        void beginWavetableLoad (int32 dspSessionId,
                                 int32 oscillatorIndex,
                                 int32 requestedGeneration,
                                 int32 requestedTableIndex,
                                 int32 requestedFrameCount)
        {
            let resolvedFrameCount = resolveUploadedFrameCount (requestedFrameCount);
            let oscillator = oscillatorIndex;

            if (dspSessionId != currentDspSessionId
                || oscillator < 0 || oscillator >= oscillatorCount
                || requestedGeneration <= 0
                || requestedGeneration < oscillatorGenerationFrontier.at (oscillator)
                || requestedTableIndex < 0
                || resolvedFrameCount == 0
                || resolvedFrameCount > wavetableFrameCapacity)
                return;

            let nextStagingSlot = findSparePackedSlot();

            if (nextStagingSlot < 0)
                return;

            let previousStagingOscillator = tableStagingOscillatorIndex;

            if (previousStagingOscillator == oscillatorA)
                discardLegacyAStagingTable();

            oscillatorGenerationFrontier.at (oscillator) = std::intrinsics::max (
                oscillatorGenerationFrontier.at (oscillator), requestedGeneration);
            tableStagingOscillatorIndex = oscillator;
            tableStagingSlotIndex = nextStagingSlot;
            tableStagingGeneration = requestedGeneration;
            tableStagingTableIndex = requestedTableIndex;
            tableStagingFrameCount = resolvedFrameCount;
            tableStagingLastFrameIndex = resolvedFrameCount - 1;
            tableStagingLastFrameIndexF = float32 (tableStagingLastFrameIndex);
            clearPackedSlotState (nextStagingSlot);
            clearOscillatorMipRequestState (oscillator);

            if (oscillator == oscillatorA)
            {
                generationFrontier = oscillatorGenerationFrontier.at (oscillatorA);
                stagingGeneration = requestedGeneration;
                stagingTableIndex = requestedTableIndex;
                stagingFrameCount = resolvedFrameCount;
                stagingLastFrameIndex = resolvedFrameCount - 1;
                stagingLastFrameIndexF = float32 (stagingLastFrameIndex);
                clearPendingTableState();
            }

            if (previousStagingOscillator >= 0 && previousStagingOscillator != oscillator)
                emitRuntimeServiceState (previousStagingOscillator);

            emitRuntimeServiceState (oscillator);
        }

        void receiveWavetableMipFrame (int32 dspSessionId,
                                       int32 oscillatorIndex,
                                       int32 uploadedGeneration,
                                       int32 uploadedTableIndex,
                                       int32 uploadedMipIndex,
                                       int32 uploadedFrameIndex,
                                       const float32[] samples)
        {
            let resolvedMipIndex = resolveMipIndex (uploadedMipIndex);

            if (resolvedMipIndex < 0 || tableStagingFrameCount <= 0)
                return;

            if (dspSessionId != currentDspSessionId
                || oscillatorIndex != tableStagingOscillatorIndex
                || uploadedGeneration != tableStagingGeneration
                || uploadedTableIndex != tableStagingTableIndex)
                return;

            if (uploadedFrameIndex < 0 || uploadedFrameIndex >= tableStagingFrameCount
                || ! hasValidWavetableSamples (samples))
                return;

            let readyIndex = packedReadinessIndex (
                tableStagingSlotIndex, resolvedMipIndex, uploadedFrameIndex);

            if (packedReadyFrameFlags.at (readyIndex) != 0)
            {
                emitUploadAck (
                    oscillatorIndex,
                    uploadedGeneration,
                    uploadedTableIndex,
                    resolvedMipIndex,
                    uploadedFrameIndex
                );
                return;
            }

            writePackedMipFrame (
                tableStagingSlotIndex, resolvedMipIndex, uploadedFrameIndex, samples);
            packedReadyFrameFlags.at (readyIndex) = 1;
            packedLoadedFrameCounts.at (packedSlotMipIndex (
                tableStagingSlotIndex, resolvedMipIndex)) += 1;

            if (oscillatorIndex == oscillatorA)
            {
                let legacyReadyIndex = bankedReadinessIndex (
                    stagingBankIndex, resolvedMipIndex, uploadedFrameIndex);
                writeMipFrame (
                    stagingBankIndex, resolvedMipIndex, uploadedFrameIndex, samples);
                readyFrameFlags.at (legacyReadyIndex) = 1;
                loadedFrameCounts.at (bankedMipLevelIndex (
                    stagingBankIndex, resolvedMipIndex)) += 1;
            }

            emitUploadAck (
                oscillatorIndex,
                uploadedGeneration,
                uploadedTableIndex,
                resolvedMipIndex,
                uploadedFrameIndex
            );

            if (isPackedStagingComplete())
            {
                if (tableStagingOscillatorIndex == oscillatorA
                    && ! isLegacyAStagingComplete())
                    return;

                commitPackedStagingTable();
            }
        }

        void abortWavetableLoad (int32 dspSessionId,
                                 int32 oscillatorIndex,
                                 int32 abortedGeneration,
                                 int32 abortedTableIndex)
        {
            if (dspSessionId != currentDspSessionId
                || oscillatorIndex != tableStagingOscillatorIndex
                || abortedGeneration != tableStagingGeneration
                || abortedTableIndex != tableStagingTableIndex)
                return;

            let abortedOscillator = tableStagingOscillatorIndex;

            if (abortedOscillator == oscillatorA)
                discardLegacyAStagingTable();

            clearTableStagingIdentity();
            emitRuntimeServiceState (abortedOscillator);
        }

        event wavetableLoadBeginIn (WavetableLoadBegin request)
        {
            beginWavetableLoad (request.dspSessionId, oscillatorA, request.generation,
                                request.tableIndex, request.frameCount);
        }

        event oscillatorWavetableLoadBeginIn (OscillatorWavetableLoadBegin request)
        {
            beginWavetableLoad (request.dspSessionId, request.oscillatorIndex,
                                request.generation, request.tableIndex, request.frameCount);
        }

        event wavetableMipFrameIn (WavetableMipFrame frame)
        {
            receiveWavetableMipFrame (frame.dspSessionId, oscillatorA, frame.generation,
                                      frame.tableIndex, frame.mipIndex, frame.frameIndex,
                                      frame.samples);
        }

        event oscillatorWavetableMipFrameIn (OscillatorWavetableMipFrame frame)
        {
            receiveWavetableMipFrame (frame.dspSessionId, frame.oscillatorIndex,
                                      frame.generation, frame.tableIndex, frame.mipIndex,
                                      frame.frameIndex, frame.samples);
        }

        event serviceLoadAbortIn (ServiceLoadAbort abort)
        {
            abortWavetableLoad (abort.dspSessionId, oscillatorA,
                                abort.generation, abort.tableIndex);
        }

        event oscillatorServiceLoadAbortIn (OscillatorServiceLoadAbort abort)
        {
            abortWavetableLoad (abort.dspSessionId, abort.oscillatorIndex,
                                abort.generation, abort.tableIndex);
        }

        void main()
        {
            previewFrequencyHzState = previewFrequencyHzState < 0.0f ? 0.0f : previewFrequencyHzState;
            glideTimeSecondsState = std::intrinsics::max (0.0f, glideTimeIn);
            updateUnisonInputState();
            for (wrap<oscillatorCount> oscillator)
                clearOscillatorMipRequestState (int32 (oscillator));
            initialiseWarpDecimatorTaps();
            resetAllWarpRenderState();

            let requestedInterval = int32 (
                std::intrinsics::floor ((processor.frequency / wt::effectiveWavetablePositionMonitorHz) + 0.5f)
            );
            monitorUpdateIntervalFrames = std::intrinsics::max (1, requestedInterval);
            framesUntilNextMonitorUpdate = 0;
            let requestedWarpInterval = int32 (
                std::intrinsics::floor ((processor.frequency / wt::effectiveWarpStateMonitorHz) + 0.5f)
            );
            warpMonitorUpdateIntervalFrames = std::intrinsics::max (1, requestedWarpInterval);
            framesUntilNextWarpMonitorUpdate = 0;
            let requestedUnisonInterval = int32 (
                std::intrinsics::floor ((processor.frequency / wt::effectiveUnisonStateMonitorHz) + 0.5f)
            );
            unisonMonitorUpdateIntervalFrames = std::intrinsics::max (1, requestedUnisonInterval);
            framesUntilNextUnisonMonitorUpdate = 0;
            let requestedFilterInterval = int32 (
                std::intrinsics::floor ((processor.frequency / wt::effectiveFilterStateMonitorHz) + 0.5f)
            );
            filterMonitorUpdateIntervalFrames = std::intrinsics::max (1, requestedFilterInterval);
            framesUntilNextFilterMonitorUpdate = 0;
            let requestedMsegInterval = int32 (
                std::intrinsics::floor ((processor.frequency / wt::effectiveMsegStateMonitorHz) + 0.5f)
            );
            msegMonitorUpdateIntervalFrames = std::intrinsics::max (1, requestedMsegInterval);
            framesUntilNextMsegMonitorUpdate = 0;
            rackModGateReleaseStepState = rackModGateReleaseStep (float32 (processor.frequency));
            rackModSmoothingCoefficientState = rackModOnePoleCoefficient (rackModSmoothingMs,
                                                                          float32 (processor.frequency));
            resetAllFilterState();
            for (wrap<voiceCount> voice)
                clearVoiceArticulation (int32 (voice));

            loop
            {
                glideTimeSecondsState = std::intrinsics::max (0.0f, glideTimeIn);
                updateUnisonInputState();

                if (! hasEmittedInitialRuntimeState)
                {
                    emitRuntimeServiceState (oscillatorA);
                    hasEmittedInitialRuntimeState = true;
                }

                maybeTransitionServiceToPlayable();

                float32 leftMix = 0.0f;
                float32 rightMix = 0.0f;
                float32 trackingPitchHz = 0.0f;
                int32 trackingSerial = -1;

                beginModulationFrame();

                for (wrap<voiceCount> voice)
                {
                    advanceVoicePitchState (int32 (voice));
                    mseg1[voice].advance();
                    mseg2[voice].advance();
                    mseg3[voice].advance();
                    modEnv1[voice].advance();
                    modEnv2[voice].advance();
                    modEnv3[voice].advance();
                    envelopes[voice].advance();
                    voiceMsegProgress1[voice] = mseg1[voice].progressOut;
                    voiceMsegProgress2[voice] = mseg2[voice].progressOut;
                    voiceMsegProgress3[voice] = mseg3[voice].progressOut;

                    let processorFrequency = float32 (processor.frequency);
                    let envelopeGain = envelopes[voice].gainOut;
                    if (! voiceIsSoundingForRackModulation (int32 (voice)))
                        continue;

                    accumulateVoiceModulationTargets (int32 (voice));
                    accumulateVoiceRackSources (int32 (voice));
                    let routePosition = voiceTargetOffset (int32 (voice), 0);
                    let routeWarpAmount = voiceTargetOffset (int32 (voice), 1);
                    let routeFilterCutoffOctaves = voiceTargetOffset (int32 (voice), 2);
                    let routeFilterQ = voiceTargetOffset (int32 (voice), 3);
                    let routePitchSemitones = voiceTargetOffset (int32 (voice), 4);
                    let routeAmpGainDb = voiceTargetOffset (int32 (voice), 5);
                    let routePan = voiceTargetOffset (int32 (voice), 6);
                    let routeUnisonDetune = voiceTargetOffset (int32 (voice), 7);
                    let routeUnisonBlend = voiceTargetOffset (int32 (voice), 8);
                    let routeUnisonWidth = voiceTargetOffset (int32 (voice), 9);
                    let routeUnisonWavetablePositionSpread = voiceTargetOffset (int32 (voice), 10);
                    let routeUnisonWarpSpread = voiceTargetOffset (int32 (voice), 11);

                    let baseFramePosition = voiceUsesArticulation.at (voice)
                        ? voiceArticulationFramePosition.at (voice)
                        : framePositionIn;
                    let baseWarpMode = voiceUsesArticulation.at (voice)
                        ? voiceArticulationWarpMode.at (voice)
                        : resolveWarpMode (warpModeIn);
                    let baseWarpAmount = voiceUsesArticulation.at (voice)
                        ? voiceArticulationWarpAmount.at (voice)
                        : warpAmountIn;
                    let baseFilterMode = voiceUsesArticulation.at (voice)
                        ? voiceArticulationFilterMode.at (voice)
                        : resolveFilterMode (filterModeIn);
                    let baseFilterCutoffHz = voiceUsesArticulation.at (voice)
                        ? voiceArticulationFilterCutoffHz.at (voice)
                        : clampFilterCutoffHz (filterCutoffIn, processorFrequency);
                    let baseFilterQ = voiceUsesArticulation.at (voice)
                        ? voiceArticulationFilterQ.at (voice)
                        : filterQIn;
                    let basePan = voiceUsesArticulation.at (voice)
                        ? voiceArticulationPan.at (voice)
                        : panIn;
                    let baseUnisonVoices = voiceUsesArticulation.at (voice)
                        ? voiceArticulationUnisonVoices.at (voice)
                        : unisonVoicesState;
                    let baseUnisonDetune = voiceUsesArticulation.at (voice)
                        ? voiceArticulationUnisonDetune.at (voice)
                        : unisonDetuneState;
                    let baseUnisonBlend = voiceUsesArticulation.at (voice)
                        ? voiceArticulationUnisonBlend.at (voice)
                        : unisonBlendState;
                    let baseUnisonWidth = voiceUsesArticulation.at (voice)
                        ? voiceArticulationUnisonWidth.at (voice)
                        : unisonWidthState;
                    let baseUnisonDetuneMode = voiceUsesArticulation.at (voice)
                        ? voiceArticulationUnisonDetuneMode.at (voice)
                        : unisonDetuneModeState;
                    let baseUnisonStackMode = voiceUsesArticulation.at (voice)
                        ? voiceArticulationUnisonStackMode.at (voice)
                        : unisonStackModeState;
                    let baseUnisonWavetablePositionSpread = voiceUsesArticulation.at (voice)
                        ? voiceArticulationUnisonWavetablePositionSpread.at (voice)
                        : unisonWavetablePositionSpreadState;
                    let baseUnisonWarpSpread = voiceUsesArticulation.at (voice)
                        ? voiceArticulationUnisonWarpSpread.at (voice)
                        : unisonWarpSpreadState;
                    let effectivePosition = std::intrinsics::clamp (
                        baseFramePosition + routePosition,
                        0.0f,
                        1.0f
                    );
                    let warpMode = baseWarpMode;
                    let effectiveWarpAmount = std::intrinsics::clamp (
                        baseWarpAmount + routeWarpAmount,
                        0.0f,
                        1.0f
                    );
                    let filterMode = baseFilterMode;
                    let effectiveFilterCutoffHz = clampFilterCutoffHz (
                        baseFilterCutoffHz * std::intrinsics::pow (2.0f, routeFilterCutoffOctaves),
                        processorFrequency
                    );
                    let effectiveFilterQ = clampFilterQ (baseFilterQ + routeFilterQ);
                    let effectivePan = clampPan (basePan + routePan);
                    let effectiveUnisonVoices = std::intrinsics::clamp (baseUnisonVoices, 1, maxUnisonVoiceCount);
                    let effectiveUnisonDetune = clampUnison01 (baseUnisonDetune + routeUnisonDetune);
                    let effectiveUnisonBlend = clampUnison01 (baseUnisonBlend + routeUnisonBlend);
                    let effectiveUnisonWidth = clampUnison01 (baseUnisonWidth + routeUnisonWidth);
                    let effectiveUnisonWavetablePositionSpread = clampUnison01 (
                        baseUnisonWavetablePositionSpread + routeUnisonWavetablePositionSpread
                    );
                    let effectiveUnisonWarpSpread = clampUnison01 (
                        baseUnisonWarpSpread + routeUnisonWarpSpread
                    );
                    let effectivePitchSemitones = voiceCurrentPitch.at (voice) + voiceBendSemitones.at (voice) + routePitchSemitones;
                    let effectiveFrequencyHz = std::notes::noteToFrequency (effectivePitchSemitones);
                    let voiceSerial = voiceTrackingSerial.at (voice);

                    if (voiceActive.at (voice) != 0 && voiceSerial > trackingSerial)
                    {
                        trackingSerial = voiceSerial;
                        trackingPitchHz = effectiveFrequencyHz;
                    }

                    let shouldRenderWarpBackground = warpMode > warpModeOff;
                    let shouldBypassWarpOutput = isIdentityWarp (warpMode, effectiveWarpAmount);
                    voiceEffectivePosition.at (voice) = effectivePosition;
                    voiceEffectiveWarpMode.at (voice) = warpMode;
                    voiceEffectiveWarpAmount.at (voice) = effectiveWarpAmount;
                    voiceEffectiveFilterMode.at (voice) = filterMode;
                    voiceEffectiveFilterCutoffHz.at (voice) = effectiveFilterCutoffHz;
                    voiceEffectiveFilterQ.at (voice) = effectiveFilterQ;
                    voiceEffectivePan.at (voice) = effectivePan;
                    voiceEffectiveUnisonVoices.at (voice) = effectiveUnisonVoices;
                    voiceEffectiveUnisonDetune.at (voice) = effectiveUnisonDetune;
                    voiceEffectiveUnisonBlend.at (voice) = effectiveUnisonBlend;
                    voiceEffectiveUnisonWidth.at (voice) = effectiveUnisonWidth;
                    voiceEffectiveUnisonDetuneMode.at (voice) = baseUnisonDetuneMode;
                    voiceEffectiveUnisonStackMode.at (voice) = baseUnisonStackMode;
                    voiceEffectiveUnisonWavetablePositionSpread.at (voice) = effectiveUnisonWavetablePositionSpread;
                    voiceEffectiveUnisonWarpSpread.at (voice) = effectiveUnisonWarpSpread;

                    if (envelopeGain <= 0.0f || effectiveFrequencyHz <= 0.0f)
                        continue;

                    if (effectiveUnisonVoices <= 1)
                    {
                        let oscillatorStateIndex = oscillatorVoiceIndex (
                            int32 (voice), oscillatorA);
                        phasors.at (oscillatorStateIndex).setFrequency (
                            processor.frequency, effectiveFrequencyHz);
                        let currentPhaseIncrement = effectiveFrequencyHz / float32 (processor.frequency);
                        let requestedMipIndex = selectMipIndexFromPhaseIncrement (currentPhaseIncrement);
                        let playableMipIndex = findPlayableMipIndex (requestedMipIndex);
                        int32 warpRequestedMipIndex = requestedMipIndex;
                        int32 warpPlayableMipIndex = playableMipIndex;

                        if (shouldRenderWarpBackground)
                        {
                            let warpPhaseIncrement = currentPhaseIncrement / float32 (warpOversampleFactor);
                            warpRequestedMipIndex = selectMipIndexFromPhaseIncrement (warpPhaseIncrement);
                            warpPlayableMipIndex = findPlayableMipIndex (warpRequestedMipIndex);
                        }

                        if (playableMipIndex < 0 && warpPlayableMipIndex < 0)
                            continue;

                        let phase = phasors.at (oscillatorStateIndex).next();
                        float32 sample = 0.0f;

                        if (playableMipIndex >= 0
                            && (! shouldRenderWarpBackground
                                || shouldBypassWarpOutput
                                || warpPlayableMipIndex < 0))
                            sample = readVoiceSampleForMip (playableMipIndex, effectivePosition, phase);

                        if (shouldRenderWarpBackground && warpPlayableMipIndex >= 0)
                        {
                            let warpedSample = renderWarpedVoiceSample (
                                int32 (voice),
                                oscillatorA,
                                warpPlayableMipIndex,
                                effectivePosition,
                                phase,
                                currentPhaseIncrement,
                                warpMode,
                                effectiveWarpAmount
                            );

                            if (! shouldBypassWarpOutput)
                                sample = warpedSample;
                        }

                        if (filterMode > filterModeOff)
                        {
                            filters.at (voice).setMode (resolveSimperFilterMode (filterMode));
                            filters.at (voice).setFrequency (
                                processor.frequency,
                                effectiveFilterCutoffHz,
                                effectiveFilterQ,
                                0.0f
                            );
                            sample = filters.at (voice).process (sample);
                        }
                        else
                        {
                            resetFilterState (int32 (voice));
                        }

                        let gainedSample = sample * envelopeGain * dbToGain (clampAmpGainDb (routeAmpGainDb));
                        leftMix += gainedSample * panLeftGain (effectivePan);
                        rightMix += gainedSample * panRightGain (effectivePan);
                    }
                    else
                    {
                        float32 unisonLeft = 0.0f;
                        float32 unisonRight = 0.0f;
                        float32 weightSum = 0.0f;
                        let detuneCents = effectiveUnisonDetune * 50.0f;

                        for (int32 subVoiceIndex = 0; subVoiceIndex < effectiveUnisonVoices; ++subVoiceIndex)
                        {
                            let spreadScalar = unisonSpreadScalar (subVoiceIndex, effectiveUnisonVoices, baseUnisonDetuneMode);
                            let stackSemitones = unisonStackSemitones (subVoiceIndex, effectiveUnisonVoices, baseUnisonStackMode);
                            let subPitchSemitones = effectivePitchSemitones + (spreadScalar * detuneCents * 0.01f) + stackSemitones;
                            let subFrequencyHz = std::notes::noteToFrequency (subPitchSemitones);

                            if (subFrequencyHz <= 0.0f)
                                continue;

                            let subPosition = std::intrinsics::clamp (
                                effectivePosition + (spreadScalar * effectiveUnisonWavetablePositionSpread * 0.5f),
                                0.0f,
                                1.0f
                            );
                            let subWarpAmount = std::intrinsics::clamp (
                                effectiveWarpAmount + (spreadScalar * effectiveUnisonWarpSpread * 0.5f),
                                0.0f,
                                1.0f
                            );
                            let shouldBypassSubWarpOutput = isIdentityWarp (warpMode, subWarpAmount);
                            let subPan = clampPan (effectivePan + (spreadScalar * effectiveUnisonWidth));
                            let subWeight = unisonSubVoiceWeight (subVoiceIndex, effectiveUnisonVoices, effectiveUnisonBlend);
                            let currentPhaseIncrement = subFrequencyHz / float32 (processor.frequency);
                            let requestedMipIndex = selectMipIndexFromPhaseIncrement (currentPhaseIncrement);
                            let playableMipIndex = findPlayableMipIndex (requestedMipIndex);
                            int32 warpRequestedMipIndex = requestedMipIndex;
                            int32 warpPlayableMipIndex = playableMipIndex;

                            if (shouldRenderWarpBackground)
                            {
                                let warpPhaseIncrement = currentPhaseIncrement / float32 (warpOversampleFactor);
                                warpRequestedMipIndex = selectMipIndexFromPhaseIncrement (warpPhaseIncrement);
                                warpPlayableMipIndex = findPlayableMipIndex (warpRequestedMipIndex);
                            }

                            if (playableMipIndex < 0 && warpPlayableMipIndex < 0)
                                continue;

                            let subStateIndex = oscillatorLaneIndex (
                                int32 (voice), oscillatorA, subVoiceIndex);
                            unisonPhasors.at (subStateIndex).setFrequency (processor.frequency, subFrequencyHz);
                            let phase = unisonPhasors.at (subStateIndex).next();
                            float32 sample = 0.0f;

                            if (playableMipIndex >= 0
                                && (! shouldRenderWarpBackground
                                    || shouldBypassSubWarpOutput
                                    || warpPlayableMipIndex < 0))
                                sample = readVoiceSampleForMip (playableMipIndex, subPosition, phase);

                            if (shouldRenderWarpBackground && warpPlayableMipIndex >= 0)
                            {
                                let warpedSample = renderWarpedUnisonSample (
                                    int32 (voice),
                                    oscillatorA,
                                    subVoiceIndex,
                                    warpPlayableMipIndex,
                                    subPosition,
                                    phase,
                                    currentPhaseIncrement,
                                    warpMode,
                                    subWarpAmount
                                );

                                if (! shouldBypassSubWarpOutput)
                                    sample = warpedSample;
                            }

                            unisonLeft += sample * subWeight * panLeftGain (subPan);
                            unisonRight += sample * subWeight * panRightGain (subPan);
                            weightSum += subWeight;
                        }

                        if (weightSum <= 0.0f)
                            continue;

                        unisonLeft /= weightSum;
                        unisonRight /= weightSum;

                        if (filterMode > filterModeOff)
                        {
                            unisonLeftFilters.at (voice).setMode (resolveSimperFilterMode (filterMode));
                            unisonLeftFilters.at (voice).setFrequency (
                                processor.frequency,
                                effectiveFilterCutoffHz,
                                effectiveFilterQ,
                                0.0f
                            );
                            unisonRightFilters.at (voice).setMode (resolveSimperFilterMode (filterMode));
                            unisonRightFilters.at (voice).setFrequency (
                                processor.frequency,
                                effectiveFilterCutoffHz,
                                effectiveFilterQ,
                                0.0f
                            );
                            unisonLeft = unisonLeftFilters.at (voice).process (unisonLeft);
                            unisonRight = unisonRightFilters.at (voice).process (unisonRight);
                        }
                        else
                        {
                            resetFilterState (int32 (voice));
                        }

                        let gain = envelopeGain * dbToGain (clampAmpGainDb (routeAmpGainDb));
                        leftMix += unisonLeft * gain;
                        rightMix += unisonRight * gain;
                    }
                }

                updateRackModulationOutputs();

                out <- float32<2> (leftMix, rightMix);
                trackingPitchHzOut <- trackingPitchHz;
                maybeEmitMonitorUpdate();
                advance();
            }
        }
    }
}
