        float32[voiceCount] voiceEffectivePan;
        int32[voiceCount] voiceEffectiveUnisonVoices;
        float32[voiceCount] voiceEffectiveUnisonDetune;
        float32[voiceCount] voiceEffectiveUnisonBlend;
