        float32[voiceCount * modulationMsegSlotCount] voiceEffectiveMsegRates;
        float32[voiceCount * modulationEnvSlotCount] voiceEffectiveEnvelopeAttackSeconds;
        float32[voiceCount * modulationEnvSlotCount] voiceEffectiveEnvelopeDecaySeconds;
        float32[voiceCount * modulationEnvSlotCount] voiceEffectiveEnvelopeSustain;
        float32[voiceCount * modulationEnvSlotCount] voiceEffectiveEnvelopeReleaseSeconds;
        float32[voiceCount] voiceEffectiveAmpAttackSeconds;
        float32[voiceCount] voiceEffectiveAmpDecaySeconds;
        float32[voiceCount] voiceEffectiveAmpSustain;
        float32[voiceCount] voiceEffectiveAmpReleaseSeconds;
        float32[voiceCount] voiceMsegProgress2;
        float32[voiceCount] voiceMsegProgress3;
        bool[articulationSlotCount] articulationSlotDefined;
        int32[articulationSlotCount * oscillatorCount] articulationOscillatorOverrideMasks;
        int32[articulationSlotCount] articulationSharedOverrideMasks;
        float32[articulationSlotCount * oscillatorCount] articulationFramePositions;
        float32[articulationSlotCount * oscillatorCount] articulationPans;
        float32[articulationSlotCount * oscillatorCount] articulationOctaves;
        float32[articulationSlotCount * oscillatorCount] articulationSemitones;
