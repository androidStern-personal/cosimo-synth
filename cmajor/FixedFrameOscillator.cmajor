        float32[articulationSlotCount * modulationEnvSlotCount] articulationEnvelopeAttackSeconds;
        float32[articulationSlotCount * modulationEnvSlotCount] articulationEnvelopeDecaySeconds;
        float32[articulationSlotCount * modulationEnvSlotCount] articulationEnvelopeSustain;
        float32[articulationSlotCount * modulationEnvSlotCount] articulationEnvelopeReleaseSeconds;
        bool[voiceCount] voiceUsesArticulation;
        int32[voiceCount] voiceSelectorA;
        int32[voiceCount] voiceSelectorB;
        int32[voiceCount] voiceArticulationDurationSamples;
        int32[voiceCount] voiceArticulationAgeSamples;
        float32[voiceCount] voiceArticulationFramePosition;
        float32[voiceCount] voiceArticulationPan;
        int32[voiceCount] voiceArticulationUnisonVoices;
        float32[voiceCount] voiceArticulationUnisonDetune;
        float32[voiceCount] voiceArticulationUnisonBlend;
        float32[voiceCount] voiceArticulationUnisonWidth;
        float32[voiceCount] voiceArticulationUnisonPhase;
        float32[voiceCount] voiceArticulationUnisonRandom;
        int32[voiceCount] voiceArticulationUnisonPhaseMode;
        int32[voiceCount] voiceArticulationUnisonDetuneMode;
        int32[voiceCount] voiceArticulationUnisonStackMode;
        float32[voiceCount] voiceArticulationUnisonWavetablePositionSpread;
        float32[voiceCount] voiceArticulationUnisonWarpSpread;
        int32[voiceCount] voiceArticulationWarpMode;
        float32[voiceCount] voiceArticulationWarpAmount;
        int32[voiceCount] voiceArticulationFilterMode;
        float32[voiceCount] voiceArticulationFilterCutoffHz;
        float32[voiceCount] voiceArticulationFilterQ;
        float32[voiceCount * modulationMsegSlotCount] voiceArticulationMsegMorphs;
        float32[voiceCount * modulationArticulationRouteCellCount] voiceArticulationRouteAmounts;
        float32[voiceCount * modulationEnvSlotCount] voiceArticulationEnvelopeAttackSeconds;
        float32[voiceCount * modulationEnvSlotCount] voiceArticulationEnvelopeDecaySeconds;
        float32[voiceCount * modulationEnvSlotCount] voiceArticulationEnvelopeSustain;
        float32[voiceCount * modulationEnvSlotCount] voiceArticulationEnvelopeReleaseSeconds;
        float32[warpDecimatorTapCount] warpDecimatorTapsState;
        float32[voiceCount * oscillatorCount * warpDecimatorTapCount] voiceWarpHistory;
        int32[voiceCount * oscillatorCount] voiceWarpHistoryWriteIndex;
        float32[voiceCount * oscillatorCount * maxUnisonVoiceCount * warpDecimatorTapCount] unisonWarpHistory;
        int32[voiceCount * oscillatorCount * maxUnisonVoiceCount] unisonWarpHistoryWriteIndex;
        int32 voiceRouteCount;
        int32[modulationVoiceRouteCellCount] voiceRouteCells;
        int32[modulationVoiceRouteCellCount] voiceRouteSources;
        int32[modulationVoiceRouteCellCount] voiceRouteTargets;
        int32[modulationVoiceRouteCellCount] voiceRoutePolarities;
        float32[modulationVoiceRouteCellCount] voiceRouteAmounts;
        float32[modulationVoiceRouteCellCount] voiceRouteScales;
        float32[modulationVoiceRouteCellCount] voiceRouteBiases;
        bool[modulationVoiceSourceCount] voiceRouteSourceUsed;
        float32<modulationVoiceTargetCount>[modulationVoiceSourceCount] voiceRouteScaleVectors;
        float32<modulationVoiceTargetCount>[modulationVoiceSourceCount] voiceRouteBiasVectors;
        int32 macroVoiceRouteCount;
        int32[modulationMacroVoiceRouteCellCount] macroVoiceRouteCells;
        int32[modulationMacroVoiceRouteCellCount] macroVoiceRouteSources;
        int32[modulationMacroVoiceRouteCellCount] macroVoiceRouteTargets;
        int32[modulationMacroVoiceRouteCellCount] macroVoiceRoutePolarities;
        float32[modulationMacroVoiceRouteCellCount] macroVoiceRouteAmounts;
        bool[modulationMacroSourceCount] macroVoiceRouteSourceUsed;
        float32<modulationVoiceTargetCount>[modulationMacroSourceCount] macroVoiceRouteScaleVectors;
        float32<modulationVoiceTargetCount>[modulationMacroSourceCount] macroVoiceRouteBiasVectors;
        int32 voiceRackRouteCount;
        int32[modulationVoiceRackRouteCellCount] voiceRackRouteCells;
        int32[modulationVoiceRackRouteCellCount] voiceRackRouteSources;
        int32[modulationVoiceRackRouteCellCount] voiceRackRouteTargets;
        int32[modulationVoiceRackRouteCellCount] voiceRackRoutePolarities;
        int32[modulationVoiceRackRouteCellCount] voiceRackRouteReducers;
        float32[modulationVoiceRackRouteCellCount] voiceRackRouteAmounts;
        int32 macroRackRouteCount;
        int32[modulationMacroRackRouteCellCount] macroRackRouteCells;
        int32[modulationMacroRackRouteCellCount] macroRackRouteSources;
        int32[modulationMacroRackRouteCellCount] macroRackRouteTargets;
        int32[modulationMacroRackRouteCellCount] macroRackRoutePolarities;
        float32[modulationMacroRackRouteCellCount] macroRackRouteAmounts;
        bool[modulationMacroSourceCount] macroRackRouteSourceUsed;
        float32<rackModTargetCount>[modulationMacroSourceCount] macroRackRouteScaleVectors;
        float32<rackModTargetCount>[modulationMacroSourceCount] macroRackRouteBiasVectors;
        bool[modulationVoiceSourceCount] voiceRackSourceUsed;
        VoiceModulationTargets[voiceCount] voiceTargetOffsets;
        float32[modulationMacroSourceCount] macroSourceValues;
        float32<modulationVoiceTargetCount> macroVoiceBaseTargetOffsets;
        float32<rackModTargetCount> macroRackBaseTargetOffsets;
        float32[modulationVoiceSourceCount] voiceRackSourceSums;
        float32[modulationVoiceSourceCount] voiceRackSourceMaxima;
        float32[modulationVoiceSourceCount] voiceRackSourceBipolarStrongest;
        float32[modulationVoiceSourceCount] voiceRackSourceBipolarMagnitudes;
        int32 voiceRackParticipantCount;
        float32 voiceRackParticipantReciprocal;
        bool[modulationVoiceRackRouteCellCount] voiceRackCellActive;
        bool[modulationVoiceRackRouteCellCount] voiceRackCellNextActive;
        float32[modulationVoiceRackRouteCellCount] voiceRackCellHeldSources;
        float32[modulationVoiceRackRouteCellCount] voiceRackCellGates;
        float32[rackModTargetCount] rackModAccumulator;
        float32[rackModTargetCount] rackModSmoothed;
        float32 rackModGateReleaseStepState;
        float32 rackModSmoothingCoefficientState;
        int32 rejectedModulationRouteCount;
        int32 acceptedModulationSerial;
        int32 acceptedModulationProgramSerial;
        int32 acceptedArticulationSerial;

        // Active slots are immutable while visible. Uploads write into the one
        // spare slot and publish only after every mip/frame has arrived.
        static_assert (wavetableFrameCapacity > 0 && wavetableFrameCapacity <= maxFramesPerTable);
        static_assert (voiceCount > 0 && voiceCount <= 16);
        let packedWavetableSlotSampleCount = packedWavetableSamplesPerFrameSet * wavetableFrameCapacity;
        let packedWavetableChunkSampleCount = (packedWavetableSlotSampleCount + packedWavetableChunkCount - 1)
                                              / packedWavetableChunkCount;
        int32[packedWavetableChunkSampleCount] packedSlot0Chunk0;
        int32[packedWavetableChunkSampleCount] packedSlot0Chunk1;
        int32[packedWavetableChunkSampleCount] packedSlot0Chunk2;
        int32[packedWavetableChunkSampleCount] packedSlot0Chunk3;
        int32[packedWavetableChunkSampleCount] packedSlot1Chunk0;
        int32[packedWavetableChunkSampleCount] packedSlot1Chunk1;
        int32[packedWavetableChunkSampleCount] packedSlot1Chunk2;
        int32[packedWavetableChunkSampleCount] packedSlot1Chunk3;
        int32[packedWavetableChunkSampleCount] packedSlot2Chunk0;
        int32[packedWavetableChunkSampleCount] packedSlot2Chunk1;
        int32[packedWavetableChunkSampleCount] packedSlot2Chunk2;
        int32[packedWavetableChunkSampleCount] packedSlot2Chunk3;
        int32[packedWavetableChunkSampleCount] packedSlot3Chunk0;
        int32[packedWavetableChunkSampleCount] packedSlot3Chunk1;
        int32[packedWavetableChunkSampleCount] packedSlot3Chunk2;
        int32[packedWavetableChunkSampleCount] packedSlot3Chunk3;
        int32[wavetableSlotCount * mipLevelCount * wavetableFrameCapacity] packedReadyFrameFlags;
        int32[wavetableSlotCount * mipLevelCount] packedLoadedFrameCounts;
        int32[oscillatorCount * mipLevelCount] oscillatorRequestedGenerationByMip;
        int32[oscillatorCount * mipLevelCount] oscillatorRequestedUrgencyByMip;
        int32[oscillatorCount] oscillatorGenerationFrontier;
        int32[oscillatorCount] oscillatorCurrentGeneration;
        int32[oscillatorCount] oscillatorCurrentTableIndex;
        int32[oscillatorCount] oscillatorFrameCount;
        int32[oscillatorCount] oscillatorLastFrameIndex;
        float32[oscillatorCount] oscillatorLastFrameIndexF;
        int32[oscillatorCount] oscillatorActiveSlot = makeInactiveOscillatorSlots();
        int32 tableStagingOscillatorIndex = -1;
        int32 tableStagingSlotIndex = -1;
        int32 tableStagingGeneration = 0;
        int32 tableStagingTableIndex = 0;
        int32 tableStagingFrameCount = 0;
        int32 tableStagingLastFrameIndex = 0;
        float32 tableStagingLastFrameIndexF = 0.0f;

        // Temporary integration state: oscillator A keeps the established
        // exact-float double bank until CORE-03 can pass the frozen A oracle
        // through the external renderer. Its upload is also mirrored into the
        // packed ownership pool. This duplication is not a product memory or
        // performance budget; CORE-03 must remove or explicitly justify it.
        float32[maxMipSampleCount] mip0Bank0Samples;
        float32[maxMipSampleCount] mip0Bank1Samples;
        float32[maxMipSampleCount] mip1Bank0Samples;
        float32[maxMipSampleCount] mip1Bank1Samples;
        float32[maxMipSampleCount] mip2Bank0Samples;
        float32[maxMipSampleCount] mip2Bank1Samples;
        float32[maxMipSampleCount] mip3Bank0Samples;
        float32[maxMipSampleCount] mip3Bank1Samples;
        float32[maxMipSampleCount] mip4Bank0Samples;
        float32[maxMipSampleCount] mip4Bank1Samples;
        float32[maxMipSampleCount] mip5Bank0Samples;
        float32[maxMipSampleCount] mip5Bank1Samples;
        float32[maxMipSampleCount] mip6Bank0Samples;
        float32[maxMipSampleCount] mip6Bank1Samples;
        float32[maxMipSampleCount] mip7Bank0Samples;
        float32[maxMipSampleCount] mip7Bank1Samples;
        float32[maxMipSampleCount] mip8Bank0Samples;
        float32[maxMipSampleCount] mip8Bank1Samples;
        float32[maxMipSampleCount] mip9Bank0Samples;
        float32[maxMipSampleCount] mip9Bank1Samples;
        float32[maxMipSampleCount] mip10Bank0Samples;
        float32[maxMipSampleCount] mip10Bank1Samples;
        int32[maxBankedMipFrameSlots] readyFrameFlags;
        int32[maxBankedMipLevelSlots] loadedFrameCounts;
        int32[mipLevelCount] requestedGenerationByMip;
        int32[mipLevelCount] requestedUrgencyByMip;

        int32 currentDspSessionId = int32 (processor.session);
        int32 currentGeneration = 0;
        int32 currentTableIndex = 0;
        int32 generationFrontier = 0;
        int32 frameCount = 0;
        int32 lastFrameIndex = 0;
        float32 lastFrameIndexF = 0.0f;
        int32 activeBankIndex = 0;
        int32 stagingBankIndex = 1;
        int32 stagingGeneration = 0;
        int32 stagingTableIndex = 0;
        int32 stagingFrameCount = 0;
        int32 stagingLastFrameIndex = 0;
        float32 stagingLastFrameIndexF = 0.0f;
        int32 isPlayable = 0;
        bool hasEmittedInitialRuntimeState = false;

        int32 nextVoiceGeneration = 1;
        int32 nextVoiceTrackingSerial = 1;
        int32 monitorUpdateIntervalFrames = 1;
        int32 framesUntilNextMonitorUpdate = 0;
        int32 warpMonitorUpdateIntervalFrames = 1;
        int32 framesUntilNextWarpMonitorUpdate = 0;
        int32 unisonMonitorUpdateIntervalFrames = 1;
        int32 framesUntilNextUnisonMonitorUpdate = 0;
        int32 filterMonitorUpdateIntervalFrames = 1;
        int32 framesUntilNextFilterMonitorUpdate = 0;
        int32 msegMonitorUpdateIntervalFrames = 1;
        int32 framesUntilNextMsegMonitorUpdate = 0;
        float32 previewFrequencyHzState = previewFrequencyHz;
        float32 glideTimeSecondsState = 0.0f;
        int32 unisonVoicesState = 1;
        float32 unisonDetuneState = 0.10f;
        float32 unisonBlendState = 0.75f;
        float32 unisonWidthState = 1.0f;
        float32 unisonPhaseState = 0.0f;
        float32 unisonRandomState = 0.0f;
        int32 unisonPhaseModeState = unisonPhaseModeContiguous;
        int32 unisonDetuneModeState = unisonDetuneModeLinear;
        int32 unisonStackModeState = unisonStackModeOff;
        float32 unisonWavetablePositionSpreadState = 0.0f;
        float32 unisonWarpSpreadState = 0.0f;

        void updateUnisonInputState()
        {
            unisonVoicesState = resolveUnisonVoices (unisonVoicesIn);
            unisonDetuneState = clampUnison01 (unisonDetuneIn);
            unisonBlendState = clampUnison01 (unisonBlendIn);
            unisonWidthState = clampUnison01 (unisonWidthIn);
            unisonPhaseState = clampUnison01 (unisonPhaseIn);
            unisonRandomState = clampUnison01 (unisonRandomIn);
            unisonPhaseModeState = resolveUnisonPhaseMode (unisonPhaseModeIn);
            unisonDetuneModeState = resolveUnisonDetuneMode (unisonDetuneModeIn);
            unisonStackModeState = resolveUnisonStackMode (unisonStackModeIn);
            unisonWavetablePositionSpreadState = clampUnison01 (unisonWavetablePositionSpreadIn);
            unisonWarpSpreadState = clampUnison01 (unisonWarpSpreadIn);
        }

        int32 oscillatorMipIndex (int32 oscillatorIndex, int32 mipIndex)
        {
            return (oscillatorIndex * mipLevelCount) + mipIndex;
        }

        int32 packedSlotMipIndex (int32 slotIndex, int32 mipIndex)
        {
            return (slotIndex * mipLevelCount) + mipIndex;
        }

        int32 packedReadinessIndex (int32 slotIndex, int32 mipIndex, int32 uploadedFrameIndex)
        {
            return (slotIndex * mipLevelCount * wavetableFrameCapacity)
                 + (mipIndex * wavetableFrameCapacity) + uploadedFrameIndex;
        }

        int32 packedMipLength (int32 mipIndex)
        {
            let harmonicLength = (1 << std::intrinsics::clamp (mipIndex, 0, mipLevelCount - 1)) * 32;
            return std::intrinsics::min (
                samplesPerFrame, std::intrinsics::max (256, harmonicLength));
        }

        int32 packedMipOffset (int32 mipIndex)
        {
            int32 offset = 0;

            for (int32 previousMip = 0; previousMip < mipIndex; ++previousMip)
                offset += (packedMipLength (previousMip) + 1) * wavetableFrameCapacity;

            return offset;
        }

        int32 packedFrameBase (int32 mipIndex, int32 uploadedFrameIndex)
        {
            return packedMipOffset (mipIndex)
                 + uploadedFrameIndex * (packedMipLength (mipIndex) + 1);
        }

        int32 quantisePackedSourceValue (float32 value, float32 inverseScale, int32 maximum)
        {
            let scaled = value * inverseScale;
            return std::intrinsics::clamp (
                int32 (scaled + (scaled >= 0.0f ? 0.5f : -0.5f)), -maximum, maximum);
        }

        int32 packSourcePoint (float32 value, float32 derivative)
        {
            let valueBits = quantisePackedSourceValue (
                value, float32 (packedSourceValueMaximum) / 1.5f, packedSourceValueMaximum)
                & 0x3ffff;
            let derivativeBits = quantisePackedSourceValue (
                derivative, float32 (packedSourceDerivativeMaximum) / 0.5f,
                packedSourceDerivativeMaximum);
            return valueBits | (derivativeBits << packedSourceValueBits);
        }

        void writePackedPoolPoint (int32 slotIndex, int32 pointIndex, int32 packedPoint)
        {
            let chunkIndex = pointIndex / packedWavetableChunkSampleCount;
            let indexWithinChunk = pointIndex % packedWavetableChunkSampleCount;

            if (slotIndex == 0)
            {
                if (chunkIndex == 0) packedSlot0Chunk0.at (indexWithinChunk) = packedPoint;
                else if (chunkIndex == 1) packedSlot0Chunk1.at (indexWithinChunk) = packedPoint;
                else if (chunkIndex == 2) packedSlot0Chunk2.at (indexWithinChunk) = packedPoint;
                else packedSlot0Chunk3.at (indexWithinChunk) = packedPoint;
            }
            else if (slotIndex == 1)
            {
                if (chunkIndex == 0) packedSlot1Chunk0.at (indexWithinChunk) = packedPoint;
                else if (chunkIndex == 1) packedSlot1Chunk1.at (indexWithinChunk) = packedPoint;
                else if (chunkIndex == 2) packedSlot1Chunk2.at (indexWithinChunk) = packedPoint;
                else packedSlot1Chunk3.at (indexWithinChunk) = packedPoint;
            }
            else if (slotIndex == 2)
            {
                if (chunkIndex == 0) packedSlot2Chunk0.at (indexWithinChunk) = packedPoint;
                else if (chunkIndex == 1) packedSlot2Chunk1.at (indexWithinChunk) = packedPoint;
                else if (chunkIndex == 2) packedSlot2Chunk2.at (indexWithinChunk) = packedPoint;
                else packedSlot2Chunk3.at (indexWithinChunk) = packedPoint;
            }
            else
            {
                if (chunkIndex == 0) packedSlot3Chunk0.at (indexWithinChunk) = packedPoint;
                else if (chunkIndex == 1) packedSlot3Chunk1.at (indexWithinChunk) = packedPoint;
                else if (chunkIndex == 2) packedSlot3Chunk2.at (indexWithinChunk) = packedPoint;
                else packedSlot3Chunk3.at (indexWithinChunk) = packedPoint;
            }
        }

        bool hasValidWavetableSamples (const float32[] sourceSamples)
        {
            for (int32 sampleIndex = 0; sampleIndex < samplesPerFrame; ++sampleIndex)
                if (! isFiniteRuntimeValue (sourceSamples.at (sampleIndex)))
                    return false;

            return true;
        }

        void writePackedMipFrame (int32 slotIndex,
                                  int32 mipIndex,
                                  int32 uploadedFrameIndex,
                                  const float32[] sourceSamples)
        {
            let length = packedMipLength (mipIndex);
            let sourceStep = samplesPerFrame / length;
            let destinationBase = packedFrameBase (mipIndex, uploadedFrameIndex);

            for (int32 pointIndex = 0; pointIndex <= length; ++pointIndex)
            {
                let wrappedPoint = pointIndex == length ? 0 : pointIndex;
                let sourceIndex = wrappedPoint * sourceStep;
                let previousIndex = sourceIndex - sourceStep < 0
                    ? sourceIndex - sourceStep + samplesPerFrame
                    : sourceIndex - sourceStep;
                let nextIndex = sourceIndex + sourceStep >= samplesPerFrame
                    ? sourceIndex + sourceStep - samplesPerFrame
                    : sourceIndex + sourceStep;
                let value = sourceSamples.at (sourceIndex);
                let derivative = 0.5f * (sourceSamples.at (nextIndex) - sourceSamples.at (previousIndex));
                writePackedPoolPoint (
                    slotIndex, destinationBase + pointIndex, packSourcePoint (value, derivative));
            }
        }

        void clearPackedSlotState (int32 slotIndex)
        {
            for (int32 index = 0; index < mipLevelCount * wavetableFrameCapacity; ++index)
                packedReadyFrameFlags.at (
                    (slotIndex * mipLevelCount * wavetableFrameCapacity) + index) = 0;

            for (int32 mipIndex = 0; mipIndex < mipLevelCount; ++mipIndex)
                packedLoadedFrameCounts.at (packedSlotMipIndex (slotIndex, mipIndex)) = 0;
        }

        void clearOscillatorMipRequestState (int32 oscillatorIndex)
        {
            for (int32 mipIndex = 0; mipIndex < mipLevelCount; ++mipIndex)
            {
                let requestIndex = oscillatorMipIndex (oscillatorIndex, mipIndex);
                oscillatorRequestedGenerationByMip.at (requestIndex) = 0;
                oscillatorRequestedUrgencyByMip.at (requestIndex) = -1;
            }
        }

        int32 findSparePackedSlot()
        {
            for (int32 slotIndex = 0; slotIndex < wavetableSlotCount; ++slotIndex)
            {
                bool active = false;

                for (wrap<oscillatorCount> oscillator)
                    if (oscillatorActiveSlot.at (oscillator) == slotIndex)
                        active = true;

                if (! active)
                    return slotIndex;
            }

            return -1;
        }

        bool isPackedStagingComplete()
        {
            if (tableStagingOscillatorIndex < 0 || tableStagingSlotIndex < 0
                || tableStagingGeneration <= 0 || tableStagingFrameCount <= 0)
                return false;

            for (int32 mipIndex = 0; mipIndex < mipLevelCount; ++mipIndex)
                if (packedLoadedFrameCounts.at (packedSlotMipIndex (
                        tableStagingSlotIndex, mipIndex)) < tableStagingFrameCount)
                    return false;

            return true;
        }

        void clearTableBankState (int32 bankIndex)
        {
            for (int32 index = 0; index < maxMipFrameSlots; ++index)
                readyFrameFlags.at ((normalizeTableBankIndex (bankIndex) * maxMipFrameSlots) + index) = 0;

            for (int32 mipIndex = 0; mipIndex < mipLevelCount; ++mipIndex)
                loadedFrameCounts.at (bankedMipLevelIndex (bankIndex, mipIndex)) = 0;
        }

        void clearPendingTableState()
        {
            clearTableBankState (stagingBankIndex);

            for (int32 mipIndex = 0; mipIndex < mipLevelCount; ++mipIndex)
            {
                requestedGenerationByMip.at (mipIndex) = 0;
                requestedUrgencyByMip.at (mipIndex) = -1;
            }
        }

        int32 oscillatorVoiceIndex (int32 voiceIndex, int32 oscillatorIndex)
        {
            return (int32 (wrap<voiceCount> (voiceIndex)) * oscillatorCount)
                 + int32 (wrap<oscillatorCount> (oscillatorIndex));
        }

        int32 oscillatorLaneIndex (int32 voiceIndex, int32 oscillatorIndex, int32 subVoiceIndex)
        {
            return (oscillatorVoiceIndex (voiceIndex, oscillatorIndex) * maxUnisonVoiceCount)
                 + int32 (wrap<maxUnisonVoiceCount> (subVoiceIndex));
        }

        int32 warpHistoryIndex (int32 voiceIndex, int32 oscillatorIndex, int32 tapIndex)
        {
            return (oscillatorVoiceIndex (voiceIndex, oscillatorIndex) * warpDecimatorTapCount) + tapIndex;
        }

        int32 unisonWarpHistoryIndex (int32 voiceIndex,
                                      int32 oscillatorIndex,
                                      int32 subVoiceIndex,
                                      int32 tapIndex)
        {
            return (oscillatorLaneIndex (voiceIndex, oscillatorIndex, subVoiceIndex)
                    * warpDecimatorTapCount) + tapIndex;
        }

        int32 resolveUnisonVoices (float32 rawVoices)
        {
            return std::intrinsics::clamp (
                int32 (std::intrinsics::floor (rawVoices + 0.5f)),
                1,
                maxUnisonVoiceCount
            );
        }

        int32 resolveUnisonPhaseMode (float32 rawMode)
        {
            return std::intrinsics::clamp (
                int32 (std::intrinsics::floor (rawMode + 0.5f)),
                unisonPhaseModeContiguous,
                unisonPhaseModeReset
            );
        }

        int32 resolveUnisonDetuneMode (float32 rawMode)
        {
            return std::intrinsics::clamp (
                int32 (std::intrinsics::floor (rawMode + 0.5f)),
                unisonDetuneModeLinear,
                unisonDetuneModeRandom
            );
        }

        int32 resolveUnisonStackMode (float32 rawMode)
        {
            return std::intrinsics::clamp (
                int32 (std::intrinsics::floor (rawMode + 0.5f)),
                unisonStackModeOff,
                unisonStackModeCenterTwoOctaves
            );
        }

        float32 clampUnison01 (float32 value)
        {
            return std::intrinsics::clamp (value, 0.0f, 1.0f);
        }

        void resetOscillatorWarpRenderState (int32 voiceIndex, int32 oscillatorIndex)
        {
            let resolvedVoice = int32 (wrap<voiceCount> (voiceIndex));
            let resolvedOscillator = int32 (wrap<oscillatorCount> (oscillatorIndex));

            for (int32 tapIndex = 0; tapIndex < warpDecimatorTapCount; ++tapIndex)
                voiceWarpHistory.at (
                    warpHistoryIndex (resolvedVoice, resolvedOscillator, tapIndex)) = 0.0f;

            voiceWarpHistoryWriteIndex.at (
                oscillatorVoiceIndex (resolvedVoice, resolvedOscillator)) = 0;
        }

        void resetOscillatorUnisonWarpRenderState (int32 voiceIndex,
                                                    int32 oscillatorIndex,
                                                    int32 subVoiceIndex)
        {
            let resolvedVoice = int32 (wrap<voiceCount> (voiceIndex));
            let resolvedOscillator = int32 (wrap<oscillatorCount> (oscillatorIndex));
            let resolvedSubVoice = int32 (wrap<maxUnisonVoiceCount> (subVoiceIndex));
            let stateIndex = oscillatorLaneIndex (
                resolvedVoice, resolvedOscillator, resolvedSubVoice);

            for (int32 tapIndex = 0; tapIndex < warpDecimatorTapCount; ++tapIndex)
                unisonWarpHistory.at (unisonWarpHistoryIndex (
                    resolvedVoice, resolvedOscillator, resolvedSubVoice, tapIndex)) = 0.0f;

            unisonWarpHistoryWriteIndex.at (stateIndex) = 0;
        }

        void resetOscillatorUnisonWarpRenderState (int32 voiceIndex, int32 oscillatorIndex)
        {
            for (wrap<maxUnisonVoiceCount> subVoice)
                resetOscillatorUnisonWarpRenderState (
                    voiceIndex, oscillatorIndex, int32 (subVoice));
        }

        void resetVoiceWarpRenderState (int32 voiceIndex)
        {
            for (wrap<oscillatorCount> oscillator)
            {
                resetOscillatorWarpRenderState (voiceIndex, int32 (oscillator));
                resetOscillatorUnisonWarpRenderState (voiceIndex, int32 (oscillator));
            }
        }

        void resetAllWarpRenderState()
        {
            for (wrap<voiceCount> voice)
                resetVoiceWarpRenderState (int32 (voice));
        }

        void resetFilterState (int32 voiceIndex)
        {
            let resolvedVoice = int32 (wrap<voiceCount> (voiceIndex));
            filters.at (resolvedVoice).reset();
            unisonLeftFilters.at (resolvedVoice).reset();
            unisonRightFilters.at (resolvedVoice).reset();
        }

        void resetAllFilterState()
        {
            for (wrap<voiceCount> voice)
                resetFilterState (int32 (voice));
        }

        float32 unisonSpreadScalar (int32 subVoiceIndex, int32 voiceCountForNote, int32 detuneMode)
        {
            if (voiceCountForNote <= 1)
                return 0.0f;

            let normalized = (float32 (subVoiceIndex) / float32 (voiceCountForNote - 1)) * 2.0f - 1.0f;

            if (detuneMode == unisonDetuneModeSuper)
                return std::intrinsics::sin (normalized * 0.5f * float32 (pi));

            if (detuneMode == unisonDetuneModeExp)
            {
                let sign = normalized < 0.0f ? -1.0f : 1.0f;
                return sign * std::intrinsics::pow (std::intrinsics::abs (normalized), 1.6f);
            }

            if (detuneMode == unisonDetuneModeInv)
            {
                let sign = normalized < 0.0f ? -1.0f : 1.0f;
                return sign * (1.0f - std::intrinsics::pow (1.0f - std::intrinsics::abs (normalized), 1.6f));
            }

            if (detuneMode == unisonDetuneModeRandom)
            {
                let seeded = std::intrinsics::sin (
                    float32 ((subVoiceIndex + 1) * 37 + (voiceCountForNote * 19)) * 12.9898f
                ) * 43758.5453f;
                return (std::intrinsics::wrap (seeded, 1.0f) * 2.0f) - 1.0f;
            }

            return normalized;
        }

        float32 unisonStackSemitones (int32 subVoiceIndex, int32 voiceCountForNote, int32 stackMode)
        {
            if (voiceCountForNote <= 1 || stackMode == unisonStackModeOff)
                return 0.0f;

            if (stackMode == unisonStackModeOctaves)
                return float32 (subVoiceIndex) * 12.0f;

            if (stackMode == unisonStackModeOctavesFifths)
            {
                if ((subVoiceIndex % 2) == 0)
                    return float32 (subVoiceIndex / 2) * 12.0f;

                return (float32 (subVoiceIndex / 2) * 12.0f) + 7.0f;
            }

            let center = float32 (voiceCountForNote - 1) * 0.5f;
            let offset = float32 (subVoiceIndex) - center;

            if (stackMode == unisonStackModeCenterTwoOctaves)
                return offset * 24.0f;

            return offset * 12.0f;
        }

        float32 unisonSubVoiceWeight (int32 subVoiceIndex, int32 voiceCountForNote, float32 blend)
        {
            if (voiceCountForNote <= 1)
                return 1.0f;

            let clampedBlend = clampUnison01 (blend);
            let center = float32 (voiceCountForNote - 1) * 0.5f;
            let distanceFromCenter = std::intrinsics::abs (float32 (subVoiceIndex) - center);
            let maxDistance = center <= 0.0f ? 1.0f : center;
            let sideAmount = distanceFromCenter / maxDistance;
            return (1.0f - clampedBlend) * (1.0f - sideAmount) + clampedBlend;
        }

        float32 unisonSubVoicePhase (int32 voiceIndex,
                                     int32 oscillatorIndex,
                                     int32 subVoiceIndex,
                                     int32 generation,
                                     float32 phase,
                                     float32 randomAmount)
        {
            let clampedPhase = clampUnison01 (phase);
            let clampedRandom = clampUnison01 (randomAmount);
            let seeded = std::intrinsics::sin (
                float32 ((voiceIndex + 1) * 101
                         + oscillatorIndex * 503
                         + (subVoiceIndex + 1) * 1009
                         + (generation + 1) * 9176) * 12.9898f
            ) * 43758.5453f;
            let randomPhase = std::intrinsics::wrap (seeded, 1.0f);
            return std::intrinsics::wrap (clampedPhase + (randomPhase * clampedRandom), 1.0f);
        }

        int32 articulationMsegIndex (int32 selectorA, int32 slotIndex)
        {
            return (selectorA * modulationMsegSlotCount) + slotIndex;
        }

        int32 articulationRouteIndex (int32 selectorA, int32 routeIndex)
        {
            return (selectorA * modulationArticulationRouteCellCount) + routeIndex;
        }

        int32 articulationEnvelopeIndex (int32 selectorA, int32 slotIndex)
        {
            return (selectorA * modulationEnvSlotCount) + slotIndex;
        }

        int32 voiceArticulationMsegIndex (int32 voiceIndex, int32 slotIndex)
        {
            return (voiceIndex * modulationMsegSlotCount) + slotIndex;
        }

        int32 voiceArticulationRouteIndex (int32 voiceIndex, int32 routeIndex)
        {
            return (voiceIndex * modulationArticulationRouteCellCount) + routeIndex;
        }

        int32 voiceArticulationEnvelopeIndex (int32 voiceIndex, int32 slotIndex)
        {
            return (voiceIndex * modulationEnvSlotCount) + slotIndex;
        }

        void clearVoiceArticulation (int32 voiceIndex)
        {
            let voice = wrap<voiceCount> (voiceIndex);
            voiceUsesArticulation.at (voice) = false;
            voiceSelectorA.at (voice) = wt::articulationSelectorNone;
            voiceSelectorB.at (voice) = 0;
            voiceArticulationDurationSamples.at (voice) = 0;
            voiceArticulationAgeSamples.at (voice) = 0;
        }

        void emitVoiceArticulationMonitor (int32 voiceIndex)
        {
            let voice = wrap<voiceCount> (voiceIndex);

            wt::VoiceArticulationMonitor monitor;
            monitor.voiceIndex = int32 (voice);
            monitor.hasArticulation = voiceUsesArticulation.at (voice) ? 1 : 0;
            monitor.selectorA = voiceSelectorA.at (voice);
            monitor.selectorB = voiceSelectorB.at (voice);
            monitor.durationSamples = voiceArticulationDurationSamples.at (voice);
            monitor.ageSamples = voiceArticulationAgeSamples.at (voice);
            monitor.framePosition = voiceUsesArticulation.at (voice) ? voiceArticulationFramePosition.at (voice) : 0.0f;
            monitor.mseg1Morph = voiceUsesArticulation.at (voice) ? voiceArticulationMsegMorphs.at (voiceArticulationMsegIndex (int32 (voice), 0)) : 0.0f;
            monitor.route1Amount = voiceUsesArticulation.at (voice) ? voiceArticulationRouteAmounts.at (voiceArticulationRouteIndex (int32 (voice), 0)) : 0.0f;
            voiceArticulationStartOut <- monitor;
        }

        void latchVoiceArticulation (int32 voiceIndex,
                                     bool hasArticulation,
                                     int32 selectorA,
                                     int32 selectorB,
                                     int32 durationSamples,
                                     int32 ageSamples)
        {
            let voice = wrap<voiceCount> (voiceIndex);

            if (! hasArticulation
                || selectorA < 0
                || selectorA >= articulationSlotCount
                || ! articulationSlotDefined.at (selectorA))
            {
                clearVoiceArticulation (voiceIndex);
                emitVoiceArticulationMonitor (voiceIndex);
                return;
            }

            voiceUsesArticulation.at (voice) = true;
            voiceSelectorA.at (voice) = selectorA;
            voiceSelectorB.at (voice) = selectorB;
            voiceArticulationDurationSamples.at (voice) = std::intrinsics::max (0, durationSamples);
            voiceArticulationAgeSamples.at (voice) = std::intrinsics::max (0, ageSamples);
            voiceArticulationFramePosition.at (voice) = articulationFramePosition.at (selectorA);
            voiceArticulationPan.at (voice) = articulationPan.at (selectorA);
            voiceArticulationUnisonVoices.at (voice) = articulationUnisonVoices.at (selectorA);
            voiceArticulationUnisonDetune.at (voice) = articulationUnisonDetune.at (selectorA);
            voiceArticulationUnisonBlend.at (voice) = articulationUnisonBlend.at (selectorA);
            voiceArticulationUnisonWidth.at (voice) = articulationUnisonWidth.at (selectorA);
            voiceArticulationUnisonPhase.at (voice) = articulationUnisonPhase.at (selectorA);
            voiceArticulationUnisonRandom.at (voice) = articulationUnisonRandom.at (selectorA);
            voiceArticulationUnisonPhaseMode.at (voice) = articulationUnisonPhaseMode.at (selectorA);
            voiceArticulationUnisonDetuneMode.at (voice) = articulationUnisonDetuneMode.at (selectorA);
            voiceArticulationUnisonStackMode.at (voice) = articulationUnisonStackMode.at (selectorA);
            voiceArticulationUnisonWavetablePositionSpread.at (voice) = articulationUnisonWavetablePositionSpread.at (selectorA);
            voiceArticulationUnisonWarpSpread.at (voice) = articulationUnisonWarpSpread.at (selectorA);
            voiceArticulationWarpMode.at (voice) = articulationWarpMode.at (selectorA);
            voiceArticulationWarpAmount.at (voice) = articulationWarpAmount.at (selectorA);
            voiceArticulationFilterMode.at (voice) = articulationFilterMode.at (selectorA);
            voiceArticulationFilterCutoffHz.at (voice) = articulationFilterCutoffHz.at (selectorA);
            voiceArticulationFilterQ.at (voice) = articulationFilterQ.at (selectorA);

            for (int32 slotIndex = 0; slotIndex < modulationMsegSlotCount; ++slotIndex)
            {
                voiceArticulationMsegMorphs.at (voiceArticulationMsegIndex (int32 (voice), slotIndex))
                    = articulationMsegMorphs.at (articulationMsegIndex (selectorA, slotIndex));
            }

            for (int32 routeIndex = 0; routeIndex < modulationArticulationRouteCellCount; ++routeIndex)
            {
                let storedAmount = articulationRouteAmounts.at (articulationRouteIndex (selectorA, routeIndex));
                let baseAmount = routeIndex < modulationVoiceRouteCellCount
                    ? voiceRouteAmounts.at (routeIndex)
                    : macroVoiceRouteAmounts.at (routeIndex - modulationVoiceRouteCellCount);
                voiceArticulationRouteAmounts.at (voiceArticulationRouteIndex (int32 (voice), routeIndex))
                    = storedAmount == modulationArticulationInheritAmount ? baseAmount : storedAmount;
            }

            for (int32 slotIndex = 0; slotIndex < modulationEnvSlotCount; ++slotIndex)
            {
                voiceArticulationEnvelopeAttackSeconds.at (voiceArticulationEnvelopeIndex (int32 (voice), slotIndex))
                    = articulationEnvelopeAttackSeconds.at (articulationEnvelopeIndex (selectorA, slotIndex));
                voiceArticulationEnvelopeDecaySeconds.at (voiceArticulationEnvelopeIndex (int32 (voice), slotIndex))
                    = articulationEnvelopeDecaySeconds.at (articulationEnvelopeIndex (selectorA, slotIndex));
                voiceArticulationEnvelopeSustain.at (voiceArticulationEnvelopeIndex (int32 (voice), slotIndex))
                    = articulationEnvelopeSustain.at (articulationEnvelopeIndex (selectorA, slotIndex));
                voiceArticulationEnvelopeReleaseSeconds.at (voiceArticulationEnvelopeIndex (int32 (voice), slotIndex))
                    = articulationEnvelopeReleaseSeconds.at (articulationEnvelopeIndex (selectorA, slotIndex));
            }

            emitVoiceArticulationMonitor (voiceIndex);
        }

        void uploadVoiceArticulationEnvelopeConfig (int32 voiceIndex)
        {
            let voice = wrap<voiceCount> (voiceIndex);

            if (! voiceUsesArticulation.at (voice))
                return;

            for (int32 slotIndex = 0; slotIndex < modulationEnvSlotCount; ++slotIndex)
            {
                ModulationEnvelopeUpload config;
                config.slot = slotIndex + 1;
                config.attackSeconds = voiceArticulationEnvelopeAttackSeconds.at (voiceArticulationEnvelopeIndex (int32 (voice), slotIndex));
                config.decaySeconds = voiceArticulationEnvelopeDecaySeconds.at (voiceArticulationEnvelopeIndex (int32 (voice), slotIndex));
                config.sustain = voiceArticulationEnvelopeSustain.at (voiceArticulationEnvelopeIndex (int32 (voice), slotIndex));
                config.releaseSeconds = voiceArticulationEnvelopeReleaseSeconds.at (voiceArticulationEnvelopeIndex (int32 (voice), slotIndex));

                if (slotIndex == 0)
                    modEnv1[voice].configUpload <- config;
                else if (slotIndex == 1)
                    modEnv2[voice].configUpload <- config;
                else
                    modEnv3[voice].configUpload <- config;
            }
        }

        void uploadMsegBufferToSlot (int32 slot, int32 shapeIndex, const float32[msegPaddedSamples] buffer)
        {
            wt::MsegBufferUpload shapeUpload;
            shapeUpload.shapeIndex = shapeIndex == 1 ? 1 : 0;

            for (int32 sampleIndex = 0; sampleIndex < msegPaddedSamples; ++sampleIndex)
                shapeUpload.buffer.at (sampleIndex) = buffer.at (sampleIndex);

            if (slot == 1)
            {
                for (wrap<voiceCount> voice)
                    mseg1[voice].bufferUpload <- shapeUpload;
                return;
            }

            if (slot == 2)
            {
                for (wrap<voiceCount> voice)
                    mseg2[voice].bufferUpload <- shapeUpload;
                return;
            }

            if (slot == 3)
            {
                for (wrap<voiceCount> voice)
                    mseg3[voice].bufferUpload <- shapeUpload;
            }
        }

        void uploadMsegPlaybackToSlot (int32 slot, wt::MsegPlaybackConfig config)
        {
            if (slot == 1)
            {
                for (wrap<voiceCount> voice)
                    mseg1[voice].playbackUpload <- config;
                return;
            }

            if (slot == 2)
            {
                for (wrap<voiceCount> voice)
                    mseg2[voice].playbackUpload <- config;
                return;
            }

            if (slot == 3)
            {
                for (wrap<voiceCount> voice)
                    mseg3[voice].playbackUpload <- config;
            }
        }

        void uploadEnvelopeToSlot (int32 slot, ModulationEnvelopeUpload config)
        {
            if (slot == 1)
            {
                for (wrap<voiceCount> voice)
                    modEnv1[voice].configUpload <- config;
                return;
            }

            if (slot == 2)
            {
                for (wrap<voiceCount> voice)
                    modEnv2[voice].configUpload <- config;
                return;
            }

            if (slot == 3)
            {
                for (wrap<voiceCount> voice)
                    modEnv3[voice].configUpload <- config;
            }
        }

        void triggerVoiceModulators (int32 voiceIndex)
        {
            let voice = wrap<voiceCount> (voiceIndex);
            mseg1[voice].triggerIn <- 1;
            mseg2[voice].triggerIn <- 1;
            mseg3[voice].triggerIn <- 1;
            uploadVoiceArticulationEnvelopeConfig (voiceIndex);

            std::notes::NoteOn note;
            note.channel = voiceChannel.at (voice);
            note.pitch = voiceBasePitch.at (voice);
            note.velocity = voiceVelocity.at (voice);
            modEnv1[voice].eventIn <- note;
            modEnv2[voice].eventIn <- note;
            modEnv3[voice].eventIn <- note;
        }

        void noteOffVoiceModulators (int32 voiceIndex, std::notes::NoteOff note)
        {
            let voice = wrap<voiceCount> (voiceIndex);
            mseg1[voice].noteOffIn <- 1;
            mseg2[voice].noteOffIn <- 1;
            mseg3[voice].noteOffIn <- 1;
            modEnv1[voice].eventIn <- note;
            modEnv2[voice].eventIn <- note;
            modEnv3[voice].eventIn <- note;
        }

        float32 resolveVoiceMsegMorph (int32 voiceIndex, int32 slot)
        {
            let voice = wrap<voiceCount> (voiceIndex);

            if (voiceUsesArticulation.at (voice))
            {
                if (slot >= 1 && slot <= modulationMsegSlotCount)
                    return std::intrinsics::clamp (voiceArticulationMsegMorphs.at (voiceArticulationMsegIndex (int32 (voice), slot - 1)), 0.0f, 1.0f);

                return 0.0f;
            }

            if (slot == 1)
                return std::intrinsics::clamp (mseg1MorphIn, 0.0f, 1.0f);

            if (slot == 2)
                return std::intrinsics::clamp (mseg2MorphIn, 0.0f, 1.0f);

            if (slot == 3)
                return std::intrinsics::clamp (mseg3MorphIn, 0.0f, 1.0f);

            return 0.0f;
        }

        float32 resolveMsegValue (int32 voiceIndex, int32 slot)
        {
            let voice = wrap<voiceCount> (voiceIndex);
            let morph = resolveVoiceMsegMorph (voiceIndex, slot);

            if (slot == 1)
            {
                return mseg1[voice].outA + ((mseg1[voice].outB - mseg1[voice].outA) * morph);
            }

            if (slot == 2)
            {
                return mseg2[voice].outA + ((mseg2[voice].outB - mseg2[voice].outA) * morph);
            }

            if (slot == 3)
            {
                return mseg3[voice].outA + ((mseg3[voice].outB - mseg3[voice].outA) * morph);
            }

            return 0.0f;
        }

        float32 resolveEnvValue (int32 voiceIndex, int32 slot)
        {
            let voice = wrap<voiceCount> (voiceIndex);

            if (slot == 1) return modEnv1[voice].gainOut;
            if (slot == 2) return modEnv2[voice].gainOut;
            if (slot == 3) return modEnv3[voice].gainOut;

            return 0.0f;
        }

        float32 resolveMacroValue (int32 slot)
        {
            if (slot == 1) return std::intrinsics::clamp (macro1In, 0.0f, 1.0f);
            if (slot == 2) return std::intrinsics::clamp (macro2In, 0.0f, 1.0f);
            if (slot == 3) return std::intrinsics::clamp (macro3In, 0.0f, 1.0f);
            if (slot == 4) return std::intrinsics::clamp (macro4In, 0.0f, 1.0f);

            return 0.0f;
        }

        float32 resolveVoiceSourceValue (int32 voiceIndex, int32 sourceIndex)
        {
            if (sourceIndex < 3)
                return resolveMsegValue (voiceIndex, sourceIndex + 1);

            if (sourceIndex < 6)
                return resolveEnvValue (voiceIndex, sourceIndex - 2);

            let voice = wrap<voiceCount> (voiceIndex);

            if (sourceIndex == 6)
                return std::intrinsics::clamp (voiceVelocity.at (voice), 0.0f, 1.0f);

            if (sourceIndex == 7)
                return std::intrinsics::clamp (voicePressure.at (voice), 0.0f, 1.0f);

            if (sourceIndex == 8)
                return std::intrinsics::clamp (voiceSlide.at (voice), 0.0f, 1.0f);

            return 0.0f;
        }

        void beginModulationFrame()
        {
            for (wrap<modulationMacroSourceCount> macroIndex)
                macroSourceValues[macroIndex] = resolveMacroValue (int32 (macroIndex) + 1);

            macroVoiceBaseTargetOffsets = float32<modulationVoiceTargetCount> (0.0f);

            for (wrap<modulationMacroSourceCount> sourceIndex)
            {
                if (macroVoiceRouteSourceUsed[sourceIndex])
                    macroVoiceBaseTargetOffsets += (
                        macroVoiceRouteScaleVectors[sourceIndex] * macroSourceValues[sourceIndex]
                    ) + macroVoiceRouteBiasVectors[sourceIndex];
            }

            for (wrap<modulationVoiceSourceCount> sourceIndex)
            {
                voiceRackSourceSums[sourceIndex] = 0.0f;
                voiceRackSourceMaxima[sourceIndex] = 0.0f;
                voiceRackSourceBipolarStrongest[sourceIndex] = 0.0f;
                voiceRackSourceBipolarMagnitudes[sourceIndex] = 0.0f;
            }

            voiceRackParticipantCount = 0;
        }

        void accumulateVoiceModulationTargets (int32 voiceIndex)
        {
            let voice = wrap<voiceCount> (voiceIndex);
            let usesArticulation = voiceUsesArticulation.at (voice);

            if (usesArticulation)
            {
                for (wrap<modulationVoiceTargetCount> targetIndex)
                    voiceTargetOffsets[voice].values[targetIndex] = 0.0f;

                int32 resolvedSourceIndex = -1;
                float32 sourceValue = 0.0f;
                for (wrap<modulationVoiceRouteCellCount> routeIndex)
                {
                    if (int32 (routeIndex) >= voiceRouteCount)
                        break;

                    let sourceIndex = voiceRouteSources[routeIndex];
                    if (sourceIndex != resolvedSourceIndex)
                    {
                        resolvedSourceIndex = sourceIndex;
                        sourceValue = std::intrinsics::clamp (
                            resolveVoiceSourceValue (voiceIndex, sourceIndex),
                            0.0f,
                            1.0f
                        );
                    }

                    let targetIndex = wrap<modulationVoiceTargetCount> (voiceRouteTargets[routeIndex]);
                    let cellIndex = voiceRouteCells[routeIndex];
                    let amount = voiceArticulationRouteAmounts.at (
                        voiceArticulationRouteIndex (voiceIndex, cellIndex)
                    );
                    voiceTargetOffsets[voice].values[targetIndex] += applyModulationPolarity (
                        sourceValue,
                        voiceRoutePolarities[routeIndex]
                    ) * amount;
                }

                for (wrap<modulationMacroVoiceRouteCellCount> routeIndex)
                {
                    if (int32 (routeIndex) >= macroVoiceRouteCount)
                        break;

                    let sourceIndex = macroVoiceRouteSources[routeIndex];
                    let targetIndex = wrap<modulationVoiceTargetCount> (macroVoiceRouteTargets[routeIndex]);
                    let cellIndex = macroVoiceRouteCells[routeIndex];
                    let articulationCellIndex = modulationVoiceRouteCellCount + cellIndex;
                    let amount = voiceArticulationRouteAmounts.at (
                        voiceArticulationRouteIndex (voiceIndex, articulationCellIndex)
                    );
                    voiceTargetOffsets[voice].values[targetIndex] += applyModulationPolarity (
                        macroSourceValues.at (sourceIndex),
                        macroVoiceRoutePolarities[routeIndex]
                    ) * amount;
                }

                return;
            }

            voiceTargetOffsets[voice].values = macroVoiceBaseTargetOffsets;
            for (wrap<modulationVoiceSourceCount> sourceIndex)
            {
                if (! voiceRouteSourceUsed[sourceIndex])
                    continue;

                let sourceValue = std::intrinsics::clamp (
                    resolveVoiceSourceValue (voiceIndex, int32 (sourceIndex)),
                    0.0f,
                    1.0f
                );
                voiceTargetOffsets[voice].values += (voiceRouteScaleVectors[sourceIndex] * sourceValue)
                    + voiceRouteBiasVectors[sourceIndex];
            }
        }

        float32 voiceTargetOffset (int32 voiceIndex, int32 targetIndex)
        {
            return voiceTargetOffsets[wrap<voiceCount> (voiceIndex)]
                .values[wrap<modulationVoiceTargetCount> (targetIndex)];
        }

        void accumulateVoiceRackSources (int32 voiceIndex)
        {
            if (voiceRackRouteCount == 0)
                return;

            for (wrap<modulationVoiceSourceCount> sourceIndex)
            {
                if (! voiceRackSourceUsed[sourceIndex])
                    continue;

                let sourceValue = std::intrinsics::clamp (
                    resolveVoiceSourceValue (voiceIndex, int32 (sourceIndex)),
                    0.0f,
                    1.0f
                );
                let bipolarValue = (sourceValue * 2.0f) - 1.0f;
                let bipolarMagnitude = std::intrinsics::abs (bipolarValue);
                voiceRackSourceSums[sourceIndex] += sourceValue;
                voiceRackSourceMaxima[sourceIndex] = std::intrinsics::max (
                    voiceRackSourceMaxima[sourceIndex],
                    sourceValue
                );

                if (voiceRackParticipantCount == 0
                    || bipolarMagnitude > voiceRackSourceBipolarMagnitudes[sourceIndex])
                {
                    voiceRackSourceBipolarStrongest[sourceIndex] = bipolarValue;
                    voiceRackSourceBipolarMagnitudes[sourceIndex] = bipolarMagnitude;
                }
            }

            voiceRackParticipantCount += 1;
        }

        float32 resolveVoiceRackSource (int32 sourceIndex, int32 polarityKind, int32 reducerKind)
        {
            if (reducerKind == modulationReducerMean)
            {
                let mean = voiceRackSourceSums.at (sourceIndex) * voiceRackParticipantReciprocal;
                return applyModulationPolarity (mean, polarityKind);
            }

            if (polarityKind == modulationPolarityBipolar)
                return voiceRackSourceBipolarStrongest.at (sourceIndex);

            return voiceRackSourceMaxima.at (sourceIndex);
        }

        bool voiceIsSoundingForRackModulation (int32 voiceIndex)
        {
            let voice = wrap<voiceCount> (voiceIndex);
            return voiceActive.at (voice) != 0 || envelopes[voice].gainOut > 0.0f;
        }

        void updateRackModulationOutputs()
        {
            for (wrap<rackModTargetCount> target)
                rackModAccumulator[target] = 0.0f;

            if (voiceRackParticipantCount > 0)
                voiceRackParticipantReciprocal = 1.0f / float32 (voiceRackParticipantCount);

            for (wrap<modulationVoiceRackRouteCellCount> routeIndex)
            {
                if (int32 (routeIndex) >= voiceRackRouteCount)
                    break;

                let cellIndex = wrap<modulationVoiceRackRouteCellCount> (voiceRackRouteCells[routeIndex]);
                let sourceIndex = voiceRackRouteSources[routeIndex];

                if (voiceRackParticipantCount > 0)
                {
                    voiceRackCellHeldSources[cellIndex] = resolveVoiceRackSource (
                        sourceIndex,
                        voiceRackRoutePolarities[routeIndex],
                        voiceRackRouteReducers[routeIndex]
                    );
                    voiceRackCellGates[cellIndex] = 1.0f;
                }
                else
                {
                    voiceRackCellGates[cellIndex] = std::intrinsics::max (
                        0.0f,
                        voiceRackCellGates[cellIndex] - rackModGateReleaseStepState
                    );
                }

                let target = wrap<rackModTargetCount> (voiceRackRouteTargets[routeIndex]);
                rackModAccumulator[target] += voiceRackCellHeldSources[cellIndex]
                    * voiceRackCellGates[cellIndex]
                    * voiceRackRouteAmounts[cellIndex];
            }

            macroRackBaseTargetOffsets = float32<rackModTargetCount> (0.0f);
            for (wrap<modulationMacroSourceCount> sourceIndex)
            {
                if (macroRackRouteSourceUsed[sourceIndex])
                    macroRackBaseTargetOffsets += (
                        macroRackRouteScaleVectors[sourceIndex] * macroSourceValues[sourceIndex]
                    ) + macroRackRouteBiasVectors[sourceIndex];
            }

            for (wrap<rackModTargetCount> target)
            {
                rackModSmoothed[target] = rackModSmoothTowards (rackModSmoothed[target],
                                                                rackModAccumulator[target]
                                                                    + macroRackBaseTargetOffsets[target],
                                                                rackModSmoothingCoefficientState);
                rackModOut[target] <- rackModSmoothed[target];
            }
        }

        void initialiseWarpDecimatorTaps()
        {
            let middleIndex = float32 (warpDecimatorTapCount - 1) * 0.5f;
            float32 coefficientSum = 0.0f;

            for (int32 tapIndex = 0; tapIndex < warpDecimatorTapCount; ++tapIndex)
            {
                let offsetFromMiddle = float32 (tapIndex) - middleIndex;
                let sincValue = std::intrinsics::abs (offsetFromMiddle) <= 0.000001f
                    ? warpDecimatorCutoffNyquist
                    : std::intrinsics::sin (float32 (pi) * warpDecimatorCutoffNyquist * offsetFromMiddle)
                        / (float32 (pi) * offsetFromMiddle);
                let phase = float32 (twoPi) * float32 (tapIndex) / float32 (warpDecimatorTapCount - 1);
                let window = 0.42f
                           - (0.5f * std::intrinsics::cos (phase))
                           + (0.08f * std::intrinsics::cos (2.0f * phase));
                let coefficient = sincValue * window;
                warpDecimatorTapsState.at (tapIndex) = coefficient;
                coefficientSum += coefficient;
            }

            if (coefficientSum <= 0.0f)
                return;

            for (int32 tapIndex = 0; tapIndex < warpDecimatorTapCount; ++tapIndex)
                warpDecimatorTapsState.at (tapIndex) /= coefficientSum;
        }

        bool isMipReady (int32 mipIndex)
        {
            if (mipIndex < 0 || mipIndex >= mipLevelCount || frameCount <= 0)
                return false;

            return loadedFrameCounts.at (bankedMipLevelIndex (activeBankIndex, mipIndex)) >= frameCount;
        }

        int32 findPlayableMipIndex (int32 requestedMipIndex)
        {
            let resolvedRequestedMip = resolveMipIndex (requestedMipIndex);

            if (resolvedRequestedMip < 0)
                return -1;

            for (int32 mipIndex = resolvedRequestedMip; mipIndex >= 0; --mipIndex)
                if (isMipReady (mipIndex))
                    return mipIndex;

            return -1;
        }

        bool isLegacyAStagingComplete()
        {
            if (stagingGeneration <= 0 || stagingFrameCount <= 0)
                return false;

            for (int32 mipIndex = 0; mipIndex < mipLevelCount; ++mipIndex)
                if (loadedFrameCounts.at (bankedMipLevelIndex (stagingBankIndex, mipIndex)) < stagingFrameCount)
                    return false;

            return true;
        }

        void commitLegacyAStagingTable()
        {
            let hadActiveTable = isPlayable != 0;

            currentGeneration = stagingGeneration;
            currentTableIndex = stagingTableIndex;
            frameCount = stagingFrameCount;
            lastFrameIndex = stagingLastFrameIndex;
            lastFrameIndexF = stagingLastFrameIndexF;
            activeBankIndex = stagingBankIndex;
            stagingBankIndex = activeBankIndex == 0 ? 1 : 0;
            stagingGeneration = 0;
            stagingTableIndex = 0;
            stagingFrameCount = 0;
            stagingLastFrameIndex = 0;
            stagingLastFrameIndexF = 0.0f;

            if (! hadActiveTable)
            {
                for (wrap<voiceCount> voice)
                {
                    for (wrap<oscillatorCount> oscillator)
                    {
                        let resolvedVoice = int32 (voice);
                        let resolvedOscillator = int32 (oscillator);
                        phasors.at (oscillatorVoiceIndex (
                            resolvedVoice, resolvedOscillator)).phase = 0.0f;
                        resetOscillatorWarpRenderState (
                            resolvedVoice, resolvedOscillator);
                        resetOscillatorUnisonPhases (
                            resolvedVoice,
                            resolvedOscillator,
                            maxUnisonVoiceCount,
                            0.0f,
                            0.0f);
                        resetOscillatorUnisonWarpRenderState (
                            resolvedVoice, resolvedOscillator);
                    }
                }
            }

            isPlayable = 1;
        }

        void clearTableStagingIdentity()
        {
            tableStagingOscillatorIndex = -1;
            tableStagingSlotIndex = -1;
            tableStagingGeneration = 0;
            tableStagingTableIndex = 0;
            tableStagingFrameCount = 0;
            tableStagingLastFrameIndex = 0;
            tableStagingLastFrameIndexF = 0.0f;
        }

        void discardLegacyAStagingTable()
        {
            stagingGeneration = 0;
            stagingTableIndex = 0;
            stagingFrameCount = 0;
            stagingLastFrameIndex = 0;
            stagingLastFrameIndexF = 0.0f;
            clearPendingTableState();
        }

        void commitPackedStagingTable()
        {
            let oscillator = tableStagingOscillatorIndex;
            let committedSlot = tableStagingSlotIndex;
            let hadActiveTable = oscillatorActiveSlot.at (oscillator) >= 0;

            oscillatorCurrentGeneration.at (oscillator) = tableStagingGeneration;
            oscillatorCurrentTableIndex.at (oscillator) = tableStagingTableIndex;
            oscillatorFrameCount.at (oscillator) = tableStagingFrameCount;
            oscillatorLastFrameIndex.at (oscillator) = tableStagingLastFrameIndex;
            oscillatorLastFrameIndexF.at (oscillator) = tableStagingLastFrameIndexF;
            oscillatorActiveSlot.at (oscillator) = committedSlot;

            if (oscillator == oscillatorA)
                commitLegacyAStagingTable();
            else if (! hadActiveTable)
            {
                for (wrap<voiceCount> voice)
                {
                    let resolvedVoice = int32 (voice);
                    phasors.at (oscillatorVoiceIndex (resolvedVoice, oscillator)).phase = 0.0f;
                    resetOscillatorWarpRenderState (resolvedVoice, oscillator);
                    resetOscillatorUnisonPhases (
                        resolvedVoice, oscillator, maxUnisonVoiceCount, 0.0f, 0.0f);
                    resetOscillatorUnisonWarpRenderState (resolvedVoice, oscillator);
                }
            }

            WavetableSlotMonitor slotMonitor;
            slotMonitor.oscillatorIndex = oscillator;
            slotMonitor.activeSlotIndex = committedSlot;
            slotMonitor.tableIndex = oscillatorCurrentTableIndex.at (oscillator);
            slotMonitor.generation = oscillatorCurrentGeneration.at (oscillator);
            wavetableSlotMonitorOut <- slotMonitor;

            clearTableStagingIdentity();
            emitRuntimeServiceState (oscillator);
        }

        void writeMipFrame (int32 bankIndex, int32 mipIndex, int32 frameIndex, const float32[] sourceSamples)
        {
            let bank = normalizeTableBankIndex (bankIndex);
            let base = frameBase (frameIndex);

            if (mipIndex == 0)
            {
                if (bank == 0)
                {
                    mip0Bank0Samples.at (base + 0) = sourceSamples.at (samplesPerFrame - 1);
