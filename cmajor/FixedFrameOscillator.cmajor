        float32[voiceCount] voiceArticulationFilterKeyTrackOffsetSemitones;
        float32[voiceCount] voiceArticulationFilterQ;
        float32[voiceCount] voiceFilterKeyTrackSmoothedHz;
        float32[voiceCount * modulationMsegSlotCount] voiceArticulationMsegMorphs;
        float32[voiceCount * modulationArticulationRouteCellCount] voiceArticulationRouteAmounts;
        VoiceArticulationModulationTransforms[voiceCount] voiceArticulationRouteTransforms;
        float32[voiceCount * modulationEnvSlotCount] voiceArticulationEnvelopeAttackSeconds;
        float32[voiceCount * modulationEnvSlotCount] voiceArticulationEnvelopeDecaySeconds;
        float32[voiceCount * modulationEnvSlotCount] voiceArticulationEnvelopeSustain;
        float32[voiceCount * modulationEnvSlotCount] voiceArticulationEnvelopeReleaseSeconds;
        int32 voiceRouteCount;
