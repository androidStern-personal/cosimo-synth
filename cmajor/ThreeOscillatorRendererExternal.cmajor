// Every function the host supplies to the synth's Cmajor code. The desktop,
// iPhone and browser hosts bind these names to native code (see
// native/three_oscillator_renderer/RendererExternalFunctionProvider.h).
// `cmaj test` has no native provider, so Cmajor tests include
// tests/cmajor_support/ThreeOscillatorRendererTestHost.cmajor and a renderer
// seam from tests/cmajor_rack instead of this file.
namespace CosimoThreeOscillatorRenderer
{
    external int32 sharedMsegSerial (int32 inputIndex, int32 dspSession);
    external float32 sampleSharedMseg (int32 inputIndex, int32 dspSession, int32 deliveryToken, float32 position);
    external int32 updateSharedTables (int32 dspSession, int32[] packedInts);
    external int32 renderShared (float32[] packedFloats, int32[] packedInts);
    external int32 renderAll (float32[] packedFloats,
                              int32[] packedInts,
                              int32[] slot0Chunk0,
                              int32[] slot0Chunk1,
                              int32[] slot0Chunk2,
                              int32[] slot0Chunk3,
                              int32[] slot1Chunk0,
                              int32[] slot1Chunk1,
                              int32[] slot1Chunk2,
                              int32[] slot1Chunk3,
                              int32[] slot2Chunk0,
                              int32[] slot2Chunk1,
                              int32[] slot2Chunk2,
                              int32[] slot2Chunk3,
                              int32[] slot3Chunk0,
                              int32[] slot3Chunk1,
                              int32[] slot3Chunk2,
                              int32[] slot3Chunk3);
}
