namespace wt
{
    let keyTrackFallbackPitchHz = 440.0f;
    let keyTrackSmoothingSeconds = 0.005f;

    float32 keyTrackFinitePitchHz (float32 playedPitchHz)
    {
        return ! std::intrinsics::isnan (playedPitchHz)
            && ! std::intrinsics::isinf (playedPitchHz)
            && playedPitchHz > 0.0f
            ? playedPitchHz
            : keyTrackFallbackPitchHz;
    }

    float32 keyTrackRatio (float32 offsetSemitones)
    {
        let finiteOffset = ! std::intrinsics::isnan (offsetSemitones)
            && ! std::intrinsics::isinf (offsetSemitones)
            ? offsetSemitones
            : 0.0f;
        return std::intrinsics::pow (2.0f, finiteOffset / 12.0f);
    }

    float32 keyTrackFrequencyHz (float32 playedPitchHz,
                                 float32 offsetSemitones,
                                 float32 minimumHz,
                                 float32 maximumHz)
    {
        let converted = keyTrackFinitePitchHz (playedPitchHz) * keyTrackRatio (offsetSemitones);
        return std::intrinsics::clamp (converted, minimumHz, maximumHz);
    }

    float32 keyTrackPeriodMilliseconds (float32 playedPitchHz,
                                        float32 offsetSemitones,
                                        float32 minimumMs,
                                        float32 maximumMs)
    {
        let converted = (1000.0f / keyTrackFinitePitchHz (playedPitchHz))
            / keyTrackRatio (offsetSemitones);
        return std::intrinsics::clamp (converted, minimumMs, maximumMs);
    }

    /**
     * A frequency control keeps its deployed ordinary value and route law
     * when Key Track is off. When enabled, ordinary Hz is switched out and
     * base plus route offsets are summed in semitones before one conversion.
     */
    float32 resolveKeyTrackedFrequencyHz (float32 enabled,
                                          float32 ordinaryHz,
                                          float32 playedPitchHz,
                                          float32 baseOffsetSemitones,
                                          float32 routeOffsetSemitones,
                                          float32 minimumHz,
                                          float32 maximumHz)
    {
        if (enabled >= 0.5f)
            return keyTrackFrequencyHz (
                playedPitchHz,
                baseOffsetSemitones + routeOffsetSemitones,
                minimumHz,
                maximumHz);

        let converted = ordinaryHz * keyTrackRatio (routeOffsetSemitones);
        return std::intrinsics::clamp (converted, minimumHz, maximumHz);
    }

    /**
     * Voice Filter routes are stored in octaves. Its Key Track-off branch is
     * deliberately separate so the deployed pow(2, octaves) expression is
     * preserved bit for bit instead of taking a float32 *12 /12 round trip.
     */
    float32 resolveVoiceFilterKeyTrackedFrequencyHz (float32 enabled,
                                                     float32 ordinaryHz,
                                                     float32 playedPitchHz,
                                                     float32 baseOffsetSemitones,
                                                     float32 routeOffsetOctaves,
                                                     float32 minimumHz,
                                                     float32 maximumHz)
    {
        if (enabled >= 0.5f)
            return keyTrackFrequencyHz (
                playedPitchHz,
                baseOffsetSemitones + (routeOffsetOctaves * 12.0f),
                minimumHz,
                maximumHz);

        return std::intrinsics::clamp (
            ordinaryHz * std::intrinsics::pow (2.0f, routeOffsetOctaves),
            minimumHz,
            maximumHz);
    }

    /** Hidden pre-T50 Chorus compatibility law. New state passes 0 and keeps
        continuous base + route addition; migrated state passes 1 and retains
        the deployed clamp around legacy fine plus the retained route. */
    float32 chorusRingTrackedOffsetSemitones (float32 legacyClampEnabled,
                                              float32 migratedBaseOffsetSemitones,
                                              float32 legacyFineSemitones,
                                              float32 retainedRouteSemitones)
    {
        if (legacyClampEnabled >= 0.5f)
            return migratedBaseOffsetSemitones
                + std::intrinsics::clamp (
                    legacyFineSemitones + retainedRouteSemitones,
                    -2.0f,
                    2.0f)
                - legacyFineSemitones;

        return migratedBaseOffsetSemitones + retainedRouteSemitones;
    }

    float32 resolveChorusRingFrequencyHz (float32 keyTrackEnabled,
                                          float32 legacyClampEnabled,
                                          float32 ordinaryHz,
                                          float32 playedPitchHz,
                                          float32 migratedBaseOffsetSemitones,
                                          float32 legacyFineSemitones,
                                          float32 retainedRouteSemitones,
                                          float32 minimumHz,
                                          float32 maximumHz)
    {
        if (keyTrackEnabled >= 0.5f)
            return keyTrackFrequencyHz (
                playedPitchHz,
                chorusRingTrackedOffsetSemitones (
                    legacyClampEnabled,
                    migratedBaseOffsetSemitones,
                    legacyFineSemitones,
                    retainedRouteSemitones),
                minimumHz,
                maximumHz);

        return resolveKeyTrackedFrequencyHz (
            0.0f,
            ordinaryHz,
            playedPitchHz,
            0.0f,
            retainedRouteSemitones,
            minimumHz,
            maximumHz);
    }

    /** resolveChorusRingFrequencyHz through one ExactPow2Memo: identical
        branch structure and expressions, with the ratio pow paid only when
        the tracked offset actually moves. Sample-exact against the direct
        resolver — the memo family's contract. */
    float32 resolveChorusRingFrequencyHzMemoized (ExactPow2Memo& ratioMemo,
                                                  float32 keyTrackEnabled,
                                                  float32 legacyClampEnabled,
                                                  float32 ordinaryHz,
                                                  float32 playedPitchHz,
                                                  float32 migratedBaseOffsetSemitones,
                                                  float32 legacyFineSemitones,
                                                  float32 retainedRouteSemitones,
                                                  float32 minimumHz,
                                                  float32 maximumHz)
    {
        if (keyTrackEnabled >= 0.5f)
            return std::intrinsics::clamp (
                keyTrackFinitePitchHz (playedPitchHz)
                    * exactKeyTrackRatio (ratioMemo,
                                          chorusRingTrackedOffsetSemitones (
                                              legacyClampEnabled,
                                              migratedBaseOffsetSemitones,
                                              legacyFineSemitones,
                                              retainedRouteSemitones)),
                minimumHz,
                maximumHz);

        return std::intrinsics::clamp (
            ordinaryHz * exactKeyTrackRatio (ratioMemo, retainedRouteSemitones),
            minimumHz,
            maximumHz);
    }

    /**
     * Ordinary delay modulation retains its deployed sign while off.
     * Tracked delay/comb periods use pitch's reciprocal sign while enabled.
     */
    float32 resolveKeyTrackedPeriodMilliseconds (float32 enabled,
                                                 float32 ordinaryMs,
                                                 float32 playedPitchHz,
                                                 float32 baseOffsetSemitones,
                                                 float32 routeOffsetSemitones,
                                                 float32 minimumMs,
                                                 float32 maximumMs)
    {
        if (enabled >= 0.5f)
            return keyTrackPeriodMilliseconds (
                playedPitchHz,
                baseOffsetSemitones + routeOffsetSemitones,
                minimumMs,
                maximumMs);

        let converted = ordinaryMs * keyTrackRatio (routeOffsetSemitones);
        return std::intrinsics::clamp (converted, minimumMs, maximumMs);
    }

    //==============================================================================
    // Exact-input transcendental memos for per-sample audio paths.
    //
    // The audio-rate contract stands: these change WHEN a value is derived,
    // never what is derived. Each memo recomputes on ANY input change (exact
    // float compare, unlike wt::RackOctaveScaler's epsilon, which is a rack
    // forwarding tolerance) and returns the identical stored bits otherwise,
    // so a memoized path is sample-for-sample identical to the direct call.
    // A zero-initialised memo is self-invalidating: every derived value here
    // is strictly positive, so `<= 0` marks "never computed", and a NaN key
    // never false-hits because NaN != NaN.

    struct ExactPow2Memo
    {
        float32 exponent;
        float32 scale;
    }

    float32 exactPow2 (ExactPow2Memo& memo, float32 exponent)
    {
        if (exponent != memo.exponent || memo.scale <= 0.0f)
        {
            memo.exponent = exponent;
            memo.scale = std::intrinsics::pow (2.0f, exponent);
        }

        return memo.scale;
    }

    /** keyTrackRatio through an ExactPow2Memo: identical finite-input mapping,
        identical expression, one pow only when the offset actually moves. */
    float32 exactKeyTrackRatio (ExactPow2Memo& memo, float32 offsetSemitones)
    {
        let finiteOffset = ! std::intrinsics::isnan (offsetSemitones)
            && ! std::intrinsics::isinf (offsetSemitones)
            ? offsetSemitones
            : 0.0f;
        return exactPow2 (memo, finiteOffset / 12.0f);
    }

    struct NoteFrequencyMemo
    {
        float32 pitchSemitones;
        float32 frequencyHz;
    }

    float32 exactNoteToFrequency (NoteFrequencyMemo& memo, float32 pitchSemitones)
    {
        if (pitchSemitones != memo.pitchSemitones || memo.frequencyHz <= 0.0f)
        {
            memo.pitchSemitones = pitchSemitones;
            memo.frequencyHz = std::notes::noteToFrequency (pitchSemitones);
        }

        return memo.frequencyHz;
    }

    struct GainDbMemo
    {
        float32 gainDb;
        float32 gain;
    }

    float32 keyTrackOnePoleCoefficient (float32 sampleRate)
    {
        let frames = std::intrinsics::max (
            1.0f, sampleRate * keyTrackSmoothingSeconds);
        return 1.0f - std::intrinsics::exp (-1.0f / frames);
    }

    // Convert and clamp first, then smooth the effective domain value. The
    // caller computes the sample-rate coefficient once at processor start;
    // no transcendental work is repeated per voice/effect on every sample.
    // A fresh voice starts at its first target; later pitch/offset changes are
    // continuous without smoothing semitones before conversion.
    float32 advanceKeyTrackSmoothedValue (float32 current,
                                           float32 target,
                                           float32 coefficient)
    {
        if (current <= 0.0f)
            return target;

        return current + (target - current)
            * std::intrinsics::clamp (coefficient, 0.0f, 1.0f);
    }
}
