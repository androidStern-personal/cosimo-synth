{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowJs": false,
    "skipLibCheck": true
  },
  "include": [
    "fx/**/*.ts",
    "fx/**/*.tsx",
    "kit/index.ts",
    "kit/ui/style-modules.d.ts",
    "kit/ui/**/*.ts",
    "kit/ui/**/*.tsx",
    "kit/examples/**/*.ts",
    "kit/examples/**/*.tsx"
  ]
}
