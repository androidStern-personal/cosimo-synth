{
  "name": "builder-kit-project",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "kit:new": "node kit/scripts/new_plugin.mjs",
    "kit:doctor": "node kit/scripts/doctor.mjs",
    "kit:setup": "node kit/scripts/setup.mjs",
    "fx:dev": "vite --config kit/fx/vite.config.mjs",
    "fx:build": "node kit/fx/build-effect.mjs",
    "fx:prod:build": "node kit/fx/prod-effect.mjs build",
    "fx:prod:install": "node kit/fx/prod-effect.mjs install",
    "fx:jit:install": "node kit/scripts/cmajplugin.mjs jit-install",
    "cmajplugin:install": "node kit/scripts/cmajplugin.mjs install",
    "typecheck": "tsc --noEmit",
    "test": "node kit/scripts/test_unit.mjs",
    "test:browser": "node --test \"kit/tests/**/*_browser.mjs\" \"tests/**/*_browser.mjs\"",
    "test:dsp": "node kit/scripts/test_dsp.mjs",
    "test:knobs": "node --test kit/tests/test_knob_browser.mjs",
    "test:filters": "node --test kit/tests/test_filter_browser.mjs",
    "test:mseg": "node --test kit/tests/test_mseg_editor_browser.mjs kit/tests/test_mseg_composition_browser.mjs",
    "test:sliders": "node --test kit/tests/test_slider_browser.mjs",
    "ui:docs:dev": "vite --config kit/examples/vite.config.mjs",
    "ui:docs:build": "vite build --config kit/examples/vite.config.mjs"
  },
  "devDependencies": "__DEV_DEPENDENCIES__"
}
