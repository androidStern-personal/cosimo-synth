namespace polishlab
{
    let clipOversampleFactor = 4;
    let meterFramesPerSecond = 20.0f;

    struct MeterFrame
    {
        float32 inputPeakDb;
        float32 outputPeakDb;
        float32 inputRmsDb;
        float32 outputRmsDb;
        float32 gainReductionDb;
        float32 clipActivityPercent;
        float32 compressorInputDb;
        float32 compressorOutputDb;
        float32 clipInput;
        float32 clipOutput;
    }

    float32 clamp01 (float32 value)
    {
        return std::intrinsics::clamp (value, 0.0f, 1.0f);
    }

    float32 gainToDb (float32 gain)
    {
        return std::levels::gainTodB (std::intrinsics::max (gain, 1.0e-6f));
    }

    float32 tensionWarp (float32 position, float32 tension)
    {
        let u = clamp01 (position);
        let t = std::intrinsics::clamp (tension, -1.0f, 1.0f);
        return u + (t * u * (1.0f - u) * (1.0f - (2.0f * u)));
    }

    float32 evaluatePositiveCurve (
        float32 magnitude,
        float32 p1xIn, float32 p1yIn, float32 p1t,
        float32 p2xIn, float32 p2yIn, float32 p2t,
        float32 p3xIn, float32 p3yIn, float32 p3t)
    {
        let p1x = std::intrinsics::clamp (p1xIn, 0.01f, 1.45f);
        let p2x = std::intrinsics::clamp (p2xIn, p1x + 0.001f, 1.48f);
        let p3x = std::intrinsics::clamp (p3xIn, p2x + 0.001f, 1.5f);
        let p1y = std::intrinsics::clamp (p1yIn, 0.0f, 1.45f);
        let p2y = std::intrinsics::clamp (p2yIn, p1y, 1.48f);
        let p3y = std::intrinsics::clamp (p3yIn, p2y, 1.5f);
        let x = std::intrinsics::max (0.0f, magnitude);

        if (x >= p3x)
            return p3y;

        if (x <= p1x)
        {
            let u = tensionWarp (x / p1x, p1t);
            return p1y * u;
        }

        if (x <= p2x)
        {
            let u = tensionWarp ((x - p1x) / (p2x - p1x), p2t);
            return p1y + ((p2y - p1y) * u);
        }

        let u = tensionWarp ((x - p2x) / (p3x - p2x), p3t);
        return p2y + ((p3y - p2y) * u);
    }

    float32 evaluateCurve (
        float32 sample,
        float32 p1x, float32 p1y, float32 p1t,
        float32 p2x, float32 p2y, float32 p2t,
        float32 p3x, float32 p3y, float32 p3t)
    {
        if (sample == 0.0f)
            return 0.0f;

        let shaped = evaluatePositiveCurve (
            std::intrinsics::abs (sample),
            p1x, p1y, p1t,
            p2x, p2y, p2t,
            p3x, p3y, p3t
        );

        return sample < 0.0f ? -shaped : shaped;
    }

    float32 quadraticBow (float32 position, float32 bend)
    {
        let u = clamp01 (position);
        let b = std::intrinsics::clamp (bend, -1.0f, 1.0f);
        return u + (b * u * (1.0f - u));
    }

    float32 evaluateBowSegment (float32 x,
                                float32 leftX, float32 leftY,
                                float32 rightX, float32 rightY,
                                float32 bend)
    {
        let u = quadraticBow ((x - leftX) / (rightX - leftX), bend);
        return leftY + ((rightY - leftY) * u);
    }

    float32 desiredGainReductionDb (float32 detectorAmplitude,
                                    float32 thresholdDb,
                                    float32 ratio,
                                    float32 kneeDb)
    {
        let levelDb = gainToDb (detectorAmplitude);
        let safeRatio = std::intrinsics::clamp (ratio, 1.0f, 1000.0f);
        let slope = 1.0f - (1.0f / safeRatio);
        let distance = levelDb - thresholdDb;
        let safeKnee = std::intrinsics::clamp (kneeDb, 0.0f, 24.0f);

        if (safeKnee <= 0.0001f)
            return distance > 0.0f ? -slope * distance : 0.0f;

        let halfKnee = safeKnee * 0.5f;

        if (distance <= -halfKnee)
            return 0.0f;

        if (distance >= halfKnee)
            return -slope * distance;

        let kneeDistance = distance + halfKnee;
        return -slope * kneeDistance * kneeDistance / (2.0f * safeKnee);
    }

    processor ClipCoreChannel
    {
        input stream float32 in;
        output stream float32 out;
        output stream float32 thru;

        input value float32 driveDb;
        input value float32 p1x;
        input value float32 p1y;
        input value float32 p1t;
        input value float32 p2x;
        input value float32 p2y;
        input value float32 p2t;
        input value float32 p3x;
        input value float32 p3y;
        input value float32 p3t;
        void main()
        {
            loop
            {
                let sample = in;
                let driven = sample * std::levels::dBtoGain (
                    std::intrinsics::clamp (driveDb, -24.0f, 36.0f)
                );

                thru <- sample;
                out <- evaluateCurve (
                    driven,
                    p1x, p1y, p1t,
                    p2x, p2y, p2t,
                    p3x, p3y, p3t
                );
                advance();
            }
        }
    }

    float32 evaluateBipolarSideCurve (
        float32 magnitude,
        float32 pointCountIn,
        float32 p1xIn, float32 p1yIn,
        float32 p2xIn, float32 p2yIn,
        float32 p3xIn, float32 p3yIn,
        float32 p4xIn, float32 p4yIn,
        float32 p5xIn, float32 p5yIn,
        float32 p6xIn, float32 p6yIn,
        float32 p7xIn, float32 p7yIn,
        float32 b1, float32 b2, float32 b3, float32 b4,
        float32 b5, float32 b6, float32 b7,
        float32 morphPointIn,
        float32 morphTargetX,
        float32 morphTargetY,
        float32 morphPosition)
    {
        let count = int32 (std::intrinsics::clamp (pointCountIn, 1.0f, 7.0f) + 0.5f);
        let requestedMorphPoint = int32 (std::intrinsics::clamp (morphPointIn, 0.0f, 7.0f) + 0.5f);
        let morphPoint = requestedMorphPoint > count ? count : requestedMorphPoint;
        let morph01 = clamp01 (morphPosition);
        var p1xRaw = p1xIn; var p1yRaw = p1yIn;
        var p2xRaw = p2xIn; var p2yRaw = p2yIn;
        var p3xRaw = p3xIn; var p3yRaw = p3yIn;
        var p4xRaw = p4xIn; var p4yRaw = p4yIn;
        var p5xRaw = p5xIn; var p5yRaw = p5yIn;
        var p6xRaw = p6xIn; var p6yRaw = p6yIn;
        var p7xRaw = p7xIn; var p7yRaw = p7yIn;

        if (morphPoint == 1) { p1xRaw += (morphTargetX - p1xRaw) * morph01; p1yRaw += (morphTargetY - p1yRaw) * morph01; }
        if (morphPoint == 2) { p2xRaw += (morphTargetX - p2xRaw) * morph01; p2yRaw += (morphTargetY - p2yRaw) * morph01; }
        if (morphPoint == 3) { p3xRaw += (morphTargetX - p3xRaw) * morph01; p3yRaw += (morphTargetY - p3yRaw) * morph01; }
        if (morphPoint == 4) { p4xRaw += (morphTargetX - p4xRaw) * morph01; p4yRaw += (morphTargetY - p4yRaw) * morph01; }
        if (morphPoint == 5) { p5xRaw += (morphTargetX - p5xRaw) * morph01; p5yRaw += (morphTargetY - p5yRaw) * morph01; }
        if (morphPoint == 6) { p6xRaw += (morphTargetX - p6xRaw) * morph01; p6yRaw += (morphTargetY - p6yRaw) * morph01; }
        if (morphPoint == 7) { p7xRaw += (morphTargetX - p7xRaw) * morph01; p7yRaw += (morphTargetY - p7yRaw) * morph01; }

        let p1x = std::intrinsics::clamp (p1xRaw, 0.001f, 1.5f - 0.001f * float32 (count - 1));
        var p2x = p1x;
        var p3x = p1x;
        var p4x = p1x;
        var p5x = p1x;
        var p6x = p1x;
        var p7x = p1x;
        if (count >= 2) p2x = std::intrinsics::clamp (p2xRaw, p1x + 0.001f, 1.5f - 0.001f * float32 (count - 2));
        if (count >= 3) p3x = std::intrinsics::clamp (p3xRaw, p2x + 0.001f, 1.5f - 0.001f * float32 (count - 3));
        if (count >= 4) p4x = std::intrinsics::clamp (p4xRaw, p3x + 0.001f, 1.5f - 0.001f * float32 (count - 4));
        if (count >= 5) p5x = std::intrinsics::clamp (p5xRaw, p4x + 0.001f, 1.5f - 0.001f * float32 (count - 5));
        if (count >= 6) p6x = std::intrinsics::clamp (p6xRaw, p5x + 0.001f, 1.5f - 0.001f * float32 (count - 6));
        if (count >= 7) p7x = std::intrinsics::clamp (p7xRaw, p6x + 0.001f, 1.5f);

        let p1y = std::intrinsics::clamp (p1yRaw, -1.5f, 1.5f);
        let p2y = std::intrinsics::clamp (p2yRaw, -1.5f, 1.5f);
        let p3y = std::intrinsics::clamp (p3yRaw, -1.5f, 1.5f);
        let p4y = std::intrinsics::clamp (p4yRaw, -1.5f, 1.5f);
        let p5y = std::intrinsics::clamp (p5yRaw, -1.5f, 1.5f);
        let p6y = std::intrinsics::clamp (p6yRaw, -1.5f, 1.5f);
        let p7y = std::intrinsics::clamp (p7yRaw, -1.5f, 1.5f);
        let x = std::intrinsics::max (0.0f, magnitude);

        if (x <= p1x) return evaluateBowSegment (x, 0.0f, 0.0f, p1x, p1y, b1);
        if (count == 1) return p1y;
        if (x <= p2x) return evaluateBowSegment (x, p1x, p1y, p2x, p2y, b2);
        if (count == 2) return p2y;
        if (x <= p3x) return evaluateBowSegment (x, p2x, p2y, p3x, p3y, b3);
        if (count == 3) return p3y;
        if (x <= p4x) return evaluateBowSegment (x, p3x, p3y, p4x, p4y, b4);
        if (count == 4) return p4y;
        if (x <= p5x) return evaluateBowSegment (x, p4x, p4y, p5x, p5y, b5);
        if (count == 5) return p5y;
        if (x <= p6x) return evaluateBowSegment (x, p5x, p5y, p6x, p6y, b6);
        if (count == 6) return p6y;
        if (x <= p7x) return evaluateBowSegment (x, p6x, p6y, p7x, p7y, b7);
        return p7y;
    }

    processor BipolarShapeCoreChannel
    {
        input stream float32 in;
        output stream float32 out;
        output stream float32 thru;

        input value float32 positivePointCount;
        input value float32 positiveP1X; input value float32 positiveP1Y;
        input value float32 positiveP2X; input value float32 positiveP2Y;
        input value float32 positiveP3X; input value float32 positiveP3Y;
        input value float32 positiveP4X; input value float32 positiveP4Y;
        input value float32 positiveP5X; input value float32 positiveP5Y;
        input value float32 positiveP6X; input value float32 positiveP6Y;
        input value float32 positiveP7X; input value float32 positiveP7Y;
        input value float32 positiveB1; input value float32 positiveB2; input value float32 positiveB3;
        input value float32 positiveB4; input value float32 positiveB5; input value float32 positiveB6; input value float32 positiveB7;

        input value float32 negativePointCount;
        input value float32 negativeP1X; input value float32 negativeP1Y;
        input value float32 negativeP2X; input value float32 negativeP2Y;
        input value float32 negativeP3X; input value float32 negativeP3Y;
        input value float32 negativeP4X; input value float32 negativeP4Y;
        input value float32 negativeP5X; input value float32 negativeP5Y;
        input value float32 negativeP6X; input value float32 negativeP6Y;
        input value float32 negativeP7X; input value float32 negativeP7Y;
        input value float32 negativeB1; input value float32 negativeB2; input value float32 negativeB3;
        input value float32 negativeB4; input value float32 negativeB5; input value float32 negativeB6; input value float32 negativeB7;

        input value float32 morphSide;
        input value float32 morphPoint;
        input value float32 morphTargetX;
        input value float32 morphTargetY;
        input value float32 morphPosition;

        void main()
        {
            loop
            {
                let sample = in;
                thru <- sample;
                out <- sample < 0.0f
                    ? evaluateBipolarSideCurve (
                        -sample, negativePointCount,
                        negativeP1X, negativeP1Y, negativeP2X, negativeP2Y,
                        negativeP3X, negativeP3Y, negativeP4X, negativeP4Y,
                        negativeP5X, negativeP5Y, negativeP6X, negativeP6Y,
                        negativeP7X, negativeP7Y,
                        negativeB1, negativeB2, negativeB3, negativeB4,
                        negativeB5, negativeB6, negativeB7,
                        morphSide < 0.0f ? morphPoint : 0.0f,
                        morphTargetX, morphTargetY, morphPosition
                    )
                    : evaluateBipolarSideCurve (
                        sample, positivePointCount,
                        positiveP1X, positiveP1Y, positiveP2X, positiveP2Y,
                        positiveP3X, positiveP3Y, positiveP4X, positiveP4Y,
                        positiveP5X, positiveP5Y, positiveP6X, positiveP6Y,
                        positiveP7X, positiveP7Y,
                        positiveB1, positiveB2, positiveB3, positiveB4,
                        positiveB5, positiveB6, positiveB7,
                        morphSide >= 0.0f ? morphPoint : 0.0f,
                        morphTargetX, morphTargetY, morphPosition
                    );
                advance();
            }
        }
    }
}

processor PolishVoicingProcessor
{
    input stream float32<2> in;
    output stream float32<2> out;

    input value float32 hostSlot0Guard [[ name: "Host Slot Guard", group: "Internal", min: 0.0f, max: 1.0f, init: 0.0f, hidden: true, rampFrames: 0 ]];

    input value bool bypass [[ name: "Bypass", group: "Master", init: false, boolean ]];

    input value float32 thresholdDb [[ name: "Threshold", group: "Compressor", min: -36.0f, max: 6.0f, init: 0.0f, unit: "dB", rampFrames: 256 ]];
    input value float32 ratio [[ name: "Ratio", group: "Compressor", min: 1.0f, max: 100.0f, init: 4.0f, unit: ":1", rampFrames: 256 ]];
    input value float32 kneeDb [[ name: "Knee", group: "Compressor", min: 0.0f, max: 24.0f, init: 6.0f, unit: "dB", rampFrames: 256 ]];
    input value float32 attackMs [[ name: "Attack", group: "Compressor", min: 0.05f, max: 100.0f, init: 10.0f, unit: "ms", rampFrames: 256 ]];
    input value float32 releaseMs [[ name: "Release", group: "Compressor", min: 5.0f, max: 1000.0f, init: 120.0f, unit: "ms", rampFrames: 256 ]];
    input value float32 makeupDb [[ name: "Makeup", group: "Compressor", min: -24.0f, max: 24.0f, init: 0.0f, unit: "dB", rampFrames: 256 ]];

    input value float32 curveP1X [[ name: "Positive Point 1 Input", group: "Waveshaper State", min: 0.01f, max: 1.5f, init: 1.0f, hidden: true, rampFrames: 256 ]];
    input value float32 curveP1Y [[ name: "Positive Point 1 Output", group: "Waveshaper State", min: -1.5f, max: 1.5f, init: 1.0f, hidden: true, rampFrames: 256 ]];
    input value float32 curveP2X [[ name: "Positive Point 2 Input", group: "Waveshaper State", min: 0.01f, max: 1.5f, init: 1.08f, hidden: true, rampFrames: 256 ]];
    input value float32 curveP2Y [[ name: "Positive Point 2 Output", group: "Waveshaper State", min: -1.5f, max: 1.5f, init: 1.0f, hidden: true, rampFrames: 256 ]];
    input value float32 curveP3X [[ name: "Positive Point 3 Input", group: "Waveshaper State", min: 0.01f, max: 1.5f, init: 1.16f, hidden: true, rampFrames: 256 ]];
    input value float32 curveP3Y [[ name: "Positive Point 3 Output", group: "Waveshaper State", min: -1.5f, max: 1.5f, init: 1.0f, hidden: true, rampFrames: 256 ]];

    input value float32 curvePointCount [[ name: "Positive Point Count", group: "Waveshaper State", min: 1.0f, max: 7.0f, init: 1.0f, discrete: true, step: 1.0f, hidden: true, rampFrames: 0 ]];
    input value float32 curveP4X [[ name: "Positive Point 4 Input", group: "Waveshaper State", min: 0.01f, max: 1.5f, init: 1.24f, hidden: true, rampFrames: 256 ]];
    input value float32 curveP4Y [[ name: "Positive Point 4 Output", group: "Waveshaper State", min: -1.5f, max: 1.5f, init: 1.0f, hidden: true, rampFrames: 256 ]];
    input value float32 curveP5X [[ name: "Positive Point 5 Input", group: "Waveshaper State", min: 0.01f, max: 1.5f, init: 1.32f, hidden: true, rampFrames: 256 ]];
    input value float32 curveP5Y [[ name: "Positive Point 5 Output", group: "Waveshaper State", min: -1.5f, max: 1.5f, init: 1.0f, hidden: true, rampFrames: 256 ]];
    input value float32 curveP6X [[ name: "Positive Point 6 Input", group: "Waveshaper State", min: 0.01f, max: 1.5f, init: 1.4f, hidden: true, rampFrames: 256 ]];
    input value float32 curveP6Y [[ name: "Positive Point 6 Output", group: "Waveshaper State", min: -1.5f, max: 1.5f, init: 1.0f, hidden: true, rampFrames: 256 ]];
    input value float32 curveP7X [[ name: "Positive Point 7 Input", group: "Waveshaper State", min: 0.01f, max: 1.5f, init: 1.5f, hidden: true, rampFrames: 256 ]];
    input value float32 curveP7Y [[ name: "Positive Point 7 Output", group: "Waveshaper State", min: -1.5f, max: 1.5f, init: 1.0f, hidden: true, rampFrames: 256 ]];
    input value float32 curveB1 [[ name: "Positive Segment 1 Bend", group: "Waveshaper State", min: -1.0f, max: 1.0f, init: 0.0f, hidden: true, rampFrames: 256 ]];
    input value float32 curveB2 [[ name: "Positive Segment 2 Bend", group: "Waveshaper State", min: -1.0f, max: 1.0f, init: 0.0f, hidden: true, rampFrames: 256 ]];
    input value float32 curveB3 [[ name: "Positive Segment 3 Bend", group: "Waveshaper State", min: -1.0f, max: 1.0f, init: 0.0f, hidden: true, rampFrames: 256 ]];
    input value float32 curveB4 [[ name: "Positive Segment 4 Bend", group: "Waveshaper State", min: -1.0f, max: 1.0f, init: 0.0f, hidden: true, rampFrames: 256 ]];
    input value float32 curveB5 [[ name: "Positive Segment 5 Bend", group: "Waveshaper State", min: -1.0f, max: 1.0f, init: 0.0f, hidden: true, rampFrames: 256 ]];
    input value float32 curveB6 [[ name: "Positive Segment 6 Bend", group: "Waveshaper State", min: -1.0f, max: 1.0f, init: 0.0f, hidden: true, rampFrames: 256 ]];
    input value float32 curveB7 [[ name: "Positive Segment 7 Bend", group: "Waveshaper State", min: -1.0f, max: 1.0f, init: 0.0f, hidden: true, rampFrames: 256 ]];

    input value float32 morph [[ name: "Morph", group: "Waveshaper", min: 0.0f, max: 100.0f, init: 0.0f, unit: "%", rampFrames: 256 ]];
    input value float32 morphSide [[ name: "Morph Side", group: "Waveshaper State", min: -1.0f, max: 1.0f, init: 1.0f, discrete: true, step: 2.0f, hidden: true, rampFrames: 0 ]];
    input value float32 morphPoint [[ name: "Morph Point", group: "Waveshaper State", min: 1.0f, max: 7.0f, init: 1.0f, discrete: true, step: 1.0f, hidden: true, rampFrames: 0 ]];
    input value float32 morphTargetX [[ name: "Morph B Input", group: "Waveshaper State", min: 0.01f, max: 1.5f, init: 0.72f, hidden: true, rampFrames: 256 ]];
    input value float32 morphTargetY [[ name: "Morph B Output", group: "Waveshaper State", min: -1.5f, max: 1.5f, init: 1.05f, hidden: true, rampFrames: 256 ]];

    input value float32 curveNPointCount [[ name: "Negative Point Count", group: "Waveshaper State", min: 1.0f, max: 7.0f, init: 1.0f, discrete: true, step: 1.0f, hidden: true, rampFrames: 0 ]];
    input value float32 curveN1X [[ name: "Negative Point 1 Input Magnitude", group: "Waveshaper State", min: 0.01f, max: 1.5f, init: 1.0f, hidden: true, rampFrames: 256 ]];
    input value float32 curveN1Y [[ name: "Negative Point 1 Output", group: "Waveshaper State", min: -1.5f, max: 1.5f, init: -1.0f, hidden: true, rampFrames: 256 ]];
    input value float32 curveN2X [[ name: "Negative Point 2 Input Magnitude", group: "Waveshaper State", min: 0.01f, max: 1.5f, init: 1.08f, hidden: true, rampFrames: 256 ]];
    input value float32 curveN2Y [[ name: "Negative Point 2 Output", group: "Waveshaper State", min: -1.5f, max: 1.5f, init: -1.0f, hidden: true, rampFrames: 256 ]];
    input value float32 curveN3X [[ name: "Negative Point 3 Input Magnitude", group: "Waveshaper State", min: 0.01f, max: 1.5f, init: 1.16f, hidden: true, rampFrames: 256 ]];
    input value float32 curveN3Y [[ name: "Negative Point 3 Output", group: "Waveshaper State", min: -1.5f, max: 1.5f, init: -1.0f, hidden: true, rampFrames: 256 ]];
    input value float32 curveN4X [[ name: "Negative Point 4 Input Magnitude", group: "Waveshaper State", min: 0.01f, max: 1.5f, init: 1.24f, hidden: true, rampFrames: 256 ]];
    input value float32 curveN4Y [[ name: "Negative Point 4 Output", group: "Waveshaper State", min: -1.5f, max: 1.5f, init: -1.0f, hidden: true, rampFrames: 256 ]];
    input value float32 curveN5X [[ name: "Negative Point 5 Input Magnitude", group: "Waveshaper State", min: 0.01f, max: 1.5f, init: 1.32f, hidden: true, rampFrames: 256 ]];
    input value float32 curveN5Y [[ name: "Negative Point 5 Output", group: "Waveshaper State", min: -1.5f, max: 1.5f, init: -1.0f, hidden: true, rampFrames: 256 ]];
    input value float32 curveN6X [[ name: "Negative Point 6 Input Magnitude", group: "Waveshaper State", min: 0.01f, max: 1.5f, init: 1.4f, hidden: true, rampFrames: 256 ]];
    input value float32 curveN6Y [[ name: "Negative Point 6 Output", group: "Waveshaper State", min: -1.5f, max: 1.5f, init: -1.0f, hidden: true, rampFrames: 256 ]];
    input value float32 curveN7X [[ name: "Negative Point 7 Input Magnitude", group: "Waveshaper State", min: 0.01f, max: 1.5f, init: 1.5f, hidden: true, rampFrames: 256 ]];
    input value float32 curveN7Y [[ name: "Negative Point 7 Output", group: "Waveshaper State", min: -1.5f, max: 1.5f, init: -1.0f, hidden: true, rampFrames: 256 ]];
    input value float32 curveNB1 [[ name: "Negative Segment 1 Bend", group: "Waveshaper State", min: -1.0f, max: 1.0f, init: 0.0f, hidden: true, rampFrames: 256 ]];
    input value float32 curveNB2 [[ name: "Negative Segment 2 Bend", group: "Waveshaper State", min: -1.0f, max: 1.0f, init: 0.0f, hidden: true, rampFrames: 256 ]];
    input value float32 curveNB3 [[ name: "Negative Segment 3 Bend", group: "Waveshaper State", min: -1.0f, max: 1.0f, init: 0.0f, hidden: true, rampFrames: 256 ]];
    input value float32 curveNB4 [[ name: "Negative Segment 4 Bend", group: "Waveshaper State", min: -1.0f, max: 1.0f, init: 0.0f, hidden: true, rampFrames: 256 ]];
    input value float32 curveNB5 [[ name: "Negative Segment 5 Bend", group: "Waveshaper State", min: -1.0f, max: 1.0f, init: 0.0f, hidden: true, rampFrames: 256 ]];
    input value float32 curveNB6 [[ name: "Negative Segment 6 Bend", group: "Waveshaper State", min: -1.0f, max: 1.0f, init: 0.0f, hidden: true, rampFrames: 256 ]];
    input value float32 curveNB7 [[ name: "Negative Segment 7 Bend", group: "Waveshaper State", min: -1.0f, max: 1.0f, init: 0.0f, hidden: true, rampFrames: 256 ]];

    output event polishlab::MeterFrame meterOut;

    node leftClipper = polishlab::BipolarShapeCoreChannel * polishlab::clipOversampleFactor;
    node rightClipper = polishlab::BipolarShapeCoreChannel * polishlab::clipOversampleFactor;

    float32 reductionDbLeft;
    float32 reductionDbRight;
    float32 currentCompressorInputDb;
    float32 currentCompressorOutputDb;
    float32 currentClipInput;
    float32 currentClipOutput;

    let meterFrameCount = int32 (
        std::intrinsics::max (1.0f, float32 (processor.frequency) / polishlab::meterFramesPerSecond)
    );
    int32 meterCountdown = meterFrameCount;
    int32 meterSamples;
    int32 meterClipSamples;
    float32 meterInputPeak;
    float32 meterOutputPeak;
    float64 meterInputPower;
    float64 meterOutputPower;
    float32 meterCompressorInputDb = -120.0f;
    float32 meterCompressorOutputDb = -120.0f;
    float32 meterClipInput;
    float32 meterClipOutput;

    float32<2> compress (float32<2> signal)
    {
        let detectorInput = signal;
        let detector = float32<2> (
            std::intrinsics::abs (detectorInput[0]),
            std::intrinsics::abs (detectorInput[1])
        );
        let linkedDetector = std::intrinsics::max (detector[0], detector[1]);
        let effectiveRatio = std::intrinsics::clamp (ratio, 1.0f, 100.0f);
        let linkedTarget = polishlab::desiredGainReductionDb (
            linkedDetector, thresholdDb, effectiveRatio, kneeDb
        );
        var leftTarget = polishlab::desiredGainReductionDb (
            detector[0], thresholdDb, effectiveRatio, kneeDb
        );
        var rightTarget = polishlab::desiredGainReductionDb (
            detector[1], thresholdDb, effectiveRatio, kneeDb
        );
        let link = 1.0f;
        leftTarget += (linkedTarget - leftTarget) * link;
        rightTarget += (linkedTarget - rightTarget) * link;

        let attackCoefficient = float32 (std::intrinsics::exp (
            -1.0 / (float64 (std::intrinsics::clamp (attackMs, 0.05f, 100.0f))
                    * 0.001 * processor.frequency)
        ));
        let releaseCoefficient = float32 (std::intrinsics::exp (
            -1.0 / (float64 (std::intrinsics::clamp (releaseMs, 5.0f, 1000.0f))
                    * 0.001 * processor.frequency)
        ));
        let leftCoefficient = leftTarget < reductionDbLeft ? attackCoefficient : releaseCoefficient;
        let rightCoefficient = rightTarget < reductionDbRight ? attackCoefficient : releaseCoefficient;
        reductionDbLeft = (leftCoefficient * reductionDbLeft)
                          + ((1.0f - leftCoefficient) * leftTarget);
        reductionDbRight = (rightCoefficient * reductionDbRight)
                           + ((1.0f - rightCoefficient) * rightTarget);

        let effectiveMakeupDb = std::intrinsics::clamp (makeupDb, -24.0f, 24.0f);
        let compressed = float32<2> (
            signal[0] * std::levels::dBtoGain (reductionDbLeft + effectiveMakeupDb),
            signal[1] * std::levels::dBtoGain (reductionDbRight + effectiveMakeupDb)
        );
        let mix = 1.0f;
        let telemetryReductionDb = detector[0] >= detector[1] ? reductionDbLeft : reductionDbRight;
        let telemetryProcessedGain = std::levels::dBtoGain (
            telemetryReductionDb + effectiveMakeupDb
        );
        let telemetryMixedGain = 1.0f + ((telemetryProcessedGain - 1.0f) * mix);
        currentCompressorInputDb = polishlab::gainToDb (linkedDetector);
        currentCompressorOutputDb = currentCompressorInputDb
                                    + polishlab::gainToDb (telemetryMixedGain);
        return signal + ((compressed - signal) * mix);
    }

    float32 effectiveFirstCurvePointX()
    {
        let morph01 = polishlab::clamp01 (morph * 0.01f);
        var positiveX = curveP1X;
        var negativeX = curveN1X;
        if (int32 (morphPoint + 0.5f) == 1)
        {
            if (morphSide >= 0.0f) positiveX += (morphTargetX - positiveX) * morph01;
            else negativeX += (morphTargetX - negativeX) * morph01;
        }
        return std::intrinsics::min (
            std::intrinsics::clamp (positiveX, 0.001f, 1.5f),
            std::intrinsics::clamp (negativeX, 0.001f, 1.5f)
        );
    }

    float32<2> clip (float32<2> signal)
    {
        leftClipper.in <- signal[0];
        leftClipper.positivePointCount <- curvePointCount;
        leftClipper.positiveP1X <- curveP1X; leftClipper.positiveP1Y <- curveP1Y;
        leftClipper.positiveP2X <- curveP2X; leftClipper.positiveP2Y <- curveP2Y;
        leftClipper.positiveP3X <- curveP3X; leftClipper.positiveP3Y <- curveP3Y;
        leftClipper.positiveP4X <- curveP4X; leftClipper.positiveP4Y <- curveP4Y;
        leftClipper.positiveP5X <- curveP5X; leftClipper.positiveP5Y <- curveP5Y;
        leftClipper.positiveP6X <- curveP6X; leftClipper.positiveP6Y <- curveP6Y;
        leftClipper.positiveP7X <- curveP7X; leftClipper.positiveP7Y <- curveP7Y;
        leftClipper.positiveB1 <- curveB1; leftClipper.positiveB2 <- curveB2; leftClipper.positiveB3 <- curveB3;
        leftClipper.positiveB4 <- curveB4; leftClipper.positiveB5 <- curveB5; leftClipper.positiveB6 <- curveB6; leftClipper.positiveB7 <- curveB7;
        leftClipper.negativePointCount <- curveNPointCount;
        leftClipper.negativeP1X <- curveN1X; leftClipper.negativeP1Y <- curveN1Y;
        leftClipper.negativeP2X <- curveN2X; leftClipper.negativeP2Y <- curveN2Y;
        leftClipper.negativeP3X <- curveN3X; leftClipper.negativeP3Y <- curveN3Y;
        leftClipper.negativeP4X <- curveN4X; leftClipper.negativeP4Y <- curveN4Y;
        leftClipper.negativeP5X <- curveN5X; leftClipper.negativeP5Y <- curveN5Y;
        leftClipper.negativeP6X <- curveN6X; leftClipper.negativeP6Y <- curveN6Y;
        leftClipper.negativeP7X <- curveN7X; leftClipper.negativeP7Y <- curveN7Y;
        leftClipper.negativeB1 <- curveNB1; leftClipper.negativeB2 <- curveNB2; leftClipper.negativeB3 <- curveNB3;
        leftClipper.negativeB4 <- curveNB4; leftClipper.negativeB5 <- curveNB5; leftClipper.negativeB6 <- curveNB6; leftClipper.negativeB7 <- curveNB7;
        leftClipper.morphSide <- morphSide;
        leftClipper.morphPoint <- morphPoint;
        leftClipper.morphTargetX <- morphTargetX;
        leftClipper.morphTargetY <- morphTargetY;
        leftClipper.morphPosition <- polishlab::clamp01 (morph * 0.01f);
        leftClipper.advance();

        rightClipper.in <- signal[1];
        rightClipper.positivePointCount <- curvePointCount;
        rightClipper.positiveP1X <- curveP1X; rightClipper.positiveP1Y <- curveP1Y;
        rightClipper.positiveP2X <- curveP2X; rightClipper.positiveP2Y <- curveP2Y;
        rightClipper.positiveP3X <- curveP3X; rightClipper.positiveP3Y <- curveP3Y;
        rightClipper.positiveP4X <- curveP4X; rightClipper.positiveP4Y <- curveP4Y;
        rightClipper.positiveP5X <- curveP5X; rightClipper.positiveP5Y <- curveP5Y;
        rightClipper.positiveP6X <- curveP6X; rightClipper.positiveP6Y <- curveP6Y;
        rightClipper.positiveP7X <- curveP7X; rightClipper.positiveP7Y <- curveP7Y;
        rightClipper.positiveB1 <- curveB1; rightClipper.positiveB2 <- curveB2; rightClipper.positiveB3 <- curveB3;
        rightClipper.positiveB4 <- curveB4; rightClipper.positiveB5 <- curveB5; rightClipper.positiveB6 <- curveB6; rightClipper.positiveB7 <- curveB7;
        rightClipper.negativePointCount <- curveNPointCount;
        rightClipper.negativeP1X <- curveN1X; rightClipper.negativeP1Y <- curveN1Y;
        rightClipper.negativeP2X <- curveN2X; rightClipper.negativeP2Y <- curveN2Y;
        rightClipper.negativeP3X <- curveN3X; rightClipper.negativeP3Y <- curveN3Y;
        rightClipper.negativeP4X <- curveN4X; rightClipper.negativeP4Y <- curveN4Y;
        rightClipper.negativeP5X <- curveN5X; rightClipper.negativeP5Y <- curveN5Y;
        rightClipper.negativeP6X <- curveN6X; rightClipper.negativeP6Y <- curveN6Y;
        rightClipper.negativeP7X <- curveN7X; rightClipper.negativeP7Y <- curveN7Y;
        rightClipper.negativeB1 <- curveNB1; rightClipper.negativeB2 <- curveNB2; rightClipper.negativeB3 <- curveNB3;
        rightClipper.negativeB4 <- curveNB4; rightClipper.negativeB5 <- curveNB5; rightClipper.negativeB6 <- curveNB6; rightClipper.negativeB7 <- curveNB7;
        rightClipper.morphSide <- morphSide;
        rightClipper.morphPoint <- morphPoint;
        rightClipper.morphTargetX <- morphTargetX;
        rightClipper.morphTargetY <- morphTargetY;
        rightClipper.morphPosition <- polishlab::clamp01 (morph * 0.01f);
        rightClipper.advance();

        let shaped = float32<2> (leftClipper.out, rightClipper.out);
        let rendered = shaped;
        if (std::intrinsics::abs (signal[0]) >= std::intrinsics::abs (signal[1]))
        {
            currentClipInput = signal[0];
            currentClipOutput = rendered[0];
        }
        else
        {
            currentClipInput = signal[1];
            currentClipOutput = rendered[1];
        }
        return rendered;
    }

    void pushMeterSample (float32<2> inputSignal,
                          float32<2> outputSignal,
                          float32 clipInputMagnitude,
                          float32 firstCurvePointX)
    {
        meterInputPeak = std::intrinsics::max (
            meterInputPeak,
            std::intrinsics::max (std::intrinsics::abs (inputSignal[0]), std::intrinsics::abs (inputSignal[1]))
        );
        meterOutputPeak = std::intrinsics::max (
            meterOutputPeak,
            std::intrinsics::max (std::intrinsics::abs (outputSignal[0]), std::intrinsics::abs (outputSignal[1]))
        );
        meterInputPower += 0.5 * (float64 (inputSignal[0]) * float64 (inputSignal[0])
                                  + float64 (inputSignal[1]) * float64 (inputSignal[1]));
        meterOutputPower += 0.5 * (float64 (outputSignal[0]) * float64 (outputSignal[0])
                                   + float64 (outputSignal[1]) * float64 (outputSignal[1]));
        meterSamples += 1;

        if (currentCompressorInputDb >= meterCompressorInputDb)
        {
            meterCompressorInputDb = currentCompressorInputDb;
            meterCompressorOutputDb = currentCompressorOutputDb;
        }

        if (std::intrinsics::abs (currentClipInput) >= std::intrinsics::abs (meterClipInput))
        {
            meterClipInput = currentClipInput;
            meterClipOutput = currentClipOutput;
        }

        if (clipInputMagnitude >= firstCurvePointX)
            meterClipSamples += 1;

        meterCountdown -= 1;

        if (meterCountdown > 0)
            return;

        polishlab::MeterFrame frame;
        let sampleCount = std::intrinsics::max (1, meterSamples);
        frame.inputPeakDb = polishlab::gainToDb (meterInputPeak);
        frame.outputPeakDb = polishlab::gainToDb (meterOutputPeak);
        frame.inputRmsDb = polishlab::gainToDb (float32 (std::intrinsics::sqrt (
            meterInputPower / float64 (sampleCount)
        )));
        frame.outputRmsDb = polishlab::gainToDb (float32 (std::intrinsics::sqrt (
            meterOutputPower / float64 (sampleCount)
        )));
        frame.gainReductionDb = std::intrinsics::max (-reductionDbLeft, -reductionDbRight);
        frame.clipActivityPercent = 100.0f * float32 (meterClipSamples) / float32 (sampleCount);
        frame.compressorInputDb = meterCompressorInputDb;
        frame.compressorOutputDb = meterCompressorOutputDb;
        frame.clipInput = meterClipInput;
        frame.clipOutput = meterClipOutput;
        meterOut <- frame;

        meterCountdown = meterFrameCount;
        meterSamples = 0;
        meterClipSamples = 0;
        meterInputPeak = 0.0f;
        meterOutputPeak = 0.0f;
        meterInputPower = 0.0;
        meterOutputPower = 0.0;
        meterCompressorInputDb = -120.0f;
        meterCompressorOutputDb = -120.0f;
        meterClipInput = 0.0f;
        meterClipOutput = 0.0f;
    }

    void main()
    {
        loop
        {
            let dry = in;
            let compressed = compress (dry);
            let clipInputMagnitude = std::intrinsics::max (
                std::intrinsics::abs (compressed[0]),
                std::intrinsics::abs (compressed[1])
            );
            let firstCurvePointX = effectiveFirstCurvePointX();
            let clipped = clip (compressed);
            let wet = clipped;
            let rendered = bypass ? dry : wet;

            out <- rendered;
            pushMeterSample (dry, rendered, clipInputMagnitude, firstCurvePointX);
            advance();
        }
    }
}
