    void init()
    {
        initialiseDefaultPattern();
        for (wrap<seqfx::laneCount> lane)
        {
            filterStartHz[lane] = 2000.0f;
            filterQ[lane] = 0.707f;
            filterModeFade[lane] = 1.0f;

            crusherBits[lane] = 8;
            crusherRateHz[lane] = 48000.0f;
            crusherCharacter[lane] = 1;
            for (wrap<2> channel)
                crusherDitherRng[lane, channel].seed (1201L + int64 (int32 (lane)) * 313L + int64 (int32 (channel)) * 977L);

            ringFrequencyHz[lane] = 180.0f;
            ringRateHz[lane] = 0.5f;
            ringSpread[lane] = 0.08f;
            ringNoiseRng[lane].seed (9109L + int64 (int32 (lane)) * 1613L);

            talkBoxToVowel[lane] = 3;
            talkBoxResonance[lane] = 6.0f;
            talkBoxLows[lane] = 0.3f;
            talkBoxHighs[lane] = 0.15f;

            dirtyDriveDb[lane] = 12.0f;
            dirtyDynamics[lane] = 0.65f;
            dirtyToneHz[lane] = 12000.0f;
            dirtyTrimDb[lane] = -6.0f;

            combTuneHz[lane] = 220.0f;
            combDecaySeconds[lane] = 1.4f;
            combDispersion[lane] = 0.55f;
            combDampingHz[lane] = 7500.0f;
            combMotion[lane] = 0.12f;
            combDrive[lane] = 0.18f;
            combWidth[lane] = 0.65f;
            combTuneCurrent[lane] = combTuneHz[lane];
            combDecayCurrent[lane] = combDecaySeconds[lane];
            combDispersionCurrent[lane] = combDispersion[lane];
            combDampingCurrent[lane] = combDampingHz[lane];
            combMotionCurrent[lane] = combMotion[lane];
            combDriveCurrent[lane] = combDrive[lane];
            combWidthCurrent[lane] = combWidth[lane];

            vibroRateHz[lane] = 4.5f;
            vibroDepthCents[lane] = 28.0f;
            vibroWaveform[lane] = 0;
            vibroPreviousWaveform[lane] = 0;
            vibroWaveformFade[lane] = 1.0f;
            vibroSpreadDegrees[lane] = 90.0f;
            vibroTimingMode[lane] = seqfx::vibroTimingSync;
            vibroDivision[lane] = 2;
            vibroRateCurrent[lane] = vibroRateHz[lane];
            vibroDepthCurrent[lane] = vibroDepthCents[lane];
            vibroSpreadCurrent[lane] = vibroSpreadDegrees[lane];
            vibroHistoryFade[lane] = 0.0f;

            flangeDelayMs[lane] = 1.2f;
            flangeDepthMs[lane] = 3.5f;
            flangeRateHz[lane] = 0.28f;
            flangeFeedback[lane] = 0.55f;
            flangeSpreadDegrees[lane] = 120.0f;
            flangeFeedbackPolarity[lane] = 0;
            flangeTimingMode[lane] = seqfx::flangeTimingFree;
            flangeDivision[lane] = 5;
            flangeDelayCurrent[lane] = flangeDelayMs[lane];
            flangeDepthCurrent[lane] = flangeDepthMs[lane];
            flangeRateCurrent[lane] = flangeRateHz[lane];
            flangeFeedbackCurrent[lane] = 0.0f;
            flangeSpreadCurrent[lane] = flangeSpreadDegrees[lane];
            flangePolarityCurrent[lane] = 1.0f;
            flangePolarityTarget[lane] = 1.0f;
            flangeHistoryFade[lane] = 0.0f;

            for (wrap<seqfx::tapeVoiceCount> voice)
                tapeVoiceRestartAge[lane, voice] = seqfx::transitionCrossfadeFrames;

            stutterSliceCount[lane] = 8;
            stutterPlaybackSpeed[lane] = 1.0f;
            stutterShape[lane] = 0.55f;
            stutterGate[lane] = 0.68f;
            stutterBlockDurationFrames[lane] = 1.0f;
            stutterReadFrames[lane] = 2;
            stutterReadLength[lane] = 2.0f;

            auxBlockStartStep[lane] = 0;
            auxAgeFrames[lane] = 0.0f;
            auxDurationFrames[lane] = 1.0f;
        }
        currentStep = 0;
        currentStepFrames = 1.0;
        needsStepLatch = true;
    }

    void initialiseDefaultPattern()
    {
        for (wrap<seqfx::laneCount> lane)
        {
            for (wrap<seqfx::stepCount> step)
            {
                activeSteps[lane, step] = false;
                triggerSteps[lane, step] = false;
                stepEffectTypes[lane, step] = seqfx::effectEmpty;
                stepMix[lane, step] = 1.0f;
                stepAuxShape[lane, step] = 0.0f;
                stepAuxSourceCurve[lane, step] = 0.0f;
                stepAuxRateMode[lane, step] = seqfx::auxRateModeSlice;
                stepAuxTempoMultiplier[lane, step] = 4;
                stepAuxTempoTriplet[lane, step] = false;
                stepAuxSliceCount[lane, step] = 1;

                for (wrap<seqfx::paramCount> param)
                {
                    stepParams[lane, step, param] = 0.0f;
                    stepAuxEnabled[lane, step, param] = false;
                    stepAuxEnd[lane, step, param] = 0.0f;
                }
            }
        }

        for (wrap<seqfx::stepCount> step)
        {
            stepParams[seqfx::laneFilter, step, 0] = 0.0f;
            stepParams[seqfx::laneFilter, step, 1] = 2000.0f;
            stepParams[seqfx::laneFilter, step, 2] = 500.0f;
            stepParams[seqfx::laneFilter, step, 3] = 0.707f;
            stepParams[seqfx::laneFilter, step, 4] = 1.0f;

            stepParams[seqfx::laneCrusher, step, 0] = 8.0f;
            stepParams[seqfx::laneCrusher, step, 1] = 48000.0f;
            stepParams[seqfx::laneCrusher, step, 2] = 0.0f;
            stepParams[seqfx::laneCrusher, step, 3] = 1.0f;
            stepParams[seqfx::laneCrusher, step, 4] = 0.0f;
            stepParams[seqfx::laneCrusher, step, 5] = 0.0f;
            stepParams[seqfx::laneCrusher, step, 6] = 0.0f;

            stepParams[seqfx::laneTapeStop, step, 0] = 8.0f;
            stepParams[seqfx::laneTapeStop, step, 1] = 0.0f;
            stepParams[seqfx::laneTapeStop, step, 2] = 0.0f;
            stepParams[seqfx::laneTapeStop, step, 3] = 1.0f;
            stepParams[seqfx::laneTapeStop, step, 4] = 0.0f;
            stepParams[seqfx::laneTapeStop, step, 5] = 0.0f;
            stepParams[seqfx::laneTapeStop, step, 6] = 500.0f;
            stepParams[seqfx::laneTapeStop, step, 7] = 125.0f;

            stepParams[seqfx::laneStutter, step, 0] = 8.0f;
            stepParams[seqfx::laneStutter, step, 1] = 1.0f;
            stepParams[seqfx::laneStutter, step, 2] = 0.55f;
            stepParams[seqfx::laneStutter, step, 3] = 0.68f;
        }

        for (wrap<seqfx::laneCount> lane)
        {
            for (wrap<seqfx::stepCount> step)
            {
                for (wrap<seqfx::paramCount> param)
                    stepAuxEnd[lane, step, param] = stepParams[lane, step, param];
            }
        }
    }

    event patternUpload (seqfx::SeqPatternUpload upload)
    {
        let uploadPatternIndex = seqfx::clampInt (upload.patternIndex, 0, seqfx::patternCount - 1);
        let uploadPatternSlot = wrap<seqfx::patternCount> (uploadPatternIndex);
        let acceptedRevision = acceptedRevisions[uploadPatternSlot];

        if (! upload.authoritative && upload.revision < acceptedRevision)
            return;

        acceptedRevisions[uploadPatternSlot] = upload.revision;

        if (uploadPatternIndex != selectedPatternIndex)
            return;

        var currentCellChanged = upload.authoritative;

        for (wrap<seqfx::laneCount> lane)
        {
            let currentLaneEffect = selectedEffectForStep (lane, currentStep);
            let currentLaneBlockStart = auxBlockStartStep[lane];

            for (wrap<seqfx::stepCount> step)
            {
                let nextActive = upload.activeSteps[lane, step];
                let nextEffectType = nextActive
                    ? seqfx::clampInt (upload.effectTypes[lane, step], seqfx::effectEmpty, seqfx::effectDirty)
                    : seqfx::effectEmpty;
                let watchesCurrentPlayback = step == currentStep
                    || (currentLaneEffect != seqfx::effectEmpty && step == currentLaneBlockStart);

                if (watchesCurrentPlayback && ! currentCellChanged)
                {
                    let currentEffectType = activeSteps[lane, step]
                        ? seqfx::clampInt (stepEffectTypes[lane, step], seqfx::effectEmpty, seqfx::effectDirty)
                        : seqfx::effectEmpty;

                    if (nextActive != activeSteps[lane, step]
                        || upload.triggerSteps[lane, step] != triggerSteps[lane, step]
                        || nextEffectType != currentEffectType
                        || upload.mix[lane, step] != stepMix[lane, step]
                        || upload.auxShape[lane, step] != stepAuxShape[lane, step]
                        || upload.auxSourceCurve[lane, step] != stepAuxSourceCurve[lane, step]
                        || upload.auxRateMode[lane, step] != stepAuxRateMode[lane, step]
                        || upload.auxTempoMultiplier[lane, step] != stepAuxTempoMultiplier[lane, step]
                        || upload.auxTempoTriplet[lane, step] != stepAuxTempoTriplet[lane, step]
                        || upload.auxSliceCount[lane, step] != stepAuxSliceCount[lane, step])
                    {
                        currentCellChanged = true;
                    }

                    for (wrap<seqfx::paramCount> param)
                    {
                        if (upload.params[lane, step, param] != stepParams[lane, step, param])
                            currentCellChanged = true;

                        if (upload.auxEnabled[lane, step, param] != stepAuxEnabled[lane, step, param]
                            || upload.auxEnd[lane, step, param] != stepAuxEnd[lane, step, param])
                        {
                            currentCellChanged = true;
                        }
                    }
                }

                activeSteps[lane, step] = nextActive;
                triggerSteps[lane, step] = upload.triggerSteps[lane, step];
                stepEffectTypes[lane, step] = nextEffectType;
                stepMix[lane, step] = seqfx::clampFloat (upload.mix[lane, step], 0.0f, 1.0f);
                stepAuxShape[lane, step] = seqfx::clampFloat (upload.auxShape[lane, step], -1.0f, 1.0f);
                stepAuxSourceCurve[lane, step] = seqfx::clampFloat (upload.auxSourceCurve[lane, step], -1.0f, 1.0f);
                stepAuxRateMode[lane, step] = seqfx::clampInt (upload.auxRateMode[lane, step], seqfx::auxRateModeTempo, seqfx::auxRateModeSlice);
                stepAuxTempoMultiplier[lane, step] = seqfx::clampInt (upload.auxTempoMultiplier[lane, step], 1, 64);
                stepAuxTempoTriplet[lane, step] = upload.auxTempoTriplet[lane, step];
                stepAuxSliceCount[lane, step] = seqfx::clampInt (upload.auxSliceCount[lane, step], 1, 32);

                for (wrap<seqfx::paramCount> param)
                {
                    stepParams[lane, step, param] = upload.params[lane, step, param];
                    stepAuxEnabled[lane, step, param] = upload.auxEnabled[lane, step, param];
                    stepAuxEnd[lane, step, param] = upload.auxEnd[lane, step, param];
                }
            }
        }

        if (currentCellChanged)
        {
            if (upload.authoritative)
                processingResetRequested = true;

            relatchingFromPatternUpload = true;
            needsStepLatch = true;
        }
    }

    event internalPlay (int32 value)
    {
        internalRunning = value != 0;
        needsStepLatch = true;
    }

    event internalReset (int32 value)
    {
        if (value == 0)
            return;

        resetRequested = true;
    }

    event tempoIn (std::timeline::Tempo tempo)
    {
        hostBpm = seqfx::clampFloat (tempo.bpm, 20.0f, 300.0f);
        hasHostPositionAnchor = false;
    }

    event transportStateIn (std::timeline::TransportState state)
    {
        let wasHostRunning = hostRunning;
        hostRunning = state.isPlaying();
        if (wasHostRunning && ! hostRunning)
        {
            processingResetRequested = true;
            relatchingFromPatternUpload = false;
        }
    }

    event positionIn (std::timeline::Position position)
    {
        if (hasHostPositionAnchor)
        {
            let elapsedFrames = renderedFrameCounter - renderedFrameAtLastHostPosition;
            let expectedFrameIndex = lastHostFrameIndex + elapsedFrames;
            let frameDelta = position.frameIndex - expectedFrameIndex;
            let expectedQuarterNote = lastHostQuarterNote
                + (float64 (elapsedFrames) / (processor.frequency * (60.0 / float64 (hostBpm))));
            let quarterNoteDelta = position.quarterNote - expectedQuarterNote;

            if (frameDelta < -8 || frameDelta > 8
                || quarterNoteDelta < -0.02 || quarterNoteDelta > 0.02)
            {
                processingResetRequested = true;
            }
        }

        hasHostPositionAnchor = true;
        renderedFrameAtLastHostPosition = renderedFrameCounter;
        lastHostFrameIndex = position.frameIndex;
        lastHostQuarterNote = position.quarterNote;
        hostQuarterNote = position.quarterNote;
        hostPositionPending = true;
    }

    int32 snapValue (float32 value, int32 minValue, int32 maxValue)
    {
        return seqfx::clampInt (seqfx::roundToInt (value), minValue, maxValue);
    }

    int32 resolveClockMode()
    {
        return snapValue (clockMode, 0, 2);
    }

    int32 resolveLoopStart()
    {
        return snapValue (loopStart, 0, seqfx::stepCount - 1);
    }

    int32 resolveLoopLength()
    {
        let start = resolveLoopStart();
        let maximum = seqfx::stepCount - start;
        return snapValue (loopLength, 1, maximum);
    }

    int32 resolveLoopEndExclusive()
    {
        return resolveLoopStart() + resolveLoopLength();
    }

    int32 resolveRate()
    {
        return snapValue (rate, 0, 2);
    }

    float64 stepQuarterNotes()
    {
        let snappedRate = resolveRate();

        if (snappedRate == 0)
            return 0.5;

        if (snappedRate == 2)
            return 0.125;

        return 0.25;
    }

    float64 framesPerQuarter()
    {
        let bpm = seqfx::clampFloat (resolveClockMode() == 0 ? hostBpm : manualBpm, 20.0f, 300.0f);
        return processor.frequency * (60.0 / float64 (bpm));
    }

    float64 stepDurationFramesForStep (int32 step)
    {
        let base = framesPerQuarter() * stepQuarterNotes();
        let start = resolveLoopStart();
        let relativeStep = std::intrinsics::max (0, step - start);
        let swingAmount = float64 (seqfx::clampFloat (swing, 0.0f, 0.45f));

        if ((relativeStep % 2) == 0)
            return std::intrinsics::max (16.0, base * (1.0 - swingAmount));

        return std::intrinsics::max (16.0, base * (1.0 + swingAmount));
    }

    int32 nextStepInLoop (int32 step)
    {
        let next = step + 1;

        if (next >= resolveLoopEndExclusive())
            return resolveLoopStart();

        return next;
    }

    int32 previousStepInLoop (int32 step)
    {
        let start = resolveLoopStart();

        if (step <= start)
            return resolveLoopEndExclusive() - 1;

        return step - 1;
    }

    bool isClockRunning()
    {
        let mode = resolveClockMode();

        if (mode == 0)
            return hostRunning;

        if (mode == 1)
            return internalRunning;

        return true;
    }

    void resetClockToLoopStart()
    {
        currentStep = resolveLoopStart();
        stepProgressFrames = 0.0;
        currentStepFrames = stepDurationFramesForStep (currentStep);
    }

    void refreshControlTransitions()
    {
        let nextClockMode = resolveClockMode();
        let nextRate = resolveRate();
        let nextLoopStart = resolveLoopStart();
        let nextLoopLength = resolveLoopLength();
        let nextEnabled = enabled >= 0.5f;

        if (! controlStateReady)
        {
            cachedClockMode = nextClockMode;
            cachedRate = nextRate;
            cachedLoopStart = nextLoopStart;
            cachedLoopLength = nextLoopLength;
            previousEnabled = nextEnabled;
            bypassMixCurrent = nextEnabled ? 1.0f : 0.0f;
            bypassMixTarget = bypassMixCurrent;
            controlStateReady = true;
            return;
        }

        if (nextClockMode != cachedClockMode
            || nextRate != cachedRate
            || nextLoopStart != cachedLoopStart
            || nextLoopLength != cachedLoopLength)
        {
            cachedClockMode = nextClockMode;
            cachedRate = nextRate;
            cachedLoopStart = nextLoopStart;
            cachedLoopLength = nextLoopLength;
            resetClockToLoopStart();
            processingResetRequested = true;
            relatchingFromPatternUpload = false;
            needsStepLatch = true;
            hasHostPositionAnchor = false;
        }

        if (nextEnabled != previousEnabled)
        {
            bypassMixTarget = nextEnabled ? 1.0f : 0.0f;

            if (! nextEnabled)
                bypassFlushPending = true;
            else if (bypassFlushPending)
            {
                processingResetRequested = true;
                bypassFlushPending = false;
            }

            previousEnabled = nextEnabled;
        }
    }

    void syncHostStepFromQuarterNote()
    {
        let start = resolveLoopStart();
        let length = resolveLoopLength();
        let absoluteStep = int64 (std::intrinsics::floor (hostQuarterNote / stepQuarterNotes()));
        var relative = int32 (absoluteStep % int64 (length));

        if (relative < 0)
            relative += length;

        let nextStep = start + relative;

        if (nextStep != currentStep)
        {
            currentStep = nextStep;
            stepProgressFrames = 0.0;
            currentStepFrames = stepDurationFramesForStep (currentStep);
            releaseTimeEffects();
            relatchingFromPatternUpload = false;
            needsStepLatch = true;
        }
    }

    void refreshSelectedPattern()
    {
        let nextPattern = snapValue (patternSelect, 0, seqfx::patternCount - 1);

        if (nextPattern == selectedPatternIndex)
            return;

        selectedPatternIndex = nextPattern;
        processingResetRequested = true;
        relatchingFromPatternUpload = false;
        needsStepLatch = true;
    }

    void releaseTimeEffects()
    {
        for (wrap<seqfx::laneCount> lane)
        {
            stutterCapturing[lane] = false;
            stutterPlaying[lane] = false;
            tapeMixTarget[lane] = 0.0f;
            stutterMixTarget[lane] = 0.0f;
        }
    }

    void resetProcessingState()
    {
        if (hasProcessedStage)
        {
            resetCrossfadeFrom = lastProcessedStage;
            resetCrossfadeAge = 0.0f;
        }
        else
        {
            resetCrossfadeAge = seqfx::transitionCrossfadeFrames;
        }

        releaseTimeEffects();

        for (wrap<seqfx::laneCount> lane)
        {
            tapePrimaryValidSamples[lane] = 0;
            tapeCoarseValidSamples[lane] = 0;
            tapePrimarySamplesWritten[lane] = 0;
            tapeCoarseSamplesWritten[lane] = 0;
            tapePrimaryWriteIndex[lane] = 0;
            tapeCoarseWriteIndex[lane] = 0;
            tapePrimaryWritePhase[lane] = 0.0f;
            tapeCoarseWritePhase[lane] = 0.0f;
            tapePreviousHostSample[lane] = float32<2> (0.0f);
            tapeCoarseLowpassState[lane] = float32<2> (0.0f);
            for (wrap<seqfx::tapeVoiceCount> voice)
            {
                tapeVoiceActive[lane, voice] = false;
                tapeVoiceAgeFrames[lane, voice] = 0.0f;
                tapeVoiceGainCurrent[lane, voice] = 0.0f;
                tapeVoiceGainTarget[lane, voice] = 0.0f;
                tapeVoiceLastOutput[lane, voice] = float32<2> (0.0f);
                tapeVoiceToneState[lane, voice] = float32<2> (0.0f);
                tapeVoiceRestartAge[lane, voice] = seqfx::transitionCrossfadeFrames;
            }

            stutterCapturing[lane] = false;
            stutterPlaying[lane] = false;
            stutterCaptureFrames[lane] = 0.0f;
            stutterPhaseFrames[lane] = 0.0f;

            filterStates[lane, 0].reset();
            filterStates[lane, 1].reset();
            filterModeFade[lane] = 0.0f;
            crusherHeld[lane] = float32<2> (0.0f);
            crusherPreviousHeld[lane] = float32<2> (0.0f);
            crusherPreviousCapture[lane] = float32<2> (0.0f);
            crusherProgressiveOutput[lane] = float32<2> (0.0f);
            crusherAdcState[lane] = float32<2> (0.0f);
            crusherDacState[lane] = float32<2> (0.0f);
            crusherDcPreviousInput[lane] = float32<2> (0.0f);
            crusherDcPreviousOutput[lane] = float32<2> (0.0f);
            crusherCapturePhase[lane] = 0.0f;
            crusherHoldCounter[lane] = 0;
            crusherNeedsRecapture[lane] = true;
            for (wrap<2> channel)
                crusherDitherRng[lane, channel].seed (1201L + int64 (int32 (lane)) * 313L + int64 (int32 (channel)) * 977L);

            ringCarrierPhase[lane] = float32<2> (0.0f);
            ringMotionPhase[lane] = 0.0f;
            ringNoiseState[lane] = float32<2> (0.0f);
            ringNoiseRng[lane].seed (9109L + int64 (int32 (lane)) * 1613L);

            for (wrap<2> formant)
                for (wrap<2> channel)
                    talkBoxFormantStates[lane, formant, channel].reset();
            talkBoxLowState[lane] = float32<2> (0.0f);
            talkBoxHighLowState[lane] = float32<2> (0.0f);
            dirtyDcPreviousInput[lane] = float32<2> (0.0f);
            dirtyDcPreviousOutput[lane] = float32<2> (0.0f);
            dirtyToneState[lane] = float32<2> (0.0f);
            dirtyInputPower[lane] = 0.0f;
            dirtyOutputPower[lane] = 0.0f;
            resetCombNetwork (lane);
            combTailAgeFrames[lane] = 0.0f;
            combTailEnergy[lane] = 0.0f;
            combMotionPhase[lane] = 0.0f;
            combMixCurrent[lane] = 0.0f;
            combMixTarget[lane] = 0.0f;
            combGateCurrent[lane] = 0.0f;
            combGateTarget[lane] = 0.0f;
            combTailActive[lane] = false;
            vibroWriteIndex[lane] = 0;
            vibroValidSamples[lane] = 0;
            vibroMixCurrent[lane] = 0.0f;
            vibroMixTarget[lane] = 0.0f;
            vibroHistoryFade[lane] = 0.0f;
            vibroPhase[lane] = 0.0f;
            vibroPreviousWaveform[lane] = vibroWaveform[lane];
            vibroWaveformFade[lane] = 1.0f;
            flangeWriteIndex[lane] = 0;
            flangeValidSamples[lane] = 0;
            flangeFeedbackCurrent[lane] = 0.0f;
            flangeMixCurrent[lane] = 0.0f;
            flangeMixTarget[lane] = 0.0f;
            flangeHistoryFade[lane] = 0.0f;
            flangePhase[lane] = 0.0f;
            flangePolarityCurrent[lane] = flangeFeedbackPolarity[lane] == 0 ? 1.0f : -1.0f;
            flangePolarityTarget[lane] = flangePolarityCurrent[lane];
            filterActive[lane] = false;
            crusherActive[lane] = false;
            ringActive[lane] = false;
            talkBoxActive[lane] = false;
            dirtyActive[lane] = false;
            combActive[lane] = false;
            vibroActive[lane] = false;
            flangeActive[lane] = false;
            tapeLaneActive[lane] = false;
            stutterLaneActive[lane] = false;
            chainPreviousEffectType[lane] = chainEffectType[lane];
            chainEffectType[lane] = seqfx::effectEmpty;
            chainLifecycleState[lane] = seqfx::lifecycleResetting;
            chainLifecycleAge[lane] = 0.0f;
        }

        dirtyCores.reset();

        needsStepLatch = true;
        processingResetRequested = false;
    }

    int32 selectedEffectForStep (wrap<seqfx::laneCount> lane, int32 step)
    {
        let stepIndex = wrap<seqfx::stepCount> (step);

        if (! activeSteps[lane, stepIndex])
            return seqfx::effectEmpty;

        return seqfx::clampInt (stepEffectTypes[lane, stepIndex], seqfx::effectEmpty, seqfx::effectDirty);
    }

    float32 segmentDurationFrames (wrap<seqfx::laneCount> lane, int32 step)
    {
        var sum = 0.0;
        var cursor = step;
        let effectType = selectedEffectForStep (lane, step);

        for (int32 offset = 0; offset < seqfx::stepCount; ++offset)
        {
            if (selectedEffectForStep (lane, cursor) != effectType || effectType == seqfx::effectEmpty)
                break;

            let cursorIndex = wrap<seqfx::stepCount> (cursor);

            if (offset > 0 && triggerSteps[lane, cursorIndex])
                break;

            sum += stepDurationFramesForStep (cursor);
            cursor = nextStepInLoop (cursor);

            if (cursor == step)
                break;
        }

        return float32 (std::intrinsics::max (1.0, sum));
    }

    int32 blockStartStep (wrap<seqfx::laneCount> lane, int32 step)
    {
        var cursor = step;
        let effectType = selectedEffectForStep (lane, step);

        for (int32 offset = 0; offset < seqfx::stepCount; ++offset)
        {
            let cursorIndex = wrap<seqfx::stepCount> (cursor);

            if (triggerSteps[lane, cursorIndex])
                return cursor;

            let previous = previousStepInLoop (cursor);

            if (previous == step || selectedEffectForStep (lane, previous) != effectType || effectType == seqfx::effectEmpty)
                return cursor;

            cursor = previous;
        }

        return cursor;
    }

    float32 elapsedFramesFromBlockStart (wrap<seqfx::laneCount> lane, int32 startStep, int32 targetStep)
    {
        var sum = 0.0;
        var cursor = startStep;
        let effectType = selectedEffectForStep (lane, startStep);

        for (int32 offset = 0; offset < seqfx::stepCount; ++offset)
        {
            if (cursor == targetStep)
                return float32 (sum);

            if (selectedEffectForStep (lane, cursor) != effectType || effectType == seqfx::effectEmpty)
                break;

            let cursorIndex = wrap<seqfx::stepCount> (cursor);

            if (offset > 0 && triggerSteps[lane, cursorIndex])
                break;

            sum += stepDurationFramesForStep (cursor);
            cursor = nextStepInLoop (cursor);

            if (cursor == startStep)
                break;
        }

        return 0.0f;
    }

    float32 auxBlockPhaseForLane (wrap<seqfx::laneCount> lane)
    {
        return seqfx::clampFloat (
            auxAgeFrames[lane] / std::intrinsics::max (1.0f, auxDurationFrames[lane]),
            0.0f,
            1.0f
        );
    }

    float32 auxCycleDurationFramesForLane (wrap<seqfx::laneCount> lane)
    {
        let blockStartIndex = wrap<seqfx::stepCount> (auxBlockStartStep[lane]);
        let rateMode = stepAuxRateMode[lane, blockStartIndex];

        if (rateMode == seqfx::auxRateModeTempo)
        {
            let multiplier = seqfx::clampInt (stepAuxTempoMultiplier[lane, blockStartIndex], 1, 64);
            var duration = float32 (framesPerQuarter() * 0.25 * float64 (multiplier));

            if (stepAuxTempoTriplet[lane, blockStartIndex])
                duration *= 0.6666666667f;

            return std::intrinsics::max (1.0f, duration);
        }

        let sliceCount = seqfx::clampInt (stepAuxSliceCount[lane, blockStartIndex], 1, 32);
        return std::intrinsics::max (1.0f, auxDurationFrames[lane] / float32 (sliceCount));
    }

    float32 auxCyclePhaseForLane (wrap<seqfx::laneCount> lane)
    {
        return seqfx::unitWrap (auxAgeFrames[lane] / auxCycleDurationFramesForLane (lane));
    }

    float32 auxAmountForLane (wrap<seqfx::laneCount> lane)
    {
        let blockStartIndex = wrap<seqfx::stepCount> (auxBlockStartStep[lane]);
        return seqfx::auxSourceAt (
            auxCyclePhaseForLane (lane),
            stepAuxShape[lane, blockStartIndex],
            stepAuxSourceCurve[lane, blockStartIndex]
        );
    }

    float32 auxParamValue (wrap<seqfx::laneCount> lane, int32 param, float32 startValue)
    {
        let blockStartIndex = wrap<seqfx::stepCount> (auxBlockStartStep[lane]);
        let paramIndex = wrap<seqfx::paramCount> (param);

        if (! stepAuxEnabled[lane, blockStartIndex, paramIndex])
            return startValue;

        let amount = auxAmountForLane (lane);
        let endValue = stepAuxEnd[lane, blockStartIndex, paramIndex];
        return startValue + ((endValue - startValue) * amount);
    }

    float32 auxLogParamValue (
        wrap<seqfx::laneCount> lane,
        int32 param,
        float32 startValue,
        float32 minValue,
        float32 maxValue)
    {
        let blockStartIndex = wrap<seqfx::stepCount> (auxBlockStartStep[lane]);
        let paramIndex = wrap<seqfx::paramCount> (param);
        let safeStart = seqfx::clampFloat (startValue, minValue, maxValue);

        if (! stepAuxEnabled[lane, blockStartIndex, paramIndex])
            return safeStart;

        let amount = auxAmountForLane (lane);
        let safeEnd = seqfx::clampFloat (stepAuxEnd[lane, blockStartIndex, paramIndex], minValue, maxValue);
        return seqfx::clampFloat (
            std::intrinsics::exp (
                std::intrinsics::log (safeStart)
                    + ((std::intrinsics::log (safeEnd) - std::intrinsics::log (safeStart)) * amount)
            ),
            minValue,
            maxValue
        );
    }

    float32 auxCutoffValue (wrap<seqfx::laneCount> lane, int32 param, float32 startValue)
    {
        let blockStartIndex = wrap<seqfx::stepCount> (auxBlockStartStep[lane]);
        let paramIndex = wrap<seqfx::paramCount> (param);

        if (! stepAuxEnabled[lane, blockStartIndex, paramIndex])
            return clampCutoffHz (startValue);

        let amount = auxAmountForLane (lane);
        let endValue = clampCutoffHz (stepAuxEnd[lane, blockStartIndex, paramIndex]);
        return clampCutoffHz (seqfx::logLerpHz (startValue, endValue, amount));
    }

    void latchAuxBlock (wrap<seqfx::laneCount> lane, int32 blockStart)
    {
        auxBlockStartStep[lane] = blockStart;
        auxAgeFrames[lane] = elapsedFramesFromBlockStart (lane, blockStart, currentStep) + float32 (stepProgressFrames);
        auxDurationFrames[lane] = segmentDurationFrames (lane, blockStart);
    }

    void advanceAuxBlock (wrap<seqfx::laneCount> lane)
    {
        if (selectedEffectForStep (lane, currentStep) == seqfx::effectEmpty)
        {
            auxAgeFrames[lane] = 0.0f;
            return;
        }

        auxAgeFrames[lane] += 1.0f;
    }

    void latchStep()
    {
        for (wrap<seqfx::laneCount> lane)
            latchChainStep (lane);

        emitMonitor();
    }

    void latchChainLifecycle (wrap<seqfx::laneCount> lane, int32 effectType)
    {
        let previousEffect = chainEffectType[lane];
        let currentStepIndex = wrap<seqfx::stepCount> (currentStep);

        if (effectType == seqfx::effectEmpty)
        {
            if (previousEffect != seqfx::effectEmpty)
            {
                chainPreviousEffectType[lane] = previousEffect;
                chainEffectType[lane] = seqfx::effectEmpty;
                chainLifecycleState[lane] = seqfx::lifecycleReleased;
                chainLifecycleAge[lane] = 0.0f;
            }
            else if (chainLifecycleState[lane] == seqfx::lifecycleResetting)
            {
                chainLifecycleState[lane] = seqfx::lifecycleIdle;
            }

            return;
        }

        let retriggered = triggerSteps[lane, currentStepIndex] && ! relatchingFromPatternUpload;
        if (effectType != previousEffect || retriggered)
        {
            chainPreviousEffectType[lane] = previousEffect;
            chainEffectType[lane] = effectType;
            chainLifecycleState[lane] = seqfx::lifecycleEntering;
            chainLifecycleAge[lane] = 0.0f;
            return;
        }

        chainLifecycleState[lane] = seqfx::lifecycleActive;
    }

    void advanceChainLifecycle (wrap<seqfx::laneCount> lane)
    {
        let state = chainLifecycleState[lane];

        if (state != seqfx::lifecycleEntering && state != seqfx::lifecycleReleased)
            return;

        chainLifecycleAge[lane] += 1.0f;
        if (chainLifecycleAge[lane] < seqfx::transitionCrossfadeFrames)
            return;

        if (state == seqfx::lifecycleEntering)
            chainLifecycleState[lane] = seqfx::lifecycleActive;
        else
            chainLifecycleState[lane] = seqfx::lifecycleIdle;
    }

    void latchChainStep (wrap<seqfx::laneCount> lane)
    {
        let currentStepIndex = wrap<seqfx::stepCount> (currentStep);
        let effectType = selectedEffectForStep (lane, currentStep);
        let targetMix = effectType == seqfx::effectEmpty ? 0.0f : stepMix[lane, currentStepIndex];
        let wasFilterActive = filterActive[lane];
        let wasCrusherActive = crusherActive[lane];
        let wasRingActive = ringActive[lane];
        let wasTalkBoxActive = talkBoxActive[lane];
        let wasDirtyActive = dirtyActive[lane];
        let wasCombActive = combActive[lane];
        let wasVibroActive = vibroActive[lane];
        let wasFlangeActive = flangeActive[lane];
        let wasTapeActive = tapeLaneActive[lane];
        let wasStutterActive = stutterLaneActive[lane];

        latchChainLifecycle (lane, effectType);

        filterActive[lane] = effectType == seqfx::effectFilter;
        crusherActive[lane] = effectType == seqfx::effectCrusher;
        ringActive[lane] = effectType == seqfx::effectRing;
        talkBoxActive[lane] = effectType == seqfx::effectTalkBox;
        dirtyActive[lane] = effectType == seqfx::effectDirty;
        combActive[lane] = effectType == seqfx::effectComb;
        vibroActive[lane] = effectType == seqfx::effectVibro;
        flangeActive[lane] = effectType == seqfx::effectFlange;
        tapeLaneActive[lane] = effectType == seqfx::effectTapeStop;
        stutterLaneActive[lane] = effectType == seqfx::effectStutter;

        filterMixTarget[lane] = filterActive[lane] ? targetMix : 0.0f;
        crusherMixTarget[lane] = crusherActive[lane] ? targetMix : 0.0f;
        ringMixTarget[lane] = ringActive[lane] ? targetMix : 0.0f;
        talkBoxMixTarget[lane] = talkBoxActive[lane] ? targetMix : 0.0f;
        dirtyMixTarget[lane] = dirtyActive[lane] ? targetMix : 0.0f;
        combGateTarget[lane] = combActive[lane] ? 1.0f : 0.0f;
        if (combActive[lane])
            combMixTarget[lane] = targetMix;
        vibroMixTarget[lane] = vibroActive[lane] ? targetMix : 0.0f;
        flangeMixTarget[lane] = flangeActive[lane] ? targetMix : 0.0f;
        tapeMixTarget[lane] = tapeLaneActive[lane] ? targetMix : 0.0f;
        stutterMixTarget[lane] = stutterLaneActive[lane] ? targetMix : 0.0f;

        if (effectType != seqfx::effectEmpty)
            latchAuxBlock (lane, blockStartStep (lane, currentStep));
        else
        {
            auxAgeFrames[lane] = 0.0f;
            auxDurationFrames[lane] = 1.0f;
        }

        if (! stutterLaneActive[lane])
        {
            stutterCapturing[lane] = false;
            stutterPlaying[lane] = false;
        }

        if (filterActive[lane])
            latchFilterStep (lane, wasFilterActive);

        if (crusherActive[lane])
            latchCrusherStep (lane, wasCrusherActive);

        if (ringActive[lane])
            latchRingStep (lane, wasRingActive);

        if (talkBoxActive[lane])
            latchTalkBoxStep (lane, wasTalkBoxActive);

        if (dirtyActive[lane])
            latchDirtyStep (lane, wasDirtyActive);

        if (combActive[lane])
            latchCombStep (lane, wasCombActive);

        if (vibroActive[lane])
            latchVibroStep (lane, wasVibroActive);

        if (flangeActive[lane])
            latchFlangeStep (lane, wasFlangeActive);

        if (tapeLaneActive[lane])
            latchTapeStep (lane, wasTapeActive);

        if (stutterLaneActive[lane])
            latchStutterStep (lane, wasStutterActive);
    }

    float32 clampCutoffHz (float32 value)
    {
        let maximum = std::intrinsics::min (20000.0f, float32 (processor.frequency) * 0.45f);
        return seqfx::clampFloat (value, 20.0f, maximum);
    }

    void latchFilterStep (wrap<seqfx::laneCount> lane, bool wasActive)
    {
        let currentStepIndex = wrap<seqfx::stepCount> (currentStep);

        if (wasActive && ! triggerSteps[lane, currentStepIndex] && ! relatchingFromPatternUpload)
            return;

        let blockStart = blockStartStep (lane, currentStep);
        let blockStartIndex = wrap<seqfx::stepCount> (blockStart);
        previousFilterMode[lane] = filterMode[lane];
        filterMode[lane] = snapValue (stepParams[lane, blockStartIndex, 0], 0, 2);
        filterStartHz[lane] = clampCutoffHz (stepParams[lane, blockStartIndex, 1]);
        filterQ[lane] = seqfx::clampFloat (stepParams[lane, blockStartIndex, 3], 0.1f, 20.0f);

        if (filterMode[lane] != previousFilterMode[lane])
        {
            filterStates[lane, 0].reset();
            filterStates[lane, 1].reset();
            filterModeFade[lane] = 0.0f;
        }
    }

    void latchCrusherStep (wrap<seqfx::laneCount> lane, bool wasActive)
    {
        let currentStepIndex = wrap<seqfx::stepCount> (currentStep);

        if (wasActive && ! triggerSteps[lane, currentStepIndex] && ! relatchingFromPatternUpload)
            return;

        let blockStart = blockStartStep (lane, currentStep);
        let blockStartIndex = wrap<seqfx::stepCount> (blockStart);
        let nextBits = snapValue (stepParams[lane, blockStartIndex, 0], 2, 16);
        let nextRateHz = seqfx::clampFloat (stepParams[lane, blockStartIndex, 1], 200.0f, 48000.0f);
        let nextDriveDb = seqfx::clampFloat (stepParams[lane, blockStartIndex, 2], 0.0f, 36.0f);
        let nextCharacter = snapValue (stepParams[lane, blockStartIndex, 3], 0, 3);
        let nextAdcQuality = seqfx::clampFloat (stepParams[lane, blockStartIndex, 4], 0.0f, 1.0f);
        let nextDacQuality = seqfx::clampFloat (stepParams[lane, blockStartIndex, 5], 0.0f, 1.0f);
        let nextDither = seqfx::clampFloat (stepParams[lane, blockStartIndex, 6], 0.0f, 1.0f);
        let needsFreshHeldSample = ! wasActive
            || triggerSteps[lane, currentStepIndex]
            || nextRateHz != crusherRateHz[lane]
            || nextDriveDb != crusherDriveDb[lane]
            || nextCharacter != crusherCharacter[lane];

        crusherBits[lane] = nextBits;
        crusherRateHz[lane] = nextRateHz;
        crusherDriveDb[lane] = nextDriveDb;
        crusherCharacter[lane] = nextCharacter;
        crusherAdcQuality[lane] = nextAdcQuality;
        crusherDacQuality[lane] = nextDacQuality;
        crusherDither[lane] = nextDither;

        if (needsFreshHeldSample)
        {
            crusherHoldCounter[lane] = 0;
            crusherCapturePhase[lane] = 0.0f;
            crusherNeedsRecapture[lane] = true;
        }
    }

    void latchTapeStep (wrap<seqfx::laneCount> lane, bool wasActive)
    {
        let currentStepIndex = wrap<seqfx::stepCount> (currentStep);

        if (! wasActive || (triggerSteps[lane, currentStepIndex] && ! relatchingFromPatternUpload))
        {
            let blockStart = blockStartStep (lane, currentStep);
            let blockStartIndex = wrap<seqfx::stepCount> (blockStart);
            startTapeStop (lane, blockStartIndex);
        }
    }

    void latchRingStep (wrap<seqfx::laneCount> lane, bool wasActive)
    {
        let currentStepIndex = wrap<seqfx::stepCount> (currentStep);

        if (wasActive && ! triggerSteps[lane, currentStepIndex] && ! relatchingFromPatternUpload)
            return;

        let blockStart = blockStartStep (lane, currentStep);
        let blockStartIndex = wrap<seqfx::stepCount> (blockStart);
        ringFrequencyHz[lane] = seqfx::clampFloat (stepParams[lane, blockStartIndex, 0], 0.1f, 12000.0f);
        ringWaveform[lane] = snapValue (stepParams[lane, blockStartIndex, 1], 0, 3);
        ringMotion[lane] = seqfx::clampFloat (stepParams[lane, blockStartIndex, 2], 0.0f, 1.0f);
        ringRateHz[lane] = seqfx::clampFloat (stepParams[lane, blockStartIndex, 3], 0.02f, 20.0f);
        ringSpread[lane] = seqfx::clampFloat (stepParams[lane, blockStartIndex, 4], 0.0f, 1.0f);
        ringBias[lane] = seqfx::clampFloat (stepParams[lane, blockStartIndex, 5], -1.0f, 1.0f);
        ringRectify[lane] = seqfx::clampFloat (stepParams[lane, blockStartIndex, 6], -1.0f, 1.0f);
    }

    void latchTalkBoxStep (wrap<seqfx::laneCount> lane, bool wasActive)
    {
        let currentStepIndex = wrap<seqfx::stepCount> (currentStep);

        if (wasActive && ! triggerSteps[lane, currentStepIndex] && ! relatchingFromPatternUpload)
            return;

        let blockStart = blockStartStep (lane, currentStep);
        let blockStartIndex = wrap<seqfx::stepCount> (blockStart);
        talkBoxFromVowel[lane] = snapValue (stepParams[lane, blockStartIndex, 0], 0, 4);
        talkBoxToVowel[lane] = snapValue (stepParams[lane, blockStartIndex, 1], 0, 4);
        talkBoxMorph[lane] = seqfx::clampFloat (stepParams[lane, blockStartIndex, 2], 0.0f, 1.0f);
        talkBoxResonance[lane] = seqfx::clampFloat (stepParams[lane, blockStartIndex, 3], 1.0f, 20.0f);
        talkBoxLows[lane] = seqfx::clampFloat (stepParams[lane, blockStartIndex, 4], 0.0f, 1.0f);
        talkBoxHighs[lane] = seqfx::clampFloat (stepParams[lane, blockStartIndex, 5], 0.0f, 1.0f);
        talkBoxDriveDb[lane] = seqfx::clampFloat (stepParams[lane, blockStartIndex, 6], 0.0f, 12.0f);
    }

    void latchDirtyStep (wrap<seqfx::laneCount> lane, bool wasActive)
    {
        let currentStepIndex = wrap<seqfx::stepCount> (currentStep);

        if (wasActive && ! triggerSteps[lane, currentStepIndex] && ! relatchingFromPatternUpload)
            return;

        let blockStart = blockStartStep (lane, currentStep);
        let blockStartIndex = wrap<seqfx::stepCount> (blockStart);
        dirtyDriveDb[lane] = seqfx::clampFloat (stepParams[lane, blockStartIndex, 0], 0.0f, 36.0f);
        dirtyCharacter[lane] = snapValue (stepParams[lane, blockStartIndex, 1], 0, 3);
        dirtyBias[lane] = seqfx::clampFloat (stepParams[lane, blockStartIndex, 2], -1.0f, 1.0f);
        dirtyDynamics[lane] = seqfx::clampFloat (stepParams[lane, blockStartIndex, 3], 0.0f, 1.0f);
        dirtyToneHz[lane] = seqfx::clampFloat (stepParams[lane, blockStartIndex, 4], 500.0f, 20000.0f);
        dirtyTrimDb[lane] = seqfx::clampFloat (stepParams[lane, blockStartIndex, 5], -18.0f, 6.0f);
    }

    void resetCombNetwork (wrap<seqfx::laneCount> lane)
    {
        combWriteIndex[lane] = 0;
        combValidSamples[lane] = 0;
        combReferenceDamped[lane] = float32<2> (0.0f);
        combReferenceDcInput[lane] = float32<2> (0.0f);
        combReferenceDcOutput[lane] = float32<2> (0.0f);
        for (wrap<seqfx::combModeCount> mode)
        {
            combVectorDamped[lane, mode] = 0.0f;
            combVectorDcInput[lane, mode] = 0.0f;
            combVectorDcOutput[lane, mode] = 0.0f;
            for (wrap<seqfx::combAllpassStageCount> stage)
            {
                combAllpassInput[lane, mode, stage] = 0.0f;
                combAllpassOutput[lane, mode, stage] = 0.0f;
            }
        }
    }

    void latchCombStep (wrap<seqfx::laneCount> lane, bool wasActive)
    {
        let currentStepIndex = wrap<seqfx::stepCount> (currentStep);

        if (wasActive && ! triggerSteps[lane, currentStepIndex] && ! relatchingFromPatternUpload)
            return;

        let blockStart = blockStartStep (lane, currentStep);
        let blockStartIndex = wrap<seqfx::stepCount> (blockStart);
        let freshNetwork = ! combTailActive[lane];
        if (freshNetwork)
            resetCombNetwork (lane);

        combTuneHz[lane] = seqfx::clampFloat (stepParams[lane, blockStartIndex, 0], 30.0f, 8000.0f);
        combDecaySeconds[lane] = seqfx::clampFloat (stepParams[lane, blockStartIndex, 1], 0.02f, 8.0f);
        combPolarity[lane] = snapValue (stepParams[lane, blockStartIndex, 2], 0, 1);
        combDispersion[lane] = seqfx::clampFloat (stepParams[lane, blockStartIndex, 3], 0.0f, 1.0f);
        combDampingHz[lane] = seqfx::clampFloat (stepParams[lane, blockStartIndex, 4], 500.0f, 20000.0f);
        combMotion[lane] = seqfx::clampFloat (stepParams[lane, blockStartIndex, 5], 0.0f, 1.0f);
        combDrive[lane] = seqfx::clampFloat (stepParams[lane, blockStartIndex, 6], 0.0f, 1.0f);
        combWidth[lane] = seqfx::clampFloat (stepParams[lane, blockStartIndex, 7], 0.0f, 1.0f);

        if (freshNetwork)
        {
            combTuneCurrent[lane] = combTuneHz[lane];
            combDecayCurrent[lane] = combDecaySeconds[lane];
            combDispersionCurrent[lane] = combDispersion[lane];
            combDampingCurrent[lane] = combDampingHz[lane];
            combMotionCurrent[lane] = combMotion[lane];
            combDriveCurrent[lane] = combDrive[lane];
            combWidthCurrent[lane] = combWidth[lane];
            combMixCurrent[lane] = 0.0f;
            combGateCurrent[lane] = 1.0f;
        }

        combTailActive[lane] = true;
        combTailAgeFrames[lane] = 0.0f;
    }

    void latchVibroStep (wrap<seqfx::laneCount> lane, bool wasActive)
    {
        let currentStepIndex = wrap<seqfx::stepCount> (currentStep);

        if (wasActive && ! triggerSteps[lane, currentStepIndex] && ! relatchingFromPatternUpload)
            return;

        let blockStart = blockStartStep (lane, currentStep);
        let blockStartIndex = wrap<seqfx::stepCount> (blockStart);
        vibroRateHz[lane] = seqfx::clampFloat (stepParams[lane, blockStartIndex, 0], 0.05f, 12.0f);
        vibroDepthCents[lane] = seqfx::clampFloat (stepParams[lane, blockStartIndex, 1], 0.0f, 100.0f);
        let nextWaveform = snapValue (stepParams[lane, blockStartIndex, 2], 0, 1);
        if (nextWaveform != vibroWaveform[lane])
        {
            vibroPreviousWaveform[lane] = vibroWaveform[lane];
            vibroWaveform[lane] = nextWaveform;
            vibroWaveformFade[lane] = 0.0f;
        }
        vibroSpreadDegrees[lane] = seqfx::clampFloat (stepParams[lane, blockStartIndex, 3], 0.0f, 180.0f);
        vibroTimingMode[lane] = snapValue (stepParams[lane, blockStartIndex, 4], 0, 1);
        vibroDivision[lane] = snapValue (stepParams[lane, blockStartIndex, 5], 0, 5);

        if (! wasActive)
        {
            vibroRateCurrent[lane] = resolveVibroRateHz (lane);
            vibroDepthCurrent[lane] = vibroDepthCents[lane];
            vibroSpreadCurrent[lane] = vibroSpreadDegrees[lane];
            vibroMixCurrent[lane] = 0.0f;
            vibroPreviousWaveform[lane] = vibroWaveform[lane];
            vibroWaveformFade[lane] = 1.0f;
        }
    }

    void latchFlangeStep (wrap<seqfx::laneCount> lane, bool wasActive)
    {
        let currentStepIndex = wrap<seqfx::stepCount> (currentStep);

        if (wasActive && ! triggerSteps[lane, currentStepIndex] && ! relatchingFromPatternUpload)
            return;

        let blockStart = blockStartStep (lane, currentStep);
        let blockStartIndex = wrap<seqfx::stepCount> (blockStart);
        flangeDelayMs[lane] = seqfx::clampFloat (stepParams[lane, blockStartIndex, 0], 0.2f, 10.0f);
        flangeDepthMs[lane] = seqfx::clampFloat (stepParams[lane, blockStartIndex, 1], 0.0f, 10.0f);
        flangeRateHz[lane] = seqfx::clampFloat (stepParams[lane, blockStartIndex, 2], 0.02f, 10.0f);
        flangeFeedback[lane] = seqfx::clampFloat (stepParams[lane, blockStartIndex, 3], 0.0f, 0.95f);
        flangeSpreadDegrees[lane] = seqfx::clampFloat (stepParams[lane, blockStartIndex, 4], 0.0f, 180.0f);
        flangeFeedbackPolarity[lane] = snapValue (stepParams[lane, blockStartIndex, 5], 0, 1);
        flangeTimingMode[lane] = snapValue (stepParams[lane, blockStartIndex, 6], 0, 1);
        flangeDivision[lane] = snapValue (stepParams[lane, blockStartIndex, 7], 0, 6);
        flangePolarityTarget[lane] = flangeFeedbackPolarity[lane] == 0 ? 1.0f : -1.0f;

        if (! wasActive)
        {
            flangeDelayCurrent[lane] = flangeDelayMs[lane];
            flangeDepthCurrent[lane] = flangeDepthMs[lane];
            flangeRateCurrent[lane] = resolveFlangeRateHz (lane);
            flangeFeedbackCurrent[lane] = flangeFeedback[lane];
            flangeSpreadCurrent[lane] = flangeSpreadDegrees[lane];
            flangePolarityCurrent[lane] = flangePolarityTarget[lane];
            flangeMixCurrent[lane] = 0.0f;
        }
    }

    void latchStutterStep (wrap<seqfx::laneCount> lane, bool wasActive)
    {
        let currentStepIndex = wrap<seqfx::stepCount> (currentStep);
        let blockStart = blockStartStep (lane, currentStep);
        let blockStartIndex = wrap<seqfx::stepCount> (blockStart);
        let nextSliceCount = snapValue (stepParams[lane, blockStartIndex, 0], 2, 32);
        let endSliceCount = stepAuxEnabled[lane, blockStartIndex, 0]
            ? snapValue (stepAuxEnd[lane, blockStartIndex, 0], 2, 32)
            : nextSliceCount;
        var captureSliceCount = nextSliceCount;
        if (endSliceCount < captureSliceCount)
            captureSliceCount = endSliceCount;
        let nextBlockFrames = segmentDurationFrames (lane, blockStart);
        let nextReadFrames = seqfx::clampInt (
            int32 (resolveSliceFramesForCount (nextBlockFrames, captureSliceCount)),
            2,
            stutterBufferSize - 8
        );
        let structureChanged = nextSliceCount != stutterSliceCount[lane] || nextReadFrames != stutterReadFrames[lane];
        let shouldRestart = ! wasActive
            || (! relatchingFromPatternUpload && triggerSteps[lane, currentStepIndex])
            || (relatchingFromPatternUpload && structureChanged);

        stutterPlaybackSpeed[lane] = seqfx::clampFloat (stepParams[lane, currentStepIndex, 1], 0.5f, 2.0f);
        stutterSliceCount[lane] = nextSliceCount;
        stutterShape[lane] = seqfx::clampFloat (stepParams[lane, blockStartIndex, 2], 0.0f, 1.0f);
        stutterGate[lane] = seqfx::clampFloat (stepParams[lane, blockStartIndex, 3], 0.0f, 1.0f);

        if (shouldRestart)
            startStutter (lane, nextBlockFrames, captureSliceCount);
    }

    float32 resolveSliceFramesForCount (float32 blockFrames, int32 sliceCount)
    {
        let requestedFrames = blockFrames / float32 (std::intrinsics::max (1, sliceCount));
        let frameCount = seqfx::clampInt (int32 (requestedFrames), 2, stutterBufferSize - 8);
        return float32 (frameCount);
    }

    float32 resolveSliceFrames (wrap<seqfx::laneCount> lane, float32 blockFrames)
    {
        let requestedFrames = blockFrames / float32 (std::intrinsics::max (1, stutterSliceCount[lane]));
        let frameCount = seqfx::clampInt (int32 (requestedFrames), 2, stutterBufferSize - 8);
        return float32 (frameCount);
    }

    float64 tapeDivisionQuarterNotes (int32 divisionIndex)
    {
        if (divisionIndex == 0)
            return 0.125;
        if (divisionIndex == 1)
            return 0.25;
        if (divisionIndex == 2)
            return 0.5;
        if (divisionIndex == 3)
            return 1.0;
        if (divisionIndex == 4)
            return 2.0;
        if (divisionIndex == 5)
            return 4.0;
        if (divisionIndex == 6)
            return 8.0;
        if (divisionIndex == 7)
            return 16.0;

        return stepQuarterNotes();
    }

    float32 tapeDurationFramesForParams (
        wrap<seqfx::laneCount> lane,
        wrap<seqfx::stepCount> blockStartIndex,
        int32 divisionParam,
        int32 freeTimeParam)
    {
        let timingMode = snapValue (stepParams[lane, blockStartIndex, 5], seqfx::tapeTimingSync, seqfx::tapeTimingFree);

        if (timingMode == seqfx::tapeTimingFree)
        {
            let milliseconds = seqfx::clampFloat (stepParams[lane, blockStartIndex, wrap<seqfx::paramCount> (freeTimeParam)], 20.0f, 8000.0f);
            return std::intrinsics::max (1.0f, milliseconds * float32 (processor.frequency) * 0.001f);
        }

        let division = snapValue (
            stepParams[lane, blockStartIndex, wrap<seqfx::paramCount> (divisionParam)],
            0,
            8
        );
        return float32 (std::intrinsics::max (
            1.0,
            framesPerQuarter() * tapeDivisionQuarterNotes (division)
        ));
    }

    int32 allocateTapeVoice (wrap<seqfx::laneCount> lane)
    {
        for (wrap<seqfx::tapeVoiceCount> voice)
        {
            if (! tapeVoiceActive[lane, voice])
                return int32 (voice);
        }

        var selected = 0;
        for (int32 voice = 1; voice < seqfx::tapeVoiceCount; ++voice)
        {
            let selectedVoice = wrap<seqfx::tapeVoiceCount> (selected);
            let candidateVoice = wrap<seqfx::tapeVoiceCount> (voice);
            let quieter = tapeVoiceGainCurrent[lane, candidateVoice] < tapeVoiceGainCurrent[lane, selectedVoice];
            let sameGainAndOlder = tapeVoiceGainCurrent[lane, candidateVoice] == tapeVoiceGainCurrent[lane, selectedVoice]
                && tapeVoiceGeneration[lane, candidateVoice] < tapeVoiceGeneration[lane, selectedVoice];

            if (quieter || sameGainAndOlder)
                selected = voice;
        }

        return selected;
    }

    void startTapeStop (wrap<seqfx::laneCount> lane, wrap<seqfx::stepCount> blockStartIndex)
    {
        if (tapePrimaryValidSamples[lane] < 8)
            return;

        let selectedVoiceIndex = allocateTapeVoice (lane);
        let selectedVoice = wrap<seqfx::tapeVoiceCount> (selectedVoiceIndex);
        let wasActive = tapeVoiceActive[lane, selectedVoice];
        let previousOutput = tapeVoiceLastOutput[lane, selectedVoice];

        for (wrap<seqfx::tapeVoiceCount> voice)
        {
            if (voice != selectedVoice)
                tapeVoiceGainTarget[lane, voice] = 0.0f;
        }

        tapeGenerationCounter[lane] += 1;
        tapeVoiceGeneration[lane, selectedVoice] = tapeGenerationCounter[lane];
        tapeVoiceActive[lane, selectedVoice] = true;
        tapeVoiceReturnMode[lane, selectedVoice] = snapValue (
            stepParams[lane, blockStartIndex, 2],
            seqfx::tapeReturnCatchUp,
            seqfx::tapeReturnSpinUp
        );
        tapeVoiceAgeFrames[lane, selectedVoice] = 0.0f;
        tapeVoiceStopFrames[lane, selectedVoice] = tapeDurationFramesForParams (lane, blockStartIndex, 0, 6);
        tapeVoiceStartFrames[lane, selectedVoice] = tapeDurationFramesForParams (lane, blockStartIndex, 3, 7);
        tapeVoiceCurvePower[lane, selectedVoice] = seqfx::tapeCurvePowerFromControl (
            stepParams[lane, blockStartIndex, 1]
        );
        tapeVoiceCharacter[lane, selectedVoice] = seqfx::clampFloat (
            stepParams[lane, blockStartIndex, 4],
            0.0f,
            1.0f
        );
        tapeVoiceMix[lane, selectedVoice] = seqfx::clampFloat (stepMix[lane, blockStartIndex], 0.0f, 1.0f);
        tapeVoiceReadPosition[lane, selectedVoice] = float64 (tapePrimarySamplesWritten[lane] - 4);
        tapeVoiceGainCurrent[lane, selectedVoice] = wasActive
            ? tapeVoiceGainCurrent[lane, selectedVoice]
            : 0.0f;
        tapeVoiceGainTarget[lane, selectedVoice] = 1.0f;
        tapeVoiceRestartFrom[lane, selectedVoice] = previousOutput;
        tapeVoiceRestartAge[lane, selectedVoice] = wasActive
            ? 0.0f
            : seqfx::transitionCrossfadeFrames;
        tapeVoiceToneState[lane, selectedVoice] = readTapeHistory (
            lane,
            tapeVoiceReadPosition[lane, selectedVoice]
        );
    }

    void startStutter (wrap<seqfx::laneCount> lane, float32 blockFrames, int32 captureSliceCount)
    {
        stutterBlockDurationFrames[lane] = std::intrinsics::max (1.0f, blockFrames);
        let sliceFrames = resolveSliceFramesForCount (stutterBlockDurationFrames[lane], captureSliceCount);
        stutterReadFrames[lane] = seqfx::clampInt (int32 (sliceFrames), 2, stutterBufferSize - 8);
        stutterReadLength[lane] = float32 (stutterReadFrames[lane]);
        stutterCaptureFrames[lane] = 0.0f;
        stutterPhaseFrames[lane] = 0.0f;
        stutterCapturing[lane] = true;
        stutterPlaying[lane] = false;
    }

    void writeTapePrimarySample (wrap<seqfx::laneCount> lane, float32<2> sample)
    {
        let index = tapePrimaryWriteIndex[lane];
        if (lane == 0)
            tapePrimaryHistory0[index] = sample;
        else if (lane == 1)
            tapePrimaryHistory1[index] = sample;
        else if (lane == 2)
            tapePrimaryHistory2[index] = sample;
        else
            tapePrimaryHistory3[index] = sample;

        tapePrimaryWriteIndex[lane] = wrap<seqfx::tapePrimaryBufferSize> (int32 (index) + 1);
        tapePrimarySamplesWritten[lane] += 1;
        if (tapePrimaryValidSamples[lane] < seqfx::tapePrimaryBufferSize - 4)
            tapePrimaryValidSamples[lane] += 1;
    }

    int32 packTapeStereo16 (float32<2> sample)
    {
        let left = seqfx::roundToInt (seqfx::clampFloat (sample[0], -1.0f, 1.0f) * 32767.0f);
        let right = seqfx::roundToInt (seqfx::clampFloat (sample[1], -1.0f, 1.0f) * 32767.0f);
        return (left & 65535) | (right << 16);
    }

    float32<2> unpackTapeStereo16 (int32 packed)
    {
        let left = (packed << 16) >> 16;
        let right = packed >> 16;
        return float32<2> (float32 (left) / 32767.0f, float32 (right) / 32767.0f);
    }

    void writeTapeCoarseSample (wrap<seqfx::laneCount> lane, float32<2> sample)
    {
        let index = tapeCoarseWriteIndex[lane];
        let packed = packTapeStereo16 (sample);
        if (lane == 0)
            tapeCoarseHistory0[index] = packed;
        else if (lane == 1)
            tapeCoarseHistory1[index] = packed;
        else if (lane == 2)
            tapeCoarseHistory2[index] = packed;
        else
            tapeCoarseHistory3[index] = packed;

        tapeCoarseWriteIndex[lane] = wrap<seqfx::tapeCoarseBufferSize> (int32 (index) + 1);
        tapeCoarseSamplesWritten[lane] += 1;
        if (tapeCoarseValidSamples[lane] < seqfx::tapeCoarseBufferSize - 4)
            tapeCoarseValidSamples[lane] += 1;
    }

    void writeTapeHistory (wrap<seqfx::laneCount> lane, float32<2> sample)
    {
        let primaryRatio = seqfx::tapePrimaryRate / float32 (processor.frequency);
        tapePrimaryWritePhase[lane] += primaryRatio;
        while (tapePrimaryWritePhase[lane] >= 1.0f)
        {
            let overshoot = tapePrimaryWritePhase[lane] - 1.0f;
            let fraction = seqfx::clampFloat (1.0f - (overshoot / primaryRatio), 0.0f, 1.0f);
            let resampled = tapePreviousHostSample[lane]
                + ((sample - tapePreviousHostSample[lane]) * fraction);
            writeTapePrimarySample (lane, resampled);
            tapePrimaryWritePhase[lane] -= 1.0f;
        }

        let coarseCutoff = std::intrinsics::min (3200.0f, float32 (processor.frequency) * 0.2f);
        let coarseCoefficient = 1.0f - std::intrinsics::exp (
            (-2.0f * seqfx::pi * coarseCutoff) / float32 (processor.frequency)
        );
        tapeCoarseLowpassState[lane] += (sample - tapeCoarseLowpassState[lane]) * coarseCoefficient;

        let coarseRatio = seqfx::tapeCoarseRate / float32 (processor.frequency);
        tapeCoarseWritePhase[lane] += coarseRatio;
        while (tapeCoarseWritePhase[lane] >= 1.0f)
        {
            writeTapeCoarseSample (lane, tapeCoarseLowpassState[lane]);
            tapeCoarseWritePhase[lane] -= 1.0f;
        }

        tapePreviousHostSample[lane] = sample;
    }

    void captureStutterSample (wrap<seqfx::laneCount> lane, float32<2> sample)
    {
        stutterHistory[lane, wrap<stutterBufferSize> (int32 (stutterCaptureFrames[lane]))] = sample;
        stutterCaptureFrames[lane] += 1.0f;

        if (stutterCaptureFrames[lane] >= stutterReadLength[lane])
        {
            stutterCapturing[lane] = false;
            stutterPlaying[lane] = true;
            stutterPhaseFrames[lane] = 0.0f;
        }
    }

    float32<2> readTapePrimaryAt (wrap<seqfx::laneCount> lane, int64 absoluteIndex)
    {
        let index = wrap<seqfx::tapePrimaryBufferSize> (
            int32 (absoluteIndex % int64 (seqfx::tapePrimaryBufferSize))
        );
        if (lane == 0)
            return tapePrimaryHistory0[index];
        if (lane == 1)
            return tapePrimaryHistory1[index];
        if (lane == 2)
            return tapePrimaryHistory2[index];
        return tapePrimaryHistory3[index];
    }

    float32<2> readTapeCoarseAt (wrap<seqfx::laneCount> lane, int64 absoluteIndex)
    {
        let index = wrap<seqfx::tapeCoarseBufferSize> (
            int32 (absoluteIndex % int64 (seqfx::tapeCoarseBufferSize))
        );
        if (lane == 0)
            return unpackTapeStereo16 (tapeCoarseHistory0[index]);
        if (lane == 1)
            return unpackTapeStereo16 (tapeCoarseHistory1[index]);
        if (lane == 2)
            return unpackTapeStereo16 (tapeCoarseHistory2[index]);
        return unpackTapeStereo16 (tapeCoarseHistory3[index]);
    }

    bool tapePrimaryPositionIsValid (wrap<seqfx::laneCount> lane, float64 position)
    {
        let currentIndex = int64 (std::intrinsics::floor (position));
        let earliest = tapePrimarySamplesWritten[lane] - int64 (tapePrimaryValidSamples[lane]);
        return currentIndex - 1 >= earliest && currentIndex + 2 < tapePrimarySamplesWritten[lane];
    }

    bool tapeCoarsePositionIsValid (wrap<seqfx::laneCount> lane, float64 position)
    {
        let currentIndex = int64 (std::intrinsics::floor (position));
        let earliest = tapeCoarseSamplesWritten[lane] - int64 (tapeCoarseValidSamples[lane]);
        return currentIndex - 1 >= earliest && currentIndex + 2 < tapeCoarseSamplesWritten[lane];
    }

    float32<2> readTapePrimary (wrap<seqfx::laneCount> lane, float64 position)
    {
        let currentIndex = int64 (std::intrinsics::floor (position));
        let fraction = float32 (position - float64 (currentIndex));
        return seqfx::cubicHermite4 (
            readTapePrimaryAt (lane, currentIndex - 1),
            readTapePrimaryAt (lane, currentIndex),
            readTapePrimaryAt (lane, currentIndex + 1),
            readTapePrimaryAt (lane, currentIndex + 2),
            fraction
        );
    }

    float32<2> readTapeCoarse (wrap<seqfx::laneCount> lane, float64 position)
    {
        let currentIndex = int64 (std::intrinsics::floor (position));
        let fraction = float32 (position - float64 (currentIndex));
        return seqfx::cubicHermite4 (
            readTapeCoarseAt (lane, currentIndex - 1),
            readTapeCoarseAt (lane, currentIndex),
            readTapeCoarseAt (lane, currentIndex + 1),
            readTapeCoarseAt (lane, currentIndex + 2),
            fraction
        );
    }

    float32<2> readTapeHistory (wrap<seqfx::laneCount> lane, float64 primaryPosition)
    {
        let coarsePosition = primaryPosition * (float64 (seqfx::tapeCoarseRate) / float64 (seqfx::tapePrimaryRate));
        let primaryValid = tapePrimaryPositionIsValid (lane, primaryPosition);
        let coarseValid = tapeCoarsePositionIsValid (lane, coarsePosition);

        if (! primaryValid && ! coarseValid)
            return float32<2> (0.0f);
        if (! primaryValid)
            return readTapeCoarse (lane, coarsePosition);
        if (! coarseValid)
            return readTapePrimary (lane, primaryPosition);

        let ageSeconds = float32 (
            (float64 (tapePrimarySamplesWritten[lane]) - primaryPosition)
                / float64 (seqfx::tapePrimaryRate)
        );
        let coarseFade = seqfx::smoothStep01 (seqfx::clampFloat ((ageSeconds - 14.5f) / 1.0f, 0.0f, 1.0f));
        let primary = readTapePrimary (lane, primaryPosition);
        let coarse = readTapeCoarse (lane, coarsePosition);
        return primary + ((coarse - primary) * coarseFade);
    }

    float32<2> readStutterCapture (wrap<seqfx::laneCount> lane, float32 position)
    {
        let wrapped = std::intrinsics::wrap (position, stutterReadLength[lane]);
        let currentIndex = int32 (std::intrinsics::floor (wrapped));
        let fraction = wrapped - float32 (currentIndex);
        let readFrameLimit = seqfx::clampInt (int32 (stutterReadLength[lane]), 2, stutterReadFrames[lane]);
        var previousIndex = currentIndex - 1;
        var followingIndex = currentIndex + 1;
        var nextFollowingIndex = currentIndex + 2;

        if (previousIndex < 0)
            previousIndex += readFrameLimit;
        if (followingIndex >= readFrameLimit)
            followingIndex -= readFrameLimit;
        while (nextFollowingIndex >= readFrameLimit)
            nextFollowingIndex -= readFrameLimit;

        return seqfx::cubicHermite4 (
            stutterHistory[lane, wrap<stutterBufferSize> (previousIndex)],
            stutterHistory[lane, wrap<stutterBufferSize> (currentIndex)],
            stutterHistory[lane, wrap<stutterBufferSize> (followingIndex)],
            stutterHistory[lane, wrap<stutterBufferSize> (nextFollowingIndex)],
            fraction
        );
    }

    float32<2> processFilter (wrap<seqfx::laneCount> lane, float32<2> stage)
    {
        filterMixCurrent[lane] = seqfx::moveTowards (filterMixCurrent[lane], filterMixTarget[lane], 1.0f / 96.0f);

        if (filterMixCurrent[lane] <= 0.00001f)
            return stage;

        let cutoffHz = auxCutoffValue (lane, 1, filterStartHz[lane]);
        let currentQ = seqfx::clampFloat (auxParamValue (lane, 3, filterQ[lane]), 0.1f, 20.0f);
        let currentMode = snapValue (auxParamValue (lane, 0, float32 (filterMode[lane])), 0, 2);
        let mode = seqfx::resolveFilterMode (currentMode);

        filterStates[lane, 0].setMode (mode);
        filterStates[lane, 1].setMode (mode);
        filterStates[lane, 0].setFrequency (processor.frequency, cutoffHz, currentQ, 0.0f);
        filterStates[lane, 1].setFrequency (processor.frequency, cutoffHz, currentQ, 0.0f);

        var filtered = float32<2> (
            filterStates[lane, 0].process (stage[0]),
            filterStates[lane, 1].process (stage[1])
        );

        filterModeFade[lane] = seqfx::moveTowards (filterModeFade[lane], 1.0f, 1.0f / std::intrinsics::max (1.0f, float32 (processor.frequency) * 0.005f));
        filtered = stage + ((filtered - stage) * filterModeFade[lane]);

        return stage + ((filtered - stage) * filterMixCurrent[lane]);
    }

    float32<2> processCrusher (wrap<seqfx::laneCount> lane, float32<2> stage)
    {
        crusherMixCurrent[lane] = seqfx::moveTowards (crusherMixCurrent[lane], crusherMixTarget[lane], 1.0f / 64.0f);

        if (crusherMixCurrent[lane] <= 0.00001f)
            return stage;

        let currentBits = snapValue (auxParamValue (lane, 0, float32 (crusherBits[lane])), 2, 16);
        let currentRateHz = seqfx::clampFloat (
            auxParamValue (lane, 1, crusherRateHz[lane]),
            200.0f,
            std::intrinsics::min (48000.0f, float32 (processor.frequency))
        );
        let currentDriveDb = seqfx::clampFloat (auxParamValue (lane, 2, crusherDriveDb[lane]), 0.0f, 36.0f);
        let currentAdcQuality = seqfx::clampFloat (auxParamValue (lane, 4, crusherAdcQuality[lane]), 0.0f, 1.0f);
        let currentDacQuality = seqfx::clampFloat (auxParamValue (lane, 5, crusherDacQuality[lane]), 0.0f, 1.0f);
        let currentDither = seqfx::clampFloat (auxParamValue (lane, 6, crusherDither[lane]), 0.0f, 1.0f);
        let driveGain = seqfx::dbToGain (currentDriveDb);
        let levels = float32 ((1 << (currentBits - 1)) - 1);

        if (crusherCharacter[lane] == 0)
        {
            let currentHoldFrames = seqfx::clampInt (
                seqfx::roundToInt (float32 (processor.frequency) / currentRateHz),
                1,
                256
            );
            let legacyDriven = float32<2> (
                seqfx::clampFloat (stage[0], -1.0f, 1.0f),
                seqfx::clampFloat (stage[1], -1.0f, 1.0f)
            ) * driveGain;
            let legacyClipped = float32<2> (
                seqfx::clampFloat (legacyDriven[0], -1.0f, 1.0f),
                seqfx::clampFloat (legacyDriven[1], -1.0f, 1.0f)
            );

            if (crusherNeedsRecapture[lane] || crusherHoldCounter[lane] <= 0)
            {
                crusherHeld[lane] = legacyClipped;
                crusherNeedsRecapture[lane] = false;
                crusherHoldCounter[lane] = currentHoldFrames;
            }

            crusherHoldCounter[lane] -= 1;
            let legacyCrushed = float32<2> (
                seqfx::quantize (crusherHeld[lane][0], levels),
                seqfx::quantize (crusherHeld[lane][1], levels)
            );
            return stage + ((legacyCrushed - stage) * crusherMixCurrent[lane]);
        }

        let driven = float32<2> (
            seqfx::clampFloat (stage[0] * driveGain, -1.0f, 1.0f),
            seqfx::clampFloat (stage[1] * driveGain, -1.0f, 1.0f)
        );
        let converterCutoff = std::intrinsics::max (
            20.0f,
            std::intrinsics::min (float32 (processor.frequency) * 0.45f, currentRateHz * 0.45f)
        );
        let converterCoefficient = 1.0f - std::intrinsics::exp (
            (-2.0f * seqfx::pi * converterCutoff) / float32 (processor.frequency)
        );
        crusherAdcState[lane] += (driven - crusherAdcState[lane]) * converterCoefficient;
        let convertedInput = driven + ((crusherAdcState[lane] - driven) * currentAdcQuality);

        crusherCapturePhase[lane] += currentRateHz / float32 (processor.frequency);
        let shouldCapture = crusherNeedsRecapture[lane] || crusherCapturePhase[lane] >= 1.0f;
        if (shouldCapture)
        {
            crusherPreviousHeld[lane] = crusherHeld[lane];
            let ditherScale = currentDither * 0.5f / levels;
            let ditherNoise = float32<2> (
                (crusherDitherRng[lane, 0].getBipolar() + crusherDitherRng[lane, 0].getBipolar()) * ditherScale,
                (crusherDitherRng[lane, 1].getBipolar() + crusherDitherRng[lane, 1].getBipolar()) * ditherScale
            );

            if (crusherCharacter[lane] == 3)
            {
                let delta = convertedInput - crusherPreviousCapture[lane];
                let quantizedDelta = float32<2> (
                    seqfx::quantize (delta[0] + ditherNoise[0], levels),
                    seqfx::quantize (delta[1] + ditherNoise[1], levels)
                );
                crusherProgressiveOutput[lane] += quantizedDelta;
                crusherProgressiveOutput[lane] = float32<2> (
                    seqfx::clampFloat (crusherProgressiveOutput[lane][0], -1.0f, 1.0f),
                    seqfx::clampFloat (crusherProgressiveOutput[lane][1], -1.0f, 1.0f)
                );
                crusherHeld[lane] = crusherProgressiveOutput[lane];
            }
            else
            {
                crusherHeld[lane] = float32<2> (
                    seqfx::quantize (convertedInput[0] + ditherNoise[0], levels),
                    seqfx::quantize (convertedInput[1] + ditherNoise[1], levels)
                );
                crusherProgressiveOutput[lane] = crusherHeld[lane];
            }

            crusherPreviousCapture[lane] = convertedInput;
            crusherNeedsRecapture[lane] = false;
            if (crusherCapturePhase[lane] >= 1.0f)
                crusherCapturePhase[lane] -= 1.0f;
            else
                crusherCapturePhase[lane] = 0.0f;
        }

        var crushed = crusherHeld[lane];
        if (crusherCharacter[lane] == 2)
        {
            let interpolation = seqfx::smoothStep01 (crusherCapturePhase[lane]);
            crushed = crusherPreviousHeld[lane] + ((crusherHeld[lane] - crusherPreviousHeld[lane]) * interpolation);
        }

        crusherDacState[lane] += (crushed - crusherDacState[lane]) * converterCoefficient;
        crushed += (crusherDacState[lane] - crushed) * currentDacQuality;

        var dcBlocked = crushed;
        if (crusherCharacter[lane] == 3)
        {
            dcBlocked = crushed - crusherDcPreviousInput[lane] + (crusherDcPreviousOutput[lane] * 0.99935f);
            crusherDcPreviousInput[lane] = crushed;
            crusherDcPreviousOutput[lane] = dcBlocked;
        }
        dcBlocked = float32<2> (
            seqfx::clampFloat (dcBlocked[0], -1.2f, 1.2f),
            seqfx::clampFloat (dcBlocked[1], -1.2f, 1.2f)
        );

        return stage + ((dcBlocked - stage) * crusherMixCurrent[lane]);
    }

    float32<2> processRing (wrap<seqfx::laneCount> lane, float32<2> stage)
    {
        ringMixCurrent[lane] = seqfx::moveTowards (
            ringMixCurrent[lane],
            ringMixTarget[lane],
            1.0f / seqfx::transitionCrossfadeFrames
        );

        let currentFrequency = auxLogParamValue (
            lane,
            0,
            ringFrequencyHz[lane],
            0.1f,
            std::intrinsics::min (12000.0f, float32 (processor.frequency) * 0.45f)
        );
        let currentMotion = seqfx::clampFloat (auxParamValue (lane, 2, ringMotion[lane]), 0.0f, 1.0f);
        let currentRate = auxLogParamValue (lane, 3, ringRateHz[lane], 0.02f, 20.0f);
        let currentSpread = seqfx::clampFloat (auxParamValue (lane, 4, ringSpread[lane]), 0.0f, 1.0f);
        let currentBias = seqfx::clampFloat (auxParamValue (lane, 5, ringBias[lane]), -1.0f, 1.0f);
        let currentRectify = seqfx::clampFloat (auxParamValue (lane, 6, ringRectify[lane]), -1.0f, 1.0f);
        let motionCarrier = std::intrinsics::sin (ringMotionPhase[lane] * 2.0f * seqfx::pi);
        let modulatedFrequency = seqfx::clampFloat (
            currentFrequency * std::intrinsics::pow (2.0f, motionCarrier * currentMotion),
            0.1f,
            std::intrinsics::min (12000.0f, float32 (processor.frequency) * 0.45f)
        );
        let spreadSemitones = currentSpread * 0.25f;
        let spreadRatio = std::intrinsics::pow (2.0f, spreadSemitones / 12.0f);
        let leftFrequency = seqfx::clampFloat (modulatedFrequency / spreadRatio, 0.1f, float32 (processor.frequency) * 0.45f);
        let rightFrequency = seqfx::clampFloat (modulatedFrequency * spreadRatio, 0.1f, float32 (processor.frequency) * 0.45f);
        let leftPhaseStep = leftFrequency / float32 (processor.frequency);
        let rightPhaseStep = rightFrequency / float32 (processor.frequency);
        let commonNoise = ringNoiseRng[lane].getBipolar();
        let leftNoiseCoefficient = 1.0f - std::intrinsics::exp (
            (-2.0f * seqfx::pi * leftFrequency) / float32 (processor.frequency)
        );
        let rightNoiseCoefficient = 1.0f - std::intrinsics::exp (
            (-2.0f * seqfx::pi * rightFrequency) / float32 (processor.frequency)
        );
        ringNoiseState[lane][0] += (commonNoise - ringNoiseState[lane][0]) * leftNoiseCoefficient;
        ringNoiseState[lane][1] += (commonNoise - ringNoiseState[lane][1]) * rightNoiseCoefficient;
        let leftCarrier = seqfx::shapeRingCarrier (
            seqfx::ringCarrierAt (
                ringWaveform[lane],
                ringCarrierPhase[lane][0],
                leftPhaseStep,
                ringNoiseState[lane][0]
            ),
            currentBias,
            currentRectify
        );
        let rightCarrier = seqfx::shapeRingCarrier (
            seqfx::ringCarrierAt (
                ringWaveform[lane],
                ringCarrierPhase[lane][1],
                rightPhaseStep,
                ringNoiseState[lane][1]
            ),
            currentBias,
            currentRectify
        );

        ringCarrierPhase[lane][0] = seqfx::unitWrap (ringCarrierPhase[lane][0] + leftPhaseStep);
        ringCarrierPhase[lane][1] = seqfx::unitWrap (ringCarrierPhase[lane][1] + rightPhaseStep);
        ringMotionPhase[lane] = seqfx::unitWrap (
            ringMotionPhase[lane] + (currentRate / float32 (processor.frequency))
        );

        if (ringMixCurrent[lane] <= 0.00001f)
            return stage;

        let ringed = float32<2> (stage[0] * leftCarrier, stage[1] * rightCarrier);
        return stage + ((ringed - stage) * ringMixCurrent[lane]);
    }

    float32<2> processTalkBox (wrap<seqfx::laneCount> lane, float32<2> stage)
    {
        talkBoxMixCurrent[lane] = seqfx::moveTowards (
            talkBoxMixCurrent[lane],
            talkBoxMixTarget[lane],
            1.0f / seqfx::transitionCrossfadeFrames
        );

        let currentMorph = seqfx::clampFloat (auxParamValue (lane, 2, talkBoxMorph[lane]), 0.0f, 1.0f);
        let currentQ = auxLogParamValue (lane, 3, talkBoxResonance[lane], 1.0f, 20.0f);
        let currentLows = seqfx::clampFloat (auxParamValue (lane, 4, talkBoxLows[lane]), 0.0f, 1.0f);
        let currentHighs = seqfx::clampFloat (auxParamValue (lane, 5, talkBoxHighs[lane]), 0.0f, 1.0f);
        let currentDriveDb = seqfx::clampFloat (auxParamValue (lane, 6, talkBoxDriveDb[lane]), 0.0f, 12.0f);
        let firstFormantHz = seqfx::logLerpHz (
            seqfx::talkBoxFormant1Hz (talkBoxFromVowel[lane]),
            seqfx::talkBoxFormant1Hz (talkBoxToVowel[lane]),
            currentMorph
        );
        let secondFormantHz = seqfx::logLerpHz (
            seqfx::talkBoxFormant2Hz (talkBoxFromVowel[lane]),
            seqfx::talkBoxFormant2Hz (talkBoxToVowel[lane]),
            currentMorph
        );
        let driveAmount = currentDriveDb / 12.0f;
        let driveGain = seqfx::dbToGain (currentDriveDb);
        let amplified = stage * driveGain;
        let driven = float32<2> (
            amplified[0] / (1.0f + (std::intrinsics::abs (amplified[0]) * driveAmount * 0.35f)),
            amplified[1] / (1.0f + (std::intrinsics::abs (amplified[1]) * driveAmount * 0.35f))
        );

        for (wrap<2> channel)
        {
            talkBoxFormantStates[lane, 0, channel].setMode (std::filters::simper::Mode::bandPass);
            talkBoxFormantStates[lane, 1, channel].setMode (std::filters::simper::Mode::bandPass);
            talkBoxFormantStates[lane, 0, channel].setFrequency (
                processor.frequency,
                firstFormantHz,
                currentQ,
                0.0f
            );
            talkBoxFormantStates[lane, 1, channel].setFrequency (
                processor.frequency,
                secondFormantHz,
                currentQ,
                0.0f
            );
        }

        let firstFormant = float32<2> (
            talkBoxFormantStates[lane, 0, 0].process (driven[0]),
            talkBoxFormantStates[lane, 0, 1].process (driven[1])
        );
        let secondFormant = float32<2> (
            talkBoxFormantStates[lane, 1, 0].process (driven[0]),
            talkBoxFormantStates[lane, 1, 1].process (driven[1])
        );
        let lowCoefficient = 1.0f - std::intrinsics::exp (
            (-2.0f * seqfx::pi * 180.0f) / float32 (processor.frequency)
        );
        let highCoefficient = 1.0f - std::intrinsics::exp (
            (-2.0f * seqfx::pi * 3000.0f) / float32 (processor.frequency)
        );
        talkBoxLowState[lane] += (driven - talkBoxLowState[lane]) * lowCoefficient;
        talkBoxHighLowState[lane] += (driven - talkBoxHighLowState[lane]) * highCoefficient;
        let highBand = driven - talkBoxHighLowState[lane];
        let formantGain = 0.85f + (currentQ * 0.04f);
        var voiced = ((firstFormant + secondFormant) * formantGain)
            + (talkBoxLowState[lane] * currentLows)
            + (highBand * currentHighs);
        voiced = float32<2> (
            seqfx::clampFloat (voiced[0], -4.0f, 4.0f),
            seqfx::clampFloat (voiced[1], -4.0f, 4.0f)
        );

        return stage + ((voiced - stage) * talkBoxMixCurrent[lane]);
    }

    float32 combModeRatio (wrap<seqfx::combModeCount> mode, float32 dispersion)
    {
        if (mode == 1) return 1.0f + (0.011f * dispersion);
        if (mode == 2) return 1.0f - (0.013f * dispersion);
        if (mode == 3) return 1.0f + (0.027f * dispersion);
        return 1.0f;
    }

    float32 combAllpassCoefficient (wrap<seqfx::combModeCount> mode, float32 dispersion)
    {
        let amount = seqfx::clampFloat (dispersion, 0.0f, 1.0f);
        if (mode == 1) return -0.5644f * amount;
        if (mode == 2) return 0.51f * amount;
        if (mode == 3) return -0.42f * amount;
        return 0.68f * amount;
    }

    float32 combAllpassGroupDelay (float32 coefficient, float32 tuneHz)
    {
        let radians = 2.0f * seqfx::pi * tuneHz / float32 (processor.frequency);
        let numerator = 1.0f - (coefficient * coefficient);
        let denominator = 1.0f + (coefficient * coefficient)
            + (2.0f * coefficient * std::intrinsics::cos (radians));
        return float32 (seqfx::combAllpassStageCount)
            * numerator
            / std::intrinsics::max (0.000001f, denominator);
    }

    float32 combModeDelaySamples (
        wrap<seqfx::combModeCount> mode,
        float32 targetPeriod,
        float32 tuneHz,
        float32 dispersion,
        float32 motion,
        float32 phase)
    {
        let coefficient = combAllpassCoefficient (mode, dispersion);
        let baseDelay = (targetPeriod * combModeRatio (mode, dispersion))
            - combAllpassGroupDelay (coefficient, tuneHz);
        let excursion = std::intrinsics::min (3.0f, targetPeriod * 0.018f)
            * seqfx::clampFloat (motion, 0.0f, 1.0f)
            * seqfx::clampFloat (dispersion, 0.0f, 1.0f);
        let modePhase = seqfx::unitWrap (phase + (float32 (mode) * 0.25f));
        return seqfx::clampFloat (
            baseDelay + (excursion * std::intrinsics::sin (modePhase * 2.0f * seqfx::pi)),
            4.0f,
            float32 (combBufferSize - 4)
        );
    }

    float32 combFeedbackGain (float32 delaySamples, float32 decaySeconds, int32 polarity)
    {
        let safeDecay = seqfx::clampFloat (decaySeconds, 0.02f, 8.0f);
        let delaySeconds = delaySamples / float32 (processor.frequency);
        let magnitude = std::intrinsics::min (
            0.9985f,
            std::intrinsics::pow (10.0f, -3.0f * delaySeconds / safeDecay)
        );
        return polarity == 0 ? magnitude : -magnitude;
    }

    float32 combMeasuredPeriodCompensation (float32 tuneHz)
    {
        let octavesFromA3 = std::intrinsics::log (
            seqfx::clampFloat (tuneHz, 30.0f, 8000.0f) / 220.0f
        ) / std::intrinsics::log (2.0f);
        return seqfx::clampFloat (1.0046f - (0.00675f * octavesFromA3), 0.97f, 1.025f);
    }

    float32 combVectorPeriodCompensation (float32 tuneHz, float32 dispersion)
    {
        // The four dispersed paths do not share the reference comb's measured
        // loop phase. This small octave-dependent correction keeps their
        // aggregate resonance centred on Tune while preserving a bit-exact
        // conventional comb at Dispersion = 0.
        let octavesFromA3 = std::intrinsics::log (
            seqfx::clampFloat (tuneHz, 30.0f, 8000.0f) / 220.0f
        ) / std::intrinsics::log (2.0f);
        let amount = seqfx::clampFloat (dispersion, 0.0f, 1.0f);
        return seqfx::clampFloat (1.0f - (0.0115f * octavesFromA3 * amount), 0.96f, 1.04f);
    }

    float32 combSoftLimit (float32 sample, float32 drive)
    {
        let amount = seqfx::clampFloat (drive, 0.0f, 1.0f);
        if (amount <= 0.000001f)
            return sample;

        let gain = 1.0f + (amount * 5.0f);
        let shaped = std::intrinsics::tanh (sample * gain) / gain;
        return (sample * (1.0f - amount)) + (shaped * amount);
    }

    float32<2> combSoftLimitStereo (float32<2> sample, float32 drive)
    {
        return float32<2> (
            combSoftLimit (sample[0], drive),
            combSoftLimit (sample[1], drive)
        );
    }

    float32<2> readCombReferenceAt (wrap<seqfx::laneCount> lane, int32 index)
    {
        return combReferenceHistory[lane, wrap<combBufferSize> (index)];
    }

    float32 readCombVectorAt (
        wrap<seqfx::laneCount> lane,
        wrap<seqfx::combModeCount> mode,
        int32 index)
    {
        return combVectorHistory[lane, mode, wrap<combBufferSize> (index)];
    }

    float32<2> readCombReference (wrap<seqfx::laneCount> lane, float32 delaySamples)
    {
        if (combValidSamples[lane] < int32 (std::intrinsics::ceil (delaySamples)) + 3)
            return float32<2> (0.0f);

        let readPosition = float32 (int32 (combWriteIndex[lane])) - delaySamples;
        let currentIndex = int32 (std::intrinsics::floor (readPosition));
        let fraction = readPosition - float32 (currentIndex);
        return seqfx::cubicHermite4 (
            readCombReferenceAt (lane, currentIndex - 1),
            readCombReferenceAt (lane, currentIndex),
            readCombReferenceAt (lane, currentIndex + 1),
            readCombReferenceAt (lane, currentIndex + 2),
            fraction
        );
    }

    float32 readCombVector (
        wrap<seqfx::laneCount> lane,
        wrap<seqfx::combModeCount> mode,
        float32 delaySamples)
    {
        if (combValidSamples[lane] < int32 (std::intrinsics::ceil (delaySamples)) + 3)
            return 0.0f;

        let readPosition = float32 (int32 (combWriteIndex[lane])) - delaySamples;
        let currentIndex = int32 (std::intrinsics::floor (readPosition));
        let fraction = readPosition - float32 (currentIndex);
        return seqfx::cubicHermite4Scalar (
            readCombVectorAt (lane, mode, currentIndex - 1),
            readCombVectorAt (lane, mode, currentIndex),
            readCombVectorAt (lane, mode, currentIndex + 1),
            readCombVectorAt (lane, mode, currentIndex + 2),
            fraction
        );
    }

    float32 processCombAllpass (
        wrap<seqfx::laneCount> lane,
        wrap<seqfx::combModeCount> mode,
        float32 sample,
        float32 coefficient)
    {
        var current = sample;
        for (wrap<seqfx::combAllpassStageCount> stage)
        {
            let nextSample = (coefficient * current)
                + combAllpassInput[lane, mode, stage]
                - (coefficient * combAllpassOutput[lane, mode, stage]);
            combAllpassInput[lane, mode, stage] = current;
            combAllpassOutput[lane, mode, stage] = nextSample;
            current = nextSample;
        }
        return current;
    }

    float32<2> processComb (wrap<seqfx::laneCount> lane, float32<2> stage)
    {
        if (! combActive[lane] && ! combTailActive[lane])
            return stage;

        let parameterSmoothing = 1.0f - std::intrinsics::exp (
            -1.0f / (0.01f * float32 (processor.frequency))
        );
        if (combActive[lane])
        {
            let targetTune = auxLogParamValue (lane, 0, combTuneHz[lane], 30.0f, 8000.0f);
            let targetDecay = auxLogParamValue (lane, 1, combDecaySeconds[lane], 0.02f, 8.0f);
            let targetDispersion = seqfx::clampFloat (auxParamValue (lane, 3, combDispersion[lane]), 0.0f, 1.0f);
            let targetDamping = auxLogParamValue (lane, 4, combDampingHz[lane], 500.0f, 20000.0f);
            let targetMotion = seqfx::clampFloat (auxParamValue (lane, 5, combMotion[lane]), 0.0f, 1.0f);
            let targetDrive = seqfx::clampFloat (auxParamValue (lane, 6, combDrive[lane]), 0.0f, 1.0f);
            let targetWidth = seqfx::clampFloat (auxParamValue (lane, 7, combWidth[lane]), 0.0f, 1.0f);
            combTuneCurrent[lane] += (targetTune - combTuneCurrent[lane]) * parameterSmoothing;
            combDecayCurrent[lane] += (targetDecay - combDecayCurrent[lane]) * parameterSmoothing;
            combDispersionCurrent[lane] += (targetDispersion - combDispersionCurrent[lane]) * parameterSmoothing;
            combDampingCurrent[lane] += (targetDamping - combDampingCurrent[lane]) * parameterSmoothing;
            combMotionCurrent[lane] += (targetMotion - combMotionCurrent[lane]) * parameterSmoothing;
            combDriveCurrent[lane] += (targetDrive - combDriveCurrent[lane]) * parameterSmoothing;
            combWidthCurrent[lane] += (targetWidth - combWidthCurrent[lane]) * parameterSmoothing;
        }

        combMixCurrent[lane] = seqfx::moveTowards (
            combMixCurrent[lane],
            combMixTarget[lane],
            1.0f / seqfx::transitionCrossfadeFrames
        );
        combGateCurrent[lane] = seqfx::moveTowards (
            combGateCurrent[lane],
            combGateTarget[lane],
            1.0f / seqfx::transitionCrossfadeFrames
        );

        let tuneHz = seqfx::clampFloat (combTuneCurrent[lane], 30.0f, 8000.0f);
        let decaySeconds = seqfx::clampFloat (combDecayCurrent[lane], 0.02f, 8.0f);
        let dispersion = seqfx::clampFloat (combDispersionCurrent[lane], 0.0f, 1.0f);
        let dampingHz = seqfx::clampFloat (
            combDampingCurrent[lane],
            500.0f,
            std::intrinsics::min (20000.0f, float32 (processor.frequency) * 0.45f)
        );
        let motion = seqfx::clampFloat (combMotionCurrent[lane], 0.0f, 1.0f);
        let drive = seqfx::clampFloat (combDriveCurrent[lane], 0.0f, 1.0f);
        let width = seqfx::clampFloat (combWidthCurrent[lane], 0.0f, 1.0f);
        let referencePeriod = (float32 (processor.frequency) / tuneHz)
            * combMeasuredPeriodCompensation (tuneHz);
        let vectorPeriod = referencePeriod * combVectorPeriodCompensation (tuneHz, dispersion);
        let inputSample = combActive[lane] ? stage : float32<2> (0.0f);
        let referenceDelay = seqfx::clampFloat (referencePeriod, 4.0f, float32 (combBufferSize - 4));
        let referenceRead = readCombReference (lane, referenceDelay);
        let dampingCoefficient = std::intrinsics::exp (
            -2.0f * seqfx::pi * dampingHz / float32 (processor.frequency)
        );
        combReferenceDamped[lane] = (referenceRead * (1.0f - dampingCoefficient))
            + (combReferenceDamped[lane] * dampingCoefficient);
        let referenceLimited = combSoftLimitStereo (combReferenceDamped[lane], drive);
        let dcCoefficient = std::intrinsics::exp (
            -2.0f * seqfx::pi * 10.0f / float32 (processor.frequency)
        );
        let referenceReturned = referenceLimited
            - combReferenceDcInput[lane]
            + (combReferenceDcOutput[lane] * dcCoefficient);
        combReferenceDcInput[lane] = referenceLimited;
        combReferenceDcOutput[lane] = referenceReturned;
        let referenceFeedback = combFeedbackGain (referenceDelay, decaySeconds, combPolarity[lane]);

        let modeDelay0 = combModeDelaySamples (0, vectorPeriod, tuneHz, dispersion, motion, combMotionPhase[lane]);
        let modeDelay1 = combModeDelaySamples (1, vectorPeriod, tuneHz, dispersion, motion, combMotionPhase[lane]);
        let modeDelay2 = combModeDelaySamples (2, vectorPeriod, tuneHz, dispersion, motion, combMotionPhase[lane]);
        let modeDelay3 = combModeDelaySamples (3, vectorPeriod, tuneHz, dispersion, motion, combMotionPhase[lane]);
        let prior0 = combVectorDamped[lane, 0] * combFeedbackGain (modeDelay0, decaySeconds, combPolarity[lane]);
        let prior1 = combVectorDamped[lane, 1] * combFeedbackGain (modeDelay1, decaySeconds, combPolarity[lane]);
        let prior2 = combVectorDamped[lane, 2] * combFeedbackGain (modeDelay2, decaySeconds, combPolarity[lane]);
        let prior3 = combVectorDamped[lane, 3] * combFeedbackGain (modeDelay3, decaySeconds, combPolarity[lane]);
        let rotated0 = 0.5f * (prior0 + prior1 + prior2 + prior3);
        let rotated1 = 0.5f * (prior0 - prior1 + prior2 - prior3);
        let rotated2 = 0.5f * (prior0 + prior1 - prior2 - prior3);
        let rotated3 = 0.5f * (prior0 - prior1 - prior2 + prior3);
        let inputMid = 0.25f * (inputSample[0] + inputSample[1]);
        let writeIndex = combWriteIndex[lane];
        combReferenceHistory[lane, writeIndex] = float32<2> (
            seqfx::clampFloat (inputSample[0] + (referenceFeedback * referenceReturned[0]), -4.0f, 4.0f),
            seqfx::clampFloat (inputSample[1] + (referenceFeedback * referenceReturned[1]), -4.0f, 4.0f)
        );
        combVectorHistory[lane, 0, writeIndex] = seqfx::clampFloat (
            (0.5f * inputSample[0]) + combSoftLimit (rotated0, drive), -4.0f, 4.0f
        );
        combVectorHistory[lane, 1, writeIndex] = seqfx::clampFloat (
            (0.5f * inputSample[1]) + combSoftLimit (rotated1, drive), -4.0f, 4.0f
        );
        combVectorHistory[lane, 2, writeIndex] = seqfx::clampFloat (
            inputMid + combSoftLimit (rotated2, drive), -4.0f, 4.0f
        );
        combVectorHistory[lane, 3, writeIndex] = seqfx::clampFloat (
            inputMid + combSoftLimit (rotated3, drive), -4.0f, 4.0f
        );

        let modeDelays = float32<4> (modeDelay0, modeDelay1, modeDelay2, modeDelay3);
        float32<4> vectorReads;
        for (wrap<seqfx::combModeCount> mode)
        {
            let rawRead = readCombVector (lane, mode, modeDelays[mode]);
            let dispersed = processCombAllpass (
                lane,
                mode,
                rawRead,
                combAllpassCoefficient (mode, dispersion)
            );
            let damped = (dispersed * (1.0f - dampingCoefficient))
                + (combVectorDamped[lane, mode] * dampingCoefficient);
            combVectorDamped[lane, mode] = damped;
            let returned = damped
                - combVectorDcInput[lane, mode]
                + (combVectorDcOutput[lane, mode] * dcCoefficient);
            combVectorDcInput[lane, mode] = damped;
            combVectorDcOutput[lane, mode] = returned;
            combVectorDamped[lane, mode] = returned;
            vectorReads[mode] = rawRead;
        }

        combWriteIndex[lane] = wrap<combBufferSize> (int32 (writeIndex) + 1);
        if (combValidSamples[lane] < combBufferSize - 4)
            combValidSamples[lane] += 1;

        let referenceMid = 0.5f * (referenceRead[0] + referenceRead[1]);
        let referenceSide = 0.5f * (referenceRead[0] - referenceRead[1]);
        let referenceWet = float32<2> (
            referenceMid + (referenceSide * width),
            referenceMid - (referenceSide * width)
        );
        let projectedLeft = 0.5f * (vectorReads[0] + vectorReads[1] - vectorReads[2] + vectorReads[3]);
        let projectedRight = 0.5f * (vectorReads[0] - vectorReads[1] + vectorReads[2] + vectorReads[3]);
        let vectorMid = 0.5f * (projectedLeft + projectedRight);
        let vectorWet = float32<2> (
            vectorMid + ((projectedLeft - vectorMid) * width),
            vectorMid + ((projectedRight - vectorMid) * width)
        );
        let advancedMix = seqfx::smoothStep01 (dispersion);
        let wet = referenceWet + ((vectorWet - referenceWet) * advancedMix);

        let energy = 0.5f * ((wet[0] * wet[0]) + (wet[1] * wet[1]));
        let energyCoefficient = 1.0f - std::intrinsics::exp (
            -1.0f / (0.02f * float32 (processor.frequency))
        );
        combTailEnergy[lane] += (energy - combTailEnergy[lane]) * energyCoefficient;
        if (! combActive[lane])
        {
            combTailAgeFrames[lane] += 1.0f;
            let quietEnough = combTailAgeFrames[lane] > float32 (processor.frequency) * 0.1f
                && combTailEnergy[lane] < 1.0e-10f;
            let expired = combTailAgeFrames[lane]
                > (decaySeconds * 1.5f + 0.25f) * float32 (processor.frequency);
            if (quietEnough || expired)
            {
                combTailActive[lane] = false;
                combMixTarget[lane] = 0.0f;
                resetCombNetwork (lane);
                return stage;
            }
        }
        else
        {
            combTailAgeFrames[lane] = 0.0f;
        }

        let motionRateHz = 0.11f + (0.31f * motion);
        combMotionPhase[lane] = seqfx::unitWrap (
            combMotionPhase[lane] + (motionRateHz / float32 (processor.frequency))
        );
        let combined = stage + (wet * combMixCurrent[lane])
            - (stage * combMixCurrent[lane] * combGateCurrent[lane]);
        return float32<2> (
            seqfx::clampFloat (combined[0], -4.0f, 4.0f),
            seqfx::clampFloat (combined[1], -4.0f, 4.0f)
        );
    }

    float64 vibroDivisionQuarterNotes (int32 division)
    {
        if (division == 0) return 0.125;
        if (division == 1) return 0.25;
        if (division == 2) return 0.5;
        if (division == 3) return 1.0;
        if (division == 4) return 2.0;
        return 4.0;
    }

    float32 resolveVibroRateHz (wrap<seqfx::laneCount> lane)
    {
        if (vibroTimingMode[lane] == seqfx::vibroTimingFree)
            return seqfx::clampFloat (vibroRateHz[lane], 0.05f, 12.0f);

        let cycleFrames = framesPerQuarter() * vibroDivisionQuarterNotes (vibroDivision[lane]);
        return seqfx::clampFloat (
            float32 (processor.frequency / std::intrinsics::max (1.0, cycleFrames)),
            0.02f,
            24.0f
        );
    }

    float32 vibroTriangleIntegral (float32 phase)
    {
        let p = seqfx::unitWrap (phase);
        if (p < 0.5f)
            return p - (2.0f * p * p);

        return (2.0f * p * p) - (3.0f * p) + 1.0f;
    }

    float32 vibroDelaySamples (
        int32 waveform,
        float32 phase,
        float32 rateHz,
        float32 depthCents)
    {
        if (depthCents <= 0.000001f)
            return 0.0f;

        // Depth is the exact half peak-to-peak pitch span. A periodic delay
        // must average one-sample-per-sample playback, so the small residual
        // centre offset is preferable to an ever-drifting read head.
        let depthRatio = std::intrinsics::tanh (
            seqfx::clampFloat (depthCents, 0.0f, 100.0f)
                * std::intrinsics::log (2.0f)
                / 1200.0f
        );
        let safeRate = seqfx::clampFloat (rateHz, 0.02f, 24.0f);
        if (waveform == 1)
        {
            let scale = depthRatio * float32 (processor.frequency) / safeRate;
            let halfRange = scale * 0.125f;
            return seqfx::clampFloat (
                4.0f + halfRange - (scale * vibroTriangleIntegral (phase)),
                4.0f,
                float32 (vibroBufferSize - 4)
            );
        }

        let amplitude = depthRatio * float32 (processor.frequency)
            / (2.0f * seqfx::pi * safeRate);
        return seqfx::clampFloat (
            4.0f + amplitude + (amplitude * std::intrinsics::cos (phase * 2.0f * seqfx::pi)),
            4.0f,
            float32 (vibroBufferSize - 4)
        );
    }

    float32<2> readVibroAt (wrap<seqfx::laneCount> lane, int32 index)
    {
        return vibroHistory[lane, wrap<vibroBufferSize> (index)];
    }

    float32<2> readVibroHistory (wrap<seqfx::laneCount> lane, float32 delaySamples)
    {
        if (vibroValidSamples[lane] < int32 (std::intrinsics::ceil (delaySamples)) + 3)
            return float32<2> (0.0f);

        let readPosition = float32 (int32 (vibroWriteIndex[lane])) - delaySamples;
        let currentIndex = int32 (std::intrinsics::floor (readPosition));
        let fraction = readPosition - float32 (currentIndex);
        return seqfx::cubicHermite4 (
            readVibroAt (lane, currentIndex - 1),
            readVibroAt (lane, currentIndex),
            readVibroAt (lane, currentIndex + 1),
            readVibroAt (lane, currentIndex + 2),
            fraction
        );
    }

    void writeVibroHistory (wrap<seqfx::laneCount> lane, float32<2> sample)
    {
        let writeIndex = vibroWriteIndex[lane];
        vibroHistory[lane, writeIndex] = sample;
        vibroWriteIndex[lane] = wrap<vibroBufferSize> (int32 (writeIndex) + 1);
        if (vibroValidSamples[lane] < vibroBufferSize - 4)
            vibroValidSamples[lane] += 1;
    }

    float32<2> processVibro (wrap<seqfx::laneCount> lane, float32<2> stage)
    {
        let parameterSmoothing = 1.0f - std::intrinsics::exp (
            -1.0f / (0.025f * float32 (processor.frequency))
        );
        var targetRate = resolveVibroRateHz (lane);
        if (vibroActive[lane])
        {
            if (vibroTimingMode[lane] == seqfx::vibroTimingFree)
                targetRate = auxLogParamValue (lane, 0, vibroRateHz[lane], 0.05f, 12.0f);

            let targetDepth = seqfx::clampFloat (auxParamValue (lane, 1, vibroDepthCents[lane]), 0.0f, 100.0f);
            let targetSpread = seqfx::clampFloat (auxParamValue (lane, 3, vibroSpreadDegrees[lane]), 0.0f, 180.0f);
            vibroDepthCurrent[lane] += (targetDepth - vibroDepthCurrent[lane]) * parameterSmoothing;
            vibroSpreadCurrent[lane] += (targetSpread - vibroSpreadCurrent[lane]) * parameterSmoothing;
        }
        vibroRateCurrent[lane] += (targetRate - vibroRateCurrent[lane]) * parameterSmoothing;
        vibroMixCurrent[lane] = seqfx::moveTowards (
            vibroMixCurrent[lane],
            vibroMixTarget[lane],
            1.0f / seqfx::transitionCrossfadeFrames
        );
        vibroWaveformFade[lane] = seqfx::moveTowards (
            vibroWaveformFade[lane],
            1.0f,
            1.0f / seqfx::transitionCrossfadeFrames
        );

        let rateHz = seqfx::clampFloat (vibroRateCurrent[lane], 0.02f, 24.0f);
        let depthCents = seqfx::clampFloat (vibroDepthCurrent[lane], 0.0f, 100.0f);
        let phase = vibroPhase[lane];
        vibroPhase[lane] = seqfx::unitWrap (
            phase + (rateHz / float32 (processor.frequency))
        );

        if (! vibroActive[lane] || vibroMixCurrent[lane] <= 0.000001f || depthCents <= 0.000001f)
            return stage;

        let spreadPhase = seqfx::clampFloat (vibroSpreadCurrent[lane], 0.0f, 180.0f) / 360.0f;
        let leftDelay = vibroDelaySamples (vibroWaveform[lane], phase, rateHz, depthCents);
        let rightDelay = vibroDelaySamples (
            vibroWaveform[lane],
            seqfx::unitWrap (phase + spreadPhase),
            rateHz,
            depthCents
        );
        let requiredDelay = std::intrinsics::max (leftDelay, rightDelay);
        if (vibroValidSamples[lane] < int32 (std::intrinsics::ceil (requiredDelay)) + 3)
        {
            vibroHistoryFade[lane] = 0.0f;
            return stage;
        }

        vibroHistoryFade[lane] = seqfx::moveTowards (
            vibroHistoryFade[lane],
            1.0f,
            1.0f / seqfx::transitionCrossfadeFrames
        );
        let leftRead = readVibroHistory (lane, leftDelay);
        let rightRead = readVibroHistory (lane, rightDelay);
        var wet = float32<2> (leftRead[0], rightRead[1]);
        if (vibroWaveformFade[lane] < 0.999999f)
        {
            let previousLeftDelay = vibroDelaySamples (
                vibroPreviousWaveform[lane], phase, rateHz, depthCents
            );
            let previousRightDelay = vibroDelaySamples (
                vibroPreviousWaveform[lane],
                seqfx::unitWrap (phase + spreadPhase),
                rateHz,
                depthCents
            );
            let previousRequired = std::intrinsics::max (previousLeftDelay, previousRightDelay);
            if (vibroValidSamples[lane] >= int32 (std::intrinsics::ceil (previousRequired)) + 3)
            {
                let previousLeftRead = readVibroHistory (lane, previousLeftDelay);
                let previousRightRead = readVibroHistory (lane, previousRightDelay);
                let previousWet = float32<2> (previousLeftRead[0], previousRightRead[1]);
                wet = previousWet + ((wet - previousWet) * vibroWaveformFade[lane]);
            }
        }

        let combined = stage + ((wet - stage) * vibroMixCurrent[lane] * vibroHistoryFade[lane]);
        return float32<2> (
            seqfx::clampFloat (combined[0], -4.0f, 4.0f),
            seqfx::clampFloat (combined[1], -4.0f, 4.0f)
        );
    }

    float64 flangeDivisionQuarterNotes (int32 division)
    {
        if (division == 0) return 0.25;
        if (division == 1) return 0.5;
        if (division == 2) return 1.0;
        if (division == 3) return 2.0;
        if (division == 4) return 4.0;
        if (division == 5) return 8.0;
        return 16.0;
    }

    float32 resolveFlangeRateHz (wrap<seqfx::laneCount> lane)
    {
        if (flangeTimingMode[lane] == seqfx::flangeTimingFree)
            return seqfx::clampFloat (flangeRateHz[lane], 0.02f, 10.0f);

        let cycleFrames = framesPerQuarter() * flangeDivisionQuarterNotes (flangeDivision[lane]);
        return seqfx::clampFloat (
            float32 (processor.frequency / std::intrinsics::max (1.0, cycleFrames)),
            0.005f,
            40.0f
        );
    }

    float32<2> readFlangeAt (wrap<seqfx::laneCount> lane, int32 index)
    {
        return flangeHistory[lane, wrap<flangeBufferSize> (index)];
    }

    float32<2> readFlangeHistory (wrap<seqfx::laneCount> lane, float32 delaySamples)
    {
        if (flangeValidSamples[lane] < int32 (std::intrinsics::ceil (delaySamples)) + 3)
            return float32<2> (0.0f);

        let readPosition = float32 (int32 (flangeWriteIndex[lane])) - delaySamples;
        let currentIndex = int32 (std::intrinsics::floor (readPosition));
        let fraction = readPosition - float32 (currentIndex);
        return seqfx::cubicHermite4 (
            readFlangeAt (lane, currentIndex - 1),
            readFlangeAt (lane, currentIndex),
            readFlangeAt (lane, currentIndex + 1),
            readFlangeAt (lane, currentIndex + 2),
            fraction
        );
    }

    void writeFlangeHistory (wrap<seqfx::laneCount> lane, float32<2> sample)
    {
        let writeIndex = flangeWriteIndex[lane];
        flangeHistory[lane, writeIndex] = sample;
        flangeWriteIndex[lane] = wrap<flangeBufferSize> (int32 (writeIndex) + 1);
        if (flangeValidSamples[lane] < flangeBufferSize - 4)
            flangeValidSamples[lane] += 1;
    }

    float32 flangeDelaySamples (float32 phase, float32 delayMs, float32 depthMs)
    {
        let modulation = 0.5f - (0.5f * std::intrinsics::cos (phase * 2.0f * seqfx::pi));
        let totalMs = seqfx::clampFloat (delayMs, 0.2f, 10.0f)
            + (seqfx::clampFloat (depthMs, 0.0f, 10.0f) * modulation);
        return seqfx::clampFloat (
            totalMs * float32 (processor.frequency) * 0.001f,
            4.0f,
            float32 (flangeBufferSize - 4)
        );
    }

    float32<2> processFlange (wrap<seqfx::laneCount> lane, float32<2> stage)
    {
        let parameterSmoothing = 1.0f - std::intrinsics::exp (
            -1.0f / (0.025f * float32 (processor.frequency))
        );
        var targetDelay = flangeDelayMs[lane];
        var targetDepth = flangeDepthMs[lane];
        var targetRate = resolveFlangeRateHz (lane);
        var targetFeedback = 0.0f;
        var targetSpread = flangeSpreadDegrees[lane];
        if (flangeActive[lane])
        {
            targetDelay = auxLogParamValue (lane, 0, flangeDelayMs[lane], 0.2f, 10.0f);
            targetDepth = seqfx::clampFloat (auxParamValue (lane, 1, flangeDepthMs[lane]), 0.0f, 10.0f);
            if (flangeTimingMode[lane] == seqfx::flangeTimingFree)
                targetRate = auxLogParamValue (lane, 2, flangeRateHz[lane], 0.02f, 10.0f);
            targetFeedback = seqfx::clampFloat (auxParamValue (lane, 3, flangeFeedback[lane]), 0.0f, 0.95f);
            targetSpread = seqfx::clampFloat (auxParamValue (lane, 4, flangeSpreadDegrees[lane]), 0.0f, 180.0f);
        }

        flangeDelayCurrent[lane] += (targetDelay - flangeDelayCurrent[lane]) * parameterSmoothing;
        flangeDepthCurrent[lane] += (targetDepth - flangeDepthCurrent[lane]) * parameterSmoothing;
        flangeRateCurrent[lane] += (targetRate - flangeRateCurrent[lane]) * parameterSmoothing;
        flangeSpreadCurrent[lane] += (targetSpread - flangeSpreadCurrent[lane]) * parameterSmoothing;
        if (flangeActive[lane])
            flangeFeedbackCurrent[lane] += (targetFeedback - flangeFeedbackCurrent[lane]) * parameterSmoothing;
        else
            flangeFeedbackCurrent[lane] = seqfx::moveTowards (
                flangeFeedbackCurrent[lane], 0.0f, 1.0f / seqfx::transitionCrossfadeFrames
            );
        flangePolarityCurrent[lane] = seqfx::moveTowards (
            flangePolarityCurrent[lane],
            flangePolarityTarget[lane],
            2.0f / seqfx::transitionCrossfadeFrames
        );
        flangeMixCurrent[lane] = seqfx::moveTowards (
            flangeMixCurrent[lane],
            flangeMixTarget[lane],
            1.0f / seqfx::transitionCrossfadeFrames
        );

        let rateHz = seqfx::clampFloat (flangeRateCurrent[lane], 0.005f, 40.0f);
        let phase = flangePhase[lane];
        flangePhase[lane] = seqfx::unitWrap (
            phase + (rateHz / float32 (processor.frequency))
        );
        let spreadPhase = seqfx::clampFloat (flangeSpreadCurrent[lane], 0.0f, 180.0f) / 360.0f;
        let leftDelay = flangeDelaySamples (
            phase, flangeDelayCurrent[lane], flangeDepthCurrent[lane]
        );
        let rightDelay = flangeDelaySamples (
            seqfx::unitWrap (phase + spreadPhase),
            flangeDelayCurrent[lane],
            flangeDepthCurrent[lane]
        );
        let requiredDelay = std::intrinsics::max (leftDelay, rightDelay);
        if (flangeValidSamples[lane] < int32 (std::intrinsics::ceil (requiredDelay)) + 3)
        {
            flangeHistoryFade[lane] = 0.0f;
            writeFlangeHistory (lane, stage);
            return stage;
        }

        flangeHistoryFade[lane] = seqfx::moveTowards (
            flangeHistoryFade[lane],
            1.0f,
            1.0f / seqfx::transitionCrossfadeFrames
        );
        let leftRead = readFlangeHistory (lane, leftDelay);
        let rightRead = readFlangeHistory (lane, rightDelay);
        let wet = float32<2> (leftRead[0], rightRead[1]);
        let feedbackGain = seqfx::clampFloat (flangeFeedbackCurrent[lane], 0.0f, 0.95f)
            * seqfx::clampFloat (flangePolarityCurrent[lane], -1.0f, 1.0f);
        let feedbackInput = stage + (wet * feedbackGain);
        writeFlangeHistory (lane, float32<2> (
            seqfx::clampFloat (feedbackInput[0], -4.0f, 4.0f),
            seqfx::clampFloat (feedbackInput[1], -4.0f, 4.0f)
        ));

        if (! flangeActive[lane] || flangeMixCurrent[lane] <= 0.000001f)
            return stage;

        let flanged = (stage + wet) * 0.5f;
        let combined = stage + (
            (flanged - stage) * flangeMixCurrent[lane] * flangeHistoryFade[lane]
        );
        return float32<2> (
            seqfx::clampFloat (combined[0], -4.0f, 4.0f),
            seqfx::clampFloat (combined[1], -4.0f, 4.0f)
        );
    }

    float32<2> processDirty (wrap<seqfx::laneCount> lane, float32<2> stage)
    {
        dirtyMixCurrent[lane] = seqfx::moveTowards (
            dirtyMixCurrent[lane],
            dirtyMixTarget[lane],
            1.0f / seqfx::transitionCrossfadeFrames
        );

        let currentDriveDb = seqfx::clampFloat (auxParamValue (lane, 0, dirtyDriveDb[lane]), 0.0f, 36.0f);
        let currentBias = seqfx::clampFloat (auxParamValue (lane, 2, dirtyBias[lane]), -1.0f, 1.0f);
        let currentDynamics = seqfx::clampFloat (auxParamValue (lane, 3, dirtyDynamics[lane]), 0.0f, 1.0f);
        let currentToneHz = auxLogParamValue (lane, 4, dirtyToneHz[lane], 500.0f, 20000.0f);
        let currentTrimDb = seqfx::clampFloat (auxParamValue (lane, 5, dirtyTrimDb[lane]), -18.0f, 6.0f);

        dirtyCores[lane].in <- stage;
        dirtyCores[lane].driveDbIn <- currentDriveDb;
        dirtyCores[lane].biasIn <- currentBias;
        dirtyCores[lane].characterIn <- float32 (dirtyCharacter[lane]);
        dirtyCores[lane].advance();

        let rawResidue = dirtyCores[lane].out - dirtyCores[lane].thru;
        let dcCoefficient = std::intrinsics::exp (
            (-2.0f * seqfx::pi * 10.0f) / float32 (processor.frequency)
        );
        let dcBlocked = rawResidue
            - dirtyDcPreviousInput[lane]
            + (dirtyDcPreviousOutput[lane] * dcCoefficient);
        dirtyDcPreviousInput[lane] = rawResidue;
        dirtyDcPreviousOutput[lane] = dcBlocked;

        let toneCoefficient = 1.0f - std::intrinsics::exp (
            (-2.0f * seqfx::pi * currentToneHz) / float32 (processor.frequency)
        );
        dirtyToneState[lane] += (dcBlocked - dirtyToneState[lane]) * toneCoefficient;
        let rawDirty = stage + dirtyToneState[lane];
        let detectorCoefficient = 1.0f - std::intrinsics::exp (
            -1.0f / (0.01f * float32 (processor.frequency))
        );
        let inputPower = 0.5f * ((stage[0] * stage[0]) + (stage[1] * stage[1]));
        let outputPower = 0.5f * ((rawDirty[0] * rawDirty[0]) + (rawDirty[1] * rawDirty[1]));
        dirtyInputPower[lane] += (inputPower - dirtyInputPower[lane]) * detectorCoefficient;
        dirtyOutputPower[lane] += (outputPower - dirtyOutputPower[lane]) * detectorCoefficient;
        let compensation = seqfx::clampFloat (
            float32 (std::intrinsics::sqrt (
                std::intrinsics::max (dirtyInputPower[lane], 1.0e-12f)
                    / std::intrinsics::max (dirtyOutputPower[lane], 1.0e-12f)
            )),
            0.015848932f,
            4.0f
        );
        let dynamicsGain = std::intrinsics::pow (compensation, currentDynamics);
        let trimGain = seqfx::dbToGain (currentTrimDb);
        let rawWet = rawDirty * dynamicsGain * trimGain;
        let clippedWet = float32<2> (
            seqfx::clampFloat (rawWet[0], -4.0f, 4.0f),
            seqfx::clampFloat (rawWet[1], -4.0f, 4.0f)
        );

        return stage + ((clippedWet - stage) * dirtyMixCurrent[lane]);
    }

    float32<2> processTapeCharacter (
        wrap<seqfx::laneCount> lane,
        wrap<seqfx::tapeVoiceCount> voice,
        float32<2> sample,
        float32 speed)
    {
        let character = tapeVoiceCharacter[lane, voice];
        if (character <= 0.00001f)
            return sample;

        let slowAmount = character * (1.0f - seqfx::clampFloat (speed, 0.0f, 1.0f));
        let maximumCutoff = std::intrinsics::min (20000.0f, float32 (processor.frequency) * 0.45f);
        let cutoff = maximumCutoff + ((1200.0f - maximumCutoff) * slowAmount);
        let coefficient = 1.0f - std::intrinsics::exp (
            (-2.0f * seqfx::pi * cutoff) / float32 (processor.frequency)
        );
        tapeVoiceToneState[lane, voice] += (sample - tapeVoiceToneState[lane, voice]) * coefficient;

        let drive = 1.0f + (slowAmount * 2.0f);
        let driven = tapeVoiceToneState[lane, voice] * drive;
        return float32<2> (
            driven[0] / (1.0f + (std::intrinsics::abs (driven[0]) * slowAmount)),
            driven[1] / (1.0f + (std::intrinsics::abs (driven[1]) * slowAmount))
        );
    }

    float32<2> processTapeStop (wrap<seqfx::laneCount> lane, float32<2> stage)
    {
        var accumulated = float32<2> (0.0f);
        var accumulatedGain = 0.0f;

        for (wrap<seqfx::tapeVoiceCount> voice)
        {
            if (! tapeVoiceActive[lane, voice])
                continue;

            tapeVoiceGainCurrent[lane, voice] = seqfx::moveTowards (
                tapeVoiceGainCurrent[lane, voice],
                tapeVoiceGainTarget[lane, voice],
                1.0f / seqfx::transitionCrossfadeFrames
            );

            if (tapeVoiceGainCurrent[lane, voice] <= 0.00001f
                && tapeVoiceGainTarget[lane, voice] <= 0.00001f)
            {
                tapeVoiceActive[lane, voice] = false;
                continue;
            }

            let age = tapeVoiceAgeFrames[lane, voice];
            let stopFrames = tapeVoiceStopFrames[lane, voice];
            let startFrames = tapeVoiceStartFrames[lane, voice];
            let returnMode = tapeVoiceReturnMode[lane, voice];
            let catchUpFrames = std::intrinsics::max (
                seqfx::transitionCrossfadeFrames,
                float32 (processor.frequency) * 0.01f
            );
            let returnFrames = returnMode == seqfx::tapeReturnSpinUp ? startFrames : catchUpFrames;
            let totalFrames = stopFrames + returnFrames;

            if (age >= totalFrames)
            {
                tapeVoiceActive[lane, voice] = false;
                tapeVoiceGainCurrent[lane, voice] = 0.0f;
                tapeVoiceGainTarget[lane, voice] = 0.0f;
                continue;
            }

            var speed = seqfx::tapeSpeedFloor;
            var voiceOutput = float32<2> (0.0f);

            if (age < stopFrames)
            {
                speed = seqfx::tapeStopSpeedAt (age, stopFrames, tapeVoiceCurvePower[lane, voice]);
                voiceOutput = processTapeCharacter (
                    lane,
                    voice,
                    readTapeHistory (lane, tapeVoiceReadPosition[lane, voice]),
                    speed
                );

                let terminalFrames = seqfx::clampFloat (
                    float32 (processor.frequency) * 0.01f,
                    1.0f,
                    std::intrinsics::max (1.0f, stopFrames * 0.1f)
                );
                if (age > stopFrames - terminalFrames)
                {
                    let terminalPhase = (stopFrames - age) / terminalFrames;
                    voiceOutput *= seqfx::smoothStep01 (terminalPhase);
                }
            }
            else
            {
                let returnPhase = seqfx::clampFloat ((age - stopFrames) / returnFrames, 0.0f, 1.0f);
                if (returnMode == seqfx::tapeReturnSpinUp)
                {
                    speed = seqfx::tapeSpinUpSpeedAt (
                        age - stopFrames,
                        returnFrames,
                        tapeVoiceCurvePower[lane, voice]
                    );
                    let spun = processTapeCharacter (
                        lane,
                        voice,
                        readTapeHistory (lane, tapeVoiceReadPosition[lane, voice]),
                        speed
                    );
                    let startFade = seqfx::smoothStep01 (seqfx::clampFloat (returnPhase * 10.0f, 0.0f, 1.0f));
                    let liveFade = seqfx::smoothStep01 (seqfx::clampFloat ((returnPhase - 0.9f) * 10.0f, 0.0f, 1.0f));
                    voiceOutput = (spun * startFade * (1.0f - liveFade)) + (stage * liveFade);
                }
                else
                {
                    voiceOutput = stage * seqfx::smoothStep01 (returnPhase);
                }
            }

            if (tapeVoiceRestartAge[lane, voice] < seqfx::transitionCrossfadeFrames)
            {
                let restartFade = seqfx::smoothStep01 (
                    tapeVoiceRestartAge[lane, voice] / seqfx::transitionCrossfadeFrames
                );
                voiceOutput = tapeVoiceRestartFrom[lane, voice]
                    + ((voiceOutput - tapeVoiceRestartFrom[lane, voice]) * restartFade);
                tapeVoiceRestartAge[lane, voice] += 1.0f;
            }

            tapeVoiceLastOutput[lane, voice] = voiceOutput;
            tapeVoiceReadPosition[lane, voice] += float64 (speed)
                * (float64 (seqfx::tapePrimaryRate) / processor.frequency);
            tapeVoiceAgeFrames[lane, voice] += 1.0f;

            let voiceGain = tapeVoiceGainCurrent[lane, voice];
            let voiceResult = stage + ((voiceOutput - stage) * tapeVoiceMix[lane, voice]);
            accumulated += voiceResult * voiceGain;
            accumulatedGain += voiceGain;
        }

        if (accumulatedGain <= 0.00001f)
            return stage;

        let normalized = accumulated / accumulatedGain;
        return stage + ((normalized - stage) * seqfx::clampFloat (accumulatedGain, 0.0f, 1.0f));
    }

    float32<2> processStutter (wrap<seqfx::laneCount> lane, float32<2> stage)
    {
        stutterMixCurrent[lane] = seqfx::moveTowards (stutterMixCurrent[lane], stutterMixTarget[lane], 1.0f / 64.0f);

        let currentPlaybackSpeed = seqfx::clampFloat (auxParamValue (lane, 1, stutterPlaybackSpeed[lane]), 0.5f, 2.0f);
        let currentShape = seqfx::clampFloat (auxParamValue (lane, 2, stutterShape[lane]), 0.0f, 1.0f);
        let currentGate = seqfx::clampFloat (auxParamValue (lane, 3, stutterGate[lane]), 0.0f, 1.0f);

        if (stutterCapturing[lane])
        {
            let capturePhase = seqfx::clampFloat (
                stutterCaptureFrames[lane] / std::intrinsics::max (1.0f, stutterReadLength[lane]),
                0.0f,
                1.0f
            );
            let captureEnvelope = seqfx::stutterCaptureEnvelopeAt (
                capturePhase,
                currentShape,
                currentGate,
                currentPlaybackSpeed
            );
            captureStutterSample (lane, stage);
            let captureOut = stage * captureEnvelope;
            return stage + ((captureOut - stage) * stutterMixCurrent[lane]);
        }

        if (stutterMixCurrent[lane] <= 0.00001f || ! stutterPlaying[lane])
            return stage;

        let currentSliceCount = snapValue (auxParamValue (lane, 0, float32 (stutterSliceCount[lane])), 2, 32);
        let currentReadLength = resolveSliceFramesForCount (stutterBlockDurationFrames[lane], currentSliceCount);
        stutterReadLength[lane] = seqfx::clampFloat (
            currentReadLength,
            2.0f,
            float32 (stutterReadFrames[lane])
        );

        let crossfadeFrames = seqfx::clampFloat (
            std::intrinsics::min (float32 (processor.frequency) * 0.005f, stutterReadLength[lane] * 0.25f),
            1.0f,
            std::intrinsics::max (1.0f, stutterReadLength[lane] * 0.5f)
        );
        var stutterOut = readStutterCapture (lane, stutterPhaseFrames[lane]);
        let stutterPhase = seqfx::clampFloat (
            stutterPhaseFrames[lane] / std::intrinsics::max (1.0f, stutterReadLength[lane]),
            0.0f,
            1.0f
        );
        let stutterEnvelope = seqfx::stutterEnvelopeAt (stutterPhase, currentShape, currentGate);

        if (stutterPhaseFrames[lane] > stutterReadLength[lane] - crossfadeFrames)
        {
            let fade = (stutterPhaseFrames[lane] - (stutterReadLength[lane] - crossfadeFrames)) / crossfadeFrames;
            let head = readStutterCapture (lane, fade * crossfadeFrames);
            stutterOut = (stutterOut * (1.0f - fade)) + (head * fade);
        }

        stutterOut *= stutterEnvelope;

        stutterPhaseFrames[lane] += currentPlaybackSpeed;

        while (stutterPhaseFrames[lane] >= stutterReadLength[lane])
            stutterPhaseFrames[lane] -= stutterReadLength[lane];

        return stage + ((stutterOut - stage) * stutterMixCurrent[lane]);
    }

    float32<2> processChain (wrap<seqfx::laneCount> lane, float32<2> stage)
    {
        stage = processFilter (lane, stage);
        stage = processCrusher (lane, stage);
        stage = processRing (lane, stage);
        stage = processTalkBox (lane, stage);
        stage = processDirty (lane, stage);
        stage = processComb (lane, stage);
        let vibroInput = stage;
        stage = processVibro (lane, stage);
        writeVibroHistory (lane, vibroInput);
        stage = processFlange (lane, stage);

        writeTapeHistory (lane, stage);
        stage = processTapeStop (lane, stage);

        stage = processStutter (lane, stage);
        advanceAuxBlock (lane);
        advanceChainLifecycle (lane);
        return stage;
    }

    void advanceSequencer()
    {
        if (! isClockRunning())
            return;

        stepProgressFrames += 1.0;

        if (stepProgressFrames < currentStepFrames)
            return;

        stepProgressFrames -= currentStepFrames;
        currentStep = nextStepInLoop (currentStep);
        currentStepFrames = stepDurationFramesForStep (currentStep);
        latchStep();
    }

    void emitMonitor()
    {
        seqfx::SeqMonitor monitor;
        monitor.patternIndex = selectedPatternIndex;
        monitor.stepIndex = currentStep;
        monitor.transportRunning = isClockRunning();
        monitor.stepProgress = float32 (stepProgressFrames / std::intrinsics::max (1.0, currentStepFrames));
        monitor.stepDurationMs = float32 ((currentStepFrames / processor.frequency) * 1000.0);
        for (wrap<seqfx::laneCount> lane)
        {
            let activeEffect = selectedEffectForStep (lane, currentStep) != seqfx::effectEmpty;
            monitor.effectType[lane] = chainEffectType[lane];
            monitor.lifecycleState[lane] = chainLifecycleState[lane];
            monitor.auxCyclePhase[lane] = activeEffect ? auxCyclePhaseForLane (lane) : 0.0f;
            monitor.auxAmount[lane] = activeEffect ? auxAmountForLane (lane) : 0.0f;
            monitor.auxDurationMs[lane] = activeEffect
                ? float32 ((auxDurationFrames[lane] / processor.frequency) * 1000.0)
                : 0.0f;
        }
        monitorOut <- monitor;
    }

    void maybeEmitMonitor()
    {
        monitorCountdown -= 1;

        if (monitorCountdown > 0)
            return;

        monitorCountdown = int32 (processor.frequency / 30.0);
        emitMonitor();
    }

    void main()
    {
        loop
        {
            refreshControlTransitions();
            refreshSelectedPattern();

            if (resetRequested)
            {
                resetClockToLoopStart();
                processingResetRequested = true;
                relatchingFromPatternUpload = false;
                needsStepLatch = true;
                resetRequested = false;
            }

            if (processingResetRequested)
                resetProcessingState();

            if (hostPositionPending)
            {
                if (resolveClockMode() == 0)
                    syncHostStepFromQuarterNote();

                hostPositionPending = false;
            }

            if (needsStepLatch)
            {
                currentStepFrames = stepDurationFramesForStep (currentStep);
                latchStep();
                relatchingFromPatternUpload = false;
                needsStepLatch = false;
            }

            let dry = audioIn;
            var stage = dry;

            if (isClockRunning())
            {
                for (wrap<seqfx::laneCount> lane)
                    stage = processChain (lane, stage);
            }
            else
            {
                for (wrap<seqfx::laneCount> lane)
                {
                    writeVibroHistory (lane, stage);
                    writeFlangeHistory (lane, stage);
                    writeTapeHistory (lane, stage);
                }
            }

            if (resetCrossfadeAge < seqfx::transitionCrossfadeFrames)
            {
                let resetFade = seqfx::smoothStep01 (
                    resetCrossfadeAge / seqfx::transitionCrossfadeFrames
                );
                stage = resetCrossfadeFrom + ((stage - resetCrossfadeFrom) * resetFade);
                resetCrossfadeAge += 1.0f;
            }

            lastProcessedStage = stage;
            hasProcessedStage = true;

            bypassMixCurrent = seqfx::moveTowards (
                bypassMixCurrent,
                bypassMixTarget,
                1.0f / seqfx::transitionCrossfadeFrames
            );
            let effectiveMix = seqfx::clampFloat (globalMix, 0.0f, 1.0f) * bypassMixCurrent;
            audioOut <- dry + ((stage - dry) * effectiveMix);

            if (bypassFlushPending && bypassMixCurrent <= 0.00001f)
            {
                processingResetRequested = true;
                bypassFlushPending = false;
            }

            advanceSequencer();
            maybeEmitMonitor();
            renderedFrameCounter += 1;
            advance();
        }
    }
}
