namespace seqfx
{
    let stepCount = 32;
    let laneCount = 4;
    let patternCount = 12;
    let paramCount = 8;
    let laneFilter = 0;
    let laneCrusher = 1;
    let laneTapeStop = 2;
    let laneStutter = 3;
    let effectEmpty = 0;
    let effectFilter = 1;
    let effectCrusher = 2;
    let effectTapeStop = 3;
    let effectStutter = 4;
    let effectPitch = 5;
    let effectComb = 6;
    let effectRing = 7;
    let effectReverse = 8;
    let effectTalkBox = 9;
    let effectVibro = 10;
    let effectFlange = 11;
    let effectDirty = 12;
    let auxRateModeTempo = 0;
    let auxRateModeSlice = 1;
    let maxStutterSeconds = 1.0f;
    let tapePrimaryRate = 48000.0f;
    let tapeCoarseRate = 8000.0f;
    let tapePrimaryBufferSize = 768008;
    let tapeCoarseBufferSize = 768008;
    let tapeSpeedFloor = 0.005f;
    let tapeVoiceCount = 2;
    let tapeReturnCatchUp = 0;
    let tapeReturnSpinUp = 1;
    let tapeTimingSync = 0;
    let tapeTimingFree = 1;
    let transitionCrossfadeFrames = 96.0f;
    let lifecycleIdle = 0;
    let lifecycleEntering = 1;
    let lifecycleActive = 2;
    let lifecycleReleased = 3;
    let lifecycleResetting = 4;
    let pi = 3.14159265358979323846f;

    struct SeqPatternUpload
    {
        int32 patternIndex;
        int32 revision;
        bool authoritative;

        bool[laneCount, stepCount] activeSteps;
        bool[laneCount, stepCount] triggerSteps;
        int32[laneCount, stepCount] effectTypes;

        float32[laneCount, stepCount] mix;
        float32[laneCount, stepCount, paramCount] params;
        bool[laneCount, stepCount, paramCount] auxEnabled;
        float32[laneCount, stepCount, paramCount] auxEnd;
        float32[laneCount, stepCount] auxShape;
        float32[laneCount, stepCount] auxSourceCurve;
        int32[laneCount, stepCount] auxRateMode;
        int32[laneCount, stepCount] auxTempoMultiplier;
        bool[laneCount, stepCount] auxTempoTriplet;
        int32[laneCount, stepCount] auxSliceCount;
    }

    struct SeqMonitor
    {
        int32 patternIndex;
        int32 stepIndex;
        bool transportRunning;
        float32 stepProgress;
        float32 stepDurationMs;
        int32[laneCount] effectType;
        int32[laneCount] lifecycleState;
        float32[laneCount] auxCyclePhase;
        float32[laneCount] auxAmount;
        float32[laneCount] auxDurationMs;
    }

    int32 roundToInt (float32 value)
    {
        return int32 (std::intrinsics::floor (value + 0.5f));
    }

    int32 clampInt (int32 value, int32 minValue, int32 maxValue)
    {
        return std::intrinsics::clamp (value, minValue, maxValue);
    }

    float32 clampFloat (float32 value, float32 minValue, float32 maxValue)
    {
        return std::intrinsics::clamp (value, minValue, maxValue);
    }

    float32 moveTowards (float32 current, float32 target, float32 maxDelta)
    {
        if (current < target)
            return std::intrinsics::min (target, current + maxDelta);

        return std::intrinsics::max (target, current - maxDelta);
    }

    // Four-point, third-order Catmull-Rom/Hermite fractional read.
    float32<2> cubicHermite4 (
        float32<2> previous,
        float32<2> current,
        float32<2> following,
        float32<2> nextFollowing,
        float32 fraction)
    {
        let a = (previous * -0.5f) + (current * 1.5f) - (following * 1.5f) + (nextFollowing * 0.5f);
        let b = previous - (current * 2.5f) + (following * 2.0f) - (nextFollowing * 0.5f);
        let c = (previous * -0.5f) + (following * 0.5f);
        return (((a * fraction) + b) * fraction + c) * fraction + current;
    }

    float32 dbToGain (float32 db)
    {
        return std::intrinsics::pow (10.0f, db / 20.0f);
    }

    float32 curve01 (float32 phase, float32 curvePower)
    {
        return std::intrinsics::pow (
            clampFloat (phase, 0.0f, 1.0f),
            clampFloat (curvePower, 0.25f, 4.0f)
        );
    }

    float32 smoothStep01 (float32 value)
    {
        let x = clampFloat (value, 0.0f, 1.0f);
        return x * x * (3.0f - (2.0f * x));
    }

    float32 unitWrap (float32 value)
    {
        let wrapped = value - std::intrinsics::floor (value);
        return wrapped < 0.0f ? wrapped + 1.0f : wrapped;
    }

    float32 auxRawBump (float32 phase, float32 shape)
    {
        let x = clampFloat (phase, 0.0f, 1.0f);
        let peak = 0.5f + (clampFloat (shape, -1.0f, 1.0f) * 0.5f);

        if (peak <= 0.000001f)
            return 1.0f - x;

        if (peak >= 0.999999f)
            return x;

        if (x <= peak)
            return x / peak;

        return (1.0f - x) / (1.0f - peak);
    }

    float32 auxSourceAt (float32 phase, float32 shape, float32 sourceCurve)
    {
        let safeShape = clampFloat (shape, -1.0f, 1.0f);
        let raw = auxRawBump (phase, safeShape);
        let roundAmount = 1.0f - std::intrinsics::abs (safeShape);
        let rounded = raw + ((std::intrinsics::sin (raw * pi * 0.5f) - raw) * roundAmount);
        let safeCurve = clampFloat (sourceCurve, -1.0f, 1.0f);

        if (safeCurve > 0.0f)
        {
            let power = 1.0f + (safeCurve * 14.0f);
            return clampFloat (1.0f - std::intrinsics::pow (1.0f - rounded, power), 0.0f, 1.0f);
        }

        if (safeCurve < 0.0f)
        {
            let power = 1.0f + (std::intrinsics::abs (safeCurve) * 5.0f);
            return clampFloat (std::intrinsics::pow (rounded, power), 0.0f, 1.0f);
        }

        return clampFloat (rounded, 0.0f, 1.0f);
    }

    float32 stutterTentShape (float32 u, float32 peak)
    {
        if (peak <= 0.000001f)
            return 1.0f - u;

        if (peak >= 0.999999f)
            return u;

        if (u <= peak)
            return u / peak;

        return (1.0f - u) / (1.0f - peak);
    }

    float32 stutterSmoothBellShape (float32 u, float32 peak)
    {
        return smoothStep01 (stutterTentShape (u, peak));
    }

    float32 stutterGateToTriangleShape (float32 u, float32 amount)
    {
        let safeU = clampFloat (u, 0.0f, 1.0f);
        let safeAmount = clampFloat (amount, 0.0f, 1.0f);
        let plateauHalfWidth = 0.5f * (1.0f - safeAmount);
        let slopeWidth = 0.5f - plateauHalfWidth;
        let distance = safeU >= 0.5f ? safeU - 0.5f : 0.5f - safeU;

        if (distance <= plateauHalfWidth)
            return 1.0f;

        if (slopeWidth <= 0.000001f)
            return 1.0f;

        return clampFloat (1.0f - ((distance - plateauHalfWidth) / slopeWidth), 0.0f, 1.0f);
    }

    float32 stutterBaseShape (int32 shapeIndex, float32 u)
    {
        if (shapeIndex == 0)
            return 1.0f;

        if (shapeIndex == 1)
            return u < 0.5f ? 2.0f * u : 2.0f * (1.0f - u);

        if (shapeIndex == 2)
            return stutterSmoothBellShape (u, 0.5f);

        if (shapeIndex == 3)
            return 1.0f - u;

        return u;
    }

    float32 stutterEnvelopeAt (float32 phase, float32 shape, float32 gate)
    {
        let safeGate = clampFloat (gate, 0.0f, 1.0f);
        let safePhase = clampFloat (phase, 0.0f, 1.0f);

        if (safeGate <= 0.0f || safePhase >= safeGate)
            return 0.0f;

        let u = safePhase / safeGate;
        let position = clampFloat (shape, 0.0f, 1.0f) * 4.0f;
        var shapeIndex = int32 (std::intrinsics::floor (position));
        if (shapeIndex > 3)
            shapeIndex = 3;

        let amount = position - float32 (shapeIndex);

        if (shapeIndex == 0)
            return stutterGateToTriangleShape (u, amount);

        if (shapeIndex == 1)
            return (stutterTentShape (u, 0.5f) * (1.0f - amount))
                + (stutterSmoothBellShape (u, 0.5f) * amount);

        if (shapeIndex == 2)
        {
            let peak = 0.5f * (1.0f - amount);
            let roundness = 1.0f - amount;
            return (stutterSmoothBellShape (u, peak) * roundness)
                + (stutterTentShape (u, peak) * (1.0f - roundness));
        }

        if (amount <= 0.5f)
        {
            let exponent = 1.0f + (8.0f * amount);
            return std::intrinsics::pow (1.0f - u, exponent);
        }

        let exponent = 1.0f + (8.0f * (1.0f - amount));
        return std::intrinsics::pow (u, exponent);
    }

    float32 stutterCaptureEnvelopeAt (float32 phase, float32 shape, float32 gate, float32 playbackSpeed)
    {
        let safeGate = clampFloat (gate, 0.0f, 1.0f);
        let safePhase = clampFloat (phase, 0.0f, 1.0f);
        let safePlaybackSpeed = clampFloat (playbackSpeed, 0.5f, 2.0f);

        if (safeGate <= 0.0f)
            return 0.0f;

        let releaseStart = safeGate * 0.5f;
        let repeatPhase = clampFloat (safePhase * safePlaybackSpeed, 0.0f, 1.0f);

        if (repeatPhase < releaseStart)
            return 1.0f;

        return stutterEnvelopeAt (repeatPhase, shape, safeGate);
    }

    float32 tapeStopSpeedAt (float32 elapsedFrames, float32 stopPointFrames, float32 curvePower)
    {
        let safeStopPoint = std::intrinsics::max (1.0f, stopPointFrames);
        let progress = clampFloat (elapsedFrames / safeStopPoint, 0.0f, 1.0f);

        if (progress >= 1.0f)
            return tapeSpeedFloor;

        return tapeSpeedFloor + ((1.0f - tapeSpeedFloor) * std::intrinsics::pow (
            std::intrinsics::max (0.0f, 1.0f - progress),
            clampFloat (curvePower, 0.25f, 4.0f)
        ));
    }

    float32 tapeSpinUpSpeedAt (float32 elapsedFrames, float32 rampEndFrames, float32 curvePower)
    {
        let safeRampEnd = std::intrinsics::max (1.0f, rampEndFrames);
        let progress = clampFloat (elapsedFrames / safeRampEnd, 0.0f, 1.0f);

        if (progress >= 1.0f)
            return 1.0f;

        return tapeSpeedFloor + ((1.0f - tapeSpeedFloor) * std::intrinsics::pow (
            progress,
            clampFloat (curvePower, 0.25f, 4.0f)
        ));
    }

    float32 tapeCurvePowerFromControl (float32 control)
    {
        return std::intrinsics::pow (4.0f, clampFloat (control, -1.0f, 1.0f));
    }

    float32 logLerpHz (float32 startHz, float32 endHz, float32 amount)
    {
        let safeStart = std::intrinsics::max (20.0f, startHz);
        let safeEnd = std::intrinsics::max (20.0f, endHz);
        let logStart = std::intrinsics::log (safeStart);
        let logEnd = std::intrinsics::log (safeEnd);
        return std::intrinsics::exp (logStart + ((logEnd - logStart) * clampFloat (amount, 0.0f, 1.0f)));
    }

    float32 quantize (float32 sample, float32 levels)
    {
        let scaled = sample * levels;

        if (scaled >= 0.0f)
            return std::intrinsics::floor (scaled + 0.5f) / levels;

        return -std::intrinsics::floor (-scaled + 0.5f) / levels;
    }

    int32 resolveFilterMode (int32 mode)
    {
        if (mode == 1)
            return std::filters::simper::Mode::highPass;

        if (mode == 2)
            return std::filters::simper::Mode::bandPass;

        return std::filters::simper::Mode::lowPass;
    }
}

processor SeqFx [[ main ]]
{
    input stream float32<2> audioIn [[ name: "Input" ]];
    output stream float32<2> audioOut [[ name: "Output" ]];

    input event std::timeline::Position positionIn;
    input event std::timeline::Tempo tempoIn;
    input event std::timeline::TransportState transportStateIn;

    input value float32 enabled       [[ name: "SeqFX On", min: 0.0f, max: 1.0f, init: 1.0f, discrete: true, step: 1.0f, rampFrames: 0 ]];
    input value float32 globalMix     [[ name: "SeqFX Mix", min: 0.0f, max: 1.0f, init: 1.0f, rampFrames: 128 ]];
    input value float32 patternSelect [[ name: "Pattern", min: 0.0f, max: 11.0f, init: 0.0f, discrete: true, step: 1.0f, rampFrames: 0 ]];
    input value float32 clockMode     [[ name: "Clock", min: 0.0f, max: 2.0f, init: 0.0f, discrete: true, step: 1.0f, text: "Host|Internal|Manual", rampFrames: 0 ]];
    input value float32 manualBpm     [[ name: "Manual BPM", min: 20.0f, max: 300.0f, init: 120.0f, rampFrames: 128 ]];
    input value float32 rate          [[ name: "Rate", min: 0.0f, max: 2.0f, init: 1.0f, discrete: true, step: 1.0f, text: "1/8|1/16|1/32", rampFrames: 0 ]];
    input value float32 swing         [[ name: "Swing", min: 0.0f, max: 0.45f, init: 0.0f, rampFrames: 128 ]];
    input value float32 loopStart     [[ name: "Loop Start", min: 0.0f, max: 31.0f, init: 0.0f, discrete: true, step: 1.0f, rampFrames: 0 ]];
    input value float32 loopLength    [[ name: "Loop Length", min: 1.0f, max: 32.0f, init: 32.0f, discrete: true, step: 1.0f, rampFrames: 0 ]];

    input event seqfx::SeqPatternUpload patternUpload;
    input event int32 internalPlay;
    input event int32 internalReset;

    output event seqfx::SeqMonitor monitorOut;

    let stutterBufferSize = int (processor.maxFrequency * seqfx::maxStutterSeconds) + 8;

    bool[seqfx::laneCount, seqfx::stepCount] activeSteps;
    bool[seqfx::laneCount, seqfx::stepCount] triggerSteps;
    int32[seqfx::laneCount, seqfx::stepCount] stepEffectTypes;
    float32[seqfx::laneCount, seqfx::stepCount] stepMix;
    float32[seqfx::laneCount, seqfx::stepCount, seqfx::paramCount] stepParams;
    bool[seqfx::laneCount, seqfx::stepCount, seqfx::paramCount] stepAuxEnabled;
    float32[seqfx::laneCount, seqfx::stepCount, seqfx::paramCount] stepAuxEnd;
    float32[seqfx::laneCount, seqfx::stepCount] stepAuxShape;
    float32[seqfx::laneCount, seqfx::stepCount] stepAuxSourceCurve;
    int32[seqfx::laneCount, seqfx::stepCount] stepAuxRateMode;
    int32[seqfx::laneCount, seqfx::stepCount] stepAuxTempoMultiplier;
    bool[seqfx::laneCount, seqfx::stepCount] stepAuxTempoTriplet;
    int32[seqfx::laneCount, seqfx::stepCount] stepAuxSliceCount;
    int32[seqfx::patternCount] acceptedRevisions;

    std::filters::simper::Implementation[seqfx::laneCount, 2] filterStates;

    float32<2>[seqfx::tapePrimaryBufferSize] tapePrimaryHistory0;
    float32<2>[seqfx::tapePrimaryBufferSize] tapePrimaryHistory1;
    float32<2>[seqfx::tapePrimaryBufferSize] tapePrimaryHistory2;
    float32<2>[seqfx::tapePrimaryBufferSize] tapePrimaryHistory3;
    int32[seqfx::tapeCoarseBufferSize] tapeCoarseHistory0;
    int32[seqfx::tapeCoarseBufferSize] tapeCoarseHistory1;
    int32[seqfx::tapeCoarseBufferSize] tapeCoarseHistory2;
    int32[seqfx::tapeCoarseBufferSize] tapeCoarseHistory3;
    float32<2>[seqfx::laneCount, stutterBufferSize] stutterHistory;
    wrap<seqfx::tapePrimaryBufferSize>[seqfx::laneCount] tapePrimaryWriteIndex;
    wrap<seqfx::tapeCoarseBufferSize>[seqfx::laneCount] tapeCoarseWriteIndex;
    int32[seqfx::laneCount] tapePrimaryValidSamples;
    int32[seqfx::laneCount] tapeCoarseValidSamples;
    int64[seqfx::laneCount] tapePrimarySamplesWritten;
    int64[seqfx::laneCount] tapeCoarseSamplesWritten;
    float32[seqfx::laneCount] tapePrimaryWritePhase;
    float32[seqfx::laneCount] tapeCoarseWritePhase;
    float32<2>[seqfx::laneCount] tapePreviousHostSample;
    float32<2>[seqfx::laneCount] tapeCoarseLowpassState;

    int32 selectedPatternIndex;
    int32 currentStep;
    float64 stepProgressFrames;
    float64 currentStepFrames = 1.0;
    bool internalRunning;
    bool hostRunning;
    float32 hostBpm = 120.0f;
    float64 hostQuarterNote;
    bool resetRequested;
    bool processingResetRequested;
    bool hostPositionPending;
    bool hasHostPositionAnchor;
    int64 renderedFrameCounter;
    int64 renderedFrameAtLastHostPosition;
    int64 lastHostFrameIndex;
    float64 lastHostQuarterNote;
    bool needsStepLatch = true;
    bool relatchingFromPatternUpload;
    bool controlStateReady;
    int32 cachedClockMode;
    int32 cachedRate;
    int32 cachedLoopStart;
    int32 cachedLoopLength;
    bool previousEnabled = true;
    float32 bypassMixCurrent = 1.0f;
    float32 bypassMixTarget = 1.0f;
    bool bypassFlushPending;
    bool hasProcessedStage;
    float32<2> lastProcessedStage;
    float32<2> resetCrossfadeFrom;
    float32 resetCrossfadeAge = seqfx::transitionCrossfadeFrames;
    int32[seqfx::laneCount] chainEffectType;
    int32[seqfx::laneCount] chainPreviousEffectType;
    int32[seqfx::laneCount] chainLifecycleState;
    float32[seqfx::laneCount] chainLifecycleAge;
    int32 monitorCountdown;
    int32[seqfx::laneCount] auxBlockStartStep;
    float32[seqfx::laneCount] auxAgeFrames;
    float32[seqfx::laneCount] auxDurationFrames;

    bool[seqfx::laneCount] filterActive;
    int32[seqfx::laneCount] filterMode;
    int32[seqfx::laneCount] previousFilterMode;
    float32[seqfx::laneCount] filterStartHz;
    float32[seqfx::laneCount] filterQ;
    float32[seqfx::laneCount] filterMixCurrent;
    float32[seqfx::laneCount] filterMixTarget;
    float32[seqfx::laneCount] filterModeFade;

    bool[seqfx::laneCount] crusherActive;
    int32[seqfx::laneCount] crusherBits;
    int32[seqfx::laneCount] crusherHoldFrames;
    float32[seqfx::laneCount] crusherDriveDb;
    float32[seqfx::laneCount] crusherMixCurrent;
    float32[seqfx::laneCount] crusherMixTarget;
    float32<2>[seqfx::laneCount] crusherHeld;
    int32[seqfx::laneCount] crusherHoldCounter;
    bool[seqfx::laneCount] crusherNeedsRecapture;

    bool[seqfx::laneCount] tapeLaneActive;
    float32[seqfx::laneCount] tapeMixCurrent;
    float32[seqfx::laneCount] tapeMixTarget;
    bool[seqfx::laneCount, seqfx::tapeVoiceCount] tapeVoiceActive;
    int32[seqfx::laneCount, seqfx::tapeVoiceCount] tapeVoiceGeneration;
    int32[seqfx::laneCount] tapeGenerationCounter;
    int32[seqfx::laneCount, seqfx::tapeVoiceCount] tapeVoiceReturnMode;
    float32[seqfx::laneCount, seqfx::tapeVoiceCount] tapeVoiceAgeFrames;
    float32[seqfx::laneCount, seqfx::tapeVoiceCount] tapeVoiceStopFrames;
    float32[seqfx::laneCount, seqfx::tapeVoiceCount] tapeVoiceStartFrames;
    float32[seqfx::laneCount, seqfx::tapeVoiceCount] tapeVoiceCurvePower;
    float32[seqfx::laneCount, seqfx::tapeVoiceCount] tapeVoiceCharacter;
    float32[seqfx::laneCount, seqfx::tapeVoiceCount] tapeVoiceMix;
    float64[seqfx::laneCount, seqfx::tapeVoiceCount] tapeVoiceReadPosition;
    float32[seqfx::laneCount, seqfx::tapeVoiceCount] tapeVoiceGainCurrent;
    float32[seqfx::laneCount, seqfx::tapeVoiceCount] tapeVoiceGainTarget;
    float32<2>[seqfx::laneCount, seqfx::tapeVoiceCount] tapeVoiceLastOutput;
    float32<2>[seqfx::laneCount, seqfx::tapeVoiceCount] tapeVoiceToneState;
    float32<2>[seqfx::laneCount, seqfx::tapeVoiceCount] tapeVoiceRestartFrom;
    float32[seqfx::laneCount, seqfx::tapeVoiceCount] tapeVoiceRestartAge;

    bool[seqfx::laneCount] stutterLaneActive;
    bool[seqfx::laneCount] stutterCapturing;
    bool[seqfx::laneCount] stutterPlaying;
    float32[seqfx::laneCount] stutterMixCurrent;
    float32[seqfx::laneCount] stutterMixTarget;
    int32[seqfx::laneCount] stutterSliceCount;
    float32[seqfx::laneCount] stutterPlaybackSpeed;
    float32[seqfx::laneCount] stutterShape;
    float32[seqfx::laneCount] stutterGate;
    float32[seqfx::laneCount] stutterBlockDurationFrames;
    float32[seqfx::laneCount] stutterCaptureFrames;
    int32[seqfx::laneCount] stutterReadFrames;
    float32[seqfx::laneCount] stutterReadLength;
    float32[seqfx::laneCount] stutterPhaseFrames;

    void init()
    {
        initialiseDefaultPattern();
        for (wrap<seqfx::laneCount> lane)
        {
            filterStartHz[lane] = 2000.0f;
            filterQ[lane] = 0.707f;
            filterModeFade[lane] = 1.0f;

            crusherBits[lane] = 8;
            crusherHoldFrames[lane] = 1;

            for (wrap<seqfx::tapeVoiceCount> voice)
                tapeVoiceRestartAge[lane, voice] = seqfx::transitionCrossfadeFrames;

            stutterSliceCount[lane] = 8;
            stutterPlaybackSpeed[lane] = 1.0f;
            stutterShape[lane] = 0.55f;
            stutterGate[lane] = 0.68f;
            stutterBlockDurationFrames[lane] = 1.0f;
            stutterReadFrames[lane] = 2;
            stutterReadLength[lane] = 2.0f;

            auxBlockStartStep[lane] = 0;
            auxAgeFrames[lane] = 0.0f;
            auxDurationFrames[lane] = 1.0f;
        }
        currentStep = 0;
        currentStepFrames = 1.0;
        needsStepLatch = true;
    }

    void initialiseDefaultPattern()
    {
        for (wrap<seqfx::laneCount> lane)
        {
            for (wrap<seqfx::stepCount> step)
            {
                activeSteps[lane, step] = false;
                triggerSteps[lane, step] = false;
                stepEffectTypes[lane, step] = seqfx::effectEmpty;
                stepMix[lane, step] = 1.0f;
                stepAuxShape[lane, step] = 0.0f;
                stepAuxSourceCurve[lane, step] = 0.0f;
                stepAuxRateMode[lane, step] = seqfx::auxRateModeSlice;
                stepAuxTempoMultiplier[lane, step] = 4;
                stepAuxTempoTriplet[lane, step] = false;
                stepAuxSliceCount[lane, step] = 1;

                for (wrap<seqfx::paramCount> param)
                {
                    stepParams[lane, step, param] = 0.0f;
                    stepAuxEnabled[lane, step, param] = false;
                    stepAuxEnd[lane, step, param] = 0.0f;
                }
            }
        }

        for (wrap<seqfx::stepCount> step)
        {
            stepParams[seqfx::laneFilter, step, 0] = 0.0f;
            stepParams[seqfx::laneFilter, step, 1] = 2000.0f;
            stepParams[seqfx::laneFilter, step, 2] = 500.0f;
            stepParams[seqfx::laneFilter, step, 3] = 0.707f;
            stepParams[seqfx::laneFilter, step, 4] = 1.0f;

            stepParams[seqfx::laneCrusher, step, 0] = 8.0f;
            stepParams[seqfx::laneCrusher, step, 1] = 1.0f;
            stepParams[seqfx::laneCrusher, step, 2] = 0.0f;

            stepParams[seqfx::laneTapeStop, step, 0] = 8.0f;
            stepParams[seqfx::laneTapeStop, step, 1] = 0.0f;
            stepParams[seqfx::laneTapeStop, step, 2] = 0.0f;
            stepParams[seqfx::laneTapeStop, step, 3] = 1.0f;
            stepParams[seqfx::laneTapeStop, step, 4] = 0.0f;
            stepParams[seqfx::laneTapeStop, step, 5] = 0.0f;
            stepParams[seqfx::laneTapeStop, step, 6] = 500.0f;
            stepParams[seqfx::laneTapeStop, step, 7] = 125.0f;

            stepParams[seqfx::laneStutter, step, 0] = 8.0f;
            stepParams[seqfx::laneStutter, step, 1] = 1.0f;
            stepParams[seqfx::laneStutter, step, 2] = 0.55f;
            stepParams[seqfx::laneStutter, step, 3] = 0.68f;
        }

        for (wrap<seqfx::laneCount> lane)
        {
            for (wrap<seqfx::stepCount> step)
            {
                for (wrap<seqfx::paramCount> param)
                    stepAuxEnd[lane, step, param] = stepParams[lane, step, param];
            }
        }
    }

    event patternUpload (seqfx::SeqPatternUpload upload)
    {
        let uploadPatternIndex = seqfx::clampInt (upload.patternIndex, 0, seqfx::patternCount - 1);
        let uploadPatternSlot = wrap<seqfx::patternCount> (uploadPatternIndex);
        let acceptedRevision = acceptedRevisions[uploadPatternSlot];

        if (! upload.authoritative && upload.revision < acceptedRevision)
            return;

        acceptedRevisions[uploadPatternSlot] = upload.revision;

        if (uploadPatternIndex != selectedPatternIndex)
            return;

        var currentCellChanged = upload.authoritative;

        for (wrap<seqfx::laneCount> lane)
        {
            let currentLaneEffect = selectedEffectForStep (lane, currentStep);
            let currentLaneBlockStart = auxBlockStartStep[lane];

            for (wrap<seqfx::stepCount> step)
            {
                let nextActive = upload.activeSteps[lane, step];
                let nextEffectType = nextActive
                    ? seqfx::clampInt (upload.effectTypes[lane, step], seqfx::effectEmpty, seqfx::effectDirty)
                    : seqfx::effectEmpty;
                let watchesCurrentPlayback = step == currentStep
                    || (currentLaneEffect != seqfx::effectEmpty && step == currentLaneBlockStart);

                if (watchesCurrentPlayback && ! currentCellChanged)
                {
                    let currentEffectType = activeSteps[lane, step]
                        ? seqfx::clampInt (stepEffectTypes[lane, step], seqfx::effectEmpty, seqfx::effectDirty)
                        : seqfx::effectEmpty;

                    if (nextActive != activeSteps[lane, step]
                        || upload.triggerSteps[lane, step] != triggerSteps[lane, step]
                        || nextEffectType != currentEffectType
                        || upload.mix[lane, step] != stepMix[lane, step]
                        || upload.auxShape[lane, step] != stepAuxShape[lane, step]
                        || upload.auxSourceCurve[lane, step] != stepAuxSourceCurve[lane, step]
                        || upload.auxRateMode[lane, step] != stepAuxRateMode[lane, step]
                        || upload.auxTempoMultiplier[lane, step] != stepAuxTempoMultiplier[lane, step]
                        || upload.auxTempoTriplet[lane, step] != stepAuxTempoTriplet[lane, step]
                        || upload.auxSliceCount[lane, step] != stepAuxSliceCount[lane, step])
                    {
                        currentCellChanged = true;
                    }

                    for (wrap<seqfx::paramCount> param)
                    {
                        if (upload.params[lane, step, param] != stepParams[lane, step, param])
                            currentCellChanged = true;

                        if (upload.auxEnabled[lane, step, param] != stepAuxEnabled[lane, step, param]
                            || upload.auxEnd[lane, step, param] != stepAuxEnd[lane, step, param])
                        {
                            currentCellChanged = true;
                        }
                    }
                }

                activeSteps[lane, step] = nextActive;
                triggerSteps[lane, step] = upload.triggerSteps[lane, step];
                stepEffectTypes[lane, step] = nextEffectType;
                stepMix[lane, step] = seqfx::clampFloat (upload.mix[lane, step], 0.0f, 1.0f);
                stepAuxShape[lane, step] = seqfx::clampFloat (upload.auxShape[lane, step], -1.0f, 1.0f);
                stepAuxSourceCurve[lane, step] = seqfx::clampFloat (upload.auxSourceCurve[lane, step], -1.0f, 1.0f);
                stepAuxRateMode[lane, step] = seqfx::clampInt (upload.auxRateMode[lane, step], seqfx::auxRateModeTempo, seqfx::auxRateModeSlice);
                stepAuxTempoMultiplier[lane, step] = seqfx::clampInt (upload.auxTempoMultiplier[lane, step], 1, 64);
                stepAuxTempoTriplet[lane, step] = upload.auxTempoTriplet[lane, step];
                stepAuxSliceCount[lane, step] = seqfx::clampInt (upload.auxSliceCount[lane, step], 1, 32);

                for (wrap<seqfx::paramCount> param)
                {
                    stepParams[lane, step, param] = upload.params[lane, step, param];
                    stepAuxEnabled[lane, step, param] = upload.auxEnabled[lane, step, param];
                    stepAuxEnd[lane, step, param] = upload.auxEnd[lane, step, param];
                }
            }
        }

        if (currentCellChanged)
        {
            if (upload.authoritative)
                processingResetRequested = true;

            relatchingFromPatternUpload = true;
            needsStepLatch = true;
        }
    }

    event internalPlay (int32 value)
    {
        internalRunning = value != 0;
        needsStepLatch = true;
    }

    event internalReset (int32 value)
    {
        if (value == 0)
            return;

        resetRequested = true;
    }

    event tempoIn (std::timeline::Tempo tempo)
    {
        hostBpm = seqfx::clampFloat (tempo.bpm, 20.0f, 300.0f);
        hasHostPositionAnchor = false;
    }

    event transportStateIn (std::timeline::TransportState state)
    {
        let wasHostRunning = hostRunning;
        hostRunning = state.isPlaying();
        if (wasHostRunning && ! hostRunning)
        {
            processingResetRequested = true;
            relatchingFromPatternUpload = false;
        }
    }

    event positionIn (std::timeline::Position position)
    {
        if (hasHostPositionAnchor)
        {
            let elapsedFrames = renderedFrameCounter - renderedFrameAtLastHostPosition;
            let expectedFrameIndex = lastHostFrameIndex + elapsedFrames;
            let frameDelta = position.frameIndex - expectedFrameIndex;
            let expectedQuarterNote = lastHostQuarterNote
                + (float64 (elapsedFrames) / (processor.frequency * (60.0 / float64 (hostBpm))));
            let quarterNoteDelta = position.quarterNote - expectedQuarterNote;

            if (frameDelta < -8 || frameDelta > 8
                || quarterNoteDelta < -0.02 || quarterNoteDelta > 0.02)
            {
                processingResetRequested = true;
            }
        }

        hasHostPositionAnchor = true;
        renderedFrameAtLastHostPosition = renderedFrameCounter;
        lastHostFrameIndex = position.frameIndex;
        lastHostQuarterNote = position.quarterNote;
        hostQuarterNote = position.quarterNote;
        hostPositionPending = true;
    }

    int32 snapValue (float32 value, int32 minValue, int32 maxValue)
    {
        return seqfx::clampInt (seqfx::roundToInt (value), minValue, maxValue);
    }

    int32 resolveClockMode()
    {
        return snapValue (clockMode, 0, 2);
    }

    int32 resolveLoopStart()
    {
        return snapValue (loopStart, 0, seqfx::stepCount - 1);
    }

    int32 resolveLoopLength()
    {
        let start = resolveLoopStart();
        let maximum = seqfx::stepCount - start;
        return snapValue (loopLength, 1, maximum);
    }

    int32 resolveLoopEndExclusive()
    {
        return resolveLoopStart() + resolveLoopLength();
    }

    int32 resolveRate()
    {
        return snapValue (rate, 0, 2);
    }

    float64 stepQuarterNotes()
    {
        let snappedRate = resolveRate();

        if (snappedRate == 0)
            return 0.5;

        if (snappedRate == 2)
            return 0.125;

        return 0.25;
    }

    float64 framesPerQuarter()
    {
        let bpm = seqfx::clampFloat (resolveClockMode() == 0 ? hostBpm : manualBpm, 20.0f, 300.0f);
        return processor.frequency * (60.0 / float64 (bpm));
    }

    float64 stepDurationFramesForStep (int32 step)
    {
        let base = framesPerQuarter() * stepQuarterNotes();
        let start = resolveLoopStart();
        let relativeStep = std::intrinsics::max (0, step - start);
        let swingAmount = float64 (seqfx::clampFloat (swing, 0.0f, 0.45f));

        if ((relativeStep % 2) == 0)
            return std::intrinsics::max (16.0, base * (1.0 - swingAmount));

        return std::intrinsics::max (16.0, base * (1.0 + swingAmount));
    }

    int32 nextStepInLoop (int32 step)
    {
        let next = step + 1;

        if (next >= resolveLoopEndExclusive())
            return resolveLoopStart();

        return next;
    }

    int32 previousStepInLoop (int32 step)
    {
        let start = resolveLoopStart();

        if (step <= start)
            return resolveLoopEndExclusive() - 1;

        return step - 1;
    }

    bool isClockRunning()
    {
        let mode = resolveClockMode();

        if (mode == 0)
            return hostRunning;

        if (mode == 1)
            return internalRunning;

        return true;
    }

    void resetClockToLoopStart()
    {
        currentStep = resolveLoopStart();
        stepProgressFrames = 0.0;
        currentStepFrames = stepDurationFramesForStep (currentStep);
    }

    void refreshControlTransitions()
    {
        let nextClockMode = resolveClockMode();
        let nextRate = resolveRate();
        let nextLoopStart = resolveLoopStart();
        let nextLoopLength = resolveLoopLength();
        let nextEnabled = enabled >= 0.5f;

        if (! controlStateReady)
        {
            cachedClockMode = nextClockMode;
            cachedRate = nextRate;
            cachedLoopStart = nextLoopStart;
            cachedLoopLength = nextLoopLength;
            previousEnabled = nextEnabled;
            bypassMixCurrent = nextEnabled ? 1.0f : 0.0f;
            bypassMixTarget = bypassMixCurrent;
            controlStateReady = true;
            return;
        }

        if (nextClockMode != cachedClockMode
            || nextRate != cachedRate
            || nextLoopStart != cachedLoopStart
            || nextLoopLength != cachedLoopLength)
        {
            cachedClockMode = nextClockMode;
            cachedRate = nextRate;
            cachedLoopStart = nextLoopStart;
            cachedLoopLength = nextLoopLength;
            resetClockToLoopStart();
            processingResetRequested = true;
            relatchingFromPatternUpload = false;
            needsStepLatch = true;
            hasHostPositionAnchor = false;
        }

        if (nextEnabled != previousEnabled)
        {
            bypassMixTarget = nextEnabled ? 1.0f : 0.0f;

            if (! nextEnabled)
                bypassFlushPending = true;
            else if (bypassFlushPending)
            {
                processingResetRequested = true;
                bypassFlushPending = false;
            }

            previousEnabled = nextEnabled;
        }
    }

    void syncHostStepFromQuarterNote()
    {
        let start = resolveLoopStart();
        let length = resolveLoopLength();
        let absoluteStep = int64 (std::intrinsics::floor (hostQuarterNote / stepQuarterNotes()));
        var relative = int32 (absoluteStep % int64 (length));

        if (relative < 0)
            relative += length;

        let nextStep = start + relative;

        if (nextStep != currentStep)
        {
            currentStep = nextStep;
            stepProgressFrames = 0.0;
            currentStepFrames = stepDurationFramesForStep (currentStep);
            releaseTimeEffects();
            relatchingFromPatternUpload = false;
            needsStepLatch = true;
        }
    }

    void refreshSelectedPattern()
    {
        let nextPattern = snapValue (patternSelect, 0, seqfx::patternCount - 1);

        if (nextPattern == selectedPatternIndex)
            return;

        selectedPatternIndex = nextPattern;
        processingResetRequested = true;
        relatchingFromPatternUpload = false;
        needsStepLatch = true;
    }

    void releaseTimeEffects()
    {
        for (wrap<seqfx::laneCount> lane)
        {
            stutterCapturing[lane] = false;
            stutterPlaying[lane] = false;
            tapeMixTarget[lane] = 0.0f;
            stutterMixTarget[lane] = 0.0f;
        }
    }

    void resetProcessingState()
    {
        if (hasProcessedStage)
        {
            resetCrossfadeFrom = lastProcessedStage;
            resetCrossfadeAge = 0.0f;
        }
        else
        {
            resetCrossfadeAge = seqfx::transitionCrossfadeFrames;
        }

        releaseTimeEffects();

        for (wrap<seqfx::laneCount> lane)
        {
            tapePrimaryValidSamples[lane] = 0;
            tapeCoarseValidSamples[lane] = 0;
            tapePrimarySamplesWritten[lane] = 0;
            tapeCoarseSamplesWritten[lane] = 0;
            tapePrimaryWriteIndex[lane] = 0;
            tapeCoarseWriteIndex[lane] = 0;
            tapePrimaryWritePhase[lane] = 0.0f;
            tapeCoarseWritePhase[lane] = 0.0f;
            tapePreviousHostSample[lane] = float32<2> (0.0f);
            tapeCoarseLowpassState[lane] = float32<2> (0.0f);
            for (wrap<seqfx::tapeVoiceCount> voice)
            {
                tapeVoiceActive[lane, voice] = false;
                tapeVoiceAgeFrames[lane, voice] = 0.0f;
                tapeVoiceGainCurrent[lane, voice] = 0.0f;
                tapeVoiceGainTarget[lane, voice] = 0.0f;
                tapeVoiceLastOutput[lane, voice] = float32<2> (0.0f);
                tapeVoiceToneState[lane, voice] = float32<2> (0.0f);
                tapeVoiceRestartAge[lane, voice] = seqfx::transitionCrossfadeFrames;
            }

            stutterCapturing[lane] = false;
            stutterPlaying[lane] = false;
            stutterCaptureFrames[lane] = 0.0f;
            stutterPhaseFrames[lane] = 0.0f;

            filterStates[lane, 0].reset();
            filterStates[lane, 1].reset();
            filterModeFade[lane] = 0.0f;
            crusherHeld[lane] = float32<2> (0.0f);
            crusherHoldCounter[lane] = 0;
            crusherNeedsRecapture[lane] = true;

            filterActive[lane] = false;
            crusherActive[lane] = false;
            tapeLaneActive[lane] = false;
            stutterLaneActive[lane] = false;
            chainPreviousEffectType[lane] = chainEffectType[lane];
            chainEffectType[lane] = seqfx::effectEmpty;
            chainLifecycleState[lane] = seqfx::lifecycleResetting;
            chainLifecycleAge[lane] = 0.0f;
        }

        needsStepLatch = true;
        processingResetRequested = false;
    }

    int32 selectedEffectForStep (wrap<seqfx::laneCount> lane, int32 step)
    {
        let stepIndex = wrap<seqfx::stepCount> (step);

        if (! activeSteps[lane, stepIndex])
            return seqfx::effectEmpty;

        return seqfx::clampInt (stepEffectTypes[lane, stepIndex], seqfx::effectEmpty, seqfx::effectDirty);
    }

    float32 segmentDurationFrames (wrap<seqfx::laneCount> lane, int32 step)
    {
        var sum = 0.0;
        var cursor = step;
        let effectType = selectedEffectForStep (lane, step);

        for (int32 offset = 0; offset < seqfx::stepCount; ++offset)
        {
            if (selectedEffectForStep (lane, cursor) != effectType || effectType == seqfx::effectEmpty)
                break;

            let cursorIndex = wrap<seqfx::stepCount> (cursor);

            if (offset > 0 && triggerSteps[lane, cursorIndex])
                break;

            sum += stepDurationFramesForStep (cursor);
            cursor = nextStepInLoop (cursor);

            if (cursor == step)
                break;
        }

        return float32 (std::intrinsics::max (1.0, sum));
    }

    int32 blockStartStep (wrap<seqfx::laneCount> lane, int32 step)
    {
        var cursor = step;
        let effectType = selectedEffectForStep (lane, step);

        for (int32 offset = 0; offset < seqfx::stepCount; ++offset)
        {
            let cursorIndex = wrap<seqfx::stepCount> (cursor);

            if (triggerSteps[lane, cursorIndex])
                return cursor;

            let previous = previousStepInLoop (cursor);

            if (previous == step || selectedEffectForStep (lane, previous) != effectType || effectType == seqfx::effectEmpty)
                return cursor;

            cursor = previous;
        }

        return cursor;
    }

    float32 elapsedFramesFromBlockStart (wrap<seqfx::laneCount> lane, int32 startStep, int32 targetStep)
    {
        var sum = 0.0;
        var cursor = startStep;
        let effectType = selectedEffectForStep (lane, startStep);

        for (int32 offset = 0; offset < seqfx::stepCount; ++offset)
        {
            if (cursor == targetStep)
                return float32 (sum);

            if (selectedEffectForStep (lane, cursor) != effectType || effectType == seqfx::effectEmpty)
                break;

            let cursorIndex = wrap<seqfx::stepCount> (cursor);

            if (offset > 0 && triggerSteps[lane, cursorIndex])
                break;

            sum += stepDurationFramesForStep (cursor);
            cursor = nextStepInLoop (cursor);

            if (cursor == startStep)
                break;
        }

        return 0.0f;
    }

    float32 auxBlockPhaseForLane (wrap<seqfx::laneCount> lane)
    {
        return seqfx::clampFloat (
            auxAgeFrames[lane] / std::intrinsics::max (1.0f, auxDurationFrames[lane]),
            0.0f,
            1.0f
        );
    }

    float32 auxCycleDurationFramesForLane (wrap<seqfx::laneCount> lane)
    {
        let blockStartIndex = wrap<seqfx::stepCount> (auxBlockStartStep[lane]);
        let rateMode = stepAuxRateMode[lane, blockStartIndex];

        if (rateMode == seqfx::auxRateModeTempo)
        {
            let multiplier = seqfx::clampInt (stepAuxTempoMultiplier[lane, blockStartIndex], 1, 64);
            var duration = float32 (framesPerQuarter() * 0.25 * float64 (multiplier));

            if (stepAuxTempoTriplet[lane, blockStartIndex])
                duration *= 0.6666666667f;

            return std::intrinsics::max (1.0f, duration);
        }

        let sliceCount = seqfx::clampInt (stepAuxSliceCount[lane, blockStartIndex], 1, 32);
        return std::intrinsics::max (1.0f, auxDurationFrames[lane] / float32 (sliceCount));
    }

    float32 auxCyclePhaseForLane (wrap<seqfx::laneCount> lane)
    {
        return seqfx::unitWrap (auxAgeFrames[lane] / auxCycleDurationFramesForLane (lane));
    }

    float32 auxAmountForLane (wrap<seqfx::laneCount> lane)
    {
        let blockStartIndex = wrap<seqfx::stepCount> (auxBlockStartStep[lane]);
        return seqfx::auxSourceAt (
            auxCyclePhaseForLane (lane),
            stepAuxShape[lane, blockStartIndex],
            stepAuxSourceCurve[lane, blockStartIndex]
        );
    }

    float32 auxParamValue (wrap<seqfx::laneCount> lane, int32 param, float32 startValue)
    {
        let blockStartIndex = wrap<seqfx::stepCount> (auxBlockStartStep[lane]);
        let paramIndex = wrap<seqfx::paramCount> (param);

        if (! stepAuxEnabled[lane, blockStartIndex, paramIndex])
            return startValue;

        let amount = auxAmountForLane (lane);
        let endValue = stepAuxEnd[lane, blockStartIndex, paramIndex];
        return startValue + ((endValue - startValue) * amount);
    }

    float32 auxCutoffValue (wrap<seqfx::laneCount> lane, int32 param, float32 startValue)
    {
        let blockStartIndex = wrap<seqfx::stepCount> (auxBlockStartStep[lane]);
        let paramIndex = wrap<seqfx::paramCount> (param);

        if (! stepAuxEnabled[lane, blockStartIndex, paramIndex])
            return clampCutoffHz (startValue);

        let amount = auxAmountForLane (lane);
        let endValue = clampCutoffHz (stepAuxEnd[lane, blockStartIndex, paramIndex]);
        return clampCutoffHz (seqfx::logLerpHz (startValue, endValue, amount));
    }

    void latchAuxBlock (wrap<seqfx::laneCount> lane, int32 blockStart)
    {
        auxBlockStartStep[lane] = blockStart;
        auxAgeFrames[lane] = elapsedFramesFromBlockStart (lane, blockStart, currentStep) + float32 (stepProgressFrames);
        auxDurationFrames[lane] = segmentDurationFrames (lane, blockStart);
    }

    void advanceAuxBlock (wrap<seqfx::laneCount> lane)
    {
        if (selectedEffectForStep (lane, currentStep) == seqfx::effectEmpty)
        {
            auxAgeFrames[lane] = 0.0f;
            return;
        }

        auxAgeFrames[lane] += 1.0f;
    }

    void latchStep()
    {
        for (wrap<seqfx::laneCount> lane)
            latchChainStep (lane);

        emitMonitor();
    }

    void latchChainLifecycle (wrap<seqfx::laneCount> lane, int32 effectType)
    {
        let previousEffect = chainEffectType[lane];
        let currentStepIndex = wrap<seqfx::stepCount> (currentStep);

        if (effectType == seqfx::effectEmpty)
        {
            if (previousEffect != seqfx::effectEmpty)
            {
                chainPreviousEffectType[lane] = previousEffect;
                chainEffectType[lane] = seqfx::effectEmpty;
                chainLifecycleState[lane] = seqfx::lifecycleReleased;
                chainLifecycleAge[lane] = 0.0f;
            }
            else if (chainLifecycleState[lane] == seqfx::lifecycleResetting)
            {
                chainLifecycleState[lane] = seqfx::lifecycleIdle;
            }

            return;
        }

        let retriggered = triggerSteps[lane, currentStepIndex] && ! relatchingFromPatternUpload;
        if (effectType != previousEffect || retriggered)
        {
            chainPreviousEffectType[lane] = previousEffect;
            chainEffectType[lane] = effectType;
            chainLifecycleState[lane] = seqfx::lifecycleEntering;
            chainLifecycleAge[lane] = 0.0f;
            return;
        }

        chainLifecycleState[lane] = seqfx::lifecycleActive;
    }

    void advanceChainLifecycle (wrap<seqfx::laneCount> lane)
    {
        let state = chainLifecycleState[lane];

        if (state != seqfx::lifecycleEntering && state != seqfx::lifecycleReleased)
            return;

        chainLifecycleAge[lane] += 1.0f;
        if (chainLifecycleAge[lane] < seqfx::transitionCrossfadeFrames)
            return;

        if (state == seqfx::lifecycleEntering)
            chainLifecycleState[lane] = seqfx::lifecycleActive;
        else
            chainLifecycleState[lane] = seqfx::lifecycleIdle;
    }

    void latchChainStep (wrap<seqfx::laneCount> lane)
    {
        let currentStepIndex = wrap<seqfx::stepCount> (currentStep);
        let effectType = selectedEffectForStep (lane, currentStep);
        let targetMix = effectType == seqfx::effectEmpty ? 0.0f : stepMix[lane, currentStepIndex];
        let wasFilterActive = filterActive[lane];
        let wasCrusherActive = crusherActive[lane];
        let wasTapeActive = tapeLaneActive[lane];
        let wasStutterActive = stutterLaneActive[lane];

        latchChainLifecycle (lane, effectType);

        filterActive[lane] = effectType == seqfx::effectFilter;
        crusherActive[lane] = effectType == seqfx::effectCrusher;
        tapeLaneActive[lane] = effectType == seqfx::effectTapeStop;
        stutterLaneActive[lane] = effectType == seqfx::effectStutter;

        filterMixTarget[lane] = filterActive[lane] ? targetMix : 0.0f;
        crusherMixTarget[lane] = crusherActive[lane] ? targetMix : 0.0f;
        tapeMixTarget[lane] = tapeLaneActive[lane] ? targetMix : 0.0f;
        stutterMixTarget[lane] = stutterLaneActive[lane] ? targetMix : 0.0f;

        if (effectType != seqfx::effectEmpty)
            latchAuxBlock (lane, blockStartStep (lane, currentStep));
        else
        {
            auxAgeFrames[lane] = 0.0f;
            auxDurationFrames[lane] = 1.0f;
        }

        if (! stutterLaneActive[lane])
        {
            stutterCapturing[lane] = false;
            stutterPlaying[lane] = false;
        }

        if (filterActive[lane])
            latchFilterStep (lane, wasFilterActive);

        if (crusherActive[lane])
            latchCrusherStep (lane, wasCrusherActive);

        if (tapeLaneActive[lane])
            latchTapeStep (lane, wasTapeActive);

        if (stutterLaneActive[lane])
            latchStutterStep (lane, wasStutterActive);
    }

    float32 clampCutoffHz (float32 value)
    {
        let maximum = std::intrinsics::min (20000.0f, float32 (processor.frequency) * 0.45f);
        return seqfx::clampFloat (value, 20.0f, maximum);
    }

    void latchFilterStep (wrap<seqfx::laneCount> lane, bool wasActive)
    {
        let currentStepIndex = wrap<seqfx::stepCount> (currentStep);

        if (wasActive && ! triggerSteps[lane, currentStepIndex] && ! relatchingFromPatternUpload)
            return;

        let blockStart = blockStartStep (lane, currentStep);
        let blockStartIndex = wrap<seqfx::stepCount> (blockStart);
        previousFilterMode[lane] = filterMode[lane];
        filterMode[lane] = snapValue (stepParams[lane, blockStartIndex, 0], 0, 2);
        filterStartHz[lane] = clampCutoffHz (stepParams[lane, blockStartIndex, 1]);
        filterQ[lane] = seqfx::clampFloat (stepParams[lane, blockStartIndex, 3], 0.1f, 20.0f);

        if (filterMode[lane] != previousFilterMode[lane])
        {
            filterStates[lane, 0].reset();
            filterStates[lane, 1].reset();
            filterModeFade[lane] = 0.0f;
        }
    }

    void latchCrusherStep (wrap<seqfx::laneCount> lane, bool wasActive)
    {
        let currentStepIndex = wrap<seqfx::stepCount> (currentStep);

        if (wasActive && ! triggerSteps[lane, currentStepIndex] && ! relatchingFromPatternUpload)
            return;

        let blockStart = blockStartStep (lane, currentStep);
        let blockStartIndex = wrap<seqfx::stepCount> (blockStart);
        let nextBits = snapValue (stepParams[lane, blockStartIndex, 0], 4, 16);
        let nextHoldFrames = snapValue (stepParams[lane, blockStartIndex, 1], 1, 64);
        let nextDriveDb = seqfx::clampFloat (stepParams[lane, blockStartIndex, 2], 0.0f, 36.0f);
        let needsFreshHeldSample = ! wasActive
            || triggerSteps[lane, currentStepIndex]
            || nextHoldFrames != crusherHoldFrames[lane]
            || nextDriveDb != crusherDriveDb[lane];

        crusherBits[lane] = nextBits;
        crusherHoldFrames[lane] = nextHoldFrames;
        crusherDriveDb[lane] = nextDriveDb;

        if (needsFreshHeldSample)
        {
            crusherHoldCounter[lane] = 0;
            crusherNeedsRecapture[lane] = true;
        }
    }

    void latchTapeStep (wrap<seqfx::laneCount> lane, bool wasActive)
    {
        let currentStepIndex = wrap<seqfx::stepCount> (currentStep);

        if (! wasActive || (triggerSteps[lane, currentStepIndex] && ! relatchingFromPatternUpload))
        {
            let blockStart = blockStartStep (lane, currentStep);
            let blockStartIndex = wrap<seqfx::stepCount> (blockStart);
            startTapeStop (lane, blockStartIndex);
        }
    }

    void latchStutterStep (wrap<seqfx::laneCount> lane, bool wasActive)
    {
        let currentStepIndex = wrap<seqfx::stepCount> (currentStep);
        let blockStart = blockStartStep (lane, currentStep);
        let blockStartIndex = wrap<seqfx::stepCount> (blockStart);
        let nextSliceCount = snapValue (stepParams[lane, blockStartIndex, 0], 2, 32);
        let endSliceCount = stepAuxEnabled[lane, blockStartIndex, 0]
            ? snapValue (stepAuxEnd[lane, blockStartIndex, 0], 2, 32)
            : nextSliceCount;
        var captureSliceCount = nextSliceCount;
        if (endSliceCount < captureSliceCount)
            captureSliceCount = endSliceCount;
        let nextBlockFrames = segmentDurationFrames (lane, blockStart);
        let nextReadFrames = seqfx::clampInt (
            int32 (resolveSliceFramesForCount (nextBlockFrames, captureSliceCount)),
            2,
            stutterBufferSize - 8
        );
        let structureChanged = nextSliceCount != stutterSliceCount[lane] || nextReadFrames != stutterReadFrames[lane];
        let shouldRestart = ! wasActive
            || (! relatchingFromPatternUpload && triggerSteps[lane, currentStepIndex])
            || (relatchingFromPatternUpload && structureChanged);

        stutterPlaybackSpeed[lane] = seqfx::clampFloat (stepParams[lane, currentStepIndex, 1], 0.5f, 2.0f);
        stutterSliceCount[lane] = nextSliceCount;
        stutterShape[lane] = seqfx::clampFloat (stepParams[lane, blockStartIndex, 2], 0.0f, 1.0f);
        stutterGate[lane] = seqfx::clampFloat (stepParams[lane, blockStartIndex, 3], 0.0f, 1.0f);

        if (shouldRestart)
            startStutter (lane, nextBlockFrames, captureSliceCount);
    }

    float32 resolveSliceFramesForCount (float32 blockFrames, int32 sliceCount)
    {
        let requestedFrames = blockFrames / float32 (std::intrinsics::max (1, sliceCount));
        let frameCount = seqfx::clampInt (int32 (requestedFrames), 2, stutterBufferSize - 8);
        return float32 (frameCount);
    }

    float32 resolveSliceFrames (wrap<seqfx::laneCount> lane, float32 blockFrames)
    {
        let requestedFrames = blockFrames / float32 (std::intrinsics::max (1, stutterSliceCount[lane]));
        let frameCount = seqfx::clampInt (int32 (requestedFrames), 2, stutterBufferSize - 8);
        return float32 (frameCount);
    }

    float64 tapeDivisionQuarterNotes (int32 divisionIndex)
    {
        if (divisionIndex == 0)
            return 0.125;
        if (divisionIndex == 1)
            return 0.25;
        if (divisionIndex == 2)
            return 0.5;
        if (divisionIndex == 3)
            return 1.0;
        if (divisionIndex == 4)
            return 2.0;
        if (divisionIndex == 5)
            return 4.0;
        if (divisionIndex == 6)
            return 8.0;
        if (divisionIndex == 7)
            return 16.0;

        return stepQuarterNotes();
    }

    float32 tapeDurationFramesForParams (
        wrap<seqfx::laneCount> lane,
        wrap<seqfx::stepCount> blockStartIndex,
        int32 divisionParam,
        int32 freeTimeParam)
    {
        let timingMode = snapValue (stepParams[lane, blockStartIndex, 5], seqfx::tapeTimingSync, seqfx::tapeTimingFree);

        if (timingMode == seqfx::tapeTimingFree)
        {
            let milliseconds = seqfx::clampFloat (stepParams[lane, blockStartIndex, wrap<seqfx::paramCount> (freeTimeParam)], 20.0f, 8000.0f);
            return std::intrinsics::max (1.0f, milliseconds * float32 (processor.frequency) * 0.001f);
        }

        let division = snapValue (
            stepParams[lane, blockStartIndex, wrap<seqfx::paramCount> (divisionParam)],
            0,
            8
        );
        return float32 (std::intrinsics::max (
            1.0,
            framesPerQuarter() * tapeDivisionQuarterNotes (division)
        ));
    }

    int32 allocateTapeVoice (wrap<seqfx::laneCount> lane)
    {
        for (wrap<seqfx::tapeVoiceCount> voice)
        {
            if (! tapeVoiceActive[lane, voice])
                return int32 (voice);
        }

        var selected = 0;
        for (int32 voice = 1; voice < seqfx::tapeVoiceCount; ++voice)
        {
            let selectedVoice = wrap<seqfx::tapeVoiceCount> (selected);
            let candidateVoice = wrap<seqfx::tapeVoiceCount> (voice);
            let quieter = tapeVoiceGainCurrent[lane, candidateVoice] < tapeVoiceGainCurrent[lane, selectedVoice];
            let sameGainAndOlder = tapeVoiceGainCurrent[lane, candidateVoice] == tapeVoiceGainCurrent[lane, selectedVoice]
                && tapeVoiceGeneration[lane, candidateVoice] < tapeVoiceGeneration[lane, selectedVoice];

            if (quieter || sameGainAndOlder)
                selected = voice;
        }

        return selected;
    }

    void startTapeStop (wrap<seqfx::laneCount> lane, wrap<seqfx::stepCount> blockStartIndex)
    {
        if (tapePrimaryValidSamples[lane] < 8)
            return;

        let selectedVoiceIndex = allocateTapeVoice (lane);
        let selectedVoice = wrap<seqfx::tapeVoiceCount> (selectedVoiceIndex);
        let wasActive = tapeVoiceActive[lane, selectedVoice];
        let previousOutput = tapeVoiceLastOutput[lane, selectedVoice];

        for (wrap<seqfx::tapeVoiceCount> voice)
        {
            if (voice != selectedVoice)
                tapeVoiceGainTarget[lane, voice] = 0.0f;
        }

        tapeGenerationCounter[lane] += 1;
        tapeVoiceGeneration[lane, selectedVoice] = tapeGenerationCounter[lane];
        tapeVoiceActive[lane, selectedVoice] = true;
        tapeVoiceReturnMode[lane, selectedVoice] = snapValue (
            stepParams[lane, blockStartIndex, 2],
            seqfx::tapeReturnCatchUp,
            seqfx::tapeReturnSpinUp
        );
        tapeVoiceAgeFrames[lane, selectedVoice] = 0.0f;
        tapeVoiceStopFrames[lane, selectedVoice] = tapeDurationFramesForParams (lane, blockStartIndex, 0, 6);
        tapeVoiceStartFrames[lane, selectedVoice] = tapeDurationFramesForParams (lane, blockStartIndex, 3, 7);
        tapeVoiceCurvePower[lane, selectedVoice] = seqfx::tapeCurvePowerFromControl (
            stepParams[lane, blockStartIndex, 1]
        );
        tapeVoiceCharacter[lane, selectedVoice] = seqfx::clampFloat (
            stepParams[lane, blockStartIndex, 4],
            0.0f,
            1.0f
        );
        tapeVoiceMix[lane, selectedVoice] = seqfx::clampFloat (stepMix[lane, blockStartIndex], 0.0f, 1.0f);
        tapeVoiceReadPosition[lane, selectedVoice] = float64 (tapePrimarySamplesWritten[lane] - 4);
        tapeVoiceGainCurrent[lane, selectedVoice] = wasActive
            ? tapeVoiceGainCurrent[lane, selectedVoice]
            : 0.0f;
        tapeVoiceGainTarget[lane, selectedVoice] = 1.0f;
        tapeVoiceRestartFrom[lane, selectedVoice] = previousOutput;
        tapeVoiceRestartAge[lane, selectedVoice] = wasActive
            ? 0.0f
            : seqfx::transitionCrossfadeFrames;
        tapeVoiceToneState[lane, selectedVoice] = readTapeHistory (
            lane,
            tapeVoiceReadPosition[lane, selectedVoice]
        );
    }

    void startStutter (wrap<seqfx::laneCount> lane, float32 blockFrames, int32 captureSliceCount)
    {
        stutterBlockDurationFrames[lane] = std::intrinsics::max (1.0f, blockFrames);
        let sliceFrames = resolveSliceFramesForCount (stutterBlockDurationFrames[lane], captureSliceCount);
        stutterReadFrames[lane] = seqfx::clampInt (int32 (sliceFrames), 2, stutterBufferSize - 8);
        stutterReadLength[lane] = float32 (stutterReadFrames[lane]);
        stutterCaptureFrames[lane] = 0.0f;
        stutterPhaseFrames[lane] = 0.0f;
        stutterCapturing[lane] = true;
        stutterPlaying[lane] = false;
    }

    void writeTapePrimarySample (wrap<seqfx::laneCount> lane, float32<2> sample)
    {
        let index = tapePrimaryWriteIndex[lane];
        if (lane == 0)
            tapePrimaryHistory0[index] = sample;
        else if (lane == 1)
            tapePrimaryHistory1[index] = sample;
        else if (lane == 2)
            tapePrimaryHistory2[index] = sample;
        else
            tapePrimaryHistory3[index] = sample;

        tapePrimaryWriteIndex[lane] = wrap<seqfx::tapePrimaryBufferSize> (int32 (index) + 1);
        tapePrimarySamplesWritten[lane] += 1;
        if (tapePrimaryValidSamples[lane] < seqfx::tapePrimaryBufferSize - 4)
            tapePrimaryValidSamples[lane] += 1;
    }

    int32 packTapeStereo16 (float32<2> sample)
    {
        let left = seqfx::roundToInt (seqfx::clampFloat (sample[0], -1.0f, 1.0f) * 32767.0f);
        let right = seqfx::roundToInt (seqfx::clampFloat (sample[1], -1.0f, 1.0f) * 32767.0f);
        return (left & 65535) | (right << 16);
    }

    float32<2> unpackTapeStereo16 (int32 packed)
    {
        let left = (packed << 16) >> 16;
        let right = packed >> 16;
        return float32<2> (float32 (left) / 32767.0f, float32 (right) / 32767.0f);
    }

    void writeTapeCoarseSample (wrap<seqfx::laneCount> lane, float32<2> sample)
    {
        let index = tapeCoarseWriteIndex[lane];
        let packed = packTapeStereo16 (sample);
        if (lane == 0)
            tapeCoarseHistory0[index] = packed;
        else if (lane == 1)
            tapeCoarseHistory1[index] = packed;
        else if (lane == 2)
            tapeCoarseHistory2[index] = packed;
        else
            tapeCoarseHistory3[index] = packed;

        tapeCoarseWriteIndex[lane] = wrap<seqfx::tapeCoarseBufferSize> (int32 (index) + 1);
        tapeCoarseSamplesWritten[lane] += 1;
        if (tapeCoarseValidSamples[lane] < seqfx::tapeCoarseBufferSize - 4)
            tapeCoarseValidSamples[lane] += 1;
    }

    void writeTapeHistory (wrap<seqfx::laneCount> lane, float32<2> sample)
    {
        let primaryRatio = seqfx::tapePrimaryRate / float32 (processor.frequency);
        tapePrimaryWritePhase[lane] += primaryRatio;
        while (tapePrimaryWritePhase[lane] >= 1.0f)
        {
            let overshoot = tapePrimaryWritePhase[lane] - 1.0f;
            let fraction = seqfx::clampFloat (1.0f - (overshoot / primaryRatio), 0.0f, 1.0f);
            let resampled = tapePreviousHostSample[lane]
                + ((sample - tapePreviousHostSample[lane]) * fraction);
            writeTapePrimarySample (lane, resampled);
            tapePrimaryWritePhase[lane] -= 1.0f;
        }

        let coarseCutoff = std::intrinsics::min (3200.0f, float32 (processor.frequency) * 0.2f);
        let coarseCoefficient = 1.0f - std::intrinsics::exp (
            (-2.0f * seqfx::pi * coarseCutoff) / float32 (processor.frequency)
        );
        tapeCoarseLowpassState[lane] += (sample - tapeCoarseLowpassState[lane]) * coarseCoefficient;

        let coarseRatio = seqfx::tapeCoarseRate / float32 (processor.frequency);
        tapeCoarseWritePhase[lane] += coarseRatio;
        while (tapeCoarseWritePhase[lane] >= 1.0f)
        {
            writeTapeCoarseSample (lane, tapeCoarseLowpassState[lane]);
            tapeCoarseWritePhase[lane] -= 1.0f;
        }

        tapePreviousHostSample[lane] = sample;
    }

    void captureStutterSample (wrap<seqfx::laneCount> lane, float32<2> sample)
    {
        stutterHistory[lane, wrap<stutterBufferSize> (int32 (stutterCaptureFrames[lane]))] = sample;
        stutterCaptureFrames[lane] += 1.0f;

        if (stutterCaptureFrames[lane] >= stutterReadLength[lane])
        {
            stutterCapturing[lane] = false;
            stutterPlaying[lane] = true;
            stutterPhaseFrames[lane] = 0.0f;
        }
    }

    float32<2> readTapePrimaryAt (wrap<seqfx::laneCount> lane, int64 absoluteIndex)
    {
        let index = wrap<seqfx::tapePrimaryBufferSize> (
            int32 (absoluteIndex % int64 (seqfx::tapePrimaryBufferSize))
        );
        if (lane == 0)
            return tapePrimaryHistory0[index];
        if (lane == 1)
            return tapePrimaryHistory1[index];
        if (lane == 2)
            return tapePrimaryHistory2[index];
        return tapePrimaryHistory3[index];
    }

    float32<2> readTapeCoarseAt (wrap<seqfx::laneCount> lane, int64 absoluteIndex)
    {
        let index = wrap<seqfx::tapeCoarseBufferSize> (
            int32 (absoluteIndex % int64 (seqfx::tapeCoarseBufferSize))
        );
        if (lane == 0)
            return unpackTapeStereo16 (tapeCoarseHistory0[index]);
        if (lane == 1)
            return unpackTapeStereo16 (tapeCoarseHistory1[index]);
        if (lane == 2)
            return unpackTapeStereo16 (tapeCoarseHistory2[index]);
        return unpackTapeStereo16 (tapeCoarseHistory3[index]);
    }

    bool tapePrimaryPositionIsValid (wrap<seqfx::laneCount> lane, float64 position)
    {
        let currentIndex = int64 (std::intrinsics::floor (position));
        let earliest = tapePrimarySamplesWritten[lane] - int64 (tapePrimaryValidSamples[lane]);
        return currentIndex - 1 >= earliest && currentIndex + 2 < tapePrimarySamplesWritten[lane];
    }

    bool tapeCoarsePositionIsValid (wrap<seqfx::laneCount> lane, float64 position)
    {
        let currentIndex = int64 (std::intrinsics::floor (position));
        let earliest = tapeCoarseSamplesWritten[lane] - int64 (tapeCoarseValidSamples[lane]);
        return currentIndex - 1 >= earliest && currentIndex + 2 < tapeCoarseSamplesWritten[lane];
    }

    float32<2> readTapePrimary (wrap<seqfx::laneCount> lane, float64 position)
    {
        let currentIndex = int64 (std::intrinsics::floor (position));
        let fraction = float32 (position - float64 (currentIndex));
        return seqfx::cubicHermite4 (
            readTapePrimaryAt (lane, currentIndex - 1),
            readTapePrimaryAt (lane, currentIndex),
            readTapePrimaryAt (lane, currentIndex + 1),
            readTapePrimaryAt (lane, currentIndex + 2),
            fraction
        );
    }

    float32<2> readTapeCoarse (wrap<seqfx::laneCount> lane, float64 position)
    {
        let currentIndex = int64 (std::intrinsics::floor (position));
        let fraction = float32 (position - float64 (currentIndex));
        return seqfx::cubicHermite4 (
            readTapeCoarseAt (lane, currentIndex - 1),
            readTapeCoarseAt (lane, currentIndex),
            readTapeCoarseAt (lane, currentIndex + 1),
            readTapeCoarseAt (lane, currentIndex + 2),
            fraction
        );
    }

    float32<2> readTapeHistory (wrap<seqfx::laneCount> lane, float64 primaryPosition)
    {
        let coarsePosition = primaryPosition * (float64 (seqfx::tapeCoarseRate) / float64 (seqfx::tapePrimaryRate));
        let primaryValid = tapePrimaryPositionIsValid (lane, primaryPosition);
        let coarseValid = tapeCoarsePositionIsValid (lane, coarsePosition);

        if (! primaryValid && ! coarseValid)
            return float32<2> (0.0f);
        if (! primaryValid)
            return readTapeCoarse (lane, coarsePosition);
        if (! coarseValid)
            return readTapePrimary (lane, primaryPosition);

        let ageSeconds = float32 (
            (float64 (tapePrimarySamplesWritten[lane]) - primaryPosition)
                / float64 (seqfx::tapePrimaryRate)
        );
        let coarseFade = seqfx::smoothStep01 (seqfx::clampFloat ((ageSeconds - 14.5f) / 1.0f, 0.0f, 1.0f));
        let primary = readTapePrimary (lane, primaryPosition);
        let coarse = readTapeCoarse (lane, coarsePosition);
        return primary + ((coarse - primary) * coarseFade);
    }

    float32<2> readStutterCapture (wrap<seqfx::laneCount> lane, float32 position)
    {
        let wrapped = std::intrinsics::wrap (position, stutterReadLength[lane]);
        let currentIndex = int32 (std::intrinsics::floor (wrapped));
        let fraction = wrapped - float32 (currentIndex);
        let readFrameLimit = seqfx::clampInt (int32 (stutterReadLength[lane]), 2, stutterReadFrames[lane]);
        var previousIndex = currentIndex - 1;
        var followingIndex = currentIndex + 1;
        var nextFollowingIndex = currentIndex + 2;

        if (previousIndex < 0)
            previousIndex += readFrameLimit;
        if (followingIndex >= readFrameLimit)
            followingIndex -= readFrameLimit;
        while (nextFollowingIndex >= readFrameLimit)
            nextFollowingIndex -= readFrameLimit;

        return seqfx::cubicHermite4 (
            stutterHistory[lane, wrap<stutterBufferSize> (previousIndex)],
            stutterHistory[lane, wrap<stutterBufferSize> (currentIndex)],
            stutterHistory[lane, wrap<stutterBufferSize> (followingIndex)],
            stutterHistory[lane, wrap<stutterBufferSize> (nextFollowingIndex)],
            fraction
        );
    }

    float32<2> processFilter (wrap<seqfx::laneCount> lane, float32<2> stage)
    {
        filterMixCurrent[lane] = seqfx::moveTowards (filterMixCurrent[lane], filterMixTarget[lane], 1.0f / 96.0f);

        if (filterMixCurrent[lane] <= 0.00001f)
            return stage;

        let cutoffHz = auxCutoffValue (lane, 1, filterStartHz[lane]);
        let currentQ = seqfx::clampFloat (auxParamValue (lane, 3, filterQ[lane]), 0.1f, 20.0f);
        let currentMode = snapValue (auxParamValue (lane, 0, float32 (filterMode[lane])), 0, 2);
        let mode = seqfx::resolveFilterMode (currentMode);

        filterStates[lane, 0].setMode (mode);
        filterStates[lane, 1].setMode (mode);
        filterStates[lane, 0].setFrequency (processor.frequency, cutoffHz, currentQ, 0.0f);
        filterStates[lane, 1].setFrequency (processor.frequency, cutoffHz, currentQ, 0.0f);

        var filtered = float32<2> (
            filterStates[lane, 0].process (stage[0]),
            filterStates[lane, 1].process (stage[1])
        );

        filterModeFade[lane] = seqfx::moveTowards (filterModeFade[lane], 1.0f, 1.0f / std::intrinsics::max (1.0f, float32 (processor.frequency) * 0.005f));
        filtered = stage + ((filtered - stage) * filterModeFade[lane]);

        return stage + ((filtered - stage) * filterMixCurrent[lane]);
    }

    float32<2> processCrusher (wrap<seqfx::laneCount> lane, float32<2> stage)
    {
        crusherMixCurrent[lane] = seqfx::moveTowards (crusherMixCurrent[lane], crusherMixTarget[lane], 1.0f / 64.0f);

        if (crusherMixCurrent[lane] <= 0.00001f)
            return stage;

        let currentBits = snapValue (auxParamValue (lane, 0, float32 (crusherBits[lane])), 4, 16);
        let currentHoldFrames = snapValue (auxParamValue (lane, 1, float32 (crusherHoldFrames[lane])), 1, 64);
        let currentDriveDb = seqfx::clampFloat (auxParamValue (lane, 2, crusherDriveDb[lane]), 0.0f, 36.0f);
        let driveGain = seqfx::dbToGain (currentDriveDb);
        let driven = float32<2> (
            seqfx::clampFloat (stage[0], -1.0f, 1.0f),
            seqfx::clampFloat (stage[1], -1.0f, 1.0f)
        ) * driveGain;
        let clipped = float32<2> (
            seqfx::clampFloat (driven[0], -1.0f, 1.0f),
            seqfx::clampFloat (driven[1], -1.0f, 1.0f)
        );

        if (crusherNeedsRecapture[lane] || crusherHoldCounter[lane] <= 0)
        {
            crusherHeld[lane] = clipped;
            crusherNeedsRecapture[lane] = false;
            crusherHoldCounter[lane] = currentHoldFrames;
        }

        crusherHoldCounter[lane] -= 1;

        let levels = float32 ((1 << (currentBits - 1)) - 1);
        let crushed = float32<2> (
            seqfx::quantize (crusherHeld[lane][0], levels),
            seqfx::quantize (crusherHeld[lane][1], levels)
        );

        return stage + ((crushed - stage) * crusherMixCurrent[lane]);
    }

    float32<2> processTapeCharacter (
        wrap<seqfx::laneCount> lane,
        wrap<seqfx::tapeVoiceCount> voice,
        float32<2> sample,
        float32 speed)
    {
        let character = tapeVoiceCharacter[lane, voice];
        if (character <= 0.00001f)
            return sample;

        let slowAmount = character * (1.0f - seqfx::clampFloat (speed, 0.0f, 1.0f));
        let maximumCutoff = std::intrinsics::min (20000.0f, float32 (processor.frequency) * 0.45f);
        let cutoff = maximumCutoff + ((1200.0f - maximumCutoff) * slowAmount);
        let coefficient = 1.0f - std::intrinsics::exp (
            (-2.0f * seqfx::pi * cutoff) / float32 (processor.frequency)
        );
        tapeVoiceToneState[lane, voice] += (sample - tapeVoiceToneState[lane, voice]) * coefficient;

        let drive = 1.0f + (slowAmount * 2.0f);
        let driven = tapeVoiceToneState[lane, voice] * drive;
        return float32<2> (
            driven[0] / (1.0f + (std::intrinsics::abs (driven[0]) * slowAmount)),
            driven[1] / (1.0f + (std::intrinsics::abs (driven[1]) * slowAmount))
        );
    }

    float32<2> processTapeStop (wrap<seqfx::laneCount> lane, float32<2> stage)
    {
        var accumulated = float32<2> (0.0f);
        var accumulatedGain = 0.0f;

        for (wrap<seqfx::tapeVoiceCount> voice)
        {
            if (! tapeVoiceActive[lane, voice])
                continue;

            tapeVoiceGainCurrent[lane, voice] = seqfx::moveTowards (
                tapeVoiceGainCurrent[lane, voice],
                tapeVoiceGainTarget[lane, voice],
                1.0f / seqfx::transitionCrossfadeFrames
            );

            if (tapeVoiceGainCurrent[lane, voice] <= 0.00001f
                && tapeVoiceGainTarget[lane, voice] <= 0.00001f)
            {
                tapeVoiceActive[lane, voice] = false;
                continue;
            }

            let age = tapeVoiceAgeFrames[lane, voice];
            let stopFrames = tapeVoiceStopFrames[lane, voice];
            let startFrames = tapeVoiceStartFrames[lane, voice];
            let returnMode = tapeVoiceReturnMode[lane, voice];
            let catchUpFrames = std::intrinsics::max (
                seqfx::transitionCrossfadeFrames,
                float32 (processor.frequency) * 0.01f
            );
            let returnFrames = returnMode == seqfx::tapeReturnSpinUp ? startFrames : catchUpFrames;
            let totalFrames = stopFrames + returnFrames;

            if (age >= totalFrames)
            {
                tapeVoiceActive[lane, voice] = false;
                tapeVoiceGainCurrent[lane, voice] = 0.0f;
                tapeVoiceGainTarget[lane, voice] = 0.0f;
                continue;
            }

            var speed = seqfx::tapeSpeedFloor;
            var voiceOutput = float32<2> (0.0f);

            if (age < stopFrames)
            {
                speed = seqfx::tapeStopSpeedAt (age, stopFrames, tapeVoiceCurvePower[lane, voice]);
                voiceOutput = processTapeCharacter (
                    lane,
                    voice,
                    readTapeHistory (lane, tapeVoiceReadPosition[lane, voice]),
                    speed
                );

                let terminalFrames = seqfx::clampFloat (
                    float32 (processor.frequency) * 0.01f,
                    1.0f,
                    std::intrinsics::max (1.0f, stopFrames * 0.1f)
                );
                if (age > stopFrames - terminalFrames)
                {
                    let terminalPhase = (stopFrames - age) / terminalFrames;
                    voiceOutput *= seqfx::smoothStep01 (terminalPhase);
                }
            }
            else
            {
                let returnPhase = seqfx::clampFloat ((age - stopFrames) / returnFrames, 0.0f, 1.0f);
                if (returnMode == seqfx::tapeReturnSpinUp)
                {
                    speed = seqfx::tapeSpinUpSpeedAt (
                        age - stopFrames,
                        returnFrames,
                        tapeVoiceCurvePower[lane, voice]
                    );
                    let spun = processTapeCharacter (
                        lane,
                        voice,
                        readTapeHistory (lane, tapeVoiceReadPosition[lane, voice]),
                        speed
                    );
                    let startFade = seqfx::smoothStep01 (seqfx::clampFloat (returnPhase * 10.0f, 0.0f, 1.0f));
                    let liveFade = seqfx::smoothStep01 (seqfx::clampFloat ((returnPhase - 0.9f) * 10.0f, 0.0f, 1.0f));
                    voiceOutput = (spun * startFade * (1.0f - liveFade)) + (stage * liveFade);
                }
                else
                {
                    voiceOutput = stage * seqfx::smoothStep01 (returnPhase);
                }
            }

            if (tapeVoiceRestartAge[lane, voice] < seqfx::transitionCrossfadeFrames)
            {
                let restartFade = seqfx::smoothStep01 (
                    tapeVoiceRestartAge[lane, voice] / seqfx::transitionCrossfadeFrames
                );
                voiceOutput = tapeVoiceRestartFrom[lane, voice]
                    + ((voiceOutput - tapeVoiceRestartFrom[lane, voice]) * restartFade);
                tapeVoiceRestartAge[lane, voice] += 1.0f;
            }

            tapeVoiceLastOutput[lane, voice] = voiceOutput;
            tapeVoiceReadPosition[lane, voice] += float64 (speed)
                * (float64 (seqfx::tapePrimaryRate) / processor.frequency);
            tapeVoiceAgeFrames[lane, voice] += 1.0f;

            let voiceGain = tapeVoiceGainCurrent[lane, voice];
            let voiceResult = stage + ((voiceOutput - stage) * tapeVoiceMix[lane, voice]);
            accumulated += voiceResult * voiceGain;
            accumulatedGain += voiceGain;
        }

        if (accumulatedGain <= 0.00001f)
            return stage;

        let normalized = accumulated / accumulatedGain;
        return stage + ((normalized - stage) * seqfx::clampFloat (accumulatedGain, 0.0f, 1.0f));
    }

    float32<2> processStutter (wrap<seqfx::laneCount> lane, float32<2> stage)
    {
        stutterMixCurrent[lane] = seqfx::moveTowards (stutterMixCurrent[lane], stutterMixTarget[lane], 1.0f / 64.0f);

        let currentPlaybackSpeed = seqfx::clampFloat (auxParamValue (lane, 1, stutterPlaybackSpeed[lane]), 0.5f, 2.0f);
        let currentShape = seqfx::clampFloat (auxParamValue (lane, 2, stutterShape[lane]), 0.0f, 1.0f);
        let currentGate = seqfx::clampFloat (auxParamValue (lane, 3, stutterGate[lane]), 0.0f, 1.0f);

        if (stutterCapturing[lane])
        {
            let capturePhase = seqfx::clampFloat (
                stutterCaptureFrames[lane] / std::intrinsics::max (1.0f, stutterReadLength[lane]),
                0.0f,
                1.0f
            );
            let captureEnvelope = seqfx::stutterCaptureEnvelopeAt (
                capturePhase,
                currentShape,
                currentGate,
                currentPlaybackSpeed
            );
            captureStutterSample (lane, stage);
            let captureOut = stage * captureEnvelope;
            return stage + ((captureOut - stage) * stutterMixCurrent[lane]);
        }

        if (stutterMixCurrent[lane] <= 0.00001f || ! stutterPlaying[lane])
            return stage;

        let currentSliceCount = snapValue (auxParamValue (lane, 0, float32 (stutterSliceCount[lane])), 2, 32);
        let currentReadLength = resolveSliceFramesForCount (stutterBlockDurationFrames[lane], currentSliceCount);
        stutterReadLength[lane] = seqfx::clampFloat (
            currentReadLength,
            2.0f,
            float32 (stutterReadFrames[lane])
        );

        let crossfadeFrames = seqfx::clampFloat (
            std::intrinsics::min (float32 (processor.frequency) * 0.005f, stutterReadLength[lane] * 0.25f),
            1.0f,
            std::intrinsics::max (1.0f, stutterReadLength[lane] * 0.5f)
        );
        var stutterOut = readStutterCapture (lane, stutterPhaseFrames[lane]);
        let stutterPhase = seqfx::clampFloat (
            stutterPhaseFrames[lane] / std::intrinsics::max (1.0f, stutterReadLength[lane]),
            0.0f,
            1.0f
        );
        let stutterEnvelope = seqfx::stutterEnvelopeAt (stutterPhase, currentShape, currentGate);

        if (stutterPhaseFrames[lane] > stutterReadLength[lane] - crossfadeFrames)
        {
            let fade = (stutterPhaseFrames[lane] - (stutterReadLength[lane] - crossfadeFrames)) / crossfadeFrames;
            let head = readStutterCapture (lane, fade * crossfadeFrames);
            stutterOut = (stutterOut * (1.0f - fade)) + (head * fade);
        }

        stutterOut *= stutterEnvelope;

        stutterPhaseFrames[lane] += currentPlaybackSpeed;

        while (stutterPhaseFrames[lane] >= stutterReadLength[lane])
            stutterPhaseFrames[lane] -= stutterReadLength[lane];

        return stage + ((stutterOut - stage) * stutterMixCurrent[lane]);
    }

    float32<2> processChain (wrap<seqfx::laneCount> lane, float32<2> stage)
    {
        stage = processFilter (lane, stage);
        stage = processCrusher (lane, stage);

        writeTapeHistory (lane, stage);
        stage = processTapeStop (lane, stage);

        stage = processStutter (lane, stage);
        advanceAuxBlock (lane);
        advanceChainLifecycle (lane);
        return stage;
    }

    void advanceSequencer()
    {
        if (! isClockRunning())
            return;

        stepProgressFrames += 1.0;

        if (stepProgressFrames < currentStepFrames)
            return;

        stepProgressFrames -= currentStepFrames;
        currentStep = nextStepInLoop (currentStep);
        currentStepFrames = stepDurationFramesForStep (currentStep);
        latchStep();
    }

    void emitMonitor()
    {
        seqfx::SeqMonitor monitor;
        monitor.patternIndex = selectedPatternIndex;
        monitor.stepIndex = currentStep;
        monitor.transportRunning = isClockRunning();
        monitor.stepProgress = float32 (stepProgressFrames / std::intrinsics::max (1.0, currentStepFrames));
        monitor.stepDurationMs = float32 ((currentStepFrames / processor.frequency) * 1000.0);
        for (wrap<seqfx::laneCount> lane)
        {
            let activeEffect = selectedEffectForStep (lane, currentStep) != seqfx::effectEmpty;
            monitor.effectType[lane] = chainEffectType[lane];
            monitor.lifecycleState[lane] = chainLifecycleState[lane];
            monitor.auxCyclePhase[lane] = activeEffect ? auxCyclePhaseForLane (lane) : 0.0f;
            monitor.auxAmount[lane] = activeEffect ? auxAmountForLane (lane) : 0.0f;
            monitor.auxDurationMs[lane] = activeEffect
                ? float32 ((auxDurationFrames[lane] / processor.frequency) * 1000.0)
                : 0.0f;
        }
        monitorOut <- monitor;
    }

    void maybeEmitMonitor()
    {
        monitorCountdown -= 1;

        if (monitorCountdown > 0)
            return;

        monitorCountdown = int32 (processor.frequency / 30.0);
        emitMonitor();
    }

    void main()
    {
        loop
        {
            refreshControlTransitions();
            refreshSelectedPattern();

            if (resetRequested)
            {
                resetClockToLoopStart();
                processingResetRequested = true;
                relatchingFromPatternUpload = false;
                needsStepLatch = true;
                resetRequested = false;
            }

            if (processingResetRequested)
                resetProcessingState();

            if (hostPositionPending)
            {
                if (resolveClockMode() == 0)
                    syncHostStepFromQuarterNote();

                hostPositionPending = false;
            }

            if (needsStepLatch)
            {
                currentStepFrames = stepDurationFramesForStep (currentStep);
                latchStep();
                relatchingFromPatternUpload = false;
                needsStepLatch = false;
            }

            let dry = audioIn;
            var stage = dry;

            if (isClockRunning())
            {
                for (wrap<seqfx::laneCount> lane)
                    stage = processChain (lane, stage);
            }
            else
            {
                for (wrap<seqfx::laneCount> lane)
                    writeTapeHistory (lane, stage);
            }

            if (resetCrossfadeAge < seqfx::transitionCrossfadeFrames)
            {
                let resetFade = seqfx::smoothStep01 (
                    resetCrossfadeAge / seqfx::transitionCrossfadeFrames
                );
                stage = resetCrossfadeFrom + ((stage - resetCrossfadeFrom) * resetFade);
                resetCrossfadeAge += 1.0f;
            }

            lastProcessedStage = stage;
            hasProcessedStage = true;

            bypassMixCurrent = seqfx::moveTowards (
                bypassMixCurrent,
                bypassMixTarget,
                1.0f / seqfx::transitionCrossfadeFrames
            );
            let effectiveMix = seqfx::clampFloat (globalMix, 0.0f, 1.0f) * bypassMixCurrent;
            audioOut <- dry + ((stage - dry) * effectiveMix);

            if (bypassFlushPending && bypassMixCurrent <= 0.00001f)
            {
                processingResetRequested = true;
                bypassFlushPending = false;
            }

            advanceSequencer();
            maybeEmitMonitor();
            renderedFrameCounter += 1;
            advance();
        }
    }
}
