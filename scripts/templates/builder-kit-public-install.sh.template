#!/bin/bash
# Public, credential-free entry point. HTTPS is the trust boundary for this
# script; the existing private installer is verified before it is executed.
# Keep all executable work inside this complete definition so a truncated
# function body cannot perform a partial installation when piped into Bash.
builder_kit_install() (
    set +x
    set -euo pipefail
    umask 077
    fail() { printf 'Builder Kit: %s\n' "$1" >&2; exit 1; }

    [[ "$#" = 1 && "$1" = --accept-juce-terms ]] \
        || fail 'Read the JUCE notice and use the complete personalized command ending in --accept-juce-terms.'

    [[ "${BUILDER_KIT_ACCESS:-}" =~ ^[A-Za-z0-9._~-]+$ ]] \
        || fail 'The supplied access key is missing or invalid. Use your complete installation command.'
    [[ "${HOME:-}" = /* ]] || fail 'Your home directory is unavailable; no project was created.'

    local release_receipt=@@RELEASE_RECEIPT@@
    local canonical_project="${HOME}/Documents/Builder Kit"
    local legacy_project="${HOME}/src/@@LEGACY_DIRECTORY@@"
    local project=''
    local candidate suffix
    recognized_release() {
        local directory="$1"
        [[ -d "$directory" && ! -L "$directory" \
            && -d "$directory/.builder-kit-install" && ! -L "$directory/.builder-kit-install" \
            && -f "$directory/.builder-kit-install/receipt" && ! -L "$directory/.builder-kit-install/receipt" \
            && "$(cat -- "$directory/.builder-kit-install/receipt")" = "$release_receipt" ]]
    }
    reusable_empty_directory() {
        local directory="$1" first_entry
        [[ -d "$directory" && ! -L "$directory" ]] || return 1
        first_entry=$(find "$directory" -mindepth 1 -maxdepth 1 -print -quit) || return 1
        [[ -z "$first_entry" ]]
    }

    if [[ "${BUILDER_KIT_PROJECT_DIR+x}" = x ]]; then
        project="$BUILDER_KIT_PROJECT_DIR"
    elif recognized_release "$canonical_project"; then
        project="$canonical_project"
    elif recognized_release "$legacy_project"; then
        project="$legacy_project"
        printf 'Builder Kit: resuming the existing project at %s\n' "$project"
    elif reusable_empty_directory "$canonical_project"; then
        project="$canonical_project"
    elif [[ ! -e "$canonical_project" && ! -L "$canonical_project" ]]; then
        project="$canonical_project"
    else
        candidate="${HOME}/Documents/Builder Kit @@RELEASE_VERSION@@"
        suffix=1
        while [[ -e "$candidate" || -L "$candidate" ]]; do
            if recognized_release "$candidate" || reusable_empty_directory "$candidate"; then
                project="$candidate"
                break
            fi
            suffix=$((suffix + 1))
            [[ "$suffix" -le 100 ]] \
                || fail 'No unused Builder Kit project folder was found in Documents. Set BUILDER_KIT_PROJECT_DIR to an empty folder and retry.'
            candidate="${HOME}/Documents/Builder Kit @@RELEASE_VERSION@@ ($suffix)"
        done
        [[ -n "$project" ]] || project="$candidate"
        printf 'Builder Kit: the usual folder is occupied; using %s\n' "$project"
    fi
    [[ "$project" = /* && "$project" != / && "$project" != "$HOME" && "$project" != */ \
        && "$project" != *//* && "$project" != *$'\n'* && "$project" != *$'\r'* ]] \
        || fail 'The project destination must be a normalized absolute project folder.'

    # Inspect every existing component before mkdir can follow a link. The
    # immutable installer remains responsible for occupied-folder ownership.
    local remaining="${project#/}" current='' component
    while [[ -n "$remaining" ]]; do
        component="${remaining%%/*}"
        [[ "$component" != . && "$component" != .. ]] \
            || fail 'The project destination must not contain dot path components.'
        current="$current/$component"
        [[ ! -L "$current" ]] || fail 'The project destination contains a linked path; it was not changed.'
        [[ ! -e "$current" || -d "$current" ]] || fail 'The project destination contains a non-directory path; it was not changed.'
        if [[ "$remaining" = */* ]]; then remaining="${remaining#*/}"; else remaining=''; fi
    done
    printf 'Builder Kit: project folder: %s\n' "$project"

    local temporary
    temporary=$(mktemp -d -t builder-kit-entry) || fail 'A private temporary download folder could not be created.'
    trap 'rm -f -- "$temporary/installer.sh"; rmdir -- "$temporary"' EXIT
    printf 'url = "%s/%s/%s"\n' @@FEED_ORIGIN@@ "$BUILDER_KIT_ACCESS" @@INSTALLER_ARTIFACT@@ \
        | curl --disable --fail --silent --location --proto @@PROTOCOLS@@ --proto-redir @@PROTOCOLS@@ \
            --config - --output "$temporary/installer.sh" \
        || fail 'Installer download failed; nothing was installed.'
    local downloaded
    downloaded=$(shasum -a 256 "$temporary/installer.sh") \
        || fail 'Installer verification could not finish; nothing was installed.'
    [[ "${downloaded%% *}" = @@INSTALLER_SHA256@@ ]] \
        || fail 'Installer verification failed; nothing was installed.'

    mkdir -p -- "$project" || fail 'The project folder could not be created.'
    cd -- "$project" || fail 'The project folder could not be opened.'
    [[ "$(pwd -P)" = "$project" ]] || fail 'The project destination changed or became linked; installation stopped.'
    # Forward the acknowledgment supplied explicitly on the personalized line.
    # No Apple/system agreement is accepted here.
    /bin/bash "$temporary/installer.sh" "$1"
)
builder_kit_install "$@"
